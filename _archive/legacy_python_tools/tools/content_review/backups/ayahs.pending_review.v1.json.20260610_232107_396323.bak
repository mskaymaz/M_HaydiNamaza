      "ayahs": [
        {
          "ref": "101/004",
          "surah": 101,
          "ayah": 4,
          "arabic": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "101/004",
            "text": "İnsanların, 'her yana dağılmış' pervaneler gibi olacakları gün,"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "101/004",
            "text": "O gün insanlar, ateş etrafında çırpınıp dökülen pervaneye dönecekler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "101/004",
            "text": "It is the Day when people will be like moths, dispersed,"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "101/004",
            "text": "On that Day human beings shall be like scattered moths,"
          }
        }
      ],
      "status": "approved",
