    {
      "ref": "010/013",
      "id": "010/013",
      "surah": 10,
      "ayahStart": 13,
      "ayahEnd": 13,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 576,
        "ref": "010/013",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 224,
        "input_status": "ok",
        "input_source_ref_groups": "010/013"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "010/013"
      ],
      "ayahs": [
        {
          "ref": "010/013",
          "surah": 10,
          "ayah": 13,
          "arabic": "وَلَقَدْ أَهْلَكْنَا ٱلْقُرُونَ مِن قَبْلِكُمْ لَمَّا ظَلَمُوا۟ ۙ وَجَآءَتْهُمْ رُسُلُهُم بِٱلْبَيِّنَـٰتِ وَمَا كَانُوا۟ لِيُؤْمِنُوا۟ ۚ كَذَٰلِكَ نَجْزِى ٱلْقَوْمَ ٱلْمُجْرِمِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "010/013",
            "text": "Andolsun, sizden önceki nesilleri, resulleri kendilerine apaçık deliller getirdiği halde, zulmettikleri ve iman etmeyecek oldukları için yıkıma uğrattık. İşte Biz, suçlu-günahkar olan bir topluluğu böyle cezalandırırız."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "010/013",
            "text": "And olsun ki, sizden önce nice nesilleri, peygamberleri onlara belgeler getirmişken, haksızlık ederek inanmadıkları zaman yok etmiştik. İşte biz suçlu milleti böyle cezalandırırız."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "010/013",
            "text": "And We had already destroyed generations before you when they wronged, and their messengers had come to them with clear proofs, but they were not to believe. Thus do We recompense the criminal people"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "010/013",
            "text": "Surely We destroyed the nations (which had risen to heights of glory in their times) before you when they indulged in wrong-doing and refused to believe even when their Messengers brought clear signs to them. Thus do We recompense the people who are guilty."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
