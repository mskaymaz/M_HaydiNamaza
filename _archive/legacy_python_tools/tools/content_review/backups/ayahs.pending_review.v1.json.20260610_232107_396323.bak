      "ayahs": [
        {
          "ref": "069/042",
          "surah": 69,
          "ayah": 42,
          "arabic": "وَلَا بِقَوْلِ كَاهِنٍ ۚ قَلِيلًا مَّا تَذَكَّرُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "069/042",
            "text": "Bir kahinin de sözü değildir. Ne az öğüt alıp-düşünüyorsunuz?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "069/042",
            "text": "Kahin sözü de değildir; ne az düşünüyorsunuz!"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "069/042",
            "text": "Nor the word of a soothsayer; little do you remember."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "069/042",
            "text": "Nor is this the speech of a soothsayer. Little do you reflect!"
          }
        }
      ],
      "status": "approved",
