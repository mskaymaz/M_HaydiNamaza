    {
      "ref": "016/059",
      "id": "016/059",
      "surah": 16,
      "ayahStart": 59,
      "ayahEnd": 59,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 677,
        "ref": "016/059",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 166,
        "input_status": "ok",
        "input_source_ref_groups": "016/059"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "016/059"
      ],
      "ayahs": [
        {
          "ref": "016/059",
          "surah": 16,
          "ayah": 59,
          "arabic": "يَتَوَٰرَىٰ مِنَ ٱلْقَوْمِ مِن سُوٓءِ مَا بُشِّرَ بِهِۦٓ ۚ أَيُمْسِكُهُۥ عَلَىٰ هُونٍ أَمْ يَدُسُّهُۥ فِى ٱلتُّرَابِ ۗ أَلَا سَآءَ مَا يَحْكُمُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "016/059",
            "text": "Kendisine verilen müjdenin kötülüğünden dolayı topluluktan gizlenir; onu aşağılanarak tutacak mı, yoksa toprağa gömecek mi? Bak, verdikleri hüküm ne kötüdür?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "016/059",
            "text": "Kendisine verilen kötü müjde yüzünden, halktan gizlenmeye çalışır; onu utana utana tutsun mu, yoksa toprağa mı gömsün? Ne kötü hükmediyorlar!"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "016/059",
            "text": "He hides himself from the people because of the ill of which he has been informed. Should he keep it in humiliation or bury it in the ground? Unquestionably, evil is what they decide."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "016/059",
            "text": "and he hides himself from people because of the bad news, thinking: should he keep the child despite disgrace, or should he bury it in dust? How evil is their estimate of Allah!"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
