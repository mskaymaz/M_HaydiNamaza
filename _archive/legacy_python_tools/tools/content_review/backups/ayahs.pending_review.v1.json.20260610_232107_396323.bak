    {
      "ref": "004/155",
      "id": "004/155",
      "surah": 4,
      "ayahStart": 155,
      "ayahEnd": 155,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 307,
        "ref": "004/155",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 337,
        "input_status": "ok",
        "input_source_ref_groups": "004/155"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "004/155"
      ],
      "ayahs": [
        {
          "ref": "004/155",
          "surah": 4,
          "ayah": 155,
          "arabic": "فَبِمَا نَقْضِهِم مِّيثَـٰقَهُمْ وَكُفْرِهِم بِـَٔايَـٰتِ ٱللَّهِ وَقَتْلِهِمُ ٱلْأَنۢبِيَآءَ بِغَيْرِ حَقٍّ وَقَوْلِهِمْ قُلُوبُنَا غُلْفٌۢ ۚ بَلْ طَبَعَ ٱللَّهُ عَلَيْهَا بِكُفْرِهِمْ فَلَا يُؤْمِنُونَ إِلَّا قَلِيلًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/155",
            "text": "Onların kendi sözlerini bozmaları, Allah'ın ayetlerine karşı inkara sapmaları, peygamberleri haksız yere öldürmeleri ve: \"Kalplerimiz örtülüdür\" demeleri nedeniyle (onları lanetledik.) Hayır; Allah, inkarları dolayısıyla ona (kalplerine) damga vurmuştur. Onların azı dışında, inanmazlar."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/155",
            "text": "Sözleşmelerini bozmaları, Allah'ın ayetlerini inkar etmeleri, peygamberleri haksız yere öldürmeleri, \"Kalblerimiz perdelidir\" demelerinden ötürü Allah, evet, inkarlarına karşılık onların kalblerini mühürledi, onun için bunların ancak pek azı inanır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/155",
            "text": "And [We cursed them] for their breaking of the covenant and their disbelief in the signs of Allah and their killing of the prophets without right and their saying, \"Our hearts are wrapped\". Rather, Allah has sealed them because of their disbelief, so they believe not, except for a few."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/155",
            "text": "(They have incurred Allah's wrath) for their breaking the covenant, and their rejection of the signs of Allah, and for slaying Prophets without right, and for saying: 'Our hearts are wrapped up in covers' -even though in fact Allah has sealed their hearts because of their unbelief, so that they scarcely believe"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
