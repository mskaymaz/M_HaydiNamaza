      "sourceRefGroups": [
        "073/015"
      ],
      "ayahs": [
        {
          "ref": "073/015",
          "surah": 73,
          "ayah": 15,
          "arabic": "إِنَّآ أَرْسَلْنَآ إِلَيْكُمْ رَسُولًا شَـٰهِدًا عَلَيْكُمْ كَمَآ أَرْسَلْنَآ إِلَىٰ فِرْعَوْنَ رَسُولًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "073/015",
            "text": "Şüphesiz size, üzerinize şahid olacak bir elçi gönderdik; Firavun'a bir elçi gönderdiğimiz gibi."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "073/015",
            "text": "Firavun'a bir peygamber gönderdiğimiz gibi, size de, hakkınızda şahidlik edecek bir peygamber gönderdik."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "073/015",
            "text": "Indeed, We have sent to you a Messenger as a witness upon you just as We sent to Pharaoh a messenger."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "073/015",
            "text": "Surely We have sent to you a Messenger as a witness over you, just as We had sent a Messenger to Pharaoh."
          }
        }
      ],
