        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 117,
        "input_status": "ok",
        "input_source_ref_groups": "017/021"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "017/021"
      ],
      "ayahs": [
        {
          "ref": "017/021",
          "surah": 17,
          "ayah": 21,
          "arabic": "ٱنظُرْ كَيْفَ فَضَّلْنَا بَعْضَهُمْ عَلَىٰ بَعْضٍ ۚ وَلَلْءَاخِرَةُ أَكْبَرُ دَرَجَـٰتٍ وَأَكْبَرُ تَفْضِيلًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "017/021",
            "text": "Onlardan kimini kimine nasıl üstün tuttuğumuzu gör. Muhakkak ahiret dereceler bakımından daha büyüktür, üstünlük bakımından da daha büyüktür."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "017/021",
            "text": "Onları birbirlerinden nasıl üstün kıldığımıza bir bak! Doğrusu ahirette daha büyük dereceler ve daha büyük üstünlükler vardır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "017/021",
            "text": "Look how We have favored [in provision] some of them over others. But the Hereafter is greater in degrees [of difference] and greater in distinction."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "017/021",
            "text": "See, how We have exalted some above others in this world, and in the Life to Come they will have higher ranks and greater degrees of excellence over others."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
