          "surah": 51,
          "ayah": 48,
          "arabic": "وَٱلْأَرْضَ فَرَشْنَـٰهَا فَنِعْمَ ٱلْمَـٰهِدُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "051/048",
            "text": "Yeri de Biz döşeyip-yaydık; ne güzel döşeyici(yiz)."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "051/048",
            "text": "Yeryüzünü biz yayıp döşedik: Ne güzel döşeyiciyiz!"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "051/048",
            "text": "And the earth We have spread out, and excellent is the preparer."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "051/048",
            "text": "And the earth – We spread it out, and how well have We smoothed it!"
          }
        }
      ],
