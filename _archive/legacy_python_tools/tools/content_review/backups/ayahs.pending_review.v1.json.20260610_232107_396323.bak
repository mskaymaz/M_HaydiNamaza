      ],
      "ayahs": [
        {
          "ref": "049/010",
          "surah": 49,
          "ayah": 10,
          "arabic": "إِنَّمَا ٱلْمُؤْمِنُونَ إِخْوَةٌ فَأَصْلِحُوا۟ بَيْنَ أَخَوَيْكُمْ ۚ وَٱتَّقُوا۟ ٱللَّهَ لَعَلَّكُمْ تُرْحَمُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "049/010",
            "text": "Mü'minler ancak kardeştirler. Öyleyse kardeşlerinizin arasını bulup-düzeltin ve Allah'tan korkup-sakının; umulur ki esirgenirsiniz."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "049/010",
            "text": "Şüphesiz müminler birbiri ile kardeştirler; öyle ise dargın olan kardeşlerinizin arasını düzeltin; Allah'tan sakının ki size acısın."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "049/010",
            "text": "The believers are but brothers, so make settlement between your brothers. And fear Allah that you may receive mercy."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "049/010",
            "text": "Surely the believers are none but brothers unto one another, so set things right between your brothers, and have fear of Allah that you may be shown mercy."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
