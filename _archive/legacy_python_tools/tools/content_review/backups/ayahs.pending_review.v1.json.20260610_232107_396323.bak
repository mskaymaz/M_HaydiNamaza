        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 117,
        "input_status": "ok",
        "input_source_ref_groups": "009/087"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "009/087"
      ],
      "ayahs": [
        {
          "ref": "009/087",
          "surah": 9,
          "ayah": 87,
          "arabic": "رَضُوا۟ بِأَن يَكُونُوا۟ مَعَ ٱلْخَوَالِفِ وَطُبِعَ عَلَىٰ قُلُوبِهِمْ فَهُمْ لَا يَفْقَهُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "009/087",
            "text": "(Savaştan) Geri kalanlarla birlikte olmayı seçtiler. Onların kalpleri mühürlenmiştir. Bundan dolayı kavrayıp-anlamazlar."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "009/087",
            "text": "Geri kalan kadınlarla beraber bulunmaya razı oldular. Kalbleri kapanmıştır, bu yüzden anlamazlar."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "009/087",
            "text": "They were satisfied to be with those who stay behind, and their hearts were sealed over, so they do not understand."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "009/087",
            "text": "They were content to stay behind with the womenfolk. Their hearts were sealed, leaving them bereft of understanding."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
