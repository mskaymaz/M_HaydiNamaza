    {
      "ref": "016/036",
      "id": "016/036",
      "surah": 16,
      "ayahStart": 36,
      "ayahEnd": 36,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 670,
        "ref": "016/036",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 284,
        "input_status": "ok",
        "input_source_ref_groups": "016/036"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "016/036"
      ],
      "ayahs": [
        {
          "ref": "016/036",
          "surah": 16,
          "ayah": 36,
          "arabic": "وَلَقَدْ بَعَثْنَا فِى كُلِّ أُمَّةٍ رَّسُولًا أَنِ ٱعْبُدُوا۟ ٱللَّهَ وَٱجْتَنِبُوا۟ ٱلطَّـٰغُوتَ ۖ فَمِنْهُم مَّنْ هَدَى ٱللَّهُ وَمِنْهُم مَّنْ حَقَّتْ عَلَيْهِ ٱلضَّلَـٰلَةُ ۚ فَسِيرُوا۟ فِى ٱلْأَرْضِ فَٱنظُرُوا۟ كَيْفَ كَانَ عَـٰقِبَةُ ٱلْمُكَذِّبِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "016/036",
            "text": "Andolsun, Biz her ümmete: \"Allah'a kulluk edin ve tağuttan kaçının\" (diye tebliğ etmesi için) bir elçi gönderdik. Böylelikle, onlardan kimine Allah hidayet verdi, onlardan kiminin üzerine sapıklık hak oldu. Artık, yeryüzünde dolaşın da yalanlayanların uğradıkları sonucu görün."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "016/036",
            "text": "And olsun ki, her ümmete: \"Allah'a kulluk edin, azdırıcılardan kaçının\" diyen peygamber göndermişizdir. Allah içlerinden kimini doğru yola eriştirdi, kimi de sapıklığı haketti. Yeryüzünde gezin; peygamberleri yalanlayanların sonlarının nasıl olduğunugörün."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "016/036",
            "text": "And We certainly sent into every nation a messenger, [saying], \"Worship Allah and avoid Taghut.\" And among them were those whom Allah guided, and among them were those upon whom error was [deservedly] decreed. So proceed through the earth and observe how was the end of the deniers."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "016/036",
            "text": "We raised a Messenger in every community (to tell them): \"Serve Allah and shun the Evil One.\" Thereafter Allah guided some of them while others were overtaken by error. Go about the earth, then, and observe what was the end of those who rejected the Messengers, calling them liars."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Nahl",
      "ayah_number": 36,
      "ayah_end_number": 36,
      "text_ar": "وَلَقَدْ بَعَثْنَا فِى كُلِّ أُمَّةٍ رَّسُولًا أَنِ ٱعْبُدُوا۟ ٱللَّهَ وَٱجْتَنِبُوا۟ ٱلطَّـٰغُوتَ ۖ فَمِنْهُم مَّنْ هَدَى ٱللَّهُ وَمِنْهُم مَّنْ حَقَّتْ عَلَيْهِ ٱلضَّلَـٰلَةُ ۚ فَسِيرُوا۟ فِى ٱلْأَرْضِ فَٱنظُرُوا۟ كَيْفَ كَانَ عَـٰقِبَةُ ٱلْمُكَذِّبِينَ",
      "text_tr": "Andolsun, Biz her ümmete: \"Allah'a kulluk edin ve tağuttan kaçının\" (diye tebliğ etmesi için) bir elçi gönderdik. Böylelikle, onlardan kimine Allah hidayet verdi, onlardan kiminin üzerine sapıklık hak oldu. Artık, yeryüzünde dolaşın da yalanlayanların uğradıkları sonucu görün.",
      "text_en": "And We certainly sent into every nation a messenger, [saying], \"Worship Allah and avoid Taghut.\" And among them were those whom Allah guided, and among them were those upon whom error was [deservedly] decreed. So proceed through the earth and observe how was the end of the deniers.",
      "priority": 1,
      "notes": "bulk approved from local Tanzil source",
      "createdAt": "2026-06-09T08:52:44+00:00",
      "updatedAt": "2026-06-09T08:52:44+00:00",
      "approvedAt": "2026-06-09T08:52:44+00:00",
