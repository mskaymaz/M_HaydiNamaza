      },
      "sourceRefGroups": [
        "008/027"
      ],
      "ayahs": [
        {
          "ref": "008/027",
          "surah": 8,
          "ayah": 27,
          "arabic": "يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَخُونُوا۟ ٱللَّهَ وَٱلرَّسُولَ وَتَخُونُوٓا۟ أَمَـٰنَـٰتِكُمْ وَأَنتُمْ تَعْلَمُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "008/027",
            "text": "Ey iman edenler, Allah'a ve Resûlü’ne ihanet etmeyin, bile bile emanetlerinize de ihanet etmeyin."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "008/027",
            "text": "Ey inananlar! Allah'a ve Peygambere karşı hainlik etmeyin, size güvenilen şeylere bile bile hıyanet etmiş olursunuz."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "008/027",
            "text": "O you who have believed, do not betray Allah and the Messenger or betray your trusts while you know [the consequence]."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "008/027",
            "text": "Believers! Do not be unfaithful to Allah and the Messenger, nor be knowingly unfaithful to your trusts."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
