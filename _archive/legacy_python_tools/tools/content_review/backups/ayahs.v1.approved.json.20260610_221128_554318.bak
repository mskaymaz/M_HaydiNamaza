      "onay_reviewed_at": "2026-06-10T16:16:17"
    },
    {
      "id": "008/015",
      "kind": "ayah",
      "ref": "008/015",
      "ar": "يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا لَقِيتُمُ ٱلَّذِينَ كَفَرُوا۟ زَحْفًا فَلَا تُوَلُّوهُمُ ٱلْأَدْبَارَ",
      "tr": "Ey iman edenler, toplu olarak kafirlerle karşılaştığınız zaman, onlara arka çevirmeyin (savaştan kaçmayın).",
      "en": "O you who have believed, when you meet those who disbelieve advancing [for battle], do not turn to them your backs [in flight].",
      "priority": 2,
      "surah_number": 8,
      "surah_name": "Enfal",
      "ayah_number": 15,
      "ayah_end_number": 15,
      "status": "approved",
      "approvedAt": "2026-06-10T16:16:27",
      "onay_review": {
        "action": "approved",
