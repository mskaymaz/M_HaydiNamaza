    {
      "ref": "009/065",
      "id": "009/065",
      "surah": 9,
      "ayahStart": 65,
      "ayahEnd": 65,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 543,
        "ref": "009/065",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 185,
        "input_status": "ok",
        "input_source_ref_groups": "009/065"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "009/065"
      ],
      "ayahs": [
        {
          "ref": "009/065",
          "surah": 9,
          "ayah": 65,
          "arabic": "وَلَئِن سَأَلْتَهُمْ لَيَقُولُنَّ إِنَّمَا كُنَّا نَخُوضُ وَنَلْعَبُ ۚ قُلْ أَبِٱللَّهِ وَءَايَـٰتِهِۦ وَرَسُولِهِۦ كُنتُمْ تَسْتَهْزِءُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "009/065",
            "text": "Onlara sorarsan, andolsun: \"Biz dalmış, oyalanıyorduk\" derler. De ki: \"Allah ile, O'nun ayetleriyle ve elçisiyle mi alay ediyordunuz?\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "009/065",
            "text": "Onlara soracak olursan, \"Biz and olsun ki, eğlenip oynuyorduk\" diyecekler; De ki: \"Allah'la, ayetleriyle, Peygamberiyle mi alay ediyordunuz?\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "009/065",
            "text": "And if you ask them, they will surely say, \"We were only conversing and playing.\" Say, \"Is it Allah and His verses and His Messenger that you were mocking?\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "009/065",
            "text": "Should you question them what they were talking about, they would certainly say: \"We were merely jesting and being playful.\" Tell them: \"Was it Allah and His revelation and His Messenger that you were mocking?\""
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
