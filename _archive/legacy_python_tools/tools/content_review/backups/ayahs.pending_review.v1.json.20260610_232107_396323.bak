      "ayahs": [
        {
          "ref": "037/020",
          "surah": 37,
          "ayah": 20,
          "arabic": "وَقَالُوا۟ يَـٰوَيْلَنَا هَـٰذَا يَوْمُ ٱلدِّينِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "037/020",
            "text": "Derler ki: \"Eyvahlar bize; bu, din günüdür.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "037/020",
            "text": "Şöyle derler: \"Vay bize! İşte bu ceza günüdür.\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "037/020",
            "text": "They will say, \"O woe to us! This is the Day of Recompense.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "037/020",
            "text": "They will then say: “Woe for us. This is the Day of Judgement.”"
          }
        }
      ],
