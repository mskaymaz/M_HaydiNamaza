        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 270,
        "input_status": "ok",
        "input_source_ref_groups": "002/120"
      },
      "source": {
        "arabic": "Existing clean UTF-8 Uthmani Arabic text from prior working dataset; Tanzil Uthmani Arabic verification/fetch script available",
        "tr": "Tanzil tr.bulac - Ali Bulaç",
        "en": "Tanzil en.sahih - Saheeh International",
        "tr_alternative": "Tanzil tr.diyanet - Diyanet İşleri",
        "en_alternative": "Tanzil en.maududi - Abul A’la Maududi"
      },
      "sourceRefGroups": [
        "002/120"
      ],
      "ayahs": [
        {
          "ref": "002/120",
          "surah": 2,
          "ayah": 120,
          "arabic": "وَلَن تَرْضَىٰ عَنكَ ٱلْيَهُودُ وَلَا ٱلنَّصَـٰرَىٰ حَتَّىٰ تَتَّبِعَ مِلَّتَهُمْ ۗ قُلْ إِنَّ هُدَى ٱللَّهِ هُوَ ٱلْهُدَىٰ ۗ وَلَئِنِ ٱتَّبَعْتَ أَهْوَآءَهُم بَعْدَ ٱلَّذِى جَآءَكَ مِنَ ٱلْعِلْمِ ۙ مَا لَكَ مِنَ ٱللَّهِ مِن وَلِىٍّ وَلَا نَصِيرٍ",
          "tr": {
            "source": "Tanzil tr.bulac - Ali Bulaç",
            "text": "Sen onların dinlerine uymadıkça, Yahudi ve Hıristiyanlar senden kesinlikle hoşnut olacak değillerdir. De ki: \"Şüphesiz doğru yol, Allah'ın (gösterdiği) yoludur.\" Eğer sana gelen bunca ilimden sonra onların heva (arzu ve tutku)larına uyacak olursan, senin için Allah'tan ne bir dost vardır, ne de bir yardımcı."
          },
          "en": {
            "source": "Tanzil en.sahih - Saheeh International",
            "text": "And never will the Jews or the Christians approve of you until you follow their religion. Say, \"Indeed, the guidance of Allah is the [only] guidance.\" If you were to follow their desires after what has come to you of knowledge, you would have against Allah no protector or helper."
          },
          "alternatives": {
            "tr_diyanet_tanzil": {
              "source": "Tanzil tr.diyanet - Diyanet İşleri",
              "text": "Kendi dinlerine uymadıkça, Yahudi ve Hıristiyanlar senden asla hoşnud olmayacaklardır. De ki: \"Doğru yol, ancak Allah'ın yoludur\". Sana gelen ilimden sonra onların heveslerine uyarsan, and olsun ki, Allah'tan sana ne bir dost ve ne de bir yardımcı olur."
            },
            "en_maududi": {
              "source": "Tanzil en.maududi - Abul A’la Maududi",
              "text": "The Jews and the Christians will never be satisfied with you, O Muhammad, until you follow their way. Tell them plainly, \"The right way is shown by Allah.\" And if, after all the' knowledge you have received, you were to yield to their desires, you shall find neither any friend nor helper to protect you from Allah's wrath."
            }
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 3,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "",
        "updated_at": "2026-06-05T12:12:17+00:00"
