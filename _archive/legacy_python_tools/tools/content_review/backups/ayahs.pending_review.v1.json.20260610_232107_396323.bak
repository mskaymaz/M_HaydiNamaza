          "ref": "089/006",
          "surah": 89,
          "ayah": 6,
          "arabic": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "089/006",
            "text": "Rabbinin Ad (kavmin)e ne yaptığını görmedin mi?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "089/006",
            "text": "Rabbinin, hiçbir memlekette benzeri ortaya konmayan sütunlara sahip İrem şehrinde oturan Ad milletine ne ettiğini görmedin mi?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "089/006",
            "text": "Have you not considered how your Lord dealt with 'Aad -"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "089/006",
            "text": "Have you not seen how your Lord dealt with Ad"
          }
        }
      ],
