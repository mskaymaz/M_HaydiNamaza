      "ayahs": [
        {
          "ref": "003/098",
          "surah": 3,
          "ayah": 98,
          "arabic": "قُلْ يَـٰٓأَهْلَ ٱلْكِتَـٰبِ لِمَ تَكْفُرُونَ بِـَٔايَـٰتِ ٱللَّهِ وَٱللَّهُ شَهِيدٌ عَلَىٰ مَا تَعْمَلُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "003/098",
            "text": "De ki: \"Ey Kitap Ehli, Allah yaptıklarınıza şahid iken, ne diye Allah'ın ayetlerini inkar ediyorsunuz?\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "003/098",
            "text": "De ki: \"Ey Kitap ehli! Allah yaptıklarınızı görüp dururken, niçin Allah'ın ayetlerini inkar ediyorsunuz?\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "003/098",
            "text": "Say, \"O People of the Scripture, why do you disbelieve in the verses of Allah while Allah is Witness over what you do?\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "003/098",
            "text": "Say: 'People of the Book! Why do you reject the signs of Allah when Allah is witness to all that you do?'"
          }
        }
      ],
