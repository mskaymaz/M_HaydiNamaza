      "input": {
        "sira": 198,
        "ref": "003/133",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 138,
        "input_status": "ok",
        "input_source_ref_groups": "003/133"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "003/133"
      ],
      "ayahs": [
        {
          "ref": "003/133",
          "surah": 3,
          "ayah": 133,
          "arabic": "وَسَارِعُوٓا۟ إِلَىٰ مَغْفِرَةٍ مِّن رَّبِّكُمْ وَجَنَّةٍ عَرْضُهَا ٱلسَّمَـٰوَٰتُ وَٱلْأَرْضُ أُعِدَّتْ لِلْمُتَّقِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "003/133",
            "text": "Rabbinizden olan mağfiret ve eni göklerle yer kadar olan cennete (kavuşmak için) yarışın; o, muttakiler için hazırlanmıştır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "003/133",
            "text": "Rabbinizin mağfiretine ve Allah'a karşı gelmekten sakınanlar için hazırlanmış eni gökler ve yer kadar olan cennete koşuşun."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "003/133",
            "text": "And hasten to forgiveness from your Lord and a garden as wide as the heavens and earth, prepared for the righteous"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "003/133",
            "text": "And hasten to the for-giveness of your Lord and to a Paradise as vast as the heavens and the earth, prepared for the God-fearing."
          }
        }
      ],
      "status": "approved",
