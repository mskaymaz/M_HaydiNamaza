    {
      "ref": "003/090",
      "id": "003/090",
      "surah": 3,
      "ayahStart": 90,
      "ayahEnd": 90,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 169,
        "ref": "003/090",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 150,
        "input_status": "ok",
        "input_source_ref_groups": "003/090"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "003/090"
      ],
      "ayahs": [
        {
          "ref": "003/090",
          "surah": 3,
          "ayah": 90,
          "arabic": "إِنَّ ٱلَّذِينَ كَفَرُوا۟ بَعْدَ إِيمَـٰنِهِمْ ثُمَّ ٱزْدَادُوا۟ كُفْرًا لَّن تُقْبَلَ تَوْبَتُهُمْ وَأُو۟لَـٰٓئِكَ هُمُ ٱلضَّآلُّونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "003/090",
            "text": "Doğrusu, imanlarından sonra inkar edenler, sonra inkarlarını arttıranlar; bunların tevbeleri kesinlikle kabul edilmez. İşte bunlar, sapıkların ta kendileridir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "003/090",
            "text": "İnandıktan sonra inkar edip, inkarda aşırı gidenler var ya, onların tevbeleri kabul edilmeyecektir. İşte sapıklar onlardır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "003/090",
            "text": "Indeed, those who reject the message after their belief and then increase in disbelief - never will their [claimed] repentance be accepted, and they are the ones astray."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "003/090",
            "text": "Those who relieved and have har-dened in their disbelief after once believing, their (pretence to) repentance shall not be accepted. Indeed such men have altogether strayed."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Ali Imran",
      "ayah_number": 90,
      "ayah_end_number": 90,
      "text_ar": "إِنَّ ٱلَّذِينَ كَفَرُوا۟ بَعْدَ إِيمَـٰنِهِمْ ثُمَّ ٱزْدَادُوا۟ كُفْرًا لَّن تُقْبَلَ تَوْبَتُهُمْ وَأُو۟لَـٰٓئِكَ هُمُ ٱلضَّآلُّونَ",
      "text_tr": "Doğrusu, imanlarından sonra inkar edenler, sonra inkarlarını arttıranlar; bunların tevbeleri kesinlikle kabul edilmez. İşte bunlar, sapıkların ta kendileridir.",
      "text_en": "Indeed, those who reject the message after their belief and then increase in disbelief - never will their [claimed] repentance be accepted, and they are the ones astray.",
