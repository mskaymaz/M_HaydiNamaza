          "ref": "004/138",
          "surah": 4,
          "ayah": 138,
          "arabic": "بَشِّرِ ٱلْمُنَـٰفِقِينَ بِأَنَّ لَهُمْ عَذَابًا أَلِيمًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/138",
            "text": "Münafıklara müjde ver: Onlar için gerçekten acıklı bir azap vardır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/138",
            "text": "Münafıklara, kendilerine elem verici bir azab olduğunu müjdele."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/138",
            "text": "Give tidings to the hypocrites that there is for them a painful punishment -"
