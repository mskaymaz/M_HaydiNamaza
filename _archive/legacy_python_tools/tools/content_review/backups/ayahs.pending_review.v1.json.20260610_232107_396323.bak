          "surah": 102,
          "ayah": 8,
          "arabic": "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "102/008",
            "text": "Sonra o gün, nimetten sorguya çekileceksiniz."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "102/008",
            "text": "Sonra o gün, size verilmiş olan her nimetten sorguya çekileceksiniz."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "102/008",
            "text": "Then you will surely be asked that Day about pleasure."
          },
