<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="96dp"
    android:layout_height="96dp"
    android:background="@drawable/prayer_widget_background"
    android:clipToOutline="true"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.05"
        android:maxLines="1"
        android:text="Akşam"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="23dp"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.07"
        android:maxLines="1"
        android:text="19:42"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:translationY="-2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/prayer_widget_countdown_bottom"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="15dp"
            android:background="@drawable/prayer_widget_remaining_band">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:text="Kalan Süre"
                android:textColor="#000000"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="15dp"
                android:layout_gravity="left|center_vertical"
                android:layout_marginLeft="10dp"
                android:contentDescription="@null"
                android:src="@drawable/prayer_widget_small_arrow_head" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="01:25:18"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
