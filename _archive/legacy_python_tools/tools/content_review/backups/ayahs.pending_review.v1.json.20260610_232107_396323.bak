      "ayahs": [
        {
          "ref": "016/123",
          "surah": 16,
          "ayah": 123,
          "arabic": "ثُمَّ أَوْحَيْنَآ إِلَيْكَ أَنِ ٱتَّبِعْ مِلَّةَ إِبْرَٰهِيمَ حَنِيفًا ۖ وَمَا كَانَ مِنَ ٱلْمُشْرِكِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "016/123",
            "text": "Sonra sana vahyettik: \"Hanif (muvahhid) olan İbrahim'in dinine uy. O, müşriklerden değildi.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "016/123",
            "text": "Şimdi sana, \"Doğruya yönelen, puta tapanlardan olmayan İbrahim'in dinine uy\" diye vahyettik."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "016/123",
            "text": "Then We revealed to you, [O Muhammad], to follow the religion of Abraham, inclining toward truth; and he was not of those who associate with Allah."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "016/123",
            "text": "Then We revealed to you: \"Follow the way of Abraham with exclusive devotion to Allah. He was not one of those who associated others with Allah in His Divinity.\""
          }
        }
      ],
