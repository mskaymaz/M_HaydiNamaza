    {
      "ref": "010/068",
      "id": "010/068",
      "surah": 10,
      "ayahStart": 68,
      "ayahEnd": 68,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 586,
        "ref": "010/068",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 232,
        "input_status": "ok",
        "input_source_ref_groups": "010/068"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "010/068"
      ],
      "ayahs": [
        {
          "ref": "010/068",
          "surah": 10,
          "ayah": 68,
          "arabic": "قَالُوا۟ ٱتَّخَذَ ٱللَّهُ وَلَدًا ۗ سُبْحَـٰنَهُۥ ۖ هُوَ ٱلْغَنِىُّ ۖ لَهُۥ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ ۚ إِنْ عِندَكُم مِّن سُلْطَـٰنٍۭ بِهَـٰذَآ ۚ أَتَقُولُونَ عَلَى ٱللَّهِ مَا لَا تَعْلَمُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "010/068",
            "text": "\"Allah çocuk edindi\" dediler. O, (bundan) Yücedir; O, hiçbir şeye ihtiyacı olmayandır. Göklerde ve yerde ne varsa O'nundur. Kendinizde buna ilişkin bir delil de yoktur. Allah'a karşı bilmeyeceğiniz bir şeyi mi söylüyorsunuz?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "010/068",
            "text": "\"Allah çocuk edindi\" dediler; haşa; O müstağnidir; göklerde ve yerde olanlara sahiptir. Elinizde, onun çocuk edindiğine dair bir delil yoktur, bilmediğiniz şeyi Allah'a karşı nasıl söylüyorsunuz?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "010/068",
            "text": "They have said, \"Allah has taken a son.\" Exalted is He; He is the [one] Free of need. To Him belongs whatever is in the heavens and whatever is in the earth. You have no authority for this [claim]. Do you say about Allah that which you do not know?"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "010/068",
            "text": "They say: 'Allah has taken a son. Glory be to Him. He is self-sufficient! His is all that is in the heavens and all that is in the earth. Have you any authority to support (that Allah has taken a son)? Do you ascribe to Allah something of which you have no knowledge?"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Yunus",
      "ayah_number": 68,
      "ayah_end_number": 68,
      "text_ar": "قَالُوا۟ ٱتَّخَذَ ٱللَّهُ وَلَدًا ۗ سُبْحَـٰنَهُۥ ۖ هُوَ ٱلْغَنِىُّ ۖ لَهُۥ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ ۚ إِنْ عِندَكُم مِّن سُلْطَـٰنٍۭ بِهَـٰذَآ ۚ أَتَقُولُونَ عَلَى ٱللَّهِ مَا لَا تَعْلَمُونَ",
      "text_tr": "\"Allah çocuk edindi\" dediler. O, (bundan) Yücedir; O, hiçbir şeye ihtiyacı olmayandır. Göklerde ve yerde ne varsa O'nundur. Kendinizde buna ilişkin bir delil de yoktur. Allah'a karşı bilmeyeceğiniz bir şeyi mi söylüyorsunuz?",
      "text_en": "They have said, \"Allah has taken a son.\" Exalted is He; He is the [one] Free of need. To Him belongs whatever is in the heavens and whatever is in the earth. You have no authority for this [claim]. Do you say about Allah that which you do not know?",
      "priority": 1,
      "notes": "bulk approved from local Tanzil source",
