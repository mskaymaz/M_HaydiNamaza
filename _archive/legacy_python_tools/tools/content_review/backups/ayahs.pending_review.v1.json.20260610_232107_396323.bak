    {
      "ref": "029/028",
      "id": "029/028",
      "surah": 29,
      "ayahStart": 28,
      "ayahEnd": 28,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 935,
        "ref": "029/028",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 160,
        "input_status": "ok",
        "input_source_ref_groups": "029/028"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "029/028"
      ],
      "ayahs": [
        {
          "ref": "029/028",
          "surah": 29,
          "ayah": 28,
          "arabic": "وَلُوطًا إِذْ قَالَ لِقَوْمِهِۦٓ إِنَّكُمْ لَتَأْتُونَ ٱلْفَـٰحِشَةَ مَا سَبَقَكُم بِهَا مِنْ أَحَدٍ مِّنَ ٱلْعَـٰلَمِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "029/028",
            "text": "Lut da; hani kavmine demişti: \"Siz gerçekten, sizden önce alemlerden hiç kimsenin yapmadığı 'çirkin bir utanmazlığı' yapıyorsunuz.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "029/028",
            "text": "Lut da, milletine şöyle demişti: \"Doğrusu siz dünyalarda hiç kimsenin sizden önce yapmadığı bir hayasızlığı yapıyorsunuz.\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "029/028",
            "text": "And [mention] Lot, when he said to his people, \"Indeed, you commit such immorality as no one has preceded you with from among the worlds."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "029/028",
            "text": "We sent Lot and he said to his people: “You commit the abomination that none in the world ever committed before you."
          }
        }
      ],
      "status": "approved",
