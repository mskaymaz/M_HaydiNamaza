      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "018/046"
      ],
      "ayahs": [
        {
          "ref": "018/046",
          "surah": 18,
          "ayah": 46,
          "arabic": "ٱلْمَالُ وَٱلْبَنُونَ زِينَةُ ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ وَٱلْبَـٰقِيَـٰتُ ٱلصَّـٰلِحَـٰتُ خَيْرٌ عِندَ رَبِّكَ ثَوَابًا وَخَيْرٌ أَمَلًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "018/046",
            "text": "Mal ve çocuklar, dünya hayatının çekici-süsüdür; sürekli olan 'salih davranışlar' ise, Rabbinin Katında sevap bakımından daha hayırlıdır, umut etmek bakımından da daha hayırlıdır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "018/046",
            "text": "Mal ve oğullar, dünya hayatının süsüdür. Ama baki kalacak yararlı işler, sevab olarak da, emel olarak da, Rabbinin katında daha hayırlıdır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "018/046",
            "text": "Wealth and children are [but] adornment of the worldly life. But the enduring good deeds are better to your Lord for reward and better for [one's] hope."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "018/046",
            "text": "Wealth and children are an adornment of the life of the world. But the deeds of lasting righteousness are the best in the sight of your Lord in reward, and far better a source of hope."
          }
        }
      ],
      "status": "approved",
      "review": {
