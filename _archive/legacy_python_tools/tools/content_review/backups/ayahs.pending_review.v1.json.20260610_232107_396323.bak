      "ayahs": [
        {
          "ref": "051/015",
          "surah": 51,
          "ayah": 15,
          "arabic": "إِنَّ ٱلْمُتَّقِينَ فِى جَنَّـٰتٍ وَعُيُونٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "051/015",
            "text": "Şüphesiz muttaki olanlar, cennetlerde ve pınarlardadırlar;"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "051/015",
            "text": "Doğrusu, Allah'a karşı gelmekten sakınanlar, Rablerinin kendilerine verdiğini almış olarak bahçelerde ve pınar başlarındadırlar. Çünkü onlar, bundan önce iyi davrananlardı."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "051/015",
            "text": "Indeed, the righteous will be among gardens and springs,"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "051/015",
            "text": "As for the God-fearing, they shall be in the midst of gardens and fountains,"
          }
        }
      ],
