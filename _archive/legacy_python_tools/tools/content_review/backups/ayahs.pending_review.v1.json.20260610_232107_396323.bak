    {
      "ref": "021/024",
      "id": "021/024",
      "surah": 21,
      "ayahStart": 24,
      "ayahEnd": 24,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 770,
        "ref": "021/024",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 272,
        "input_status": "ok",
        "input_source_ref_groups": "021/024"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "021/024"
      ],
      "ayahs": [
        {
          "ref": "021/024",
          "surah": 21,
          "ayah": 24,
          "arabic": "أَمِ ٱتَّخَذُوا۟ مِن دُونِهِۦٓ ءَالِهَةً ۖ قُلْ هَاتُوا۟ بُرْهَـٰنَكُمْ ۖ هَـٰذَا ذِكْرُ مَن مَّعِىَ وَذِكْرُ مَن قَبْلِى ۗ بَلْ أَكْثَرُهُمْ لَا يَعْلَمُونَ ٱلْحَقَّ ۖ فَهُم مُّعْرِضُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "021/024",
            "text": "Yoksa O'ndan başka ilahlar mı edindiler? De ki: \"Kesin-kanıt (burhan)ınızı getirin. İşte benimle birlikte olanların zikri (kitabı) ve benden öncekilerin de zikri.\" Hayır, onların çoğu hakkı bilmiyorlar, bundan dolayı yüz çeviriyorlar."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "021/024",
            "text": "O'nu bırakıp tanrılar mı edindiler? De ki: \"Kesin delilinizi getirin. İşte benim ve ümmetimin Kitap'ı ve senden öncekilerin kitapları.\" Hayır; onların çoğu gerçeği bilmez de yüz çevirirler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "021/024",
            "text": "Or have they taken gods besides Him? Say, [O Muhammad], \"Produce your proof. This [Qur'an] is the message for those with me and the message of those before me.\" But most of them do not know the truth, so they are turning away."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "021/024",
            "text": "Have they taken gods other than Him? Say, (O Muhammad): \"Bring forth your proof! Here is the Book with admonition for those of my time and there are also scriptures with admonition for people before me.\" But most people do not know the Truth, and have, therefore, turned away from it."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Enbiya",
      "ayah_number": 24,
      "ayah_end_number": 24,
      "text_ar": "أَمِ ٱتَّخَذُوا۟ مِن دُونِهِۦٓ ءَالِهَةً ۖ قُلْ هَاتُوا۟ بُرْهَـٰنَكُمْ ۖ هَـٰذَا ذِكْرُ مَن مَّعِىَ وَذِكْرُ مَن قَبْلِى ۗ بَلْ أَكْثَرُهُمْ لَا يَعْلَمُونَ ٱلْحَقَّ ۖ فَهُم مُّعْرِضُونَ",
      "text_tr": "Yoksa O'ndan başka ilahlar mı edindiler? De ki: \"Kesin-kanıt (burhan)ınızı getirin. İşte benimle birlikte olanların zikri (kitabı) ve benden öncekilerin de zikri.\" Hayır, onların çoğu hakkı bilmiyorlar, bundan dolayı yüz çeviriyorlar.",
