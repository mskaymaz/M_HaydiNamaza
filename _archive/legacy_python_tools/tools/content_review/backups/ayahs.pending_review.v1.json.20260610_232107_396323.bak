      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "016/082"
      ],
      "ayahs": [
        {
          "ref": "016/082",
          "surah": 16,
          "ayah": 82,
          "arabic": "فَإِن تَوَلَّوْا۟ فَإِنَّمَا عَلَيْكَ ٱلْبَلَـٰغُ ٱلْمُبِينُ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "016/082",
            "text": "Fakat onlar yüz çevirirlerse, sana düşen yalnızca apaçık bir tebliğdir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "016/082",
            "text": "Eğer yüz çevirirlerse, sana düşenin sadece açıkça tebliğ olduğunu bil."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "016/082",
            "text": "But if they turn away, [O Muhammad] - then only upon you is [responsibility for] clear notification."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "016/082",
            "text": "But if they turn away, your only duty is to clearly deliver the message of the truth."
          }
        }
      ],
      "status": "approved",
