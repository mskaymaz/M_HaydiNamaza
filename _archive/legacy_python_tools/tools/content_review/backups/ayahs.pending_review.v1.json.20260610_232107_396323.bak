      "ayahs": [
        {
          "ref": "076/015",
          "surah": 76,
          "ayah": 15,
          "arabic": "وَيُطَافُ عَلَيْهِم بِـَٔانِيَةٍ مِّن فِضَّةٍ وَأَكْوَابٍ كَانَتْ قَوَارِيرَا۠",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "076/015",
            "text": "Çevrelerinde gümüşten billur kablar, kupalar dolaştırılır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "076/015",
            "text": "Çevrelerinde gümüş kaplar ve billur kaseler dolaştırılır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "076/015",
            "text": "And there will be circulated among them vessels of silver and cups having been [created] clear [as glass],"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "076/015",
            "text": "and there shall be passed around them vessels of silver and goblets of crystal,"
          }
        },
        {
          "ref": "076/016",
          "surah": 76,
          "ayah": 16,
          "arabic": "قَوَارِيرَا۟ مِن فِضَّةٍ قَدَّرُوهَا تَقْدِيرًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "076/016",
            "text": "Gümüşten billur kaplar ki, onları belli bir ölçüyle tespit etmişlerdir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "076/016",
            "text": "Billurları gümüş gibi parlaktır, onları ölçüp ölçüp dağıtırlar."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "076/016",
            "text": "Clear glasses [made] from silver of which they have determined the measure."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "076/016",
            "text": "goblets bright as crystal but made of silver, filled to exact measure."
          }
        }
