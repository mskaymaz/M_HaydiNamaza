    {
      "id": "026/181",
      "kind": "ayah",
      "ref": "026/181",
      "ar": "أَوْفُوا۟ ٱلْكَيْلَ وَلَا تَكُونُوا۟ مِنَ ٱلْمُخْسِرِينَ",
      "tr": "\"Ölçüyü tam tutun ve eksiltenlerden olmayın.\"",
      "en": "Give full measure and do not be of those who cause loss.",
      "priority": 1,
      "surah_number": 26,
      "surah_name": "Suara",
      "ayah_number": 181,
      "ayah_end_number": 181,
      "status": "pending_review"
    },
    {
      "id": "026/182",
      "kind": "ayah",
      "ref": "026/182",
      "ar": "وَزِنُوا۟ بِٱلْقِسْطَاسِ ٱلْمُسْتَقِيمِ",
      "tr": "\"Dosdoğru olan terazi ile tartın.\"",
      "en": "And weigh with an even balance.",
      "priority": 1,
      "surah_number": 26,
      "surah_name": "Suara",
      "ayah_number": 182,
      "ayah_end_number": 182,
      "status": "pending_review"
    },
    {
      "id": "026/185",
      "kind": "ayah",
      "ref": "026/185",
      "ar": "قَالُوٓا۟ إِنَّمَآ أَنتَ مِنَ ٱلْمُسَحَّرِينَ",
      "tr": "Dediler ki: \"Sen ancak büyülenmişlerdensin”.",
      "en": "They said, \"You are only of those affected by magic.",
      "priority": 1,
      "surah_number": 26,
      "surah_name": "Suara",
      "ayah_number": 185,
      "ayah_end_number": 185,
      "status": "pending_review"
    },
    {
      "id": "026/181-182",
      "kind": "ayah",
      "ref": "026/181-182",
      "ar": "﴿181﴾ أَوْفُوا۟ ٱلْكَيْلَ وَلَا تَكُونُوا۟ مِنَ ٱلْمُخْسِرِينَ\n\n﴿182﴾ وَزِنُوا۟ بِٱلْقِسْطَاسِ ٱلْمُسْتَقِيمِ",
      "tr": "[181] \"Ölçüyü tam tutun ve eksiltenlerden olmayın.\"\n\n[182] \"Dosdoğru olan terazi ile tartın.\"",
      "en": "[181] Give full measure and do not be of those who cause loss.\n\n[182] And weigh with an even balance.",
      "priority": 1,
      "surah_number": 26,
      "surah_name": "Suara",
      "ayah_number": 181,
      "ayah_end_number": 182,
      "status": "pending_review"
    },
    {
      "id": "026/217",
      "kind": "ayah",
      "ref": "026/217",
      "ar": "وَتَوَكَّلْ عَلَى ٱلْعَزِيزِ ٱلرَّحِيمِ",
      "tr": "Sen, O güçlü ve üstün, esirgeyici olan (Allah')a tevekkül et.",
      "en": "And rely upon the Exalted in Might, the Merciful,",
      "priority": 1,
      "surah_number": 26,
      "surah_name": "Suara",
      "ayah_number": 217,
      "ayah_end_number": 217,
      "status": "pending_review"
    },
    {
      "id": "026/218",
      "kind": "ayah",
      "ref": "026/218",
      "ar": "ٱلَّذِى يَرَىٰكَ حِينَ تَقُومُ",
      "tr": "O, kıyam ettiğin zaman seni görüyor.",
      "en": "Who sees you when you arise",
      "priority": 1,
      "surah_number": 26,
      "surah_name": "Suara",
      "ayah_number": 218,
      "ayah_end_number": 218,
      "status": "pending_review"
    },
    {
      "id": "026/221",
      "kind": "ayah",
      "ref": "026/221",
      "ar": "هَلْ أُنَبِّئُكُمْ عَلَىٰ مَن تَنَزَّلُ ٱلشَّيَـٰطِينُ",
      "tr": "Şeytanların kimlere inmekte olduklarını size haber vereyim mi?",
      "en": "Shall I inform you upon whom the devils descend?",
      "priority": 1,
      "surah_number": 26,
      "surah_name": "Suara",
      "ayah_number": 221,
      "ayah_end_number": 221,
      "status": "pending_review"
    },
    {
      "id": "026/217-218",
      "kind": "ayah",
      "ref": "026/217-218",
      "ar": "﴿217﴾ وَتَوَكَّلْ عَلَى ٱلْعَزِيزِ ٱلرَّحِيمِ\n\n﴿218﴾ ٱلَّذِى يَرَىٰكَ حِينَ تَقُومُ",
      "tr": "[217] Sen, O güçlü ve üstün, esirgeyici olan (Allah')a tevekkül et.\n\n[218] O, kıyam ettiğin zaman seni görüyor.",
      "en": "[217] And rely upon the Exalted in Might, the Merciful,\n\n[218] Who sees you when you arise",
      "priority": 1,
      "surah_number": 26,
      "surah_name": "Suara",
      "ayah_number": 217,
      "ayah_end_number": 218,
      "status": "pending_review"
    },
    {
      "id": "026/222",
      "kind": "ayah",
      "ref": "026/222",
      "ar": "تَنَزَّلُ عَلَىٰ كُلِّ أَفَّاكٍ أَثِيمٍ",
      "tr": "Onlar, 'gerçeği ters yüz eden,' günaha düşkün olan her yalancıya inerler.",
      "en": "They descend upon every sinful liar.",
      "priority": 1,
      "surah_number": 26,
      "surah_name": "Suara",
      "ayah_number": 222,
      "ayah_end_number": 222,
      "status": "pending_review"
    },
    {
      "id": "026/223",
      "kind": "ayah",
      "ref": "026/223",
      "ar": "يُلْقُونَ ٱلسَّمْعَ وَأَكْثَرُهُمْ كَـٰذِبُونَ",
      "tr": "Bunlar (şeytanlara) kulak verirler ve çoğu yalan söylemektedirler.",
      "en": "They pass on what is heard, and most of them are liars.",
      "priority": 1,
      "surah_number": 26,
      "surah_name": "Suara",
      "ayah_number": 223,
      "ayah_end_number": 223,
      "status": "pending_review"
    },
    {
      "id": "027/004",
      "kind": "ayah",
      "ref": "027/004",
      "ar": "إِنَّ ٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْءَاخِرَةِ زَيَّنَّا لَهُمْ أَعْمَـٰلَهُمْ فَهُمْ يَعْمَهُونَ",
      "tr": "Ahirete inanmayanlara gelince; Biz onlara kendi yaptıklarını süslemişiz, böylece onlar, 'körlük içinde şaşkınca dolaşırlar'.",
      "en": "Indeed, for those who do not believe in the Hereafter, We have made pleasing to them their deeds, so they wander blindly.",
      "priority": 1,
      "surah_number": 27,
      "surah_name": "Neml",
      "ayah_number": 4,
      "ayah_end_number": 4,
      "status": "pending_review"
    },
    {
      "id": "027/013",
      "kind": "ayah",
      "ref": "027/013",
      "ar": "فَلَمَّا جَآءَتْهُمْ ءَايَـٰتُنَا مُبْصِرَةً قَالُوا۟ هَـٰذَا سِحْرٌ مُّبِينٌ",
      "tr": "Ayetlerimiz onlara, gözler önünde sergilenmiş olarak gelince dediler ki: \"Bu, apaçık olan bir büyüdür.\"",
      "en": "But when there came to them Our visible signs, they said, \"This is obvious magic.\"",
      "priority": 1,
      "surah_number": 27,
      "surah_name": "Neml",
      "ayah_number": 13,
      "ayah_end_number": 13,
      "status": "pending_review"
    },
    {
      "id": "027/023",
      "kind": "ayah",
      "ref": "027/023",
      "ar": "إِنِّى وَجَدتُّ ٱمْرَأَةً تَمْلِكُهُمْ وَأُوتِيَتْ مِن كُلِّ شَىْءٍ وَلَهَا عَرْشٌ عَظِيمٌ",
      "tr": "\"Gerçekten ben, onlara hükmetmekte olan bir kadın buldum ki, ona herşeyden (bolca) verilmiştir ve büyük bir tahtı var.\"",
      "en": "Indeed, I found [there] a woman ruling them, and she has been given of all things, and she has a great throne.",
      "priority": 1,
      "surah_number": 27,
      "surah_name": "Neml",
      "ayah_number": 23,
      "ayah_end_number": 23,
      "status": "pending_review"
    },
    {
      "id": "027/029",
      "kind": "ayah",
      "ref": "027/029",
      "ar": "قَالَتْ يَـٰٓأَيُّهَا ٱلْمَلَؤُا۟ إِنِّىٓ أُلْقِىَ إِلَىَّ كِتَـٰبٌ كَرِيمٌ",
      "tr": "(Hüdhüd'ün mektubu götürüp bırakmasından sonra Saba melikesi Belkıs:) Dedi ki: \"Ey önde gelenler gerçekten bana oldukça önemli bir mektup bırakıldı.\"",
      "en": "She said, \"O eminent ones, indeed, to me has been delivered a noble letter.",
      "priority": 1,
      "surah_number": 27,
      "surah_name": "Neml",
      "ayah_number": 29,
      "ayah_end_number": 29,
      "status": "pending_review"
    },
    {
      "id": "027/032",
      "kind": "ayah",
      "ref": "027/032",
      "ar": "قَالَتْ يَـٰٓأَيُّهَا ٱلْمَلَؤُا۟ أَفْتُونِى فِىٓ أَمْرِى مَا كُنتُ قَاطِعَةً أَمْرًا حَتَّىٰ تَشْهَدُونِ",
      "tr": "Dedi ki: \"Ey önde gelenler, bu işimde bana görüş belirtin, siz (herşeye) şahidlik etmedikçe ben hiçbir işte kesin (karar veren biri) değilim.\"",
      "en": "She said, \"O eminent ones, advise me in my affair. I would not decide a matter until you witness [for] me.\"",
      "priority": 1,
      "surah_number": 27,
      "surah_name": "Neml",
      "ayah_number": 32,
      "ayah_end_number": 32,
      "status": "pending_review"
    },
    {
      "id": "027/033",
      "kind": "ayah",
      "ref": "027/033",
      "ar": "قَالُوا۟ نَحْنُ أُو۟لُوا۟ قُوَّةٍ وَأُو۟لُوا۟ بَأْسٍ شَدِيدٍ وَٱلْأَمْرُ إِلَيْكِ فَٱنظُرِى مَاذَا تَأْمُرِينَ",
      "tr": "Dediler ki: \"Biz kuvvet sahibiyiz ve zorlu savaşçılarız. İş konusunda karar senindir, artık sen bak, neyi emredersen (biz uygularız).",
      "en": "They said, \"We are men of strength and of great military might, but the command is yours, so see what you will command.\"",
      "priority": 1,
      "surah_number": 27,
      "surah_name": "Neml",
      "ayah_number": 33,
      "ayah_end_number": 33,
      "status": "pending_review"
    },
    {
      "id": "027/034",
      "kind": "ayah",
      "ref": "027/034",
      "ar": "قَالَتْ إِنَّ ٱلْمُلُوكَ إِذَا دَخَلُوا۟ قَرْيَةً أَفْسَدُوهَا وَجَعَلُوٓا۟ أَعِزَّةَ أَهْلِهَآ أَذِلَّةً ۖ وَكَذَٰلِكَ يَفْعَلُونَ",
      "tr": "Dedi ki: \"Gerçekten hükümdarlar bir ülkeye girdikleri zaman, orasını bozguna uğratırlar ve halkından onur sahibi olanları hor ve aşağılık kılarlar; işte onlar, böyle yaparlar.\"",
      "en": "She said, \"Indeed kings - when they enter a city, they ruin it and render the honored of its people humbled. And thus do they do.",
      "priority": 1,
      "surah_number": 27,
      "surah_name": "Neml",
      "ayah_number": 34,
      "ayah_end_number": 34,
      "status": "pending_review"
    },
    {
      "id": "027/035",
      "kind": "ayah",
      "ref": "027/035",
      "ar": "وَإِنِّى مُرْسِلَةٌ إِلَيْهِم بِهَدِيَّةٍ فَنَاظِرَةٌۢ بِمَ يَرْجِعُ ٱلْمُرْسَلُونَ",
      "tr": "\"Ben onlara bir hediye göndereyim de, bir bakayım elçiler neyle dönerler.\"",
      "en": "But indeed, I will send to them a gift and see with what [reply] the messengers will return.\"",
      "priority": 1,
      "surah_number": 27,
      "surah_name": "Neml",
      "ayah_number": 35,
      "ayah_end_number": 35,
      "status": "pending_review"
    },
    {
      "id": "027/044",
      "kind": "ayah",
      "ref": "027/044",
      "ar": "قِيلَ لَهَا ٱدْخُلِى ٱلصَّرْحَ ۖ فَلَمَّا رَأَتْهُ حَسِبَتْهُ لُجَّةً وَكَشَفَتْ عَن سَاقَيْهَا ۚ قَالَ إِنَّهُۥ صَرْحٌ مُّمَرَّدٌ مِّن قَوَارِيرَ ۗ قَالَتْ رَبِّ إِنِّى ظَلَمْتُ نَفْسِى وَأَسْلَمْتُ مَعَ سُلَيْمَـٰنَ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ",
      "tr": "Ona: \"Köşke gir\" denildi. Onu görünce derin bir su sandı ve (eteğini çekerek) ayaklarını açtı. (Süleyman:) Dedi ki: \"Gerçekte bu, saydam camdan olma düzeltilmiş bir köşk-zemindir.\" Dedi ki: \"Rabbim, gerçekten ben kendime zulmettim; (artık) ben Süleyman'la birlikte alemlerin Rabbi olan Allah'a teslim oldum.\"",
      "en": "She was told, \"Enter the palace.\" But when she saw it, she thought it was a body of water and uncovered her shins [to wade through]. He said, \"Indeed, it is a palace [whose floor is] made smooth with glass.\" She said, \"My Lord, indeed I have wronged myself, and I submit with Solomon to Allah, Lord of the worlds.\"",
      "priority": 1,
      "surah_number": 27,
      "surah_name": "Neml",
      "ayah_number": 44,
      "ayah_end_number": 44,
      "status": "pending_review"
    },
    {
      "id": "027/032-035",
      "kind": "ayah",
      "ref": "027/032-035",
      "ar": "﴿32﴾ قَالَتْ يَـٰٓأَيُّهَا ٱلْمَلَؤُا۟ أَفْتُونِى فِىٓ أَمْرِى مَا كُنتُ قَاطِعَةً أَمْرًا حَتَّىٰ تَشْهَدُونِ\n\n﴿33﴾ قَالُوا۟ نَحْنُ أُو۟لُوا۟ قُوَّةٍ وَأُو۟لُوا۟ بَأْسٍ شَدِيدٍ وَٱلْأَمْرُ إِلَيْكِ فَٱنظُرِى مَاذَا تَأْمُرِينَ\n\n﴿34﴾ قَالَتْ إِنَّ ٱلْمُلُوكَ إِذَا دَخَلُوا۟ قَرْيَةً أَفْسَدُوهَا وَجَعَلُوٓا۟ أَعِزَّةَ أَهْلِهَآ أَذِلَّةً ۖ وَكَذَٰلِكَ يَفْعَلُونَ\n\n﴿35﴾ وَإِنِّى مُرْسِلَةٌ إِلَيْهِم بِهَدِيَّةٍ فَنَاظِرَةٌۢ بِمَ يَرْجِعُ ٱلْمُرْسَلُونَ",
      "tr": "[32] Dedi ki: \"Ey önde gelenler, bu işimde bana görüş belirtin, siz (herşeye) şahidlik etmedikçe ben hiçbir işte kesin (karar veren biri) değilim.\"\n\n[33] Dediler ki: \"Biz kuvvet sahibiyiz ve zorlu savaşçılarız. İş konusunda karar senindir, artık sen bak, neyi emredersen (biz uygularız).\n\n[34] Dedi ki: \"Gerçekten hükümdarlar bir ülkeye girdikleri zaman, orasını bozguna uğratırlar ve halkından onur sahibi olanları hor ve aşağılık kılarlar; işte onlar, böyle yaparlar.\"\n\n[35] \"Ben onlara bir hediye göndereyim de, bir bakayım elçiler neyle dönerler.\"",
      "en": "[32] She said, \"O eminent ones, advise me in my affair. I would not decide a matter until you witness [for] me.\"\n\n[33] They said, \"We are men of strength and of great military might, but the command is yours, so see what you will command.\"\n\n[34] She said, \"Indeed kings - when they enter a city, they ruin it and render the honored of its people humbled. And thus do they do.\n\n[35] But indeed, I will send to them a gift and see with what [reply] the messengers will return.\"",
      "priority": 1,
      "surah_number": 27,
      "surah_name": "Neml",
      "ayah_number": 32,
      "ayah_end_number": 35,
      "status": "pending_review"
    },
    {
      "id": "027/048",
      "kind": "ayah",
      "ref": "027/048",
      "ar": "وَكَانَ فِى ٱلْمَدِينَةِ تِسْعَةُ رَهْطٍ يُفْسِدُونَ فِى ٱلْأَرْضِ وَلَا يُصْلِحُونَ",
      "tr": "Şehirde dokuzlu bir çete vardı, yeryüzünde bozgun çıkarıyorlar ve dirlik-düzenlik bırakmıyorlardı.",
      "en": "And there were in the city nine family heads causing corruption in the land and not amending [its affairs].",
      "priority": 1,
      "surah_number": 27,
      "surah_name": "Neml",
      "ayah_number": 48,
      "ayah_end_number": 48,
      "status": "pending_review"
    },
    {
      "id": "027/050",
      "kind": "ayah",
      "ref": "027/050",
      "ar": "وَمَكَرُوا۟ مَكْرًا وَمَكَرْنَا مَكْرًا وَهُمْ لَا يَشْعُرُونَ",
      "tr": "Onlar hileli bir düzen kurdu. Biz de (onların hilesine karşı) onların farkında olmadığı bir düzen kurduk.",
      "en": "And they planned a plan, and We planned a plan, while they perceived not.",
      "priority": 1,
      "surah_number": 27,
      "surah_name": "Neml",
      "ayah_number": 50,
      "ayah_end_number": 50,
      "status": "pending_review"
    },
    {
      "id": "027/051",
      "kind": "ayah",
      "ref": "027/051",
      "ar": "فَٱنظُرْ كَيْفَ كَانَ عَـٰقِبَةُ مَكْرِهِمْ أَنَّا دَمَّرْنَـٰهُمْ وَقَوْمَهُمْ أَجْمَعِينَ",
      "tr": "Artık sen, onların kurdukları hileli-düzenin uğradığı sona bir bak; Biz, onları ve kavimlerini topluca yerle bir ettik.",
      "en": "Then look how was the outcome of their plan - that We destroyed them and their people, all.",
      "priority": 1,
      "surah_number": 27,
      "surah_name": "Neml",
      "ayah_number": 51,
      "ayah_end_number": 51,
      "status": "pending_review"
    },
    {
      "id": "027/054",
      "kind": "ayah",
      "ref": "027/054",
      "ar": "وَلُوطًا إِذْ قَالَ لِقَوْمِهِۦٓ أَتَأْتُونَ ٱلْفَـٰحِشَةَ وَأَنتُمْ تُبْصِرُونَ",
      "tr": "Lut da; hani kavmine demişti ki: \"Siz, açıkça gördüğünüz halde, yine de o çirkin utanmazlığı yapacak mısınız?\"",
      "en": "And [mention] Lot, when he said to his people, \"Do you commit immorality while you are seeing?",
      "priority": 1,
      "surah_number": 27,
      "surah_name": "Neml",
      "ayah_number": 54,
      "ayah_end_number": 54,
      "status": "pending_review"
    },
    {
      "id": "027/050-051",
      "kind": "ayah",
      "ref": "027/050-051",
      "ar": "﴿50﴾ وَمَكَرُوا۟ مَكْرًا وَمَكَرْنَا مَكْرًا وَهُمْ لَا يَشْعُرُونَ\n\n﴿51﴾ فَٱنظُرْ كَيْفَ كَانَ عَـٰقِبَةُ مَكْرِهِمْ أَنَّا دَمَّرْنَـٰهُمْ وَقَوْمَهُمْ أَجْمَعِينَ",
      "tr": "[50] Onlar hileli bir düzen kurdu. Biz de (onların hilesine karşı) onların farkında olmadığı bir düzen kurduk.\n\n[51] Artık sen, onların kurdukları hileli-düzenin uğradığı sona bir bak; Biz, onları ve kavimlerini topluca yerle bir ettik.",
      "en": "[50] And they planned a plan, and We planned a plan, while they perceived not.\n\n[51] Then look how was the outcome of their plan - that We destroyed them and their people, all.",
      "priority": 1,
      "surah_number": 27,
      "surah_name": "Neml",
      "ayah_number": 50,
      "ayah_end_number": 51,
      "status": "pending_review"
    },
    {
      "id": "027/055",
      "kind": "ayah",
      "ref": "027/055",
      "ar": "أَئِنَّكُمْ لَتَأْتُونَ ٱلرِّجَالَ شَهْوَةً مِّن دُونِ ٱلنِّسَآءِ ۚ بَلْ أَنتُمْ قَوْمٌ تَجْهَلُونَ",
      "tr": "\"Siz gerçekten, kadınları bırakıp şehvetle erkeklere mi yaklaşıyorsunuz? Hayır, siz (yaptığı şeyi) bilmeyen bir kavimsiniz.\"",
      "en": "Do you indeed approach men with desire instead of women? Rather, you are a people behaving ignorantly.\"",
      "priority": 1,
      "surah_number": 27,
      "surah_name": "Neml",
      "ayah_number": 55,
      "ayah_end_number": 55,
      "status": "pending_review"
    },
    {
      "id": "027/069",
      "kind": "ayah",
      "ref": "027/069",
      "ar": "قُلْ سِيرُوا۟ فِى ٱلْأَرْضِ فَٱنظُرُوا۟ كَيْفَ كَانَ عَـٰقِبَةُ ٱلْمُجْرِمِينَ",
      "tr": "De ki: \"Yeryüzünde gezip dolaşın da, suçlu-günahkarların nasıl bir sona uğradıklarını görün\"",
      "en": "Say, [O Muhammad], \"Travel through the land and observe how was the end of the criminals.\"",
      "priority": 1,
      "surah_number": 27,
      "surah_name": "Neml",
      "ayah_number": 69,
      "ayah_end_number": 69,
      "status": "pending_review"
    },
    {
      "id": "027/054-055",
      "kind": "ayah",
      "ref": "027/054-055",
      "ar": "﴿54﴾ وَلُوطًا إِذْ قَالَ لِقَوْمِهِۦٓ أَتَأْتُونَ ٱلْفَـٰحِشَةَ وَأَنتُمْ تُبْصِرُونَ\n\n﴿55﴾ أَئِنَّكُمْ لَتَأْتُونَ ٱلرِّجَالَ شَهْوَةً مِّن دُونِ ٱلنِّسَآءِ ۚ بَلْ أَنتُمْ قَوْمٌ تَجْهَلُونَ",
      "tr": "[54] Lut da; hani kavmine demişti ki: \"Siz, açıkça gördüğünüz halde, yine de o çirkin utanmazlığı yapacak mısınız?\"\n\n[55] \"Siz gerçekten, kadınları bırakıp şehvetle erkeklere mi yaklaşıyorsunuz? Hayır, siz (yaptığı şeyi) bilmeyen bir kavimsiniz.\"",
      "en": "[54] And [mention] Lot, when he said to his people, \"Do you commit immorality while you are seeing?\n\n[55] Do you indeed approach men with desire instead of women? Rather, you are a people behaving ignorantly.\"",
      "priority": 1,
      "surah_number": 27,
      "surah_name": "Neml",
      "ayah_number": 54,
      "ayah_end_number": 55,
      "status": "pending_review"
    },
    {
      "id": "027/076",
      "kind": "ayah",
      "ref": "027/076",
      "ar": "إِنَّ هَـٰذَا ٱلْقُرْءَانَ يَقُصُّ عَلَىٰ بَنِىٓ إِسْرَٰٓءِيلَ أَكْثَرَ ٱلَّذِى هُمْ فِيهِ يَخْتَلِفُونَ",
      "tr": "Gerçek şu ki, bu Kur'an, İsrailoğulları'na hakkında ayrılığa düştükleri şeylerin bir çoğunu aktarıp anlatıyor.",
      "en": "Indeed, this Qur'an relates to the Children of Israel most of that over which they disagree.",
      "priority": 1,
      "surah_number": 27,
      "surah_name": "Neml",
      "ayah_number": 76,
      "ayah_end_number": 76,
      "status": "pending_review"
    },
    {
      "id": "027/087",
      "kind": "ayah",
      "ref": "027/087",
      "ar": "وَيَوْمَ يُنفَخُ فِى ٱلصُّورِ فَفَزِعَ مَن فِى ٱلسَّمَـٰوَٰتِ وَمَن فِى ٱلْأَرْضِ إِلَّا مَن شَآءَ ٱللَّهُ ۚ وَكُلٌّ أَتَوْهُ دَٰخِرِينَ",
      "tr": "Sur'a üfürüleceği gün, Allah'ın dilediği kimseler dışında, göklerde ve yerde olan herkes artık korkuya kapılmıştır ve her biri 'boyun bükmüş' olarak O'na gelmişlerdir.",
      "en": "And [warn of] the Day the Horn will be blown, and whoever is in the heavens and whoever is on the earth will be terrified except whom Allah wills. And all will come to Him humbled.",
      "priority": 1,
      "surah_number": 27,
      "surah_name": "Neml",
      "ayah_number": 87,
      "ayah_end_number": 87,
      "status": "pending_review"
    },
    {
      "id": "027/088",
      "kind": "ayah",
      "ref": "027/088",
      "ar": "وَتَرَى ٱلْجِبَالَ تَحْسَبُهَا جَامِدَةً وَهِىَ تَمُرُّ مَرَّ ٱلسَّحَابِ ۚ صُنْعَ ٱللَّهِ ٱلَّذِىٓ أَتْقَنَ كُلَّ شَىْءٍ ۚ إِنَّهُۥ خَبِيرٌۢ بِمَا تَفْعَلُونَ",
      "tr": "Dağları görürsün de, donmuş sanırsın; oysa onlar bulutların sürüklenmesi gibi sürüklenirler. Herşeyi 'sapasağlam ve yerli yerinde yapan' Allah'ın sanatı (yapısı)dır (bu). Şüphesiz O, işlediklerinizden haberdardır.",
      "en": "And you see the mountains, thinking them rigid, while they will pass as the passing of clouds. [It is] the work of Allah, who perfected all things. Indeed, He is Acquainted with that which you do.",
      "priority": 1,
      "surah_number": 27,
      "surah_name": "Neml",
      "ayah_number": 88,
      "ayah_end_number": 88,
      "status": "pending_review"
    },
    {
      "id": "028/005",
      "kind": "ayah",
      "ref": "028/005",
      "ar": "وَنُرِيدُ أَن نَّمُنَّ عَلَى ٱلَّذِينَ ٱسْتُضْعِفُوا۟ فِى ٱلْأَرْضِ وَنَجْعَلَهُمْ أَئِمَّةً وَنَجْعَلَهُمُ ٱلْوَٰرِثِينَ",
      "tr": "Biz ise, yeryüzünde güçten düşürülenlere lütufta bulunmak, onları önderler yapmak ve mirasçılar kılmak istiyoruz.",
      "en": "And We wanted to confer favor upon those who were oppressed in the land and make them leaders and make them inheritors",
      "priority": 1,
      "surah_number": 28,
      "surah_name": "Kasas",
      "ayah_number": 5,
      "ayah_end_number": 5,
      "status": "pending_review"
    },
    {
      "id": "028/014",
      "kind": "ayah",
      "ref": "028/014",
      "ar": "وَلَمَّا بَلَغَ أَشُدَّهُۥ وَٱسْتَوَىٰٓ ءَاتَيْنَـٰهُ حُكْمًا وَعِلْمًا ۚ وَكَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ",
      "tr": "O, erginlik çağına ulaşıp olgunlaşınca, ona bir 'hüküm ve hikmet' ve ilim verdik. Biz iyilikte bulunanları işte böyle ödüllendiririz.",
      "en": "And when he attained his full strength and was [mentally] mature, We bestowed upon him judgement and knowledge. And thus do We reward the doers of good.",
      "priority": 1,
      "surah_number": 28,
      "surah_name": "Kasas",
      "ayah_number": 14,
      "ayah_end_number": 14,
      "status": "pending_review"
    },
    {
      "id": "028/050",
      "kind": "ayah",
      "ref": "028/050",
      "ar": "فَإِن لَّمْ يَسْتَجِيبُوا۟ لَكَ فَٱعْلَمْ أَنَّمَا يَتَّبِعُونَ أَهْوَآءَهُمْ ۚ وَمَنْ أَضَلُّ مِمَّنِ ٱتَّبَعَ هَوَىٰهُ بِغَيْرِ هُدًى مِّنَ ٱللَّهِ ۚ إِنَّ ٱللَّهَ لَا يَهْدِى ٱلْقَوْمَ ٱلظَّـٰلِمِينَ",
      "tr": "Buna rağmen sana icabet etmeyecek olurlarsa, artık bil ki, onlar, gerçekten kendi heva (istek ve tutku)larına uymaktadırlar. Oysa Allah'tan bir kılavuz (doğru yol gösterici) olmaksızın, kendi istek ve tutkularına (hevasına) uyandan daha sapık kimdir? Şüphesiz Allah, zulmeden bir kavme hidayet vermez.",
      "en": "But if they do not respond to you - then know that they only follow their [own] desires. And who is more astray than one who follows his desire without guidance from Allah? Indeed, Allah does not guide the wrongdoing people.",
      "priority": 1,
      "surah_number": 28,
      "surah_name": "Kasas",
      "ayah_number": 50,
      "ayah_end_number": 50,
      "status": "pending_review"
    },
    {
      "id": "028/055",
      "kind": "ayah",
      "ref": "028/055",
      "ar": "وَإِذَا سَمِعُوا۟ ٱللَّغْوَ أَعْرَضُوا۟ عَنْهُ وَقَالُوا۟ لَنَآ أَعْمَـٰلُنَا وَلَكُمْ أَعْمَـٰلُكُمْ سَلَـٰمٌ عَلَيْكُمْ لَا نَبْتَغِى ٱلْجَـٰهِلِينَ",
      "tr": "'Boş ve yararsız olan sözü' işittikleri zaman ondan yüz çevirirler ve: \"Bizim yapıp-ettiklerimiz bizim, sizin yapıp-ettikleriniz sizindir; size selam olsun, biz cahilleri benimsemeyiz\" derler.",
      "en": "And when they hear ill speech, they turn away from it and say, \"For us are our deeds, and for you are your deeds. Peace will be upon you; we seek not the ignorant.\"",
      "priority": 1,
      "surah_number": 28,
      "surah_name": "Kasas",
      "ayah_number": 55,
      "ayah_end_number": 55,
      "status": "pending_review"
    },
    {
      "id": "028/056",
      "kind": "ayah",
      "ref": "028/056",
      "ar": "إِنَّكَ لَا تَهْدِى مَنْ أَحْبَبْتَ وَلَـٰكِنَّ ٱللَّهَ يَهْدِى مَن يَشَآءُ ۚ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ",
      "tr": "Gerçek şu ki, sen, sevdiğini hidayete erdiremezsin, ancak Allah, dilediğini hidayete erdirir; O, hidayete erecek olanları daha iyi bilendir.",
      "en": "Indeed, [O Muhammad], you do not guide whom you like, but Allah guides whom He wills. And He is most knowing of the [rightly] guided.",
      "priority": 1,
      "surah_number": 28,
      "surah_name": "Kasas",
      "ayah_number": 56,
      "ayah_end_number": 56,
      "status": "pending_review"
    },
    {
      "id": "028/058",
      "kind": "ayah",
      "ref": "028/058",
      "ar": "وَكَمْ أَهْلَكْنَا مِن قَرْيَةٍۭ بَطِرَتْ مَعِيشَتَهَا ۖ فَتِلْكَ مَسَـٰكِنُهُمْ لَمْ تُسْكَن مِّنۢ بَعْدِهِمْ إِلَّا قَلِيلًا ۖ وَكُنَّا نَحْنُ ٱلْوَٰرِثِينَ",
      "tr": "Biz, yaşama biçimleriyle 'refah içinde şımarıp azmış' nice şehri yıkıma uğrattık. İşte meskenleri; çok az (bir zaman) dışında (onlarda) kendilerinden sonra oturulabilmiş değildir. (Onlara) Varis olanlar Biziz.",
      "en": "And how many a city have We destroyed that was insolent in its [way of] living, and those are their dwellings which have not been inhabited after them except briefly. And it is We who were the inheritors.",
      "priority": 1,
      "surah_number": 28,
      "surah_name": "Kasas",
      "ayah_number": 58,
      "ayah_end_number": 58,
      "status": "pending_review"
    },
    {
      "id": "028/055-056",
      "kind": "ayah",
      "ref": "028/055-056",
      "ar": "﴿55﴾ وَإِذَا سَمِعُوا۟ ٱللَّغْوَ أَعْرَضُوا۟ عَنْهُ وَقَالُوا۟ لَنَآ أَعْمَـٰلُنَا وَلَكُمْ أَعْمَـٰلُكُمْ سَلَـٰمٌ عَلَيْكُمْ لَا نَبْتَغِى ٱلْجَـٰهِلِينَ\n\n﴿56﴾ إِنَّكَ لَا تَهْدِى مَنْ أَحْبَبْتَ وَلَـٰكِنَّ ٱللَّهَ يَهْدِى مَن يَشَآءُ ۚ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ",
      "tr": "[55] 'Boş ve yararsız olan sözü' işittikleri zaman ondan yüz çevirirler ve: \"Bizim yapıp-ettiklerimiz bizim, sizin yapıp-ettikleriniz sizindir; size selam olsun, biz cahilleri benimsemeyiz\" derler.\n\n[56] Gerçek şu ki, sen, sevdiğini hidayete erdiremezsin, ancak Allah, dilediğini hidayete erdirir; O, hidayete erecek olanları daha iyi bilendir.",
      "en": "[55] And when they hear ill speech, they turn away from it and say, \"For us are our deeds, and for you are your deeds. Peace will be upon you; we seek not the ignorant.\"\n\n[56] Indeed, [O Muhammad], you do not guide whom you like, but Allah guides whom He wills. And He is most knowing of the [rightly] guided.",
      "priority": 1,
      "surah_number": 28,
      "surah_name": "Kasas",
      "ayah_number": 55,
      "ayah_end_number": 56,
      "status": "pending_review"
    },
    {
      "id": "028/060",
      "kind": "ayah",
      "ref": "028/060",
      "ar": "وَمَآ أُوتِيتُم مِّن شَىْءٍ فَمَتَـٰعُ ٱلْحَيَوٰةِ ٱلدُّنْيَا وَزِينَتُهَا ۚ وَمَا عِندَ ٱللَّهِ خَيْرٌ وَأَبْقَىٰٓ ۚ أَفَلَا تَعْقِلُونَ",
      "tr": "Size verilen herşey, yalnızca dünya hayatının metaı ve süsüdür. Allah Katında olan ise, daha hayırlı ve daha süreklidir. Yine de, akıllanmayacak mısınız?",
      "en": "And whatever thing you [people] have been given - it is [only for] the enjoyment of worldly life and its adornment. And what is with Allah is better and more lasting; so will you not use reason?",
      "priority": 1,
      "surah_number": 28,
      "surah_name": "Kasas",
      "ayah_number": 60,
      "ayah_end_number": 60,
      "status": "pending_review"
    },
    {
      "id": "028/070",
      "kind": "ayah",
      "ref": "028/070",
      "ar": "وَهُوَ ٱللَّهُ لَآ إِلَـٰهَ إِلَّا هُوَ ۖ لَهُ ٱلْحَمْدُ فِى ٱلْأُولَىٰ وَٱلْءَاخِرَةِ ۖ وَلَهُ ٱلْحُكْمُ وَإِلَيْهِ تُرْجَعُونَ",
      "tr": "O, Allah'tır, Kendisi'nden başka İlah yoktur. İlkte de, sonda da hamd O'nundur. Hüküm O'nundur ve O'na döndürüleceksiniz.",
      "en": "And He is Allah; there is no deity except Him. To Him is [due all] praise in the first [life] and the Hereafter. And His is the [final] decision, and to Him you will be returned.",
      "priority": 1,
      "surah_number": 28,
      "surah_name": "Kasas",
      "ayah_number": 70,
      "ayah_end_number": 70,
      "status": "pending_review"
    },
    {
      "id": "028/073",
      "kind": "ayah",
      "ref": "028/073",
      "ar": "وَمِن رَّحْمَتِهِۦ جَعَلَ لَكُمُ ٱلَّيْلَ وَٱلنَّهَارَ لِتَسْكُنُوا۟ فِيهِ وَلِتَبْتَغُوا۟ مِن فَضْلِهِۦ وَلَعَلَّكُمْ تَشْكُرُونَ",
      "tr": "Kendi rahmetinden olmak üzere O, sizin için, dinlenmeniz ve O'nun fazlından (geçiminizi) aramanız için geceyi ve gündüzü var etti. Umulur ki şükredersiniz.",
      "en": "And out of His mercy He made for you the night and the day that you may rest therein and [by day] seek from His bounty and [that] perhaps you will be grateful.",
      "priority": 1,
      "surah_number": 28,
      "surah_name": "Kasas",
      "ayah_number": 73,
      "ayah_end_number": 73,
      "status": "pending_review"
    },
    {
      "id": "028/077",
      "kind": "ayah",
      "ref": "028/077",
      "ar": "وَٱبْتَغِ فِيمَآ ءَاتَىٰكَ ٱللَّهُ ٱلدَّارَ ٱلْءَاخِرَةَ ۖ وَلَا تَنسَ نَصِيبَكَ مِنَ ٱلدُّنْيَا ۖ وَأَحْسِن كَمَآ أَحْسَنَ ٱللَّهُ إِلَيْكَ ۖ وَلَا تَبْغِ ٱلْفَسَادَ فِى ٱلْأَرْضِ ۖ إِنَّ ٱللَّهَ لَا يُحِبُّ ٱلْمُفْسِدِينَ",
      "tr": "\"Allah'ın sana verdiğiyle ahiret yurdunu ara, dünyadan da kendi payını (nasibini) unutma. Allah'ın sana ihsan ettiği gibi, sen de ihsanda bulun ve yeryüzünde bozgunculuk arama. Çünkü Allah, bozgunculuk yapanları sevmez.\"",
      "en": "But seek, through that which Allah has given you, the home of the Hereafter; and [yet], do not forget your share of the world. And do good as Allah has done good to you. And desire not corruption in the land. Indeed, Allah does not like corrupters.\"",
      "priority": 1,
      "surah_number": 28,
      "surah_name": "Kasas",
      "ayah_number": 77,
      "ayah_end_number": 77,
      "status": "pending_review"
    },
    {
      "id": "028/084",
      "kind": "ayah",
      "ref": "028/084",
      "ar": "مَن جَآءَ بِٱلْحَسَنَةِ فَلَهُۥ خَيْرٌ مِّنْهَا ۖ وَمَن جَآءَ بِٱلسَّيِّئَةِ فَلَا يُجْزَى ٱلَّذِينَ عَمِلُوا۟ ٱلسَّيِّـَٔاتِ إِلَّا مَا كَانُوا۟ يَعْمَلُونَ",
      "tr": "Kim bir iyilikle gelirse, artık onun için daha hayırlısı vardır; kim bir kötülükle gelirse, artık kötülükleri yapanlar, yalnızca yaptıklarıyla karşılık görürler.",
      "en": "Whoever comes [on the Day of Judgement] with a good deed will have better than it; and whoever comes with an evil deed - then those who did evil deeds will not be recompensed except [as much as] what they used to do.",
      "priority": 1,
      "surah_number": 28,
      "surah_name": "Kasas",
      "ayah_number": 84,
      "ayah_end_number": 84,
      "status": "pending_review"
    },
    {
      "id": "028/087",
      "kind": "ayah",
      "ref": "028/087",
      "ar": "وَلَا يَصُدُّنَّكَ عَنْ ءَايَـٰتِ ٱللَّهِ بَعْدَ إِذْ أُنزِلَتْ إِلَيْكَ ۖ وَٱدْعُ إِلَىٰ رَبِّكَ ۖ وَلَا تَكُونَنَّ مِنَ ٱلْمُشْرِكِينَ",
      "tr": "Sana indirildikten sonra, sakın seni Allah'ın ayetlerinden alıkoymasınlar. Sen Rabbine çağır ve sakın müşriklerden olma.",
      "en": "And never let them avert you from the verses of Allah after they have been revealed to you. And invite [people] to your Lord. And never be of those who associate others with Allah.",
      "priority": 1,
      "surah_number": 28,
      "surah_name": "Kasas",
      "ayah_number": 87,
      "ayah_end_number": 87,
      "status": "pending_review"
    },
    {
      "id": "028/088",
      "kind": "ayah",
      "ref": "028/088",
      "ar": "وَلَا تَدْعُ مَعَ ٱللَّهِ إِلَـٰهًا ءَاخَرَ ۘ لَآ إِلَـٰهَ إِلَّا هُوَ ۚ كُلُّ شَىْءٍ هَالِكٌ إِلَّا وَجْهَهُۥ ۚ لَهُ ٱلْحُكْمُ وَإِلَيْهِ تُرْجَعُونَ",
      "tr": "Ve Allah ile beraber başka bir İlah'a tapma. O'ndan başka İlah yoktur. O'nun yüzünden (zatından) başka herşey helak olucudur. Hüküm O'nundur ve siz O'na döndürüleceksiniz.",
      "en": "And do not invoke with Allah another deity. There is no deity except Him. Everything will be destroyed except His Face. His is the judgement, and to Him you will be returned.",
      "priority": 1,
      "surah_number": 28,
      "surah_name": "Kasas",
      "ayah_number": 88,
      "ayah_end_number": 88,
      "status": "pending_review"
    },
    {
      "id": "029/002",
      "kind": "ayah",
      "ref": "029/002",
      "ar": "أَحَسِبَ ٱلنَّاسُ أَن يُتْرَكُوٓا۟ أَن يَقُولُوٓا۟ ءَامَنَّا وَهُمْ لَا يُفْتَنُونَ",
      "tr": "İnsanlar, (sadece) \"İman ettik\" diyerek, sınanmadan bırakılacaklarını mı sandılar?",
      "en": "Do the people think that they will be left to say, \"We believe\" and they will not be tried?",
      "priority": 1,
      "surah_number": 29,
      "surah_name": "Ankebut",
      "ayah_number": 2,
      "ayah_end_number": 2,
      "status": "pending_review"
    },
    {
      "id": "029/003",
      "kind": "ayah",
      "ref": "029/003",
      "ar": "وَلَقَدْ فَتَنَّا ٱلَّذِينَ مِن قَبْلِهِمْ ۖ فَلَيَعْلَمَنَّ ٱللَّهُ ٱلَّذِينَ صَدَقُوا۟ وَلَيَعْلَمَنَّ ٱلْكَـٰذِبِينَ",
      "tr": "Andolsun, onlardan öncekileri sınadık; Allah, gerçekten doğruları da bilmekte ve gerçekten yalancıları da bilmektedir.",
      "en": "But We have certainly tried those before them, and Allah will surely make evident those who are truthful, and He will surely make evident the liars.",
      "priority": 1,
      "surah_number": 29,
      "surah_name": "Ankebut",
      "ayah_number": 3,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "029/008",
      "kind": "ayah",
      "ref": "029/008",
      "ar": "وَوَصَّيْنَا ٱلْإِنسَـٰنَ بِوَٰلِدَيْهِ حُسْنًا ۖ وَإِن جَـٰهَدَاكَ لِتُشْرِكَ بِى مَا لَيْسَ لَكَ بِهِۦ عِلْمٌ فَلَا تُطِعْهُمَآ ۚ إِلَىَّ مَرْجِعُكُمْ فَأُنَبِّئُكُم بِمَا كُنتُمْ تَعْمَلُونَ",
      "tr": "Biz insana, anne ve babasına (karşı) güzelliği (ilke edinmesini) tavsiye ettik. Eğer onlar, hakkında bilgin olmayan şeyle Bana ortak koşman için sana karşı çaba harcayacak olurlarsa, bu durumda, onlara itaat etme. Dönüşünüz Banadır. Artık yaptıklarınızı size haber vereceğim.",
      "en": "And We have enjoined upon man goodness to parents. But if they endeavor to make you associate with Me that of which you have no knowledge, do not obey them. To Me is your return, and I will inform you about what you used to do.",
      "priority": 1,
      "surah_number": 29,
      "surah_name": "Ankebut",
      "ayah_number": 8,
      "ayah_end_number": 8,
      "status": "pending_review"
    },
    {
      "id": "029/002-003",
      "kind": "ayah",
      "ref": "029/002-003",
      "ar": "﴿2﴾ أَحَسِبَ ٱلنَّاسُ أَن يُتْرَكُوٓا۟ أَن يَقُولُوٓا۟ ءَامَنَّا وَهُمْ لَا يُفْتَنُونَ\n\n﴿3﴾ وَلَقَدْ فَتَنَّا ٱلَّذِينَ مِن قَبْلِهِمْ ۖ فَلَيَعْلَمَنَّ ٱللَّهُ ٱلَّذِينَ صَدَقُوا۟ وَلَيَعْلَمَنَّ ٱلْكَـٰذِبِينَ",
      "tr": "[2] İnsanlar, (sadece) \"İman ettik\" diyerek, sınanmadan bırakılacaklarını mı sandılar?\n\n[3] Andolsun, onlardan öncekileri sınadık; Allah, gerçekten doğruları da bilmekte ve gerçekten yalancıları da bilmektedir.",
      "en": "[2] Do the people think that they will be left to say, \"We believe\" and they will not be tried?\n\n[3] But We have certainly tried those before them, and Allah will surely make evident those who are truthful, and He will surely make evident the liars.",
      "priority": 1,
      "surah_number": 29,
      "surah_name": "Ankebut",
      "ayah_number": 2,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "029/017",
      "kind": "ayah",
      "ref": "029/017",
      "ar": "إِنَّمَا تَعْبُدُونَ مِن دُونِ ٱللَّهِ أَوْثَـٰنًا وَتَخْلُقُونَ إِفْكًا ۚ إِنَّ ٱلَّذِينَ تَعْبُدُونَ مِن دُونِ ٱللَّهِ لَا يَمْلِكُونَ لَكُمْ رِزْقًا فَٱبْتَغُوا۟ عِندَ ٱللَّهِ ٱلرِّزْقَ وَٱعْبُدُوهُ وَٱشْكُرُوا۟ لَهُۥٓ ۖ إِلَيْهِ تُرْجَعُونَ",
      "tr": "\"Siz yalnızca Allah'tan başka birtakım putlara tapıyor ve birtakım yalanlar uyduruyorsunuz. Gerçek şu ki, sizin Allah'tan başka taptıklarınız, size rızık vermeye güç yetiremezler; öyleyse rızkı Allah'ın Katında arayın, O'na kulluk edin ve O'na şükredin. Siz O'na döndürüleceksiniz.\"",
      "en": "You only worship, besides Allah, idols, and you produce a falsehood. Indeed, those you worship besides Allah do not possess for you [the power of] provision. So seek from Allah provision and worship Him and be grateful to Him. To Him you will be returned.\"",
      "priority": 1,
      "surah_number": 29,
      "surah_name": "Ankebut",
      "ayah_number": 17,
      "ayah_end_number": 17,
      "status": "pending_review"
    },
    {
      "id": "029/018",
      "kind": "ayah",
      "ref": "029/018",
      "ar": "وَإِن تُكَذِّبُوا۟ فَقَدْ كَذَّبَ أُمَمٌ مِّن قَبْلِكُمْ ۖ وَمَا عَلَى ٱلرَّسُولِ إِلَّا ٱلْبَلَـٰغُ ٱلْمُبِينُ",
      "tr": "\"Eğer yalanlarsanız, sizden önceki ümmetler de (elçilerin çağrısını) yalanlamışlardır. Elçiye düşen ise, yalnızca açık bir tebliğdir.\"",
      "en": "And if you [people] deny [the message] - already nations before you have denied. And there is not upon the Messenger except [the duty of] clear notification.",
      "priority": 1,
      "surah_number": 29,
      "surah_name": "Ankebut",
      "ayah_number": 18,
      "ayah_end_number": 18,
      "status": "pending_review"
    },
    {
      "id": "029/020",
      "kind": "ayah",
      "ref": "029/020",
      "ar": "قُلْ سِيرُوا۟ فِى ٱلْأَرْضِ فَٱنظُرُوا۟ كَيْفَ بَدَأَ ٱلْخَلْقَ ۚ ثُمَّ ٱللَّهُ يُنشِئُ ٱلنَّشْأَةَ ٱلْءَاخِرَةَ ۚ إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ",
      "tr": "De ki: \"Yeryüzünde gezip dolaşın da, böylelikle yaratmaya nasıl başladığına bir bakın, sonra Allah ahiret yaratmasını (veya son yaratmayı) da inşa edip yaratacaktır. Şüphesiz Allah, herşeye güç yetirendir.",
      "en": "Say, [O Muhammad], \"Travel through the land and observe how He began creation. Then Allah will produce the final creation. Indeed Allah, over all things, is competent.\"",
      "priority": 1,
      "surah_number": 29,
      "surah_name": "Ankebut",
      "ayah_number": 20,
      "ayah_end_number": 20,
      "status": "pending_review"
    },
    {
      "id": "029/017-018",
      "kind": "ayah",
      "ref": "029/017-018",
      "ar": "﴿17﴾ إِنَّمَا تَعْبُدُونَ مِن دُونِ ٱللَّهِ أَوْثَـٰنًا وَتَخْلُقُونَ إِفْكًا ۚ إِنَّ ٱلَّذِينَ تَعْبُدُونَ مِن دُونِ ٱللَّهِ لَا يَمْلِكُونَ لَكُمْ رِزْقًا فَٱبْتَغُوا۟ عِندَ ٱللَّهِ ٱلرِّزْقَ وَٱعْبُدُوهُ وَٱشْكُرُوا۟ لَهُۥٓ ۖ إِلَيْهِ تُرْجَعُونَ\n\n﴿18﴾ وَإِن تُكَذِّبُوا۟ فَقَدْ كَذَّبَ أُمَمٌ مِّن قَبْلِكُمْ ۖ وَمَا عَلَى ٱلرَّسُولِ إِلَّا ٱلْبَلَـٰغُ ٱلْمُبِينُ",
      "tr": "[17] \"Siz yalnızca Allah'tan başka birtakım putlara tapıyor ve birtakım yalanlar uyduruyorsunuz. Gerçek şu ki, sizin Allah'tan başka taptıklarınız, size rızık vermeye güç yetiremezler; öyleyse rızkı Allah'ın Katında arayın, O'na kulluk edin ve O'na şükredin. Siz O'na döndürüleceksiniz.\"\n\n[18] \"Eğer yalanlarsanız, sizden önceki ümmetler de (elçilerin çağrısını) yalanlamışlardır. Elçiye düşen ise, yalnızca açık bir tebliğdir.\"",
      "en": "[17] You only worship, besides Allah, idols, and you produce a falsehood. Indeed, those you worship besides Allah do not possess for you [the power of] provision. So seek from Allah provision and worship Him and be grateful to Him. To Him you will be returned.\"\n\n[18] And if you [people] deny [the message] - already nations before you have denied. And there is not upon the Messenger except [the duty of] clear notification.",
      "priority": 1,
      "surah_number": 29,
      "surah_name": "Ankebut",
      "ayah_number": 17,
      "ayah_end_number": 18,
      "status": "pending_review"
    },
    {
      "id": "029/026",
      "kind": "ayah",
      "ref": "029/026",
      "ar": "فَـَٔامَنَ لَهُۥ لُوطٌ ۘ وَقَالَ إِنِّى مُهَاجِرٌ إِلَىٰ رَبِّىٓ ۖ إِنَّهُۥ هُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ",
      "tr": "Bunun üzerine Lut ona iman etti ve dedi ki: \"Gerçekten ben, Rabbime hicret edeceğim. Çünkü şüphesiz O, güçlü ve üstün olandır, hüküm ve hikmet sahibidir.\"",
      "en": "And Lot believed him. [Abraham] said, \"Indeed, I will emigrate to [the service of] my Lord. Indeed, He is the Exalted in Might, the Wise.\"",
      "priority": 1,
      "surah_number": 29,
      "surah_name": "Ankebut",
      "ayah_number": 26,
      "ayah_end_number": 26,
      "status": "pending_review"
    },
    {
      "id": "029/028",
      "kind": "ayah",
      "ref": "029/028",
      "ar": "وَلُوطًا إِذْ قَالَ لِقَوْمِهِۦٓ إِنَّكُمْ لَتَأْتُونَ ٱلْفَـٰحِشَةَ مَا سَبَقَكُم بِهَا مِنْ أَحَدٍ مِّنَ ٱلْعَـٰلَمِينَ",
      "tr": "Lut da; hani kavmine demişti: \"Siz gerçekten, sizden önce alemlerden hiç kimsenin yapmadığı 'çirkin bir utanmazlığı' yapıyorsunuz.\"",
      "en": "And [mention] Lot, when he said to his people, \"Indeed, you commit such immorality as no one has preceded you with from among the worlds.",
      "priority": 1,
      "surah_number": 29,
      "surah_name": "Ankebut",
      "ayah_number": 28,
      "ayah_end_number": 28,
      "status": "pending_review"
    },
    {
      "id": "029/044",
      "kind": "ayah",
      "ref": "029/044",
      "ar": "خَلَقَ ٱللَّهُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ بِٱلْحَقِّ ۚ إِنَّ فِى ذَٰلِكَ لَـَٔايَةً لِّلْمُؤْمِنِينَ",
      "tr": "Allah gökleri ve yeri hak olarak yarattı. Şüphesiz, bunda iman edenler için bir ayet vardır.",
      "en": "Allah created the heavens and the earth in truth. Indeed in that is a sign for the believers.",
      "priority": 1,
      "surah_number": 29,
      "surah_name": "Ankebut",
      "ayah_number": 44,
      "ayah_end_number": 44,
      "status": "pending_review"
    },
    {
      "id": "029/046",
      "kind": "ayah",
      "ref": "029/046",
      "ar": "وَلَا تُجَـٰدِلُوٓا۟ أَهْلَ ٱلْكِتَـٰبِ إِلَّا بِٱلَّتِى هِىَ أَحْسَنُ إِلَّا ٱلَّذِينَ ظَلَمُوا۟ مِنْهُمْ ۖ وَقُولُوٓا۟ ءَامَنَّا بِٱلَّذِىٓ أُنزِلَ إِلَيْنَا وَأُنزِلَ إِلَيْكُمْ وَإِلَـٰهُنَا وَإِلَـٰهُكُمْ وَٰحِدٌ وَنَحْنُ لَهُۥ مُسْلِمُونَ",
      "tr": "İçlerinde zulmedenleri hariç olmak üzere, Kitap Ehliyle en güzel olan bir tarzın dışında mücadele etmeyin. Ve deyin ki: \"Bize ve size indirilene iman ettik; bizim İlahımız da, sizin İlahınız da birdir ve biz O'na teslim olmuşuz.\"",
      "en": "And do not argue with the People of the Scripture except in a way that is best, except for those who commit injustice among them, and say, \"We believe in that which has been revealed to us and revealed to you. And our God and your God is one; and we are Muslims [in submission] to Him.\"",
      "priority": 1,
      "surah_number": 29,
      "surah_name": "Ankebut",
      "ayah_number": 46,
      "ayah_end_number": 46,
      "status": "pending_review"
    },
    {
      "id": "029/049",
      "kind": "ayah",
      "ref": "029/049",
      "ar": "بَلْ هُوَ ءَايَـٰتٌۢ بَيِّنَـٰتٌ فِى صُدُورِ ٱلَّذِينَ أُوتُوا۟ ٱلْعِلْمَ ۚ وَمَا يَجْحَدُ بِـَٔايَـٰتِنَآ إِلَّا ٱلظَّـٰلِمُونَ",
      "tr": "Hayır, o, kendilerine ilim verilenlerin göğüslerinde apaçık olan ayetlerdir. Zulmedenlerden başkası, Bizim ayetlerimizi inkar etmez.",
      "en": "Rather, the Qur'an is distinct verses [preserved] within the breasts of those who have been given knowledge. And none reject Our verses except the wrongdoers.",
      "priority": 1,
      "surah_number": 29,
      "surah_name": "Ankebut",
      "ayah_number": 49,
      "ayah_end_number": 49,
      "status": "pending_review"
    },
    {
      "id": "029/064",
      "kind": "ayah",
      "ref": "029/064",
      "ar": "وَمَا هَـٰذِهِ ٱلْحَيَوٰةُ ٱلدُّنْيَآ إِلَّا لَهْوٌ وَلَعِبٌ ۚ وَإِنَّ ٱلدَّارَ ٱلْءَاخِرَةَ لَهِىَ ٱلْحَيَوَانُ ۚ لَوْ كَانُوا۟ يَعْلَمُونَ",
      "tr": "Bu dünya hayatı, yalnızca bir oyun ve '(eğlence türünden) tutkulu bir oyalanmadır'. Gerçekten ahiret yurdu ise, asıl hayat odur. Bir bilselerdi.",
      "en": "And this worldly life is not but diversion and amusement. And indeed, the home of the Hereafter - that is the [eternal] life, if only they knew.",
      "priority": 1,
      "surah_number": 29,
      "surah_name": "Ankebut",
      "ayah_number": 64,
      "ayah_end_number": 64,
      "status": "pending_review"
    },
    {
      "id": "029/068",
      "kind": "ayah",
      "ref": "029/068",
      "ar": "وَمَنْ أَظْلَمُ مِمَّنِ ٱفْتَرَىٰ عَلَى ٱللَّهِ كَذِبًا أَوْ كَذَّبَ بِٱلْحَقِّ لَمَّا جَآءَهُۥٓ ۚ أَلَيْسَ فِى جَهَنَّمَ مَثْوًى لِّلْكَـٰفِرِينَ",
      "tr": "Allah hakkında yalan uydurup iftira edenlerden veya kendisine hak geldiği zaman onu yalan sayandan daha zalim kimdir? İnkar edenlere cehennem içinde bir konaklama yeri mi yok?",
      "en": "And who is more unjust than one who invents a lie about Allah or denies the truth when it has come to him? Is there not in Hell a [sufficient] residence for the disbelievers?",
      "priority": 1,
      "surah_number": 29,
      "surah_name": "Ankebut",
      "ayah_number": 68,
      "ayah_end_number": 68,
      "status": "pending_review"
    },
    {
      "id": "030/008",
      "kind": "ayah",
      "ref": "030/008",
      "ar": "أَوَلَمْ يَتَفَكَّرُوا۟ فِىٓ أَنفُسِهِم ۗ مَّا خَلَقَ ٱللَّهُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَآ إِلَّا بِٱلْحَقِّ وَأَجَلٍ مُّسَمًّى ۗ وَإِنَّ كَثِيرًا مِّنَ ٱلنَّاسِ بِلِقَآئِ رَبِّهِمْ لَكَـٰفِرُونَ",
      "tr": "Kendi nefisleri konusunda düşünmüyorlar mı? Allah, gökleri, yeri ve bu ikisi arasında olanları ancak hak ile ve belirlenmiş bir süre (ecel) olarak yaratmıştır. Gerçekten, insanlardan çoğu Rablerine kavuşmayı inkar ediyorlar.",
      "en": "Do they not contemplate within themselves? Allah has not created the heavens and the earth and what is between them except in truth and for a specified term. And indeed, many of the people, in [the matter of] the meeting with their Lord, are disbelievers.",
      "priority": 1,
      "surah_number": 30,
      "surah_name": "Rum",
      "ayah_number": 8,
      "ayah_end_number": 8,
      "status": "pending_review"
    },
    {
      "id": "030/013",
      "kind": "ayah",
      "ref": "030/013",
      "ar": "وَلَمْ يَكُن لَّهُم مِّن شُرَكَآئِهِمْ شُفَعَـٰٓؤُا۟ وَكَانُوا۟ بِشُرَكَآئِهِمْ كَـٰفِرِينَ",
      "tr": "(Allah'a eş koştukları) Ortaklarından kendilerine şefaatçi olan yoktur; onlar, ortaklarını inkar ediyorlar.",
      "en": "And there will not be for them among their [alleged] partners any intercessors, and they will [then] be disbelievers in their partners.",
      "priority": 1,
      "surah_number": 30,
      "surah_name": "Rum",
      "ayah_number": 13,
      "ayah_end_number": 13,
      "status": "pending_review"
    },
    {
      "id": "030/021",
      "kind": "ayah",
      "ref": "030/021",
      "ar": "وَمِنْ ءَايَـٰتِهِۦٓ أَنْ خَلَقَ لَكُم مِّنْ أَنفُسِكُمْ أَزْوَٰجًا لِّتَسْكُنُوٓا۟ إِلَيْهَا وَجَعَلَ بَيْنَكُم مَّوَدَّةً وَرَحْمَةً ۚ إِنَّ فِى ذَٰلِكَ لَـَٔايَـٰتٍ لِّقَوْمٍ يَتَفَكَّرُونَ",
      "tr": "Onda 'sükun bulup durulmanız' için, size kendi nefislerinizden eşler yaratması ve aranızda bir sevgi ve merhamet kılması da, O'nun ayetlerindendir. Şüphesiz bunda, düşünebilen bir kavim için gerçekten ayetler vardır.",
      "en": "And of His signs is that He created for you from yourselves mates that you may find tranquillity in them; and He placed between you affection and mercy. Indeed in that are signs for a people who give thought.",
      "priority": 1,
      "surah_number": 30,
      "surah_name": "Rum",
      "ayah_number": 21,
      "ayah_end_number": 21,
      "status": "pending_review"
    },
    {
      "id": "030/022",
      "kind": "ayah",
      "ref": "030/022",
      "ar": "وَمِنْ ءَايَـٰتِهِۦ خَلْقُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَٱخْتِلَـٰفُ أَلْسِنَتِكُمْ وَأَلْوَٰنِكُمْ ۚ إِنَّ فِى ذَٰلِكَ لَـَٔايَـٰتٍ لِّلْعَـٰلِمِينَ",
      "tr": "Göklerin ve yerin yaratılması ile dillerinizin ve renklerinizin ayrı olması, O'nun ayetlerindendir. Şüphesiz bunda, alimler için gerçekten ayetler vardır.",
      "en": "And of His signs is the creation of the heavens and the earth and the diversity of your languages and your colors. Indeed in that are signs for those of knowledge.",
      "priority": 1,
      "surah_number": 30,
      "surah_name": "Rum",
      "ayah_number": 22,
      "ayah_end_number": 22,
      "status": "pending_review"
    },
    {
      "id": "030/021-022",
      "kind": "ayah",
      "ref": "030/021-022",
      "ar": "﴿21﴾ وَمِنْ ءَايَـٰتِهِۦٓ أَنْ خَلَقَ لَكُم مِّنْ أَنفُسِكُمْ أَزْوَٰجًا لِّتَسْكُنُوٓا۟ إِلَيْهَا وَجَعَلَ بَيْنَكُم مَّوَدَّةً وَرَحْمَةً ۚ إِنَّ فِى ذَٰلِكَ لَـَٔايَـٰتٍ لِّقَوْمٍ يَتَفَكَّرُونَ\n\n﴿22﴾ وَمِنْ ءَايَـٰتِهِۦ خَلْقُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَٱخْتِلَـٰفُ أَلْسِنَتِكُمْ وَأَلْوَٰنِكُمْ ۚ إِنَّ فِى ذَٰلِكَ لَـَٔايَـٰتٍ لِّلْعَـٰلِمِينَ",
      "tr": "[21] Onda 'sükun bulup durulmanız' için, size kendi nefislerinizden eşler yaratması ve aranızda bir sevgi ve merhamet kılması da, O'nun ayetlerindendir. Şüphesiz bunda, düşünebilen bir kavim için gerçekten ayetler vardır.\n\n[22] Göklerin ve yerin yaratılması ile dillerinizin ve renklerinizin ayrı olması, O'nun ayetlerindendir. Şüphesiz bunda, alimler için gerçekten ayetler vardır.",
      "en": "[21] And of His signs is that He created for you from yourselves mates that you may find tranquillity in them; and He placed between you affection and mercy. Indeed in that are signs for a people who give thought.\n\n[22] And of His signs is the creation of the heavens and the earth and the diversity of your languages and your colors. Indeed in that are signs for those of knowledge.",
      "priority": 1,
      "surah_number": 30,
      "surah_name": "Rum",
      "ayah_number": 21,
      "ayah_end_number": 22,
      "status": "pending_review"
    },
    {
      "id": "030/031",
      "kind": "ayah",
      "ref": "030/031",
      "ar": "مُنِيبِينَ إِلَيْهِ وَٱتَّقُوهُ وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَلَا تَكُونُوا۟ مِنَ ٱلْمُشْرِكِينَ",
      "tr": "'Gönülden katıksız bağlılar' olarak, O'na yönelin ve O'ndan korkup-sakının, dosdoğru namazı kılın ve müşriklerden olmayın.",
      "en": "[Adhere to it], turning in repentance to Him, and fear Him and establish prayer and do not be of those who associate others with Allah",
      "priority": 1,
      "surah_number": 30,
      "surah_name": "Rum",
      "ayah_number": 31,
      "ayah_end_number": 31,
      "status": "pending_review"
    },
    {
      "id": "030/032",
      "kind": "ayah",
      "ref": "030/032",
      "ar": "مِنَ ٱلَّذِينَ فَرَّقُوا۟ دِينَهُمْ وَكَانُوا۟ شِيَعًا ۖ كُلُّ حِزْبٍۭ بِمَا لَدَيْهِمْ فَرِحُونَ",
      "tr": "(O müşrikler ki,) Kendi dinlerini fırkalara ayırmış ve kendileri de parça parça olmuşlardır; ki her grup kendi elindekiyle övünüp sevinç duymaktadır.",
      "en": "[Or] of those who have divided their religion and become sects, every faction rejoicing in what it has.",
      "priority": 1,
      "surah_number": 30,
      "surah_name": "Rum",
      "ayah_number": 32,
      "ayah_end_number": 32,
      "status": "pending_review"
    },
    {
      "id": "030/039",
      "kind": "ayah",
      "ref": "030/039",
      "ar": "وَمَآ ءَاتَيْتُم مِّن رِّبًا لِّيَرْبُوَا۟ فِىٓ أَمْوَٰلِ ٱلنَّاسِ فَلَا يَرْبُوا۟ عِندَ ٱللَّهِ ۖ وَمَآ ءَاتَيْتُم مِّن زَكَوٰةٍ تُرِيدُونَ وَجْهَ ٱللَّهِ فَأُو۟لَـٰٓئِكَ هُمُ ٱلْمُضْعِفُونَ",
      "tr": "İnsanların mallarından artsın diye, verdiğiniz faiz Allah Katında artmaz. Ama Allah'ın yüzünü (rızasını) isteyerek verdiğiniz zekat ise, işte (sevablarını ve gelirlerini) kat kat arttıranlar onlardır.",
      "en": "And whatever you give for interest to increase within the wealth of people will not increase with Allah. But what you give in zakah, desiring the countenance of Allah - those are the multipliers.",
      "priority": 1,
      "surah_number": 30,
      "surah_name": "Rum",
      "ayah_number": 39,
      "ayah_end_number": 39,
      "status": "pending_review"
    },
    {
      "id": "030/030-032",
      "kind": "ayah",
      "ref": "030/030-032",
      "ar": "﴿30﴾ فَأَقِمْ وَجْهَكَ لِلدِّينِ حَنِيفًا ۚ فِطْرَتَ ٱللَّهِ ٱلَّتِى فَطَرَ ٱلنَّاسَ عَلَيْهَا ۚ لَا تَبْدِيلَ لِخَلْقِ ٱللَّهِ ۚ ذَٰلِكَ ٱلدِّينُ ٱلْقَيِّمُ وَلَـٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَعْلَمُونَ\n\n﴿31﴾ مُنِيبِينَ إِلَيْهِ وَٱتَّقُوهُ وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَلَا تَكُونُوا۟ مِنَ ٱلْمُشْرِكِينَ\n\n﴿32﴾ مِنَ ٱلَّذِينَ فَرَّقُوا۟ دِينَهُمْ وَكَانُوا۟ شِيَعًا ۖ كُلُّ حِزْبٍۭ بِمَا لَدَيْهِمْ فَرِحُونَ",
      "tr": "[30] Öyleyse sen yüzünü Allah'ı birleyen (bir hanif) olarak dine, Allah'ın o fıtratına çevir; ki insanları bunun üzerine yaratmıştır. Allah'ın yaratışı için hiçbir değiştirme yoktur. İşte dimdik ayakta duran din (budur). Ancak insanların çoğu bilmezler.\n\n[31] 'Gönülden katıksız bağlılar' olarak, O'na yönelin ve O'ndan korkup-sakının, dosdoğru namazı kılın ve müşriklerden olmayın.\n\n[32] (O müşrikler ki,) Kendi dinlerini fırkalara ayırmış ve kendileri de parça parça olmuşlardır; ki her grup kendi elindekiyle övünüp sevinç duymaktadır.",
      "en": "[30] So direct your face toward the religion, inclining to truth. [Adhere to] the fitrah of Allah upon which He has created [all] people. No change should there be in the creation of Allah. That is the correct religion, but most of the people do not know.\n\n[31] [Adhere to it], turning in repentance to Him, and fear Him and establish prayer and do not be of those who associate others with Allah\n\n[32] [Or] of those who have divided their religion and become sects, every faction rejoicing in what it has.",
      "priority": 1,
      "surah_number": 30,
      "surah_name": "Rum",
      "ayah_number": 30,
      "ayah_end_number": 32,
      "status": "pending_review"
    },
    {
      "id": "030/041",
      "kind": "ayah",
      "ref": "030/041",
      "ar": "ظَهَرَ ٱلْفَسَادُ فِى ٱلْبَرِّ وَٱلْبَحْرِ بِمَا كَسَبَتْ أَيْدِى ٱلنَّاسِ لِيُذِيقَهُم بَعْضَ ٱلَّذِى عَمِلُوا۟ لَعَلَّهُمْ يَرْجِعُونَ",
      "tr": "İnsanların kendi ellerinin kazandığı dolayısıyla, karada ve denizde fesad ortaya çıktı. Umulur ki, dönerler diye (Allah) onlara yaptıklarının bir kısmını kendilerine taddırmaktadır.",
      "en": "Corruption has appeared throughout the land and sea by [reason of] what the hands of people have earned so He may let them taste part of [the consequence of] what they have done that perhaps they will return [to righteousness].",
      "priority": 1,
      "surah_number": 30,
      "surah_name": "Rum",
      "ayah_number": 41,
      "ayah_end_number": 41,
      "status": "pending_review"
    },
    {
      "id": "030/042",
      "kind": "ayah",
      "ref": "030/042",
      "ar": "قُلْ سِيرُوا۟ فِى ٱلْأَرْضِ فَٱنظُرُوا۟ كَيْفَ كَانَ عَـٰقِبَةُ ٱلَّذِينَ مِن قَبْلُ ۚ كَانَ أَكْثَرُهُم مُّشْرِكِينَ",
      "tr": "De ki: \"Yeryüzünde gezip dolaşın, böylece daha öncekilerin nasıl bir sona uğradıklarını görün. Onların çoğu müşrik kimselerdi.\"",
      "en": "Say, [O Muhammad], \"Travel through the land and observe how was the end of those before. Most of them were associators [of others with Allah].",
      "priority": 1,
      "surah_number": 30,
      "surah_name": "Rum",
      "ayah_number": 42,
      "ayah_end_number": 42,
      "status": "pending_review"
    },
    {
      "id": "030/047",
      "kind": "ayah",
      "ref": "030/047",
      "ar": "وَلَقَدْ أَرْسَلْنَا مِن قَبْلِكَ رُسُلًا إِلَىٰ قَوْمِهِمْ فَجَآءُوهُم بِٱلْبَيِّنَـٰتِ فَٱنتَقَمْنَا مِنَ ٱلَّذِينَ أَجْرَمُوا۟ ۖ وَكَانَ حَقًّا عَلَيْنَا نَصْرُ ٱلْمُؤْمِنِينَ",
      "tr": "Andolsun, Biz senden önce kendi kavimlerine elçiler gönderdik de onlara apaçık belgeler getirdiler; böylece Biz de suçlu günahkarlardan intikam aldık. İman edenlere yardım etmek ise, Bizim üzerimizde bir haktır.",
      "en": "And We have already sent messengers before you to their peoples, and they came to them with clear evidences; then We took retribution from those who committed crimes, and incumbent upon Us was support of the believers.",
      "priority": 1,
      "surah_number": 30,
      "surah_name": "Rum",
      "ayah_number": 47,
      "ayah_end_number": 47,
      "status": "pending_review"
    },
    {
      "id": "030/041-042",
      "kind": "ayah",
      "ref": "030/041-042",
      "ar": "﴿41﴾ ظَهَرَ ٱلْفَسَادُ فِى ٱلْبَرِّ وَٱلْبَحْرِ بِمَا كَسَبَتْ أَيْدِى ٱلنَّاسِ لِيُذِيقَهُم بَعْضَ ٱلَّذِى عَمِلُوا۟ لَعَلَّهُمْ يَرْجِعُونَ\n\n﴿42﴾ قُلْ سِيرُوا۟ فِى ٱلْأَرْضِ فَٱنظُرُوا۟ كَيْفَ كَانَ عَـٰقِبَةُ ٱلَّذِينَ مِن قَبْلُ ۚ كَانَ أَكْثَرُهُم مُّشْرِكِينَ",
      "tr": "[41] İnsanların kendi ellerinin kazandığı dolayısıyla, karada ve denizde fesad ortaya çıktı. Umulur ki, dönerler diye (Allah) onlara yaptıklarının bir kısmını kendilerine taddırmaktadır.\n\n[42] De ki: \"Yeryüzünde gezip dolaşın, böylece daha öncekilerin nasıl bir sona uğradıklarını görün. Onların çoğu müşrik kimselerdi.\"",
      "en": "[41] Corruption has appeared throughout the land and sea by [reason of] what the hands of people have earned so He may let them taste part of [the consequence of] what they have done that perhaps they will return [to righteousness].\n\n[42] Say, [O Muhammad], \"Travel through the land and observe how was the end of those before. Most of them were associators [of others with Allah].",
      "priority": 1,
      "surah_number": 30,
      "surah_name": "Rum",
      "ayah_number": 41,
      "ayah_end_number": 42,
      "status": "pending_review"
    },
    {
      "id": "031/006",
      "kind": "ayah",
      "ref": "031/006",
      "ar": "وَمِنَ ٱلنَّاسِ مَن يَشْتَرِى لَهْوَ ٱلْحَدِيثِ لِيُضِلَّ عَن سَبِيلِ ٱللَّهِ بِغَيْرِ عِلْمٍ وَيَتَّخِذَهَا هُزُوًا ۚ أُو۟لَـٰٓئِكَ لَهُمْ عَذَابٌ مُّهِينٌ",
      "tr": "İnsanlardan öyleleri vardır ki, bilgisizce Allah'ın yolundan saptırmak ve onu bir eğlence konusu edinmek için sözün 'boş ve amaçsız olanını' satın alırlar. İşte onlar için aşağılatıcı bir azap vardır.",
      "en": "And of the people is he who buys the amusement of speech to mislead [others] from the way of Allah without knowledge and who takes it in ridicule. Those will have a humiliating punishment.",
      "priority": 1,
      "surah_number": 31,
      "surah_name": "Lokman",
      "ayah_number": 6,
      "ayah_end_number": 6,
      "status": "pending_review"
    },
    {
      "id": "031/013",
      "kind": "ayah",
      "ref": "031/013",
      "ar": "وَإِذْ قَالَ لُقْمَـٰنُ لِٱبْنِهِۦ وَهُوَ يَعِظُهُۥ يَـٰبُنَىَّ لَا تُشْرِكْ بِٱللَّهِ ۖ إِنَّ ٱلشِّرْكَ لَظُلْمٌ عَظِيمٌ",
      "tr": "Hani Lukman oğluna -öğüt vererek- demişti ki; \"Ey oğlum, Allah'a şirk koşma. Şüphesiz şirk, gerçekten büyük bir zulümdür.\"",
      "en": "And [mention, O Muhammad], when Luqman said to his son while he was instructing him, \"O my son, do not associate [anything] with Allah. Indeed, association [with him] is great injustice.\"",
      "priority": 1,
      "surah_number": 31,
      "surah_name": "Lokman",
      "ayah_number": 13,
      "ayah_end_number": 13,
      "status": "pending_review"
    },
    {
      "id": "031/014",
      "kind": "ayah",
      "ref": "031/014",
      "ar": "وَوَصَّيْنَا ٱلْإِنسَـٰنَ بِوَٰلِدَيْهِ حَمَلَتْهُ أُمُّهُۥ وَهْنًا عَلَىٰ وَهْنٍ وَفِصَـٰلُهُۥ فِى عَامَيْنِ أَنِ ٱشْكُرْ لِى وَلِوَٰلِدَيْكَ إِلَىَّ ٱلْمَصِيرُ",
      "tr": "Biz insana anne ve babasını (onlara iyilikle davranmayı) tavsiye ettik. Annesi onu, zorluk üstüne zorlukla (karnında) taşımıştır. Onun (sütten) ayrılması, iki yıl içindedir. \"Hem Bana, hem anne ve babana şükret, dönüş yalnız Banadır.\"",
      "en": "And We have enjoined upon man [care] for his parents. His mother carried him, [increasing her] in weakness upon weakness, and his weaning is in two years. Be grateful to Me and to your parents; to Me is the [final] destination.",
      "priority": 1,
      "surah_number": 31,
      "surah_name": "Lokman",
      "ayah_number": 14,
      "ayah_end_number": 14,
      "status": "pending_review"
    },
    {
      "id": "031/015",
      "kind": "ayah",
      "ref": "031/015",
      "ar": "وَإِن جَـٰهَدَاكَ عَلَىٰٓ أَن تُشْرِكَ بِى مَا لَيْسَ لَكَ بِهِۦ عِلْمٌ فَلَا تُطِعْهُمَا ۖ وَصَاحِبْهُمَا فِى ٱلدُّنْيَا مَعْرُوفًا ۖ وَٱتَّبِعْ سَبِيلَ مَنْ أَنَابَ إِلَىَّ ۚ ثُمَّ إِلَىَّ مَرْجِعُكُمْ فَأُنَبِّئُكُم بِمَا كُنتُمْ تَعْمَلُونَ",
      "tr": "Bununla birlikte, onların ikisi (annen ve baban) hakkında bir bilgin olmayan şeyi Bana şirk koşman için, sana karşı çaba harcayacak olurlarsa, bu durumda onlara itaat etme ve dünya (hayatın) da onlara iyilikle (ma'ruf üzere) sahiplen (onlarla geçin) ve Bana 'gönülden-katıksız olarak yönelenin' yoluna tabi ol. Sonra dönüşünüz yalnızca Banadır, böylece Ben de size yaptıklarınızı haber vereceğim.",
      "en": "But if they endeavor to make you associate with Me that of which you have no knowledge, do not obey them but accompany them in [this] world with appropriate kindness and follow the way of those who turn back to Me [in repentance]. Then to Me will be your return, and I will inform you about what you used to do.",
      "priority": 1,
      "surah_number": 31,
      "surah_name": "Lokman",
      "ayah_number": 15,
      "ayah_end_number": 15,
      "status": "pending_review"
    },
    {
      "id": "031/018",
      "kind": "ayah",
      "ref": "031/018",
      "ar": "وَلَا تُصَعِّرْ خَدَّكَ لِلنَّاسِ وَلَا تَمْشِ فِى ٱلْأَرْضِ مَرَحًا ۖ إِنَّ ٱللَّهَ لَا يُحِبُّ كُلَّ مُخْتَالٍ فَخُورٍ",
      "tr": "\"İnsanlara yanağını çevirip (büyüklenme) ve böbürlenmiş olarak yeryüzünde yürüme. Çünkü Allah, büyüklük taslayıp böbürleneni sevmez.\"",
      "en": "And do not turn your cheek [in contempt] toward people and do not walk through the earth exultantly. Indeed, Allah does not like everyone self-deluded and boastful.",
      "priority": 1,
      "surah_number": 31,
      "surah_name": "Lokman",
      "ayah_number": 18,
      "ayah_end_number": 18,
      "status": "pending_review"
    },
    {
      "id": "031/021",
      "kind": "ayah",
      "ref": "031/021",
      "ar": "وَإِذَا قِيلَ لَهُمُ ٱتَّبِعُوا۟ مَآ أَنزَلَ ٱللَّهُ قَالُوا۟ بَلْ نَتَّبِعُ مَا وَجَدْنَا عَلَيْهِ ءَابَآءَنَآ ۚ أَوَلَوْ كَانَ ٱلشَّيْطَـٰنُ يَدْعُوهُمْ إِلَىٰ عَذَابِ ٱلسَّعِيرِ",
      "tr": "Onlara; \"Allah'ın indirdiklerine uyun\" denildiğinde, derler ki; \"Hayır, biz atalarımızı üzerinde bulduğumuz şeye uyarız.\" Şayet şeytan, onları çılgınca yanan ateşin azabına çağırmışsa da mı (buna uyacaklar)?",
      "en": "And when it is said to them, \"Follow what Allah has revealed,\" they say, \"Rather, we will follow that upon which we found our fathers.\" Even if Satan was inviting them to the punishment of the Blaze?",
      "priority": 1,
      "surah_number": 31,
      "surah_name": "Lokman",
      "ayah_number": 21,
      "ayah_end_number": 21,
      "status": "pending_review"
    },
    {
      "id": "031/017-018",
      "kind": "ayah",
      "ref": "031/017-018",
      "ar": "﴿17﴾ يَـٰبُنَىَّ أَقِمِ ٱلصَّلَوٰةَ وَأْمُرْ بِٱلْمَعْرُوفِ وَٱنْهَ عَنِ ٱلْمُنكَرِ وَٱصْبِرْ عَلَىٰ مَآ أَصَابَكَ ۖ إِنَّ ذَٰلِكَ مِنْ عَزْمِ ٱلْأُمُورِ\n\n﴿18﴾ وَلَا تُصَعِّرْ خَدَّكَ لِلنَّاسِ وَلَا تَمْشِ فِى ٱلْأَرْضِ مَرَحًا ۖ إِنَّ ٱللَّهَ لَا يُحِبُّ كُلَّ مُخْتَالٍ فَخُورٍ",
      "tr": "[17] \"Ey oğlum, namazı dosdoğru kıl, ma'rufu emret, münkerden sakındır ve sana isabet eden (musibetler)e karşı sabret. Çünkü bunlar, azmedilmesi gereken işlerdendir.\n\n[18] \"İnsanlara yanağını çevirip (büyüklenme) ve böbürlenmiş olarak yeryüzünde yürüme. Çünkü Allah, büyüklük taslayıp böbürleneni sevmez.\"",
      "en": "[17] O my son, establish prayer, enjoin what is right, forbid what is wrong, and be patient over what befalls you. Indeed, [all] that is of the matters [requiring] determination.\n\n[18] And do not turn your cheek [in contempt] toward people and do not walk through the earth exultantly. Indeed, Allah does not like everyone self-deluded and boastful.",
      "priority": 1,
      "surah_number": 31,
      "surah_name": "Lokman",
      "ayah_number": 17,
      "ayah_end_number": 18,
      "status": "pending_review"
    },
    {
      "id": "031/033",
      "kind": "ayah",
      "ref": "031/033",
      "ar": "يَـٰٓأَيُّهَا ٱلنَّاسُ ٱتَّقُوا۟ رَبَّكُمْ وَٱخْشَوْا۟ يَوْمًا لَّا يَجْزِى وَالِدٌ عَن وَلَدِهِۦ وَلَا مَوْلُودٌ هُوَ جَازٍ عَن وَالِدِهِۦ شَيْـًٔا ۚ إِنَّ وَعْدَ ٱللَّهِ حَقٌّ ۖ فَلَا تَغُرَّنَّكُمُ ٱلْحَيَوٰةُ ٱلدُّنْيَا وَلَا يَغُرَّنَّكُم بِٱللَّهِ ٱلْغَرُورُ",
      "tr": "Ey insanlar, Rabbinizden korkup-sakının ve öyle bir günün azabından çekinip-korkun ki, (o gün hiç) bir baba, çocuğu için bir karşılık veremez ve (hiç)bir çocuk da babası için bir şeyi verebilecek (durumda) değildir. Şüphesiz Allah'ın va'di haktır. Artık dünya hayatı sizi aldatmaya sürüklemesin ve aldatıcı(lar) da sizi Allah ile aldatmasın.",
      "en": "O mankind, fear your Lord and fear a Day when no father will avail his son, nor will a son avail his father at all. Indeed, the promise of Allah is truth, so let not the worldly life delude you and be not deceived about Allah by the Deceiver.",
      "priority": 1,
      "surah_number": 31,
      "surah_name": "Lokman",
      "ayah_number": 33,
      "ayah_end_number": 33,
      "status": "pending_review"
    },
    {
      "id": "032/004",
      "kind": "ayah",
      "ref": "032/004",
      "ar": "ٱللَّهُ ٱلَّذِى خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَا فِى سِتَّةِ أَيَّامٍ ثُمَّ ٱسْتَوَىٰ عَلَى ٱلْعَرْشِ ۖ مَا لَكُم مِّن دُونِهِۦ مِن وَلِىٍّ وَلَا شَفِيعٍ ۚ أَفَلَا تَتَذَكَّرُونَ",
      "tr": "Allah; gökleri, yeri ve ikisi arasında olanları altı günde yarattı, sonra arşa istiva etti. Sizin O'nun dışında bir yardımcınız ve şefaatçiniz yoktur. Yine de öğüt alıp-düşünmeyecek misiniz?",
      "en": "It is Allah who created the heavens and the earth and whatever is between them in six days; then He established Himself above the Throne. You have not besides Him any protector or any intercessor; so will you not be reminded?",
      "priority": 1,
      "surah_number": 32,
      "surah_name": "Secde",
      "ayah_number": 4,
      "ayah_end_number": 4,
      "status": "pending_review"
    },
    {
      "id": "032/018",
      "kind": "ayah",
      "ref": "032/018",
      "ar": "أَفَمَن كَانَ مُؤْمِنًا كَمَن كَانَ فَاسِقًا ۚ لَّا يَسْتَوُۥنَ",
      "tr": "Öyleyse, iman eden kimse, fasık olan gibi olur mu? Bunlar eşit olmazlar.",
      "en": "Then is one who was a believer like one who was defiantly disobedient? They are not equal.",
      "priority": 1,
      "surah_number": 32,
      "surah_name": "Secde",
      "ayah_number": 18,
      "ayah_end_number": 18,
      "status": "pending_review"
    },
    {
      "id": "033/001",
      "kind": "ayah",
      "ref": "033/001",
      "ar": "\\basmalah يَـٰٓأَيُّهَا ٱلنَّبِىُّ ٱتَّقِ ٱللَّهَ وَلَا تُطِعِ ٱلْكَـٰفِرِينَ وَٱلْمُنَـٰفِقِينَ ۗ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمًا",
      "tr": "Ey Peygamber, Allah'tan sakın, kafirlere ve münafıklara itaat etme. Şüphesiz Allah, bilendir, hüküm ve hikmet sahibidir.",
      "en": "O Prophet, fear Allah and do not obey the disbelievers and the hypocrites. Indeed, Allah is ever Knowing and Wise.",
      "priority": 1,
      "surah_number": 33,
      "surah_name": "Ahzab",
      "ayah_number": 1,
      "ayah_end_number": 1,
      "status": "pending_review"
    },
    {
      "id": "033/003",
      "kind": "ayah",
      "ref": "033/003",
      "ar": "وَتَوَكَّلْ عَلَى ٱللَّهِ ۚ وَكَفَىٰ بِٱللَّهِ وَكِيلًا",
      "tr": "Allah'a tevekkül et; vekil olarak Allah yeter.",
      "en": "And rely upon Allah; and sufficient is Allah as Disposer of affairs.",
      "priority": 1,
      "surah_number": 33,
      "surah_name": "Ahzab",
      "ayah_number": 3,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "033/012",
      "kind": "ayah",
      "ref": "033/012",
      "ar": "وَإِذْ يَقُولُ ٱلْمُنَـٰفِقُونَ وَٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌ مَّا وَعَدَنَا ٱللَّهُ وَرَسُولُهُۥٓ إِلَّا غُرُورًا",
      "tr": "Hani, münafık olanlar ve kalplerinde hastalık bulunanlar: \"Allah ve Resulü, bize boş bir aldanıştan başka bir şey vadetmedi\" diyorlardı.",
      "en": "And [remember] when the hypocrites and those in whose hearts is disease said, \"Allah and His Messenger did not promise us except delusion,\"",
      "priority": 1,
      "surah_number": 33,
      "surah_name": "Ahzab",
      "ayah_number": 12,
      "ayah_end_number": 12,
      "status": "pending_review"
    },
    {
      "id": "033/013",
      "kind": "ayah",
      "ref": "033/013",
      "ar": "وَإِذْ قَالَت طَّآئِفَةٌ مِّنْهُمْ يَـٰٓأَهْلَ يَثْرِبَ لَا مُقَامَ لَكُمْ فَٱرْجِعُوا۟ ۚ وَيَسْتَـْٔذِنُ فَرِيقٌ مِّنْهُمُ ٱلنَّبِىَّ يَقُولُونَ إِنَّ بُيُوتَنَا عَوْرَةٌ وَمَا هِىَ بِعَوْرَةٍ ۖ إِن يُرِيدُونَ إِلَّا فِرَارًا",
      "tr": "Onlardan bir grup da hani şöyle demişti: \"Ey Yesrib (Medine) halkı, artık sizin için (burada) kalacak yer yok, şu halde dönün.\" Onlardan bir topluluk da: \"Gerçekten evlerimiz açıktır\" diye Peygamberden izin istiyordu; oysa onlar(ın evleri) açık değildi. Onlar yalnızca kaçmak istiyorlardı.",
      "en": "And when a faction of them said, \"O people of Yathrib, there is no stability for you [here], so return [home].\" And a party of them asked permission of the Prophet, saying, \"Indeed, our houses are unprotected,\" while they were not exposed. They did not intend except to flee.",
      "priority": 1,
      "surah_number": 33,
      "surah_name": "Ahzab",
      "ayah_number": 13,
      "ayah_end_number": 13,
      "status": "pending_review"
    },
    {
      "id": "033/014",
      "kind": "ayah",
      "ref": "033/014",
      "ar": "وَلَوْ دُخِلَتْ عَلَيْهِم مِّنْ أَقْطَارِهَا ثُمَّ سُئِلُوا۟ ٱلْفِتْنَةَ لَـَٔاتَوْهَا وَمَا تَلَبَّثُوا۟ بِهَآ إِلَّا يَسِيرًا",
      "tr": "Eğer onlara (şehrin her) yanından girilseydi sonra da kendilerinden fitne (karışıklık çıkarmaları) istenmiş olsaydı, hiç şüphesiz buna yanaşır ve bunda pek az (zaman) dışında (kararsız) kalmazlardı.",
      "en": "And if they had been entered upon from all its [surrounding] regions and fitnah had been demanded of them, they would have done it and not hesitated over it except briefly.",
      "priority": 1,
      "surah_number": 33,
      "surah_name": "Ahzab",
      "ayah_number": 14,
      "ayah_end_number": 14,
      "status": "pending_review"
    },
    {
      "id": "033/015",
      "kind": "ayah",
      "ref": "033/015",
      "ar": "وَلَقَدْ كَانُوا۟ عَـٰهَدُوا۟ ٱللَّهَ مِن قَبْلُ لَا يُوَلُّونَ ٱلْأَدْبَـٰرَ ۚ وَكَانَ عَهْدُ ٱللَّهِ مَسْـُٔولًا",
      "tr": "Oysa andolsun, daha önce 'arkalarını dönüp kaçmayacaklarına' dair Allah'a söz vermişlerdi; Allah'a verilen söz (ahid) ise, (ağır bir) sorumluluktur.",
      "en": "And they had already promised Allah before not to turn their backs and flee. And ever is the promise to Allah [that about which one will be] questioned.",
      "priority": 1,
      "surah_number": 33,
      "surah_name": "Ahzab",
      "ayah_number": 15,
      "ayah_end_number": 15,
      "status": "pending_review"
    },
    {
      "id": "033/016",
      "kind": "ayah",
      "ref": "033/016",
      "ar": "قُل لَّن يَنفَعَكُمُ ٱلْفِرَارُ إِن فَرَرْتُم مِّنَ ٱلْمَوْتِ أَوِ ٱلْقَتْلِ وَإِذًا لَّا تُمَتَّعُونَ إِلَّا قَلِيلًا",
      "tr": "De ki: \"Eğer ölümden veya öldürülmekten kaçıyorsanız, kaçış size kesin olarak bir yarar sağlamaz; böyle olsa bile, pek az (bir zaman) dışında metalanıp-yararlandırılmazsınız.\"",
      "en": "Say, [O Muhammad], \"Never will fleeing benefit you if you should flee from death or killing; and then [if you did], you would not be given enjoyment [of life] except for a little.\"",
      "priority": 1,
      "surah_number": 33,
      "surah_name": "Ahzab",
      "ayah_number": 16,
      "ayah_end_number": 16,
      "status": "pending_review"
    },
    {
      "id": "033/017",
      "kind": "ayah",
      "ref": "033/017",
      "ar": "قُلْ مَن ذَا ٱلَّذِى يَعْصِمُكُم مِّنَ ٱللَّهِ إِنْ أَرَادَ بِكُمْ سُوٓءًا أَوْ أَرَادَ بِكُمْ رَحْمَةً ۚ وَلَا يَجِدُونَ لَهُم مِّن دُونِ ٱللَّهِ وَلِيًّا وَلَا نَصِيرًا",
      "tr": "De ki: \"Size bir kötülük isteyecek olsa sizi Allah'tan koruyacak, veya size bir rahmet isteyecek olsa (buna engel olacak) kimdir?\" Onlar, kendileri için Allah'ın dışında ne bir veli, ne bir yardımcı bulamazlar.",
      "en": "Say, \"Who is it that can protect you from Allah if He intends for you an ill or intends for you a mercy?\" And they will not find for themselves besides Allah any protector or any helper.",
      "priority": 1,
      "surah_number": 33,
      "surah_name": "Ahzab",
      "ayah_number": 17,
      "ayah_end_number": 17,
      "status": "pending_review"
    },
    {
      "id": "033/018",
      "kind": "ayah",
      "ref": "033/018",
      "ar": "قَدْ يَعْلَمُ ٱللَّهُ ٱلْمُعَوِّقِينَ مِنكُمْ وَٱلْقَآئِلِينَ لِإِخْوَٰنِهِمْ هَلُمَّ إِلَيْنَا ۖ وَلَا يَأْتُونَ ٱلْبَأْسَ إِلَّا قَلِيلًا",
      "tr": "Gerçekten Allah, içinizden alıkoyanları ve kardeşlerine: \"Bize gelin\" diyenleri bilir. Bunlar, pek azı dışında zorlu-savaşlara gelmezler.",
      "en": "Already Allah knows the hinderers among you and those [hypocrites] who say to their brothers, \"Come to us,\" and do not go to battle, except for a few,",
      "priority": 1,
      "surah_number": 33,
      "surah_name": "Ahzab",
      "ayah_number": 18,
      "ayah_end_number": 18,
      "status": "pending_review"
    },
    {
      "id": "033/019",
      "kind": "ayah",
      "ref": "033/019",
      "ar": "أَشِحَّةً عَلَيْكُمْ ۖ فَإِذَا جَآءَ ٱلْخَوْفُ رَأَيْتَهُمْ يَنظُرُونَ إِلَيْكَ تَدُورُ أَعْيُنُهُمْ كَٱلَّذِى يُغْشَىٰ عَلَيْهِ مِنَ ٱلْمَوْتِ ۖ فَإِذَا ذَهَبَ ٱلْخَوْفُ سَلَقُوكُم بِأَلْسِنَةٍ حِدَادٍ أَشِحَّةً عَلَى ٱلْخَيْرِ ۚ أُو۟لَـٰٓئِكَ لَمْ يُؤْمِنُوا۟ فَأَحْبَطَ ٱللَّهُ أَعْمَـٰلَهُمْ ۚ وَكَانَ ذَٰلِكَ عَلَى ٱللَّهِ يَسِيرًا",
      "tr": "(Geldiklerinde de) Size karşı 'cimri ve bencildirler.' Şayet korku gelecek olsa, ölümden dolayı üstüne baygınlık çökmüş kimseler gibi gözleri dönerek sana bakmakta olduklarını görürsün. Korku gidince, hayra karşı oldukça düşkünlük göstererek sizi keskin dilleriyle (eleştirip inciterek) karşılarlar. İşte onlar iman etmemişlerdir; böylece Allah onların yaptıklarını boşa çıkarmıştır. Bu Allah'a göre pek kolaydır.",
      "en": "Indisposed toward you. And when fear comes, you see them looking at you, their eyes revolving like one being overcome by death. But when fear departs, they lash you with sharp tongues, indisposed toward [any] good. Those have not believed, so Allah has rendered their deeds worthless, and ever is that, for Allah, easy.",
      "priority": 1,
      "surah_number": 33,
      "surah_name": "Ahzab",
      "ayah_number": 19,
      "ayah_end_number": 19,
      "status": "pending_review"
    },
    {
      "id": "033/023",
      "kind": "ayah",
      "ref": "033/023",
      "ar": "مِّنَ ٱلْمُؤْمِنِينَ رِجَالٌ صَدَقُوا۟ مَا عَـٰهَدُوا۟ ٱللَّهَ عَلَيْهِ ۖ فَمِنْهُم مَّن قَضَىٰ نَحْبَهُۥ وَمِنْهُم مَّن يَنتَظِرُ ۖ وَمَا بَدَّلُوا۟ تَبْدِيلًا",
      "tr": "Mü'minlerden öyle erkek-adamlar vardır ki- Allah ile yaptıkları ahide sadakat gösterdiler; böylece onlardan kimi adağını gerçekleştirdi, kimi beklemektedir. Onlar hiçbir değiştirme ile (sözlerini) değiştirmediler.",
      "en": "Among the believers are men true to what they promised Allah. Among them is he who has fulfilled his vow [to the death], and among them is he who awaits [his chance]. And they did not alter [the terms of their commitment] by any alteration -",
      "priority": 1,
      "surah_number": 33,
      "surah_name": "Ahzab",
      "ayah_number": 23,
      "ayah_end_number": 23,
      "status": "pending_review"
    },
    {
      "id": "033/024",
      "kind": "ayah",
      "ref": "033/024",
      "ar": "لِّيَجْزِىَ ٱللَّهُ ٱلصَّـٰدِقِينَ بِصِدْقِهِمْ وَيُعَذِّبَ ٱلْمُنَـٰفِقِينَ إِن شَآءَ أَوْ يَتُوبَ عَلَيْهِمْ ۚ إِنَّ ٱللَّهَ كَانَ غَفُورًا رَّحِيمًا",
      "tr": "Çünkü Allah, (sözüne bağlı kalıp doğru olan) sadıkları sadakatlerinden dolayı mükafaatlandıracak, münafıkları da dilerse azaplandıracak veya tevbe (nasib edip tevbe)lerini kabul edecektir. Şüphesiz Allah, çok bağışlayandır, çok esirgeyendir.",
      "en": "That Allah may reward the truthful for their truth and punish the hypocrites if He wills or accept their repentance. Indeed, Allah is ever Forgiving and Merciful.",
      "priority": 1,
      "surah_number": 33,
      "surah_name": "Ahzab",
      "ayah_number": 24,
      "ayah_end_number": 24,
      "status": "pending_review"
    },
    {
      "id": "033/026",
      "kind": "ayah",
      "ref": "033/026",
      "ar": "وَأَنزَلَ ٱلَّذِينَ ظَـٰهَرُوهُم مِّنْ أَهْلِ ٱلْكِتَـٰبِ مِن صَيَاصِيهِمْ وَقَذَفَ فِى قُلُوبِهِمُ ٱلرُّعْبَ فَرِيقًا تَقْتُلُونَ وَتَأْسِرُونَ فَرِيقًا",
      "tr": "Kitap Ehlinden onlara arka çıkanları da kalelerinden indirdi ve onların kalplerine korku düşürdü. Siz (onlardan) bir kısmını öldürüyordunuz, bir kısmını ise esir alıyordunuz.",
      "en": "And He brought down those who supported them among the People of the Scripture from their fortresses and cast terror into their hearts [so that] a party you killed, and you took captive a party.",
      "priority": 1,
      "surah_number": 33,
      "surah_name": "Ahzab",
      "ayah_number": 26,
      "ayah_end_number": 26,
      "status": "pending_review"
    },
    {
      "id": "033/023-024",
      "kind": "ayah",
      "ref": "033/023-024",
      "ar": "﴿23﴾ مِّنَ ٱلْمُؤْمِنِينَ رِجَالٌ صَدَقُوا۟ مَا عَـٰهَدُوا۟ ٱللَّهَ عَلَيْهِ ۖ فَمِنْهُم مَّن قَضَىٰ نَحْبَهُۥ وَمِنْهُم مَّن يَنتَظِرُ ۖ وَمَا بَدَّلُوا۟ تَبْدِيلًا\n\n﴿24﴾ لِّيَجْزِىَ ٱللَّهُ ٱلصَّـٰدِقِينَ بِصِدْقِهِمْ وَيُعَذِّبَ ٱلْمُنَـٰفِقِينَ إِن شَآءَ أَوْ يَتُوبَ عَلَيْهِمْ ۚ إِنَّ ٱللَّهَ كَانَ غَفُورًا رَّحِيمًا",
      "tr": "[23] Mü'minlerden öyle erkek-adamlar vardır ki- Allah ile yaptıkları ahide sadakat gösterdiler; böylece onlardan kimi adağını gerçekleştirdi, kimi beklemektedir. Onlar hiçbir değiştirme ile (sözlerini) değiştirmediler.\n\n[24] Çünkü Allah, (sözüne bağlı kalıp doğru olan) sadıkları sadakatlerinden dolayı mükafaatlandıracak, münafıkları da dilerse azaplandıracak veya tevbe (nasib edip tevbe)lerini kabul edecektir. Şüphesiz Allah, çok bağışlayandır, çok esirgeyendir.",
      "en": "[23] Among the believers are men true to what they promised Allah. Among them is he who has fulfilled his vow [to the death], and among them is he who awaits [his chance]. And they did not alter [the terms of their commitment] by any alteration -\n\n[24] That Allah may reward the truthful for their truth and punish the hypocrites if He wills or accept their repentance. Indeed, Allah is ever Forgiving and Merciful.",
      "priority": 1,
      "surah_number": 33,
      "surah_name": "Ahzab",
      "ayah_number": 23,
      "ayah_end_number": 24,
      "status": "pending_review"
    },
    {
      "id": "033/030",
      "kind": "ayah",
      "ref": "033/030",
      "ar": "يَـٰنِسَآءَ ٱلنَّبِىِّ مَن يَأْتِ مِنكُنَّ بِفَـٰحِشَةٍ مُّبَيِّنَةٍ يُضَـٰعَفْ لَهَا ٱلْعَذَابُ ضِعْفَيْنِ ۚ وَكَانَ ذَٰلِكَ عَلَى ٱللَّهِ يَسِيرًا",
      "tr": "Ey peygamberin kadınları, sizden kim açık bir çirkin-utanmazlıkta bulunursa, onun azabı iki kat olarak artırılır. Bu da Allah'a göre pek kolaydır.",
      "en": "O wives of the Prophet, whoever of you should commit a clear immorality - for her the punishment would be doubled two fold, and ever is that, for Allah, easy.",
      "priority": 1,
      "surah_number": 33,
      "surah_name": "Ahzab",
      "ayah_number": 30,
      "ayah_end_number": 30,
      "status": "pending_review"
    },
    {
      "id": "033/033",
      "kind": "ayah",
      "ref": "033/033",
      "ar": "وَقَرْنَ فِى بُيُوتِكُنَّ وَلَا تَبَرَّجْنَ تَبَرُّجَ ٱلْجَـٰهِلِيَّةِ ٱلْأُولَىٰ ۖ وَأَقِمْنَ ٱلصَّلَوٰةَ وَءَاتِينَ ٱلزَّكَوٰةَ وَأَطِعْنَ ٱللَّهَ وَرَسُولَهُۥٓ ۚ إِنَّمَا يُرِيدُ ٱللَّهُ لِيُذْهِبَ عَنكُمُ ٱلرِّجْسَ أَهْلَ ٱلْبَيْتِ وَيُطَهِّرَكُمْ تَطْهِيرًا",
      "tr": "Evlerinizde vakarla-oturun (evlerinizi karargah edinin), ilk cahiliye (kadınları)nın süslerini açığa vurması gibi, siz de süslerinizi açığa vurmayın; namazı dosdoğru kılın, zekatı verin, Allah'a ve elçisine itaat edin. Ey Ehl-i Beyt, gerçekten Allah, sizden kiri (günah ve çirkinliği) gidermek ve sizi tertemiz kılmak ister.",
      "en": "And abide in your houses and do not display yourselves as [was] the display of the former times of ignorance. And establish prayer and give zakah and obey Allah and His Messenger. Allah intends only to remove from you the impurity [of sin], O people of the [Prophet's] household, and to purify you with [extensive] purification.",
      "priority": 1,
      "surah_number": 33,
      "surah_name": "Ahzab",
      "ayah_number": 33,
      "ayah_end_number": 33,
      "status": "pending_review"
    },
    {
      "id": "033/039",
      "kind": "ayah",
      "ref": "033/039",
      "ar": "ٱلَّذِينَ يُبَلِّغُونَ رِسَـٰلَـٰتِ ٱللَّهِ وَيَخْشَوْنَهُۥ وَلَا يَخْشَوْنَ أَحَدًا إِلَّا ٱللَّهَ ۗ وَكَفَىٰ بِٱللَّهِ حَسِيبًا",
      "tr": "Ki onlar (o peygamberler) Allah'ın risaletini tebliğ edenler, O'ndan içleri titreyerek-korkanlar ve Allah'ın dışında hiç kimseden korkmayanlardır. Hesap görücü olarak Allah yeter.",
      "en": "[Allah praises] those who convey the messages of Allah and fear Him and do not fear anyone but Allah. And sufficient is Allah as Accountant.",
      "priority": 1,
      "surah_number": 33,
      "surah_name": "Ahzab",
      "ayah_number": 39,
      "ayah_end_number": 39,
      "status": "pending_review"
    },
    {
      "id": "033/048",
      "kind": "ayah",
      "ref": "033/048",
      "ar": "وَلَا تُطِعِ ٱلْكَـٰفِرِينَ وَٱلْمُنَـٰفِقِينَ وَدَعْ أَذَىٰهُمْ وَتَوَكَّلْ عَلَى ٱللَّهِ ۚ وَكَفَىٰ بِٱللَّهِ وَكِيلًا",
      "tr": "Kafirlere ve münafıklara itaat etme, eziyetlerine aldırma ve Allah'a tevekkül et. Vekil olarak Allah yeter.",
      "en": "And do not obey the disbelievers and the hypocrites but do not harm them, and rely upon Allah. And sufficient is Allah as Disposer of affairs.",
      "priority": 1,
      "surah_number": 33,
      "surah_name": "Ahzab",
      "ayah_number": 48,
      "ayah_end_number": 48,
      "status": "pending_review"
    },
    {
      "id": "033/057",
      "kind": "ayah",
      "ref": "033/057",
      "ar": "إِنَّ ٱلَّذِينَ يُؤْذُونَ ٱللَّهَ وَرَسُولَهُۥ لَعَنَهُمُ ٱللَّهُ فِى ٱلدُّنْيَا وَٱلْءَاخِرَةِ وَأَعَدَّ لَهُمْ عَذَابًا مُّهِينًا",
      "tr": "Gerçek şu ki, Allah'a ve elçisine eziyet edenler; Allah, onlara dünyada ve ahirette lanet etmiş ve onlar için aşağılatıcı bir azap hazırlanmıştır.",
      "en": "Indeed, those who abuse Allah and His Messenger - Allah has cursed them in this world and the Hereafter and prepared for them a humiliating punishment.",
      "priority": 1,
      "surah_number": 33,
      "surah_name": "Ahzab",
      "ayah_number": 57,
      "ayah_end_number": 57,
      "status": "pending_review"
    },
    {
      "id": "033/058",
      "kind": "ayah",
      "ref": "033/058",
      "ar": "وَٱلَّذِينَ يُؤْذُونَ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ بِغَيْرِ مَا ٱكْتَسَبُوا۟ فَقَدِ ٱحْتَمَلُوا۟ بُهْتَـٰنًا وَإِثْمًا مُّبِينًا",
      "tr": "Mü'min erkeklere ve mü'min kadınlara irtikab etmedikleri (bir suç) sebebiyle eziyet edenler ise, gerçekten bir iftira ve açık bir günah yüklenmişlerdir.",
      "en": "And those who harm believing men and believing women for [something] other than what they have earned have certainly born upon themselves a slander and manifest sin.",
      "priority": 1,
      "surah_number": 33,
      "surah_name": "Ahzab",
      "ayah_number": 58,
      "ayah_end_number": 58,
      "status": "pending_review"
    },
    {
      "id": "033/059",
      "kind": "ayah",
      "ref": "033/059",
      "ar": "يَـٰٓأَيُّهَا ٱلنَّبِىُّ قُل لِّأَزْوَٰجِكَ وَبَنَاتِكَ وَنِسَآءِ ٱلْمُؤْمِنِينَ يُدْنِينَ عَلَيْهِنَّ مِن جَلَـٰبِيبِهِنَّ ۚ ذَٰلِكَ أَدْنَىٰٓ أَن يُعْرَفْنَ فَلَا يُؤْذَيْنَ ۗ وَكَانَ ٱللَّهُ غَفُورًا رَّحِيمًا",
      "tr": "Ey Peygamber, eşlerine, kızlarına ve mü'minlerin kadınlarına dış elbiselerinden (cilbablarından) üstlerine giymelerini söyle; onların (özgür ve iffetli) tanınması ve eziyet görmemeleri için en uygun olan budur. Allah, çok bağışlayandır, çok esirgeyendir.",
      "en": "O Prophet, tell your wives and your daughters and the women of the believers to bring down over themselves [part] of their outer garments. That is more suitable that they will be known and not be abused. And ever is Allah Forgiving and Merciful.",
      "priority": 1,
      "surah_number": 33,
      "surah_name": "Ahzab",
      "ayah_number": 59,
      "ayah_end_number": 59,
      "status": "pending_review"
    },
    {
      "id": "033/060",
      "kind": "ayah",
      "ref": "033/060",
      "ar": "لَّئِن لَّمْ يَنتَهِ ٱلْمُنَـٰفِقُونَ وَٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌ وَٱلْمُرْجِفُونَ فِى ٱلْمَدِينَةِ لَنُغْرِيَنَّكَ بِهِمْ ثُمَّ لَا يُجَاوِرُونَكَ فِيهَآ إِلَّا قَلِيلًا",
      "tr": "Andolsun, eğer münafıklar, kalplerinde hastalık bulunanlar ve şehirde kışkırtıcılık yapan (yalan haber yayan)lar (bu tutumlarına) bir son vermeyecek olurlarsa, gerçekten seni onlara saldırtırız, sonra orada seninle pek az (bir süre) komşu kalabilirler.",
      "en": "If the hypocrites and those in whose hearts is disease and those who spread rumors in al-Madinah do not cease, We will surely incite you against them; then they will not remain your neighbors therein except for a little.",
      "priority": 1,
      "surah_number": 33,
      "surah_name": "Ahzab",
      "ayah_number": 60,
      "ayah_end_number": 60,
      "status": "pending_review"
    },
    {
      "id": "033/072",
      "kind": "ayah",
      "ref": "033/072",
      "ar": "إِنَّا عَرَضْنَا ٱلْأَمَانَةَ عَلَى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَٱلْجِبَالِ فَأَبَيْنَ أَن يَحْمِلْنَهَا وَأَشْفَقْنَ مِنْهَا وَحَمَلَهَا ٱلْإِنسَـٰنُ ۖ إِنَّهُۥ كَانَ ظَلُومًا جَهُولًا",
      "tr": "Gerçek şu ki, Biz emanetleri göklere, yere ve dağlara sunduk da onlar bunu yüklenmekten kaçındılar ve ondan korkuya kapıldılar; onu insan yüklendi. Çünkü o, çok zalim, çok cahildir.",
      "en": "Indeed, we offered the Trust to the heavens and the earth and the mountains, and they declined to bear it and feared it; but man [undertook to] bear it. Indeed, he was unjust and ignorant.",
      "priority": 1,
      "surah_number": 33,
      "surah_name": "Ahzab",
      "ayah_number": 72,
      "ayah_end_number": 72,
      "status": "pending_review"
    },
    {
      "id": "034/013",
      "kind": "ayah",
      "ref": "034/013",
      "ar": "يَعْمَلُونَ لَهُۥ مَا يَشَآءُ مِن مَّحَـٰرِيبَ وَتَمَـٰثِيلَ وَجِفَانٍ كَٱلْجَوَابِ وَقُدُورٍ رَّاسِيَـٰتٍ ۚ ٱعْمَلُوٓا۟ ءَالَ دَاوُۥدَ شُكْرًا ۚ وَقَلِيلٌ مِّنْ عِبَادِىَ ٱلشَّكُورُ",
      "tr": "Ona dilediği şekilde kaleler, heykeller, havuz büyüklüğünde çanaklar ve yerinden sökülmeyen kazanlar yaparlardı. \"Ey Davud ailesi, şükrederek çalışın.\" Kullarımdan şükredenler azdır.",
      "en": "They made for him what he willed of elevated chambers, statues, bowls like reservoirs, and stationary kettles. [We said], \"Work, O family of David, in gratitude.\" And few of My servants are grateful.",
      "priority": 1,
      "surah_number": 34,
      "surah_name": "Sebe",
      "ayah_number": 13,
      "ayah_end_number": 13,
      "status": "pending_review"
    },
    {
      "id": "034/040",
      "kind": "ayah",
      "ref": "034/040",
      "ar": "وَيَوْمَ يَحْشُرُهُمْ جَمِيعًا ثُمَّ يَقُولُ لِلْمَلَـٰٓئِكَةِ أَهَـٰٓؤُلَآءِ إِيَّاكُمْ كَانُوا۟ يَعْبُدُونَ",
      "tr": "O gün, onların hepsini birarada toplayacak (haşredecek), sonra meleklere diyecek ki: \"Size tapanlar bunlar mıydı?\"",
      "en": "And [mention] the Day when He will gather them all and then say to the angels, \"Did these [people] used to worship you?\"",
      "priority": 1,
      "surah_number": 34,
      "surah_name": "Sebe",
      "ayah_number": 40,
      "ayah_end_number": 40,
      "status": "pending_review"
    },
    {
      "id": "034/041",
      "kind": "ayah",
      "ref": "034/041",
      "ar": "قَالُوا۟ سُبْحَـٰنَكَ أَنتَ وَلِيُّنَا مِن دُونِهِم ۖ بَلْ كَانُوا۟ يَعْبُدُونَ ٱلْجِنَّ ۖ أَكْثَرُهُم بِهِم مُّؤْمِنُونَ",
      "tr": "(Melekler) Derler ki: \"Sen Yücesin, bizim velimiz Sensin, onlar değil. Hayır, onlar cinlere tapıyordu ve çoğu onlara iman etmişlerdi.\"",
      "en": "They will say, \"Exalted are You! You, [O Allah], are our benefactor not them. Rather, they used to worship the jinn; most of them were believers in them.\"",
      "priority": 1,
      "surah_number": 34,
      "surah_name": "Sebe",
      "ayah_number": 41,
      "ayah_end_number": 41,
      "status": "pending_review"
    },
    {
      "id": "034/043",
      "kind": "ayah",
      "ref": "034/043",
      "ar": "وَإِذَا تُتْلَىٰ عَلَيْهِمْ ءَايَـٰتُنَا بَيِّنَـٰتٍ قَالُوا۟ مَا هَـٰذَآ إِلَّا رَجُلٌ يُرِيدُ أَن يَصُدَّكُمْ عَمَّا كَانَ يَعْبُدُ ءَابَآؤُكُمْ وَقَالُوا۟ مَا هَـٰذَآ إِلَّآ إِفْكٌ مُّفْتَرًى ۚ وَقَالَ ٱلَّذِينَ كَفَرُوا۟ لِلْحَقِّ لَمَّا جَآءَهُمْ إِنْ هَـٰذَآ إِلَّا سِحْرٌ مُّبِينٌ",
      "tr": "Onlara, apaçık olan ayetlerimiz okunduğunda: \"Bu, sizi babalarınızın taptıkların(ilahlar)dan alıkoymak isteyen bir adamdan başkası değildir\" dediler. Ve dediler ki: \"Bu, düzülüp uydurulmuş bir yalan (iftira)dan başka bir şey de değildir.\" İnkar edenler de, kendilerine geldiği zaman hak için: \"Bu, apaçık bir büyüden başka bir şey değildir\" dediler.",
      "en": "And when our verses are recited to them as clear evidences, they say, \"This is not but a man who wishes to avert you from that which your fathers were worshipping.\" And they say, \"This is not except a lie invented.\" And those who disbelieve say of the truth when it has come to them, \"This is not but obvious magic.\"",
      "priority": 1,
      "surah_number": 34,
      "surah_name": "Sebe",
      "ayah_number": 43,
      "ayah_end_number": 43,
      "status": "pending_review"
    },
    {
      "id": "034/040-041",
      "kind": "ayah",
      "ref": "034/040-041",
      "ar": "﴿40﴾ وَيَوْمَ يَحْشُرُهُمْ جَمِيعًا ثُمَّ يَقُولُ لِلْمَلَـٰٓئِكَةِ أَهَـٰٓؤُلَآءِ إِيَّاكُمْ كَانُوا۟ يَعْبُدُونَ\n\n﴿41﴾ قَالُوا۟ سُبْحَـٰنَكَ أَنتَ وَلِيُّنَا مِن دُونِهِم ۖ بَلْ كَانُوا۟ يَعْبُدُونَ ٱلْجِنَّ ۖ أَكْثَرُهُم بِهِم مُّؤْمِنُونَ",
      "tr": "[40] O gün, onların hepsini birarada toplayacak (haşredecek), sonra meleklere diyecek ki: \"Size tapanlar bunlar mıydı?\"\n\n[41] (Melekler) Derler ki: \"Sen Yücesin, bizim velimiz Sensin, onlar değil. Hayır, onlar cinlere tapıyordu ve çoğu onlara iman etmişlerdi.\"",
      "en": "[40] And [mention] the Day when He will gather them all and then say to the angels, \"Did these [people] used to worship you?\"\n\n[41] They will say, \"Exalted are You! You, [O Allah], are our benefactor not them. Rather, they used to worship the jinn; most of them were believers in them.\"",
      "priority": 1,
      "surah_number": 34,
      "surah_name": "Sebe",
      "ayah_number": 40,
      "ayah_end_number": 41,
      "status": "pending_review"
    },
    {
      "id": "034/046",
      "kind": "ayah",
      "ref": "034/046",
      "ar": "قُلْ إِنَّمَآ أَعِظُكُم بِوَٰحِدَةٍ ۖ أَن تَقُومُوا۟ لِلَّهِ مَثْنَىٰ وَفُرَٰدَىٰ ثُمَّ تَتَفَكَّرُوا۟ ۚ مَا بِصَاحِبِكُم مِّن جِنَّةٍ ۚ إِنْ هُوَ إِلَّا نَذِيرٌ لَّكُم بَيْنَ يَدَىْ عَذَابٍ شَدِيدٍ",
      "tr": "De ki: \"Size bir tek öğüt veriyorum: “Allah için ikişer ikişer ve teker teker kıyam etmeniz, sonra düşünmeniz. Sizin sahibiniz (veya arkadaşınız olan Peygamber)de hiçbir delilik yoktur. O, yalnızca sizi, şiddetli bir azabın öncesinde uyarandır.\"",
      "en": "Say, \"I only advise you of one [thing] - that you stand for Allah, [seeking truth] in pairs and individually, and then give thought.\" There is not in your companion any madness. He is only a warner to you before a severe punishment.",
      "priority": 1,
      "surah_number": 34,
      "surah_name": "Sebe",
      "ayah_number": 46,
      "ayah_end_number": 46,
      "status": "pending_review"
    },
    {
      "id": "034/049",
      "kind": "ayah",
      "ref": "034/049",
      "ar": "قُلْ جَآءَ ٱلْحَقُّ وَمَا يُبْدِئُ ٱلْبَـٰطِلُ وَمَا يُعِيدُ",
      "tr": "De ki: \"Hak geldi; batıl ise ne (bir şey) ortaya çıkarabilir, ne geri getirebilir.”",
      "en": "Say, \"The truth has come, and falsehood can neither begin [anything] nor repeat [it].\"",
      "priority": 1,
      "surah_number": 34,
      "surah_name": "Sebe",
      "ayah_number": 49,
      "ayah_end_number": 49,
      "status": "pending_review"
    },
    {
      "id": "035/005",
      "kind": "ayah",
      "ref": "035/005",
      "ar": "يَـٰٓأَيُّهَا ٱلنَّاسُ إِنَّ وَعْدَ ٱللَّهِ حَقٌّ ۖ فَلَا تَغُرَّنَّكُمُ ٱلْحَيَوٰةُ ٱلدُّنْيَا ۖ وَلَا يَغُرَّنَّكُم بِٱللَّهِ ٱلْغَرُورُ",
      "tr": "Ey insanlar, hiç şüphesiz Allah'ın va'di haktır; öyleyse dünya hayatı sizi aldatmasın ve aldatıcı(lar) da, sizi Allah ile (Allah'ın adını kullanarak) aldatmasın.",
      "en": "O mankind, indeed the promise of Allah is truth, so let not the worldly life delude you and be not deceived about Allah by the Deceiver.",
      "priority": 1,
      "surah_number": 35,
      "surah_name": "Fatir",
      "ayah_number": 5,
      "ayah_end_number": 5,
      "status": "pending_review"
    },
    {
      "id": "035/015",
      "kind": "ayah",
      "ref": "035/015",
      "ar": "يَـٰٓأَيُّهَا ٱلنَّاسُ أَنتُمُ ٱلْفُقَرَآءُ إِلَى ٱللَّهِ ۖ وَٱللَّهُ هُوَ ٱلْغَنِىُّ ٱلْحَمِيدُ",
      "tr": "Ey insanlar, siz Allah'a (karşı fakir olan) muhtaçlarsınız; Allah ise, Ğaniy (hiçbir şeye ihtiyacı olmayan)dır, Hamid (övülmeye layık)tır.",
      "en": "O mankind, you are those in need of Allah, while Allah is the Free of need, the Praiseworthy.",
      "priority": 1,
      "surah_number": 35,
      "surah_name": "Fatir",
      "ayah_number": 15,
      "ayah_end_number": 15,
      "status": "pending_review"
    },
    {
      "id": "035/018",
      "kind": "ayah",
      "ref": "035/018",
      "ar": "وَلَا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَىٰ ۚ وَإِن تَدْعُ مُثْقَلَةٌ إِلَىٰ حِمْلِهَا لَا يُحْمَلْ مِنْهُ شَىْءٌ وَلَوْ كَانَ ذَا قُرْبَىٰٓ ۗ إِنَّمَا تُنذِرُ ٱلَّذِينَ يَخْشَوْنَ رَبَّهُم بِٱلْغَيْبِ وَأَقَامُوا۟ ٱلصَّلَوٰةَ ۚ وَمَن تَزَكَّىٰ فَإِنَّمَا يَتَزَكَّىٰ لِنَفْسِهِۦ ۚ وَإِلَى ٱللَّهِ ٱلْمَصِيرُ",
      "tr": "Hiçbir günahkar bir başka günahkarın günahını yüklenemez. Eğer yükü ağır olan kimse (bir başkasını) onu taşımaya çağırsa, -bu, yakın-akrabası da olsa- kendisine ondan hiçbir şey yükletilmez. Sen, yalnızca gayb ile Rablerinden 'içleri titreyerek-korkmakta' olanları ve dosdoğru namazı kılanları uyarırsın. Kim temizlenip-arınırsa, artık o, kendi nefsi için temizlenip-arınmıştır. Sonunda dönüş Allah'adır.",
      "en": "And no bearer of burdens will bear the burden of another. And if a heavily laden soul calls [another] to [carry some of] its load, nothing of it will be carried, even if he should be a close relative. You can only warn those who fear their Lord unseen and have established prayer. And whoever purifies himself only purifies himself for [the benefit of] his soul. And to Allah is the [final] destination.",
      "priority": 1,
      "surah_number": 35,
      "surah_name": "Fatir",
      "ayah_number": 18,
      "ayah_end_number": 18,
      "status": "pending_review"
    },
    {
      "id": "035/019",
      "kind": "ayah",
      "ref": "035/019",
      "ar": "وَمَا يَسْتَوِى ٱلْأَعْمَىٰ وَٱلْبَصِيرُ",
      "tr": "Kör olanla (basiretle) gören bir değildir;",
      "en": "Not equal are the blind and the seeing,",
      "priority": 1,
      "surah_number": 35,
      "surah_name": "Fatir",
      "ayah_number": 19,
      "ayah_end_number": 19,
      "status": "pending_review"
    },
    {
      "id": "035/020",
      "kind": "ayah",
      "ref": "035/020",
      "ar": "وَلَا ٱلظُّلُمَـٰتُ وَلَا ٱلنُّورُ",
      "tr": "Karanlıklarla aydınlık,",
      "en": "Nor are the darknesses and the light,",
      "priority": 1,
      "surah_number": 35,
      "surah_name": "Fatir",
      "ayah_number": 20,
      "ayah_end_number": 20,
      "status": "pending_review"
    },
    {
      "id": "035/021",
      "kind": "ayah",
      "ref": "035/021",
      "ar": "وَلَا ٱلظِّلُّ وَلَا ٱلْحَرُورُ",
      "tr": "Gölge ile sıcaklık da.",
      "en": "Nor are the shade and the heat,",
      "priority": 1,
      "surah_number": 35,
      "surah_name": "Fatir",
      "ayah_number": 21,
      "ayah_end_number": 21,
      "status": "pending_review"
    },
    {
      "id": "035/022",
      "kind": "ayah",
      "ref": "035/022",
      "ar": "وَمَا يَسْتَوِى ٱلْأَحْيَآءُ وَلَا ٱلْأَمْوَٰتُ ۚ إِنَّ ٱللَّهَ يُسْمِعُ مَن يَشَآءُ ۖ وَمَآ أَنتَ بِمُسْمِعٍ مَّن فِى ٱلْقُبُورِ",
      "tr": "Diri olanlarla ölüler de bir değildir. Gerçekten Allah, dilediğine işittirir; sen ise kabirlerde olanlara işittirecek değilsin.",
      "en": "And not equal are the living and the dead. Indeed, Allah causes to hear whom He wills, but you cannot make hear those in the graves.",
      "priority": 1,
      "surah_number": 35,
      "surah_name": "Fatir",
      "ayah_number": 22,
      "ayah_end_number": 22,
      "status": "pending_review"
    },
    {
      "id": "035/024",
      "kind": "ayah",
      "ref": "035/024",
      "ar": "إِنَّآ أَرْسَلْنَـٰكَ بِٱلْحَقِّ بَشِيرًا وَنَذِيرًا ۚ وَإِن مِّنْ أُمَّةٍ إِلَّا خَلَا فِيهَا نَذِيرٌ",
      "tr": "Şüphesiz Biz seni, hak ile bir müjde verici ve bir uyarıcı olarak gönderdik. Hiçbir ümmet yoktur ki, içinde bir uyarıcı gelip-geçmiş olmasın.",
      "en": "Indeed, We have sent you with the truth as a bringer of good tidings and a warner. And there was no nation but that there had passed within it a warner.",
      "priority": 1,
      "surah_number": 35,
      "surah_name": "Fatir",
      "ayah_number": 24,
      "ayah_end_number": 24,
      "status": "pending_review"
    },
    {
      "id": "035/028",
      "kind": "ayah",
      "ref": "035/028",
      "ar": "وَمِنَ ٱلنَّاسِ وَٱلدَّوَآبِّ وَٱلْأَنْعَـٰمِ مُخْتَلِفٌ أَلْوَٰنُهُۥ كَذَٰلِكَ ۗ إِنَّمَا يَخْشَى ٱللَّهَ مِنْ عِبَادِهِ ٱلْعُلَمَـٰٓؤُا۟ ۗ إِنَّ ٱللَّهَ عَزِيزٌ غَفُورٌ",
      "tr": "İnsanlardan, hayvanlardan ve davarlardan da renkleri böyle değişik olanlar vardır. Kulları içinde ise Allah'tan ancak alim olanlar 'içleri titreyerek-korkar'. Şüphesiz Allah, üstün ve güçlü olandır, bağışlayandır.",
      "en": "And among people and moving creatures and grazing livestock are various colors similarly. Only those fear Allah, from among His servants, who have knowledge. Indeed, Allah is Exalted in Might and Forgiving.",
      "priority": 1,
      "surah_number": 35,
      "surah_name": "Fatir",
      "ayah_number": 28,
      "ayah_end_number": 28,
      "status": "pending_review"
    },
    {
      "id": "035/036",
      "kind": "ayah",
      "ref": "035/036",
      "ar": "وَٱلَّذِينَ كَفَرُوا۟ لَهُمْ نَارُ جَهَنَّمَ لَا يُقْضَىٰ عَلَيْهِمْ فَيَمُوتُوا۟ وَلَا يُخَفَّفُ عَنْهُم مِّنْ عَذَابِهَا ۚ كَذَٰلِكَ نَجْزِى كُلَّ كَفُورٍ",
      "tr": "İnkar edenlere gelince, onlar için de cehennem ateşi vardır. Onlar için ne, karar verilir, ki böylece ölüversinler, ne de kendilerine onun azabından (bir şey) hafifletilir. İşte Biz, her nankör olanı böyle cezalandırırız.",
      "en": "And for those who disbelieve will be the fire of Hell. [Death] is not decreed for them so they may die, nor will its torment be lightened for them. Thus do we recompense every ungrateful one.",
      "priority": 1,
      "surah_number": 35,
      "surah_name": "Fatir",
      "ayah_number": 36,
      "ayah_end_number": 36,
      "status": "pending_review"
    },
    {
      "id": "035/040",
      "kind": "ayah",
      "ref": "035/040",
      "ar": "قُلْ أَرَءَيْتُمْ شُرَكَآءَكُمُ ٱلَّذِينَ تَدْعُونَ مِن دُونِ ٱللَّهِ أَرُونِى مَاذَا خَلَقُوا۟ مِنَ ٱلْأَرْضِ أَمْ لَهُمْ شِرْكٌ فِى ٱلسَّمَـٰوَٰتِ أَمْ ءَاتَيْنَـٰهُمْ كِتَـٰبًا فَهُمْ عَلَىٰ بَيِّنَتٍ مِّنْهُ ۚ بَلْ إِن يَعِدُ ٱلظَّـٰلِمُونَ بَعْضُهُم بَعْضًا إِلَّا غُرُورًا",
      "tr": "De ki: \"Siz, Allah'ın dışında taptığınız ortaklarınızı gördünüz mü? Bana haber verin; yerden neyi yaratmışlardır? Ya da onların göklerde bir ortaklığı mı var? Yoksa Biz onlara bir kitap vermişiz de onlar bundan (dolayı) apaçık bir belge üzerinde midirler? Hayır, zulmedenler, birbirlerine aldatmadan başkasını vadetmiyorlar.",
      "en": "Say, \"Have you considered your 'partners' whom you invoke besides Allah? Show me what they have created from the earth, or have they partnership [with Him] in the heavens? Or have We given them a book so they are [standing] on evidence therefrom? [No], rather, the wrongdoers do not promise each other except delusion.\"",
      "priority": 1,
      "surah_number": 35,
      "surah_name": "Fatir",
      "ayah_number": 40,
      "ayah_end_number": 40,
      "status": "pending_review"
    },
    {
      "id": "035/043",
      "kind": "ayah",
      "ref": "035/043",
      "ar": "ٱسْتِكْبَارًا فِى ٱلْأَرْضِ وَمَكْرَ ٱلسَّيِّئِ ۚ وَلَا يَحِيقُ ٱلْمَكْرُ ٱلسَّيِّئُ إِلَّا بِأَهْلِهِۦ ۚ فَهَلْ يَنظُرُونَ إِلَّا سُنَّتَ ٱلْأَوَّلِينَ ۚ فَلَن تَجِدَ لِسُنَّتِ ٱللَّهِ تَبْدِيلًا ۖ وَلَن تَجِدَ لِسُنَّتِ ٱللَّهِ تَحْوِيلًا",
      "tr": "(Hem de) Yeryüzünde büyüklük taslayarak ve kötülüğü tasarlayıp düzenleyerek. Oysa hileli düzen, kendi sahibinden başkasını sarıp-kuşatmaz. Artık onlar öncekilerin sünnetinden başkasını mı gözlemektedirler? Sen, Allah'ın sünnetinde kesinlikle bir değişiklik bulamazsın ve sen, Allah'ın sünnetinde kesinlikle bir dönüşüm de bulamazsın.",
      "en": "[Due to] arrogance in the land and plotting of evil; but the evil plot does not encompass except its own people. Then do they await except the way of the former peoples? But you will never find in the way of Allah any change, and you will never find in the way of Allah any alteration.",
      "priority": 1,
      "surah_number": 35,
      "surah_name": "Fatir",
      "ayah_number": 43,
      "ayah_end_number": 43,
      "status": "pending_review"
    },
    {
      "id": "035/044",
      "kind": "ayah",
      "ref": "035/044",
      "ar": "أَوَلَمْ يَسِيرُوا۟ فِى ٱلْأَرْضِ فَيَنظُرُوا۟ كَيْفَ كَانَ عَـٰقِبَةُ ٱلَّذِينَ مِن قَبْلِهِمْ وَكَانُوٓا۟ أَشَدَّ مِنْهُمْ قُوَّةً ۚ وَمَا كَانَ ٱللَّهُ لِيُعْجِزَهُۥ مِن شَىْءٍ فِى ٱلسَّمَـٰوَٰتِ وَلَا فِى ٱلْأَرْضِ ۚ إِنَّهُۥ كَانَ عَلِيمًا قَدِيرًا",
      "tr": "Yeryüzünde gezip dolaşmıyorlar mı ki, kendilerinden öncekilerin nasıl bir sona uğradıklarını görsünler; üstelik onlar kuvvet bakımından kendilerinden daha güçlüydüler. Göklerde ve yerde Allah'ı aciz bırakacak hiçbir şey yoktur. Şüphesiz O, bilendir, güç yetirendir.",
      "en": "Have they not traveled through the land and observed how was the end of those before them? And they were greater than them in power. But Allah is not to be caused failure by anything in the heavens or on the earth. Indeed, He is ever Knowing and Competent.",
      "priority": 1,
      "surah_number": 35,
      "surah_name": "Fatir",
      "ayah_number": 44,
      "ayah_end_number": 44,
      "status": "pending_review"
    },
    {
      "id": "036/010",
      "kind": "ayah",
      "ref": "036/010",
      "ar": "وَسَوَآءٌ عَلَيْهِمْ ءَأَنذَرْتَهُمْ أَمْ لَمْ تُنذِرْهُمْ لَا يُؤْمِنُونَ",
      "tr": "Kendilerini uyarsan da, uyarmasan da onlar için birdir; inanmazlar.",
      "en": "And it is all the same for them whether you warn them or do not warn them - they will not believe.",
      "priority": 1,
      "surah_number": 36,
      "surah_name": "Yasin",
      "ayah_number": 10,
      "ayah_end_number": 10,
      "status": "pending_review"
    },
    {
      "id": "036/011",
      "kind": "ayah",
      "ref": "036/011",
      "ar": "إِنَّمَا تُنذِرُ مَنِ ٱتَّبَعَ ٱلذِّكْرَ وَخَشِىَ ٱلرَّحْمَـٰنَ بِٱلْغَيْبِ ۖ فَبَشِّرْهُ بِمَغْفِرَةٍ وَأَجْرٍ كَرِيمٍ",
      "tr": "Sen ancak, zikre (Kur'an'a) uyan ve gayb ile Rahman olan (Allah')a (karşı) içi titreyerek korku duyan kimseyi uyarırsın. İşte böylesini, bir bağışlanma ve üstün bir ecirle müjdele.",
      "en": "You can only warn one who follows the message and fears the Most Merciful unseen. So give him good tidings of forgiveness and noble reward.",
      "priority": 1,
      "surah_number": 36,
      "surah_name": "Yasin",
      "ayah_number": 11,
      "ayah_end_number": 11,
      "status": "pending_review"
    },
    {
      "id": "036/017",
      "kind": "ayah",
      "ref": "036/017",
      "ar": "وَمَا عَلَيْنَآ إِلَّا ٱلْبَلَـٰغُ ٱلْمُبِينُ",
      "tr": "\"Bizim üzerimizde de (sorumluluk ve görev olarak) apaçık bir tebliğden başkası yoktur.\"",
      "en": "And we are not responsible except for clear notification.\"",
      "priority": 1,
      "surah_number": 36,
      "surah_name": "Yasin",
      "ayah_number": 17,
      "ayah_end_number": 17,
      "status": "pending_review"
    },
    {
      "id": "036/010-011",
      "kind": "ayah",
      "ref": "036/010-011",
      "ar": "﴿10﴾ وَسَوَآءٌ عَلَيْهِمْ ءَأَنذَرْتَهُمْ أَمْ لَمْ تُنذِرْهُمْ لَا يُؤْمِنُونَ\n\n﴿11﴾ إِنَّمَا تُنذِرُ مَنِ ٱتَّبَعَ ٱلذِّكْرَ وَخَشِىَ ٱلرَّحْمَـٰنَ بِٱلْغَيْبِ ۖ فَبَشِّرْهُ بِمَغْفِرَةٍ وَأَجْرٍ كَرِيمٍ",
      "tr": "[10] Kendilerini uyarsan da, uyarmasan da onlar için birdir; inanmazlar.\n\n[11] Sen ancak, zikre (Kur'an'a) uyan ve gayb ile Rahman olan (Allah')a (karşı) içi titreyerek korku duyan kimseyi uyarırsın. İşte böylesini, bir bağışlanma ve üstün bir ecirle müjdele.",
      "en": "[10] And it is all the same for them whether you warn them or do not warn them - they will not believe.\n\n[11] You can only warn one who follows the message and fears the Most Merciful unseen. So give him good tidings of forgiveness and noble reward.",
      "priority": 1,
      "surah_number": 36,
      "surah_name": "Yasin",
      "ayah_number": 10,
      "ayah_end_number": 11,
      "status": "pending_review"
    },
    {
      "id": "036/023",
      "kind": "ayah",
      "ref": "036/023",
      "ar": "ءَأَتَّخِذُ مِن دُونِهِۦٓ ءَالِهَةً إِن يُرِدْنِ ٱلرَّحْمَـٰنُ بِضُرٍّ لَّا تُغْنِ عَنِّى شَفَـٰعَتُهُمْ شَيْـًٔا وَلَا يُنقِذُونِ",
      "tr": "\"Ben, O'ndan başka İlahlar edinir miyim ki, Rahman (olan Allah), bana bir zarar dileyecek olsa, ne onların şefaati bana bir şeyle yarar sağlar, ne de onlar beni kurtarabilirler.\"",
      "en": "Should I take other than Him [false] deities [while], if the Most Merciful intends for me some adversity, their intercession will not avail me at all, nor can they save me?",
      "priority": 1,
      "surah_number": 36,
      "surah_name": "Yasin",
      "ayah_number": 23,
      "ayah_end_number": 23,
      "status": "pending_review"
    },
    {
      "id": "036/036",
      "kind": "ayah",
      "ref": "036/036",
      "ar": "سُبْحَـٰنَ ٱلَّذِى خَلَقَ ٱلْأَزْوَٰجَ كُلَّهَا مِمَّا تُنۢبِتُ ٱلْأَرْضُ وَمِنْ أَنفُسِهِمْ وَمِمَّا لَا يَعْلَمُونَ",
      "tr": "Yerin bitirdiklerinden, kendi nefislerinden ve daha bilmedikleri nice şeylerden bütün çiftleri yaratan (Allah çok) Yücedir.",
      "en": "Exalted is He who created all pairs - from what the earth grows and from themselves and from that which they do not know.",
      "priority": 1,
      "surah_number": 36,
      "surah_name": "Yasin",
      "ayah_number": 36,
      "ayah_end_number": 36,
      "status": "pending_review"
    },
    {
      "id": "036/054",
      "kind": "ayah",
      "ref": "036/054",
      "ar": "فَٱلْيَوْمَ لَا تُظْلَمُ نَفْسٌ شَيْـًٔا وَلَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ",
      "tr": "İşte bugün hiç kimseye (hiç)bir şeyle zulmedilmez ve siz de yaptıklarınızdan başkasıyla karşılık görmezsiniz.",
      "en": "So today no soul will be wronged at all, and you will not be recompensed except for what you used to do.",
      "priority": 1,
      "surah_number": 36,
      "surah_name": "Yasin",
      "ayah_number": 54,
      "ayah_end_number": 54,
      "status": "pending_review"
    },
    {
      "id": "036/061",
      "kind": "ayah",
      "ref": "036/061",
      "ar": "وَأَنِ ٱعْبُدُونِى ۚ هَـٰذَا صِرَٰطٌ مُّسْتَقِيمٌ",
      "tr": "\"Bana kulluk edin, doğru yol budur.\"",
      "en": "And that you worship [only] Me? This is a straight path.",
      "priority": 1,
      "surah_number": 36,
      "surah_name": "Yasin",
      "ayah_number": 61,
      "ayah_end_number": 61,
      "status": "pending_review"
    },
    {
      "id": "036/081",
      "kind": "ayah",
      "ref": "036/081",
      "ar": "أَوَلَيْسَ ٱلَّذِى خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ بِقَـٰدِرٍ عَلَىٰٓ أَن يَخْلُقَ مِثْلَهُم ۚ بَلَىٰ وَهُوَ ٱلْخَلَّـٰقُ ٱلْعَلِيمُ",
      "tr": "Gökleri ve yeri yaratan, onların bir benzerini yaratmağa kadir değil mi? Elbette (öyledir); O, yaratandır, bilendir.",
      "en": "Is not He who created the heavens and the earth Able to create the likes of them? Yes, [it is so]; and He is the Knowing Creator.",
      "priority": 1,
      "surah_number": 36,
      "surah_name": "Yasin",
      "ayah_number": 81,
      "ayah_end_number": 81,
      "status": "pending_review"
    },
    {
      "id": "037/015",
      "kind": "ayah",
      "ref": "037/015",
      "ar": "وَقَالُوٓا۟ إِنْ هَـٰذَآ إِلَّا سِحْرٌ مُّبِينٌ",
      "tr": "\"Bu, açıkça bir büyüden başkası değildir\" dediler.",
      "en": "And say, \"This is not but obvious magic.",
      "priority": 1,
      "surah_number": 37,
      "surah_name": "Saffat",
      "ayah_number": 15,
      "ayah_end_number": 15,
      "status": "pending_review"
    },
    {
      "id": "037/020",
      "kind": "ayah",
      "ref": "037/020",
      "ar": "وَقَالُوا۟ يَـٰوَيْلَنَا هَـٰذَا يَوْمُ ٱلدِّينِ",
      "tr": "Derler ki: \"Eyvahlar bize; bu, din günüdür.\"",
      "en": "They will say, \"O woe to us! This is the Day of Recompense.\"",
      "priority": 1,
      "surah_number": 37,
      "surah_name": "Saffat",
      "ayah_number": 20,
      "ayah_end_number": 20,
      "status": "pending_review"
    },
    {
      "id": "037/039",
      "kind": "ayah",
      "ref": "037/039",
      "ar": "وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ",
      "tr": "Yaptıklarınızdan başkasıyla cezalandırılmayacaksınız.",
      "en": "And you will not be recompensed except for what you used to do -",
      "priority": 1,
      "surah_number": 37,
      "surah_name": "Saffat",
      "ayah_number": 39,
      "ayah_end_number": 39,
      "status": "pending_review"
    },
    {
      "id": "037/045",
      "kind": "ayah",
      "ref": "037/045",
      "ar": "يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍۭ",
      "tr": "Kaynaktan (doldurulmuş) kadehlerle çevrelerinde dolaşılır.",
      "en": "There will be circulated among them a cup [of wine] from a flowing spring,",
      "priority": 1,
      "surah_number": 37,
      "surah_name": "Saffat",
      "ayah_number": 45,
      "ayah_end_number": 45,
      "status": "pending_review"
    },
    {
      "id": "037/046",
      "kind": "ayah",
      "ref": "037/046",
      "ar": "بَيْضَآءَ لَذَّةٍ لِّلشَّـٰرِبِينَ",
      "tr": "Bembeyaz; içenlere lezzet (veren bir içki).",
      "en": "White and delicious to the drinkers;",
      "priority": 1,
      "surah_number": 37,
      "surah_name": "Saffat",
      "ayah_number": 46,
      "ayah_end_number": 46,
      "status": "pending_review"
    },
    {
      "id": "037/095",
      "kind": "ayah",
      "ref": "037/095",
      "ar": "قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ",
      "tr": "Dedi ki: “Yontmakta olduğunuz şeylere mi tapıyorsunuz?”",
      "en": "He said, \"Do you worship that which you [yourselves] carve,",
      "priority": 1,
      "surah_number": 37,
      "surah_name": "Saffat",
      "ayah_number": 95,
      "ayah_end_number": 95,
      "status": "pending_review"
    },
    {
      "id": "037/045-046",
      "kind": "ayah",
      "ref": "037/045-046",
      "ar": "﴿45﴾ يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍۭ\n\n﴿46﴾ بَيْضَآءَ لَذَّةٍ لِّلشَّـٰرِبِينَ",
      "tr": "[45] Kaynaktan (doldurulmuş) kadehlerle çevrelerinde dolaşılır.\n\n[46] Bembeyaz; içenlere lezzet (veren bir içki).",
      "en": "[45] There will be circulated among them a cup [of wine] from a flowing spring,\n\n[46] White and delicious to the drinkers;",
      "priority": 1,
      "surah_number": 37,
      "surah_name": "Saffat",
      "ayah_number": 45,
      "ayah_end_number": 46,
      "status": "pending_review"
    },
    {
      "id": "037/096",
      "kind": "ayah",
      "ref": "037/096",
      "ar": "وَٱللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَ",
      "tr": "“Oysa sizi de, yapmakta olduklarınızı da Allah yaratmıştır.”",
      "en": "While Allah created you and that which you do?\"",
      "priority": 1,
      "surah_number": 37,
      "surah_name": "Saffat",
      "ayah_number": 96,
      "ayah_end_number": 96,
      "status": "pending_review"
    },
    {
      "id": "037/136",
      "kind": "ayah",
      "ref": "037/136",
      "ar": "ثُمَّ دَمَّرْنَا ٱلْءَاخَرِينَ",
      "tr": "Sonra geride kalanları yerle bir ettik.",
      "en": "Then We destroyed the others.",
      "priority": 1,
      "surah_number": 37,
      "surah_name": "Saffat",
      "ayah_number": 136,
      "ayah_end_number": 136,
      "status": "pending_review"
    },
    {
      "id": "037/095-096",
      "kind": "ayah",
      "ref": "037/095-096",
      "ar": "﴿95﴾ قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ\n\n﴿96﴾ وَٱللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَ",
      "tr": "[95] Dedi ki: “Yontmakta olduğunuz şeylere mi tapıyorsunuz?”\n\n[96] “Oysa sizi de, yapmakta olduklarınızı da Allah yaratmıştır.”",
      "en": "[95] He said, \"Do you worship that which you [yourselves] carve,\n\n[96] While Allah created you and that which you do?\"",
      "priority": 1,
      "surah_number": 37,
      "surah_name": "Saffat",
      "ayah_number": 95,
      "ayah_end_number": 96,
      "status": "pending_review"
    },
    {
      "id": "037/149",
      "kind": "ayah",
      "ref": "037/149",
      "ar": "فَٱسْتَفْتِهِمْ أَلِرَبِّكَ ٱلْبَنَاتُ وَلَهُمُ ٱلْبَنُونَ",
      "tr": "Şimdi sen onlara sor: -Kızlar senin Rabbinin, erkek çocuklar onların mı?",
      "en": "So inquire of them, [O Muhammad], \"Does your Lord have daughters while they have sons?",
      "priority": 1,
      "surah_number": 37,
      "surah_name": "Saffat",
      "ayah_number": 149,
      "ayah_end_number": 149,
      "status": "pending_review"
    },
    {
      "id": "037/150",
      "kind": "ayah",
      "ref": "037/150",
      "ar": "أَمْ خَلَقْنَا ٱلْمَلَـٰٓئِكَةَ إِنَـٰثًا وَهُمْ شَـٰهِدُونَ",
      "tr": "Yoksa onlar, şahidlik etmekteyken Biz melekleri dişiler olarak mı yarattık?",
      "en": "Or did We create the angels as females while they were witnesses?\"",
      "priority": 1,
      "surah_number": 37,
      "surah_name": "Saffat",
      "ayah_number": 150,
      "ayah_end_number": 150,
      "status": "pending_review"
    },
    {
      "id": "038/026",
      "kind": "ayah",
      "ref": "038/026",
      "ar": "يَـٰدَاوُۥدُ إِنَّا جَعَلْنَـٰكَ خَلِيفَةً فِى ٱلْأَرْضِ فَٱحْكُم بَيْنَ ٱلنَّاسِ بِٱلْحَقِّ وَلَا تَتَّبِعِ ٱلْهَوَىٰ فَيُضِلَّكَ عَن سَبِيلِ ٱللَّهِ ۚ إِنَّ ٱلَّذِينَ يَضِلُّونَ عَن سَبِيلِ ٱللَّهِ لَهُمْ عَذَابٌ شَدِيدٌۢ بِمَا نَسُوا۟ يَوْمَ ٱلْحِسَابِ",
      "tr": "\"Ey Davud, gerçek şu ki, Biz seni yeryüzünde bir halife kıldık. Öyleyse insanlar arasında hak ile hükmet, istek ve tutkulara (hevaya) uyma; sonra seni Allah'ın yolundan saptırır. Şüphesiz Allah’ın yolundan sapanlara, hesap gününü unutmalarından dolayı şiddetli bir azap vardır.\"",
      "en": "[We said], \"O David, indeed We have made you a successor upon the earth, so judge between the people in truth and do not follow [your own] desire, as it will lead you astray from the way of Allah.\" Indeed, those who go astray from the way of Allah will have a severe punishment for having forgotten the Day of Account.",
      "priority": 1,
      "surah_number": 38,
      "surah_name": "Sad",
      "ayah_number": 26,
      "ayah_end_number": 26,
      "status": "pending_review"
    },
    {
      "id": "038/028",
      "kind": "ayah",
      "ref": "038/028",
      "ar": "أَمْ نَجْعَلُ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ كَٱلْمُفْسِدِينَ فِى ٱلْأَرْضِ أَمْ نَجْعَلُ ٱلْمُتَّقِينَ كَٱلْفُجَّارِ",
      "tr": "Yoksa Biz, iman edip salih amellerde bulunanları yeryüzünde bozgunculuk çıkaranlar gibi (bir) mi tutacağız? Ya da muttakileri facirler gibi (bir) mi tutacağız?",
      "en": "Or should we treat those who believe and do righteous deeds like corrupters in the land? Or should We treat those who fear Allah like the wicked?",
      "priority": 1,
      "surah_number": 38,
      "surah_name": "Sad",
      "ayah_number": 28,
      "ayah_end_number": 28,
      "status": "pending_review"
    },
    {
      "id": "038/029",
      "kind": "ayah",
      "ref": "038/029",
      "ar": "كِتَـٰبٌ أَنزَلْنَـٰهُ إِلَيْكَ مُبَـٰرَكٌ لِّيَدَّبَّرُوٓا۟ ءَايَـٰتِهِۦ وَلِيَتَذَكَّرَ أُو۟لُوا۟ ٱلْأَلْبَـٰبِ",
      "tr": "(Bu Kur'an,) Ayetlerini, iyiden iyiye düşünsünler ve temiz akıl sahipleri öğüt alsınlar diye sana indirdiğimiz mübarek bir Kitap'tır.",
      "en": "[This is] a blessed Book which We have revealed to you, [O Muhammad], that they might reflect upon its verses and that those of understanding would be reminded.",
      "priority": 1,
      "surah_number": 38,
      "surah_name": "Sad",
      "ayah_number": 29,
      "ayah_end_number": 29,
      "status": "pending_review"
    },
    {
      "id": "038/035",
      "kind": "ayah",
      "ref": "038/035",
      "ar": "قَالَ رَبِّ ٱغْفِرْ لِى وَهَبْ لِى مُلْكًا لَّا يَنۢبَغِى لِأَحَدٍ مِّنۢ بَعْدِىٓ ۖ إِنَّكَ أَنتَ ٱلْوَهَّابُ",
      "tr": "\"Rabbim, beni bağışla ve benden sonra hiç kimseye nasib olmayan bir mülkü bana armağan et. Şüphesiz Sen, karşılıksız armağan edensin.\"",
      "en": "He said, \"My Lord, forgive me and grant me a kingdom such as will not belong to anyone after me. Indeed, You are the Bestower.\"",
      "priority": 1,
      "surah_number": 38,
      "surah_name": "Sad",
      "ayah_number": 35,
      "ayah_end_number": 35,
      "status": "pending_review"
    },
    {
      "id": "038/028-029",
      "kind": "ayah",
      "ref": "038/028-029",
      "ar": "﴿28﴾ أَمْ نَجْعَلُ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ كَٱلْمُفْسِدِينَ فِى ٱلْأَرْضِ أَمْ نَجْعَلُ ٱلْمُتَّقِينَ كَٱلْفُجَّارِ\n\n﴿29﴾ كِتَـٰبٌ أَنزَلْنَـٰهُ إِلَيْكَ مُبَـٰرَكٌ لِّيَدَّبَّرُوٓا۟ ءَايَـٰتِهِۦ وَلِيَتَذَكَّرَ أُو۟لُوا۟ ٱلْأَلْبَـٰبِ",
      "tr": "[28] Yoksa Biz, iman edip salih amellerde bulunanları yeryüzünde bozgunculuk çıkaranlar gibi (bir) mi tutacağız? Ya da muttakileri facirler gibi (bir) mi tutacağız?\n\n[29] (Bu Kur'an,) Ayetlerini, iyiden iyiye düşünsünler ve temiz akıl sahipleri öğüt alsınlar diye sana indirdiğimiz mübarek bir Kitap'tır.",
      "en": "[28] Or should we treat those who believe and do righteous deeds like corrupters in the land? Or should We treat those who fear Allah like the wicked?\n\n[29] [This is] a blessed Book which We have revealed to you, [O Muhammad], that they might reflect upon its verses and that those of understanding would be reminded.",
      "priority": 1,
      "surah_number": 38,
      "surah_name": "Sad",
      "ayah_number": 28,
      "ayah_end_number": 29,
      "status": "pending_review"
    },
    {
      "id": "038/078",
      "kind": "ayah",
      "ref": "038/078",
      "ar": "وَإِنَّ عَلَيْكَ لَعْنَتِىٓ إِلَىٰ يَوْمِ ٱلدِّينِ",
      "tr": "\"Ve şüphesiz, din (kıyametteki hesap) gününe kadar Benim lanetim senin üzerinedir.\"",
      "en": "And indeed, upon you is My curse until the Day of Recompense.\"",
      "priority": 1,
      "surah_number": 38,
      "surah_name": "Sad",
      "ayah_number": 78,
      "ayah_end_number": 78,
      "status": "pending_review"
    },
    {
      "id": "039/002",
      "kind": "ayah",
      "ref": "039/002",
      "ar": "إِنَّآ أَنزَلْنَآ إِلَيْكَ ٱلْكِتَـٰبَ بِٱلْحَقِّ فَٱعْبُدِ ٱللَّهَ مُخْلِصًا لَّهُ ٱلدِّينَ",
      "tr": "Şüphesiz, sana bu Kitab'ı hak ile indirdik; öyleyse sen de dini yalnızca O'na halis kılarak Allah'a ibadet et.",
      "en": "Indeed, We have sent down to you the Book, [O Muhammad], in truth. So worship Allah, [being] sincere to Him in religion.",
      "priority": 1,
      "surah_number": 39,
      "surah_name": "Zumer",
      "ayah_number": 2,
      "ayah_end_number": 2,
      "status": "pending_review"
    },
    {
      "id": "039/003",
      "kind": "ayah",
      "ref": "039/003",
      "ar": "أَلَا لِلَّهِ ٱلدِّينُ ٱلْخَالِصُ ۚ وَٱلَّذِينَ ٱتَّخَذُوا۟ مِن دُونِهِۦٓ أَوْلِيَآءَ مَا نَعْبُدُهُمْ إِلَّا لِيُقَرِّبُونَآ إِلَى ٱللَّهِ زُلْفَىٰٓ إِنَّ ٱللَّهَ يَحْكُمُ بَيْنَهُمْ فِى مَا هُمْ فِيهِ يَخْتَلِفُونَ ۗ إِنَّ ٱللَّهَ لَا يَهْدِى مَنْ هُوَ كَـٰذِبٌ كَفَّارٌ",
      "tr": "Haberin olsun; halis (katıksız) olan din yalnızca Allah'ındır. O'ndan başka veliler edinenler (şöyle derler:) \"Biz, bunlara bizi Allah'a daha fazla yaklaştırsınlar diye ibadet ediyoruz.\" Elbette Allah, kendi aralarında hakkında ihtilaf ettikleri şeylerden hüküm verecektir. Gerçekten Allah, yalancı, kafir olan kimseyi hidayete erdirmez.",
      "en": "Unquestionably, for Allah is the pure religion. And those who take protectors besides Him [say], \"We only worship them that they may bring us nearer to Allah in position.\" Indeed, Allah will judge between them concerning that over which they differ. Indeed, Allah does not guide he who is a liar and [confirmed] disbeliever.",
      "priority": 1,
      "surah_number": 39,
      "surah_name": "Zumer",
      "ayah_number": 3,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "039/009",
      "kind": "ayah",
      "ref": "039/009",
      "ar": "أَمَّنْ هُوَ قَـٰنِتٌ ءَانَآءَ ٱلَّيْلِ سَاجِدًا وَقَآئِمًا يَحْذَرُ ٱلْءَاخِرَةَ وَيَرْجُوا۟ رَحْمَةَ رَبِّهِۦ ۗ قُلْ هَلْ يَسْتَوِى ٱلَّذِينَ يَعْلَمُونَ وَٱلَّذِينَ لَا يَعْلَمُونَ ۗ إِنَّمَا يَتَذَكَّرُ أُو۟لُوا۟ ٱلْأَلْبَـٰبِ",
      "tr": "Yoksa o, gece saatinde kalkıp da secde ederek ve kıyama durarak gönülden itaat (ibadet) eden, ahiretten sakınan ve Rabbinin rahmetini umud eden (gibi) midir? De ki: \"Hiç bilenlerle bilmeyenler bir olur mu? Şüphesiz, temiz akıl sahipleri öğüt alıp-düşünürler.\"",
      "en": "Is one who is devoutly obedient during periods of the night, prostrating and standing [in prayer], fearing the Hereafter and hoping for the mercy of his Lord, [like one who does not]? Say, \"Are those who know equal to those who do not know?\" Only they will remember [who are] people of understanding.",
      "priority": 1,
      "surah_number": 39,
      "surah_name": "Zumer",
      "ayah_number": 9,
      "ayah_end_number": 9,
      "status": "pending_review"
    },
    {
      "id": "039/002-003",
      "kind": "ayah",
      "ref": "039/002-003",
      "ar": "﴿2﴾ إِنَّآ أَنزَلْنَآ إِلَيْكَ ٱلْكِتَـٰبَ بِٱلْحَقِّ فَٱعْبُدِ ٱللَّهَ مُخْلِصًا لَّهُ ٱلدِّينَ\n\n﴿3﴾ أَلَا لِلَّهِ ٱلدِّينُ ٱلْخَالِصُ ۚ وَٱلَّذِينَ ٱتَّخَذُوا۟ مِن دُونِهِۦٓ أَوْلِيَآءَ مَا نَعْبُدُهُمْ إِلَّا لِيُقَرِّبُونَآ إِلَى ٱللَّهِ زُلْفَىٰٓ إِنَّ ٱللَّهَ يَحْكُمُ بَيْنَهُمْ فِى مَا هُمْ فِيهِ يَخْتَلِفُونَ ۗ إِنَّ ٱللَّهَ لَا يَهْدِى مَنْ هُوَ كَـٰذِبٌ كَفَّارٌ",
      "tr": "[2] Şüphesiz, sana bu Kitab'ı hak ile indirdik; öyleyse sen de dini yalnızca O'na halis kılarak Allah'a ibadet et.\n\n[3] Haberin olsun; halis (katıksız) olan din yalnızca Allah'ındır. O'ndan başka veliler edinenler (şöyle derler:) \"Biz, bunlara bizi Allah'a daha fazla yaklaştırsınlar diye ibadet ediyoruz.\" Elbette Allah, kendi aralarında hakkında ihtilaf ettikleri şeylerden hüküm verecektir. Gerçekten Allah, yalancı, kafir olan kimseyi hidayete erdirmez.",
      "en": "[2] Indeed, We have sent down to you the Book, [O Muhammad], in truth. So worship Allah, [being] sincere to Him in religion.\n\n[3] Unquestionably, for Allah is the pure religion. And those who take protectors besides Him [say], \"We only worship them that they may bring us nearer to Allah in position.\" Indeed, Allah will judge between them concerning that over which they differ. Indeed, Allah does not guide he who is a liar and [confirmed] disbeliever.",
      "priority": 1,
      "surah_number": 39,
      "surah_name": "Zumer",
      "ayah_number": 2,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "039/011",
      "kind": "ayah",
      "ref": "039/011",
      "ar": "قُلْ إِنِّىٓ أُمِرْتُ أَنْ أَعْبُدَ ٱللَّهَ مُخْلِصًا لَّهُ ٱلدِّينَ",
      "tr": "De ki: \"Ben, dini yalnızca O'na halis kılarak Allah'a ibadet etmekle emrolundum.\"",
      "en": "Say, [O Muhammad], \"Indeed, I have been commanded to worship Allah, [being] sincere to Him in religion.",
      "priority": 1,
      "surah_number": 39,
      "surah_name": "Zumer",
      "ayah_number": 11,
      "ayah_end_number": 11,
      "status": "pending_review"
    },
    {
      "id": "039/017",
      "kind": "ayah",
      "ref": "039/017",
      "ar": "وَٱلَّذِينَ ٱجْتَنَبُوا۟ ٱلطَّـٰغُوتَ أَن يَعْبُدُوهَا وَأَنَابُوٓا۟ إِلَى ٱللَّهِ لَهُمُ ٱلْبُشْرَىٰ ۚ فَبَشِّرْ عِبَادِ",
      "tr": "Tağut'a kulluk etmekten kaçınan ve Allah'a içten yönelenler ise; onlar için bir müjde vardır, öyleyse kullarıma müjde ver.",
      "en": "But those who have avoided Taghut, lest they worship it, and turned back to Allah - for them are good tidings. So give good tidings to My servants",
      "priority": 1,
      "surah_number": 39,
      "surah_name": "Zumer",
      "ayah_number": 17,
      "ayah_end_number": 17,
      "status": "pending_review"
    },
    {
      "id": "039/032",
      "kind": "ayah",
      "ref": "039/032",
      "ar": "فَمَنْ أَظْلَمُ مِمَّن كَذَبَ عَلَى ٱللَّهِ وَكَذَّبَ بِٱلصِّدْقِ إِذْ جَآءَهُۥٓ ۚ أَلَيْسَ فِى جَهَنَّمَ مَثْوًى لِّلْكَـٰفِرِينَ",
      "tr": "Allah'a karşı yalan söyleyenden ve kendisine geldiğinde doğruyu (Kur'an'ı) yalanlayandan daha zalim kimdir? Kafirler için cehennemde bir konaklama yeri mi yok?",
      "en": "So who is more unjust than one who lies about Allah and denies the truth when it has come to him? Is there not in Hell a residence for the disbelievers?",
      "priority": 1,
      "surah_number": 39,
      "surah_name": "Zumer",
      "ayah_number": 32,
      "ayah_end_number": 32,
      "status": "pending_review"
    },
    {
      "id": "039/033",
      "kind": "ayah",
      "ref": "039/033",
      "ar": "وَٱلَّذِى جَآءَ بِٱلصِّدْقِ وَصَدَّقَ بِهِۦٓ ۙ أُو۟لَـٰٓئِكَ هُمُ ٱلْمُتَّقُونَ",
      "tr": "Doğruyu getiren ve doğrulayanlara gelince; işte onlar muttaki (takva sahibi) olanlardır.",
      "en": "And the one who has brought the truth and [they who] believed in it - those are the righteous.",
      "priority": 1,
      "surah_number": 39,
      "surah_name": "Zumer",
      "ayah_number": 33,
      "ayah_end_number": 33,
      "status": "pending_review"
    },
    {
      "id": "039/036",
      "kind": "ayah",
      "ref": "039/036",
      "ar": "أَلَيْسَ ٱللَّهُ بِكَافٍ عَبْدَهُۥ ۖ وَيُخَوِّفُونَكَ بِٱلَّذِينَ مِن دُونِهِۦ ۚ وَمَن يُضْلِلِ ٱللَّهُ فَمَا لَهُۥ مِنْ هَادٍ",
      "tr": "Allah, kuluna yeterli değil mi? Seni O'ndan başkalarıyla korkutuyorlar. Allah, kimi saptırırsa, artık onun için bir yol gösterici yoktur.",
      "en": "Is not Allah sufficient for His Servant [Prophet Muhammad]? And [yet], they threaten you with those [they worship] other than Him. And whoever Allah leaves astray - for him there is no guide.",
      "priority": 1,
      "surah_number": 39,
      "surah_name": "Zumer",
      "ayah_number": 36,
      "ayah_end_number": 36,
      "status": "pending_review"
    },
    {
      "id": "039/032-033",
      "kind": "ayah",
      "ref": "039/032-033",
      "ar": "﴿32﴾ فَمَنْ أَظْلَمُ مِمَّن كَذَبَ عَلَى ٱللَّهِ وَكَذَّبَ بِٱلصِّدْقِ إِذْ جَآءَهُۥٓ ۚ أَلَيْسَ فِى جَهَنَّمَ مَثْوًى لِّلْكَـٰفِرِينَ\n\n﴿33﴾ وَٱلَّذِى جَآءَ بِٱلصِّدْقِ وَصَدَّقَ بِهِۦٓ ۙ أُو۟لَـٰٓئِكَ هُمُ ٱلْمُتَّقُونَ",
      "tr": "[32] Allah'a karşı yalan söyleyenden ve kendisine geldiğinde doğruyu (Kur'an'ı) yalanlayandan daha zalim kimdir? Kafirler için cehennemde bir konaklama yeri mi yok?\n\n[33] Doğruyu getiren ve doğrulayanlara gelince; işte onlar muttaki (takva sahibi) olanlardır.",
      "en": "[32] So who is more unjust than one who lies about Allah and denies the truth when it has come to him? Is there not in Hell a residence for the disbelievers?\n\n[33] And the one who has brought the truth and [they who] believed in it - those are the righteous.",
      "priority": 1,
      "surah_number": 39,
      "surah_name": "Zumer",
      "ayah_number": 32,
      "ayah_end_number": 33,
      "status": "pending_review"
    },
    {
      "id": "039/037",
      "kind": "ayah",
      "ref": "039/037",
      "ar": "وَمَن يَهْدِ ٱللَّهُ فَمَا لَهُۥ مِن مُّضِلٍّ ۗ أَلَيْسَ ٱللَّهُ بِعَزِيزٍ ذِى ٱنتِقَامٍ",
      "tr": "Allah, kimi hidayete erdirirse, onun için bir saptırıcı yoktur. Allah, intikam sahibi, güçlü ve üstün olan değil midir?",
      "en": "And whoever Allah guides - for him there is no misleader. Is not Allah Exalted in Might and Owner of Retribution?",
      "priority": 1,
      "surah_number": 39,
      "surah_name": "Zumer",
      "ayah_number": 37,
      "ayah_end_number": 37,
      "status": "pending_review"
    },
    {
      "id": "039/038",
      "kind": "ayah",
      "ref": "039/038",
      "ar": "وَلَئِن سَأَلْتَهُم مَّنْ خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ لَيَقُولُنَّ ٱللَّهُ ۚ قُلْ أَفَرَءَيْتُم مَّا تَدْعُونَ مِن دُونِ ٱللَّهِ إِنْ أَرَادَنِىَ ٱللَّهُ بِضُرٍّ هَلْ هُنَّ كَـٰشِفَـٰتُ ضُرِّهِۦٓ أَوْ أَرَادَنِى بِرَحْمَةٍ هَلْ هُنَّ مُمْسِكَـٰتُ رَحْمَتِهِۦ ۚ قُلْ حَسْبِىَ ٱللَّهُ ۖ عَلَيْهِ يَتَوَكَّلُ ٱلْمُتَوَكِّلُونَ",
      "tr": "Andolsun, onlara: \"Gökleri ve yeri kim yarattı?\" diye soracak olsan, elbette \"Allah\" diyecekler. De ki: \"Gördünüz mü-haber verin; Allah'tan başka taptıklarınız, eğer Allah bana bir zarar dileyecek olsa, O'nun zararını kaldırabilirler mi? Ya da bana bir rahmet vermeyi istese, O'nun rahmetini tutup-önleyebilecekler mi\" De ki: \"Allah, bana yeter. Tevekkül edecek olanlar, O'na tevekkül etsinler.\"",
      "en": "And if you asked them, \"Who created the heavens and the earth?\" they would surely say, \"Allah.\" Say, \"Then have you considered what you invoke besides Allah? If Allah intended me harm, are they removers of His harm; or if He intended me mercy, are they withholders of His mercy?\" Say, \"Sufficient for me is Allah; upon Him [alone] rely the [wise] reliers.\"",
      "priority": 1,
      "surah_number": 39,
      "surah_name": "Zumer",
      "ayah_number": 38,
      "ayah_end_number": 38,
      "status": "pending_review"
    },
    {
      "id": "039/042",
      "kind": "ayah",
      "ref": "039/042",
      "ar": "ٱللَّهُ يَتَوَفَّى ٱلْأَنفُسَ حِينَ مَوْتِهَا وَٱلَّتِى لَمْ تَمُتْ فِى مَنَامِهَا ۖ فَيُمْسِكُ ٱلَّتِى قَضَىٰ عَلَيْهَا ٱلْمَوْتَ وَيُرْسِلُ ٱلْأُخْرَىٰٓ إِلَىٰٓ أَجَلٍ مُّسَمًّى ۚ إِنَّ فِى ذَٰلِكَ لَـَٔايَـٰتٍ لِّقَوْمٍ يَتَفَكَّرُونَ",
      "tr": "Allah, ölecekleri zaman canlarını alır; ölmeyeni de uykusunda (bir tür ölüme sokar). Böylece, kendisi hakkında ölüm kararı verilmiş olanı(n ruhunu) tutar, öbürüsünü ise adı konulmuş bir ecele kadar salıverir. Şüphesiz bunda, düşünebilen bir kavim için gerçekten ayetler vardır.",
      "en": "Allah takes the souls at the time of their death, and those that do not die [He takes] during their sleep. Then He keeps those for which He has decreed death and releases the others for a specified term. Indeed in that are signs for a people who give thought.",
      "priority": 1,
      "surah_number": 39,
      "surah_name": "Zumer",
      "ayah_number": 42,
      "ayah_end_number": 42,
      "status": "pending_review"
    },
    {
      "id": "039/045",
      "kind": "ayah",
      "ref": "039/045",
      "ar": "وَإِذَا ذُكِرَ ٱللَّهُ وَحْدَهُ ٱشْمَأَزَّتْ قُلُوبُ ٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْءَاخِرَةِ ۖ وَإِذَا ذُكِرَ ٱلَّذِينَ مِن دُونِهِۦٓ إِذَا هُمْ يَسْتَبْشِرُونَ",
      "tr": "Sadece Allah anıldığı zaman, ahirete inanmayanların kalbi öfkeyle kabarır. Oysa O'ndan başkaları anıldığında hemen sevince kapılırlar.",
      "en": "And when Allah is mentioned alone, the hearts of those who do not believe in the Hereafter shrink with aversion, but when those [worshipped] other than Him are mentioned, immediately they rejoice.",
      "priority": 1,
      "surah_number": 39,
      "surah_name": "Zumer",
      "ayah_number": 45,
      "ayah_end_number": 45,
      "status": "pending_review"
    },
    {
      "id": "039/059",
      "kind": "ayah",
      "ref": "039/059",
      "ar": "بَلَىٰ قَدْ جَآءَتْكَ ءَايَـٰتِى فَكَذَّبْتَ بِهَا وَٱسْتَكْبَرْتَ وَكُنتَ مِنَ ٱلْكَـٰفِرِينَ",
      "tr": "\"Hayır, Benim ayetlerim sana gelmişti, fakat sen onları yalanladın, büyüklüğe kapıldın ve kafirlerden oldun.\"",
      "en": "But yes, there had come to you My verses, but you denied them and were arrogant, and you were among the disbelievers.",
      "priority": 1,
      "surah_number": 39,
      "surah_name": "Zumer",
      "ayah_number": 59,
      "ayah_end_number": 59,
      "status": "pending_review"
    },
    {
      "id": "039/060",
      "kind": "ayah",
      "ref": "039/060",
      "ar": "وَيَوْمَ ٱلْقِيَـٰمَةِ تَرَى ٱلَّذِينَ كَذَبُوا۟ عَلَى ٱللَّهِ وُجُوهُهُم مُّسْوَدَّةٌ ۚ أَلَيْسَ فِى جَهَنَّمَ مَثْوًى لِّلْمُتَكَبِّرِينَ",
      "tr": "Kıyamet günü, Allah'a karşı yalan söyleyenlerin yüzlerinin kapkara olduğunu görürsün. Büyüklenenler için cehennemde bir konaklama yeri mi yok?",
      "en": "And on the Day of Resurrection you will see those who lied about Allah [with] their faces blackened. Is there not in Hell a residence for the arrogant?",
      "priority": 1,
      "surah_number": 39,
      "surah_name": "Zumer",
      "ayah_number": 60,
      "ayah_end_number": 60,
      "status": "pending_review"
    },
    {
      "id": "039/064",
      "kind": "ayah",
      "ref": "039/064",
      "ar": "قُلْ أَفَغَيْرَ ٱللَّهِ تَأْمُرُوٓنِّىٓ أَعْبُدُ أَيُّهَا ٱلْجَـٰهِلُونَ",
      "tr": "De ki: \"Ey cahiller, bana Allah'ın dışında bir başkasına mı kulluk etmemi emrediyorsunuz?\"",
      "en": "Say, [O Muhammad], \"Is it other than Allah that you order me to worship, O ignorant ones?\"",
      "priority": 1,
      "surah_number": 39,
      "surah_name": "Zumer",
      "ayah_number": 64,
      "ayah_end_number": 64,
      "status": "pending_review"
    },
    {
      "id": "039/059-060",
      "kind": "ayah",
      "ref": "039/059-060",
      "ar": "﴿59﴾ بَلَىٰ قَدْ جَآءَتْكَ ءَايَـٰتِى فَكَذَّبْتَ بِهَا وَٱسْتَكْبَرْتَ وَكُنتَ مِنَ ٱلْكَـٰفِرِينَ\n\n﴿60﴾ وَيَوْمَ ٱلْقِيَـٰمَةِ تَرَى ٱلَّذِينَ كَذَبُوا۟ عَلَى ٱللَّهِ وُجُوهُهُم مُّسْوَدَّةٌ ۚ أَلَيْسَ فِى جَهَنَّمَ مَثْوًى لِّلْمُتَكَبِّرِينَ",
      "tr": "[59] \"Hayır, Benim ayetlerim sana gelmişti, fakat sen onları yalanladın, büyüklüğe kapıldın ve kafirlerden oldun.\"\n\n[60] Kıyamet günü, Allah'a karşı yalan söyleyenlerin yüzlerinin kapkara olduğunu görürsün. Büyüklenenler için cehennemde bir konaklama yeri mi yok?",
      "en": "[59] But yes, there had come to you My verses, but you denied them and were arrogant, and you were among the disbelievers.\n\n[60] And on the Day of Resurrection you will see those who lied about Allah [with] their faces blackened. Is there not in Hell a residence for the arrogant?",
      "priority": 1,
      "surah_number": 39,
      "surah_name": "Zumer",
      "ayah_number": 59,
      "ayah_end_number": 60,
      "status": "pending_review"
    },
    {
      "id": "039/065",
      "kind": "ayah",
      "ref": "039/065",
      "ar": "وَلَقَدْ أُوحِىَ إِلَيْكَ وَإِلَى ٱلَّذِينَ مِن قَبْلِكَ لَئِنْ أَشْرَكْتَ لَيَحْبَطَنَّ عَمَلُكَ وَلَتَكُونَنَّ مِنَ ٱلْخَـٰسِرِينَ",
      "tr": "Andolsun, sana ve senden öncekilere vahyolundu (ki): \"Eğer şirk koşacak olursan, şüphesiz amellerin boşa çıkacak ve elbette sen, hüsrana uğrayanlardan olacaksın.",
      "en": "And it was already revealed to you and to those before you that if you should associate [anything] with Allah, your work would surely become worthless, and you would surely be among the losers.\"",
      "priority": 1,
      "surah_number": 39,
      "surah_name": "Zumer",
      "ayah_number": 65,
      "ayah_end_number": 65,
      "status": "pending_review"
    },
    {
      "id": "039/068",
      "kind": "ayah",
      "ref": "039/068",
      "ar": "وَنُفِخَ فِى ٱلصُّورِ فَصَعِقَ مَن فِى ٱلسَّمَـٰوَٰتِ وَمَن فِى ٱلْأَرْضِ إِلَّا مَن شَآءَ ٱللَّهُ ۖ ثُمَّ نُفِخَ فِيهِ أُخْرَىٰ فَإِذَا هُمْ قِيَامٌ يَنظُرُونَ",
      "tr": "Sur'a üfürüldü; böylece Allah'ın diledikleri dışında, göklerde ve yerde olanlar çarpılıp-yıkılıverdi. Sonra bir daha ona üfürüldü, artık onlar ayağa kalkmış durumda gözetliyorlar.",
      "en": "And the Horn will be blown, and whoever is in the heavens and whoever is on the earth will fall dead except whom Allah wills. Then it will be blown again, and at once they will be standing, looking on.",
      "priority": 1,
      "surah_number": 39,
      "surah_name": "Zumer",
      "ayah_number": 68,
      "ayah_end_number": 68,
      "status": "pending_review"
    },
    {
      "id": "039/064-065",
      "kind": "ayah",
      "ref": "039/064-065",
      "ar": "﴿64﴾ قُلْ أَفَغَيْرَ ٱللَّهِ تَأْمُرُوٓنِّىٓ أَعْبُدُ أَيُّهَا ٱلْجَـٰهِلُونَ\n\n﴿65﴾ وَلَقَدْ أُوحِىَ إِلَيْكَ وَإِلَى ٱلَّذِينَ مِن قَبْلِكَ لَئِنْ أَشْرَكْتَ لَيَحْبَطَنَّ عَمَلُكَ وَلَتَكُونَنَّ مِنَ ٱلْخَـٰسِرِينَ",
      "tr": "[64] De ki: \"Ey cahiller, bana Allah'ın dışında bir başkasına mı kulluk etmemi emrediyorsunuz?\"\n\n[65] Andolsun, sana ve senden öncekilere vahyolundu (ki): \"Eğer şirk koşacak olursan, şüphesiz amellerin boşa çıkacak ve elbette sen, hüsrana uğrayanlardan olacaksın.",
      "en": "[64] Say, [O Muhammad], \"Is it other than Allah that you order me to worship, O ignorant ones?\"\n\n[65] And it was already revealed to you and to those before you that if you should associate [anything] with Allah, your work would surely become worthless, and you would surely be among the losers.\"",
      "priority": 1,
      "surah_number": 39,
      "surah_name": "Zumer",
      "ayah_number": 64,
      "ayah_end_number": 65,
      "status": "pending_review"
    },
    {
      "id": "039/069",
      "kind": "ayah",
      "ref": "039/069",
      "ar": "وَأَشْرَقَتِ ٱلْأَرْضُ بِنُورِ رَبِّهَا وَوُضِعَ ٱلْكِتَـٰبُ وَجِا۟ىٓءَ بِٱلنَّبِيِّـۧنَ وَٱلشُّهَدَآءِ وَقُضِىَ بَيْنَهُم بِٱلْحَقِّ وَهُمْ لَا يُظْلَمُونَ",
      "tr": "Yer, Rabbinin nuruyla parıldadı; (orta yere) kitap kondu; peygamberler ve şahidler getirildi ve aralarında hak ile hüküm verildi, onlar haksızlığa uğratılmazlar.",
      "en": "And the earth will shine with the light of its Lord, and the record [of deeds] will be placed, and the prophets and the witnesses will be brought, and it will be judged between them in truth, and they will not be wronged.",
      "priority": 1,
      "surah_number": 39,
      "surah_name": "Zumer",
      "ayah_number": 69,
      "ayah_end_number": 69,
      "status": "pending_review"
    },
    {
      "id": "039/070",
      "kind": "ayah",
      "ref": "039/070",
      "ar": "وَوُفِّيَتْ كُلُّ نَفْسٍ مَّا عَمِلَتْ وَهُوَ أَعْلَمُ بِمَا يَفْعَلُونَ",
      "tr": "Her bir nefse yaptığının tam karşılığı verildi. O, onların işlediklerini daha iyi bilendir.",
      "en": "And every soul will be fully compensated [for] what it did; and He is most knowing of what they do.",
      "priority": 1,
      "surah_number": 39,
      "surah_name": "Zumer",
      "ayah_number": 70,
      "ayah_end_number": 70,
      "status": "pending_review"
    },
    {
      "id": "039/071",
      "kind": "ayah",
      "ref": "039/071",
      "ar": "وَسِيقَ ٱلَّذِينَ كَفَرُوٓا۟ إِلَىٰ جَهَنَّمَ زُمَرًا ۖ حَتَّىٰٓ إِذَا جَآءُوهَا فُتِحَتْ أَبْوَٰبُهَا وَقَالَ لَهُمْ خَزَنَتُهَآ أَلَمْ يَأْتِكُمْ رُسُلٌ مِّنكُمْ يَتْلُونَ عَلَيْكُمْ ءَايَـٰتِ رَبِّكُمْ وَيُنذِرُونَكُمْ لِقَآءَ يَوْمِكُمْ هَـٰذَا ۚ قَالُوا۟ بَلَىٰ وَلَـٰكِنْ حَقَّتْ كَلِمَةُ ٱلْعَذَابِ عَلَى ٱلْكَـٰفِرِينَ",
      "tr": "İnkar edenler, cehenneme bölük bölük sevkedildiler. Sonunda oraya geldikleri zaman, kapıları açıldı ve onlara (cehennemin) bekçileri dedi ki: \"Size Rabbinizin ayetlerini okuyan ve bugünle karşılaşacağınızı (söyleyip) sizi uyaran elçiler gelmedi mi?\" Onlar: \"Evet.\" dediler. Ancak azap kelimesi kafirlerin üzerine hak oldu.",
      "en": "And those who disbelieved will be driven to Hell in groups until, when they reach it, its gates are opened and its keepers will say, \"Did there not come to you messengers from yourselves, reciting to you the verses of your Lord and warning you of the meeting of this Day of yours?\" They will say, \"Yes, but the word of punishment has come into effect upon the disbelievers.",
      "priority": 1,
      "surah_number": 39,
      "surah_name": "Zumer",
      "ayah_number": 71,
      "ayah_end_number": 71,
      "status": "pending_review"
    },
    {
      "id": "040/004",
      "kind": "ayah",
      "ref": "040/004",
      "ar": "مَا يُجَـٰدِلُ فِىٓ ءَايَـٰتِ ٱللَّهِ إِلَّا ٱلَّذِينَ كَفَرُوا۟ فَلَا يَغْرُرْكَ تَقَلُّبُهُمْ فِى ٱلْبِلَـٰدِ",
      "tr": "Allah'ın ayetleri konusunda inkar edenlerden başkası mücadele etmez. Öyleyse onların şehirlerde dönüp dolaşması seni aldatmasın.",
      "en": "No one disputes concerning the signs of Allah except those who disbelieve, so be not deceived by their [uninhibited] movement throughout the land.",
      "priority": 1,
      "surah_number": 40,
      "surah_name": "Mumin",
      "ayah_number": 4,
      "ayah_end_number": 4,
      "status": "pending_review"
    },
    {
      "id": "040/012",
      "kind": "ayah",
      "ref": "040/012",
      "ar": "ذَٰلِكُم بِأَنَّهُۥٓ إِذَا دُعِىَ ٱللَّهُ وَحْدَهُۥ كَفَرْتُمْ ۖ وَإِن يُشْرَكْ بِهِۦ تُؤْمِنُوا۟ ۚ فَٱلْحُكْمُ لِلَّهِ ٱلْعَلِىِّ ٱلْكَبِيرِ",
      "tr": "\"Sizin (durumunuz) böyledir. Çünkü bir olan Allah'a çağırıldığınız zaman inkar ettiniz. O'na ortak koşulduğunda inanıp-onayladınız. Artık hüküm, Yüce, büyük olan Allah'ındır.\"",
      "en": "[They will be told], \"That is because, when Allah was called upon alone, you disbelieved; but if others were associated with Him, you believed. So the judgement is with Allah, the Most High, the Grand.\"",
      "priority": 1,
      "surah_number": 40,
      "surah_name": "Mumin",
      "ayah_number": 12,
      "ayah_end_number": 12,
      "status": "pending_review"
    },
    {
      "id": "040/017",
      "kind": "ayah",
      "ref": "040/017",
      "ar": "ٱلْيَوْمَ تُجْزَىٰ كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ ۚ لَا ظُلْمَ ٱلْيَوْمَ ۚ إِنَّ ٱللَّهَ سَرِيعُ ٱلْحِسَابِ",
      "tr": "Bugün her bir nefis, kendi kazandığıyla karşılık görür. Bugün zulüm yoktur. Şüphesiz Allah, hesabı seri görendir.",
      "en": "This Day every soul will be recompensed for what it earned. No injustice today! Indeed, Allah is swift in account.",
      "priority": 1,
      "surah_number": 40,
      "surah_name": "Mumin",
      "ayah_number": 17,
      "ayah_end_number": 17,
      "status": "pending_review"
    },
    {
      "id": "040/020",
      "kind": "ayah",
      "ref": "040/020",
      "ar": "وَٱللَّهُ يَقْضِى بِٱلْحَقِّ ۖ وَٱلَّذِينَ يَدْعُونَ مِن دُونِهِۦ لَا يَقْضُونَ بِشَىْءٍ ۗ إِنَّ ٱللَّهَ هُوَ ٱلسَّمِيعُ ٱلْبَصِيرُ",
      "tr": "Allah hak ile hükmeder. Oysa O'nu bırakıp taptıkları hiçbir şeye hükmedemezler. Şüphesiz Allah, işitendir, görendir.",
      "en": "And Allah judges with truth, while those they invoke besides Him judge not with anything. Indeed, Allah - He is the Hearing, the Seeing.",
      "priority": 1,
      "surah_number": 40,
      "surah_name": "Mumin",
      "ayah_number": 20,
      "ayah_end_number": 20,
      "status": "pending_review"
    },
    {
      "id": "040/028",
      "kind": "ayah",
      "ref": "040/028",
      "ar": "وَقَالَ رَجُلٌ مُّؤْمِنٌ مِّنْ ءَالِ فِرْعَوْنَ يَكْتُمُ إِيمَـٰنَهُۥٓ أَتَقْتُلُونَ رَجُلًا أَن يَقُولَ رَبِّىَ ٱللَّهُ وَقَدْ جَآءَكُم بِٱلْبَيِّنَـٰتِ مِن رَّبِّكُمْ ۖ وَإِن يَكُ كَـٰذِبًا فَعَلَيْهِ كَذِبُهُۥ ۖ وَإِن يَكُ صَادِقًا يُصِبْكُم بَعْضُ ٱلَّذِى يَعِدُكُمْ ۖ إِنَّ ٱللَّهَ لَا يَهْدِى مَنْ هُوَ مُسْرِفٌ كَذَّابٌ",
      "tr": "Firavun ailesinden imanını gizlemekte olan mü'min bir adam dedi ki: \"Siz, benim Rabbim Allah'tır diyen bir adamı öldürüyor musunuz? Oysa o, size Rabbinizden apaçık belgelerle gelmiş bulunuyor. Buna rağmen o eğer bir yalancı ise yalanı kendi aleyhinedir; ve eğer doğru sözlü ise, (o zaman da) size va'dettiklerinin bir kısmı size isabet eder. Şüphesiz Allah, ölçüyü taşıran, çok yalan söyleyen kimseyi hidayete erdirmez.\"",
      "en": "And a believing man from the family of Pharaoh who concealed his faith said, \"Do you kill a man [merely] because he says, 'My Lord is Allah' while he has brought you clear proofs from your Lord? And if he should be lying, then upon him is [the consequence of] his lie; but if he should be truthful, there will strike you some of what he promises you. Indeed, Allah does not guide one who is a transgressor and a liar.",
      "priority": 1,
      "surah_number": 40,
      "surah_name": "Mumin",
      "ayah_number": 28,
      "ayah_end_number": 28,
      "status": "pending_review"
    },
    {
      "id": "040/035",
      "kind": "ayah",
      "ref": "040/035",
      "ar": "ٱلَّذِينَ يُجَـٰدِلُونَ فِىٓ ءَايَـٰتِ ٱللَّهِ بِغَيْرِ سُلْطَـٰنٍ أَتَىٰهُمْ ۖ كَبُرَ مَقْتًا عِندَ ٱللَّهِ وَعِندَ ٱلَّذِينَ ءَامَنُوا۟ ۚ كَذَٰلِكَ يَطْبَعُ ٱللَّهُ عَلَىٰ كُلِّ قَلْبِ مُتَكَبِّرٍ جَبَّارٍ",
      "tr": "\"Ki onlar, Allah'ın ayetleri konusunda kendilerine gelmiş bir delil bulunmaksızın mücadele edip dururlar. (Bu,) Allah Katında da, iman edenler katında da büyük bir öfke (sebebi)dir. İşte Allah, her mütekebbir zorbanın kalbini böyle mühürler.\"",
      "en": "Those who dispute concerning the signs of Allah without an authority having come to them - great is hatred [of them] in the sight of Allah and in the sight of those who have believed. Thus does Allah seal over every heart [belonging to] an arrogant tyrant.",
      "priority": 1,
      "surah_number": 40,
      "surah_name": "Mumin",
      "ayah_number": 35,
      "ayah_end_number": 35,
      "status": "pending_review"
    },
    {
      "id": "040/039",
      "kind": "ayah",
      "ref": "040/039",
      "ar": "يَـٰقَوْمِ إِنَّمَا هَـٰذِهِ ٱلْحَيَوٰةُ ٱلدُّنْيَا مَتَـٰعٌ وَإِنَّ ٱلْءَاخِرَةَ هِىَ دَارُ ٱلْقَرَارِ",
      "tr": "\"Ey kavmim, gerçekten bu dünya hayatı, yalnızca bir meta (kısa süreli bir yararlanma)dır. Şüphesiz ahiret, (asıl) karar kılınan yurt odur.\"",
      "en": "O my people, this worldly life is only [temporary] enjoyment, and indeed, the Hereafter - that is the home of [permanent] settlement.",
      "priority": 1,
      "surah_number": 40,
      "surah_name": "Mumin",
      "ayah_number": 39,
      "ayah_end_number": 39,
      "status": "pending_review"
    },
    {
      "id": "040/051",
      "kind": "ayah",
      "ref": "040/051",
      "ar": "إِنَّا لَنَنصُرُ رُسُلَنَا وَٱلَّذِينَ ءَامَنُوا۟ فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا وَيَوْمَ يَقُومُ ٱلْأَشْهَـٰدُ",
      "tr": "Şüphesiz Biz elçilerimize ve iman edenlere, dünya hayatında ve şahidlerin (şahidlik için) duracakları gün elbette yardım edeceğiz.",
      "en": "Indeed, We will support Our messengers and those who believe during the life of this world and on the Day when the witnesses will stand -",
      "priority": 1,
      "surah_number": 40,
      "surah_name": "Mumin",
      "ayah_number": 51,
      "ayah_end_number": 51,
      "status": "pending_review"
    },
    {
      "id": "040/058",
      "kind": "ayah",
      "ref": "040/058",
      "ar": "وَمَا يَسْتَوِى ٱلْأَعْمَىٰ وَٱلْبَصِيرُ وَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَلَا ٱلْمُسِىٓءُ ۚ قَلِيلًا مَّا تَتَذَكَّرُونَ",
      "tr": "Kör olanla (basiretle) gören bir olmaz; iman edip salih amellerde bulunanlarla kötülük yapan da. Ne az öğüt alıp-düşünüyorsunuz.",
      "en": "And not equal are the blind and the seeing, nor are those who believe and do righteous deeds and the evildoer. Little do you remember.",
      "priority": 1,
      "surah_number": 40,
      "surah_name": "Mumin",
      "ayah_number": 58,
      "ayah_end_number": 58,
      "status": "pending_review"
    },
    {
      "id": "040/060",
      "kind": "ayah",
      "ref": "040/060",
      "ar": "وَقَالَ رَبُّكُمُ ٱدْعُونِىٓ أَسْتَجِبْ لَكُمْ ۚ إِنَّ ٱلَّذِينَ يَسْتَكْبِرُونَ عَنْ عِبَادَتِى سَيَدْخُلُونَ جَهَنَّمَ دَاخِرِينَ",
      "tr": "Rabbiniz dedi ki: \"Bana dua edin, size icabet edeyim. Doğrusu Bana ibadet etmekten büyüklenen (müstekbir)ler; cehenneme boyun bükmüş kimseler olarak gireceklerdir.",
      "en": "And your Lord says, \"Call upon Me; I will respond to you.\" Indeed, those who disdain My worship will enter Hell [rendered] contemptible.",
      "priority": 1,
      "surah_number": 40,
      "surah_name": "Mumin",
      "ayah_number": 60,
      "ayah_end_number": 60,
      "status": "pending_review"
    },
    {
      "id": "040/061",
      "kind": "ayah",
      "ref": "040/061",
      "ar": "ٱللَّهُ ٱلَّذِى جَعَلَ لَكُمُ ٱلَّيْلَ لِتَسْكُنُوا۟ فِيهِ وَٱلنَّهَارَ مُبْصِرًا ۚ إِنَّ ٱللَّهَ لَذُو فَضْلٍ عَلَى ٱلنَّاسِ وَلَـٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَشْكُرُونَ",
      "tr": "Allah, kendisinde sükun bulmanız için geceyi, aydınlık olarak da gündüzü sizin için var etti. Şüphesiz Allah, insanlara karşı (sınırsız) bir fazl sahibidir. Ancak insanların çoğu şükretmiyorlar.",
      "en": "It is Allah who made for you the night that you may rest therein and the day giving sight. Indeed, Allah is full of bounty to the people, but most of the people are not grateful.",
      "priority": 1,
      "surah_number": 40,
      "surah_name": "Mumin",
      "ayah_number": 61,
      "ayah_end_number": 61,
      "status": "pending_review"
    },
    {
      "id": "040/070",
      "kind": "ayah",
      "ref": "040/070",
      "ar": "ٱلَّذِينَ كَذَّبُوا۟ بِٱلْكِتَـٰبِ وَبِمَآ أَرْسَلْنَا بِهِۦ رُسُلَنَا ۖ فَسَوْفَ يَعْلَمُونَ",
      "tr": "Ki onlar, Kitab'ı ve elçilerimizle gönderdiğimiz şeyleri yalanladılar. Artık yakında bileceklerdir.",
      "en": "Those who deny the Book and that with which We sent Our messengers - they are going to know,",
      "priority": 1,
      "surah_number": 40,
      "surah_name": "Mumin",
      "ayah_number": 70,
      "ayah_end_number": 70,
      "status": "pending_review"
    },
    {
      "id": "040/060-061",
      "kind": "ayah",
      "ref": "040/060-061",
      "ar": "﴿60﴾ وَقَالَ رَبُّكُمُ ٱدْعُونِىٓ أَسْتَجِبْ لَكُمْ ۚ إِنَّ ٱلَّذِينَ يَسْتَكْبِرُونَ عَنْ عِبَادَتِى سَيَدْخُلُونَ جَهَنَّمَ دَاخِرِينَ\n\n﴿61﴾ ٱللَّهُ ٱلَّذِى جَعَلَ لَكُمُ ٱلَّيْلَ لِتَسْكُنُوا۟ فِيهِ وَٱلنَّهَارَ مُبْصِرًا ۚ إِنَّ ٱللَّهَ لَذُو فَضْلٍ عَلَى ٱلنَّاسِ وَلَـٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَشْكُرُونَ",
      "tr": "[60] Rabbiniz dedi ki: \"Bana dua edin, size icabet edeyim. Doğrusu Bana ibadet etmekten büyüklenen (müstekbir)ler; cehenneme boyun bükmüş kimseler olarak gireceklerdir.\n\n[61] Allah, kendisinde sükun bulmanız için geceyi, aydınlık olarak da gündüzü sizin için var etti. Şüphesiz Allah, insanlara karşı (sınırsız) bir fazl sahibidir. Ancak insanların çoğu şükretmiyorlar.",
      "en": "[60] And your Lord says, \"Call upon Me; I will respond to you.\" Indeed, those who disdain My worship will enter Hell [rendered] contemptible.\n\n[61] It is Allah who made for you the night that you may rest therein and the day giving sight. Indeed, Allah is full of bounty to the people, but most of the people are not grateful.",
      "priority": 1,
      "surah_number": 40,
      "surah_name": "Mumin",
      "ayah_number": 60,
      "ayah_end_number": 61,
      "status": "pending_review"
    },
    {
      "id": "040/076",
      "kind": "ayah",
      "ref": "040/076",
      "ar": "ٱدْخُلُوٓا۟ أَبْوَٰبَ جَهَنَّمَ خَـٰلِدِينَ فِيهَا ۖ فَبِئْسَ مَثْوَى ٱلْمُتَكَبِّرِينَ",
      "tr": "İçinde ebedi kalıcılar olarak cehennemin kapılarından girin. Artık mütekebbirlerin konaklama yeri ne kötüdür.",
      "en": "Enter the gates of Hell to abide eternally therein, and wretched is the residence of the arrogant.\"",
      "priority": 1,
      "surah_number": 40,
      "surah_name": "Mumin",
      "ayah_number": 76,
      "ayah_end_number": 76,
      "status": "pending_review"
    },
    {
      "id": "040/082",
      "kind": "ayah",
      "ref": "040/082",
      "ar": "أَفَلَمْ يَسِيرُوا۟ فِى ٱلْأَرْضِ فَيَنظُرُوا۟ كَيْفَ كَانَ عَـٰقِبَةُ ٱلَّذِينَ مِن قَبْلِهِمْ ۚ كَانُوٓا۟ أَكْثَرَ مِنْهُمْ وَأَشَدَّ قُوَّةً وَءَاثَارًا فِى ٱلْأَرْضِ فَمَآ أَغْنَىٰ عَنْهُم مَّا كَانُوا۟ يَكْسِبُونَ",
      "tr": "Yeryüzünde gezip dolaşmıyorlar mı ki, kendilerinden öncekilerin nasıl bir sona uğradıklarını bir görsünler. Onlar, kendilerinden (sayıca) daha çoktu ve yeryüzünde kuvvet ve eserler bakımından daha üstündüler. Fakat kazandıkları şeyler, (azaba karşı) onlara hiçbir şey sağlayamadı.",
      "en": "Have they not traveled through the land and observed how was the end of those before them? They were more numerous than themselves and greater in strength and in impression on the land, but they were not availed by what they used to earn.",
      "priority": 1,
      "surah_number": 40,
      "surah_name": "Mumin",
      "ayah_number": 82,
      "ayah_end_number": 82,
      "status": "pending_review"
    },
    {
      "id": "040/056",
      "kind": "ayah",
      "ref": "040/056",
      "ar": "إِنَّ ٱلَّذِينَ يُجَـٰدِلُونَ فِىٓ ءَايَـٰتِ ٱللَّهِ بِغَيْرِ سُلْطَـٰنٍ أَتَىٰهُمْ ۙ إِن فِى صُدُورِهِمْ إِلَّا كِبْرٌ مَّا هُم بِبَـٰلِغِيهِ ۚ فَٱسْتَعِذْ بِٱللَّهِ ۖ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْبَصِيرُ",
      "tr": "Şüphesiz, kendilerine gelmiş bulunan hiçbir delil olmaksızın, Allah'ın ayetleri konusunda mücadele edenlere gelince; onların göğüslerinde kendisine ulaşamayacakları bir büyüklük (isteğin)den başkası yoktur. Artık sen Allah'a sığın. Şüphesiz O hakkıyla işiten, hakkıyla görendir.",
      "en": "Indeed, those who dispute concerning the signs of Allah without [any] authority having come to them - there is not within their breasts except pride, [the extent of] which they cannot reach. So seek refuge in Allah. Indeed, it is He who is the Hearing, the Seeing.",
      "priority": 1,
      "surah_number": 40,
      "surah_name": "Mumin",
      "ayah_number": 56,
      "ayah_end_number": 56,
      "status": "pending_review"
    },
    {
      "id": "041/009",
      "kind": "ayah",
      "ref": "041/009",
      "ar": "قُلْ أَئِنَّكُمْ لَتَكْفُرُونَ بِٱلَّذِى خَلَقَ ٱلْأَرْضَ فِى يَوْمَيْنِ وَتَجْعَلُونَ لَهُۥٓ أَندَادًا ۚ ذَٰلِكَ رَبُّ ٱلْعَـٰلَمِينَ",
      "tr": "De ki: \"Gerçekten siz mi yeri iki günde yaratanı inkar ediyor ve O'na birtakım eşler kılıyorsunuz? O, alemlerin Rabbidir.\"",
      "en": "Say, \"Do you indeed disbelieve in He who created the earth in two days and attribute to Him equals? That is the Lord of the worlds.\"",
      "priority": 1,
      "surah_number": 41,
      "surah_name": "Fussilet",
      "ayah_number": 9,
      "ayah_end_number": 9,
      "status": "pending_review"
    },
    {
      "id": "041/010",
      "kind": "ayah",
      "ref": "041/010",
      "ar": "وَجَعَلَ فِيهَا رَوَٰسِىَ مِن فَوْقِهَا وَبَـٰرَكَ فِيهَا وَقَدَّرَ فِيهَآ أَقْوَٰتَهَا فِىٓ أَرْبَعَةِ أَيَّامٍ سَوَآءً لِّلسَّآئِلِينَ",
      "tr": "Orda (yerde) onun üstünde sarsılmaz dağlar var etti, onda bereketler yarattı ve isteyip-arayanlar için eşit olmak üzere ordaki rızıkları dört günde takdir etti.",
      "en": "And He placed on the earth firmly set mountains over its surface, and He blessed it and determined therein its [creatures'] sustenance in four days without distinction - for [the information] of those who ask.",
      "priority": 1,
      "surah_number": 41,
      "surah_name": "Fussilet",
      "ayah_number": 10,
      "ayah_end_number": 10,
      "status": "pending_review"
    },
    {
      "id": "041/011",
      "kind": "ayah",
      "ref": "041/011",
      "ar": "ثُمَّ ٱسْتَوَىٰٓ إِلَى ٱلسَّمَآءِ وَهِىَ دُخَانٌ فَقَالَ لَهَا وَلِلْأَرْضِ ٱئْتِيَا طَوْعًا أَوْ كَرْهًا قَالَتَآ أَتَيْنَا طَآئِعِينَ",
      "tr": "Sonra, duman halinde olan göğe yöneldi; böylece ona ve yere dedi ki: \"İsteyerek veya istemeyerek gelin.\" İkisi de: \"İsteyerek (İtaat ederek) geldik\" dediler.",
      "en": "Then He directed Himself to the heaven while it was smoke and said to it and to the earth, \"Come [into being], willingly or by compulsion.\" They said, \"We have come willingly.\"",
      "priority": 1,
      "surah_number": 41,
      "surah_name": "Fussilet",
      "ayah_number": 11,
      "ayah_end_number": 11,
      "status": "pending_review"
    },
    {
      "id": "041/012",
      "kind": "ayah",
      "ref": "041/012",
      "ar": "فَقَضَىٰهُنَّ سَبْعَ سَمَـٰوَاتٍ فِى يَوْمَيْنِ وَأَوْحَىٰ فِى كُلِّ سَمَآءٍ أَمْرَهَا ۚ وَزَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِمَصَـٰبِيحَ وَحِفْظًا ۚ ذَٰلِكَ تَقْدِيرُ ٱلْعَزِيزِ ٱلْعَلِيمِ",
      "tr": "Böylece onları iki gün içinde yedi gök olarak tamamladı ve her bir göğe emrini vahyetti. Biz dünya göğünü de kandillerle süsleyip-donattık ve bir koruma (altına aldık). İşte bu, üstün ve güçlü olan, bilen (Allah)'ın takdiridir.",
      "en": "And He completed them as seven heavens within two days and inspired in each heaven its command. And We adorned the nearest heaven with lamps and as protection. That is the determination of the Exalted in Might, the Knowing.",
      "priority": 1,
      "surah_number": 41,
      "surah_name": "Fussilet",
      "ayah_number": 12,
      "ayah_end_number": 12,
      "status": "pending_review"
    },
    {
      "id": "041/015",
      "kind": "ayah",
      "ref": "041/015",
      "ar": "فَأَمَّا عَادٌ فَٱسْتَكْبَرُوا۟ فِى ٱلْأَرْضِ بِغَيْرِ ٱلْحَقِّ وَقَالُوا۟ مَنْ أَشَدُّ مِنَّا قُوَّةً ۖ أَوَلَمْ يَرَوْا۟ أَنَّ ٱللَّهَ ٱلَّذِى خَلَقَهُمْ هُوَ أَشَدُّ مِنْهُمْ قُوَّةً ۖ وَكَانُوا۟ بِـَٔايَـٰتِنَا يَجْحَدُونَ",
      "tr": "Ad (kavmin)e gelince; onlar yeryüzünde haksız yere büyüklendiler ve dediler ki: \"Kuvvet bakımından bizden daha üstünü kimmiş?\" Onlar, gerçekten kendilerini yaratan Allah'ı görmediler mi? O, kuvvet bakımından kendilerinden daha üstündür. Oysa onlar, Bizim ayetlerimizi (bilerek) inkar ediyorlardı.",
      "en": "As for 'Aad, they were arrogant upon the earth without right and said, \"Who is greater than us in strength?\" Did they not consider that Allah who created them was greater than them in strength? But they were rejecting Our signs.",
      "priority": 1,
      "surah_number": 41,
      "surah_name": "Fussilet",
      "ayah_number": 15,
      "ayah_end_number": 15,
      "status": "pending_review"
    },
    {
      "id": "041/033",
      "kind": "ayah",
      "ref": "041/033",
      "ar": "وَمَنْ أَحْسَنُ قَوْلًا مِّمَّن دَعَآ إِلَى ٱللَّهِ وَعَمِلَ صَـٰلِحًا وَقَالَ إِنَّنِى مِنَ ٱلْمُسْلِمِينَ",
      "tr": "Allah'a çağıran, salih amelde bulunan ve: \"Gerçekten ben Müslümanlardanım\" diyenden daha güzel sözlü kimdir?",
      "en": "And who is better in speech than one who invites to Allah and does righteousness and says, \"Indeed, I am of the Muslims.\"",
      "priority": 1,
      "surah_number": 41,
      "surah_name": "Fussilet",
      "ayah_number": 33,
      "ayah_end_number": 33,
      "status": "pending_review"
    },
    {
      "id": "041/034",
      "kind": "ayah",
      "ref": "041/034",
      "ar": "وَلَا تَسْتَوِى ٱلْحَسَنَةُ وَلَا ٱلسَّيِّئَةُ ۚ ٱدْفَعْ بِٱلَّتِى هِىَ أَحْسَنُ فَإِذَا ٱلَّذِى بَيْنَكَ وَبَيْنَهُۥ عَدَٰوَةٌ كَأَنَّهُۥ وَلِىٌّ حَمِيمٌ",
      "tr": "İyilikle kötülük eşit olmaz. Sen, en güzel olan bir tarzda (kötülüğü) uzaklaştır; o zaman, (görürsün ki) seninle onun arasında düşmanlık bulunan kimse, sanki sıcak bir dost(un) oluvermiştir.",
      "en": "And not equal are the good deed and the bad. Repel [evil] by that [deed] which is better; and thereupon the one whom between you and him is enmity [will become] as though he was a devoted friend.",
      "priority": 1,
      "surah_number": 41,
      "surah_name": "Fussilet",
      "ayah_number": 34,
      "ayah_end_number": 34,
      "status": "pending_review"
    },
    {
      "id": "041/035",
      "kind": "ayah",
      "ref": "041/035",
      "ar": "وَمَا يُلَقَّىٰهَآ إِلَّا ٱلَّذِينَ صَبَرُوا۟ وَمَا يُلَقَّىٰهَآ إِلَّا ذُو حَظٍّ عَظِيمٍ",
      "tr": "Buna da, sabredenlerden başkası kavuşturulamaz. Ve buna, büyük bir pay sahibi olanlardan başkası da kavuşturulamaz.",
      "en": "But none is granted it except those who are patient, and none is granted it except one having a great portion [of good].",
      "priority": 1,
      "surah_number": 41,
      "surah_name": "Fussilet",
      "ayah_number": 35,
      "ayah_end_number": 35,
      "status": "pending_review"
    },
    {
      "id": "041/042",
      "kind": "ayah",
      "ref": "041/042",
      "ar": "لَّا يَأْتِيهِ ٱلْبَـٰطِلُ مِنۢ بَيْنِ يَدَيْهِ وَلَا مِنْ خَلْفِهِۦ ۖ تَنزِيلٌ مِّنْ حَكِيمٍ حَمِيدٍ",
      "tr": "Batıl, ona önünden de, ardından da gelemez. (Çünkü Kur'an,) Hüküm ve hikmet sahibi, çok övülen (Allah)tan indirilmedir.",
      "en": "Falsehood cannot approach it from before it or from behind it; [it is] a revelation from a [Lord who is] Wise and Praiseworthy.",
      "priority": 1,
      "surah_number": 41,
      "surah_name": "Fussilet",
      "ayah_number": 42,
      "ayah_end_number": 42,
      "status": "pending_review"
    },
    {
      "id": "041/033-035",
      "kind": "ayah",
      "ref": "041/033-035",
      "ar": "﴿33﴾ وَمَنْ أَحْسَنُ قَوْلًا مِّمَّن دَعَآ إِلَى ٱللَّهِ وَعَمِلَ صَـٰلِحًا وَقَالَ إِنَّنِى مِنَ ٱلْمُسْلِمِينَ\n\n﴿34﴾ وَلَا تَسْتَوِى ٱلْحَسَنَةُ وَلَا ٱلسَّيِّئَةُ ۚ ٱدْفَعْ بِٱلَّتِى هِىَ أَحْسَنُ فَإِذَا ٱلَّذِى بَيْنَكَ وَبَيْنَهُۥ عَدَٰوَةٌ كَأَنَّهُۥ وَلِىٌّ حَمِيمٌ\n\n﴿35﴾ وَمَا يُلَقَّىٰهَآ إِلَّا ٱلَّذِينَ صَبَرُوا۟ وَمَا يُلَقَّىٰهَآ إِلَّا ذُو حَظٍّ عَظِيمٍ",
      "tr": "[33] Allah'a çağıran, salih amelde bulunan ve: \"Gerçekten ben Müslümanlardanım\" diyenden daha güzel sözlü kimdir?\n\n[34] İyilikle kötülük eşit olmaz. Sen, en güzel olan bir tarzda (kötülüğü) uzaklaştır; o zaman, (görürsün ki) seninle onun arasında düşmanlık bulunan kimse, sanki sıcak bir dost(un) oluvermiştir.\n\n[35] Buna da, sabredenlerden başkası kavuşturulamaz. Ve buna, büyük bir pay sahibi olanlardan başkası da kavuşturulamaz.",
      "en": "[33] And who is better in speech than one who invites to Allah and does righteousness and says, \"Indeed, I am of the Muslims.\"\n\n[34] And not equal are the good deed and the bad. Repel [evil] by that [deed] which is better; and thereupon the one whom between you and him is enmity [will become] as though he was a devoted friend.\n\n[35] But none is granted it except those who are patient, and none is granted it except one having a great portion [of good].",
      "priority": 1,
      "surah_number": 41,
      "surah_name": "Fussilet",
      "ayah_number": 33,
      "ayah_end_number": 35,
      "status": "pending_review"
    },
    {
      "id": "042/010",
      "kind": "ayah",
      "ref": "042/010",
      "ar": "وَمَا ٱخْتَلَفْتُمْ فِيهِ مِن شَىْءٍ فَحُكْمُهُۥٓ إِلَى ٱللَّهِ ۚ ذَٰلِكُمُ ٱللَّهُ رَبِّى عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ أُنِيبُ",
      "tr": "Hakkında ihtilafa düştüğünüz herhangi bir şey; artık O'nun hükmü Allah'ındır. İşte Rabbim olan Allah. Ben O'na tevekkül ettim ve yalnızca O'na dönüp-yönelirim.",
      "en": "And in anything over which you disagree - its ruling is [to be referred] to Allah. [Say], \"That is Allah, my Lord; upon Him I have relied, and to Him I turn back.\"",
      "priority": 1,
      "surah_number": 42,
      "surah_name": "Sura",
      "ayah_number": 10,
      "ayah_end_number": 10,
      "status": "pending_review"
    },
    {
      "id": "042/011",
      "kind": "ayah",
      "ref": "042/011",
      "ar": "فَاطِرُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ جَعَلَ لَكُم مِّنْ أَنفُسِكُمْ أَزْوَٰجًا وَمِنَ ٱلْأَنْعَـٰمِ أَزْوَٰجًا ۖ يَذْرَؤُكُمْ فِيهِ ۚ لَيْسَ كَمِثْلِهِۦ شَىْءٌ ۖ وَهُوَ ٱلسَّمِيعُ ٱلْبَصِيرُ",
      "tr": "O, göklerin ve yerin Yaratıcısı'dır. Size kendi nefislerinizden eşler, davarlardan da çiftler var etti. Sizleri bu tarzda türetip-yayıyor. O'nun benzeri gibi olan hiçbir şey yoktur. O, işitendir, görendir.",
      "en": "[He is] Creator of the heavens and the earth. He has made for you from yourselves, mates, and among the cattle, mates; He multiplies you thereby. There is nothing like unto Him, and He is the Hearing, the Seeing.",
      "priority": 1,
      "surah_number": 42,
      "surah_name": "Sura",
      "ayah_number": 11,
      "ayah_end_number": 11,
      "status": "pending_review"
    },
    {
      "id": "042/013",
      "kind": "ayah",
      "ref": "042/013",
      "ar": "شَرَعَ لَكُم مِّنَ ٱلدِّينِ مَا وَصَّىٰ بِهِۦ نُوحًا وَٱلَّذِىٓ أَوْحَيْنَآ إِلَيْكَ وَمَا وَصَّيْنَا بِهِۦٓ إِبْرَٰهِيمَ وَمُوسَىٰ وَعِيسَىٰٓ ۖ أَنْ أَقِيمُوا۟ ٱلدِّينَ وَلَا تَتَفَرَّقُوا۟ فِيهِ ۚ كَبُرَ عَلَى ٱلْمُشْرِكِينَ مَا تَدْعُوهُمْ إِلَيْهِ ۚ ٱللَّهُ يَجْتَبِىٓ إِلَيْهِ مَن يَشَآءُ وَيَهْدِىٓ إِلَيْهِ مَن يُنِيبُ",
      "tr": "O: \"Dini dosdoğru ayakta tutun ve onda ayrılığa düşmeyin\" diye dinden Nuh'a vasiyet ettiğini ve sana vahyettiğimizi, İbrahim'e, Musa'ya ve İsa'ya vasiyet ettiğimizi sizin için de teşri' etti (bir şeriat kıldı). Senin kendilerini çağırdığın şey, müşriklere ağır geldi. Allah, dilediğini buna seçer ve içten Kendisi'ne yöneleni hidayete erdirir.",
      "en": "He has ordained for you of religion what He enjoined upon Noah and that which We have revealed to you, [O Muhammad], and what We enjoined upon Abraham and Moses and Jesus - to establish the religion and not be divided therein. Difficult for those who associate others with Allah is that to which you invite them. Allah chooses for Himself whom He wills and guides to Himself whoever turns back [to Him].",
      "priority": 1,
      "surah_number": 42,
      "surah_name": "Sura",
      "ayah_number": 13,
      "ayah_end_number": 13,
      "status": "pending_review"
    },
    {
      "id": "042/010-011",
      "kind": "ayah",
      "ref": "042/010-011",
      "ar": "﴿10﴾ وَمَا ٱخْتَلَفْتُمْ فِيهِ مِن شَىْءٍ فَحُكْمُهُۥٓ إِلَى ٱللَّهِ ۚ ذَٰلِكُمُ ٱللَّهُ رَبِّى عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ أُنِيبُ\n\n﴿11﴾ فَاطِرُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ جَعَلَ لَكُم مِّنْ أَنفُسِكُمْ أَزْوَٰجًا وَمِنَ ٱلْأَنْعَـٰمِ أَزْوَٰجًا ۖ يَذْرَؤُكُمْ فِيهِ ۚ لَيْسَ كَمِثْلِهِۦ شَىْءٌ ۖ وَهُوَ ٱلسَّمِيعُ ٱلْبَصِيرُ",
      "tr": "[10] Hakkında ihtilafa düştüğünüz herhangi bir şey; artık O'nun hükmü Allah'ındır. İşte Rabbim olan Allah. Ben O'na tevekkül ettim ve yalnızca O'na dönüp-yönelirim.\n\n[11] O, göklerin ve yerin Yaratıcısı'dır. Size kendi nefislerinizden eşler, davarlardan da çiftler var etti. Sizleri bu tarzda türetip-yayıyor. O'nun benzeri gibi olan hiçbir şey yoktur. O, işitendir, görendir.",
      "en": "[10] And in anything over which you disagree - its ruling is [to be referred] to Allah. [Say], \"That is Allah, my Lord; upon Him I have relied, and to Him I turn back.\"\n\n[11] [He is] Creator of the heavens and the earth. He has made for you from yourselves, mates, and among the cattle, mates; He multiplies you thereby. There is nothing like unto Him, and He is the Hearing, the Seeing.",
      "priority": 1,
      "surah_number": 42,
      "surah_name": "Sura",
      "ayah_number": 10,
      "ayah_end_number": 11,
      "status": "pending_review"
    },
    {
      "id": "042/014",
      "kind": "ayah",
      "ref": "042/014",
      "ar": "وَمَا تَفَرَّقُوٓا۟ إِلَّا مِنۢ بَعْدِ مَا جَآءَهُمُ ٱلْعِلْمُ بَغْيًۢا بَيْنَهُمْ ۚ وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِن رَّبِّكَ إِلَىٰٓ أَجَلٍ مُّسَمًّى لَّقُضِىَ بَيْنَهُمْ ۚ وَإِنَّ ٱلَّذِينَ أُورِثُوا۟ ٱلْكِتَـٰبَ مِنۢ بَعْدِهِمْ لَفِى شَكٍّ مِّنْهُ مُرِيبٍ",
      "tr": "Onlar, kendilerine ilim geldikten sonra, yalnızca aralarındaki 'tecavüz ve haksızlık' dolayısıyla ayrılığa düştüler. Eğer Rabbinden, adı konulmuş bir ecele kadar geçmiş (verilmiş) bir söz olmasaydı, muhakkak aralarında hüküm verilmiş (iş bitirilmiş)ti. Şüphesiz onların ardından kitaba mirasçı olanlar ise, herhalde ona karşı kuşku verici bir tereddüt içindedirler.",
      "en": "And they did not become divided until after knowledge had come to them - out of jealous animosity between themselves. And if not for a word that preceded from your Lord [postponing the penalty] until a specified time, it would have been concluded between them. And indeed, those who were granted inheritance of the Scripture after them are, concerning it, in disquieting doubt.",
      "priority": 1,
      "surah_number": 42,
      "surah_name": "Sura",
      "ayah_number": 14,
      "ayah_end_number": 14,
      "status": "pending_review"
    },
    {
      "id": "042/015",
      "kind": "ayah",
      "ref": "042/015",
      "ar": "فَلِذَٰلِكَ فَٱدْعُ ۖ وَٱسْتَقِمْ كَمَآ أُمِرْتَ ۖ وَلَا تَتَّبِعْ أَهْوَآءَهُمْ ۖ وَقُلْ ءَامَنتُ بِمَآ أَنزَلَ ٱللَّهُ مِن كِتَـٰبٍ ۖ وَأُمِرْتُ لِأَعْدِلَ بَيْنَكُمُ ۖ ٱللَّهُ رَبُّنَا وَرَبُّكُمْ ۖ لَنَآ أَعْمَـٰلُنَا وَلَكُمْ أَعْمَـٰلُكُمْ ۖ لَا حُجَّةَ بَيْنَنَا وَبَيْنَكُمُ ۖ ٱللَّهُ يَجْمَعُ بَيْنَنَا ۖ وَإِلَيْهِ ٱلْمَصِيرُ",
      "tr": "Şu halde, sen bundan dolayı davet et ve emrolunduğun gibi doğru bir istikamet tuttur. Onların heva (istek ve tutku)larına uyma. Ve de ki: Allah'ın indirdiği her kitaba inandım. Aranızda adaletli davranmakla emrolundum. Allah, bizim de Rabbimiz, sizin de Rabbinizdir. Bizim amellerimiz bizim, sizin amelleriniz sizindir. Bizimle aranızda ‘deliller getirerek tartışma (ya, huccete gerek)’ yoktur. Allah bizi biraraya getirip-toplayacaktır. Dönüş O'nadır.\"",
      "en": "So to that [religion of Allah] invite, [O Muhammad], and remain on a right course as you are commanded and do not follow their inclinations but say, \"I have believed in what Allah has revealed of the Qur'an, and I have been commanded to do justice among you. Allah is our Lord and your Lord. For us are our deeds, and for you your deeds. There is no [need for] argument between us and you. Allah will bring us together, and to Him is the [final] destination.\"",
      "priority": 1,
      "surah_number": 42,
      "surah_name": "Sura",
      "ayah_number": 15,
      "ayah_end_number": 15,
      "status": "pending_review"
    },
    {
      "id": "042/042",
      "kind": "ayah",
      "ref": "042/042",
      "ar": "إِنَّمَا ٱلسَّبِيلُ عَلَى ٱلَّذِينَ يَظْلِمُونَ ٱلنَّاسَ وَيَبْغُونَ فِى ٱلْأَرْضِ بِغَيْرِ ٱلْحَقِّ ۚ أُو۟لَـٰٓئِكَ لَهُمْ عَذَابٌ أَلِيمٌ",
      "tr": "Yol, ancak insanlara zulmeden ve yeryüzünde haksız yere 'tecavüz ve haksızlıkta bulunanların' aleyhinedir. İşte bunlara acıklı bir azap vardır.",
      "en": "The cause is only against the ones who wrong the people and tyrannize upon the earth without right. Those will have a painful punishment.",
      "priority": 1,
      "surah_number": 42,
      "surah_name": "Sura",
      "ayah_number": 42,
      "ayah_end_number": 42,
      "status": "pending_review"
    },
    {
      "id": "042/048",
      "kind": "ayah",
      "ref": "042/048",
      "ar": "فَإِنْ أَعْرَضُوا۟ فَمَآ أَرْسَلْنَـٰكَ عَلَيْهِمْ حَفِيظًا ۖ إِنْ عَلَيْكَ إِلَّا ٱلْبَلَـٰغُ ۗ وَإِنَّآ إِذَآ أَذَقْنَا ٱلْإِنسَـٰنَ مِنَّا رَحْمَةً فَرِحَ بِهَا ۖ وَإِن تُصِبْهُمْ سَيِّئَةٌۢ بِمَا قَدَّمَتْ أَيْدِيهِمْ فَإِنَّ ٱلْإِنسَـٰنَ كَفُورٌ",
      "tr": "Şayet onlar, sırt çevirecek olurlarsa, artık Biz seni onların üzerine bir gözetleyici olarak göndermiş değiliz. Sana düşen, yalnızca tebliğdir. Gerçek şu ki, Biz insana tarafımızdan bir rahmet taddırdığımız zaman, ona sevinir. Eğer onlara kendi ellerinin takdim ettikleri dolayısıyla bir kötülük isabet ederse, bu durumda insan bir nankör kesiliverir.",
      "en": "But if they turn away - then We have not sent you, [O Muhammad], over them as a guardian; upon you is only [the duty of] notification. And indeed, when We let man taste mercy from us, he rejoices in it; but if evil afflicts him for what his hands have put forth, then indeed, man is ungrateful.",
      "priority": 1,
      "surah_number": 42,
      "surah_name": "Sura",
      "ayah_number": 48,
      "ayah_end_number": 48,
      "status": "pending_review"
    },
    {
      "id": "042/052",
      "kind": "ayah",
      "ref": "042/052",
      "ar": "وَكَذَٰلِكَ أَوْحَيْنَآ إِلَيْكَ رُوحًا مِّنْ أَمْرِنَا ۚ مَا كُنتَ تَدْرِى مَا ٱلْكِتَـٰبُ وَلَا ٱلْإِيمَـٰنُ وَلَـٰكِن جَعَلْنَـٰهُ نُورًا نَّهْدِى بِهِۦ مَن نَّشَآءُ مِنْ عِبَادِنَا ۚ وَإِنَّكَ لَتَهْدِىٓ إِلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ",
      "tr": "Böylece sana emrimizden bir ruh vahyettik. Sen, kitap nedir, iman nedir bilmiyordun. Ancak Biz onu bir nur kıldık; onunla kullarımızdan dilediklerimizi hidayete erdiririz. Şüphesiz sen, dosdoğru olan bir yola yöneltip-iletiyorsun.",
      "en": "And thus We have revealed to you an inspiration of Our command. You did not know what is the Book or [what is] faith, but We have made it a light by which We guide whom We will of Our servants. And indeed, [O Muhammad], you guide to a straight path -",
      "priority": 1,
      "surah_number": 42,
      "surah_name": "Sura",
      "ayah_number": 52,
      "ayah_end_number": 52,
      "status": "pending_review"
    },
    {
      "id": "042/024",
      "kind": "ayah",
      "ref": "042/024",
      "ar": "أَمْ يَقُولُونَ ٱفْتَرَىٰ عَلَى ٱللَّهِ كَذِبًا ۖ فَإِن يَشَإِ ٱللَّهُ يَخْتِمْ عَلَىٰ قَلْبِكَ ۗ وَيَمْحُ ٱللَّهُ ٱلْبَـٰطِلَ وَيُحِقُّ ٱلْحَقَّ بِكَلِمَـٰتِهِۦٓ ۚ إِنَّهُۥ عَلِيمٌۢ بِذَاتِ ٱلصُّدُورِ",
      "tr": "Yoksa onlar: \"Allah'a karşı yalan düzüp-uydurdu\"mu diyorlar? Oysa eğer Allah dilerse senin de kalbini mühürler. Allah, batılı yok edip-ortadan kaldırır ve Kendi kelimeleriyle hakkı hak olarak pekiştirir (gerçekleştirir). Çünkü O, sinelerin özünde olanı bilendir.",
      "en": "Or do they say, \"He has invented about Allah a lie\"? But if Allah willed, He could seal over your heart. And Allah eliminates falsehood and establishes the truth by His words. Indeed, He is Knowing of that within the breasts.",
      "priority": 1,
      "surah_number": 42,
      "surah_name": "Sura",
      "ayah_number": 24,
      "ayah_end_number": 24,
      "status": "pending_review"
    },
    {
      "id": "043/005",
      "kind": "ayah",
      "ref": "043/005",
      "ar": "أَفَنَضْرِبُ عَنكُمُ ٱلذِّكْرَ صَفْحًا أَن كُنتُمْ قَوْمًا مُّسْرِفِينَ",
      "tr": "Siz ölçüyü taşıran bir kavimsiniz diye, şimdi o zikri (öğüt ve hatırlatma dolu Kur'an'ı) sizden (uzaklaştırıp) bir yana mı bırakalım?",
      "en": "Then should We turn the message away, disregarding you, because you are a transgressing people?",
      "priority": 1,
      "surah_number": 43,
      "surah_name": "Zuhruf",
      "ayah_number": 5,
      "ayah_end_number": 5,
      "status": "pending_review"
    },
    {
      "id": "043/015",
      "kind": "ayah",
      "ref": "043/015",
      "ar": "وَجَعَلُوا۟ لَهُۥ مِنْ عِبَادِهِۦ جُزْءًا ۚ إِنَّ ٱلْإِنسَـٰنَ لَكَفُورٌ مُّبِينٌ",
      "tr": "(Buna rağmen) Kendi kullarından O'na bir parça kılıp-yakıştırdılar. Doğrusu insan, açıkça bir nankördür.",
      "en": "But they have attributed to Him from His servants a portion. Indeed, man is clearly ungrateful.",
      "priority": 1,
      "surah_number": 43,
      "surah_name": "Zuhruf",
      "ayah_number": 15,
      "ayah_end_number": 15,
      "status": "pending_review"
    },
    {
      "id": "043/017",
      "kind": "ayah",
      "ref": "043/017",
      "ar": "وَإِذَا بُشِّرَ أَحَدُهُم بِمَا ضَرَبَ لِلرَّحْمَـٰنِ مَثَلًا ظَلَّ وَجْهُهُۥ مُسْوَدًّا وَهُوَ كَظِيمٌ",
      "tr": "Oysa onlardan biri, O, Rahman (olan Allah) için verdiği örnek ile (kız çocuğunun doğumuyla) müjdelendiği zaman, yüzü simsiyah kesilmiş olarak kahrından yutkundukça yutkunur.",
      "en": "And when one of them is given good tidings of that which he attributes to the Most Merciful in comparison, his face becomes dark, and he suppresses grief.",
      "priority": 1,
      "surah_number": 43,
      "surah_name": "Zuhruf",
      "ayah_number": 17,
      "ayah_end_number": 17,
      "status": "pending_review"
    },
    {
      "id": "043/022",
      "kind": "ayah",
      "ref": "043/022",
      "ar": "بَلْ قَالُوٓا۟ إِنَّا وَجَدْنَآ ءَابَآءَنَا عَلَىٰٓ أُمَّةٍ وَإِنَّا عَلَىٰٓ ءَاثَـٰرِهِم مُّهْتَدُونَ",
      "tr": "Hayır; dediler ki: \"Gerçekten atalarımızı bir ümmet üzerinde bulduk ve doğrusu biz onların izleri (eserleri) üstünde doğru olana (hidayete) yönelmiş (kimse)leriz.\"",
      "en": "Rather, they say, \"Indeed, we found our fathers upon a religion, and we are in their footsteps [rightly] guided.\"",
      "priority": 1,
      "surah_number": 43,
      "surah_name": "Zuhruf",
      "ayah_number": 22,
      "ayah_end_number": 22,
      "status": "pending_review"
    },
    {
      "id": "043/023",
      "kind": "ayah",
      "ref": "043/023",
      "ar": "وَكَذَٰلِكَ مَآ أَرْسَلْنَا مِن قَبْلِكَ فِى قَرْيَةٍ مِّن نَّذِيرٍ إِلَّا قَالَ مُتْرَفُوهَآ إِنَّا وَجَدْنَآ ءَابَآءَنَا عَلَىٰٓ أُمَّةٍ وَإِنَّا عَلَىٰٓ ءَاثَـٰرِهِم مُّقْتَدُونَ",
      "tr": "İşte böyle, senden önce de (herhangi) bir memlekete bir elçi göndermiş olmayalım, mutlaka onun 'refah içinde şımarıp azan önde gelenleri' (şöyle) demişlerdir: \"Gerçekten biz, atalarımızı bir ümmet (din) üzerinde bulduk ve doğrusu biz, onların izlerine (eserlerine) uymuş kimseleriz.\"",
      "en": "And similarly, We did not send before you any warner into a city except that its affluent said, \"Indeed, we found our fathers upon a religion, and we are, in their footsteps, following.\"",
      "priority": 1,
      "surah_number": 43,
      "surah_name": "Zuhruf",
      "ayah_number": 23,
      "ayah_end_number": 23,
      "status": "pending_review"
    },
    {
      "id": "043/024",
      "kind": "ayah",
      "ref": "043/024",
      "ar": "قَـٰلَ أَوَلَوْ جِئْتُكُم بِأَهْدَىٰ مِمَّا وَجَدتُّمْ عَلَيْهِ ءَابَآءَكُمْ ۖ قَالُوٓا۟ إِنَّا بِمَآ أُرْسِلْتُم بِهِۦ كَـٰفِرُونَ",
      "tr": "(O peygamberlerden her biri de şöyle) Demiştir: \"Ben size atalarınızı üstünde bulduğunuz şeyden daha doğru olanını getirmiş olsam da mı?\" Onlar da demişlerdi ki: \"Doğrusu biz, kendisiyle gönderildiğiniz şeye kafir olanlarız.\"",
      "en": "[Each warner] said, \"Even if I brought you better guidance than that [religion] upon which you found your fathers?\" They said, \"Indeed we, in that with which you were sent, are disbelievers.\"",
      "priority": 1,
      "surah_number": 43,
      "surah_name": "Zuhruf",
      "ayah_number": 24,
      "ayah_end_number": 24,
      "status": "pending_review"
    },
    {
      "id": "043/025",
      "kind": "ayah",
      "ref": "043/025",
      "ar": "فَٱنتَقَمْنَا مِنْهُمْ ۖ فَٱنظُرْ كَيْفَ كَانَ عَـٰقِبَةُ ٱلْمُكَذِّبِينَ",
      "tr": "Böylece onlardan intikam aldık. Öyleyse, bir bak; yalan sayanların sonu nasıl oldu?",
      "en": "So we took retribution from them; then see how was the end of the deniers.",
      "priority": 1,
      "surah_number": 43,
      "surah_name": "Zuhruf",
      "ayah_number": 25,
      "ayah_end_number": 25,
      "status": "pending_review"
    },
    {
      "id": "043/032",
      "kind": "ayah",
      "ref": "043/032",
      "ar": "أَهُمْ يَقْسِمُونَ رَحْمَتَ رَبِّكَ ۚ نَحْنُ قَسَمْنَا بَيْنَهُم مَّعِيشَتَهُمْ فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا ۚ وَرَفَعْنَا بَعْضَهُمْ فَوْقَ بَعْضٍ دَرَجَـٰتٍ لِّيَتَّخِذَ بَعْضُهُم بَعْضًا سُخْرِيًّا ۗ وَرَحْمَتُ رَبِّكَ خَيْرٌ مِّمَّا يَجْمَعُونَ",
      "tr": "Senin Rabbinin rahmetini onlar mı paylaştırıyorlar? Dünya hayatında maişetlerini aralarında Biz paylaştırdık ve onlardan bir bölümü (diğer) bir bölümünü 'teshir etmesi için, bir bölümünü bir bölümü üzerinde derecelerle yükselttik. Rabbinin rahmeti; toplayıp-yığdıklarından daha hayırlıdır.",
      "en": "Do they distribute the mercy of your Lord? It is We who have apportioned among them their livelihood in the life of this world and have raised some of them above others in degrees [of rank] that they may make use of one another for service. But the mercy of your Lord is better than whatever they accumulate.",
      "priority": 1,
      "surah_number": 43,
      "surah_name": "Zuhruf",
      "ayah_number": 32,
      "ayah_end_number": 32,
      "status": "pending_review"
    },
    {
      "id": "043/043",
      "kind": "ayah",
      "ref": "043/043",
      "ar": "فَٱسْتَمْسِكْ بِٱلَّذِىٓ أُوحِىَ إِلَيْكَ ۖ إِنَّكَ عَلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ",
      "tr": "Şu halde, sana vahyedilene sımsıkı-tutun; çünkü sen dosdoğru bir yol üzerindesin.",
      "en": "So adhere to that which is revealed to you. Indeed, you are on a straight path.",
      "priority": 1,
      "surah_number": 43,
      "surah_name": "Zuhruf",
      "ayah_number": 43,
      "ayah_end_number": 43,
      "status": "pending_review"
    },
    {
      "id": "043/057",
      "kind": "ayah",
      "ref": "043/057",
      "ar": "وَلَمَّا ضُرِبَ ٱبْنُ مَرْيَمَ مَثَلًا إِذَا قَوْمُكَ مِنْهُ يَصِدُّونَ",
      "tr": "Meryem oğlu (İsa) bir örnek olarak verilince, senin kavmin hemen ondan (keyifle söz edip) kahkahalarla gülüyorlar.",
      "en": "And when the son of Mary was presented as an example, immediately your people laughed aloud.",
      "priority": 1,
      "surah_number": 43,
      "surah_name": "Zuhruf",
      "ayah_number": 57,
      "ayah_end_number": 57,
      "status": "pending_review"
    },
    {
      "id": "043/061",
      "kind": "ayah",
      "ref": "043/061",
      "ar": "وَإِنَّهُۥ لَعِلْمٌ لِّلسَّاعَةِ فَلَا تَمْتَرُنَّ بِهَا وَٱتَّبِعُونِ ۚ هَـٰذَا صِرَٰطٌ مُّسْتَقِيمٌ",
      "tr": "Şüphesiz o, kıyamet-saati için bir ilimdir. Öyleyse ondan (kıyametten) yana hiçbir kuşkuya kapılmayın ve Bana uyun. Dosdoğru yol budur.",
      "en": "And indeed, Jesus will be [a sign for] knowledge of the Hour, so be not in doubt of it, and follow Me. This is a straight path.",
      "priority": 1,
      "surah_number": 43,
      "surah_name": "Zuhruf",
      "ayah_number": 61,
      "ayah_end_number": 61,
      "status": "pending_review"
    },
    {
      "id": "043/065",
      "kind": "ayah",
      "ref": "043/065",
      "ar": "فَٱخْتَلَفَ ٱلْأَحْزَابُ مِنۢ بَيْنِهِمْ ۖ فَوَيْلٌ لِّلَّذِينَ ظَلَمُوا۟ مِنْ عَذَابِ يَوْمٍ أَلِيمٍ",
      "tr": "Sonra, içlerinden birtakım fırkalar ihtilafa düştü. Artık, acı bir günün azabından vay o zulmetmiş olanlara.",
      "en": "But the denominations from among them differed [and separated], so woe to those who have wronged from the punishment of a painful Day.",
      "priority": 1,
      "surah_number": 43,
      "surah_name": "Zuhruf",
      "ayah_number": 65,
      "ayah_end_number": 65,
      "status": "pending_review"
    },
    {
      "id": "043/086",
      "kind": "ayah",
      "ref": "043/086",
      "ar": "وَلَا يَمْلِكُ ٱلَّذِينَ يَدْعُونَ مِن دُونِهِ ٱلشَّفَـٰعَةَ إِلَّا مَن شَهِدَ بِٱلْحَقِّ وَهُمْ يَعْلَمُونَ",
      "tr": "O'nun dışında taptıkları şefaatte bulunmaya malik değildirler; ancak kendileri bilerek hakka şahidlik edenler başka.",
      "en": "And those they invoke besides Him do not possess [power of] intercession; but only those who testify to the truth [can benefit], and they know.",
      "priority": 1,
      "surah_number": 43,
      "surah_name": "Zuhruf",
      "ayah_number": 86,
      "ayah_end_number": 86,
      "status": "pending_review"
    },
    {
      "id": "044/032",
      "kind": "ayah",
      "ref": "044/032",
      "ar": "وَلَقَدِ ٱخْتَرْنَـٰهُمْ عَلَىٰ عِلْمٍ عَلَى ٱلْعَـٰلَمِينَ",
      "tr": "Andolsun, Biz onları bir ilim üzere alemlere üstün kıldık.",
      "en": "And We certainly chose them by knowledge over [all] the worlds.",
      "priority": 1,
      "surah_number": 44,
      "surah_name": "Duhan",
      "ayah_number": 32,
      "ayah_end_number": 32,
      "status": "pending_review"
    },
    {
      "id": "045/013",
      "kind": "ayah",
      "ref": "045/013",
      "ar": "وَسَخَّرَ لَكُم مَّا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ جَمِيعًا مِّنْهُ ۚ إِنَّ فِى ذَٰلِكَ لَـَٔايَـٰتٍ لِّقَوْمٍ يَتَفَكَّرُونَ",
      "tr": "Kendinden (bir nimet olarak) göklerde ve yerde olanların tümüne sizin için boyun eğdirdi. Şüphesiz bunda, düşünebilen bir kavim için gerçekten ayetler vardır.",
      "en": "And He has subjected to you whatever is in the heavens and whatever is on the earth - all from Him. Indeed in that are signs for a people who give thought.",
      "priority": 1,
      "surah_number": 45,
      "surah_name": "Casiye",
      "ayah_number": 13,
      "ayah_end_number": 13,
      "status": "pending_review"
    },
    {
      "id": "045/016",
      "kind": "ayah",
      "ref": "045/016",
      "ar": "وَلَقَدْ ءَاتَيْنَا بَنِىٓ إِسْرَٰٓءِيلَ ٱلْكِتَـٰبَ وَٱلْحُكْمَ وَٱلنُّبُوَّةَ وَرَزَقْنَـٰهُم مِّنَ ٱلطَّيِّبَـٰتِ وَفَضَّلْنَـٰهُمْ عَلَى ٱلْعَـٰلَمِينَ",
      "tr": "Andolsun, Biz İsrailoğulları'na kitap, hüküm ve peygamberlik verdik, onları temiz ve güzel şeylerle rızıklandırdık ve onları alemlere üstün kıldık.",
      "en": "And We did certainly give the Children of Israel the Scripture and judgement and prophethood, and We provided them with good things and preferred them over the worlds.",
      "priority": 1,
      "surah_number": 45,
      "surah_name": "Casiye",
      "ayah_number": 16,
      "ayah_end_number": 16,
      "status": "pending_review"
    },
    {
      "id": "045/021",
      "kind": "ayah",
      "ref": "045/021",
      "ar": "أَمْ حَسِبَ ٱلَّذِينَ ٱجْتَرَحُوا۟ ٱلسَّيِّـَٔاتِ أَن نَّجْعَلَهُمْ كَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ سَوَآءً مَّحْيَاهُمْ وَمَمَاتُهُمْ ۚ سَآءَ مَا يَحْكُمُونَ",
      "tr": "Yoksa kötülüklere batıp-yara alanlar, kendilerini iman edip salih amellerde bulunanlar gibi kılacağımızı mı sandılar? Hayatları ve ölümleri bir mi (olacak)? Ne kötü hüküm veriyorlar.",
      "en": "Or do those who commit evils think We will make them like those who have believed and done righteous deeds - [make them] equal in their life and their death? Evil is that which they judge.",
      "priority": 1,
      "surah_number": 45,
      "surah_name": "Casiye",
      "ayah_number": 21,
      "ayah_end_number": 21,
      "status": "pending_review"
    },
    {
      "id": "045/022",
      "kind": "ayah",
      "ref": "045/022",
      "ar": "وَخَلَقَ ٱللَّهُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ بِٱلْحَقِّ وَلِتُجْزَىٰ كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ وَهُمْ لَا يُظْلَمُونَ",
      "tr": "Allah, gökleri ve yeri hak olarak yarattı; öyle ki, her nefis kazandıklarıyla karşılık görsün. Onlara zulmedilmez.",
      "en": "And Allah created the heavens and earth in truth and so that every soul may be recompensed for what it has earned, and they will not be wronged.",
      "priority": 1,
      "surah_number": 45,
      "surah_name": "Casiye",
      "ayah_number": 22,
      "ayah_end_number": 22,
      "status": "pending_review"
    },
    {
      "id": "045/023",
      "kind": "ayah",
      "ref": "045/023",
      "ar": "أَفَرَءَيْتَ مَنِ ٱتَّخَذَ إِلَـٰهَهُۥ هَوَىٰهُ وَأَضَلَّهُ ٱللَّهُ عَلَىٰ عِلْمٍ وَخَتَمَ عَلَىٰ سَمْعِهِۦ وَقَلْبِهِۦ وَجَعَلَ عَلَىٰ بَصَرِهِۦ غِشَـٰوَةً فَمَن يَهْدِيهِ مِنۢ بَعْدِ ٱللَّهِ ۚ أَفَلَا تَذَكَّرُونَ",
      "tr": "Şimdi sen, kendi hevasını ilah edinen ve Allah'ın bir ilim üzere kendisini saptırdığı, kulağını ve kalbini mühürlediği ve gözü üstüne bir perde çektiği kimseyi gördün mü? Artık Allah'tan sonra ona kim hidayet verecektir? Siz yine de öğüt alıp-düşünmüyor musunuz?",
      "en": "Have you seen he who has taken as his god his [own] desire, and Allah has sent him astray due to knowledge and has set a seal upon his hearing and his heart and put over his vision a veil? So who will guide him after Allah? Then will you not be reminded?",
      "priority": 1,
      "surah_number": 45,
      "surah_name": "Casiye",
      "ayah_number": 23,
      "ayah_end_number": 23,
      "status": "pending_review"
    },
    {
      "id": "045/035",
      "kind": "ayah",
      "ref": "045/035",
      "ar": "ذَٰلِكُم بِأَنَّكُمُ ٱتَّخَذْتُمْ ءَايَـٰتِ ٱللَّهِ هُزُوًا وَغَرَّتْكُمُ ٱلْحَيَوٰةُ ٱلدُّنْيَا ۚ فَٱلْيَوْمَ لَا يُخْرَجُونَ مِنْهَا وَلَا هُمْ يُسْتَعْتَبُونَ",
      "tr": "\"Bunun nedeni şudur: Çünkü siz Allah'ın ayetlerini alay konusu edindiniz; dünya hayatı da sizi aldattı.\" Böylece ne ordan (ateşten) çıkarılırlar, ne (Allah'tan) hoşnutluk dilekleri kabul edilir.",
      "en": "That is because you took the verses of Allah in ridicule, and worldly life deluded you.\" So that Day they will not be removed from it, nor will they be asked to appease [Allah].",
      "priority": 1,
      "surah_number": 45,
      "surah_name": "Casiye",
      "ayah_number": 35,
      "ayah_end_number": 35,
      "status": "pending_review"
    },
    {
      "id": "046/005",
      "kind": "ayah",
      "ref": "046/005",
      "ar": "وَمَنْ أَضَلُّ مِمَّن يَدْعُوا۟ مِن دُونِ ٱللَّهِ مَن لَّا يَسْتَجِيبُ لَهُۥٓ إِلَىٰ يَوْمِ ٱلْقِيَـٰمَةِ وَهُمْ عَن دُعَآئِهِمْ غَـٰفِلُونَ",
      "tr": "Allah'ı bırakıp kıyamet gününe kadar kendisine icabet etmeyecek şeylere tapandan daha sapmış kimdir? Oysa onlar, bunların tapmalarından habersizdirler.",
      "en": "And who is more astray than he who invokes besides Allah those who will not respond to him until the Day of Resurrection, and they, of their invocation, are unaware.",
      "priority": 1,
      "surah_number": 46,
      "surah_name": "Ahkaf",
      "ayah_number": 5,
      "ayah_end_number": 5,
      "status": "pending_review"
    },
    {
      "id": "046/007",
      "kind": "ayah",
      "ref": "046/007",
      "ar": "وَإِذَا تُتْلَىٰ عَلَيْهِمْ ءَايَـٰتُنَا بَيِّنَـٰتٍ قَالَ ٱلَّذِينَ كَفَرُوا۟ لِلْحَقِّ لَمَّا جَآءَهُمْ هَـٰذَا سِحْرٌ مُّبِينٌ",
      "tr": "Onlara açık belgeler olarak ayetlerimiz okunduğu zaman, o inkar edenler kendilerine gelmiş olan hak için dediler ki: \"Bu, apaçık bir büyüdür.\"",
      "en": "And when Our verses are recited to them as clear evidences, those who disbelieve say of the truth when it has come to them, \"This is obvious magic.\"",
      "priority": 1,
      "surah_number": 46,
      "surah_name": "Ahkaf",
      "ayah_number": 7,
      "ayah_end_number": 7,
      "status": "pending_review"
    },
    {
      "id": "046/015",
      "kind": "ayah",
      "ref": "046/015",
      "ar": "وَوَصَّيْنَا ٱلْإِنسَـٰنَ بِوَٰلِدَيْهِ إِحْسَـٰنًا ۖ حَمَلَتْهُ أُمُّهُۥ كُرْهًا وَوَضَعَتْهُ كُرْهًا ۖ وَحَمْلُهُۥ وَفِصَـٰلُهُۥ ثَلَـٰثُونَ شَهْرًا ۚ حَتَّىٰٓ إِذَا بَلَغَ أَشُدَّهُۥ وَبَلَغَ أَرْبَعِينَ سَنَةً قَالَ رَبِّ أَوْزِعْنِىٓ أَنْ أَشْكُرَ نِعْمَتَكَ ٱلَّتِىٓ أَنْعَمْتَ عَلَىَّ وَعَلَىٰ وَٰلِدَىَّ وَأَنْ أَعْمَلَ صَـٰلِحًا تَرْضَىٰهُ وَأَصْلِحْ لِى فِى ذُرِّيَّتِىٓ ۖ إِنِّى تُبْتُ إِلَيْكَ وَإِنِّى مِنَ ٱلْمُسْلِمِينَ",
      "tr": "Biz insana, 'anne ve babasına' iyilikle davranmasını tavsiye ettik. Annesi onu güçlükle taşıdı ve onu güçlükle doğurdu. Onun (hamilelikte) taşınması ve sütten kesilmesi, otuz aydır. Nihayet güçlü (erginlik) çağına erip kırk yıl (yaşın)a ulaşınca, dedi ki: \"Rabbim, bana, anne ve babama verdiğin nimete şükretmemi ve Senin razı olacağın salih bir amelde bulunmamı bana ilham et; benim için soyumda salahı ver. Gerçekten ben tevbe edip Sana yöneldim ve gerçekten ben Müslümanlardanım.\"",
      "en": "And We have enjoined upon man, to his parents, good treatment. His mother carried him with hardship and gave birth to him with hardship, and his gestation and weaning [period] is thirty months. [He grows] until, when he reaches maturity and reaches [the age of] forty years, he says, \"My Lord, enable me to be grateful for Your favor which You have bestowed upon me and upon my parents and to work righteousness of which You will approve and make righteous for me my offspring. Indeed, I have repented to You, and indeed, I am of the Muslims.\"",
      "priority": 1,
      "surah_number": 46,
      "surah_name": "Ahkaf",
      "ayah_number": 15,
      "ayah_end_number": 15,
      "status": "pending_review"
    },
    {
      "id": "046/016",
      "kind": "ayah",
      "ref": "046/016",
      "ar": "أُو۟لَـٰٓئِكَ ٱلَّذِينَ نَتَقَبَّلُ عَنْهُمْ أَحْسَنَ مَا عَمِلُوا۟ وَنَتَجَاوَزُ عَن سَيِّـَٔاتِهِمْ فِىٓ أَصْحَـٰبِ ٱلْجَنَّةِ ۖ وَعْدَ ٱلصِّدْقِ ٱلَّذِى كَانُوا۟ يُوعَدُونَ",
      "tr": "İşte bunlar; yaptıklarının en güzelini kabul ederiz ve kötülüklerinden geçeriz; (bunlar) cennet halkı içindedirler. (İşte bu,) Onlara va'dolunan doğru bir vaaddir.",
      "en": "Those are the ones from whom We will accept the best of what they did and overlook their misdeeds, [their being] among the companions of Paradise. [That is] the promise of truth which they had been promised.",
      "priority": 1,
      "surah_number": 46,
      "surah_name": "Ahkaf",
      "ayah_number": 16,
      "ayah_end_number": 16,
      "status": "pending_review"
    },
    {
      "id": "046/019",
      "kind": "ayah",
      "ref": "046/019",
      "ar": "وَلِكُلٍّ دَرَجَـٰتٌ مِّمَّا عَمِلُوا۟ ۖ وَلِيُوَفِّيَهُمْ أَعْمَـٰلَهُمْ وَهُمْ لَا يُظْلَمُونَ",
      "tr": "Her biri için yaptıklarınızdan dolayı dereceler vardır; öyle ki amelleri kendilerine eksiksizce ödensin ve onlar zulme de uğratılmazlar.",
      "en": "And for all there are degrees [of reward and punishment] for what they have done, and [it is] so that He may fully compensate them for their deeds, and they will not be wronged.",
      "priority": 1,
      "surah_number": 46,
      "surah_name": "Ahkaf",
      "ayah_number": 19,
      "ayah_end_number": 19,
      "status": "pending_review"
    },
    {
      "id": "046/020",
      "kind": "ayah",
      "ref": "046/020",
      "ar": "وَيَوْمَ يُعْرَضُ ٱلَّذِينَ كَفَرُوا۟ عَلَى ٱلنَّارِ أَذْهَبْتُمْ طَيِّبَـٰتِكُمْ فِى حَيَاتِكُمُ ٱلدُّنْيَا وَٱسْتَمْتَعْتُم بِهَا فَٱلْيَوْمَ تُجْزَوْنَ عَذَابَ ٱلْهُونِ بِمَا كُنتُمْ تَسْتَكْبِرُونَ فِى ٱلْأَرْضِ بِغَيْرِ ٱلْحَقِّ وَبِمَا كُنتُمْ تَفْسُقُونَ",
      "tr": "İnkar edenler ateşe sunulacakları gün, (onlara şöyle denir:) \"Siz dünya hayatınızda bütün 'güzellikleriniz ve zevklerinizi tüketip-yok ettiniz, onlarla yaşayıp-zevk sürdünüz. İşte yeryüzünde haksız yere büyüklenmeniz (istikbarınız) ve fasıklıkta bulunmanızdan dolayı, bugün alçaltıcı bir azap ile cezalandırılacaksınız.\"",
      "en": "And the Day those who disbelieved are exposed to the Fire [it will be said], \"You exhausted your pleasures during your worldly life and enjoyed them, so this Day you will be awarded the punishment of [extreme] humiliation because you were arrogant upon the earth without right and because you were defiantly disobedient.\"",
      "priority": 1,
      "surah_number": 46,
      "surah_name": "Ahkaf",
      "ayah_number": 20,
      "ayah_end_number": 20,
      "status": "pending_review"
    },
    {
      "id": "046/023",
      "kind": "ayah",
      "ref": "046/023",
      "ar": "قَالَ إِنَّمَا ٱلْعِلْمُ عِندَ ٱللَّهِ وَأُبَلِّغُكُم مَّآ أُرْسِلْتُ بِهِۦ وَلَـٰكِنِّىٓ أَرَىٰكُمْ قَوْمًا تَجْهَلُونَ",
      "tr": "Dedi ki: \"İlim ancak Allah Katındadır. Ben size gönderildiğim şeyi tebliğ ediyorum; ancak sizi cahillik eden bir kavim olarak görüyorum.\"",
      "en": "He said, \"Knowledge [of its time] is only with Allah, and I convey to you that with which I was sent; but I see you [to be] a people behaving ignorantly.\"",
      "priority": 1,
      "surah_number": 46,
      "surah_name": "Ahkaf",
      "ayah_number": 23,
      "ayah_end_number": 23,
      "status": "pending_review"
    },
    {
      "id": "046/019-020",
      "kind": "ayah",
      "ref": "046/019-020",
      "ar": "﴿19﴾ وَلِكُلٍّ دَرَجَـٰتٌ مِّمَّا عَمِلُوا۟ ۖ وَلِيُوَفِّيَهُمْ أَعْمَـٰلَهُمْ وَهُمْ لَا يُظْلَمُونَ\n\n﴿20﴾ وَيَوْمَ يُعْرَضُ ٱلَّذِينَ كَفَرُوا۟ عَلَى ٱلنَّارِ أَذْهَبْتُمْ طَيِّبَـٰتِكُمْ فِى حَيَاتِكُمُ ٱلدُّنْيَا وَٱسْتَمْتَعْتُم بِهَا فَٱلْيَوْمَ تُجْزَوْنَ عَذَابَ ٱلْهُونِ بِمَا كُنتُمْ تَسْتَكْبِرُونَ فِى ٱلْأَرْضِ بِغَيْرِ ٱلْحَقِّ وَبِمَا كُنتُمْ تَفْسُقُونَ",
      "tr": "[19] Her biri için yaptıklarınızdan dolayı dereceler vardır; öyle ki amelleri kendilerine eksiksizce ödensin ve onlar zulme de uğratılmazlar.\n\n[20] İnkar edenler ateşe sunulacakları gün, (onlara şöyle denir:) \"Siz dünya hayatınızda bütün 'güzellikleriniz ve zevklerinizi tüketip-yok ettiniz, onlarla yaşayıp-zevk sürdünüz. İşte yeryüzünde haksız yere büyüklenmeniz (istikbarınız) ve fasıklıkta bulunmanızdan dolayı, bugün alçaltıcı bir azap ile cezalandırılacaksınız.\"",
      "en": "[19] And for all there are degrees [of reward and punishment] for what they have done, and [it is] so that He may fully compensate them for their deeds, and they will not be wronged.\n\n[20] And the Day those who disbelieved are exposed to the Fire [it will be said], \"You exhausted your pleasures during your worldly life and enjoyed them, so this Day you will be awarded the punishment of [extreme] humiliation because you were arrogant upon the earth without right and because you were defiantly disobedient.\"",
      "priority": 1,
      "surah_number": 46,
      "surah_name": "Ahkaf",
      "ayah_number": 19,
      "ayah_end_number": 20,
      "status": "pending_review"
    },
    {
      "id": "046/031",
      "kind": "ayah",
      "ref": "046/031",
      "ar": "يَـٰقَوْمَنَآ أَجِيبُوا۟ دَاعِىَ ٱللَّهِ وَءَامِنُوا۟ بِهِۦ يَغْفِرْ لَكُم مِّن ذُنُوبِكُمْ وَيُجِرْكُم مِّنْ عَذَابٍ أَلِيمٍ",
      "tr": "\"Ey kavmimiz, Allah'a davet edene icabet edin ve O’na iman edin; günahlarınızdan bir kısmını bağışlasın ve sizi acı bir azaptan korusun.\"",
      "en": "O our people, respond to the Messenger of Allah and believe in him; Allah will forgive for you your sins and protect you from a painful punishment.",
      "priority": 1,
      "surah_number": 46,
      "surah_name": "Ahkaf",
      "ayah_number": 31,
      "ayah_end_number": 31,
      "status": "pending_review"
    },
    {
      "id": "047/004",
      "kind": "ayah",
      "ref": "047/004",
      "ar": "فَإِذَا لَقِيتُمُ ٱلَّذِينَ كَفَرُوا۟ فَضَرْبَ ٱلرِّقَابِ حَتَّىٰٓ إِذَآ أَثْخَنتُمُوهُمْ فَشُدُّوا۟ ٱلْوَثَاقَ فَإِمَّا مَنًّۢا بَعْدُ وَإِمَّا فِدَآءً حَتَّىٰ تَضَعَ ٱلْحَرْبُ أَوْزَارَهَا ۚ ذَٰلِكَ وَلَوْ يَشَآءُ ٱللَّهُ لَٱنتَصَرَ مِنْهُمْ وَلَـٰكِن لِّيَبْلُوَا۟ بَعْضَكُم بِبَعْضٍ ۗ وَٱلَّذِينَ قُتِلُوا۟ فِى سَبِيلِ ٱللَّهِ فَلَن يُضِلَّ أَعْمَـٰلَهُمْ",
      "tr": "Öyleyse, inkar edenlerle (savaş sırasında) karşı karşıya geldiğiniz zaman, hemen boyunlarını vurun; sonunda onları 'iyice bozguna uğratıp zafer kazanınca da' artık (esirler için) bağı sımsıkı tutun. Bundan sonra ya bir lütuf olarak (onları bırakın) veya bir fidye (karşılığı salıverin). Öyle ki savaş ağırlıklarını bıraksın (sona ersin). İşte böyle; eğer Allah dilemiş olsaydı, elbette onlardan intikam alırdı. Ancak (savaş,) sizleri birbirinizle denemesi içindir. Allah yolunda öldürülenlerin ise; kesin olarak (Allah,) amellerini giderip-boşa çıkarmaz.",
      "en": "So when you meet those who disbelieve [in battle], strike [their] necks until, when you have inflicted slaughter upon them, then secure their bonds, and either [confer] favor afterwards or ransom [them] until the war lays down its burdens. That [is the command]. And if Allah had willed, He could have taken vengeance upon them [Himself], but [He ordered armed struggle] to test some of you by means of others. And those who are killed in the cause of Allah - never will He waste their deeds.",
      "priority": 1,
      "surah_number": 47,
      "surah_name": "Muhammed",
      "ayah_number": 4,
      "ayah_end_number": 4,
      "status": "pending_review"
    },
    {
      "id": "047/008",
      "kind": "ayah",
      "ref": "047/008",
      "ar": "وَٱلَّذِينَ كَفَرُوا۟ فَتَعْسًا لَّهُمْ وَأَضَلَّ أَعْمَـٰلَهُمْ",
      "tr": "İnkar edenler ise, yüzükoyun-düşüş, onlara olsun; (Allah,) amellerini giderip-boşa çıkarmıştır.",
      "en": "But those who disbelieve - for them is misery, and He will waste their deeds.",
      "priority": 1,
      "surah_number": 47,
      "surah_name": "Muhammed",
      "ayah_number": 8,
      "ayah_end_number": 8,
      "status": "pending_review"
    },
    {
      "id": "047/009",
      "kind": "ayah",
      "ref": "047/009",
      "ar": "ذَٰلِكَ بِأَنَّهُمْ كَرِهُوا۟ مَآ أَنزَلَ ٱللَّهُ فَأَحْبَطَ أَعْمَـٰلَهُمْ",
      "tr": "İşte böyle; çünkü onlar, Allah'ın indirdiğini çirkin (kerih) gördüler, bundan dolayı, O da, onların amellerini boşa çıkardı.",
      "en": "That is because they disliked what Allah revealed, so He rendered worthless their deeds.",
      "priority": 1,
      "surah_number": 47,
      "surah_name": "Muhammed",
      "ayah_number": 9,
      "ayah_end_number": 9,
      "status": "pending_review"
    },
    {
      "id": "047/010",
      "kind": "ayah",
      "ref": "047/010",
      "ar": "أَفَلَمْ يَسِيرُوا۟ فِى ٱلْأَرْضِ فَيَنظُرُوا۟ كَيْفَ كَانَ عَـٰقِبَةُ ٱلَّذِينَ مِن قَبْلِهِمْ ۚ دَمَّرَ ٱللَّهُ عَلَيْهِمْ ۖ وَلِلْكَـٰفِرِينَ أَمْثَـٰلُهَا",
      "tr": "Onlar, yeryüzünde gezip dolaşmıyorlar mı ki, kendilerinden öncekilerin nasıl bir sona uğradıklarını görsünler. Allah, onları yerle bir etti. O kafirler için de bunun bir benzeri vardır.",
      "en": "Have they not traveled through the land and seen how was the end of those before them? Allah destroyed [everything] over them, and for the disbelievers is something comparable.",
      "priority": 1,
      "surah_number": 47,
      "surah_name": "Muhammed",
      "ayah_number": 10,
      "ayah_end_number": 10,
      "status": "pending_review"
    },
    {
      "id": "047/012",
      "kind": "ayah",
      "ref": "047/012",
      "ar": "إِنَّ ٱللَّهَ يُدْخِلُ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ جَنَّـٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ ۖ وَٱلَّذِينَ كَفَرُوا۟ يَتَمَتَّعُونَ وَيَأْكُلُونَ كَمَا تَأْكُلُ ٱلْأَنْعَـٰمُ وَٱلنَّارُ مَثْوًى لَّهُمْ",
      "tr": "Şüphesiz Allah, iman edip salih amellerde bulunanları, altından ırmaklar akan cennetlere sokar. İnkar edenler ise, metalanırlar ve hayvanların yemesi gibi yerler; ateş, onlar için bir konaklama yeridir.",
      "en": "Indeed, Allah will admit those who have believed and done righteous deeds to gardens beneath which rivers flow, but those who disbelieve enjoy themselves and eat as grazing livestock eat, and the Fire will be a residence for them.",
      "priority": 1,
      "surah_number": 47,
      "surah_name": "Muhammed",
      "ayah_number": 12,
      "ayah_end_number": 12,
      "status": "pending_review"
    },
    {
      "id": "047/018",
      "kind": "ayah",
      "ref": "047/018",
      "ar": "فَهَلْ يَنظُرُونَ إِلَّا ٱلسَّاعَةَ أَن تَأْتِيَهُم بَغْتَةً ۖ فَقَدْ جَآءَ أَشْرَاطُهَا ۚ فَأَنَّىٰ لَهُمْ إِذَا جَآءَتْهُمْ ذِكْرَىٰهُمْ",
      "tr": "Artık onlar, kıyamet-saatinin kendilerine apansız gelmesinden başkasını mı gözlüyorlar? İşte onun işaretleri gelmiştir. Fakat kendilerine geldikten sonra öğüt alıp-düşünmeleri onlara neyi sağlar?",
      "en": "Then do they await except that the Hour should come upon them unexpectedly? But already there have come [some of] its indications. Then what good to them, when it has come, will be their remembrance?",
      "priority": 1,
      "surah_number": 47,
      "surah_name": "Muhammed",
      "ayah_number": 18,
      "ayah_end_number": 18,
      "status": "pending_review"
    },
    {
      "id": "047/020",
      "kind": "ayah",
      "ref": "047/020",
      "ar": "وَيَقُولُ ٱلَّذِينَ ءَامَنُوا۟ لَوْلَا نُزِّلَتْ سُورَةٌ ۖ فَإِذَآ أُنزِلَتْ سُورَةٌ مُّحْكَمَةٌ وَذُكِرَ فِيهَا ٱلْقِتَالُ ۙ رَأَيْتَ ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌ يَنظُرُونَ إِلَيْكَ نَظَرَ ٱلْمَغْشِىِّ عَلَيْهِ مِنَ ٱلْمَوْتِ ۖ فَأَوْلَىٰ لَهُمْ",
      "tr": "İman edenler, derler ki: \"(Savaş izni için) Bir sûre indirilmeli değil miydi?\" Fakat, içinde savaş (kıtal) zikri geçen muhkem bir sure indirildiği zaman, kalplerinde hastalık olanların, üzerine ölüm baygınlığı çökmüş olanların bakışı gibi sana baktıklarını gördün. Oysa onlara evla (olan):",
      "en": "Those who believe say, \"Why has a surah not been sent down? But when a precise surah is revealed and fighting is mentioned therein, you see those in whose hearts is hypocrisy looking at you with a look of one overcome by death. And more appropriate for them [would have been]",
      "priority": 1,
      "surah_number": 47,
      "surah_name": "Muhammed",
      "ayah_number": 20,
      "ayah_end_number": 20,
      "status": "pending_review"
    },
    {
      "id": "047/021",
      "kind": "ayah",
      "ref": "047/021",
      "ar": "طَاعَةٌ وَقَوْلٌ مَّعْرُوفٌ ۚ فَإِذَا عَزَمَ ٱلْأَمْرُ فَلَوْ صَدَقُوا۟ ٱللَّهَ لَكَانَ خَيْرًا لَّهُمْ",
      "tr": "İtaat ve maruf (güzel) sözdü. Fakat iş, kesinlik ve kararlılık gerektirdiği zaman, şayet Allah'a sadakat gösterselerdi, şüphesiz onlar için daha hayırlı olurdu.",
      "en": "Obedience and good words. And when the matter [of fighting] was determined, if they had been true to Allah, it would have been better for them.",
      "priority": 1,
      "surah_number": 47,
      "surah_name": "Muhammed",
      "ayah_number": 21,
      "ayah_end_number": 21,
      "status": "pending_review"
    },
    {
      "id": "047/023",
      "kind": "ayah",
      "ref": "047/023",
      "ar": "أُو۟لَـٰٓئِكَ ٱلَّذِينَ لَعَنَهُمُ ٱللَّهُ فَأَصَمَّهُمْ وَأَعْمَىٰٓ أَبْصَـٰرَهُمْ",
      "tr": "İşte bunlar; Allah onları lanetlemiş, böylece (kulaklarını) sağırlaştırmış ve basiret (göz)lerini de kör etmiştir.",
      "en": "Those [who do so] are the ones that Allah has cursed, so He deafened them and blinded their vision.",
      "priority": 1,
      "surah_number": 47,
      "surah_name": "Muhammed",
      "ayah_number": 23,
      "ayah_end_number": 23,
      "status": "pending_review"
    },
    {
      "id": "047/020-021",
      "kind": "ayah",
      "ref": "047/020-021",
      "ar": "﴿20﴾ وَيَقُولُ ٱلَّذِينَ ءَامَنُوا۟ لَوْلَا نُزِّلَتْ سُورَةٌ ۖ فَإِذَآ أُنزِلَتْ سُورَةٌ مُّحْكَمَةٌ وَذُكِرَ فِيهَا ٱلْقِتَالُ ۙ رَأَيْتَ ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌ يَنظُرُونَ إِلَيْكَ نَظَرَ ٱلْمَغْشِىِّ عَلَيْهِ مِنَ ٱلْمَوْتِ ۖ فَأَوْلَىٰ لَهُمْ\n\n﴿21﴾ طَاعَةٌ وَقَوْلٌ مَّعْرُوفٌ ۚ فَإِذَا عَزَمَ ٱلْأَمْرُ فَلَوْ صَدَقُوا۟ ٱللَّهَ لَكَانَ خَيْرًا لَّهُمْ",
      "tr": "[20] İman edenler, derler ki: \"(Savaş izni için) Bir sûre indirilmeli değil miydi?\" Fakat, içinde savaş (kıtal) zikri geçen muhkem bir sure indirildiği zaman, kalplerinde hastalık olanların, üzerine ölüm baygınlığı çökmüş olanların bakışı gibi sana baktıklarını gördün. Oysa onlara evla (olan):\n\n[21] İtaat ve maruf (güzel) sözdü. Fakat iş, kesinlik ve kararlılık gerektirdiği zaman, şayet Allah'a sadakat gösterselerdi, şüphesiz onlar için daha hayırlı olurdu.",
      "en": "[20] Those who believe say, \"Why has a surah not been sent down? But when a precise surah is revealed and fighting is mentioned therein, you see those in whose hearts is hypocrisy looking at you with a look of one overcome by death. And more appropriate for them [would have been]\n\n[21] Obedience and good words. And when the matter [of fighting] was determined, if they had been true to Allah, it would have been better for them.",
      "priority": 1,
      "surah_number": 47,
      "surah_name": "Muhammed",
      "ayah_number": 20,
      "ayah_end_number": 21,
      "status": "pending_review"
    },
    {
      "id": "047/025",
      "kind": "ayah",
      "ref": "047/025",
      "ar": "إِنَّ ٱلَّذِينَ ٱرْتَدُّوا۟ عَلَىٰٓ أَدْبَـٰرِهِم مِّنۢ بَعْدِ مَا تَبَيَّنَ لَهُمُ ٱلْهُدَى ۙ ٱلشَّيْطَـٰنُ سَوَّلَ لَهُمْ وَأَمْلَىٰ لَهُمْ",
      "tr": "Şüphesiz, kendilerine hidayet açıkça belli olduktan sonra, gerisin geri (küfre) dönenleri, şeytan kışkırtmış ve uzun emellere kaptırmıştır.",
      "en": "Indeed, those who reverted back [to disbelief] after guidance had become clear to them - Satan enticed them and prolonged hope for them.",
      "priority": 1,
      "surah_number": 47,
      "surah_name": "Muhammed",
      "ayah_number": 25,
      "ayah_end_number": 25,
      "status": "pending_review"
    },
    {
      "id": "047/031",
      "kind": "ayah",
      "ref": "047/031",
      "ar": "وَلَنَبْلُوَنَّكُمْ حَتَّىٰ نَعْلَمَ ٱلْمُجَـٰهِدِينَ مِنكُمْ وَٱلصَّـٰبِرِينَ وَنَبْلُوَا۟ أَخْبَارَكُمْ",
      "tr": "Andolsun, Biz sizden mücahid olanlarla sabredenleri bilinceye (belli edip ortaya çıkarıncaya) kadar, deneyeceğiz ve haberlerinizi sınayacağız (açıklayacağız).",
      "en": "And We will surely test you until We make evident those who strive among you [for the cause of Allah] and the patient, and We will test your affairs.",
      "priority": 1,
      "surah_number": 47,
      "surah_name": "Muhammed",
      "ayah_number": 31,
      "ayah_end_number": 31,
      "status": "pending_review"
    },
    {
      "id": "047/036",
      "kind": "ayah",
      "ref": "047/036",
      "ar": "إِنَّمَا ٱلْحَيَوٰةُ ٱلدُّنْيَا لَعِبٌ وَلَهْوٌ ۚ وَإِن تُؤْمِنُوا۟ وَتَتَّقُوا۟ يُؤْتِكُمْ أُجُورَكُمْ وَلَا يَسْـَٔلْكُمْ أَمْوَٰلَكُمْ",
      "tr": "Gerçekten dünya hayatı, ancak bir oyun ve tutkulu bir oyalanmadır. Eğer iman ederseniz ve sakınırsanız, O, size ecirlerinizi verir ve mallarınızı da istemez.",
      "en": "[This] worldly life is only amusement and diversion. And if you believe and fear Allah, He will give you your rewards and not ask you for your properties.",
      "priority": 1,
      "surah_number": 47,
      "surah_name": "Muhammed",
      "ayah_number": 36,
      "ayah_end_number": 36,
      "status": "pending_review"
    },
    {
      "id": "047/038",
      "kind": "ayah",
      "ref": "047/038",
      "ar": "هَـٰٓأَنتُمْ هَـٰٓؤُلَآءِ تُدْعَوْنَ لِتُنفِقُوا۟ فِى سَبِيلِ ٱللَّهِ فَمِنكُم مَّن يَبْخَلُ ۖ وَمَن يَبْخَلْ فَإِنَّمَا يَبْخَلُ عَن نَّفْسِهِۦ ۚ وَٱللَّهُ ٱلْغَنِىُّ وَأَنتُمُ ٱلْفُقَرَآءُ ۚ وَإِن تَتَوَلَّوْا۟ يَسْتَبْدِلْ قَوْمًا غَيْرَكُمْ ثُمَّ لَا يَكُونُوٓا۟ أَمْثَـٰلَكُم",
      "tr": "İşte sizler böylesiniz; Allah yolunda infak etmeye çağrılıyorsunuz; buna rağmen bazılarınız cimrilik ediyor. Kim cimrilik ederse, artık o, ancak kendi nefsine cimrilik eder. Allah ise, Ğaniy (hiçbir şeye ihtiyacı olmayan)dır; fakir olan sizlersiniz. Eğer siz yüz çevirecek olursanız, sizden başka bir kavmi getirip-değiştirir. Sonra onlar, sizin benzeriniz de olmazlar.",
      "en": "Here you are - those invited to spend in the cause of Allah - but among you are those who withhold [out of greed]. And whoever withholds only withholds [benefit] from himself; and Allah is the Free of need, while you are the needy. And if you turn away, He will replace you with another people; then they will not be the likes of you.",
      "priority": 1,
      "surah_number": 47,
      "surah_name": "Muhammed",
      "ayah_number": 38,
      "ayah_end_number": 38,
      "status": "pending_review"
    },
    {
      "id": "048/003",
      "kind": "ayah",
      "ref": "048/003",
      "ar": "وَيَنصُرَكَ ٱللَّهُ نَصْرًا عَزِيزًا",
      "tr": "Ve Allah, sana 'üstün ve onurlu' bir zaferle yardım etsin.",
      "en": "And [that] Allah may aid you with a mighty victory.",
      "priority": 1,
      "surah_number": 48,
      "surah_name": "Fetih",
      "ayah_number": 3,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "048/004",
      "kind": "ayah",
      "ref": "048/004",
      "ar": "هُوَ ٱلَّذِىٓ أَنزَلَ ٱلسَّكِينَةَ فِى قُلُوبِ ٱلْمُؤْمِنِينَ لِيَزْدَادُوٓا۟ إِيمَـٰنًا مَّعَ إِيمَـٰنِهِمْ ۗ وَلِلَّهِ جُنُودُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَكَانَ ٱللَّهُ عَلِيمًا حَكِيمًا",
      "tr": "Mü'minlerin kalplerine, imanlarına iman katıp-arttırsınlar diye, 'güven duygusu ve huzur' indiren O'dur. Göklerin ve yerin orduları Allah'ındır: Allah bilendir, hüküm ve hikmet sahibidir.",
      "en": "It is He who sent down tranquillity into the hearts of the believers that they would increase in faith along with their [present] faith. And to Allah belong the soldiers of the heavens and the earth, and ever is Allah Knowing and Wise.",
      "priority": 1,
      "surah_number": 48,
      "surah_name": "Fetih",
      "ayah_number": 4,
      "ayah_end_number": 4,
      "status": "pending_review"
    },
    {
      "id": "048/010",
      "kind": "ayah",
      "ref": "048/010",
      "ar": "إِنَّ ٱلَّذِينَ يُبَايِعُونَكَ إِنَّمَا يُبَايِعُونَ ٱللَّهَ يَدُ ٱللَّهِ فَوْقَ أَيْدِيهِمْ ۚ فَمَن نَّكَثَ فَإِنَّمَا يَنكُثُ عَلَىٰ نَفْسِهِۦ ۖ وَمَنْ أَوْفَىٰ بِمَا عَـٰهَدَ عَلَيْهُ ٱللَّهَ فَسَيُؤْتِيهِ أَجْرًا عَظِيمًا",
      "tr": "Şüphesiz sana biat edenler, ancak Allah'a biat etmişlerdir. Allah'ın eli, onların ellerinin üzerindedir. Şu halde, kim ahdini bozarsa, artık o, ancak kendi aleyhine ahdini bozmuş olur. Kim de Allah'a verdiği ahdine vefa gösterirse, artık O da, ona büyük bir ecir verecektir.",
      "en": "Indeed, those who pledge allegiance to you, [O Muhammad] - they are actually pledging allegiance to Allah. The hand of Allah is over their hands. So he who breaks his word only breaks it to the detriment of himself. And he who fulfills that which he has promised Allah - He will give him a great reward.",
      "priority": 1,
      "surah_number": 48,
      "surah_name": "Fetih",
      "ayah_number": 10,
      "ayah_end_number": 10,
      "status": "pending_review"
    },
    {
      "id": "048/003-004",
      "kind": "ayah",
      "ref": "048/003-004",
      "ar": "﴿3﴾ وَيَنصُرَكَ ٱللَّهُ نَصْرًا عَزِيزًا\n\n﴿4﴾ هُوَ ٱلَّذِىٓ أَنزَلَ ٱلسَّكِينَةَ فِى قُلُوبِ ٱلْمُؤْمِنِينَ لِيَزْدَادُوٓا۟ إِيمَـٰنًا مَّعَ إِيمَـٰنِهِمْ ۗ وَلِلَّهِ جُنُودُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَكَانَ ٱللَّهُ عَلِيمًا حَكِيمًا",
      "tr": "[3] Ve Allah, sana 'üstün ve onurlu' bir zaferle yardım etsin.\n\n[4] Mü'minlerin kalplerine, imanlarına iman katıp-arttırsınlar diye, 'güven duygusu ve huzur' indiren O'dur. Göklerin ve yerin orduları Allah'ındır: Allah bilendir, hüküm ve hikmet sahibidir.",
      "en": "[3] And [that] Allah may aid you with a mighty victory.\n\n[4] It is He who sent down tranquillity into the hearts of the believers that they would increase in faith along with their [present] faith. And to Allah belong the soldiers of the heavens and the earth, and ever is Allah Knowing and Wise.",
      "priority": 1,
      "surah_number": 48,
      "surah_name": "Fetih",
      "ayah_number": 3,
      "ayah_end_number": 4,
      "status": "pending_review"
    },
    {
      "id": "048/018",
      "kind": "ayah",
      "ref": "048/018",
      "ar": "لَّقَدْ رَضِىَ ٱللَّهُ عَنِ ٱلْمُؤْمِنِينَ إِذْ يُبَايِعُونَكَ تَحْتَ ٱلشَّجَرَةِ فَعَلِمَ مَا فِى قُلُوبِهِمْ فَأَنزَلَ ٱلسَّكِينَةَ عَلَيْهِمْ وَأَثَـٰبَهُمْ فَتْحًا قَرِيبًا",
      "tr": "Andolsun, Allah, sana o ağacın altında biat ederlerken mü'minlerden razı olmuştur, kalplerinde olanı bilmiş ve böylece üzerlerine 'güven duygusu ve huzur' indirmiştir ve onlara yakın bir fethi sevap (karşılık) olarak vermiştir.",
      "en": "Certainly was Allah pleased with the believers when they pledged allegiance to you, [O Muhammad], under the tree, and He knew what was in their hearts, so He sent down tranquillity upon them and rewarded them with an imminent conquest",
      "priority": 1,
      "surah_number": 48,
      "surah_name": "Fetih",
      "ayah_number": 18,
      "ayah_end_number": 18,
      "status": "pending_review"
    },
    {
      "id": "048/019",
      "kind": "ayah",
      "ref": "048/019",
      "ar": "وَمَغَانِمَ كَثِيرَةً يَأْخُذُونَهَا ۗ وَكَانَ ٱللَّهُ عَزِيزًا حَكِيمًا",
      "tr": "Ve alacakları birçok ganimetleri de. Allah, üstün ve güçlü olandır, hüküm ve hikmet sahibidir.",
      "en": "And much war booty which they will take. And ever is Allah Exalted in Might and Wise.",
      "priority": 1,
      "surah_number": 48,
      "surah_name": "Fetih",
      "ayah_number": 19,
      "ayah_end_number": 19,
      "status": "pending_review"
    },
    {
      "id": "048/026",
      "kind": "ayah",
      "ref": "048/026",
      "ar": "إِذْ جَعَلَ ٱلَّذِينَ كَفَرُوا۟ فِى قُلُوبِهِمُ ٱلْحَمِيَّةَ حَمِيَّةَ ٱلْجَـٰهِلِيَّةِ فَأَنزَلَ ٱللَّهُ سَكِينَتَهُۥ عَلَىٰ رَسُولِهِۦ وَعَلَى ٱلْمُؤْمِنِينَ وَأَلْزَمَهُمْ كَلِمَةَ ٱلتَّقْوَىٰ وَكَانُوٓا۟ أَحَقَّ بِهَا وَأَهْلَهَا ۚ وَكَانَ ٱللَّهُ بِكُلِّ شَىْءٍ عَلِيمًا",
      "tr": "Hani o inkar edenler, kendi kalplerinde, 'öfkeli soy koruyuculuğu'nu (hamiyeti), cahiliyenin 'öfkeli soy koruyuculuğunu' kılıp-kışkırttıkları zaman, hemen Allah; elçisinin ve mü'minlerin üzerine '(kalbi teskin eden) güven ve yatışma duygusunu' indirdi ve onları \"takva sözü\" üzerinde 'kararlılıkla ayakta tuttu.\" Zaten onlar da, buna layık ve ehil idiler. Allah, herşeyi hakkıyla bilendir.",
      "en": "When those who disbelieved had put into their hearts chauvinism - the chauvinism of the time of ignorance. But Allah sent down His tranquillity upon His Messenger and upon the believers and imposed upon them the word of righteousness, and they were more deserving of it and worthy of it. And ever is Allah, of all things, Knowing.",
      "priority": 1,
      "surah_number": 48,
      "surah_name": "Fetih",
      "ayah_number": 26,
      "ayah_end_number": 26,
      "status": "pending_review"
    },
    {
      "id": "048/018-019",
      "kind": "ayah",
      "ref": "048/018-019",
      "ar": "﴿18﴾ لَّقَدْ رَضِىَ ٱللَّهُ عَنِ ٱلْمُؤْمِنِينَ إِذْ يُبَايِعُونَكَ تَحْتَ ٱلشَّجَرَةِ فَعَلِمَ مَا فِى قُلُوبِهِمْ فَأَنزَلَ ٱلسَّكِينَةَ عَلَيْهِمْ وَأَثَـٰبَهُمْ فَتْحًا قَرِيبًا\n\n﴿19﴾ وَمَغَانِمَ كَثِيرَةً يَأْخُذُونَهَا ۗ وَكَانَ ٱللَّهُ عَزِيزًا حَكِيمًا",
      "tr": "[18] Andolsun, Allah, sana o ağacın altında biat ederlerken mü'minlerden razı olmuştur, kalplerinde olanı bilmiş ve böylece üzerlerine 'güven duygusu ve huzur' indirmiştir ve onlara yakın bir fethi sevap (karşılık) olarak vermiştir.\n\n[19] Ve alacakları birçok ganimetleri de. Allah, üstün ve güçlü olandır, hüküm ve hikmet sahibidir.",
      "en": "[18] Certainly was Allah pleased with the believers when they pledged allegiance to you, [O Muhammad], under the tree, and He knew what was in their hearts, so He sent down tranquillity upon them and rewarded them with an imminent conquest\n\n[19] And much war booty which they will take. And ever is Allah Exalted in Might and Wise.",
      "priority": 1,
      "surah_number": 48,
      "surah_name": "Fetih",
      "ayah_number": 18,
      "ayah_end_number": 19,
      "status": "pending_review"
    },
    {
      "id": "049/004",
      "kind": "ayah",
      "ref": "049/004",
      "ar": "إِنَّ ٱلَّذِينَ يُنَادُونَكَ مِن وَرَآءِ ٱلْحُجُرَٰتِ أَكْثَرُهُمْ لَا يَعْقِلُونَ",
      "tr": "Şüphesiz, hücrelerin ardından sana seslenenler de, onların çoğu aklını kullanmıyor.",
      "en": "Indeed, those who call you, [O Muhammad], from behind the chambers - most of them do not use reason.",
      "priority": 1,
      "surah_number": 49,
      "surah_name": "Hucurat",
      "ayah_number": 4,
      "ayah_end_number": 4,
      "status": "pending_review"
    },
    {
      "id": "049/005",
      "kind": "ayah",
      "ref": "049/005",
      "ar": "وَلَوْ أَنَّهُمْ صَبَرُوا۟ حَتَّىٰ تَخْرُجَ إِلَيْهِمْ لَكَانَ خَيْرًا لَّهُمْ ۚ وَٱللَّهُ غَفُورٌ رَّحِيمٌ",
      "tr": "Eğer gerçekten, yanlarına çıkıncaya kadar sabretmiş olsalardı, herhalde (bu,) kendileri için daha hayırlı olurdu. Allah, çok bağışlayandır, çok esirgeyendir.",
      "en": "And if they had been patient until you [could] come out to them, it would have been better for them. But Allah is Forgiving and Merciful.",
      "priority": 1,
      "surah_number": 49,
      "surah_name": "Hucurat",
      "ayah_number": 5,
      "ayah_end_number": 5,
      "status": "pending_review"
    },
    {
      "id": "049/006",
      "kind": "ayah",
      "ref": "049/006",
      "ar": "يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِن جَآءَكُمْ فَاسِقٌۢ بِنَبَإٍ فَتَبَيَّنُوٓا۟ أَن تُصِيبُوا۟ قَوْمًۢا بِجَهَـٰلَةٍ فَتُصْبِحُوا۟ عَلَىٰ مَا فَعَلْتُمْ نَـٰدِمِينَ",
      "tr": "Ey iman edenler, eğer bir fasık, size bir haber getirirse, onu 'etraflıca araştırın'. Yoksa cehalet sonucu, bir kavme kötülükte bulunursunuz da, sonra işlediklerinize pişman olursunuz.",
      "en": "O you who have believed, if there comes to you a disobedient one with information, investigate, lest you harm a people out of ignorance and become, over what you have done, regretful.",
      "priority": 1,
      "surah_number": 49,
      "surah_name": "Hucurat",
      "ayah_number": 6,
      "ayah_end_number": 6,
      "status": "pending_review"
    },
    {
      "id": "049/009",
      "kind": "ayah",
      "ref": "049/009",
      "ar": "وَإِن طَآئِفَتَانِ مِنَ ٱلْمُؤْمِنِينَ ٱقْتَتَلُوا۟ فَأَصْلِحُوا۟ بَيْنَهُمَا ۖ فَإِنۢ بَغَتْ إِحْدَىٰهُمَا عَلَى ٱلْأُخْرَىٰ فَقَـٰتِلُوا۟ ٱلَّتِى تَبْغِى حَتَّىٰ تَفِىٓءَ إِلَىٰٓ أَمْرِ ٱللَّهِ ۚ فَإِن فَآءَتْ فَأَصْلِحُوا۟ بَيْنَهُمَا بِٱلْعَدْلِ وَأَقْسِطُوٓا۟ ۖ إِنَّ ٱللَّهَ يُحِبُّ ٱلْمُقْسِطِينَ",
      "tr": "Mü'minlerden iki topluluk çarpışacak olursa, aralarını bulup-düzeltin. Şayet biri diğerine tecavüzde bulunacak olursa, artık tecavüzde bulunanla, Allah'ın emrine dönünceye kadar savaşın; eğer sonunda (Allah'ın emrini kabul edip) dönerse, bu durumda adaletle aralarını bulun ve (her konuda) adil davranın. Şüphesiz Allah, adil olanları sever.",
      "en": "And if two factions among the believers should fight, then make settlement between the two. But if one of them oppresses the other, then fight against the one that oppresses until it returns to the ordinance of Allah. And if it returns, then make settlement between them in justice and act justly. Indeed, Allah loves those who act justly.",
      "priority": 1,
      "surah_number": 49,
      "surah_name": "Hucurat",
      "ayah_number": 9,
      "ayah_end_number": 9,
      "status": "pending_review"
    },
    {
      "id": "049/004-006",
      "kind": "ayah",
      "ref": "049/004-006",
      "ar": "﴿4﴾ إِنَّ ٱلَّذِينَ يُنَادُونَكَ مِن وَرَآءِ ٱلْحُجُرَٰتِ أَكْثَرُهُمْ لَا يَعْقِلُونَ\n\n﴿5﴾ وَلَوْ أَنَّهُمْ صَبَرُوا۟ حَتَّىٰ تَخْرُجَ إِلَيْهِمْ لَكَانَ خَيْرًا لَّهُمْ ۚ وَٱللَّهُ غَفُورٌ رَّحِيمٌ\n\n﴿6﴾ يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِن جَآءَكُمْ فَاسِقٌۢ بِنَبَإٍ فَتَبَيَّنُوٓا۟ أَن تُصِيبُوا۟ قَوْمًۢا بِجَهَـٰلَةٍ فَتُصْبِحُوا۟ عَلَىٰ مَا فَعَلْتُمْ نَـٰدِمِينَ",
      "tr": "[4] Şüphesiz, hücrelerin ardından sana seslenenler de, onların çoğu aklını kullanmıyor.\n\n[5] Eğer gerçekten, yanlarına çıkıncaya kadar sabretmiş olsalardı, herhalde (bu,) kendileri için daha hayırlı olurdu. Allah, çok bağışlayandır, çok esirgeyendir.\n\n[6] Ey iman edenler, eğer bir fasık, size bir haber getirirse, onu 'etraflıca araştırın'. Yoksa cehalet sonucu, bir kavme kötülükte bulunursunuz da, sonra işlediklerinize pişman olursunuz.",
      "en": "[4] Indeed, those who call you, [O Muhammad], from behind the chambers - most of them do not use reason.\n\n[5] And if they had been patient until you [could] come out to them, it would have been better for them. But Allah is Forgiving and Merciful.\n\n[6] O you who have believed, if there comes to you a disobedient one with information, investigate, lest you harm a people out of ignorance and become, over what you have done, regretful.",
      "priority": 1,
      "surah_number": 49,
      "surah_name": "Hucurat",
      "ayah_number": 4,
      "ayah_end_number": 6,
      "status": "pending_review"
    },
    {
      "id": "049/010",
      "kind": "ayah",
      "ref": "049/010",
      "ar": "إِنَّمَا ٱلْمُؤْمِنُونَ إِخْوَةٌ فَأَصْلِحُوا۟ بَيْنَ أَخَوَيْكُمْ ۚ وَٱتَّقُوا۟ ٱللَّهَ لَعَلَّكُمْ تُرْحَمُونَ",
      "tr": "Mü'minler ancak kardeştirler. Öyleyse kardeşlerinizin arasını bulup-düzeltin ve Allah'tan korkup-sakının; umulur ki esirgenirsiniz.",
      "en": "The believers are but brothers, so make settlement between your brothers. And fear Allah that you may receive mercy.",
      "priority": 1,
      "surah_number": 49,
      "surah_name": "Hucurat",
      "ayah_number": 10,
      "ayah_end_number": 10,
      "status": "pending_review"
    },
    {
      "id": "049/011",
      "kind": "ayah",
      "ref": "049/011",
      "ar": "يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا يَسْخَرْ قَوْمٌ مِّن قَوْمٍ عَسَىٰٓ أَن يَكُونُوا۟ خَيْرًا مِّنْهُمْ وَلَا نِسَآءٌ مِّن نِّسَآءٍ عَسَىٰٓ أَن يَكُنَّ خَيْرًا مِّنْهُنَّ ۖ وَلَا تَلْمِزُوٓا۟ أَنفُسَكُمْ وَلَا تَنَابَزُوا۟ بِٱلْأَلْقَـٰبِ ۖ بِئْسَ ٱلِٱسْمُ ٱلْفُسُوقُ بَعْدَ ٱلْإِيمَـٰنِ ۚ وَمَن لَّمْ يَتُبْ فَأُو۟لَـٰٓئِكَ هُمُ ٱلظَّـٰلِمُونَ",
      "tr": "Ey iman edenler, bir kavim (bir başka) kavimle alay etmesin, belki kendilerinden daha hayırlıdırlar; kadınlar da kadınlarla (alay etmesin), belki kendilerinden daha hayırlıdırlar. Kendi nefislerinizi (kendi kendinizi) yadırgayıp-küçük düşürmeyin ve birbirinizi 'olmadık-kötü lakablarla' çağırmayın. İmandan sonra fasıklık ne kötü bir isimdir. Kim tevbe etmezse, işte onlar, zalim olanların ta kendileridir.",
      "en": "O you who have believed, let not a people ridicule [another] people; perhaps they may be better than them; nor let women ridicule [other] women; perhaps they may be better than them. And do not insult one another and do not call each other by [offensive] nicknames. Wretched is the name of disobedience after [one's] faith. And whoever does not repent - then it is those who are the wrongdoers.",
      "priority": 1,
      "surah_number": 49,
      "surah_name": "Hucurat",
      "ayah_number": 11,
      "ayah_end_number": 11,
      "status": "pending_review"
    },
    {
      "id": "049/012",
      "kind": "ayah",
      "ref": "049/012",
      "ar": "يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱجْتَنِبُوا۟ كَثِيرًا مِّنَ ٱلظَّنِّ إِنَّ بَعْضَ ٱلظَّنِّ إِثْمٌ ۖ وَلَا تَجَسَّسُوا۟ وَلَا يَغْتَب بَّعْضُكُم بَعْضًا ۚ أَيُحِبُّ أَحَدُكُمْ أَن يَأْكُلَ لَحْمَ أَخِيهِ مَيْتًا فَكَرِهْتُمُوهُ ۚ وَٱتَّقُوا۟ ٱللَّهَ ۚ إِنَّ ٱللَّهَ تَوَّابٌ رَّحِيمٌ",
      "tr": "Ey iman edenler, zandan çok kaçının; çünkü zannın bir kısmı günahtır. Tecessüs etmeyin (birbirinizin gizli yönlerini araştırmayın). Kiminiz kiminizin gıybetini yapmasın (arkasından çekiştirmesin.) Sizden biriniz, ölü kardeşinin etini yemeyi sever mi? İşte, bundan tiksindiniz. Allah'tan korkup-sakının. Şüphesiz Allah, tevbeleri kabul edendir, çok esirgeyendir.",
      "en": "O you who have believed, avoid much [negative] assumption. Indeed, some assumption is sin. And do not spy or backbite each other. Would one of you like to eat the flesh of his brother when dead? You would detest it. And fear Allah; indeed, Allah is Accepting of repentance and Merciful.",
      "priority": 1,
      "surah_number": 49,
      "surah_name": "Hucurat",
      "ayah_number": 12,
      "ayah_end_number": 12,
      "status": "pending_review"
    },
    {
      "id": "049/013",
      "kind": "ayah",
      "ref": "049/013",
      "ar": "يَـٰٓأَيُّهَا ٱلنَّاسُ إِنَّا خَلَقْنَـٰكُم مِّن ذَكَرٍ وَأُنثَىٰ وَجَعَلْنَـٰكُمْ شُعُوبًا وَقَبَآئِلَ لِتَعَارَفُوٓا۟ ۚ إِنَّ أَكْرَمَكُمْ عِندَ ٱللَّهِ أَتْقَىٰكُمْ ۚ إِنَّ ٱللَّهَ عَلِيمٌ خَبِيرٌ",
      "tr": "Ey insanlar, gerçekten, Biz sizi bir erkek ve bir dişiden yarattık ve birbirinizle tanışmanız için sizi halklar ve kabileler (şeklinde) kıldık. Şüphesiz, Allah Katında sizin en üstün (kerim) olanınız, (ırk ya da soyca değil) takvaca en ileride olanınızdır. Şüphesiz Allah, bilendir, haber alandır.",
      "en": "O mankind, indeed We have created you from male and female and made you peoples and tribes that you may know one another. Indeed, the most noble of you in the sight of Allah is the most righteous of you. Indeed, Allah is Knowing and Acquainted.",
      "priority": 1,
      "surah_number": 49,
      "surah_name": "Hucurat",
      "ayah_number": 13,
      "ayah_end_number": 13,
      "status": "pending_review"
    },
    {
      "id": "049/015",
      "kind": "ayah",
      "ref": "049/015",
      "ar": "إِنَّمَا ٱلْمُؤْمِنُونَ ٱلَّذِينَ ءَامَنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ ثُمَّ لَمْ يَرْتَابُوا۟ وَجَـٰهَدُوا۟ بِأَمْوَٰلِهِمْ وَأَنفُسِهِمْ فِى سَبِيلِ ٱللَّهِ ۚ أُو۟لَـٰٓئِكَ هُمُ ٱلصَّـٰدِقُونَ",
      "tr": "Mü'min olanlar, ancak o kimselerdir ki, onlar, Allah'a ve Resûlü’ne iman ettiler, sonra hiçbir kuşkuya kapılmadan Allah yolunda mallarıyla ve canlarıyla mücadele ettiler. İşte onlar, sadık (doğru) olanların ta kendileridir.",
      "en": "The believers are only the ones who have believed in Allah and His Messenger and then doubt not but strive with their properties and their lives in the cause of Allah. It is those who are the truthful.",
      "priority": 1,
      "surah_number": 49,
      "surah_name": "Hucurat",
      "ayah_number": 15,
      "ayah_end_number": 15,
      "status": "pending_review"
    },
    {
      "id": "050/017",
      "kind": "ayah",
      "ref": "050/017",
      "ar": "إِذْ يَتَلَقَّى ٱلْمُتَلَقِّيَانِ عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ قَعِيدٌ",
      "tr": "Onun sağında ve solunda oturan iki yazıcı kaydederlerken",
      "en": "When the two receivers receive, seated on the right and on the left.",
      "priority": 1,
      "surah_number": 50,
      "surah_name": "Kaf",
      "ayah_number": 17,
      "ayah_end_number": 17,
      "status": "pending_review"
    },
    {
      "id": "050/018",
      "kind": "ayah",
      "ref": "050/018",
      "ar": "مَّا يَلْفِظُ مِن قَوْلٍ إِلَّا لَدَيْهِ رَقِيبٌ عَتِيدٌ",
      "tr": "O, söz olarak (herhangi bir şey) söylemeyiversin, mutlaka yanında hazır bir gözetleyici vardır.",
      "en": "Man does not utter any word except that with him is an observer prepared [to record].",
      "priority": 1,
      "surah_number": 50,
      "surah_name": "Kaf",
      "ayah_number": 18,
      "ayah_end_number": 18,
      "status": "pending_review"
    },
    {
      "id": "050/027",
      "kind": "ayah",
      "ref": "050/027",
      "ar": "قَالَ قَرِينُهُۥ رَبَّنَا مَآ أَطْغَيْتُهُۥ وَلَـٰكِن كَانَ فِى ضَلَـٰلٍۭ بَعِيدٍ",
      "tr": "Onun yakın-dostu (saptırıcı) dedi ki: \"Rabbimiz, ben onu kışkırtıp-azdırdım. Ancak kendisi (haktan) uzak bir sapıklık içindeydi.\"",
      "en": "His [devil] companion will say, \"Our Lord, I did not make him transgress, but he [himself] was in extreme error.\"",
      "priority": 1,
      "surah_number": 50,
      "surah_name": "Kaf",
      "ayah_number": 27,
      "ayah_end_number": 27,
      "status": "pending_review"
    },
    {
      "id": "050/017-018",
      "kind": "ayah",
      "ref": "050/017-018",
      "ar": "﴿17﴾ إِذْ يَتَلَقَّى ٱلْمُتَلَقِّيَانِ عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ قَعِيدٌ\n\n﴿18﴾ مَّا يَلْفِظُ مِن قَوْلٍ إِلَّا لَدَيْهِ رَقِيبٌ عَتِيدٌ",
      "tr": "[17] Onun sağında ve solunda oturan iki yazıcı kaydederlerken\n\n[18] O, söz olarak (herhangi bir şey) söylemeyiversin, mutlaka yanında hazır bir gözetleyici vardır.",
      "en": "[17] When the two receivers receive, seated on the right and on the left.\n\n[18] Man does not utter any word except that with him is an observer prepared [to record].",
      "priority": 1,
      "surah_number": 50,
      "surah_name": "Kaf",
      "ayah_number": 17,
      "ayah_end_number": 18,
      "status": "pending_review"
    },
    {
      "id": "050/031",
      "kind": "ayah",
      "ref": "050/031",
      "ar": "وَأُزْلِفَتِ ٱلْجَنَّةُ لِلْمُتَّقِينَ غَيْرَ بَعِيدٍ",
      "tr": "Cennet de, muttakiler için, uzakta değildir, (o gün) yakınlaştırılmıştır.",
      "en": "And Paradise will be brought near to the righteous, not far,",
      "priority": 1,
      "surah_number": 50,
      "surah_name": "Kaf",
      "ayah_number": 31,
      "ayah_end_number": 31,
      "status": "pending_review"
    },
    {
      "id": "050/038",
      "kind": "ayah",
      "ref": "050/038",
      "ar": "وَلَقَدْ خَلَقْنَا ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَا فِى سِتَّةِ أَيَّامٍ وَمَا مَسَّنَا مِن لُّغُوبٍ",
      "tr": "Andolsun, Biz gökleri, yeri ve ikisi arasında bulunanları altı günde yarattık; Bize hiçbir yorgunluk dokunmadı.",
      "en": "And We did certainly create the heavens and earth and what is between them in six days, and there touched Us no weariness.",
      "priority": 1,
      "surah_number": 50,
      "surah_name": "Kaf",
      "ayah_number": 38,
      "ayah_end_number": 38,
      "status": "pending_review"
    },
    {
      "id": "050/041",
      "kind": "ayah",
      "ref": "050/041",
      "ar": "وَٱسْتَمِعْ يَوْمَ يُنَادِ ٱلْمُنَادِ مِن مَّكَانٍ قَرِيبٍ",
      "tr": "Çağırıcının, yakın bir yerden çağrıda bulunacağı güne kulak ver;",
      "en": "And listen on the Day when the Caller will call out from a place that is near -",
      "priority": 1,
      "surah_number": 50,
      "surah_name": "Kaf",
      "ayah_number": 41,
      "ayah_end_number": 41,
      "status": "pending_review"
    },
    {
      "id": "050/042",
      "kind": "ayah",
      "ref": "050/042",
      "ar": "يَوْمَ يَسْمَعُونَ ٱلصَّيْحَةَ بِٱلْحَقِّ ۚ ذَٰلِكَ يَوْمُ ٱلْخُرُوجِ",
      "tr": "O gün, o çığlığı bir gerçek (hak) olarak işitirler. İşte bu, (dirilip kabirlerden) çıkış günüdür.",
      "en": "The Day they will hear the blast [of the Horn] in truth. That is the Day of Emergence [from the graves].",
      "priority": 1,
      "surah_number": 50,
      "surah_name": "Kaf",
      "ayah_number": 42,
      "ayah_end_number": 42,
      "status": "pending_review"
    },
    {
      "id": "050/024",
      "kind": "ayah",
      "ref": "050/024",
      "ar": "أَلْقِيَا فِى جَهَنَّمَ كُلَّ كَفَّارٍ عَنِيدٍ",
      "tr": "Siz ikiniz (ey melekler), her inatçı nankörü atın cehennemin içine,",
      "en": "[Allah will say], \"Throw into Hell every obstinate disbeliever,",
      "priority": 1,
      "surah_number": 50,
      "surah_name": "Kaf",
      "ayah_number": 24,
      "ayah_end_number": 24,
      "status": "pending_review"
    },
    {
      "id": "050/041-042",
      "kind": "ayah",
      "ref": "050/041-042",
      "ar": "﴿41﴾ وَٱسْتَمِعْ يَوْمَ يُنَادِ ٱلْمُنَادِ مِن مَّكَانٍ قَرِيبٍ\n\n﴿42﴾ يَوْمَ يَسْمَعُونَ ٱلصَّيْحَةَ بِٱلْحَقِّ ۚ ذَٰلِكَ يَوْمُ ٱلْخُرُوجِ",
      "tr": "[41] Çağırıcının, yakın bir yerden çağrıda bulunacağı güne kulak ver;\n\n[42] O gün, o çığlığı bir gerçek (hak) olarak işitirler. İşte bu, (dirilip kabirlerden) çıkış günüdür.",
      "en": "[41] And listen on the Day when the Caller will call out from a place that is near -\n\n[42] The Day they will hear the blast [of the Horn] in truth. That is the Day of Emergence [from the graves].",
      "priority": 1,
      "surah_number": 50,
      "surah_name": "Kaf",
      "ayah_number": 41,
      "ayah_end_number": 42,
      "status": "pending_review"
    },
    {
      "id": "051/006",
      "kind": "ayah",
      "ref": "051/006",
      "ar": "وَإِنَّ ٱلدِّينَ لَوَٰقِعٌ",
      "tr": "Şüphesiz din (hesap ve ceza) da mutlaka gerçekleşecektir.",
      "en": "And indeed, the recompense is to occur.",
      "priority": 1,
      "surah_number": 51,
      "surah_name": "Zariyat",
      "ayah_number": 6,
      "ayah_end_number": 6,
      "status": "pending_review"
    },
    {
      "id": "051/011",
      "kind": "ayah",
      "ref": "051/011",
      "ar": "ٱلَّذِينَ هُمْ فِى غَمْرَةٍ سَاهُونَ",
      "tr": "Ki onlar, 'bilgisizliğin kuşatması' içinde habersizdirler.",
      "en": "Who are within a flood [of confusion] and heedless.",
      "priority": 1,
      "surah_number": 51,
      "surah_name": "Zariyat",
      "ayah_number": 11,
      "ayah_end_number": 11,
      "status": "pending_review"
    },
    {
      "id": "051/015",
      "kind": "ayah",
      "ref": "051/015",
      "ar": "إِنَّ ٱلْمُتَّقِينَ فِى جَنَّـٰتٍ وَعُيُونٍ",
      "tr": "Şüphesiz muttaki olanlar, cennetlerde ve pınarlardadırlar;",
      "en": "Indeed, the righteous will be among gardens and springs,",
      "priority": 1,
      "surah_number": 51,
      "surah_name": "Zariyat",
      "ayah_number": 15,
      "ayah_end_number": 15,
      "status": "pending_review"
    },
    {
      "id": "051/047",
      "kind": "ayah",
      "ref": "051/047",
      "ar": "وَٱلسَّمَآءَ بَنَيْنَـٰهَا بِأَيْي۟دٍ وَإِنَّا لَمُوسِعُونَ",
      "tr": "Biz göğü 'büyük bir kudretle' bina ettik ve şüphesiz Biz, (onu) genişleticiyiz.",
      "en": "And the heaven We constructed with strength, and indeed, We are [its] expander.",
      "priority": 1,
      "surah_number": 51,
      "surah_name": "Zariyat",
      "ayah_number": 47,
      "ayah_end_number": 47,
      "status": "pending_review"
    },
    {
      "id": "051/048",
      "kind": "ayah",
      "ref": "051/048",
      "ar": "وَٱلْأَرْضَ فَرَشْنَـٰهَا فَنِعْمَ ٱلْمَـٰهِدُونَ",
      "tr": "Yeri de Biz döşeyip-yaydık; ne güzel döşeyici(yiz).",
      "en": "And the earth We have spread out, and excellent is the preparer.",
      "priority": 1,
      "surah_number": 51,
      "surah_name": "Zariyat",
      "ayah_number": 48,
      "ayah_end_number": 48,
      "status": "pending_review"
    },
    {
      "id": "051/049",
      "kind": "ayah",
      "ref": "051/049",
      "ar": "وَمِن كُلِّ شَىْءٍ خَلَقْنَا زَوْجَيْنِ لَعَلَّكُمْ تَذَكَّرُونَ",
      "tr": "Ve Biz, herşeyi iki çift yarattık. Umulur ki, öğüt alıp-düşünürsünüz.",
      "en": "And of all things We created two mates; perhaps you will remember.",
      "priority": 1,
      "surah_number": 51,
      "surah_name": "Zariyat",
      "ayah_number": 49,
      "ayah_end_number": 49,
      "status": "pending_review"
    },
    {
      "id": "052/010",
      "kind": "ayah",
      "ref": "052/010",
      "ar": "وَتَسِيرُ ٱلْجِبَالُ سَيْرًا",
      "tr": "Ve dağlar (yerlerinden oynatan) bir yürüyüşle yürür.",
      "en": "And the mountains will pass on, departing -",
      "priority": 1,
      "surah_number": 52,
      "surah_name": "Tur",
      "ayah_number": 10,
      "ayah_end_number": 10,
      "status": "pending_review"
    },
    {
      "id": "052/012",
      "kind": "ayah",
      "ref": "052/012",
      "ar": "ٱلَّذِينَ هُمْ فِى خَوْضٍ يَلْعَبُونَ",
      "tr": "Ki onlar, 'daldıkları saçma bir uğraşı' içinde oynayan-oyalananlardır.",
      "en": "Who are in [empty] discourse amusing themselves.",
      "priority": 1,
      "surah_number": 52,
      "surah_name": "Tur",
      "ayah_number": 12,
      "ayah_end_number": 12,
      "status": "pending_review"
    },
    {
      "id": "052/015",
      "kind": "ayah",
      "ref": "052/015",
      "ar": "أَفَسِحْرٌ هَـٰذَآ أَمْ أَنتُمْ لَا تُبْصِرُونَ",
      "tr": "\"Bu da bir büyü mü, yoksa siz mi görmüyorsunuz.\"",
      "en": "Then is this magic, or do you not see?",
      "priority": 1,
      "surah_number": 52,
      "surah_name": "Tur",
      "ayah_number": 15,
      "ayah_end_number": 15,
      "status": "pending_review"
    },
    {
      "id": "052/016",
      "kind": "ayah",
      "ref": "052/016",
      "ar": "ٱصْلَوْهَا فَٱصْبِرُوٓا۟ أَوْ لَا تَصْبِرُوا۟ سَوَآءٌ عَلَيْكُمْ ۖ إِنَّمَا تُجْزَوْنَ مَا كُنتُمْ تَعْمَلُونَ",
      "tr": "\"Girin ona; artık ister sabredin, ister sabretmeyin. Sizin için birdir. Siz ancak, yaptıklarınızla cezalandırılıyorsunuz.\"",
      "en": "[Enter to] burn therein; then be patient or impatient - it is all the same for you. You are only being recompensed [for] what you used to do.\"",
      "priority": 1,
      "surah_number": 52,
      "surah_name": "Tur",
      "ayah_number": 16,
      "ayah_end_number": 16,
      "status": "pending_review"
    },
    {
      "id": "052/017",
      "kind": "ayah",
      "ref": "052/017",
      "ar": "إِنَّ ٱلْمُتَّقِينَ فِى جَنَّـٰتٍ وَنَعِيمٍ",
      "tr": "Hiç şüphesiz muttakiler, cennetlerde ve nimet içindedirler;",
      "en": "Indeed, the righteous will be in gardens and pleasure,",
      "priority": 1,
      "surah_number": 52,
      "surah_name": "Tur",
      "ayah_number": 17,
      "ayah_end_number": 17,
      "status": "pending_review"
    },
    {
      "id": "052/023",
      "kind": "ayah",
      "ref": "052/023",
      "ar": "يَتَنَـٰزَعُونَ فِيهَا كَأْسًا لَّا لَغْوٌ فِيهَا وَلَا تَأْثِيمٌ",
      "tr": "Orada bir kadeh kapışır-çekişirler ki, onda ne 'boş ve saçma bir söz', ne günaha sokma yoktur.",
      "en": "They will exchange with one another a cup [of wine] wherein [results] no ill speech or commission of sin.",
      "priority": 1,
      "surah_number": 52,
      "surah_name": "Tur",
      "ayah_number": 23,
      "ayah_end_number": 23,
      "status": "pending_review"
    },
    {
      "id": "052/015-017",
      "kind": "ayah",
      "ref": "052/015-017",
      "ar": "﴿15﴾ أَفَسِحْرٌ هَـٰذَآ أَمْ أَنتُمْ لَا تُبْصِرُونَ\n\n﴿16﴾ ٱصْلَوْهَا فَٱصْبِرُوٓا۟ أَوْ لَا تَصْبِرُوا۟ سَوَآءٌ عَلَيْكُمْ ۖ إِنَّمَا تُجْزَوْنَ مَا كُنتُمْ تَعْمَلُونَ\n\n﴿17﴾ إِنَّ ٱلْمُتَّقِينَ فِى جَنَّـٰتٍ وَنَعِيمٍ",
      "tr": "[15] \"Bu da bir büyü mü, yoksa siz mi görmüyorsunuz.\"\n\n[16] \"Girin ona; artık ister sabredin, ister sabretmeyin. Sizin için birdir. Siz ancak, yaptıklarınızla cezalandırılıyorsunuz.\"\n\n[17] Hiç şüphesiz muttakiler, cennetlerde ve nimet içindedirler;",
      "en": "[15] Then is this magic, or do you not see?\n\n[16] [Enter to] burn therein; then be patient or impatient - it is all the same for you. You are only being recompensed [for] what you used to do.\"\n\n[17] Indeed, the righteous will be in gardens and pleasure,",
      "priority": 1,
      "surah_number": 52,
      "surah_name": "Tur",
      "ayah_number": 15,
      "ayah_end_number": 17,
      "status": "pending_review"
    },
    {
      "id": "052/029",
      "kind": "ayah",
      "ref": "052/029",
      "ar": "فَذَكِّرْ فَمَآ أَنتَ بِنِعْمَتِ رَبِّكَ بِكَاهِنٍ وَلَا مَجْنُونٍ",
      "tr": "Şu halde sen, öğüt verip-hatırlat; çünkü sen, Rabbinin nimetiyle ne kahinsin, ne mecnun.",
      "en": "So remind [O Muhammad], for you are not, by the favor of your Lord, a soothsayer or a madman.",
      "priority": 1,
      "surah_number": 52,
      "surah_name": "Tur",
      "ayah_number": 29,
      "ayah_end_number": 29,
      "status": "pending_review"
    },
    {
      "id": "053/023",
      "kind": "ayah",
      "ref": "053/023",
      "ar": "إِنْ هِىَ إِلَّآ أَسْمَآءٌ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلْطَـٰنٍ ۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهْوَى ٱلْأَنفُسُ ۖ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ ٱلْهُدَىٰٓ",
      "tr": "Bu (putlar ise,) sizin ve atalarınızın (kendi istek ve öngörünüze göre) isimlendirdiğiniz (keyfi) isimlerden başkası değildir. Allah, onlarla ilgili 'hiçbir delil' indirmemiştir. Onlar, yalnızca zanna ve nefislerinin (alçak) heva (istek ve tutku) olarak arzu ettiklerine uyuyorlar. Oysa andolsun, onlara Rablerinden yol gösterici gelmiştir.",
      "en": "They are not but [mere] names you have named them - you and your forefathers - for which Allah has sent down no authority. They follow not except assumption and what [their] souls desire, and there has already come to them from their Lord guidance.",
      "priority": 1,
      "surah_number": 53,
      "surah_name": "Necm",
      "ayah_number": 23,
      "ayah_end_number": 23,
      "status": "pending_review"
    },
    {
      "id": "053/026",
      "kind": "ayah",
      "ref": "053/026",
      "ar": "وَكَم مِّن مَّلَكٍ فِى ٱلسَّمَـٰوَٰتِ لَا تُغْنِى شَفَـٰعَتُهُمْ شَيْـًٔا إِلَّا مِنۢ بَعْدِ أَن يَأْذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرْضَىٰٓ",
      "tr": "Göklerde nice melekler vardır ki, onların şefaatleri hiçbir şeyle yarar sağlamaz; ancak Allah'ın dileyip razı olduğu kimseye izin verdikten sonra başka.",
      "en": "And how many angels there are in the heavens whose intercession will not avail at all except [only] after Allah has permitted [it] to whom He wills and approves.",
      "priority": 1,
      "surah_number": 53,
      "surah_name": "Necm",
      "ayah_number": 26,
      "ayah_end_number": 26,
      "status": "pending_review"
    },
    {
      "id": "053/028",
      "kind": "ayah",
      "ref": "053/028",
      "ar": "وَمَا لَهُم بِهِۦ مِنْ عِلْمٍ ۖ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ ۖ وَإِنَّ ٱلظَّنَّ لَا يُغْنِى مِنَ ٱلْحَقِّ شَيْـًٔا",
      "tr": "Oysa onların bununla ilgili hiçbir bilgileri yoktur. Onlar, yalnızca zanna uymaktadırlar. Oysa gerçekte zan, haktan yana hiçbir yarar sağlamaz.",
      "en": "And they have thereof no knowledge. They follow not except assumption, and indeed, assumption avails not against the truth at all.",
      "priority": 1,
      "surah_number": 53,
      "surah_name": "Necm",
      "ayah_number": 28,
      "ayah_end_number": 28,
      "status": "pending_review"
    },
    {
      "id": "053/031",
      "kind": "ayah",
      "ref": "053/031",
      "ar": "وَلِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ لِيَجْزِىَ ٱلَّذِينَ أَسَـٰٓـُٔوا۟ بِمَا عَمِلُوا۟ وَيَجْزِىَ ٱلَّذِينَ أَحْسَنُوا۟ بِٱلْحُسْنَى",
      "tr": "Göklerde ve yerde olanlar Allah'ındır; öyle ki, kötülükte bulunanları, yaptıkları dolayısıyla cezalandırır, güzel davranışta bulunanları da daha güzeliyle ödüllendirir.",
      "en": "And to Allah belongs whatever is in the heavens and whatever is in the earth - that He may recompense those who do evil with [the penalty of] what they have done and recompense those who do good with the best [reward] -",
      "priority": 1,
      "surah_number": 53,
      "surah_name": "Necm",
      "ayah_number": 31,
      "ayah_end_number": 31,
      "status": "pending_review"
    },
    {
      "id": "053/032",
      "kind": "ayah",
      "ref": "053/032",
      "ar": "ٱلَّذِينَ يَجْتَنِبُونَ كَبَـٰٓئِرَ ٱلْإِثْمِ وَٱلْفَوَٰحِشَ إِلَّا ٱللَّمَمَ ۚ إِنَّ رَبَّكَ وَٰسِعُ ٱلْمَغْفِرَةِ ۚ هُوَ أَعْلَمُ بِكُمْ إِذْ أَنشَأَكُم مِّنَ ٱلْأَرْضِ وَإِذْ أَنتُمْ أَجِنَّةٌ فِى بُطُونِ أُمَّهَـٰتِكُمْ ۖ فَلَا تُزَكُّوٓا۟ أَنفُسَكُمْ ۖ هُوَ أَعْلَمُ بِمَنِ ٱتَّقَىٰٓ",
      "tr": "Ki onlar, ufak tefek günahlar dışında, günahın büyük olanından ve çirkin utanmazlıklardan kaçınırlar. Şüphesiz senin Rabbin, mağfireti geniş olandır. O, sizi daha iyi bilendir; hem sizi topraktan inşa ettiği (yarattığı) ve siz daha annelerinizin karnında cenin halinde bulunduğunuz zaman da. Öyleyse kendinizi temize çıkarıp-durmayın. O, sakınanı daha iyi bilendir.",
      "en": "Those who avoid the major sins and immoralities, only [committing] slight ones. Indeed, your Lord is vast in forgiveness. He was most knowing of you when He produced you from the earth and when you were fetuses in the wombs of your mothers. So do not claim yourselves to be pure; He is most knowing of who fears Him.",
      "priority": 1,
      "surah_number": 53,
      "surah_name": "Necm",
      "ayah_number": 32,
      "ayah_end_number": 32,
      "status": "pending_review"
    },
    {
      "id": "053/050",
      "kind": "ayah",
      "ref": "053/050",
      "ar": "وَأَنَّهُۥٓ أَهْلَكَ عَادًا ٱلْأُولَىٰ",
      "tr": "Doğrusu, önce gelen Ad (halkın)ı O yıkıma uğrattı.",
      "en": "And that He destroyed the first [people of] 'Aad",
      "priority": 1,
      "surah_number": 53,
      "surah_name": "Necm",
      "ayah_number": 50,
      "ayah_end_number": 50,
      "status": "pending_review"
    },
    {
      "id": "053/051",
      "kind": "ayah",
      "ref": "053/051",
      "ar": "وَثَمُودَا۟ فَمَآ أَبْقَىٰ",
      "tr": "Semud'u da. Böylelikle (o halklardan kimseyi) bırakmadı.",
      "en": "And Thamud - and He did not spare [them] -",
      "priority": 1,
      "surah_number": 53,
      "surah_name": "Necm",
      "ayah_number": 51,
      "ayah_end_number": 51,
      "status": "pending_review"
    },
    {
      "id": "053/052",
      "kind": "ayah",
      "ref": "053/052",
      "ar": "وَقَوْمَ نُوحٍ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا۟ هُمْ أَظْلَمَ وَأَطْغَىٰ",
      "tr": "Daha önce Nuh kavmini de. Çünkü onlar, daha zalim ve daha azgındılar.",
      "en": "And the people of Noah before. Indeed, it was they who were [even] more unjust and oppressing.",
      "priority": 1,
      "surah_number": 53,
      "surah_name": "Necm",
      "ayah_number": 52,
      "ayah_end_number": 52,
      "status": "pending_review"
    },
    {
      "id": "054/001",
      "kind": "ayah",
      "ref": "054/001",
      "ar": "\\basmalah ٱقْتَرَبَتِ ٱلسَّاعَةُ وَٱنشَقَّ ٱلْقَمَرُ",
      "tr": "Saat (kıyamet vakti) yakınlaştı ve ay yarıldı.",
      "en": "The Hour has come near, and the moon has split [in two].",
      "priority": 1,
      "surah_number": 54,
      "surah_name": "Kamer",
      "ayah_number": 1,
      "ayah_end_number": 1,
      "status": "pending_review"
    },
    {
      "id": "054/002",
      "kind": "ayah",
      "ref": "054/002",
      "ar": "وَإِن يَرَوْا۟ ءَايَةً يُعْرِضُوا۟ وَيَقُولُوا۟ سِحْرٌ مُّسْتَمِرٌّ",
      "tr": "Onlar bir ayet (mucize) görseler, sırt çevirirler ve: \"(Bu,) Süregelen bir büyüdür\" derler.",
      "en": "And if they see a miracle, they turn away and say, \"Passing magic.\"",
      "priority": 1,
      "surah_number": 54,
      "surah_name": "Kamer",
      "ayah_number": 2,
      "ayah_end_number": 2,
      "status": "pending_review"
    },
    {
      "id": "054/049",
      "kind": "ayah",
      "ref": "054/049",
      "ar": "إِنَّا كُلَّ شَىْءٍ خَلَقْنَـٰهُ بِقَدَرٍ",
      "tr": "Hiç şüphesiz, Biz herşeyi kader ile yarattık.",
      "en": "Indeed, all things We created with predestination.",
      "priority": 1,
      "surah_number": 54,
      "surah_name": "Kamer",
      "ayah_number": 49,
      "ayah_end_number": 49,
      "status": "pending_review"
    },
    {
      "id": "054/001-002",
      "kind": "ayah",
      "ref": "054/001-002",
      "ar": "﴿1﴾ \\basmalah ٱقْتَرَبَتِ ٱلسَّاعَةُ وَٱنشَقَّ ٱلْقَمَرُ\n\n﴿2﴾ وَإِن يَرَوْا۟ ءَايَةً يُعْرِضُوا۟ وَيَقُولُوا۟ سِحْرٌ مُّسْتَمِرٌّ",
      "tr": "[1] Saat (kıyamet vakti) yakınlaştı ve ay yarıldı.\n\n[2] Onlar bir ayet (mucize) görseler, sırt çevirirler ve: \"(Bu,) Süregelen bir büyüdür\" derler.",
      "en": "[1] The Hour has come near, and the moon has split [in two].\n\n[2] And if they see a miracle, they turn away and say, \"Passing magic.\"",
      "priority": 1,
      "surah_number": 54,
      "surah_name": "Kamer",
      "ayah_number": 1,
      "ayah_end_number": 2,
      "status": "pending_review"
    },
    {
      "id": "055/005",
      "kind": "ayah",
      "ref": "055/005",
      "ar": "ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍ",
      "tr": "Güneş ve ay (belli) bir hesap iledir.",
      "en": "The sun and the moon [move] by precise calculation,",
      "priority": 1,
      "surah_number": 55,
      "surah_name": "Rahman",
      "ayah_number": 5,
      "ayah_end_number": 5,
      "status": "pending_review"
    },
    {
      "id": "055/006",
      "kind": "ayah",
      "ref": "055/006",
      "ar": "وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ",
      "tr": "Bitki ve ağaç (O'na) secde etmektedirler.",
      "en": "And the stars and trees prostrate.",
      "priority": 1,
      "surah_number": 55,
      "surah_name": "Rahman",
      "ayah_number": 6,
      "ayah_end_number": 6,
      "status": "pending_review"
    },
    {
      "id": "055/008",
      "kind": "ayah",
      "ref": "055/008",
      "ar": "أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ",
      "tr": "Sakın mizanda 'haksızlık ve taşkınlık yapmayın.'",
      "en": "That you not transgress within the balance.",
      "priority": 1,
      "surah_number": 55,
      "surah_name": "Rahman",
      "ayah_number": 8,
      "ayah_end_number": 8,
      "status": "pending_review"
    },
    {
      "id": "055/005-006",
      "kind": "ayah",
      "ref": "055/005-006",
      "ar": "﴿5﴾ ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍ\n\n﴿6﴾ وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ",
      "tr": "[5] Güneş ve ay (belli) bir hesap iledir.\n\n[6] Bitki ve ağaç (O'na) secde etmektedirler.",
      "en": "[5] The sun and the moon [move] by precise calculation,\n\n[6] And the stars and trees prostrate.",
      "priority": 1,
      "surah_number": 55,
      "surah_name": "Rahman",
      "ayah_number": 5,
      "ayah_end_number": 6,
      "status": "pending_review"
    },
    {
      "id": "055/009",
      "kind": "ayah",
      "ref": "055/009",
      "ar": "وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ",
      "tr": "Tartıyı adaletle tutup-doğrultun ve tartıyı noksan tutmayın.",
      "en": "And establish weight in justice and do not make deficient the balance.",
      "priority": 1,
      "surah_number": 55,
      "surah_name": "Rahman",
      "ayah_number": 9,
      "ayah_end_number": 9,
      "status": "pending_review"
    },
    {
      "id": "056/001",
      "kind": "ayah",
      "ref": "056/001",
      "ar": "\\basmalah إِذَا وَقَعَتِ ٱلْوَاقِعَةُ",
      "tr": "Vakıa (kesin bir gerçek olan kıyamet) vuku bulduğu zaman,",
      "en": "When the Occurrence occurs,",
      "priority": 1,
      "surah_number": 56,
      "surah_name": "Vakia",
      "ayah_number": 1,
      "ayah_end_number": 1,
      "status": "pending_review"
    },
    {
      "id": "056/002",
      "kind": "ayah",
      "ref": "056/002",
      "ar": "لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ",
      "tr": "Onun vukuuna (gerçekleşmesine artık) yalan diyecek yoktur.",
      "en": "There is, at its occurrence, no denial.",
      "priority": 1,
      "surah_number": 56,
      "surah_name": "Vakia",
      "ayah_number": 2,
      "ayah_end_number": 2,
      "status": "pending_review"
    },
    {
      "id": "056/003",
      "kind": "ayah",
      "ref": "056/003",
      "ar": "خَافِضَةٌ رَّافِعَةٌ",
      "tr": "O aşağılatıcı, yücelticidir.",
      "en": "It will bring down [some] and raise up [others].",
      "priority": 1,
      "surah_number": 56,
      "surah_name": "Vakia",
      "ayah_number": 3,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "056/005",
      "kind": "ayah",
      "ref": "056/005",
      "ar": "وَبُسَّتِ ٱلْجِبَالُ بَسًّا",
      "tr": "Ve dağlar darmadağın olup ufalandığı,",
      "en": "And the mountains are broken down, crumbling",
      "priority": 1,
      "surah_number": 56,
      "surah_name": "Vakia",
      "ayah_number": 5,
      "ayah_end_number": 5,
      "status": "pending_review"
    },
    {
      "id": "056/001-003",
      "kind": "ayah",
      "ref": "056/001-003",
      "ar": "﴿1﴾ \\basmalah إِذَا وَقَعَتِ ٱلْوَاقِعَةُ\n\n﴿2﴾ لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ\n\n﴿3﴾ خَافِضَةٌ رَّافِعَةٌ",
      "tr": "[1] Vakıa (kesin bir gerçek olan kıyamet) vuku bulduğu zaman,\n\n[2] Onun vukuuna (gerçekleşmesine artık) yalan diyecek yoktur.\n\n[3] O aşağılatıcı, yücelticidir.",
      "en": "[1] When the Occurrence occurs,\n\n[2] There is, at its occurrence, no denial.\n\n[3] It will bring down [some] and raise up [others].",
      "priority": 1,
      "surah_number": 56,
      "surah_name": "Vakia",
      "ayah_number": 1,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "056/018",
      "kind": "ayah",
      "ref": "056/018",
      "ar": "بِأَكْوَابٍ وَأَبَارِيقَ وَكَأْسٍ مِّن مَّعِينٍ",
      "tr": "Kaynağından (doldurulmuş) testiler, ibrikler ve kadehler,",
      "en": "With vessels, pitchers and a cup [of wine] from a flowing spring -",
      "priority": 1,
      "surah_number": 56,
      "surah_name": "Vakia",
      "ayah_number": 18,
      "ayah_end_number": 18,
      "status": "pending_review"
    },
    {
      "id": "056/056",
      "kind": "ayah",
      "ref": "056/056",
      "ar": "هَـٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ",
      "tr": "İşte bu, onların din (hesap ve ceza) gününde şölenleridir.",
      "en": "That is their accommodation on the Day of Recompense.",
      "priority": 1,
      "surah_number": 56,
      "surah_name": "Vakia",
      "ayah_number": 56,
      "ayah_end_number": 56,
      "status": "pending_review"
    },
    {
      "id": "057/007",
      "kind": "ayah",
      "ref": "057/007",
      "ar": "ءَامِنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ وَأَنفِقُوا۟ مِمَّا جَعَلَكُم مُّسْتَخْلَفِينَ فِيهِ ۖ فَٱلَّذِينَ ءَامَنُوا۟ مِنكُمْ وَأَنفَقُوا۟ لَهُمْ أَجْرٌ كَبِيرٌ",
      "tr": "Allah'a ve Resûlü’ne iman edin. \"Sizi kendilerinde halifeler kılıp harcama yetkisi verdiği' şeylerden infak edin. Artık sizden kim iman edip infak ederse, onlara büyük bir ecir vardır.",
      "en": "Believe in Allah and His Messenger and spend out of that in which He has made you successors. For those who have believed among you and spent, there will be a great reward.",
      "priority": 1,
      "surah_number": 57,
      "surah_name": "Hadid",
      "ayah_number": 7,
      "ayah_end_number": 7,
      "status": "pending_review"
    },
    {
      "id": "057/010",
      "kind": "ayah",
      "ref": "057/010",
      "ar": "وَمَا لَكُمْ أَلَّا تُنفِقُوا۟ فِى سَبِيلِ ٱللَّهِ وَلِلَّهِ مِيرَٰثُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ لَا يَسْتَوِى مِنكُم مَّنْ أَنفَقَ مِن قَبْلِ ٱلْفَتْحِ وَقَـٰتَلَ ۚ أُو۟لَـٰٓئِكَ أَعْظَمُ دَرَجَةً مِّنَ ٱلَّذِينَ أَنفَقُوا۟ مِنۢ بَعْدُ وَقَـٰتَلُوا۟ ۚ وَكُلًّا وَعَدَ ٱللَّهُ ٱلْحُسْنَىٰ ۚ وَٱللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ",
      "tr": "Size ne oluyor ki, Allah yolunda infak etmiyorsunuz? Oysa göklerin ve yerin mirası Allah'ındır. İçinizden, fetihten önce infak eden ve savaşanlar (başkasıyla) bir olmaz. İşte onlar, derece olarak sonradan infak eden ve savaşanlardan daha büyüktür. Allah, her birine en güzel olanı va'detmiştir. Allah, yaptıklarınızdan haberdardır.",
      "en": "And why do you not spend in the cause of Allah while to Allah belongs the heritage of the heavens and the earth? Not equal among you are those who spent before the conquest [of Makkah] and fought [and those who did so after it]. Those are greater in degree than they who spent afterwards and fought. But to all Allah has promised the best [reward]. And Allah, with what you do, is Acquainted.",
      "priority": 1,
      "surah_number": 57,
      "surah_name": "Hadid",
      "ayah_number": 10,
      "ayah_end_number": 10,
      "status": "pending_review"
    },
    {
      "id": "057/013",
      "kind": "ayah",
      "ref": "057/013",
      "ar": "يَوْمَ يَقُولُ ٱلْمُنَـٰفِقُونَ وَٱلْمُنَـٰفِقَـٰتُ لِلَّذِينَ ءَامَنُوا۟ ٱنظُرُونَا نَقْتَبِسْ مِن نُّورِكُمْ قِيلَ ٱرْجِعُوا۟ وَرَآءَكُمْ فَٱلْتَمِسُوا۟ نُورًا فَضُرِبَ بَيْنَهُم بِسُورٍ لَّهُۥ بَابٌۢ بَاطِنُهُۥ فِيهِ ٱلرَّحْمَةُ وَظَـٰهِرُهُۥ مِن قِبَلِهِ ٱلْعَذَابُ",
      "tr": "O gün, münafık erkekler ile münafık kadınlar, iman edenlere derler ki: \"(Ne olur) Bize bir bakın, sizin nurunuzdan birazcık alıp-yararlanalım.\" Onlara: \"Arkanıza (dünyaya) dönün de bir nur arayıp-bulmaya çalışın\" denilir. Derken aralarında kapısı olan bir sur çekilmiştir; onun iç yanında rahmet, dış yanında o yönden azap vardır.",
      "en": "On the [same] Day the hypocrite men and hypocrite women will say to those who believed, \"Wait for us that we may acquire some of your light.\" It will be said, \"Go back behind you and seek light.\" And a wall will be placed between them with a door, its interior containing mercy, but on the outside of it is torment.",
      "priority": 1,
      "surah_number": 57,
      "surah_name": "Hadid",
      "ayah_number": 13,
      "ayah_end_number": 13,
      "status": "pending_review"
    },
    {
      "id": "057/014",
      "kind": "ayah",
      "ref": "057/014",
      "ar": "يُنَادُونَهُمْ أَلَمْ نَكُن مَّعَكُمْ ۖ قَالُوا۟ بَلَىٰ وَلَـٰكِنَّكُمْ فَتَنتُمْ أَنفُسَكُمْ وَتَرَبَّصْتُمْ وَٱرْتَبْتُمْ وَغَرَّتْكُمُ ٱلْأَمَانِىُّ حَتَّىٰ جَآءَ أَمْرُ ٱللَّهِ وَغَرَّكُم بِٱللَّهِ ٱلْغَرُورُ",
      "tr": "(Münafıklar) Onlara seslenirler: \"Biz sizlerle birlikte değil miydik?\" Derler ki: \"Evet, ancak siz kendinizi fitneye düşürdünüz, (Müslümanları acıların ve yıkımların sarmasını) gözetip-beklediniz, (Allah'a ve İslam'a karşı) kuşkulara kapıldınız. Sizleri kuruntular yanıltıp-aldattı. Sonunda Allah'ın emri (olan ölüm) geliverdi; ve o aldaltıcı da sizi Allah ile (Allah'ın adını kullanarak, hatta masumca sizden görünerek) aldatmış oldu.\"",
      "en": "The hypocrites will call to the believers, \"Were we not with you?\" They will say, \"Yes, but you afflicted yourselves and awaited [misfortune for us] and doubted, and wishful thinking deluded you until there came the command of Allah. And the Deceiver deceived you concerning Allah.",
      "priority": 1,
      "surah_number": 57,
      "surah_name": "Hadid",
      "ayah_number": 14,
      "ayah_end_number": 14,
      "status": "pending_review"
    },
    {
      "id": "057/016",
      "kind": "ayah",
      "ref": "057/016",
      "ar": "أَلَمْ يَأْنِ لِلَّذِينَ ءَامَنُوٓا۟ أَن تَخْشَعَ قُلُوبُهُمْ لِذِكْرِ ٱللَّهِ وَمَا نَزَلَ مِنَ ٱلْحَقِّ وَلَا يَكُونُوا۟ كَٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ مِن قَبْلُ فَطَالَ عَلَيْهِمُ ٱلْأَمَدُ فَقَسَتْ قُلُوبُهُمْ ۖ وَكَثِيرٌ مِّنْهُمْ فَـٰسِقُونَ",
      "tr": "İman edenlerin, Allah'ın ve haktan inmiş olanın zikri için kalplerinin 'saygı ve korku ile yumuşaması' zamanı gelmedi mi? Onlar, bundan önce kendilerine kitap verilmiş, sonra üzerlerinden uzun bir süre geçmiş, böylece kalpleri de katılaşmış bulunanlar gibi olmasınlar. Onlardan çoğu fasık olanlardı.",
      "en": "Has the time not come for those who have believed that their hearts should become humbly submissive at the remembrance of Allah and what has come down of the truth? And let them not be like those who were given the Scripture before, and a long period passed over them, so their hearts hardened; and many of them are defiantly disobedient.",
      "priority": 1,
      "surah_number": 57,
      "surah_name": "Hadid",
      "ayah_number": 16,
      "ayah_end_number": 16,
      "status": "pending_review"
    },
    {
      "id": "057/018",
      "kind": "ayah",
      "ref": "057/018",
      "ar": "إِنَّ ٱلْمُصَّدِّقِينَ وَٱلْمُصَّدِّقَـٰتِ وَأَقْرَضُوا۟ ٱللَّهَ قَرْضًا حَسَنًا يُضَـٰعَفُ لَهُمْ وَلَهُمْ أَجْرٌ كَرِيمٌ",
      "tr": "Gerçek şu ki, sadaka veren erkekler ile sadaka veren kadınlar ve Allah'a güzel bir borç verenler; onlar için kat kat arttırılır ve 'kerim (üstün ve onurlu)' olan ecir de onlarındır.",
      "en": "Indeed, the men who practice charity and the women who practice charity and [they who] have loaned Allah a goodly loan - it will be multiplied for them, and they will have a noble reward.",
      "priority": 1,
      "surah_number": 57,
      "surah_name": "Hadid",
      "ayah_number": 18,
      "ayah_end_number": 18,
      "status": "pending_review"
    },
    {
      "id": "057/020",
      "kind": "ayah",
      "ref": "057/020",
      "ar": "ٱعْلَمُوٓا۟ أَنَّمَا ٱلْحَيَوٰةُ ٱلدُّنْيَا لَعِبٌ وَلَهْوٌ وَزِينَةٌ وَتَفَاخُرٌۢ بَيْنَكُمْ وَتَكَاثُرٌ فِى ٱلْأَمْوَٰلِ وَٱلْأَوْلَـٰدِ ۖ كَمَثَلِ غَيْثٍ أَعْجَبَ ٱلْكُفَّارَ نَبَاتُهُۥ ثُمَّ يَهِيجُ فَتَرَىٰهُ مُصْفَرًّا ثُمَّ يَكُونُ حُطَـٰمًا ۖ وَفِى ٱلْءَاخِرَةِ عَذَابٌ شَدِيدٌ وَمَغْفِرَةٌ مِّنَ ٱللَّهِ وَرِضْوَٰنٌ ۚ وَمَا ٱلْحَيَوٰةُ ٱلدُّنْيَآ إِلَّا مَتَـٰعُ ٱلْغُرُورِ",
      "tr": "Bilin ki, dünya hayatı ancak bir oyun, '(eğlence türünden) tutkulu bir oyalama', bir süs, kendi aranızda bir övünme (süresi ve konusu), mal ve çocuklarda bir 'çoğalma-tutkusu'dur. Bir yağmur örneği gibi; onun bitirdiği ekin ekicilerin (veya kafirlerin) hoşuna gitmiştir, sonra kuruyuverir, bir de bakarsın ki sapsarı kesilmiş, sonra o, bir çer-çöp oluvermiştir. Ahirette ise şiddetli bir azap; Allah'tan bir mağfiret ve bir hoşnutluk (rıza) vardır. Dünya hayatı, aldanış olan bir metadan başka bir şey değildir.",
      "en": "Know that the life of this world is but amusement and diversion and adornment and boasting to one another and competition in increase of wealth and children - like the example of a rain whose [resulting] plant growth pleases the tillers; then it dries and you see it turned yellow; then it becomes [scattered] debris. And in the Hereafter is severe punishment and forgiveness from Allah and approval. And what is the worldly life except the enjoyment of delusion.",
      "priority": 1,
      "surah_number": 57,
      "surah_name": "Hadid",
      "ayah_number": 20,
      "ayah_end_number": 20,
      "status": "pending_review"
    },
    {
      "id": "057/021",
      "kind": "ayah",
      "ref": "057/021",
      "ar": "سَابِقُوٓا۟ إِلَىٰ مَغْفِرَةٍ مِّن رَّبِّكُمْ وَجَنَّةٍ عَرْضُهَا كَعَرْضِ ٱلسَّمَآءِ وَٱلْأَرْضِ أُعِدَّتْ لِلَّذِينَ ءَامَنُوا۟ بِٱللَّهِ وَرُسُلِهِۦ ۚ ذَٰلِكَ فَضْلُ ٱللَّهِ يُؤْتِيهِ مَن يَشَآءُ ۚ وَٱللَّهُ ذُو ٱلْفَضْلِ ٱلْعَظِيمِ",
      "tr": "Rabbinizden olan bir mağfirete ve cennete (kavuşmak için) 'çaba gösterip-yarışın,' ki (o cennet) genişliği gök ile yerin genişliği gibi olup Allah'a ve Resûlü’ne iman edenler için hazırlanmıştır. İşte bu, Allah'ın fazlıdır ki, onu dilediğine verir. Allah büyük fazl sahibidir.",
      "en": "Race toward forgiveness from your Lord and a Garden whose width is like the width of the heavens and earth, prepared for those who believed in Allah and His messengers. That is the bounty of Allah which He gives to whom He wills, and Allah is the possessor of great bounty.",
      "priority": 1,
      "surah_number": 57,
      "surah_name": "Hadid",
      "ayah_number": 21,
      "ayah_end_number": 21,
      "status": "pending_review"
    },
    {
      "id": "057/022",
      "kind": "ayah",
      "ref": "057/022",
      "ar": "مَآ أَصَابَ مِن مُّصِيبَةٍ فِى ٱلْأَرْضِ وَلَا فِىٓ أَنفُسِكُمْ إِلَّا فِى كِتَـٰبٍ مِّن قَبْلِ أَن نَّبْرَأَهَآ ۚ إِنَّ ذَٰلِكَ عَلَى ٱللَّهِ يَسِيرٌ",
      "tr": "Yeryüzünde olan ve sizin nefislerinizde meydana gelen herhangi bir musibet yoktur ki, Biz onu yaratmadan önce, bir kitapta (yazılı) olmasın. Şüphesiz bu, Allah'a göre pek kolaydır.",
      "en": "No disaster strikes upon the earth or among yourselves except that it is in a register before We bring it into being - indeed that, for Allah, is easy -",
      "priority": 1,
      "surah_number": 57,
      "surah_name": "Hadid",
      "ayah_number": 22,
      "ayah_end_number": 22,
      "status": "pending_review"
    },
    {
      "id": "057/023",
      "kind": "ayah",
      "ref": "057/023",
      "ar": "لِّكَيْلَا تَأْسَوْا۟ عَلَىٰ مَا فَاتَكُمْ وَلَا تَفْرَحُوا۟ بِمَآ ءَاتَىٰكُمْ ۗ وَٱللَّهُ لَا يُحِبُّ كُلَّ مُخْتَالٍ فَخُورٍ",
      "tr": "Öyle ki, elinizden çıkana karşı üzüntü duymayasınız ve size (Allah'ın) verdikleri dolayısıyla sevinip-şımarmayasınız. Allah, büyüklük taslayıp böbürleneni sevmez.",
      "en": "In order that you not despair over what has eluded you and not exult [in pride] over what He has given you. And Allah does not like everyone self-deluded and boastful -",
      "priority": 1,
      "surah_number": 57,
      "surah_name": "Hadid",
      "ayah_number": 23,
      "ayah_end_number": 23,
      "status": "pending_review"
    },
    {
      "id": "057/024",
      "kind": "ayah",
      "ref": "057/024",
      "ar": "ٱلَّذِينَ يَبْخَلُونَ وَيَأْمُرُونَ ٱلنَّاسَ بِٱلْبُخْلِ ۗ وَمَن يَتَوَلَّ فَإِنَّ ٱللَّهَ هُوَ ٱلْغَنِىُّ ٱلْحَمِيدُ",
      "tr": "Ki onlar, cimrilik ederler ve insanlara cimriliği emr (tavsiye) ederler. Her kim yüz çevirirse, artık şüphesiz Allah, Ğaniy (hiçbir şeye muhtaç olmayan), Hamid (övülmeye layık olan) O'dur.",
      "en": "[Those] who are stingy and enjoin upon people stinginess. And whoever turns away - then indeed, Allah is the Free of need, the Praiseworthy.",
      "priority": 1,
      "surah_number": 57,
      "surah_name": "Hadid",
      "ayah_number": 24,
      "ayah_end_number": 24,
      "status": "pending_review"
    },
    {
      "id": "057/027",
      "kind": "ayah",
      "ref": "057/027",
      "ar": "ثُمَّ قَفَّيْنَا عَلَىٰٓ ءَاثَـٰرِهِم بِرُسُلِنَا وَقَفَّيْنَا بِعِيسَى ٱبْنِ مَرْيَمَ وَءَاتَيْنَـٰهُ ٱلْإِنجِيلَ وَجَعَلْنَا فِى قُلُوبِ ٱلَّذِينَ ٱتَّبَعُوهُ رَأْفَةً وَرَحْمَةً وَرَهْبَانِيَّةً ٱبْتَدَعُوهَا مَا كَتَبْنَـٰهَا عَلَيْهِمْ إِلَّا ٱبْتِغَآءَ رِضْوَٰنِ ٱللَّهِ فَمَا رَعَوْهَا حَقَّ رِعَايَتِهَا ۖ فَـَٔاتَيْنَا ٱلَّذِينَ ءَامَنُوا۟ مِنْهُمْ أَجْرَهُمْ ۖ وَكَثِيرٌ مِّنْهُمْ فَـٰسِقُونَ",
      "tr": "Sonra onların izleri üzerinde elçilerimizi birbiri ardınca gönderdik. Meryem oğlu İsa'yı da arkalarından gönderdik; ona İncil'i verdik ve onu izleyenlerin kalplerinde bir şefkat ve merhamet kıldık. (Bir bid'at olarak) Türettikleri ruhbanlığı ise, Biz onlara yazmadık (emretmedik). Ancak Allah'ın rızasını aramak için (türettiler) ama buna da gerektiği gibi uymadılar. Bununla birlikte onlardan iman edenlere ecirlerini verdik, onlardan birçoğu da fasık olanlardır.",
      "en": "Then We sent following their footsteps Our messengers and followed [them] with Jesus, the son of Mary, and gave him the Gospel. And We placed in the hearts of those who followed him compassion and mercy and monasticism, which they innovated; We did not prescribe it for them except [that they did so] seeking the approval of Allah. But they did not observe it with due observance. So We gave the ones who believed among them their reward, but many of them are defiantly disobedient.",
      "priority": 1,
      "surah_number": 57,
      "surah_name": "Hadid",
      "ayah_number": 27,
      "ayah_end_number": 27,
      "status": "pending_review"
    },
    {
      "id": "057/029",
      "kind": "ayah",
      "ref": "057/029",
      "ar": "لِّئَلَّا يَعْلَمَ أَهْلُ ٱلْكِتَـٰبِ أَلَّا يَقْدِرُونَ عَلَىٰ شَىْءٍ مِّن فَضْلِ ٱللَّهِ ۙ وَأَنَّ ٱلْفَضْلَ بِيَدِ ٱللَّهِ يُؤْتِيهِ مَن يَشَآءُ ۚ وَٱللَّهُ ذُو ٱلْفَضْلِ ٱلْعَظِيمِ",
      "tr": "Öyle ki, Kitap Ehli (Yahudi ve Hıristiyanlar) Allah'ın fazlından hiçbir şeye 'güç yetirip-sahip olmadıklarını' ve fazlın muhakkak Allah'ın elinde olduğunu, onu dilediğine verdiğini bilip-öğrensin. Allah, büyük fazl (üstün lütuf ve ihsan) sahibidir.",
      "en": "[This is] so that the People of the Scripture may know that they are not able [to obtain] anything from the bounty of Allah and that [all] bounty is in the hand of Allah; He gives it to whom He wills. And Allah is the possessor of great bounty.",
      "priority": 1,
      "surah_number": 57,
      "surah_name": "Hadid",
      "ayah_number": 29,
      "ayah_end_number": 29,
      "status": "pending_review"
    },
    {
      "id": "058/011",
      "kind": "ayah",
      "ref": "058/011",
      "ar": "يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا قِيلَ لَكُمْ تَفَسَّحُوا۟ فِى ٱلْمَجَـٰلِسِ فَٱفْسَحُوا۟ يَفْسَحِ ٱللَّهُ لَكُمْ ۖ وَإِذَا قِيلَ ٱنشُزُوا۟ فَٱنشُزُوا۟ يَرْفَعِ ٱللَّهُ ٱلَّذِينَ ءَامَنُوا۟ مِنكُمْ وَٱلَّذِينَ أُوتُوا۟ ٱلْعِلْمَ دَرَجَـٰتٍ ۚ وَٱللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ",
      "tr": "Ey iman edenler, size meclislerde \"Yer açın\" dendiği zaman, yer açın; Allah size genişlik versin. Size: \"Kalkın\" denildiği zaman da kalkın. Allah, sizden iman edenleri ve kendilerine ilim verilenleri derecelerle yükseltsin. Allah, yaptıklarınızdan haberdardır.",
      "en": "O you who have believed, when you are told, \"Space yourselves\" in assemblies, then make space; Allah will make space for you. And when you are told, \"Arise,\" then arise; Allah will raise those who have believed among you and those who were given knowledge, by degrees. And Allah is Acquainted with what you do.",
      "priority": 1,
      "surah_number": 58,
      "surah_name": "Mucadele",
      "ayah_number": 11,
      "ayah_end_number": 11,
      "status": "pending_review"
    },
    {
      "id": "058/014",
      "kind": "ayah",
      "ref": "058/014",
      "ar": "أَلَمْ تَرَ إِلَى ٱلَّذِينَ تَوَلَّوْا۟ قَوْمًا غَضِبَ ٱللَّهُ عَلَيْهِم مَّا هُم مِّنكُمْ وَلَا مِنْهُمْ وَيَحْلِفُونَ عَلَى ٱلْكَذِبِ وَهُمْ يَعْلَمُونَ",
      "tr": "Allah'ın kendilerine karşı gazablandığı bir kavmi veli (dost ve müttefik) edinenleri görmedin mi? Onlar, ne sizdendirler, ne onlardan. Kendileri de (açıkça gerçeği) bildikleri halde, yalan üzere yemin ediyorlar.",
      "en": "Have you not considered those who make allies of a people with whom Allah has become angry? They are neither of you nor of them, and they swear to untruth while they know [they are lying].",
      "priority": 1,
      "surah_number": 58,
      "surah_name": "Mucadele",
      "ayah_number": 14,
      "ayah_end_number": 14,
      "status": "pending_review"
    },
    {
      "id": "058/015",
      "kind": "ayah",
      "ref": "058/015",
      "ar": "أَعَدَّ ٱللَّهُ لَهُمْ عَذَابًا شَدِيدًا ۖ إِنَّهُمْ سَآءَ مَا كَانُوا۟ يَعْمَلُونَ",
      "tr": "Allah, onlara şiddetli bir azap hazırlamıştır. Doğrusu onların yaptıkları ne kötüdür.",
      "en": "Allah has prepared for them a severe punishment. Indeed, it was evil that they were doing.",
      "priority": 1,
      "surah_number": 58,
      "surah_name": "Mucadele",
      "ayah_number": 15,
      "ayah_end_number": 15,
      "status": "pending_review"
    },
    {
      "id": "058/014-015",
      "kind": "ayah",
      "ref": "058/014-015",
      "ar": "﴿14﴾ أَلَمْ تَرَ إِلَى ٱلَّذِينَ تَوَلَّوْا۟ قَوْمًا غَضِبَ ٱللَّهُ عَلَيْهِم مَّا هُم مِّنكُمْ وَلَا مِنْهُمْ وَيَحْلِفُونَ عَلَى ٱلْكَذِبِ وَهُمْ يَعْلَمُونَ\n\n﴿15﴾ أَعَدَّ ٱللَّهُ لَهُمْ عَذَابًا شَدِيدًا ۖ إِنَّهُمْ سَآءَ مَا كَانُوا۟ يَعْمَلُونَ",
      "tr": "[14] Allah'ın kendilerine karşı gazablandığı bir kavmi veli (dost ve müttefik) edinenleri görmedin mi? Onlar, ne sizdendirler, ne onlardan. Kendileri de (açıkça gerçeği) bildikleri halde, yalan üzere yemin ediyorlar.\n\n[15] Allah, onlara şiddetli bir azap hazırlamıştır. Doğrusu onların yaptıkları ne kötüdür.",
      "en": "[14] Have you not considered those who make allies of a people with whom Allah has become angry? They are neither of you nor of them, and they swear to untruth while they know [they are lying].\n\n[15] Allah has prepared for them a severe punishment. Indeed, it was evil that they were doing.",
      "priority": 1,
      "surah_number": 58,
      "surah_name": "Mucadele",
      "ayah_number": 14,
      "ayah_end_number": 15,
      "status": "pending_review"
    },
    {
      "id": "059/002",
      "kind": "ayah",
      "ref": "059/002",
      "ar": "هُوَ ٱلَّذِىٓ أَخْرَجَ ٱلَّذِينَ كَفَرُوا۟ مِنْ أَهْلِ ٱلْكِتَـٰبِ مِن دِيَـٰرِهِمْ لِأَوَّلِ ٱلْحَشْرِ ۚ مَا ظَنَنتُمْ أَن يَخْرُجُوا۟ ۖ وَظَنُّوٓا۟ أَنَّهُم مَّانِعَتُهُمْ حُصُونُهُم مِّنَ ٱللَّهِ فَأَتَىٰهُمُ ٱللَّهُ مِنْ حَيْثُ لَمْ يَحْتَسِبُوا۟ ۖ وَقَذَفَ فِى قُلُوبِهِمُ ٱلرُّعْبَ ۚ يُخْرِبُونَ بُيُوتَهُم بِأَيْدِيهِمْ وَأَيْدِى ٱلْمُؤْمِنِينَ فَٱعْتَبِرُوا۟ يَـٰٓأُو۟لِى ٱلْأَبْصَـٰرِ",
      "tr": "Kitap Ehlinden inkar edenleri ilk sürgünde yurtlarından çıkaran O'dur. Onların çıkacaklarını siz sanmamıştınız, onlar da kalelerinin kendilerini Allah'tan koruyacağını sanmışlardı. Böylece Allah(ın azabı) da, onlara hesaba katmadıkları bir yönden geldi, yüreklerine korku saldı; öyle ki evlerini kendi elleriyle ve mü'minlerin elleriyle tahrip ediyorlardı. Artık ey basiret sahipleri ibret alın.",
      "en": "It is He who expelled the ones who disbelieved among the People of the Scripture from their homes at the first gathering. You did not think they would leave, and they thought that their fortresses would protect them from Allah; but [the decree of] Allah came upon them from where they had not expected, and He cast terror into their hearts [so] they destroyed their houses by their [own] hands and the hands of the believers. So take warning, O people of vision.",
      "priority": 1,
      "surah_number": 59,
      "surah_name": "Hasr",
      "ayah_number": 2,
      "ayah_end_number": 2,
      "status": "pending_review"
    },
    {
      "id": "059/007",
      "kind": "ayah",
      "ref": "059/007",
      "ar": "مَّآ أَفَآءَ ٱللَّهُ عَلَىٰ رَسُولِهِۦ مِنْ أَهْلِ ٱلْقُرَىٰ فَلِلَّهِ وَلِلرَّسُولِ وَلِذِى ٱلْقُرْبَىٰ وَٱلْيَتَـٰمَىٰ وَٱلْمَسَـٰكِينِ وَٱبْنِ ٱلسَّبِيلِ كَىْ لَا يَكُونَ دُولَةًۢ بَيْنَ ٱلْأَغْنِيَآءِ مِنكُمْ ۚ وَمَآ ءَاتَىٰكُمُ ٱلرَّسُولُ فَخُذُوهُ وَمَا نَهَىٰكُمْ عَنْهُ فَٱنتَهُوا۟ ۚ وَٱتَّقُوا۟ ٱللَّهَ ۖ إِنَّ ٱللَّهَ شَدِيدُ ٱلْعِقَابِ",
      "tr": "Allah'ın o (fethedilen) şehir halkından Resûlü’ne verdiği fey, Allah'a, Resûl’e, (ve Resûl’e) yakın akrabalığı olanlara, yetimlere, yoksullara ve yolda kalmışlara aittir. Öyle ki (bu mallar ve servet) sizden zengin olanlar arasında dönüp-dolaşan bir devlet olmasın. Resûl size ne verirse artık onu alın, sizi neden sakındırırsa artık ondan sakının ve Allah'tan korkun. Şüphesiz Allah, cezası (ikabı) pek şiddetli olandır.",
      "en": "And what Allah restored to His Messenger from the people of the towns - it is for Allah and for the Messenger and for [his] near relatives and orphans and the [stranded] traveler - so that it will not be a perpetual distribution among the rich from among you. And whatever the Messenger has given you - take; and what he has forbidden you - refrain from. And fear Allah; indeed, Allah is severe in penalty.",
      "priority": 1,
      "surah_number": 59,
      "surah_name": "Hasr",
      "ayah_number": 7,
      "ayah_end_number": 7,
      "status": "pending_review"
    },
    {
      "id": "059/008",
      "kind": "ayah",
      "ref": "059/008",
      "ar": "لِلْفُقَرَآءِ ٱلْمُهَـٰجِرِينَ ٱلَّذِينَ أُخْرِجُوا۟ مِن دِيَـٰرِهِمْ وَأَمْوَٰلِهِمْ يَبْتَغُونَ فَضْلًا مِّنَ ٱللَّهِ وَرِضْوَٰنًا وَيَنصُرُونَ ٱللَّهَ وَرَسُولَهُۥٓ ۚ أُو۟لَـٰٓئِكَ هُمُ ٱلصَّـٰدِقُونَ",
      "tr": "(Bundan başka bu mallar,) Hicret eden fakirleredir ki, onlar, Allah'tan bir fazl (lütuf ve ihsan) arayıp, Allah'a ve O'nun Resûlü’ne yardım ederlerken yurtlarından ve mallarından sürülüp-çıkarılmışlardır. İşte bunlar, sadık olanlar bunlardır.",
      "en": "For the poor emigrants who were expelled from their homes and their properties, seeking bounty from Allah and [His] approval and supporting Allah and His Messenger, [there is also a share]. Those are the truthful.",
      "priority": 1,
      "surah_number": 59,
      "surah_name": "Hasr",
      "ayah_number": 8,
      "ayah_end_number": 8,
      "status": "pending_review"
    },
    {
      "id": "059/020",
      "kind": "ayah",
      "ref": "059/020",
      "ar": "لَا يَسْتَوِىٓ أَصْحَـٰبُ ٱلنَّارِ وَأَصْحَـٰبُ ٱلْجَنَّةِ ۚ أَصْحَـٰبُ ٱلْجَنَّةِ هُمُ ٱلْفَآئِزُونَ",
      "tr": "Ateş halkı ile cennet halkı bir olmaz. Cennet halkı 'umduklarına kavuşup mutluluk içinde olanlardır.'",
      "en": "Not equal are the companions of the Fire and the companions of Paradise. The companions of Paradise - they are the attainers [of success].",
      "priority": 1,
      "surah_number": 59,
      "surah_name": "Hasr",
      "ayah_number": 20,
      "ayah_end_number": 20,
      "status": "pending_review"
    },
    {
      "id": "059/021",
      "kind": "ayah",
      "ref": "059/021",
      "ar": "لَوْ أَنزَلْنَا هَـٰذَا ٱلْقُرْءَانَ عَلَىٰ جَبَلٍ لَّرَأَيْتَهُۥ خَـٰشِعًا مُّتَصَدِّعًا مِّنْ خَشْيَةِ ٱللَّهِ ۚ وَتِلْكَ ٱلْأَمْثَـٰلُ نَضْرِبُهَا لِلنَّاسِ لَعَلَّهُمْ يَتَفَكَّرُونَ",
      "tr": "Şayet Biz bu Kur'an'ı bir dağın üzerine indirmiş olsaydık, andolsun onu Allah korkusundan saygı ile baş eğmiş, parça parça olmuş görürdün. İşte Biz, belki düşünürler diye, insanlara böyle örnekler veririz.",
      "en": "If We had sent down this Qur'an upon a mountain, you would have seen it humbled and coming apart from fear of Allah. And these examples We present to the people that perhaps they will give thought.",
      "priority": 1,
      "surah_number": 59,
      "surah_name": "Hasr",
      "ayah_number": 21,
      "ayah_end_number": 21,
      "status": "pending_review"
    },
    {
      "id": "059/023",
      "kind": "ayah",
      "ref": "059/023",
      "ar": "هُوَ ٱللَّهُ ٱلَّذِى لَآ إِلَـٰهَ إِلَّا هُوَ ٱلْمَلِكُ ٱلْقُدُّوسُ ٱلسَّلَـٰمُ ٱلْمُؤْمِنُ ٱلْمُهَيْمِنُ ٱلْعَزِيزُ ٱلْجَبَّارُ ٱلْمُتَكَبِّرُ ۚ سُبْحَـٰنَ ٱللَّهِ عَمَّا يُشْرِكُونَ",
      "tr": "O Allah ki, O'ndan başka İlah yoktur. Meliktir; Kuddûstur; Selam'ır; Mü'mindir; Müheymindir; Azizdir; Cebbardır; Mütekebbirdir. Allah, (müşriklerin) şirk koştuklarından çok Yücedir.",
      "en": "He is Allah, other than whom there is no deity, the Sovereign, the Pure, the Perfection, the Bestower of Faith, the Overseer, the Exalted in Might, the Compeller, the Superior. Exalted is Allah above whatever they associate with Him.",
      "priority": 1,
      "surah_number": 59,
      "surah_name": "Hasr",
      "ayah_number": 23,
      "ayah_end_number": 23,
      "status": "pending_review"
    },
    {
      "id": "059/020-021",
      "kind": "ayah",
      "ref": "059/020-021",
      "ar": "﴿20﴾ لَا يَسْتَوِىٓ أَصْحَـٰبُ ٱلنَّارِ وَأَصْحَـٰبُ ٱلْجَنَّةِ ۚ أَصْحَـٰبُ ٱلْجَنَّةِ هُمُ ٱلْفَآئِزُونَ\n\n﴿21﴾ لَوْ أَنزَلْنَا هَـٰذَا ٱلْقُرْءَانَ عَلَىٰ جَبَلٍ لَّرَأَيْتَهُۥ خَـٰشِعًا مُّتَصَدِّعًا مِّنْ خَشْيَةِ ٱللَّهِ ۚ وَتِلْكَ ٱلْأَمْثَـٰلُ نَضْرِبُهَا لِلنَّاسِ لَعَلَّهُمْ يَتَفَكَّرُونَ",
      "tr": "[20] Ateş halkı ile cennet halkı bir olmaz. Cennet halkı 'umduklarına kavuşup mutluluk içinde olanlardır.'\n\n[21] Şayet Biz bu Kur'an'ı bir dağın üzerine indirmiş olsaydık, andolsun onu Allah korkusundan saygı ile baş eğmiş, parça parça olmuş görürdün. İşte Biz, belki düşünürler diye, insanlara böyle örnekler veririz.",
      "en": "[20] Not equal are the companions of the Fire and the companions of Paradise. The companions of Paradise - they are the attainers [of success].\n\n[21] If We had sent down this Qur'an upon a mountain, you would have seen it humbled and coming apart from fear of Allah. And these examples We present to the people that perhaps they will give thought.",
      "priority": 1,
      "surah_number": 59,
      "surah_name": "Hasr",
      "ayah_number": 20,
      "ayah_end_number": 21,
      "status": "pending_review"
    },
    {
      "id": "060/005",
      "kind": "ayah",
      "ref": "060/005",
      "ar": "رَبَّنَا لَا تَجْعَلْنَا فِتْنَةً لِّلَّذِينَ كَفَرُوا۟ وَٱغْفِرْ لَنَا رَبَّنَآ ۖ إِنَّكَ أَنتَ ٱلْعَزِيزُ ٱلْحَكِيمُ",
      "tr": "\"Rabbimiz, bizi inkar edenler için fitne (deneme konusu) kılma ve bizi bağışla Rabbimiz. Şüphesiz Sen, üstün ve güçlüsün, hüküm ve hikmet sahibisin.\"",
      "en": "Our Lord, make us not [objects of] torment for the disbelievers and forgive us, our Lord. Indeed, it is You who is the Exalted in Might, the Wise.\"",
      "priority": 1,
      "surah_number": 60,
      "surah_name": "Mumtehine",
      "ayah_number": 5,
      "ayah_end_number": 5,
      "status": "pending_review"
    },
    {
      "id": "060/012",
      "kind": "ayah",
      "ref": "060/012",
      "ar": "يَـٰٓأَيُّهَا ٱلنَّبِىُّ إِذَا جَآءَكَ ٱلْمُؤْمِنَـٰتُ يُبَايِعْنَكَ عَلَىٰٓ أَن لَّا يُشْرِكْنَ بِٱللَّهِ شَيْـًٔا وَلَا يَسْرِقْنَ وَلَا يَزْنِينَ وَلَا يَقْتُلْنَ أَوْلَـٰدَهُنَّ وَلَا يَأْتِينَ بِبُهْتَـٰنٍ يَفْتَرِينَهُۥ بَيْنَ أَيْدِيهِنَّ وَأَرْجُلِهِنَّ وَلَا يَعْصِينَكَ فِى مَعْرُوفٍ ۙ فَبَايِعْهُنَّ وَٱسْتَغْفِرْ لَهُنَّ ٱللَّهَ ۖ إِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ",
      "tr": "Ey Peygamber, mü'min kadınlar, Allah'a hiçbir şeyi ortak koşmamak, hırsızlık yapmamak, zina etmemek, çocuklarını öldürmemek, elleri ve ayakları arasında bir iftira düzüp-uydurmamak (gayri meşru olan bir çocuğu kocalarına dayandırmamak), ma'ruf (iyi, güzel ve yararlı bir iş) konusunda isyan etmemek üzere, sana biat etmek amacıyla geldikleri zaman, onların biatlarını kabul et ve onlar için Allah'tan mağfiret iste. Şüphesiz Allah, çok bağışlayandır, çok esirgeyendir.",
      "en": "O Prophet, when the believing women come to you pledging to you that they will not associate anything with Allah, nor will they steal, nor will they commit unlawful sexual intercourse, nor will they kill their children, nor will they bring forth a slander they have invented between their arms and legs, nor will they disobey you in what is right - then accept their pledge and ask forgiveness for them of Allah. Indeed, Allah is Forgiving and Merciful.",
      "priority": 1,
      "surah_number": 60,
      "surah_name": "Mumtehine",
      "ayah_number": 12,
      "ayah_end_number": 12,
      "status": "pending_review"
    },
    {
      "id": "060/013",
      "kind": "ayah",
      "ref": "060/013",
      "ar": "يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَتَوَلَّوْا۟ قَوْمًا غَضِبَ ٱللَّهُ عَلَيْهِمْ قَدْ يَئِسُوا۟ مِنَ ٱلْءَاخِرَةِ كَمَا يَئِسَ ٱلْكُفَّارُ مِنْ أَصْحَـٰبِ ٱلْقُبُورِ",
      "tr": "Ey iman edenler, Allah'ın kendilerine karşı gazablandığı bir kavmi veli (dost ve müttefik) edinmeyin; ki onlar, kafirlerin mezar halkından umut kesmeleri gibi ahiretten umut kesmişlerdir.",
      "en": "O you who have believed, do not make allies of a people with whom Allah has become angry. They have despaired of [reward in] the Hereafter just as the disbelievers have despaired of [meeting] the inhabitants of the graves.",
      "priority": 1,
      "surah_number": 60,
      "surah_name": "Mumtehine",
      "ayah_number": 13,
      "ayah_end_number": 13,
      "status": "pending_review"
    },
    {
      "id": "061/006",
      "kind": "ayah",
      "ref": "061/006",
      "ar": "وَإِذْ قَالَ عِيسَى ٱبْنُ مَرْيَمَ يَـٰبَنِىٓ إِسْرَٰٓءِيلَ إِنِّى رَسُولُ ٱللَّهِ إِلَيْكُم مُّصَدِّقًا لِّمَا بَيْنَ يَدَىَّ مِنَ ٱلتَّوْرَىٰةِ وَمُبَشِّرًۢا بِرَسُولٍ يَأْتِى مِنۢ بَعْدِى ٱسْمُهُۥٓ أَحْمَدُ ۖ فَلَمَّا جَآءَهُم بِٱلْبَيِّنَـٰتِ قَالُوا۟ هَـٰذَا سِحْرٌ مُّبِينٌ",
      "tr": "Hani Meryem oğlu İsa da: \"Ey İsrailoğulları, gerçekten ben, sizin için Allah'tan gönderilmiş bir elçiyim. Benden önceki Tevrat'ı doğrulayıcı ve benden sonra ismi \"Ahmed\" olan bir elçinin de müjdeleyicisiyim\" demişti. Fakat o, onlara apaçık belgelerle gelince: \"Bu, açıkça bir büyüdür\" dediler.",
      "en": "And [mention] when Jesus, the son of Mary, said, \"O children of Israel, indeed I am the messenger of Allah to you confirming what came before me of the Torah and bringing good tidings of a messenger to come after me, whose name is Ahmad.\" But when he came to them with clear evidences, they said, \"This is obvious magic.\"",
      "priority": 1,
      "surah_number": 61,
      "surah_name": "Saff",
      "ayah_number": 6,
      "ayah_end_number": 6,
      "status": "pending_review"
    },
    {
      "id": "061/007",
      "kind": "ayah",
      "ref": "061/007",
      "ar": "وَمَنْ أَظْلَمُ مِمَّنِ ٱفْتَرَىٰ عَلَى ٱللَّهِ ٱلْكَذِبَ وَهُوَ يُدْعَىٰٓ إِلَى ٱلْإِسْلَـٰمِ ۚ وَٱللَّهُ لَا يَهْدِى ٱلْقَوْمَ ٱلظَّـٰلِمِينَ",
      "tr": "İslam'a çağrıldığı halde, Allah'a karşı yalan uyduranlardan daha zalim kimdir? Allah, zalim bir kavmi hidayete erdirmez.",
      "en": "And who is more unjust than one who invents about Allah untruth while he is being invited to Islam. And Allah does not guide the wrongdoing people.",
      "priority": 1,
      "surah_number": 61,
      "surah_name": "Saff",
      "ayah_number": 7,
      "ayah_end_number": 7,
      "status": "pending_review"
    },
    {
      "id": "061/006-007",
      "kind": "ayah",
      "ref": "061/006-007",
      "ar": "﴿6﴾ وَإِذْ قَالَ عِيسَى ٱبْنُ مَرْيَمَ يَـٰبَنِىٓ إِسْرَٰٓءِيلَ إِنِّى رَسُولُ ٱللَّهِ إِلَيْكُم مُّصَدِّقًا لِّمَا بَيْنَ يَدَىَّ مِنَ ٱلتَّوْرَىٰةِ وَمُبَشِّرًۢا بِرَسُولٍ يَأْتِى مِنۢ بَعْدِى ٱسْمُهُۥٓ أَحْمَدُ ۖ فَلَمَّا جَآءَهُم بِٱلْبَيِّنَـٰتِ قَالُوا۟ هَـٰذَا سِحْرٌ مُّبِينٌ\n\n﴿7﴾ وَمَنْ أَظْلَمُ مِمَّنِ ٱفْتَرَىٰ عَلَى ٱللَّهِ ٱلْكَذِبَ وَهُوَ يُدْعَىٰٓ إِلَى ٱلْإِسْلَـٰمِ ۚ وَٱللَّهُ لَا يَهْدِى ٱلْقَوْمَ ٱلظَّـٰلِمِينَ",
      "tr": "[6] Hani Meryem oğlu İsa da: \"Ey İsrailoğulları, gerçekten ben, sizin için Allah'tan gönderilmiş bir elçiyim. Benden önceki Tevrat'ı doğrulayıcı ve benden sonra ismi \"Ahmed\" olan bir elçinin de müjdeleyicisiyim\" demişti. Fakat o, onlara apaçık belgelerle gelince: \"Bu, açıkça bir büyüdür\" dediler.\n\n[7] İslam'a çağrıldığı halde, Allah'a karşı yalan uyduranlardan daha zalim kimdir? Allah, zalim bir kavmi hidayete erdirmez.",
      "en": "[6] And [mention] when Jesus, the son of Mary, said, \"O children of Israel, indeed I am the messenger of Allah to you confirming what came before me of the Torah and bringing good tidings of a messenger to come after me, whose name is Ahmad.\" But when he came to them with clear evidences, they said, \"This is obvious magic.\"\n\n[7] And who is more unjust than one who invents about Allah untruth while he is being invited to Islam. And Allah does not guide the wrongdoing people.",
      "priority": 1,
      "surah_number": 61,
      "surah_name": "Saff",
      "ayah_number": 6,
      "ayah_end_number": 7,
      "status": "pending_review"
    },
    {
      "id": "061/013",
      "kind": "ayah",
      "ref": "061/013",
      "ar": "وَأُخْرَىٰ تُحِبُّونَهَا ۖ نَصْرٌ مِّنَ ٱللَّهِ وَفَتْحٌ قَرِيبٌ ۗ وَبَشِّرِ ٱلْمُؤْمِنِينَ",
      "tr": "Ve seveceğiniz bir başka (nimet) daha var: Allah'tan 'yardım ve zafer (nusret)' ve yakın bir fetih. Mü'minleri müjdele.",
      "en": "And [you will obtain] another [favor] that you love - victory from Allah and an imminent conquest; and give good tidings to the believers.",
      "priority": 1,
      "surah_number": 61,
      "surah_name": "Saff",
      "ayah_number": 13,
      "ayah_end_number": 13,
      "status": "pending_review"
    },
    {
      "id": "062/002",
      "kind": "ayah",
      "ref": "062/002",
      "ar": "هُوَ ٱلَّذِى بَعَثَ فِى ٱلْأُمِّيِّـۧنَ رَسُولًا مِّنْهُمْ يَتْلُوا۟ عَلَيْهِمْ ءَايَـٰتِهِۦ وَيُزَكِّيهِمْ وَيُعَلِّمُهُمُ ٱلْكِتَـٰبَ وَٱلْحِكْمَةَ وَإِن كَانُوا۟ مِن قَبْلُ لَفِى ضَلَـٰلٍ مُّبِينٍ",
      "tr": "O, ümmîler içinde, kendilerinden olan ve onlara ayetlerini okuyan, onları arındırıp-temizleyen ve onlara kitap ve hikmeti öğreten bir elçi gönderendir. Oysa onlar, bundan önce gerçekten açıkça bir sapıklık içinde idiler.",
      "en": "It is He who has sent among the unlettered a Messenger from themselves reciting to them His verses and purifying them and teaching them the Book and wisdom - although they were before in clear error -",
      "priority": 1,
      "surah_number": 62,
      "surah_name": "Cuma",
      "ayah_number": 2,
      "ayah_end_number": 2,
      "status": "pending_review"
    },
    {
      "id": "062/005",
      "kind": "ayah",
      "ref": "062/005",
      "ar": "مَثَلُ ٱلَّذِينَ حُمِّلُوا۟ ٱلتَّوْرَىٰةَ ثُمَّ لَمْ يَحْمِلُوهَا كَمَثَلِ ٱلْحِمَارِ يَحْمِلُ أَسْفَارًۢا ۚ بِئْسَ مَثَلُ ٱلْقَوْمِ ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَـٰتِ ٱللَّهِ ۚ وَٱللَّهُ لَا يَهْدِى ٱلْقَوْمَ ٱلظَّـٰلِمِينَ",
      "tr": "Kendilerine Tevrat yükletilip de sonra onu (içindeki derin anlamları, hikmet ve hükümleriyle gereği gibi) yüklenmemiş olanların durumu, koskoca kitap yükü taşıyan eşeğin durumu gibidir. Allah'ın ayetlerini yalanlayan kavmin durumu ne kötüdür. Allah, zalim bir kavmi hidayete erdirmez.",
      "en": "The example of those who were entrusted with the Torah and then did not take it on is like that of a donkey who carries volumes [of books]. Wretched is the example of the people who deny the signs of Allah. And Allah does not guide the wrongdoing people.",
      "priority": 1,
      "surah_number": 62,
      "surah_name": "Cuma",
      "ayah_number": 5,
      "ayah_end_number": 5,
      "status": "pending_review"
    },
    {
      "id": "062/006",
      "kind": "ayah",
      "ref": "062/006",
      "ar": "قُلْ يَـٰٓأَيُّهَا ٱلَّذِينَ هَادُوٓا۟ إِن زَعَمْتُمْ أَنَّكُمْ أَوْلِيَآءُ لِلَّهِ مِن دُونِ ٱلنَّاسِ فَتَمَنَّوُا۟ ٱلْمَوْتَ إِن كُنتُمْ صَـٰدِقِينَ",
      "tr": "De ki: \"Ey Yahudi olanlar, eğer siz, (bütün) insanlardan ayrı olarak yalnızca sizlerin gerçekten Allah'ın velileri (dost ve sevgili kulları) olduğunuzu öne sürüyorsanız, şu halde ölümü temenni edin; eğer doğru sözlü iseniz (bunu çekinmeden yapın).\"",
      "en": "Say, \"O you who are Jews, if you claim that you are allies of Allah, excluding the [other] people, then wish for death, if you should be truthful.\"",
      "priority": 1,
      "surah_number": 62,
      "surah_name": "Cuma",
      "ayah_number": 6,
      "ayah_end_number": 6,
      "status": "pending_review"
    },
    {
      "id": "062/007",
      "kind": "ayah",
      "ref": "062/007",
      "ar": "وَلَا يَتَمَنَّوْنَهُۥٓ أَبَدًۢا بِمَا قَدَّمَتْ أَيْدِيهِمْ ۚ وَٱللَّهُ عَلِيمٌۢ بِٱلظَّـٰلِمِينَ",
      "tr": "Oysa onlar, ellerinin öne takdim ettikleri dolayısıyla bunu hiçbir zaman temenni edemezler. Allah, zalimleri bilendir.",
      "en": "But they will not wish for it, ever, because of what their hands have put forth. And Allah is Knowing of the wrongdoers.",
      "priority": 1,
      "surah_number": 62,
      "surah_name": "Cuma",
      "ayah_number": 7,
      "ayah_end_number": 7,
      "status": "pending_review"
    },
    {
      "id": "062/009",
      "kind": "ayah",
      "ref": "062/009",
      "ar": "يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا نُودِىَ لِلصَّلَوٰةِ مِن يَوْمِ ٱلْجُمُعَةِ فَٱسْعَوْا۟ إِلَىٰ ذِكْرِ ٱللَّهِ وَذَرُوا۟ ٱلْبَيْعَ ۚ ذَٰلِكُمْ خَيْرٌ لَّكُمْ إِن كُنتُمْ تَعْلَمُونَ",
      "tr": "Ey iman edenler, cuma günü namaz için çağrı yapıldığı zaman, hemen Allah'ı zikretmeye koşun ve alış-verişi bırakın. Eğer bilirseniz, bu sizin için daha hayırlıdır.",
      "en": "O you who have believed, when [the adhan] is called for the prayer on the day of Jumu'ah [Friday], then proceed to the remembrance of Allah and leave trade. That is better for you, if you only knew.",
      "priority": 1,
      "surah_number": 62,
      "surah_name": "Cuma",
      "ayah_number": 9,
      "ayah_end_number": 9,
      "status": "pending_review"
    },
    {
      "id": "062/005-007",
      "kind": "ayah",
      "ref": "062/005-007",
      "ar": "﴿5﴾ مَثَلُ ٱلَّذِينَ حُمِّلُوا۟ ٱلتَّوْرَىٰةَ ثُمَّ لَمْ يَحْمِلُوهَا كَمَثَلِ ٱلْحِمَارِ يَحْمِلُ أَسْفَارًۢا ۚ بِئْسَ مَثَلُ ٱلْقَوْمِ ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَـٰتِ ٱللَّهِ ۚ وَٱللَّهُ لَا يَهْدِى ٱلْقَوْمَ ٱلظَّـٰلِمِينَ\n\n﴿6﴾ قُلْ يَـٰٓأَيُّهَا ٱلَّذِينَ هَادُوٓا۟ إِن زَعَمْتُمْ أَنَّكُمْ أَوْلِيَآءُ لِلَّهِ مِن دُونِ ٱلنَّاسِ فَتَمَنَّوُا۟ ٱلْمَوْتَ إِن كُنتُمْ صَـٰدِقِينَ\n\n﴿7﴾ وَلَا يَتَمَنَّوْنَهُۥٓ أَبَدًۢا بِمَا قَدَّمَتْ أَيْدِيهِمْ ۚ وَٱللَّهُ عَلِيمٌۢ بِٱلظَّـٰلِمِينَ",
      "tr": "[5] Kendilerine Tevrat yükletilip de sonra onu (içindeki derin anlamları, hikmet ve hükümleriyle gereği gibi) yüklenmemiş olanların durumu, koskoca kitap yükü taşıyan eşeğin durumu gibidir. Allah'ın ayetlerini yalanlayan kavmin durumu ne kötüdür. Allah, zalim bir kavmi hidayete erdirmez.\n\n[6] De ki: \"Ey Yahudi olanlar, eğer siz, (bütün) insanlardan ayrı olarak yalnızca sizlerin gerçekten Allah'ın velileri (dost ve sevgili kulları) olduğunuzu öne sürüyorsanız, şu halde ölümü temenni edin; eğer doğru sözlü iseniz (bunu çekinmeden yapın).\"\n\n[7] Oysa onlar, ellerinin öne takdim ettikleri dolayısıyla bunu hiçbir zaman temenni edemezler. Allah, zalimleri bilendir.",
      "en": "[5] The example of those who were entrusted with the Torah and then did not take it on is like that of a donkey who carries volumes [of books]. Wretched is the example of the people who deny the signs of Allah. And Allah does not guide the wrongdoing people.\n\n[6] Say, \"O you who are Jews, if you claim that you are allies of Allah, excluding the [other] people, then wish for death, if you should be truthful.\"\n\n[7] But they will not wish for it, ever, because of what their hands have put forth. And Allah is Knowing of the wrongdoers.",
      "priority": 1,
      "surah_number": 62,
      "surah_name": "Cuma",
      "ayah_number": 5,
      "ayah_end_number": 7,
      "status": "pending_review"
    },
    {
      "id": "062/011",
      "kind": "ayah",
      "ref": "062/011",
      "ar": "وَإِذَا رَأَوْا۟ تِجَـٰرَةً أَوْ لَهْوًا ٱنفَضُّوٓا۟ إِلَيْهَا وَتَرَكُوكَ قَآئِمًا ۚ قُلْ مَا عِندَ ٱللَّهِ خَيْرٌ مِّنَ ٱللَّهْوِ وَمِنَ ٱلتِّجَـٰرَةِ ۚ وَٱللَّهُ خَيْرُ ٱلرَّٰزِقِينَ",
      "tr": "Oysa onlar (kendilerini tümüyle Allah'a ve İslam'a teslim etmeyenler) bir ticaret ya da bir eğlence gördükleri zaman, (hemen) ona sökün ettiler ve seni ayakta bıraktılar. De ki: \"Allah'ın Katında bulunan, eğlenceden ve ticaretten daha hayırlıdır. Allah, rızık verenlerin en hayırlısıdır.\"",
      "en": "But when they saw a transaction or a diversion, [O Muhammad], they rushed to it and left you standing. Say, \"What is with Allah is better than diversion and than a transaction, and Allah is the best of providers.\"",
      "priority": 1,
      "surah_number": 62,
      "surah_name": "Cuma",
      "ayah_number": 11,
      "ayah_end_number": 11,
      "status": "pending_review"
    },
    {
      "id": "063/001",
      "kind": "ayah",
      "ref": "063/001",
      "ar": "\\basmalah إِذَا جَآءَكَ ٱلْمُنَـٰفِقُونَ قَالُوا۟ نَشْهَدُ إِنَّكَ لَرَسُولُ ٱللَّهِ ۗ وَٱللَّهُ يَعْلَمُ إِنَّكَ لَرَسُولُهُۥ وَٱللَّهُ يَشْهَدُ إِنَّ ٱلْمُنَـٰفِقِينَ لَكَـٰذِبُونَ",
      "tr": "Münafıklar sana geldikleri zaman: \"Biz gerçekten şehadet ederiz ki, sen kesin olarak Allah'ın elçisisin\" dediler. Allah da bilir ki sen elbette O'nun elçisisin. Allah, şüphesiz münafıkların yalan söylediklerine şahidlik eder.",
      "en": "When the hypocrites come to you, [O Muhammad], they say, \"We testify that you are the Messenger of Allah.\" And Allah knows that you are His Messenger, and Allah testifies that the hypocrites are liars.",
      "priority": 1,
      "surah_number": 63,
      "surah_name": "Munafikun",
      "ayah_number": 1,
      "ayah_end_number": 1,
      "status": "pending_review"
    },
    {
      "id": "063/002",
      "kind": "ayah",
      "ref": "063/002",
      "ar": "ٱتَّخَذُوٓا۟ أَيْمَـٰنَهُمْ جُنَّةً فَصَدُّوا۟ عَن سَبِيلِ ٱللَّهِ ۚ إِنَّهُمْ سَآءَ مَا كَانُوا۟ يَعْمَلُونَ",
      "tr": "Onlar, yeminlerini bir siper edinip Allah'ın yolundan alıkoydular. Doğrusu ne kötü şey yapıyorlar.",
      "en": "They have taken their oaths as a cover, so they averted [people] from the way of Allah. Indeed, it was evil that they were doing.",
      "priority": 1,
      "surah_number": 63,
      "surah_name": "Munafikun",
      "ayah_number": 2,
      "ayah_end_number": 2,
      "status": "pending_review"
    },
    {
      "id": "063/003",
      "kind": "ayah",
      "ref": "063/003",
      "ar": "ذَٰلِكَ بِأَنَّهُمْ ءَامَنُوا۟ ثُمَّ كَفَرُوا۟ فَطُبِعَ عَلَىٰ قُلُوبِهِمْ فَهُمْ لَا يَفْقَهُونَ",
      "tr": "Bu, onların iman etmeleri sonra inkar etmeleri dolayısıyla böyledir. Böylece kalplerinin üzerini mühürlemiştir, artık onlar kavrayamazlar.",
      "en": "That is because they believed, and then they disbelieved; so their hearts were sealed over, and they do not understand.",
      "priority": 1,
      "surah_number": 63,
      "surah_name": "Munafikun",
      "ayah_number": 3,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "063/004",
      "kind": "ayah",
      "ref": "063/004",
      "ar": "وَإِذَا رَأَيْتَهُمْ تُعْجِبُكَ أَجْسَامُهُمْ ۖ وَإِن يَقُولُوا۟ تَسْمَعْ لِقَوْلِهِمْ ۖ كَأَنَّهُمْ خُشُبٌ مُّسَنَّدَةٌ ۖ يَحْسَبُونَ كُلَّ صَيْحَةٍ عَلَيْهِمْ ۚ هُمُ ٱلْعَدُوُّ فَٱحْذَرْهُمْ ۚ قَـٰتَلَهُمُ ٱللَّهُ ۖ أَنَّىٰ يُؤْفَكُونَ",
      "tr": "Sen onları gördüğün zaman cüsseli yapıları beğenini kazanmaktadır. Konuştukları zaman da onları dinlersin. (Oysa) Sanki onlar (sütun gibi) dayandırılmış ahşap-kütük gibidirler. (Bu dayanıksızlıklarından dolayı da) Her çağrıyı kendileri aleyhinde sanırlar. Onlar düşmandırlar, bu yüzden onlardan kaçınıp-sakının. Allah onları kahretsin; nasıl da çevriliyorlar.",
      "en": "And when you see them, their forms please you, and if they speak, you listen to their speech. [They are] as if they were pieces of wood propped up - they think that every shout is against them. They are the enemy, so beware of them. May Allah destroy them; how are they deluded?",
      "priority": 1,
      "surah_number": 63,
      "surah_name": "Munafikun",
      "ayah_number": 4,
      "ayah_end_number": 4,
      "status": "pending_review"
    },
    {
      "id": "063/005",
      "kind": "ayah",
      "ref": "063/005",
      "ar": "وَإِذَا قِيلَ لَهُمْ تَعَالَوْا۟ يَسْتَغْفِرْ لَكُمْ رَسُولُ ٱللَّهِ لَوَّوْا۟ رُءُوسَهُمْ وَرَأَيْتَهُمْ يَصُدُّونَ وَهُم مُّسْتَكْبِرُونَ",
      "tr": "Onlara: \"Gelin Allah'ın Resûlü sizin için mağfiret (bağışlanma) dilesin,\" denildiği zaman başlarını yana çevirdiler. Sen, onların büyüklük taslamışlar olarak yüz çevirmekte olduklarını görürsün.",
      "en": "And when it is said to them, \"Come, the Messenger of Allah will ask forgiveness for you,\" they turn their heads aside and you see them evading while they are arrogant.",
      "priority": 1,
      "surah_number": 63,
      "surah_name": "Munafikun",
      "ayah_number": 5,
      "ayah_end_number": 5,
      "status": "pending_review"
    },
    {
      "id": "063/006",
      "kind": "ayah",
      "ref": "063/006",
      "ar": "سَوَآءٌ عَلَيْهِمْ أَسْتَغْفَرْتَ لَهُمْ أَمْ لَمْ تَسْتَغْفِرْ لَهُمْ لَن يَغْفِرَ ٱللَّهُ لَهُمْ ۚ إِنَّ ٱللَّهَ لَا يَهْدِى ٱلْقَوْمَ ٱلْفَـٰسِقِينَ",
      "tr": "Senin onlar adına mağfiret dilemen ile mağfiret dilememen onlar için birdir. Allah, onlara kesin olarak mağfiret etmeyecektir. Şüphesiz Allah, fasık bir kavme hidayet vermez.",
      "en": "It is all the same for them whether you ask forgiveness for them or do not ask forgiveness for them; never will Allah forgive them. Indeed, Allah does not guide the defiantly disobedient people.",
      "priority": 1,
      "surah_number": 63,
      "surah_name": "Munafikun",
      "ayah_number": 6,
      "ayah_end_number": 6,
      "status": "pending_review"
    },
    {
      "id": "063/007",
      "kind": "ayah",
      "ref": "063/007",
      "ar": "هُمُ ٱلَّذِينَ يَقُولُونَ لَا تُنفِقُوا۟ عَلَىٰ مَنْ عِندَ رَسُولِ ٱللَّهِ حَتَّىٰ يَنفَضُّوا۟ ۗ وَلِلَّهِ خَزَآئِنُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَلَـٰكِنَّ ٱلْمُنَـٰفِقِينَ لَا يَفْقَهُونَ",
      "tr": "Onlar ki: \"Allah'ın Resûlü yanında bulunanlara hiçbir infak (harcama)da bulunmayın, sonunda dağılıp gitsinler,\" derler. Oysa göklerin ve yerin hazineleri Allah'ındır. Ancak münafıklar kavramıyorlar.",
      "en": "They are the ones who say, \"Do not spend on those who are with the Messenger of Allah until they disband.\" And to Allah belongs the depositories of the heavens and the earth, but the hypocrites do not understand.",
      "priority": 1,
      "surah_number": 63,
      "surah_name": "Munafikun",
      "ayah_number": 7,
      "ayah_end_number": 7,
      "status": "pending_review"
    },
    {
      "id": "063/008",
      "kind": "ayah",
      "ref": "063/008",
      "ar": "يَقُولُونَ لَئِن رَّجَعْنَآ إِلَى ٱلْمَدِينَةِ لَيُخْرِجَنَّ ٱلْأَعَزُّ مِنْهَا ٱلْأَذَلَّ ۚ وَلِلَّهِ ٱلْعِزَّةُ وَلِرَسُولِهِۦ وَلِلْمُؤْمِنِينَ وَلَـٰكِنَّ ٱلْمُنَـٰفِقِينَ لَا يَعْلَمُونَ",
      "tr": "Derler ki, \"Andolsun, Medine'ye bir dönecek olursak, gücü ve onuru çok olan, düşkün ve zayıf olanı elbette oradan sürüp-çıkaracaktır.\" Oysa izzet (güç, onur ve üstünlük) Allah'ın, O'nun Resûlü’nün ve mü'minlerindir. Ancak münafıklar bilmiyorlar.",
      "en": "They say, \"If we return to al-Madinah, the more honored [for power] will surely expel therefrom the more humble.\" And to Allah belongs [all] honor, and to His Messenger, and to the believers, but the hypocrites do not know.",
      "priority": 1,
      "surah_number": 63,
      "surah_name": "Munafikun",
      "ayah_number": 8,
      "ayah_end_number": 8,
      "status": "pending_review"
    },
    {
      "id": "063/010",
      "kind": "ayah",
      "ref": "063/010",
      "ar": "وَأَنفِقُوا۟ مِن مَّا رَزَقْنَـٰكُم مِّن قَبْلِ أَن يَأْتِىَ أَحَدَكُمُ ٱلْمَوْتُ فَيَقُولَ رَبِّ لَوْلَآ أَخَّرْتَنِىٓ إِلَىٰٓ أَجَلٍ قَرِيبٍ فَأَصَّدَّقَ وَأَكُن مِّنَ ٱلصَّـٰلِحِينَ",
      "tr": "Sizden birinize ölüm gelip de: \"Rabbim, beni yakın bir süreye (ecele) kadar geciktirsen ben de böylece sadaka versem ve salihlerden olsam\" demezden önce, size rızık olarak verdiklerimizden infak edin.",
      "en": "And spend [in the way of Allah] from what We have provided you before death approaches one of you and he says, \"My Lord, if only You would delay me for a brief term so I would give charity and be among the righteous.\"",
      "priority": 1,
      "surah_number": 63,
      "surah_name": "Munafikun",
      "ayah_number": 10,
      "ayah_end_number": 10,
      "status": "pending_review"
    },
    {
      "id": "064/010",
      "kind": "ayah",
      "ref": "064/010",
      "ar": "وَٱلَّذِينَ كَفَرُوا۟ وَكَذَّبُوا۟ بِـَٔايَـٰتِنَآ أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلنَّارِ خَـٰلِدِينَ فِيهَا ۖ وَبِئْسَ ٱلْمَصِيرُ",
      "tr": "İnkar edip ayetlerimizi yalanlayanlara gelince; onlar da içinde sürekli kalıcılar olmak üzere, ateşin halkıdırlar. Ne kötü bir dönüş yeridir O.",
      "en": "But the ones who disbelieved and denied Our verses - those are the companions of the Fire, abiding eternally therein; and wretched is the destination.",
      "priority": 1,
      "surah_number": 64,
      "surah_name": "Tegabun",
      "ayah_number": 10,
      "ayah_end_number": 10,
      "status": "pending_review"
    },
    {
      "id": "064/011",
      "kind": "ayah",
      "ref": "064/011",
      "ar": "مَآ أَصَابَ مِن مُّصِيبَةٍ إِلَّا بِإِذْنِ ٱللَّهِ ۗ وَمَن يُؤْمِنۢ بِٱللَّهِ يَهْدِ قَلْبَهُۥ ۚ وَٱللَّهُ بِكُلِّ شَىْءٍ عَلِيمٌ",
      "tr": "Allah'ın izni olmaksızın hiçbir musibet (hiç kimseye) isabet etmez. Kim Allah'a iman ederse, onun kalbini hidayete yöneltir. Allah, herşeyi bilendir.",
      "en": "No disaster strikes except by permission of Allah. And whoever believes in Allah - He will guide his heart. And Allah is Knowing of all things.",
      "priority": 1,
      "surah_number": 64,
      "surah_name": "Tegabun",
      "ayah_number": 11,
      "ayah_end_number": 11,
      "status": "pending_review"
    },
    {
      "id": "064/012",
      "kind": "ayah",
      "ref": "064/012",
      "ar": "وَأَطِيعُوا۟ ٱللَّهَ وَأَطِيعُوا۟ ٱلرَّسُولَ ۚ فَإِن تَوَلَّيْتُمْ فَإِنَّمَا عَلَىٰ رَسُولِنَا ٱلْبَلَـٰغُ ٱلْمُبِينُ",
      "tr": "Allah'a itaat edin ve Resûle de itaat edin. Şayet yüz çevirecek olursanız, artık elçimiz üzerine düşen (yalnızca) apaçık bir tebliğ (gerçeği en yalın biçimde size iletme)dir.",
      "en": "And obey Allah and obey the Messenger; but if you turn away - then upon Our Messenger is only [the duty of] clear notification.",
      "priority": 1,
      "surah_number": 64,
      "surah_name": "Tegabun",
      "ayah_number": 12,
      "ayah_end_number": 12,
      "status": "pending_review"
    },
    {
      "id": "064/014",
      "kind": "ayah",
      "ref": "064/014",
      "ar": "يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِنَّ مِنْ أَزْوَٰجِكُمْ وَأَوْلَـٰدِكُمْ عَدُوًّا لَّكُمْ فَٱحْذَرُوهُمْ ۚ وَإِن تَعْفُوا۟ وَتَصْفَحُوا۟ وَتَغْفِرُوا۟ فَإِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ",
      "tr": "Ey iman edenler, gerçek şu ki, sizin eşlerinizden ve çocuklarınızdan bir kısmı sizler için (birer) düşmandırlar. Şu halde onlardan sakının. Yine de affeder, hoş görür (kusurlarını yüzlerine vurmaz) ve bağışlarsanız, artık elbette Allah, bağışlayandır, esirgeyendir.",
      "en": "O you who have believed, indeed, among your wives and your children are enemies to you, so beware of them. But if you pardon and overlook and forgive - then indeed, Allah is Forgiving and Merciful.",
      "priority": 1,
      "surah_number": 64,
      "surah_name": "Tegabun",
      "ayah_number": 14,
      "ayah_end_number": 14,
      "status": "pending_review"
    },
    {
      "id": "064/010-012",
      "kind": "ayah",
      "ref": "064/010-012",
      "ar": "﴿10﴾ وَٱلَّذِينَ كَفَرُوا۟ وَكَذَّبُوا۟ بِـَٔايَـٰتِنَآ أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلنَّارِ خَـٰلِدِينَ فِيهَا ۖ وَبِئْسَ ٱلْمَصِيرُ\n\n﴿11﴾ مَآ أَصَابَ مِن مُّصِيبَةٍ إِلَّا بِإِذْنِ ٱللَّهِ ۗ وَمَن يُؤْمِنۢ بِٱللَّهِ يَهْدِ قَلْبَهُۥ ۚ وَٱللَّهُ بِكُلِّ شَىْءٍ عَلِيمٌ\n\n﴿12﴾ وَأَطِيعُوا۟ ٱللَّهَ وَأَطِيعُوا۟ ٱلرَّسُولَ ۚ فَإِن تَوَلَّيْتُمْ فَإِنَّمَا عَلَىٰ رَسُولِنَا ٱلْبَلَـٰغُ ٱلْمُبِينُ",
      "tr": "[10] İnkar edip ayetlerimizi yalanlayanlara gelince; onlar da içinde sürekli kalıcılar olmak üzere, ateşin halkıdırlar. Ne kötü bir dönüş yeridir O.\n\n[11] Allah'ın izni olmaksızın hiçbir musibet (hiç kimseye) isabet etmez. Kim Allah'a iman ederse, onun kalbini hidayete yöneltir. Allah, herşeyi bilendir.\n\n[12] Allah'a itaat edin ve Resûle de itaat edin. Şayet yüz çevirecek olursanız, artık elçimiz üzerine düşen (yalnızca) apaçık bir tebliğ (gerçeği en yalın biçimde size iletme)dir.",
      "en": "[10] But the ones who disbelieved and denied Our verses - those are the companions of the Fire, abiding eternally therein; and wretched is the destination.\n\n[11] No disaster strikes except by permission of Allah. And whoever believes in Allah - He will guide his heart. And Allah is Knowing of all things.\n\n[12] And obey Allah and obey the Messenger; but if you turn away - then upon Our Messenger is only [the duty of] clear notification.",
      "priority": 1,
      "surah_number": 64,
      "surah_name": "Tegabun",
      "ayah_number": 10,
      "ayah_end_number": 12,
      "status": "pending_review"
    },
    {
      "id": "064/015",
      "kind": "ayah",
      "ref": "064/015",
      "ar": "إِنَّمَآ أَمْوَٰلُكُمْ وَأَوْلَـٰدُكُمْ فِتْنَةٌ ۚ وَٱللَّهُ عِندَهُۥٓ أَجْرٌ عَظِيمٌ",
      "tr": "Mallarınız ve çocuklarınız sizin için ancak bir fitne (bir deneme)dir. Allah ise, büyük ecir (en güzel karşılık) O'nun Katında olandır.",
      "en": "Your wealth and your children are but a trial, and Allah has with Him a great reward.",
      "priority": 1,
      "surah_number": 64,
      "surah_name": "Tegabun",
      "ayah_number": 15,
      "ayah_end_number": 15,
      "status": "pending_review"
    },
    {
      "id": "064/016",
      "kind": "ayah",
      "ref": "064/016",
      "ar": "فَٱتَّقُوا۟ ٱللَّهَ مَا ٱسْتَطَعْتُمْ وَٱسْمَعُوا۟ وَأَطِيعُوا۟ وَأَنفِقُوا۟ خَيْرًا لِّأَنفُسِكُمْ ۗ وَمَن يُوقَ شُحَّ نَفْسِهِۦ فَأُو۟لَـٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ",
      "tr": "Öyleyse güç yetirebildiğiniz kadar Allah'tan korkup-sakının, dinleyin ve itaat edin. Kendi nefsinize hayır (en büyük yarar) olmak üzere infakta bulunun. Kim nefsinin bencil-tutkularından (ya da cimri tutumundan) korunursa; işte onlar, felah (kurtuluş) bulanlardır.",
      "en": "So fear Allah as much as you are able and listen and obey and spend [in the way of Allah]; it is better for your selves. And whoever is protected from the stinginess of his soul - it is those who will be the successful.",
      "priority": 1,
      "surah_number": 64,
      "surah_name": "Tegabun",
      "ayah_number": 16,
      "ayah_end_number": 16,
      "status": "pending_review"
    },
    {
      "id": "065/001",
      "kind": "ayah",
      "ref": "065/001",
      "ar": "\\basmalah يَـٰٓأَيُّهَا ٱلنَّبِىُّ إِذَا طَلَّقْتُمُ ٱلنِّسَآءَ فَطَلِّقُوهُنَّ لِعِدَّتِهِنَّ وَأَحْصُوا۟ ٱلْعِدَّةَ ۖ وَٱتَّقُوا۟ ٱللَّهَ رَبَّكُمْ ۖ لَا تُخْرِجُوهُنَّ مِنۢ بُيُوتِهِنَّ وَلَا يَخْرُجْنَ إِلَّآ أَن يَأْتِينَ بِفَـٰحِشَةٍ مُّبَيِّنَةٍ ۚ وَتِلْكَ حُدُودُ ٱللَّهِ ۚ وَمَن يَتَعَدَّ حُدُودَ ٱللَّهِ فَقَدْ ظَلَمَ نَفْسَهُۥ ۚ لَا تَدْرِى لَعَلَّ ٱللَّهَ يُحْدِثُ بَعْدَ ذَٰلِكَ أَمْرًا",
      "tr": "Ey Peygamber, kadınları boşadığınız zaman, iddetleri süresinde (temizlendiklerinde) boşayın ve iddeti sayın. Rabbiniz Allah'tan korkun. Onları evlerinden çıkarmayın, onlar da çıkmasınlar; ancak açık 'çirkin bir hayasızlık' göstermeleri durumu başka. Bunlar Allah'ın sınırlarıdır. Kim Allah'ın sınırlarını çiğnerse, gerçekte o, kendi nefsine zulmetmiş olur. Sen bilmezsin; olabilir ki Allah, bunun arkasından bir iş (durum) oluşturur.",
      "en": "O Prophet, when you [Muslims] divorce women, divorce them for [the commencement of] their waiting period and keep count of the waiting period, and fear Allah, your Lord. Do not turn them out of their [husbands'] houses, nor should they [themselves] leave [during that period] unless they are committing a clear immorality. And those are the limits [set by] Allah. And whoever transgresses the limits of Allah has certainly wronged himself. You know not; perhaps Allah will bring about after that a [different] matter.",
      "priority": 1,
      "surah_number": 65,
      "surah_name": "Talak",
      "ayah_number": 1,
      "ayah_end_number": 1,
      "status": "pending_review"
    },
    {
      "id": "065/003",
      "kind": "ayah",
      "ref": "065/003",
      "ar": "وَيَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ ۚ وَمَن يَتَوَكَّلْ عَلَى ٱللَّهِ فَهُوَ حَسْبُهُۥٓ ۚ إِنَّ ٱللَّهَ بَـٰلِغُ أَمْرِهِۦ ۚ قَدْ جَعَلَ ٱللَّهُ لِكُلِّ شَىْءٍ قَدْرًا",
      "tr": "Ve onu hesaba katmadığı bir yönden rızıklandırır. Kim de Allah'a tevekkül ederse, O, ona yeter. Elbette Allah, Kendi emrini yerine getirip-gerçekleştirendir. Allah, herşey için bir ölçü kılmıştır.",
      "en": "And will provide for him from where he does not expect. And whoever relies upon Allah - then He is sufficient for him. Indeed, Allah will accomplish His purpose. Allah has already set for everything a [decreed] extent.",
      "priority": 1,
      "surah_number": 65,
      "surah_name": "Talak",
      "ayah_number": 3,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "066/007",
      "kind": "ayah",
      "ref": "066/007",
      "ar": "يَـٰٓأَيُّهَا ٱلَّذِينَ كَفَرُوا۟ لَا تَعْتَذِرُوا۟ ٱلْيَوْمَ ۖ إِنَّمَا تُجْزَوْنَ مَا كُنتُمْ تَعْمَلُونَ",
      "tr": "Ey inkar edenler, bugün özür beyan etmeyin. Siz ancak yaptıklarınızla cezalandırılıyorsunuz.",
      "en": "O you who have disbelieved, make no excuses that Day. You will only be recompensed for what you used to do.",
      "priority": 1,
      "surah_number": 66,
      "surah_name": "Tahrim",
      "ayah_number": 7,
      "ayah_end_number": 7,
      "status": "pending_review"
    },
    {
      "id": "066/009",
      "kind": "ayah",
      "ref": "066/009",
      "ar": "يَـٰٓأَيُّهَا ٱلنَّبِىُّ جَـٰهِدِ ٱلْكُفَّارَ وَٱلْمُنَـٰفِقِينَ وَٱغْلُظْ عَلَيْهِمْ ۚ وَمَأْوَىٰهُمْ جَهَنَّمُ ۖ وَبِئْسَ ٱلْمَصِيرُ",
      "tr": "Ey Peygamber, kafirlere ve münafıklara karşı cihad et ve onlara karşı 'sert ve caydırıcı' davran. Onların barınma yeri cehennemdir. Ne kötü bir dönüş yeridir o.",
      "en": "O Prophet, strive against the disbelievers and the hypocrites and be harsh upon them. And their refuge is Hell, and wretched is the destination.",
      "priority": 1,
      "surah_number": 66,
      "surah_name": "Tahrim",
      "ayah_number": 9,
      "ayah_end_number": 9,
      "status": "pending_review"
    },
    {
      "id": "066/010",
      "kind": "ayah",
      "ref": "066/010",
      "ar": "ضَرَبَ ٱللَّهُ مَثَلًا لِّلَّذِينَ كَفَرُوا۟ ٱمْرَأَتَ نُوحٍ وَٱمْرَأَتَ لُوطٍ ۖ كَانَتَا تَحْتَ عَبْدَيْنِ مِنْ عِبَادِنَا صَـٰلِحَيْنِ فَخَانَتَاهُمَا فَلَمْ يُغْنِيَا عَنْهُمَا مِنَ ٱللَّهِ شَيْـًٔا وَقِيلَ ٱدْخُلَا ٱلنَّارَ مَعَ ٱلدَّٰخِلِينَ",
      "tr": "Allah, inkar edenlere, Nuh'un eşini ve Lut'un eşini örnek verdi. İkisi de, kullarımızdan salih olan iki kulumuzun nikahları altındaydı; ancak onlara ihanet ettiler. Bundan dolayı, (kocaları) kendilerine Allah'tan gelen hiçbir şeyle yarar sağlamadılar. İkisine de: \"Ateşe diğer girenlerle birlikte girin\" denildi.",
      "en": "Allah presents an example of those who disbelieved: the wife of Noah and the wife of Lot. They were under two of Our righteous servants but betrayed them, so those prophets did not avail them from Allah at all, and it was said, \"Enter the Fire with those who enter.\"",
      "priority": 1,
      "surah_number": 66,
      "surah_name": "Tahrim",
      "ayah_number": 10,
      "ayah_end_number": 10,
      "status": "pending_review"
    },
    {
      "id": "066/011",
      "kind": "ayah",
      "ref": "066/011",
      "ar": "وَضَرَبَ ٱللَّهُ مَثَلًا لِّلَّذِينَ ءَامَنُوا۟ ٱمْرَأَتَ فِرْعَوْنَ إِذْ قَالَتْ رَبِّ ٱبْنِ لِى عِندَكَ بَيْتًا فِى ٱلْجَنَّةِ وَنَجِّنِى مِن فِرْعَوْنَ وَعَمَلِهِۦ وَنَجِّنِى مِنَ ٱلْقَوْمِ ٱلظَّـٰلِمِينَ",
      "tr": "Allah, iman edenlere de Firavun'un karısını örnek verdi. Hani demişti ki: \"Rabbim bana Kendi Katında, cennette bir ev yap; beni Firavun'dan ve onun yaptıklarından kurtar ve beni o zalimler topluluğundan da kurtar.\"",
      "en": "And Allah presents an example of those who believed: the wife of Pharaoh, when she said, \"My Lord, build for me near You a house in Paradise and save me from Pharaoh and his deeds and save me from the wrongdoing people.\"",
      "priority": 1,
      "surah_number": 66,
      "surah_name": "Tahrim",
      "ayah_number": 11,
      "ayah_end_number": 11,
      "status": "pending_review"
    },
    {
      "id": "066/012",
      "kind": "ayah",
      "ref": "066/012",
      "ar": "وَمَرْيَمَ ٱبْنَتَ عِمْرَٰنَ ٱلَّتِىٓ أَحْصَنَتْ فَرْجَهَا فَنَفَخْنَا فِيهِ مِن رُّوحِنَا وَصَدَّقَتْ بِكَلِمَـٰتِ رَبِّهَا وَكُتُبِهِۦ وَكَانَتْ مِنَ ٱلْقَـٰنِتِينَ",
      "tr": "İmran'ın kızı Meryem'i de. Ki o kendi ırzını korumuştu. Böylece Biz ona ruhumuzdan üfledik. O da Rabbinin kelimelerini ve kitaplarını tasdik etti. O, (Rabbine) gönülden bağlı olanlardandı.",
      "en": "And [the example of] Mary, the daughter of 'Imran, who guarded her chastity, so We blew into [her garment] through Our angel, and she believed in the words of her Lord and His scriptures and was of the devoutly obedient.",
      "priority": 1,
      "surah_number": 66,
      "surah_name": "Tahrim",
      "ayah_number": 12,
      "ayah_end_number": 12,
      "status": "pending_review"
    },
    {
      "id": "067/002",
      "kind": "ayah",
      "ref": "067/002",
      "ar": "ٱلَّذِى خَلَقَ ٱلْمَوْتَ وَٱلْحَيَوٰةَ لِيَبْلُوَكُمْ أَيُّكُمْ أَحْسَنُ عَمَلًا ۚ وَهُوَ ٱلْعَزِيزُ ٱلْغَفُورُ",
      "tr": "O, amel (davranış ve eylem) bakımından hanginizin daha iyi (ve güzel) olacağını denemek için ölümü ve hayatı yarattı. O, üstün ve güçlü olandır, çok bağışlayandır.",
      "en": "[He] who created death and life to test you [as to] which of you is best in deed - and He is the Exalted in Might, the Forgiving -",
      "priority": 1,
      "surah_number": 67,
      "surah_name": "Mulk",
      "ayah_number": 2,
      "ayah_end_number": 2,
      "status": "pending_review"
    },
    {
      "id": "067/003",
      "kind": "ayah",
      "ref": "067/003",
      "ar": "ٱلَّذِى خَلَقَ سَبْعَ سَمَـٰوَٰتٍ طِبَاقًا ۖ مَّا تَرَىٰ فِى خَلْقِ ٱلرَّحْمَـٰنِ مِن تَفَـٰوُتٍ ۖ فَٱرْجِعِ ٱلْبَصَرَ هَلْ تَرَىٰ مِن فُطُورٍ",
      "tr": "O, biri diğeriyle 'tam bir uyum’ (mutabakat) içinde yedi gök yaratmış olandır. Rahman (olan Allah)ın yaratmasında hiçbir 'çelişki ve uygunsuzluk’ (tefavüt) göremezsin. İşte gözü(nü) çevirip-gezdir; herhangi bir çatlaklık (bozukluk ve çarpıklık) görüyor musun?",
      "en": "[And] who created seven heavens in layers. You do not see in the creation of the Most Merciful any inconsistency. So return [your] vision [to the sky]; do you see any breaks?",
      "priority": 1,
      "surah_number": 67,
      "surah_name": "Mulk",
      "ayah_number": 3,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "067/010",
      "kind": "ayah",
      "ref": "067/010",
      "ar": "وَقَالُوا۟ لَوْ كُنَّا نَسْمَعُ أَوْ نَعْقِلُ مَا كُنَّا فِىٓ أَصْحَـٰبِ ٱلسَّعِيرِ",
      "tr": "Ve derler ki: \"Eğer dinlemiş olsaydık ya da akıl etmiş olsaydık, şu çılgınca yanan ateşin halkı arasında olmayacaktık.\"",
      "en": "And they will say, \"If only we had been listening or reasoning, we would not be among the companions of the Blaze.\"",
      "priority": 1,
      "surah_number": 67,
      "surah_name": "Mulk",
      "ayah_number": 10,
      "ayah_end_number": 10,
      "status": "pending_review"
    },
    {
      "id": "067/002-003",
      "kind": "ayah",
      "ref": "067/002-003",
      "ar": "﴿2﴾ ٱلَّذِى خَلَقَ ٱلْمَوْتَ وَٱلْحَيَوٰةَ لِيَبْلُوَكُمْ أَيُّكُمْ أَحْسَنُ عَمَلًا ۚ وَهُوَ ٱلْعَزِيزُ ٱلْغَفُورُ\n\n﴿3﴾ ٱلَّذِى خَلَقَ سَبْعَ سَمَـٰوَٰتٍ طِبَاقًا ۖ مَّا تَرَىٰ فِى خَلْقِ ٱلرَّحْمَـٰنِ مِن تَفَـٰوُتٍ ۖ فَٱرْجِعِ ٱلْبَصَرَ هَلْ تَرَىٰ مِن فُطُورٍ",
      "tr": "[2] O, amel (davranış ve eylem) bakımından hanginizin daha iyi (ve güzel) olacağını denemek için ölümü ve hayatı yarattı. O, üstün ve güçlü olandır, çok bağışlayandır.\n\n[3] O, biri diğeriyle 'tam bir uyum’ (mutabakat) içinde yedi gök yaratmış olandır. Rahman (olan Allah)ın yaratmasında hiçbir 'çelişki ve uygunsuzluk’ (tefavüt) göremezsin. İşte gözü(nü) çevirip-gezdir; herhangi bir çatlaklık (bozukluk ve çarpıklık) görüyor musun?",
      "en": "[2] [He] who created death and life to test you [as to] which of you is best in deed - and He is the Exalted in Might, the Forgiving -\n\n[3] [And] who created seven heavens in layers. You do not see in the creation of the Most Merciful any inconsistency. So return [your] vision [to the sky]; do you see any breaks?",
      "priority": 1,
      "surah_number": 67,
      "surah_name": "Mulk",
      "ayah_number": 2,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "067/011",
      "kind": "ayah",
      "ref": "067/011",
      "ar": "فَٱعْتَرَفُوا۟ بِذَنۢبِهِمْ فَسُحْقًا لِّأَصْحَـٰبِ ٱلسَّعِيرِ",
      "tr": "Böylece kendi günahlarını itiraf ettiler. Çılgınca yanan ateşin halkına (Allah'ın rahmetinden) uzaklık olsun.",
      "en": "And they will admit their sin, so [it is] alienation for the companions of the Blaze.",
      "priority": 1,
      "surah_number": 67,
      "surah_name": "Mulk",
      "ayah_number": 11,
      "ayah_end_number": 11,
      "status": "pending_review"
    },
    {
      "id": "067/029",
      "kind": "ayah",
      "ref": "067/029",
      "ar": "قُلْ هُوَ ٱلرَّحْمَـٰنُ ءَامَنَّا بِهِۦ وَعَلَيْهِ تَوَكَّلْنَا ۖ فَسَتَعْلَمُونَ مَنْ هُوَ فِى ضَلَـٰلٍ مُّبِينٍ",
      "tr": "De ki: \"O (Allah) Rahman olan (esirgeyen koruyan)dır; biz O'na iman ettik ve O'na tevekkül ettik. Artık siz kimin açık bir sapmışlık içinde olduğunu pek yakında bileceksiniz.\"",
      "en": "Say, \"He is the Most Merciful; we have believed in Him, and upon Him we have relied. And you will [come to] know who it is that is in clear error.\"",
      "priority": 1,
      "surah_number": 67,
      "surah_name": "Mulk",
      "ayah_number": 29,
      "ayah_end_number": 29,
      "status": "pending_review"
    },
    {
      "id": "067/010-011",
      "kind": "ayah",
      "ref": "067/010-011",
      "ar": "﴿10﴾ وَقَالُوا۟ لَوْ كُنَّا نَسْمَعُ أَوْ نَعْقِلُ مَا كُنَّا فِىٓ أَصْحَـٰبِ ٱلسَّعِيرِ\n\n﴿11﴾ فَٱعْتَرَفُوا۟ بِذَنۢبِهِمْ فَسُحْقًا لِّأَصْحَـٰبِ ٱلسَّعِيرِ",
      "tr": "[10] Ve derler ki: \"Eğer dinlemiş olsaydık ya da akıl etmiş olsaydık, şu çılgınca yanan ateşin halkı arasında olmayacaktık.\"\n\n[11] Böylece kendi günahlarını itiraf ettiler. Çılgınca yanan ateşin halkına (Allah'ın rahmetinden) uzaklık olsun.",
      "en": "[10] And they will say, \"If only we had been listening or reasoning, we would not be among the companions of the Blaze.\"\n\n[11] And they will admit their sin, so [it is] alienation for the companions of the Blaze.",
      "priority": 1,
      "surah_number": 67,
      "surah_name": "Mulk",
      "ayah_number": 10,
      "ayah_end_number": 11,
      "status": "pending_review"
    },
    {
      "id": "068/004",
      "kind": "ayah",
      "ref": "068/004",
      "ar": "وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ",
      "tr": "Ve şüphesiz sen, pek büyük bir ahlak üzerindesin.",
      "en": "And indeed, you are of a great moral character.",
      "priority": 1,
      "surah_number": 68,
      "surah_name": "Kalem",
      "ayah_number": 4,
      "ayah_end_number": 4,
      "status": "pending_review"
    },
    {
      "id": "068/008",
      "kind": "ayah",
      "ref": "068/008",
      "ar": "فَلَا تُطِعِ ٱلْمُكَذِّبِينَ",
      "tr": "Şu halde yalanlayanlara itaat etme.",
      "en": "Then do not obey the deniers.",
      "priority": 1,
      "surah_number": 68,
      "surah_name": "Kalem",
      "ayah_number": 8,
      "ayah_end_number": 8,
      "status": "pending_review"
    },
    {
      "id": "068/009",
      "kind": "ayah",
      "ref": "068/009",
      "ar": "وَدُّوا۟ لَوْ تُدْهِنُ فَيُدْهِنُونَ",
      "tr": "Onlar, senin kendilerine yaranmanı (uzlaşmanı) arzu ettiler; o zaman onlar da sana yaranıp-uzlaşacaklardı.",
      "en": "They wish that you would soften [in your position], so they would soften [toward you].",
      "priority": 1,
      "surah_number": 68,
      "surah_name": "Kalem",
      "ayah_number": 9,
      "ayah_end_number": 9,
      "status": "pending_review"
    },
    {
      "id": "068/031",
      "kind": "ayah",
      "ref": "068/031",
      "ar": "قَالُوا۟ يَـٰوَيْلَنَآ إِنَّا كُنَّا طَـٰغِينَ",
      "tr": "\"Yazıklar bize, gerçekten bizler azgınmışız\" dediler.",
      "en": "They said, \"O woe to us; indeed we were transgressors.",
      "priority": 1,
      "surah_number": 68,
      "surah_name": "Kalem",
      "ayah_number": 31,
      "ayah_end_number": 31,
      "status": "pending_review"
    },
    {
      "id": "068/008-009",
      "kind": "ayah",
      "ref": "068/008-009",
      "ar": "﴿8﴾ فَلَا تُطِعِ ٱلْمُكَذِّبِينَ\n\n﴿9﴾ وَدُّوا۟ لَوْ تُدْهِنُ فَيُدْهِنُونَ",
      "tr": "[8] Şu halde yalanlayanlara itaat etme.\n\n[9] Onlar, senin kendilerine yaranmanı (uzlaşmanı) arzu ettiler; o zaman onlar da sana yaranıp-uzlaşacaklardı.",
      "en": "[8] Then do not obey the deniers.\n\n[9] They wish that you would soften [in your position], so they would soften [toward you].",
      "priority": 1,
      "surah_number": 68,
      "surah_name": "Kalem",
      "ayah_number": 8,
      "ayah_end_number": 9,
      "status": "pending_review"
    },
    {
      "id": "068/034",
      "kind": "ayah",
      "ref": "068/034",
      "ar": "إِنَّ لِلْمُتَّقِينَ عِندَ رَبِّهِمْ جَنَّـٰتِ ٱلنَّعِيمِ",
      "tr": "Doğrusu, muttaki olanlar için Rableri Katında nimetlerle donatılmış cennetler vardır.",
      "en": "Indeed, for the righteous with their Lord are the Gardens of Pleasure.",
      "priority": 1,
      "surah_number": 68,
      "surah_name": "Kalem",
      "ayah_number": 34,
      "ayah_end_number": 34,
      "status": "pending_review"
    },
    {
      "id": "068/035",
      "kind": "ayah",
      "ref": "068/035",
      "ar": "أَفَنَجْعَلُ ٱلْمُسْلِمِينَ كَٱلْمُجْرِمِينَ",
      "tr": "Öyleyse, Müslümanları suçlu-günahkar olanlar gibi (eşit) kılar mıyız?",
      "en": "Then will We treat the Muslims like the criminals?",
      "priority": 1,
      "surah_number": 68,
      "surah_name": "Kalem",
      "ayah_number": 35,
      "ayah_end_number": 35,
      "status": "pending_review"
    },
    {
      "id": "068/036",
      "kind": "ayah",
      "ref": "068/036",
      "ar": "مَا لَكُمْ كَيْفَ تَحْكُمُونَ",
      "tr": "Size ne oluyor? Nasıl hüküm veriyorsunuz?",
      "en": "What is [the matter] with you? How do you judge?",
      "priority": 1,
      "surah_number": 68,
      "surah_name": "Kalem",
      "ayah_number": 36,
      "ayah_end_number": 36,
      "status": "pending_review"
    },
    {
      "id": "069/004",
      "kind": "ayah",
      "ref": "069/004",
      "ar": "كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ",
      "tr": "Semud ve Ad (toplumları), karia’yı yalan saydılar.",
      "en": "Thamud and 'Aad denied the Striking Calamity.",
      "priority": 1,
      "surah_number": 69,
      "surah_name": "Hakka",
      "ayah_number": 4,
      "ayah_end_number": 4,
      "status": "pending_review"
    },
    {
      "id": "069/005",
      "kind": "ayah",
      "ref": "069/005",
      "ar": "فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ",
      "tr": "Bu nedenle Semud (halkı), korkunç bir sesle helak edildi.",
      "en": "So as for Thamud, they were destroyed by the overpowering [blast].",
      "priority": 1,
      "surah_number": 69,
      "surah_name": "Hakka",
      "ayah_number": 5,
      "ayah_end_number": 5,
      "status": "pending_review"
    },
    {
      "id": "069/006",
      "kind": "ayah",
      "ref": "069/006",
      "ar": "وَأَمَّا عَادٌ فَأُهْلِكُوا۟ بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ",
      "tr": "Ad (halkın)a gelince; onlar da, uğultu yüklü, azgın bir kasırga ile helak edildiler.",
      "en": "And as for 'Aad, they were destroyed by a screaming, violent wind",
      "priority": 1,
      "surah_number": 69,
      "surah_name": "Hakka",
      "ayah_number": 6,
      "ayah_end_number": 6,
      "status": "pending_review"
    },
    {
      "id": "069/008",
      "kind": "ayah",
      "ref": "069/008",
      "ar": "فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٍ",
      "tr": "Şimdi onlardan hiç arta kalan (bir şey) görüyor musun?",
      "en": "Then do you see of them any remains?",
      "priority": 1,
      "surah_number": 69,
      "surah_name": "Hakka",
      "ayah_number": 8,
      "ayah_end_number": 8,
      "status": "pending_review"
    },
    {
      "id": "069/004-006",
      "kind": "ayah",
      "ref": "069/004-006",
      "ar": "﴿4﴾ كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ\n\n﴿5﴾ فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ\n\n﴿6﴾ وَأَمَّا عَادٌ فَأُهْلِكُوا۟ بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ",
      "tr": "[4] Semud ve Ad (toplumları), karia’yı yalan saydılar.\n\n[5] Bu nedenle Semud (halkı), korkunç bir sesle helak edildi.\n\n[6] Ad (halkın)a gelince; onlar da, uğultu yüklü, azgın bir kasırga ile helak edildiler.",
      "en": "[4] Thamud and 'Aad denied the Striking Calamity.\n\n[5] So as for Thamud, they were destroyed by the overpowering [blast].\n\n[6] And as for 'Aad, they were destroyed by a screaming, violent wind",
      "priority": 1,
      "surah_number": 69,
      "surah_name": "Hakka",
      "ayah_number": 4,
      "ayah_end_number": 6,
      "status": "pending_review"
    },
    {
      "id": "069/013",
      "kind": "ayah",
      "ref": "069/013",
      "ar": "فَإِذَا نُفِخَ فِى ٱلصُّورِ نَفْخَةٌ وَٰحِدَةٌ",
      "tr": "Artık sur'a tek bir üfürülüşle üfürüleceği.",
      "en": "Then when the Horn is blown with one blast",
      "priority": 1,
      "surah_number": 69,
      "surah_name": "Hakka",
      "ayah_number": 13,
      "ayah_end_number": 13,
      "status": "pending_review"
    },
    {
      "id": "069/014",
      "kind": "ayah",
      "ref": "069/014",
      "ar": "وَحُمِلَتِ ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا دَكَّةً وَٰحِدَةً",
      "tr": "Yeryüzü ve dağlar yerlerinden oynatılıp kaldırılacağı, ardından tek bir çarpma ile birbirlerine çarpılıp parça parça olacağı zaman.",
      "en": "And the earth and the mountains are lifted and leveled with one blow -",
      "priority": 1,
      "surah_number": 69,
      "surah_name": "Hakka",
      "ayah_number": 14,
      "ayah_end_number": 14,
      "status": "pending_review"
    },
    {
      "id": "069/015",
      "kind": "ayah",
      "ref": "069/015",
      "ar": "فَيَوْمَئِذٍ وَقَعَتِ ٱلْوَاقِعَةُ",
      "tr": "İşte o gün, vakıa (bir gerçek olan kıyamet) artık vukubulmuş (gerçekleşmiş)tur.",
      "en": "Then on that Day, the Resurrection will occur,",
      "priority": 1,
      "surah_number": 69,
      "surah_name": "Hakka",
      "ayah_number": 15,
      "ayah_end_number": 15,
      "status": "pending_review"
    },
    {
      "id": "069/016",
      "kind": "ayah",
      "ref": "069/016",
      "ar": "وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِىَ يَوْمَئِذٍ وَاهِيَةٌ",
      "tr": "Gök yarılıp-çatlamıştır; artık o gün, 'sarkmış-za'fa uğramıştır.'",
      "en": "And the heaven will split [open], for that Day it is infirm.",
      "priority": 1,
      "surah_number": 69,
      "surah_name": "Hakka",
      "ayah_number": 16,
      "ayah_end_number": 16,
      "status": "pending_review"
    },
    {
      "id": "069/042",
      "kind": "ayah",
      "ref": "069/042",
      "ar": "وَلَا بِقَوْلِ كَاهِنٍ ۚ قَلِيلًا مَّا تَذَكَّرُونَ",
      "tr": "Bir kahinin de sözü değildir. Ne az öğüt alıp-düşünüyorsunuz?",
      "en": "Nor the word of a soothsayer; little do you remember.",
      "priority": 1,
      "surah_number": 69,
      "surah_name": "Hakka",
      "ayah_number": 42,
      "ayah_end_number": 42,
      "status": "pending_review"
    },
    {
      "id": "069/013-016",
      "kind": "ayah",
      "ref": "069/013-016",
      "ar": "﴿13﴾ فَإِذَا نُفِخَ فِى ٱلصُّورِ نَفْخَةٌ وَٰحِدَةٌ\n\n﴿14﴾ وَحُمِلَتِ ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا دَكَّةً وَٰحِدَةً\n\n﴿15﴾ فَيَوْمَئِذٍ وَقَعَتِ ٱلْوَاقِعَةُ\n\n﴿16﴾ وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِىَ يَوْمَئِذٍ وَاهِيَةٌ",
      "tr": "[13] Artık sur'a tek bir üfürülüşle üfürüleceği.\n\n[14] Yeryüzü ve dağlar yerlerinden oynatılıp kaldırılacağı, ardından tek bir çarpma ile birbirlerine çarpılıp parça parça olacağı zaman.\n\n[15] İşte o gün, vakıa (bir gerçek olan kıyamet) artık vukubulmuş (gerçekleşmiş)tur.\n\n[16] Gök yarılıp-çatlamıştır; artık o gün, 'sarkmış-za'fa uğramıştır.'",
      "en": "[13] Then when the Horn is blown with one blast\n\n[14] And the earth and the mountains are lifted and leveled with one blow -\n\n[15] Then on that Day, the Resurrection will occur,\n\n[16] And the heaven will split [open], for that Day it is infirm.",
      "priority": 1,
      "surah_number": 69,
      "surah_name": "Hakka",
      "ayah_number": 13,
      "ayah_end_number": 16,
      "status": "pending_review"
    },
    {
      "id": "070/004",
      "kind": "ayah",
      "ref": "070/004",
      "ar": "تَعْرُجُ ٱلْمَلَـٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍ",
      "tr": "Melekler ve Ruh (Cebrail), ona, süresi elli bin yıl olan bir günde çıkabilmektedir.",
      "en": "The angels and the Spirit will ascend to Him during a Day the extent of which is fifty thousand years.",
      "priority": 1,
      "surah_number": 70,
      "surah_name": "Mearic",
      "ayah_number": 4,
      "ayah_end_number": 4,
      "status": "pending_review"
    },
    {
      "id": "070/008",
      "kind": "ayah",
      "ref": "070/008",
      "ar": "يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ",
      "tr": "Gökyüzünün erimiş maden gibi olacağı gün;",
      "en": "On the Day the sky will be like murky oil,",
      "priority": 1,
      "surah_number": 70,
      "surah_name": "Mearic",
      "ayah_number": 8,
      "ayah_end_number": 8,
      "status": "pending_review"
    },
    {
      "id": "070/009",
      "kind": "ayah",
      "ref": "070/009",
      "ar": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ",
      "tr": "Dağlar da (etrafa uçuşmuş) rengarenk yün gibi olacak.",
      "en": "And the mountains will be like wool,",
      "priority": 1,
      "surah_number": 70,
      "surah_name": "Mearic",
      "ayah_number": 9,
      "ayah_end_number": 9,
      "status": "pending_review"
    },
    {
      "id": "070/026",
      "kind": "ayah",
      "ref": "070/026",
      "ar": "وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ",
      "tr": "Onlar, din gününü tasdik etmektedirler.",
      "en": "And those who believe in the Day of Recompense",
      "priority": 1,
      "surah_number": 70,
      "surah_name": "Mearic",
      "ayah_number": 26,
      "ayah_end_number": 26,
      "status": "pending_review"
    },
    {
      "id": "070/008-009",
      "kind": "ayah",
      "ref": "070/008-009",
      "ar": "﴿8﴾ يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ\n\n﴿9﴾ وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ",
      "tr": "[8] Gökyüzünün erimiş maden gibi olacağı gün;\n\n[9] Dağlar da (etrafa uçuşmuş) rengarenk yün gibi olacak.",
      "en": "[8] On the Day the sky will be like murky oil,\n\n[9] And the mountains will be like wool,",
      "priority": 1,
      "surah_number": 70,
      "surah_name": "Mearic",
      "ayah_number": 8,
      "ayah_end_number": 9,
      "status": "pending_review"
    },
    {
      "id": "070/032",
      "kind": "ayah",
      "ref": "070/032",
      "ar": "وَٱلَّذِينَ هُمْ لِأَمَـٰنَـٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ",
      "tr": "(Bir de) Onlar, kendilerine verilen emanete ve verdikleri ahde (harfiyyen) riayet edenlerdir.",
      "en": "And those who are to their trusts and promises attentive",
      "priority": 1,
      "surah_number": 70,
      "surah_name": "Mearic",
      "ayah_number": 32,
      "ayah_end_number": 32,
      "status": "pending_review"
    },
    {
      "id": "070/042",
      "kind": "ayah",
      "ref": "070/042",
      "ar": "فَذَرْهُمْ يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ يُلَـٰقُوا۟ يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ",
      "tr": "Şu halde sen, kendilerine vadedilen (azap) günlerine kavuşuncaya kadar onları bırak; dalıp-oynasınlar, oyalansınlar.",
      "en": "So leave them to converse vainly and amuse themselves until they meet their Day which they are promised -",
      "priority": 1,
      "surah_number": 70,
      "surah_name": "Mearic",
      "ayah_number": 42,
      "ayah_end_number": 42,
      "status": "pending_review"
    },
    {
      "id": "071/007",
      "kind": "ayah",
      "ref": "071/007",
      "ar": "وَإِنِّى كُلَّمَا دَعَوْتُهُمْ لِتَغْفِرَ لَهُمْ جَعَلُوٓا۟ أَصَـٰبِعَهُمْ فِىٓ ءَاذَانِهِمْ وَٱسْتَغْشَوْا۟ ثِيَابَهُمْ وَأَصَرُّوا۟ وَٱسْتَكْبَرُوا۟ ٱسْتِكْبَارًا",
      "tr": "\"Doğrusu ben, onları bağışlaman için her davet edişimde, onlar parmaklarını kulaklarına tıkadılar, örtülerini başlarına çektiler ve büyüklük tasladıkça büyüklük gösterip-direttiler.'",
      "en": "And indeed, every time I invited them that You may forgive them, they put their fingers in their ears, covered themselves with their garments, persisted, and were arrogant with [great] arrogance.",
      "priority": 1,
      "surah_number": 71,
      "surah_name": "Nuh",
      "ayah_number": 7,
      "ayah_end_number": 7,
      "status": "pending_review"
    },
    {
      "id": "071/015",
      "kind": "ayah",
      "ref": "071/015",
      "ar": "أَلَمْ تَرَوْا۟ كَيْفَ خَلَقَ ٱللَّهُ سَبْعَ سَمَـٰوَٰتٍ طِبَاقًا",
      "tr": "\"Görmüyor musunuz; Allah, yedi göğü birbirleriyle bir uyum (mutabakat) içinde yaratmıştır?\"",
      "en": "Do you not consider how Allah has created seven heavens in layers",
      "priority": 1,
      "surah_number": 71,
      "surah_name": "Nuh",
      "ayah_number": 15,
      "ayah_end_number": 15,
      "status": "pending_review"
    },
    {
      "id": "071/023",
      "kind": "ayah",
      "ref": "071/023",
      "ar": "وَقَالُوا۟ لَا تَذَرُنَّ ءَالِهَتَكُمْ وَلَا تَذَرُنَّ وَدًّا وَلَا سُوَاعًا وَلَا يَغُوثَ وَيَعُوقَ وَنَسْرًا",
      "tr": "\"Ve dediler ki: Kendi ilahlarınızı bırakmayın; bırakmayın ne Vedd'i, ne Suva'ı, ne Yeğus'u, ne Ye'uk'u ve ne de Nesr'i.\"",
      "en": "And said, 'Never leave your gods and never leave Wadd or Suwa' or Yaghuth and Ya'uq and Nasr.",
      "priority": 1,
      "surah_number": 71,
      "surah_name": "Nuh",
      "ayah_number": 23,
      "ayah_end_number": 23,
      "status": "pending_review"
    },
    {
      "id": "072/021",
      "kind": "ayah",
      "ref": "072/021",
      "ar": "قُلْ إِنِّى لَآ أَمْلِكُ لَكُمْ ضَرًّا وَلَا رَشَدًا",
      "tr": "De ki: \"Doğrusu ben, sizin için ne bir zarar, ne de bir yarar (irşad) sağlayabilirim.\"",
      "en": "Say, \"Indeed, I do not possess for you [the power of] harm or right direction.\"",
      "priority": 1,
      "surah_number": 72,
      "surah_name": "Cin",
      "ayah_number": 21,
      "ayah_end_number": 21,
      "status": "pending_review"
    },
    {
      "id": "073/004",
      "kind": "ayah",
      "ref": "073/004",
      "ar": "أَوْ زِدْ عَلَيْهِ وَرَتِّلِ ٱلْقُرْءَانَ تَرْتِيلًا",
      "tr": "Veya üzerine ilave et. Ve Kur'an'ı belli bir düzen içinde (tertil üzere) oku.",
      "en": "Or add to it, and recite the Qur'an with measured recitation.",
      "priority": 1,
      "surah_number": 73,
      "surah_name": "Muzzemmil",
      "ayah_number": 4,
      "ayah_end_number": 4,
      "status": "pending_review"
    },
    {
      "id": "073/014",
      "kind": "ayah",
      "ref": "073/014",
      "ar": "يَوْمَ تَرْجُفُ ٱلْأَرْضُ وَٱلْجِبَالُ وَكَانَتِ ٱلْجِبَالُ كَثِيبًا مَّهِيلًا",
      "tr": "(Öyle) Bir gün ki, yeryüzü ve dağlar titremeye-tutulur ve dağlar göçüveren bir kum yığını olur.",
      "en": "On the Day the earth and the mountains will convulse and the mountains will become a heap of sand pouring down.",
      "priority": 1,
      "surah_number": 73,
      "surah_name": "Muzzemmil",
      "ayah_number": 14,
      "ayah_end_number": 14,
      "status": "pending_review"
    },
    {
      "id": "073/015",
      "kind": "ayah",
      "ref": "073/015",
      "ar": "إِنَّآ أَرْسَلْنَآ إِلَيْكُمْ رَسُولًا شَـٰهِدًا عَلَيْكُمْ كَمَآ أَرْسَلْنَآ إِلَىٰ فِرْعَوْنَ رَسُولًا",
      "tr": "Şüphesiz size, üzerinize şahid olacak bir elçi gönderdik; Firavun'a bir elçi gönderdiğimiz gibi.",
      "en": "Indeed, We have sent to you a Messenger as a witness upon you just as We sent to Pharaoh a messenger.",
      "priority": 1,
      "surah_number": 73,
      "surah_name": "Muzzemmil",
      "ayah_number": 15,
      "ayah_end_number": 15,
      "status": "pending_review"
    },
    {
      "id": "074/006",
      "kind": "ayah",
      "ref": "074/006",
      "ar": "وَلَا تَمْنُن تَسْتَكْثِرُ",
      "tr": "Daha çok istekte bulunmak için iyilik yapma.",
      "en": "And do not confer favor to acquire more",
      "priority": 1,
      "surah_number": 74,
      "surah_name": "Mudessir",
      "ayah_number": 6,
      "ayah_end_number": 6,
      "status": "pending_review"
    },
    {
      "id": "074/024",
      "kind": "ayah",
      "ref": "074/024",
      "ar": "فَقَالَ إِنْ هَـٰذَآ إِلَّا سِحْرٌ يُؤْثَرُ",
      "tr": "Böylece: \"Bu, yalnızca 'aktarılarak öğrenilen' bir büyüdür\" dedi.",
      "en": "And said, \"This is not but magic imitated [from others].",
      "priority": 1,
      "surah_number": 74,
      "surah_name": "Mudessir",
      "ayah_number": 24,
      "ayah_end_number": 24,
      "status": "pending_review"
    },
    {
      "id": "074/048",
      "kind": "ayah",
      "ref": "074/048",
      "ar": "فَمَا تَنفَعُهُمْ شَفَـٰعَةُ ٱلشَّـٰفِعِينَ",
      "tr": "Artık, şefaat edenlerin şefaati onlara bir yarar sağlamaz.",
      "en": "So there will not benefit them the intercession of [any] intercessors.",
      "priority": 1,
      "surah_number": 74,
      "surah_name": "Mudessir",
      "ayah_number": 48,
      "ayah_end_number": 48,
      "status": "pending_review"
    },
    {
      "id": "075/005",
      "kind": "ayah",
      "ref": "075/005",
      "ar": "بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ",
      "tr": "Ancak insan, önündeki (sonsuz geleceği)ni de 'fücurla sürdürmek ister.'",
      "en": "But man desires to continue in sin.",
      "priority": 1,
      "surah_number": 75,
      "surah_name": "Kiyame",
      "ayah_number": 5,
      "ayah_end_number": 5,
      "status": "pending_review"
    },
    {
      "id": "075/016",
      "kind": "ayah",
      "ref": "075/016",
      "ar": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ",
      "tr": "Onu (Kur'an'ı, kavrayıp belletmek için) aceleye kapılıp dilini onunla hareket ettirip-durma.",
      "en": "Move not your tongue with it, [O Muhammad], to hasten with recitation of the Qur'an.",
      "priority": 1,
      "surah_number": 75,
      "surah_name": "Kiyame",
      "ayah_number": 16,
      "ayah_end_number": 16,
      "status": "pending_review"
    },
    {
      "id": "075/017",
      "kind": "ayah",
      "ref": "075/017",
      "ar": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ",
      "tr": "Şüphesiz, onu (kalbinde) toplamak ve onu (sana) okutmak Bize ait (bir iş)tir.",
      "en": "Indeed, upon Us is its collection [in your heart] and [to make possible] its recitation.",
      "priority": 1,
      "surah_number": 75,
      "surah_name": "Kiyame",
      "ayah_number": 17,
      "ayah_end_number": 17,
      "status": "pending_review"
    },
    {
      "id": "075/018",
      "kind": "ayah",
      "ref": "075/018",
      "ar": "فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ",
      "tr": "Şu halde, Biz onu okuduğumuz zaman, sen de onun okunuşunu izle.",
      "en": "So when We have recited it [through Gabriel], then follow its recitation.",
      "priority": 1,
      "surah_number": 75,
      "surah_name": "Kiyame",
      "ayah_number": 18,
      "ayah_end_number": 18,
      "status": "pending_review"
    },
    {
      "id": "076/002",
      "kind": "ayah",
      "ref": "076/002",
      "ar": "إِنَّا خَلَقْنَا ٱلْإِنسَـٰنَ مِن نُّطْفَةٍ أَمْشَاجٍ نَّبْتَلِيهِ فَجَعَلْنَـٰهُ سَمِيعًۢا بَصِيرًا",
      "tr": "Şüphesiz Biz insanı, karmaşık olan bir damla sudan yarattık. Onu deniyoruz. Bundan dolayı onu işiten ve gören yaptık.",
      "en": "Indeed, We created man from a sperm-drop mixture that We may try him; and We made him hearing and seeing.",
      "priority": 1,
      "surah_number": 76,
      "surah_name": "Insan",
      "ayah_number": 2,
      "ayah_end_number": 2,
      "status": "pending_review"
    },
    {
      "id": "076/008",
      "kind": "ayah",
      "ref": "076/008",
      "ar": "وَيُطْعِمُونَ ٱلطَّعَامَ عَلَىٰ حُبِّهِۦ مِسْكِينًا وَيَتِيمًا وَأَسِيرًا",
      "tr": "Kendileri, ona duydukları sevgiye rağmen yemeği, yoksula, yetime ve esire yedirirler.",
      "en": "And they give food in spite of love for it to the needy, the orphan, and the captive,",
      "priority": 1,
      "surah_number": 76,
      "surah_name": "Insan",
      "ayah_number": 8,
      "ayah_end_number": 8,
      "status": "pending_review"
    },
    {
      "id": "076/009",
      "kind": "ayah",
      "ref": "076/009",
      "ar": "إِنَّمَا نُطْعِمُكُمْ لِوَجْهِ ٱللَّهِ لَا نُرِيدُ مِنكُمْ جَزَآءً وَلَا شُكُورًا",
      "tr": "\"Biz size, ancak Allah'ın yüzü (rızası) için yediriyoruz; sizden ne bir karşılık istiyoruz, ne bir teşekkür.\"",
      "en": "[Saying], \"We feed you only for the countenance of Allah. We wish not from you reward or gratitude.",
      "priority": 1,
      "surah_number": 76,
      "surah_name": "Insan",
      "ayah_number": 9,
      "ayah_end_number": 9,
      "status": "pending_review"
    },
    {
      "id": "076/015",
      "kind": "ayah",
      "ref": "076/015",
      "ar": "وَيُطَافُ عَلَيْهِم بِـَٔانِيَةٍ مِّن فِضَّةٍ وَأَكْوَابٍ كَانَتْ قَوَارِيرَا۠",
      "tr": "Çevrelerinde gümüşten billur kablar, kupalar dolaştırılır.",
      "en": "And there will be circulated among them vessels of silver and cups having been [created] clear [as glass],",
      "priority": 1,
      "surah_number": 76,
      "surah_name": "Insan",
      "ayah_number": 15,
      "ayah_end_number": 15,
      "status": "pending_review"
    },
    {
      "id": "076/008-009",
      "kind": "ayah",
      "ref": "076/008-009",
      "ar": "﴿8﴾ وَيُطْعِمُونَ ٱلطَّعَامَ عَلَىٰ حُبِّهِۦ مِسْكِينًا وَيَتِيمًا وَأَسِيرًا\n\n﴿9﴾ إِنَّمَا نُطْعِمُكُمْ لِوَجْهِ ٱللَّهِ لَا نُرِيدُ مِنكُمْ جَزَآءً وَلَا شُكُورًا",
      "tr": "[8] Kendileri, ona duydukları sevgiye rağmen yemeği, yoksula, yetime ve esire yedirirler.\n\n[9] \"Biz size, ancak Allah'ın yüzü (rızası) için yediriyoruz; sizden ne bir karşılık istiyoruz, ne bir teşekkür.\"",
      "en": "[8] And they give food in spite of love for it to the needy, the orphan, and the captive,\n\n[9] [Saying], \"We feed you only for the countenance of Allah. We wish not from you reward or gratitude.",
      "priority": 1,
      "surah_number": 76,
      "surah_name": "Insan",
      "ayah_number": 8,
      "ayah_end_number": 9,
      "status": "pending_review"
    },
    {
      "id": "076/016",
      "kind": "ayah",
      "ref": "076/016",
      "ar": "قَوَارِيرَا۟ مِن فِضَّةٍ قَدَّرُوهَا تَقْدِيرًا",
      "tr": "Gümüşten billur kaplar ki, onları belli bir ölçüyle tespit etmişlerdir.",
      "en": "Clear glasses [made] from silver of which they have determined the measure.",
      "priority": 1,
      "surah_number": 76,
      "surah_name": "Insan",
      "ayah_number": 16,
      "ayah_end_number": 16,
      "status": "pending_review"
    },
    {
      "id": "076/024",
      "kind": "ayah",
      "ref": "076/024",
      "ar": "فَٱصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تُطِعْ مِنْهُمْ ءَاثِمًا أَوْ كَفُورًا",
      "tr": "Öyleyse, Rabbinin hükmüne sabır göster. Onlardan günahkar veya nankör olana itaat etme.",
      "en": "So be patient for the decision of your Lord and do not obey from among them a sinner or ungrateful [disbeliever].",
      "priority": 1,
      "surah_number": 76,
      "surah_name": "Insan",
      "ayah_number": 24,
      "ayah_end_number": 24,
      "status": "pending_review"
    },
    {
      "id": "076/015-016",
      "kind": "ayah",
      "ref": "076/015-016",
      "ar": "﴿15﴾ وَيُطَافُ عَلَيْهِم بِـَٔانِيَةٍ مِّن فِضَّةٍ وَأَكْوَابٍ كَانَتْ قَوَارِيرَا۠\n\n﴿16﴾ قَوَارِيرَا۟ مِن فِضَّةٍ قَدَّرُوهَا تَقْدِيرًا",
      "tr": "[15] Çevrelerinde gümüşten billur kablar, kupalar dolaştırılır.\n\n[16] Gümüşten billur kaplar ki, onları belli bir ölçüyle tespit etmişlerdir.",
      "en": "[15] And there will be circulated among them vessels of silver and cups having been [created] clear [as glass],\n\n[16] Clear glasses [made] from silver of which they have determined the measure.",
      "priority": 1,
      "surah_number": 76,
      "surah_name": "Insan",
      "ayah_number": 15,
      "ayah_end_number": 16,
      "status": "pending_review"
    },
    {
      "id": "076/030",
      "kind": "ayah",
      "ref": "076/030",
      "ar": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمًا",
      "tr": "Allah dilemedikçe siz dileyemezsiniz. Gerçekten Allah, bilendir, hüküm ve hikmet sahibidir.",
      "en": "And you do not will except that Allah wills. Indeed, Allah is ever Knowing and Wise.",
      "priority": 1,
      "surah_number": 76,
      "surah_name": "Insan",
      "ayah_number": 30,
      "ayah_end_number": 30,
      "status": "pending_review"
    },
    {
      "id": "077/008",
      "kind": "ayah",
      "ref": "077/008",
      "ar": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ",
      "tr": "Yıldızlar 'örtülüp (ışıkları) silindiği' zaman,",
      "en": "So when the stars are obliterated",
      "priority": 1,
      "surah_number": 77,
      "surah_name": "Murselat",
      "ayah_number": 8,
      "ayah_end_number": 8,
      "status": "pending_review"
    },
    {
      "id": "077/009",
      "kind": "ayah",
      "ref": "077/009",
      "ar": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ",
      "tr": "Gök yarıldığı zaman",
      "en": "And when the heaven is opened",
      "priority": 1,
      "surah_number": 77,
      "surah_name": "Murselat",
      "ayah_number": 9,
      "ayah_end_number": 9,
      "status": "pending_review"
    },
    {
      "id": "077/010",
      "kind": "ayah",
      "ref": "077/010",
      "ar": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ",
      "tr": "Dağlar, kökünden sökülüp savurulduğu zaman,",
      "en": "And when the mountains are blown away",
      "priority": 1,
      "surah_number": 77,
      "surah_name": "Murselat",
      "ayah_number": 10,
      "ayah_end_number": 10,
      "status": "pending_review"
    },
    {
      "id": "077/011",
      "kind": "ayah",
      "ref": "077/011",
      "ar": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ",
      "tr": "Ve resuller de (şahitlik için) belli bir vakitte getirildiği zaman",
      "en": "And when the messengers' time has come...",
      "priority": 1,
      "surah_number": 77,
      "surah_name": "Murselat",
      "ayah_number": 11,
      "ayah_end_number": 11,
      "status": "pending_review"
    },
    {
      "id": "078/006",
      "kind": "ayah",
      "ref": "078/006",
      "ar": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَـٰدًا",
      "tr": "Biz, yeryüzünü bir döşek kılmadık mı?",
      "en": "Have We not made the earth a resting place?",
      "priority": 1,
      "surah_number": 78,
      "surah_name": "Nebe",
      "ayah_number": 6,
      "ayah_end_number": 6,
      "status": "pending_review"
    },
    {
      "id": "078/007",
      "kind": "ayah",
      "ref": "078/007",
      "ar": "وَٱلْجِبَالَ أَوْتَادًا",
      "tr": "Dağları da birer kazık?",
      "en": "And the mountains as stakes?",
      "priority": 1,
      "surah_number": 78,
      "surah_name": "Nebe",
      "ayah_number": 7,
      "ayah_end_number": 7,
      "status": "pending_review"
    },
    {
      "id": "078/008",
      "kind": "ayah",
      "ref": "078/008",
      "ar": "وَخَلَقْنَـٰكُمْ أَزْوَٰجًا",
      "tr": "Sizi çift çift yarattık.",
      "en": "And We created you in pairs",
      "priority": 1,
      "surah_number": 78,
      "surah_name": "Nebe",
      "ayah_number": 8,
      "ayah_end_number": 8,
      "status": "pending_review"
    },
    {
      "id": "078/011",
      "kind": "ayah",
      "ref": "078/011",
      "ar": "وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا",
      "tr": "Gündüzü bir geçim-vakti kıldık.",
      "en": "And made the day for livelihood",
      "priority": 1,
      "surah_number": 78,
      "surah_name": "Nebe",
      "ayah_number": 11,
      "ayah_end_number": 11,
      "status": "pending_review"
    },
    {
      "id": "078/006-008",
      "kind": "ayah",
      "ref": "078/006-008",
      "ar": "﴿6﴾ أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَـٰدًا\n\n﴿7﴾ وَٱلْجِبَالَ أَوْتَادًا\n\n﴿8﴾ وَخَلَقْنَـٰكُمْ أَزْوَٰجًا",
      "tr": "[6] Biz, yeryüzünü bir döşek kılmadık mı?\n\n[7] Dağları da birer kazık?\n\n[8] Sizi çift çift yarattık.",
      "en": "[6] Have We not made the earth a resting place?\n\n[7] And the mountains as stakes?\n\n[8] And We created you in pairs",
      "priority": 1,
      "surah_number": 78,
      "surah_name": "Nebe",
      "ayah_number": 6,
      "ayah_end_number": 8,
      "status": "pending_review"
    },
    {
      "id": "078/012",
      "kind": "ayah",
      "ref": "078/012",
      "ar": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا",
      "tr": "Sizin üstünüze sapasağlam yedi-gök bina ettik.",
      "en": "And constructed above you seven strong [heavens]",
      "priority": 1,
      "surah_number": 78,
      "surah_name": "Nebe",
      "ayah_number": 12,
      "ayah_end_number": 12,
      "status": "pending_review"
    },
    {
      "id": "078/018",
      "kind": "ayah",
      "ref": "078/018",
      "ar": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا",
      "tr": "Sur'a üfürüleceği gün, artık siz dalga dalga geleceksiniz.",
      "en": "The Day the Horn is blown and you will come forth in multitudes",
      "priority": 1,
      "surah_number": 78,
      "surah_name": "Nebe",
      "ayah_number": 18,
      "ayah_end_number": 18,
      "status": "pending_review"
    },
    {
      "id": "078/011-012",
      "kind": "ayah",
      "ref": "078/011-012",
      "ar": "﴿11﴾ وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا\n\n﴿12﴾ وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا",
      "tr": "[11] Gündüzü bir geçim-vakti kıldık.\n\n[12] Sizin üstünüze sapasağlam yedi-gök bina ettik.",
      "en": "[11] And made the day for livelihood\n\n[12] And constructed above you seven strong [heavens]",
      "priority": 1,
      "surah_number": 78,
      "surah_name": "Nebe",
      "ayah_number": 11,
      "ayah_end_number": 12,
      "status": "pending_review"
    },
    {
      "id": "078/019",
      "kind": "ayah",
      "ref": "078/019",
      "ar": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا",
      "tr": "O sırada gök açılmış ve kapı kapı olmuştur.",
      "en": "And the heaven is opened and will become gateways",
      "priority": 1,
      "surah_number": 78,
      "surah_name": "Nebe",
      "ayah_number": 19,
      "ayah_end_number": 19,
      "status": "pending_review"
    },
    {
      "id": "078/020",
      "kind": "ayah",
      "ref": "078/020",
      "ar": "وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا",
      "tr": "Dağlar yürütülmüş, artık bir serab oluvermiştir.",
      "en": "And the mountains are removed and will be [but] a mirage.",
      "priority": 1,
      "surah_number": 78,
      "surah_name": "Nebe",
      "ayah_number": 20,
      "ayah_end_number": 20,
      "status": "pending_review"
    },
    {
      "id": "078/026",
      "kind": "ayah",
      "ref": "078/026",
      "ar": "جَزَآءً وِفَاقًا",
      "tr": "(İşlediklerine) Uygun olan bir ceza olarak,",
      "en": "An appropriate recompense.",
      "priority": 1,
      "surah_number": 78,
      "surah_name": "Nebe",
      "ayah_number": 26,
      "ayah_end_number": 26,
      "status": "pending_review"
    },
    {
      "id": "078/018-020",
      "kind": "ayah",
      "ref": "078/018-020",
      "ar": "﴿18﴾ يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا\n\n﴿19﴾ وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا\n\n﴿20﴾ وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا",
      "tr": "[18] Sur'a üfürüleceği gün, artık siz dalga dalga geleceksiniz.\n\n[19] O sırada gök açılmış ve kapı kapı olmuştur.\n\n[20] Dağlar yürütülmüş, artık bir serab oluvermiştir.",
      "en": "[18] The Day the Horn is blown and you will come forth in multitudes\n\n[19] And the heaven is opened and will become gateways\n\n[20] And the mountains are removed and will be [but] a mirage.",
      "priority": 1,
      "surah_number": 78,
      "surah_name": "Nebe",
      "ayah_number": 18,
      "ayah_end_number": 20,
      "status": "pending_review"
    },
    {
      "id": "078/031",
      "kind": "ayah",
      "ref": "078/031",
      "ar": "إِنَّ لِلْمُتَّقِينَ مَفَازًا",
      "tr": "Gerçek şu ki, muttakiler için 'bir kurtuluş ve mutluluk' vardır.",
      "en": "Indeed, for the righteous is attainment -",
      "priority": 1,
      "surah_number": 78,
      "surah_name": "Nebe",
      "ayah_number": 31,
      "ayah_end_number": 31,
      "status": "pending_review"
    },
    {
      "id": "078/038",
      "kind": "ayah",
      "ref": "078/038",
      "ar": "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَـٰٓئِكَةُ صَفًّا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَـٰنُ وَقَالَ صَوَابًا",
      "tr": "Ruh ve meleklerin saflar halinde duracakları gün; Rahman'ın kendilerine izin verdikleri dışında olanlar konuşmazlar. (Konuşacak olan da,) Doğruyu söyleyecektir.",
      "en": "The Day that the Spirit and the angels will stand in rows, they will not speak except for one whom the Most Merciful permits, and he will say what is correct.",
      "priority": 1,
      "surah_number": 78,
      "surah_name": "Nebe",
      "ayah_number": 38,
      "ayah_end_number": 38,
      "status": "pending_review"
    },
    {
      "id": "079/006",
      "kind": "ayah",
      "ref": "079/006",
      "ar": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ",
      "tr": "O sarsıntının sarsacağı gün,",
      "en": "On the Day the blast [of the Horn] will convulse [creation],",
      "priority": 1,
      "surah_number": 79,
      "surah_name": "Naziat",
      "ayah_number": 6,
      "ayah_end_number": 6,
      "status": "pending_review"
    },
    {
      "id": "079/007",
      "kind": "ayah",
      "ref": "079/007",
      "ar": "تَتْبَعُهَا ٱلرَّادِفَةُ",
      "tr": "Arkasından onu diğer bir sarsıntı izleyecek.",
      "en": "There will follow it the subsequent [one].",
      "priority": 1,
      "surah_number": 79,
      "surah_name": "Naziat",
      "ayah_number": 7,
      "ayah_end_number": 7,
      "status": "pending_review"
    },
    {
      "id": "079/012",
      "kind": "ayah",
      "ref": "079/012",
      "ar": "قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ",
      "tr": "Derler ki: \"Şu durumda, zararına bir dönüştür bu.\"",
      "en": "They say, \"That, then, would be a losing return.\"",
      "priority": 1,
      "surah_number": 79,
      "surah_name": "Naziat",
      "ayah_number": 12,
      "ayah_end_number": 12,
      "status": "pending_review"
    },
    {
      "id": "079/006-007",
      "kind": "ayah",
      "ref": "079/006-007",
      "ar": "﴿6﴾ يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ\n\n﴿7﴾ تَتْبَعُهَا ٱلرَّادِفَةُ",
      "tr": "[6] O sarsıntının sarsacağı gün,\n\n[7] Arkasından onu diğer bir sarsıntı izleyecek.",
      "en": "[6] On the Day the blast [of the Horn] will convulse [creation],\n\n[7] There will follow it the subsequent [one].",
      "priority": 1,
      "surah_number": 79,
      "surah_name": "Naziat",
      "ayah_number": 6,
      "ayah_end_number": 7,
      "status": "pending_review"
    },
    {
      "id": "079/017",
      "kind": "ayah",
      "ref": "079/017",
      "ar": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ",
      "tr": "\"Firavun'a git; çünkü o, azdı.\"",
      "en": "\"Go to Pharaoh. Indeed, he has transgressed.",
      "priority": 1,
      "surah_number": 79,
      "surah_name": "Naziat",
      "ayah_number": 17,
      "ayah_end_number": 17,
      "status": "pending_review"
    },
    {
      "id": "079/027",
      "kind": "ayah",
      "ref": "079/027",
      "ar": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا",
      "tr": "Yaratmak bakımından siz mi daha güçsünüz yoksa gök mü? (Allah) Onu bina etti.",
      "en": "Are you a more difficult creation or is the heaven? Allah constructed it.",
      "priority": 1,
      "surah_number": 79,
      "surah_name": "Naziat",
      "ayah_number": 27,
      "ayah_end_number": 27,
      "status": "pending_review"
    },
    {
      "id": "079/028",
      "kind": "ayah",
      "ref": "079/028",
      "ar": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا",
      "tr": "Boyunu yükseltti, ona belli bir düzen verdi.",
      "en": "He raised its ceiling and proportioned it.",
      "priority": 1,
      "surah_number": 79,
      "surah_name": "Naziat",
      "ayah_number": 28,
      "ayah_end_number": 28,
      "status": "pending_review"
    },
    {
      "id": "079/029",
      "kind": "ayah",
      "ref": "079/029",
      "ar": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا",
      "tr": "Gecesini kararttı, kuşluğunu açığa-çıkardı.",
      "en": "And He darkened its night and extracted its brightness.",
      "priority": 1,
      "surah_number": 79,
      "surah_name": "Naziat",
      "ayah_number": 29,
      "ayah_end_number": 29,
      "status": "pending_review"
    },
    {
      "id": "079/030",
      "kind": "ayah",
      "ref": "079/030",
      "ar": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ",
      "tr": "Bundan sonra yeryüzünü serip döşedi.",
      "en": "And after that He spread the earth.",
      "priority": 1,
      "surah_number": 79,
      "surah_name": "Naziat",
      "ayah_number": 30,
      "ayah_end_number": 30,
      "status": "pending_review"
    },
    {
      "id": "079/037",
      "kind": "ayah",
      "ref": "079/037",
      "ar": "فَأَمَّا مَن طَغَىٰ",
      "tr": "Artık kim taşkınlık edip-azarsa,",
      "en": "So as for he who transgressed",
      "priority": 1,
      "surah_number": 79,
      "surah_name": "Naziat",
      "ayah_number": 37,
      "ayah_end_number": 37,
      "status": "pending_review"
    },
    {
      "id": "079/027-030",
      "kind": "ayah",
      "ref": "079/027-030",
      "ar": "﴿27﴾ ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا\n\n﴿28﴾ رَفَعَ سَمْكَهَا فَسَوَّىٰهَا\n\n﴿29﴾ وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا\n\n﴿30﴾ وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ",
      "tr": "[27] Yaratmak bakımından siz mi daha güçsünüz yoksa gök mü? (Allah) Onu bina etti.\n\n[28] Boyunu yükseltti, ona belli bir düzen verdi.\n\n[29] Gecesini kararttı, kuşluğunu açığa-çıkardı.\n\n[30] Bundan sonra yeryüzünü serip döşedi.",
      "en": "[27] Are you a more difficult creation or is the heaven? Allah constructed it.\n\n[28] He raised its ceiling and proportioned it.\n\n[29] And He darkened its night and extracted its brightness.\n\n[30] And after that He spread the earth.",
      "priority": 1,
      "surah_number": 79,
      "surah_name": "Naziat",
      "ayah_number": 27,
      "ayah_end_number": 30,
      "status": "pending_review"
    },
    {
      "id": "079/038",
      "kind": "ayah",
      "ref": "079/038",
      "ar": "وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
      "tr": "Ve dünya hayatını seçerse,",
      "en": "And preferred the life of the world,",
      "priority": 1,
      "surah_number": 79,
      "surah_name": "Naziat",
      "ayah_number": 38,
      "ayah_end_number": 38,
      "status": "pending_review"
    },
    {
      "id": "079/039",
      "kind": "ayah",
      "ref": "079/039",
      "ar": "فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ",
      "tr": "Şüphesiz cehennem, (onun için) bir barınma yeridir.",
      "en": "Then indeed, Hellfire will be [his] refuge.",
      "priority": 1,
      "surah_number": 79,
      "surah_name": "Naziat",
      "ayah_number": 39,
      "ayah_end_number": 39,
      "status": "pending_review"
    },
    {
      "id": "079/040",
      "kind": "ayah",
      "ref": "079/040",
      "ar": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ",
      "tr": "Kim Rabbinin makamından korkar ve nefsi heva (istek ve tutkular) dan sakındırırsa,",
      "en": "But as for he who feared the position of his Lord and prevented the soul from [unlawful] inclination,",
      "priority": 1,
      "surah_number": 79,
      "surah_name": "Naziat",
      "ayah_number": 40,
      "ayah_end_number": 40,
      "status": "pending_review"
    },
    {
      "id": "080/003",
      "kind": "ayah",
      "ref": "080/003",
      "ar": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
      "tr": "Nerden biliyorsun; belki o, temizlenip-arınacak?",
      "en": "But what would make you perceive, [O Muhammad], that perhaps he might be purified",
      "priority": 1,
      "surah_number": 80,
      "surah_name": "Abese",
      "ayah_number": 3,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "080/007",
      "kind": "ayah",
      "ref": "080/007",
      "ar": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ",
      "tr": "Oysa, onun temizlenip-arınmasından sana ne?",
      "en": "And not upon you [is any blame] if he will not be purified.",
      "priority": 1,
      "surah_number": 80,
      "surah_name": "Abese",
      "ayah_number": 7,
      "ayah_end_number": 7,
      "status": "pending_review"
    },
    {
      "id": "081/001",
      "kind": "ayah",
      "ref": "081/001",
      "ar": "\\basmalah إِذَا ٱلشَّمْسُ كُوِّرَتْ",
      "tr": "Güneş, köreltildiği zaman,",
      "en": "When the sun is wrapped up [in darkness]",
      "priority": 1,
      "surah_number": 81,
      "surah_name": "Tekvir",
      "ayah_number": 1,
      "ayah_end_number": 1,
      "status": "pending_review"
    },
    {
      "id": "081/002",
      "kind": "ayah",
      "ref": "081/002",
      "ar": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
      "tr": "Yıldızlar, bulanıklaşıp-döküldüğü zaman,",
      "en": "And when the stars fall, dispersing,",
      "priority": 1,
      "surah_number": 81,
      "surah_name": "Tekvir",
      "ayah_number": 2,
      "ayah_end_number": 2,
      "status": "pending_review"
    },
    {
      "id": "081/003",
      "kind": "ayah",
      "ref": "081/003",
      "ar": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
      "tr": "Dağlar, yürütüldüğü zaman,",
      "en": "And when the mountains are removed",
      "priority": 1,
      "surah_number": 81,
      "surah_name": "Tekvir",
      "ayah_number": 3,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "081/004",
      "kind": "ayah",
      "ref": "081/004",
      "ar": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
      "tr": "Gebe develer, kendi başına terk edildiği zaman,",
      "en": "And when full-term she-camels are neglected",
      "priority": 1,
      "surah_number": 81,
      "surah_name": "Tekvir",
      "ayah_number": 4,
      "ayah_end_number": 4,
      "status": "pending_review"
    },
    {
      "id": "081/005",
      "kind": "ayah",
      "ref": "081/005",
      "ar": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
      "tr": "Vahşi-hayvanlar, toplandığı zaman,",
      "en": "And when the wild beasts are gathered",
      "priority": 1,
      "surah_number": 81,
      "surah_name": "Tekvir",
      "ayah_number": 5,
      "ayah_end_number": 5,
      "status": "pending_review"
    },
    {
      "id": "081/006",
      "kind": "ayah",
      "ref": "081/006",
      "ar": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
      "tr": "Denizler, tutuşturulduğu zaman,",
      "en": "And when the seas are filled with flame",
      "priority": 1,
      "surah_number": 81,
      "surah_name": "Tekvir",
      "ayah_number": 6,
      "ayah_end_number": 6,
      "status": "pending_review"
    },
    {
      "id": "081/007",
      "kind": "ayah",
      "ref": "081/007",
      "ar": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
      "tr": "Nefisler, birleştiği zaman,",
      "en": "And when the souls are paired",
      "priority": 1,
      "surah_number": 81,
      "surah_name": "Tekvir",
      "ayah_number": 7,
      "ayah_end_number": 7,
      "status": "pending_review"
    },
    {
      "id": "081/008",
      "kind": "ayah",
      "ref": "081/008",
      "ar": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
      "tr": "Ve 'diri diri toprağa gömülen kızcağıza' sorulduğu zaman:",
      "en": "And when the girl [who was] buried alive is asked",
      "priority": 1,
      "surah_number": 81,
      "surah_name": "Tekvir",
      "ayah_number": 8,
      "ayah_end_number": 8,
      "status": "pending_review"
    },
    {
      "id": "081/009",
      "kind": "ayah",
      "ref": "081/009",
      "ar": "بِأَىِّ ذَنۢبٍ قُتِلَتْ",
      "tr": "\"Hangi suçtan dolayı öldürüldü?\"",
      "en": "For what sin she was killed",
      "priority": 1,
      "surah_number": 81,
      "surah_name": "Tekvir",
      "ayah_number": 9,
      "ayah_end_number": 9,
      "status": "pending_review"
    },
    {
      "id": "081/010",
      "kind": "ayah",
      "ref": "081/010",
      "ar": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
      "tr": "Sahifeler (amel defterleri) açıldığı zaman,",
      "en": "And when the pages are made public",
      "priority": 1,
      "surah_number": 81,
      "surah_name": "Tekvir",
      "ayah_number": 10,
      "ayah_end_number": 10,
      "status": "pending_review"
    },
    {
      "id": "081/011",
      "kind": "ayah",
      "ref": "081/011",
      "ar": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
      "tr": "Gök, sıyrılıp-yüzüldüğü zaman",
      "en": "And when the sky is stripped away",
      "priority": 1,
      "surah_number": 81,
      "surah_name": "Tekvir",
      "ayah_number": 11,
      "ayah_end_number": 11,
      "status": "pending_review"
    },
    {
      "id": "081/012",
      "kind": "ayah",
      "ref": "081/012",
      "ar": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
      "tr": "Cehennem ateşi çılgınca kızıştırıldığı zaman,",
      "en": "And when Hellfire is set ablaze",
      "priority": 1,
      "surah_number": 81,
      "surah_name": "Tekvir",
      "ayah_number": 12,
      "ayah_end_number": 12,
      "status": "pending_review"
    },
    {
      "id": "081/013",
      "kind": "ayah",
      "ref": "081/013",
      "ar": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
      "tr": "Cennet de yakınlaştırıldığı zaman,",
      "en": "And when Paradise is brought near,",
      "priority": 1,
      "surah_number": 81,
      "surah_name": "Tekvir",
      "ayah_number": 13,
      "ayah_end_number": 13,
      "status": "pending_review"
    },
    {
      "id": "081/014",
      "kind": "ayah",
      "ref": "081/014",
      "ar": "عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ",
      "tr": "(Artık her) Nefis, neyi hazırladığını bilip-öğrenmiştir.",
      "en": "A soul will [then] know what it has brought [with it].",
      "priority": 1,
      "surah_number": 81,
      "surah_name": "Tekvir",
      "ayah_number": 14,
      "ayah_end_number": 14,
      "status": "pending_review"
    },
    {
      "id": "081/019",
      "kind": "ayah",
      "ref": "081/019",
      "ar": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ",
      "tr": "Şüphesiz o (Kur'an), üstün onur sahibi bir elçinin gerçekten (Allah'tan getirdiği) sözüdür;",
      "en": "[That] indeed, the Qur'an is a word [conveyed by] a noble messenger",
      "priority": 1,
      "surah_number": 81,
      "surah_name": "Tekvir",
      "ayah_number": 19,
      "ayah_end_number": 19,
      "status": "pending_review"
    },
    {
      "id": "081/021",
      "kind": "ayah",
      "ref": "081/021",
      "ar": "مُّطَاعٍ ثَمَّ أَمِينٍ",
      "tr": "Ona itaat edilir, sonra güvenilirdir.",
      "en": "Obeyed there [in the heavens] and trustworthy.",
      "priority": 1,
      "surah_number": 81,
      "surah_name": "Tekvir",
      "ayah_number": 21,
      "ayah_end_number": 21,
      "status": "pending_review"
    },
    {
      "id": "081/025",
      "kind": "ayah",
      "ref": "081/025",
      "ar": "وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ",
      "tr": "O (Kur'an) da kovulmuş şeytanın sözü değildir.",
      "en": "And the Qur'an is not the word of a devil, expelled [from the heavens].",
      "priority": 1,
      "surah_number": 81,
      "surah_name": "Tekvir",
      "ayah_number": 25,
      "ayah_end_number": 25,
      "status": "pending_review"
    },
    {
      "id": "081/029",
      "kind": "ayah",
      "ref": "081/029",
      "ar": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ",
      "tr": "Alemlerin Rabbi olan Allah dilemedikçe siz dileyemezsiniz.",
      "en": "And you do not will except that Allah wills - Lord of the worlds.",
      "priority": 1,
      "surah_number": 81,
      "surah_name": "Tekvir",
      "ayah_number": 29,
      "ayah_end_number": 29,
      "status": "pending_review"
    },
    {
      "id": "082/001",
      "kind": "ayah",
      "ref": "082/001",
      "ar": "\\basmalah إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ",
      "tr": "Gök, çatlayıp-yarıldığı zaman,",
      "en": "When the sky breaks apart",
      "priority": 1,
      "surah_number": 82,
      "surah_name": "Infitar",
      "ayah_number": 1,
      "ayah_end_number": 1,
      "status": "pending_review"
    },
    {
      "id": "082/002",
      "kind": "ayah",
      "ref": "082/002",
      "ar": "وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ",
      "tr": "Yıldızlar, dağılıp-yayıldığı zaman,",
      "en": "And when the stars fall, scattering,",
      "priority": 1,
      "surah_number": 82,
      "surah_name": "Infitar",
      "ayah_number": 2,
      "ayah_end_number": 2,
      "status": "pending_review"
    },
    {
      "id": "082/003",
      "kind": "ayah",
      "ref": "082/003",
      "ar": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ",
      "tr": "Denizler, fışkırtılıp-taşırıldığı zaman,",
      "en": "And when the seas are erupted",
      "priority": 1,
      "surah_number": 82,
      "surah_name": "Infitar",
      "ayah_number": 3,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "082/004",
      "kind": "ayah",
      "ref": "082/004",
      "ar": "وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ",
      "tr": "Ve kabirlerin içi 'deşilip dışa atıldığı' zaman;",
      "en": "And when the [contents of] graves are scattered,",
      "priority": 1,
      "surah_number": 82,
      "surah_name": "Infitar",
      "ayah_number": 4,
      "ayah_end_number": 4,
      "status": "pending_review"
    },
    {
      "id": "082/006",
      "kind": "ayah",
      "ref": "082/006",
      "ar": "يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ",
      "tr": "Ey insan, 'üstün kerem sahibi' olan Rabbine karşı seni aldatıp-yanıltan nedir?",
      "en": "O mankind, what has deceived you concerning your Lord, the Generous,",
      "priority": 1,
      "surah_number": 82,
      "surah_name": "Infitar",
      "ayah_number": 6,
      "ayah_end_number": 6,
      "status": "pending_review"
    },
    {
      "id": "082/001-004",
      "kind": "ayah",
      "ref": "082/001-004",
      "ar": "﴿1﴾ \\basmalah إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ\n\n﴿2﴾ وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ\n\n﴿3﴾ وَإِذَا ٱلْبِحَارُ فُجِّرَتْ\n\n﴿4﴾ وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ",
      "tr": "[1] Gök, çatlayıp-yarıldığı zaman,\n\n[2] Yıldızlar, dağılıp-yayıldığı zaman,\n\n[3] Denizler, fışkırtılıp-taşırıldığı zaman,\n\n[4] Ve kabirlerin içi 'deşilip dışa atıldığı' zaman;",
      "en": "[1] When the sky breaks apart\n\n[2] And when the stars fall, scattering,\n\n[3] And when the seas are erupted\n\n[4] And when the [contents of] graves are scattered,",
      "priority": 1,
      "surah_number": 82,
      "surah_name": "Infitar",
      "ayah_number": 1,
      "ayah_end_number": 4,
      "status": "pending_review"
    },
    {
      "id": "082/010",
      "kind": "ayah",
      "ref": "082/010",
      "ar": "وَإِنَّ عَلَيْكُمْ لَحَـٰفِظِينَ",
      "tr": "Oysa gerçekten sizin üzerinizde koruyucular var,",
      "en": "And indeed, [appointed] over you are keepers,",
      "priority": 1,
      "surah_number": 82,
      "surah_name": "Infitar",
      "ayah_number": 10,
      "ayah_end_number": 10,
      "status": "pending_review"
    },
    {
      "id": "082/011",
      "kind": "ayah",
      "ref": "082/011",
      "ar": "كِرَامًا كَـٰتِبِينَ",
      "tr": "'Şerefli-üstün' yazıcılar.",
      "en": "Noble and recording;",
      "priority": 1,
      "surah_number": 82,
      "surah_name": "Infitar",
      "ayah_number": 11,
      "ayah_end_number": 11,
      "status": "pending_review"
    },
    {
      "id": "082/012",
      "kind": "ayah",
      "ref": "082/012",
      "ar": "يَعْلَمُونَ مَا تَفْعَلُونَ",
      "tr": "Her yapmakta olduğunuzu bilirler.",
      "en": "They know whatever you do.",
      "priority": 1,
      "surah_number": 82,
      "surah_name": "Infitar",
      "ayah_number": 12,
      "ayah_end_number": 12,
      "status": "pending_review"
    },
    {
      "id": "082/015",
      "kind": "ayah",
      "ref": "082/015",
      "ar": "يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ",
      "tr": "Onlar, din günü oraya yollanırlar.",
      "en": "They will [enter to] burn therein on the Day of Recompense,",
      "priority": 1,
      "surah_number": 82,
      "surah_name": "Infitar",
      "ayah_number": 15,
      "ayah_end_number": 15,
      "status": "pending_review"
    },
    {
      "id": "082/010-012",
      "kind": "ayah",
      "ref": "082/010-012",
      "ar": "﴿10﴾ وَإِنَّ عَلَيْكُمْ لَحَـٰفِظِينَ\n\n﴿11﴾ كِرَامًا كَـٰتِبِينَ\n\n﴿12﴾ يَعْلَمُونَ مَا تَفْعَلُونَ",
      "tr": "[10] Oysa gerçekten sizin üzerinizde koruyucular var,\n\n[11] 'Şerefli-üstün' yazıcılar.\n\n[12] Her yapmakta olduğunuzu bilirler.",
      "en": "[10] And indeed, [appointed] over you are keepers,\n\n[11] Noble and recording;\n\n[12] They know whatever you do.",
      "priority": 1,
      "surah_number": 82,
      "surah_name": "Infitar",
      "ayah_number": 10,
      "ayah_end_number": 12,
      "status": "pending_review"
    },
    {
      "id": "082/017",
      "kind": "ayah",
      "ref": "082/017",
      "ar": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ",
      "tr": "Din gününü sana bildiren şey nedir?",
      "en": "And what can make you know what is the Day of Recompense?",
      "priority": 1,
      "surah_number": 82,
      "surah_name": "Infitar",
      "ayah_number": 17,
      "ayah_end_number": 17,
      "status": "pending_review"
    },
    {
      "id": "082/018",
      "kind": "ayah",
      "ref": "082/018",
      "ar": "ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ",
      "tr": "Ve yine din gününü sana bildiren şey nedir?",
      "en": "Then, what can make you know what is the Day of Recompense?",
      "priority": 1,
      "surah_number": 82,
      "surah_name": "Infitar",
      "ayah_number": 18,
      "ayah_end_number": 18,
      "status": "pending_review"
    },
    {
      "id": "083/001",
      "kind": "ayah",
      "ref": "083/001",
      "ar": "\\basmalah وَيْلٌ لِّلْمُطَفِّفِينَ",
      "tr": "Eksik ölçüp tartanların vay haline,",
      "en": "Woe to those who give less [than due],",
      "priority": 1,
      "surah_number": 83,
      "surah_name": "Mutaffifin",
      "ayah_number": 1,
      "ayah_end_number": 1,
      "status": "pending_review"
    },
    {
      "id": "083/002",
      "kind": "ayah",
      "ref": "083/002",
      "ar": "ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ",
      "tr": "Ki onlar, insanlardan ölçerek aldıklarında noksansız alırlar.",
      "en": "Who, when they take a measure from people, take in full.",
      "priority": 1,
      "surah_number": 83,
      "surah_name": "Mutaffifin",
      "ayah_number": 2,
      "ayah_end_number": 2,
      "status": "pending_review"
    },
    {
      "id": "083/003",
      "kind": "ayah",
      "ref": "083/003",
      "ar": "وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ",
      "tr": "Kendileri onlara ölçtüklerinde veya tarttıklarında eksiltirler.",
      "en": "But if they give by measure or by weight to them, they cause loss.",
      "priority": 1,
      "surah_number": 83,
      "surah_name": "Mutaffifin",
      "ayah_number": 3,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "083/011",
      "kind": "ayah",
      "ref": "083/011",
      "ar": "ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ",
      "tr": "Ki onlar, din gününü yalanlıyorlar.",
      "en": "Who deny the Day of Recompense.",
      "priority": 1,
      "surah_number": 83,
      "surah_name": "Mutaffifin",
      "ayah_number": 11,
      "ayah_end_number": 11,
      "status": "pending_review"
    },
    {
      "id": "083/001-003",
      "kind": "ayah",
      "ref": "083/001-003",
      "ar": "﴿1﴾ \\basmalah وَيْلٌ لِّلْمُطَفِّفِينَ\n\n﴿2﴾ ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ\n\n﴿3﴾ وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ",
      "tr": "[1] Eksik ölçüp tartanların vay haline,\n\n[2] Ki onlar, insanlardan ölçerek aldıklarında noksansız alırlar.\n\n[3] Kendileri onlara ölçtüklerinde veya tarttıklarında eksiltirler.",
      "en": "[1] Woe to those who give less [than due],\n\n[2] Who, when they take a measure from people, take in full.\n\n[3] But if they give by measure or by weight to them, they cause loss.",
      "priority": 1,
      "surah_number": 83,
      "surah_name": "Mutaffifin",
      "ayah_number": 1,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "083/013",
      "kind": "ayah",
      "ref": "083/013",
      "ar": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَـٰتُنَا قَالَ أَسَـٰطِيرُ ٱلْأَوَّلِينَ",
      "tr": "Ona ayetlerimiz okunduğu zaman: \"Geçmişlerin masallarıdır\" dedi.",
      "en": "When Our verses are recited to him, he says, \"Legends of the former peoples.\"",
      "priority": 1,
      "surah_number": 83,
      "surah_name": "Mutaffifin",
      "ayah_number": 13,
      "ayah_end_number": 13,
      "status": "pending_review"
    },
    {
      "id": "084/001",
      "kind": "ayah",
      "ref": "084/001",
      "ar": "\\basmalah إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ",
      "tr": "Gök, yarılıp-parçalandığı,",
      "en": "When the sky has split [open]",
      "priority": 1,
      "surah_number": 84,
      "surah_name": "Insikak",
      "ayah_number": 1,
      "ayah_end_number": 1,
      "status": "pending_review"
    },
    {
      "id": "084/002",
      "kind": "ayah",
      "ref": "084/002",
      "ar": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
      "tr": "Ve 'kendi yaratılışına uygun' Rabbine boyun eğdiği zaman;",
      "en": "And has responded to its Lord and was obligated [to do so]",
      "priority": 1,
      "surah_number": 84,
      "surah_name": "Insikak",
      "ayah_number": 2,
      "ayah_end_number": 2,
      "status": "pending_review"
    },
    {
      "id": "084/003",
      "kind": "ayah",
      "ref": "084/003",
      "ar": "وَإِذَا ٱلْأَرْضُ مُدَّتْ",
      "tr": "Yer, düzlendiği,",
      "en": "And when the earth has been extended",
      "priority": 1,
      "surah_number": 84,
      "surah_name": "Insikak",
      "ayah_number": 3,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "084/004",
      "kind": "ayah",
      "ref": "084/004",
      "ar": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ",
      "tr": "İçinde olanları dışa atıp boşaldığı,",
      "en": "And has cast out that within it and relinquished [it]",
      "priority": 1,
      "surah_number": 84,
      "surah_name": "Insikak",
      "ayah_number": 4,
      "ayah_end_number": 4,
      "status": "pending_review"
    },
    {
      "id": "084/005",
      "kind": "ayah",
      "ref": "084/005",
      "ar": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
      "tr": "Ve 'kendi yaratılışına uygun Rabbine boyun eğdiği zaman.",
      "en": "And has responded to its Lord and was obligated [to do so] -",
      "priority": 1,
      "surah_number": 84,
      "surah_name": "Insikak",
      "ayah_number": 5,
      "ayah_end_number": 5,
      "status": "pending_review"
    },
    {
      "id": "085/010",
      "kind": "ayah",
      "ref": "085/010",
      "ar": "إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ",
      "tr": "Gerçek şu ki, mü'min erkeklerle mü'min kadınlara işkence (fitne) uygulayanlar, sonra tevbe etmeyenler; işte onlar için, cehennem azabı vardır ve yakıcı azap onlaradır.",
      "en": "Indeed, those who have tortured the believing men and believing women and then have not repented will have the punishment of Hell, and they will have the punishment of the Burning Fire.",
      "priority": 1,
      "surah_number": 85,
      "surah_name": "Buruc",
      "ayah_number": 10,
      "ayah_end_number": 10,
      "status": "pending_review"
    },
    {
      "id": "086/001",
      "kind": "ayah",
      "ref": "086/001",
      "ar": "\\basmalah وَٱلسَّمَآءِ وَٱلطَّارِقِ",
      "tr": "Göğe ve Tarık'a andolsun,",
      "en": "By the sky and the night comer -",
      "priority": 1,
      "surah_number": 86,
      "surah_name": "Tarik",
      "ayah_number": 1,
      "ayah_end_number": 1,
      "status": "pending_review"
    },
    {
      "id": "086/002",
      "kind": "ayah",
      "ref": "086/002",
      "ar": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ",
      "tr": "Tarık'ın ne olduğunu sana bildiren nedir?",
      "en": "And what can make you know what is the night comer?",
      "priority": 1,
      "surah_number": 86,
      "surah_name": "Tarik",
      "ayah_number": 2,
      "ayah_end_number": 2,
      "status": "pending_review"
    },
    {
      "id": "086/003",
      "kind": "ayah",
      "ref": "086/003",
      "ar": "ٱلنَّجْمُ ٱلثَّاقِبُ",
      "tr": "(Karanlığı) Delen yıldızdır.",
      "en": "It is the piercing star -",
      "priority": 1,
      "surah_number": 86,
      "surah_name": "Tarik",
      "ayah_number": 3,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "086/004",
      "kind": "ayah",
      "ref": "086/004",
      "ar": "إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ",
      "tr": "Üzerinde gözetleyici-koruyucu bulunmayan hiçbir nefis (kimse) yoktur.",
      "en": "There is no soul but that it has over it a protector.",
      "priority": 1,
      "surah_number": 86,
      "surah_name": "Tarik",
      "ayah_number": 4,
      "ayah_end_number": 4,
      "status": "pending_review"
    },
    {
      "id": "086/005",
      "kind": "ayah",
      "ref": "086/005",
      "ar": "فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ",
      "tr": "İnsan bir baksın, hangi şeyden yaratıldı?",
      "en": "So let man observe from what he was created.",
      "priority": 1,
      "surah_number": 86,
      "surah_name": "Tarik",
      "ayah_number": 5,
      "ayah_end_number": 5,
      "status": "pending_review"
    },
    {
      "id": "086/015",
      "kind": "ayah",
      "ref": "086/015",
      "ar": "إِنَّهُمْ يَكِيدُونَ كَيْدًا",
      "tr": "Doğrusu onlar, hileli bir düzen planlayıp kuruyorlar;",
      "en": "Indeed, they are planning a plan,",
      "priority": 1,
      "surah_number": 86,
      "surah_name": "Tarik",
      "ayah_number": 15,
      "ayah_end_number": 15,
      "status": "pending_review"
    },
    {
      "id": "086/001-005",
      "kind": "ayah",
      "ref": "086/001-005",
      "ar": "﴿1﴾ \\basmalah وَٱلسَّمَآءِ وَٱلطَّارِقِ\n\n﴿2﴾ وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ\n\n﴿3﴾ ٱلنَّجْمُ ٱلثَّاقِبُ\n\n﴿4﴾ إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ\n\n﴿5﴾ فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ",
      "tr": "[1] Göğe ve Tarık'a andolsun,\n\n[2] Tarık'ın ne olduğunu sana bildiren nedir?\n\n[3] (Karanlığı) Delen yıldızdır.\n\n[4] Üzerinde gözetleyici-koruyucu bulunmayan hiçbir nefis (kimse) yoktur.\n\n[5] İnsan bir baksın, hangi şeyden yaratıldı?",
      "en": "[1] By the sky and the night comer -\n\n[2] And what can make you know what is the night comer?\n\n[3] It is the piercing star -\n\n[4] There is no soul but that it has over it a protector.\n\n[5] So let man observe from what he was created.",
      "priority": 1,
      "surah_number": 86,
      "surah_name": "Tarik",
      "ayah_number": 1,
      "ayah_end_number": 5,
      "status": "pending_review"
    },
    {
      "id": "086/016",
      "kind": "ayah",
      "ref": "086/016",
      "ar": "وَأَكِيدُ كَيْدًا",
      "tr": "Ben de bir düzen kurup hazırlıyorum.",
      "en": "But I am planning a plan.",
      "priority": 1,
      "surah_number": 86,
      "surah_name": "Tarik",
      "ayah_number": 16,
      "ayah_end_number": 16,
      "status": "pending_review"
    },
    {
      "id": "087/002",
      "kind": "ayah",
      "ref": "087/002",
      "ar": "ٱلَّذِى خَلَقَ فَسَوَّىٰ",
      "tr": "Ki O, yarattı, 'bir düzen içinde biçim verdi',",
      "en": "Who created and proportioned",
      "priority": 1,
      "surah_number": 87,
      "surah_name": "Ala",
      "ayah_number": 2,
      "ayah_end_number": 2,
      "status": "pending_review"
    },
    {
      "id": "087/003",
      "kind": "ayah",
      "ref": "087/003",
      "ar": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ",
      "tr": "Takdir etti, böylece yol gösterdi,",
      "en": "And who destined and [then] guided",
      "priority": 1,
      "surah_number": 87,
      "surah_name": "Ala",
      "ayah_number": 3,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "087/014",
      "kind": "ayah",
      "ref": "087/014",
      "ar": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ",
      "tr": "Doğrusu, temizlenip arınan felah bulmuştur;",
      "en": "He has certainly succeeded who purifies himself",
      "priority": 1,
      "surah_number": 87,
      "surah_name": "Ala",
      "ayah_number": 14,
      "ayah_end_number": 14,
      "status": "pending_review"
    },
    {
      "id": "087/002-003",
      "kind": "ayah",
      "ref": "087/002-003",
      "ar": "﴿2﴾ ٱلَّذِى خَلَقَ فَسَوَّىٰ\n\n﴿3﴾ وَٱلَّذِى قَدَّرَ فَهَدَىٰ",
      "tr": "[2] Ki O, yarattı, 'bir düzen içinde biçim verdi',\n\n[3] Takdir etti, böylece yol gösterdi,",
      "en": "[2] Who created and proportioned\n\n[3] And who destined and [then] guided",
      "priority": 1,
      "surah_number": 87,
      "surah_name": "Ala",
      "ayah_number": 2,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "087/016",
      "kind": "ayah",
      "ref": "087/016",
      "ar": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
      "tr": "Hayır siz, dünya hayatını seçip üstün tutuyorsunuz.",
      "en": "But you prefer the worldly life,",
      "priority": 1,
      "surah_number": 87,
      "surah_name": "Ala",
      "ayah_number": 16,
      "ayah_end_number": 16,
      "status": "pending_review"
    },
    {
      "id": "087/017",
      "kind": "ayah",
      "ref": "087/017",
      "ar": "وَٱلْءَاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ",
      "tr": "Ahiret ise daha hayırlı ve daha süreklidir.",
      "en": "While the Hereafter is better and more enduring.",
      "priority": 1,
      "surah_number": 87,
      "surah_name": "Ala",
      "ayah_number": 17,
      "ayah_end_number": 17,
      "status": "pending_review"
    },
    {
      "id": "088/003",
      "kind": "ayah",
      "ref": "088/003",
      "ar": "عَامِلَةٌ نَّاصِبَةٌ",
      "tr": "Çalışmış, boşuna yorulmuştur.",
      "en": "Working [hard] and exhausted.",
      "priority": 1,
      "surah_number": 88,
      "surah_name": "Gasiye",
      "ayah_number": 3,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "088/004",
      "kind": "ayah",
      "ref": "088/004",
      "ar": "تَصْلَىٰ نَارًا حَامِيَةً",
      "tr": "Kızgın bir ateşe yollanırlar.",
      "en": "They will [enter to] burn in an intensely hot Fire.",
      "priority": 1,
      "surah_number": 88,
      "surah_name": "Gasiye",
      "ayah_number": 4,
      "ayah_end_number": 4,
      "status": "pending_review"
    },
    {
      "id": "088/014",
      "kind": "ayah",
      "ref": "088/014",
      "ar": "وَأَكْوَابٌ مَّوْضُوعَةٌ",
      "tr": "Konulmuş (içecek dolu) kaplar,",
      "en": "And cups put in place",
      "priority": 1,
      "surah_number": 88,
      "surah_name": "Gasiye",
      "ayah_number": 14,
      "ayah_end_number": 14,
      "status": "pending_review"
    },
    {
      "id": "088/003-004",
      "kind": "ayah",
      "ref": "088/003-004",
      "ar": "﴿3﴾ عَامِلَةٌ نَّاصِبَةٌ\n\n﴿4﴾ تَصْلَىٰ نَارًا حَامِيَةً",
      "tr": "[3] Çalışmış, boşuna yorulmuştur.\n\n[4] Kızgın bir ateşe yollanırlar.",
      "en": "[3] Working [hard] and exhausted.\n\n[4] They will [enter to] burn in an intensely hot Fire.",
      "priority": 1,
      "surah_number": 88,
      "surah_name": "Gasiye",
      "ayah_number": 3,
      "ayah_end_number": 4,
      "status": "pending_review"
    },
    {
      "id": "088/017",
      "kind": "ayah",
      "ref": "088/017",
      "ar": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ",
      "tr": "Bakmıyorlar mı o deveye; nasıl yaratıldı?",
      "en": "Then do they not look at the camels - how they are created?",
      "priority": 1,
      "surah_number": 88,
      "surah_name": "Gasiye",
      "ayah_number": 17,
      "ayah_end_number": 17,
      "status": "pending_review"
    },
    {
      "id": "088/018",
      "kind": "ayah",
      "ref": "088/018",
      "ar": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ",
      "tr": "Göğe, nasıl yükseltildi?",
      "en": "And at the sky - how it is raised?",
      "priority": 1,
      "surah_number": 88,
      "surah_name": "Gasiye",
      "ayah_number": 18,
      "ayah_end_number": 18,
      "status": "pending_review"
    },
    {
      "id": "088/019",
      "kind": "ayah",
      "ref": "088/019",
      "ar": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ",
      "tr": "Dağlara; nasıl oturtulup-kuruldu?",
      "en": "And at the mountains - how they are erected?",
      "priority": 1,
      "surah_number": 88,
      "surah_name": "Gasiye",
      "ayah_number": 19,
      "ayah_end_number": 19,
      "status": "pending_review"
    },
    {
      "id": "088/020",
      "kind": "ayah",
      "ref": "088/020",
      "ar": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ",
      "tr": "Yere; nasıl yayılıp-döşendi?",
      "en": "And at the earth - how it is spread out?",
      "priority": 1,
      "surah_number": 88,
      "surah_name": "Gasiye",
      "ayah_number": 20,
      "ayah_end_number": 20,
      "status": "pending_review"
    },
    {
      "id": "089/006",
      "kind": "ayah",
      "ref": "089/006",
      "ar": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ",
      "tr": "Rabbinin Ad (kavmin)e ne yaptığını görmedin mi?",
      "en": "Have you not considered how your Lord dealt with 'Aad -",
      "priority": 1,
      "surah_number": 89,
      "surah_name": "Fecr",
      "ayah_number": 6,
      "ayah_end_number": 6,
      "status": "pending_review"
    },
    {
      "id": "089/007",
      "kind": "ayah",
      "ref": "089/007",
      "ar": "إِرَمَ ذَاتِ ٱلْعِمَادِ",
      "tr": "'Yüksek sütunlar' sahibi İrem'e?",
      "en": "[With] Iram - who had lofty pillars,",
      "priority": 1,
      "surah_number": 89,
      "surah_name": "Fecr",
      "ayah_number": 7,
      "ayah_end_number": 7,
      "status": "pending_review"
    },
    {
      "id": "089/008",
      "kind": "ayah",
      "ref": "089/008",
      "ar": "ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَـٰدِ",
      "tr": "Ki şehirler içinde onun bir benzeri yaratılmış değildi.",
      "en": "The likes of whom had never been created in the land?",
      "priority": 1,
      "surah_number": 89,
      "surah_name": "Fecr",
      "ayah_number": 8,
      "ayah_end_number": 8,
      "status": "pending_review"
    },
    {
      "id": "089/009",
      "kind": "ayah",
      "ref": "089/009",
      "ar": "وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ",
      "tr": "Ve vadilerde kayaları oyup biçen Semud'a?",
      "en": "And [with] Thamud, who carved out the rocks in the valley?",
      "priority": 1,
      "surah_number": 89,
      "surah_name": "Fecr",
      "ayah_number": 9,
      "ayah_end_number": 9,
      "status": "pending_review"
    },
    {
      "id": "089/010",
      "kind": "ayah",
      "ref": "089/010",
      "ar": "وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ",
      "tr": "Ve kazıklar (ehramlar) sahibi Firavun'a?",
      "en": "And [with] Pharaoh, owner of the stakes? -",
      "priority": 1,
      "surah_number": 89,
      "surah_name": "Fecr",
      "ayah_number": 10,
      "ayah_end_number": 10,
      "status": "pending_review"
    },
    {
      "id": "089/011",
      "kind": "ayah",
      "ref": "089/011",
      "ar": "ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَـٰدِ",
      "tr": "Ki onlar, şehirlerde azgınlaşmışlardı.",
      "en": "[All of] whom oppressed within the lands",
      "priority": 1,
      "surah_number": 89,
      "surah_name": "Fecr",
      "ayah_number": 11,
      "ayah_end_number": 11,
      "status": "pending_review"
    },
    {
      "id": "089/012",
      "kind": "ayah",
      "ref": "089/012",
      "ar": "فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ",
      "tr": "Böylece oralarda fesadı yaygınlaştırmış-arttırmışlardı.'",
      "en": "And increased therein the corruption.",
      "priority": 1,
      "surah_number": 89,
      "surah_name": "Fecr",
      "ayah_number": 12,
      "ayah_end_number": 12,
      "status": "pending_review"
    },
    {
      "id": "089/013",
      "kind": "ayah",
      "ref": "089/013",
      "ar": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ",
      "tr": "Bundan dolayı, Rabbin, onların üzerine bir azap kamçısı çarpıverdi.",
      "en": "So your Lord poured upon them a scourge of punishment.",
      "priority": 1,
      "surah_number": 89,
      "surah_name": "Fecr",
      "ayah_number": 13,
      "ayah_end_number": 13,
      "status": "pending_review"
    },
    {
      "id": "089/014",
      "kind": "ayah",
      "ref": "089/014",
      "ar": "إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ",
      "tr": "Çünkü senin Rabbin, gerçekten gözetleme yerindedir.",
      "en": "Indeed, your Lord is in observation.",
      "priority": 1,
      "surah_number": 89,
      "surah_name": "Fecr",
      "ayah_number": 14,
      "ayah_end_number": 14,
      "status": "pending_review"
    },
    {
      "id": "089/015",
      "kind": "ayah",
      "ref": "089/015",
      "ar": "فَأَمَّا ٱلْإِنسَـٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ",
      "tr": "Fakat insan; ne zaman Rabbi kendisini bir denemeden geçirse, ona bir keremde bulunsa, nimetler verse: \"Rabbim bana ikram etti\" der.",
      "en": "And as for man, when his Lord tries him and [thus] is generous to him and favors him, he says, \"My Lord has honored me.\"",
      "priority": 1,
      "surah_number": 89,
      "surah_name": "Fecr",
      "ayah_number": 15,
      "ayah_end_number": 15,
      "status": "pending_review"
    },
    {
      "id": "089/016",
      "kind": "ayah",
      "ref": "089/016",
      "ar": "وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَـٰنَنِ",
      "tr": "Ama ne zaman onu deneyerek, rızkını kıssa, hemen: \"Rabbim bana ihanet etti\" der.",
      "en": "But when He tries him and restricts his provision, he says, \"My Lord has humiliated me.\"",
      "priority": 1,
      "surah_number": 89,
      "surah_name": "Fecr",
      "ayah_number": 16,
      "ayah_end_number": 16,
      "status": "pending_review"
    },
    {
      "id": "091/005",
      "kind": "ayah",
      "ref": "091/005",
      "ar": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا",
      "tr": "Göğe ve onu bina edene,",
      "en": "And [by] the sky and He who constructed it",
      "priority": 1,
      "surah_number": 91,
      "surah_name": "Sems",
      "ayah_number": 5,
      "ayah_end_number": 5,
      "status": "pending_review"
    },
    {
      "id": "091/009",
      "kind": "ayah",
      "ref": "091/009",
      "ar": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا",
      "tr": "Onu arındırıp-temizleyen gerçekten felah bulmuştur.",
      "en": "He has succeeded who purifies it,",
      "priority": 1,
      "surah_number": 91,
      "surah_name": "Sems",
      "ayah_number": 9,
      "ayah_end_number": 9,
      "status": "pending_review"
    },
    {
      "id": "092/008",
      "kind": "ayah",
      "ref": "092/008",
      "ar": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ",
      "tr": "Kim de cimrilik eder, kendini müstağni görürse,",
      "en": "But as for he who withholds and considers himself free of need",
      "priority": 1,
      "surah_number": 92,
      "surah_name": "Leyl",
      "ayah_number": 8,
      "ayah_end_number": 8,
      "status": "pending_review"
    },
    {
      "id": "092/009",
      "kind": "ayah",
      "ref": "092/009",
      "ar": "وَكَذَّبَ بِٱلْحُسْنَىٰ",
      "tr": "Ve en güzel olanı yalan sayarsa,",
      "en": "And denies the best [reward],",
      "priority": 1,
      "surah_number": 92,
      "surah_name": "Leyl",
      "ayah_number": 9,
      "ayah_end_number": 9,
      "status": "pending_review"
    },
    {
      "id": "092/010",
      "kind": "ayah",
      "ref": "092/010",
      "ar": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ",
      "tr": "Biz de ona en zorlu olanı (azaba uğramasını) kolaylaştıracağız.",
      "en": "We will ease him toward difficulty.",
      "priority": 1,
      "surah_number": 92,
      "surah_name": "Leyl",
      "ayah_number": 10,
      "ayah_end_number": 10,
      "status": "pending_review"
    },
    {
      "id": "092/017",
      "kind": "ayah",
      "ref": "092/017",
      "ar": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى",
      "tr": "Sakınan ise, ondan uzak tutulacaktır.",
      "en": "But the righteous one will avoid it -",
      "priority": 1,
      "surah_number": 92,
      "surah_name": "Leyl",
      "ayah_number": 17,
      "ayah_end_number": 17,
      "status": "pending_review"
    },
    {
      "id": "092/008-010",
      "kind": "ayah",
      "ref": "092/008-010",
      "ar": "﴿8﴾ وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ\n\n﴿9﴾ وَكَذَّبَ بِٱلْحُسْنَىٰ\n\n﴿10﴾ فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ",
      "tr": "[8] Kim de cimrilik eder, kendini müstağni görürse,\n\n[9] Ve en güzel olanı yalan sayarsa,\n\n[10] Biz de ona en zorlu olanı (azaba uğramasını) kolaylaştıracağız.",
      "en": "[8] But as for he who withholds and considers himself free of need\n\n[9] And denies the best [reward],\n\n[10] We will ease him toward difficulty.",
      "priority": 1,
      "surah_number": 92,
      "surah_name": "Leyl",
      "ayah_number": 8,
      "ayah_end_number": 10,
      "status": "pending_review"
    },
    {
      "id": "092/018",
      "kind": "ayah",
      "ref": "092/018",
      "ar": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ",
      "tr": "Ki o, malını vererek temizlenip-arınır.",
      "en": "[He] who gives [from] his wealth to purify himself",
      "priority": 1,
      "surah_number": 92,
      "surah_name": "Leyl",
      "ayah_number": 18,
      "ayah_end_number": 18,
      "status": "pending_review"
    },
    {
      "id": "092/019",
      "kind": "ayah",
      "ref": "092/019",
      "ar": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ",
      "tr": "Onun yanında hiç kimsenin karşılığı verilecek bir nimeti (borcu) yoktur.",
      "en": "And not [giving] for anyone who has [done him] a favor to be rewarded",
      "priority": 1,
      "surah_number": 92,
      "surah_name": "Leyl",
      "ayah_number": 19,
      "ayah_end_number": 19,
      "status": "pending_review"
    },
    {
      "id": "092/020",
      "kind": "ayah",
      "ref": "092/020",
      "ar": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ",
      "tr": "Ancak Yüce Rabbinin rızasını aramak için (verir).",
      "en": "But only seeking the countenance of his Lord, Most High.",
      "priority": 1,
      "surah_number": 92,
      "surah_name": "Leyl",
      "ayah_number": 20,
      "ayah_end_number": 20,
      "status": "pending_review"
    },
    {
      "id": "094/005",
      "kind": "ayah",
      "ref": "094/005",
      "ar": "فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا",
      "tr": "Demek ki, gerçekten zorlukla beraber kolaylık vardır.",
      "en": "For indeed, with hardship [will be] ease.",
      "priority": 1,
      "surah_number": 94,
      "surah_name": "Insirah",
      "ayah_number": 5,
      "ayah_end_number": 5,
      "status": "pending_review"
    },
    {
      "id": "094/006",
      "kind": "ayah",
      "ref": "094/006",
      "ar": "إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا",
      "tr": "Gerçekten güçlükle beraber kolaylık vardır.",
      "en": "Indeed, with hardship [will be] ease.",
      "priority": 1,
      "surah_number": 94,
      "surah_name": "Insirah",
      "ayah_number": 6,
      "ayah_end_number": 6,
      "status": "pending_review"
    },
    {
      "id": "096/001",
      "kind": "ayah",
      "ref": "096/001",
      "ar": "\\basmalah ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ",
      "tr": "Yaratan Rabbin adıyla oku.",
      "en": "Recite in the name of your Lord who created -",
      "priority": 1,
      "surah_number": 96,
      "surah_name": "Alak",
      "ayah_number": 1,
      "ayah_end_number": 1,
      "status": "pending_review"
    },
    {
      "id": "096/002",
      "kind": "ayah",
      "ref": "096/002",
      "ar": "خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ",
      "tr": "O, insanı bir alak'tan yarattı.",
      "en": "Created man from a clinging substance.",
      "priority": 1,
      "surah_number": 96,
      "surah_name": "Alak",
      "ayah_number": 2,
      "ayah_end_number": 2,
      "status": "pending_review"
    },
    {
      "id": "096/003",
      "kind": "ayah",
      "ref": "096/003",
      "ar": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ",
      "tr": "Oku, Rabbin en büyük kerem sahibidir;",
      "en": "Recite, and your Lord is the most Generous -",
      "priority": 1,
      "surah_number": 96,
      "surah_name": "Alak",
      "ayah_number": 3,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "096/004",
      "kind": "ayah",
      "ref": "096/004",
      "ar": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ",
      "tr": "Ki O, kalemle (yazmayı) öğretendir.",
      "en": "Who taught by the pen -",
      "priority": 1,
      "surah_number": 96,
      "surah_name": "Alak",
      "ayah_number": 4,
      "ayah_end_number": 4,
      "status": "pending_review"
    },
    {
      "id": "096/005",
      "kind": "ayah",
      "ref": "096/005",
      "ar": "عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ",
      "tr": "İnsana bilmediğini öğretti.",
      "en": "Taught man that which he knew not.",
      "priority": 1,
      "surah_number": 96,
      "surah_name": "Alak",
      "ayah_number": 5,
      "ayah_end_number": 5,
      "status": "pending_review"
    },
    {
      "id": "096/006",
      "kind": "ayah",
      "ref": "096/006",
      "ar": "كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ",
      "tr": "Hayır; gerçekten insan, azar.",
      "en": "No! [But] indeed, man transgresses",
      "priority": 1,
      "surah_number": 96,
      "surah_name": "Alak",
      "ayah_number": 6,
      "ayah_end_number": 6,
      "status": "pending_review"
    },
    {
      "id": "096/007",
      "kind": "ayah",
      "ref": "096/007",
      "ar": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ",
      "tr": "Kendini müstağni gördüğünden.",
      "en": "Because he sees himself self-sufficient.",
      "priority": 1,
      "surah_number": 96,
      "surah_name": "Alak",
      "ayah_number": 7,
      "ayah_end_number": 7,
      "status": "pending_review"
    },
    {
      "id": "097/004",
      "kind": "ayah",
      "ref": "097/004",
      "ar": "تَنَزَّلُ ٱلْمَلَـٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٍ",
      "tr": "Melekler ve ruh, onda Rablerinin izniyle her bir iş için inerler.",
      "en": "The angels and the Spirit descend therein by permission of their Lord for every matter.",
      "priority": 1,
      "surah_number": 97,
      "surah_name": "Kadir",
      "ayah_number": 4,
      "ayah_end_number": 4,
      "status": "pending_review"
    },
    {
      "id": "098/001",
      "kind": "ayah",
      "ref": "098/001",
      "ar": "\\basmalah لَمْ يَكُنِ ٱلَّذِينَ كَفَرُوا۟ مِنْ أَهْلِ ٱلْكِتَـٰبِ وَٱلْمُشْرِكِينَ مُنفَكِّينَ حَتَّىٰ تَأْتِيَهُمُ ٱلْبَيِّنَةُ",
      "tr": "Kitap Ehlinden ve müşriklerden inkar edenler, kendilerine apaçık bir delil gelinceye kadar, (bulundukları durumdan) kopup-ayrılacak değillerdi.",
      "en": "Those who disbelieved among the People of the Scripture and the polytheists were not to be parted [from misbelief] until there came to them clear evidence -",
      "priority": 1,
      "surah_number": 98,
      "surah_name": "Beyyine",
      "ayah_number": 1,
      "ayah_end_number": 1,
      "status": "pending_review"
    },
    {
      "id": "098/005",
      "kind": "ayah",
      "ref": "098/005",
      "ar": "وَمَآ أُمِرُوٓا۟ إِلَّا لِيَعْبُدُوا۟ ٱللَّهَ مُخْلِصِينَ لَهُ ٱلدِّينَ حُنَفَآءَ وَيُقِيمُوا۟ ٱلصَّلَوٰةَ وَيُؤْتُوا۟ ٱلزَّكَوٰةَ ۚ وَذَٰلِكَ دِينُ ٱلْقَيِّمَةِ",
      "tr": "Oysa onlar, dini yalnızca O'na halis kılan hanifler (Allah'ı birleyenler) olarak sadece Allah'a kulluk etmek, namazı dosdoğru kılmak ve zekatı vermekten başkasıyla emrolunmadılar. İşte en doğru (dimdik ve sapasağlam) din budur.",
      "en": "And they were not commanded except to worship Allah, [being] sincere to Him in religion, inclining to truth, and to establish prayer and to give zakah. And that is the correct religion.",
      "priority": 1,
      "surah_number": 98,
      "surah_name": "Beyyine",
      "ayah_number": 5,
      "ayah_end_number": 5,
      "status": "pending_review"
    },
    {
      "id": "098/006",
      "kind": "ayah",
      "ref": "098/006",
      "ar": "إِنَّ ٱلَّذِينَ كَفَرُوا۟ مِنْ أَهْلِ ٱلْكِتَـٰبِ وَٱلْمُشْرِكِينَ فِى نَارِ جَهَنَّمَ خَـٰلِدِينَ فِيهَآ ۚ أُو۟لَـٰٓئِكَ هُمْ شَرُّ ٱلْبَرِيَّةِ",
      "tr": "Şüphesiz, Kitap Ehlinden ve müşriklerden inkar edenler, içinde sürekli kalıcılar olmak üzere cehennem ateşindedirler. İşte onlar, yaratılmışların en kötüleridir.",
      "en": "Indeed, they who disbelieved among the People of the Scripture and the polytheists will be in the fire of Hell, abiding eternally therein. Those are the worst of creatures.",
      "priority": 1,
      "surah_number": 98,
      "surah_name": "Beyyine",
      "ayah_number": 6,
      "ayah_end_number": 6,
      "status": "pending_review"
    },
    {
      "id": "099/001",
      "kind": "ayah",
      "ref": "099/001",
      "ar": "\\basmalah إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا",
      "tr": "Yer, o şiddetli sarsıntısıyla sarsıldığı,",
      "en": "When the earth is shaken with its [final] earthquake",
      "priority": 1,
      "surah_number": 99,
      "surah_name": "Zilzal",
      "ayah_number": 1,
      "ayah_end_number": 1,
      "status": "pending_review"
    },
    {
      "id": "099/002",
      "kind": "ayah",
      "ref": "099/002",
      "ar": "وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا",
      "tr": "Yer, ağırlıklarını dışa atıp-çıkardığı,",
      "en": "And the earth discharges its burdens",
      "priority": 1,
      "surah_number": 99,
      "surah_name": "Zilzal",
      "ayah_number": 2,
      "ayah_end_number": 2,
      "status": "pending_review"
    },
    {
      "id": "099/003",
      "kind": "ayah",
      "ref": "099/003",
      "ar": "وَقَالَ ٱلْإِنسَـٰنُ مَا لَهَا",
      "tr": "Ve insan: \"Buna ne oluyor?\" dediği zaman;",
      "en": "And man says, \"What is [wrong] with it?\" -",
      "priority": 1,
      "surah_number": 99,
      "surah_name": "Zilzal",
      "ayah_number": 3,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "099/007",
      "kind": "ayah",
      "ref": "099/007",
      "ar": "فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُۥ",
      "tr": "Artık kim zerre ağırlığınca hayır işlerse, onu görür.",
      "en": "So whoever does an atom's weight of good will see it,",
      "priority": 1,
      "surah_number": 99,
      "surah_name": "Zilzal",
      "ayah_number": 7,
      "ayah_end_number": 7,
      "status": "pending_review"
    },
    {
      "id": "099/001-003",
      "kind": "ayah",
      "ref": "099/001-003",
      "ar": "﴿1﴾ \\basmalah إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا\n\n﴿2﴾ وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا\n\n﴿3﴾ وَقَالَ ٱلْإِنسَـٰنُ مَا لَهَا",
      "tr": "[1] Yer, o şiddetli sarsıntısıyla sarsıldığı,\n\n[2] Yer, ağırlıklarını dışa atıp-çıkardığı,\n\n[3] Ve insan: \"Buna ne oluyor?\" dediği zaman;",
      "en": "[1] When the earth is shaken with its [final] earthquake\n\n[2] And the earth discharges its burdens\n\n[3] And man says, \"What is [wrong] with it?\" -",
      "priority": 1,
      "surah_number": 99,
      "surah_name": "Zilzal",
      "ayah_number": 1,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "099/008",
      "kind": "ayah",
      "ref": "099/008",
      "ar": "وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُۥ",
      "tr": "Artık kim zerre ağırlığınca bir şer (kötülük) işlerse, onu görür.",
      "en": "And whoever does an atom's weight of evil will see it.",
      "priority": 1,
      "surah_number": 99,
      "surah_name": "Zilzal",
      "ayah_number": 8,
      "ayah_end_number": 8,
      "status": "pending_review"
    },
    {
      "id": "101/001",
      "kind": "ayah",
      "ref": "101/001",
      "ar": "\\basmalah ٱلْقَارِعَةُ",
      "tr": "Kaari’a...",
      "en": "The Striking Calamity -",
      "priority": 1,
      "surah_number": 101,
      "surah_name": "Karia",
      "ayah_number": 1,
      "ayah_end_number": 1,
      "status": "pending_review"
    },
    {
      "id": "101/002",
      "kind": "ayah",
      "ref": "101/002",
      "ar": "مَا ٱلْقَارِعَةُ",
      "tr": "Nedir kaari’a?",
      "en": "What is the Striking Calamity?",
      "priority": 1,
      "surah_number": 101,
      "surah_name": "Karia",
      "ayah_number": 2,
      "ayah_end_number": 2,
      "status": "pending_review"
    },
    {
      "id": "101/003",
      "kind": "ayah",
      "ref": "101/003",
      "ar": "وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ",
      "tr": "Sana o kaaria’yı bildiren nedir?",
      "en": "And what can make you know what is the Striking Calamity?",
      "priority": 1,
      "surah_number": 101,
      "surah_name": "Karia",
      "ayah_number": 3,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "101/004",
      "kind": "ayah",
      "ref": "101/004",
      "ar": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ",
      "tr": "İnsanların, 'her yana dağılmış' pervaneler gibi olacakları gün,",
      "en": "It is the Day when people will be like moths, dispersed,",
      "priority": 1,
      "surah_number": 101,
      "surah_name": "Karia",
      "ayah_number": 4,
      "ayah_end_number": 4,
      "status": "pending_review"
    },
    {
      "id": "101/005",
      "kind": "ayah",
      "ref": "101/005",
      "ar": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ",
      "tr": "Ve dağların 'etrafa saçılmış' renkli yünler gibi olacakları (gün),",
      "en": "And the mountains will be like wool, fluffed up.",
      "priority": 1,
      "surah_number": 101,
      "surah_name": "Karia",
      "ayah_number": 5,
      "ayah_end_number": 5,
      "status": "pending_review"
    },
    {
      "id": "102/001",
      "kind": "ayah",
      "ref": "102/001",
      "ar": "\\basmalah أَلْهَىٰكُمُ ٱلتَّكَاثُرُ",
      "tr": "(Mal, mülk ve servette) Çoklukla övünmek, sizi 'tutkuyla oyalayıp, kendinizden geçirdi.'",
      "en": "Competition in [worldly] increase diverts you",
      "priority": 1,
      "surah_number": 102,
      "surah_name": "Tekasur",
      "ayah_number": 1,
      "ayah_end_number": 1,
      "status": "pending_review"
    },
    {
      "id": "102/002",
      "kind": "ayah",
      "ref": "102/002",
      "ar": "حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ",
      "tr": "\"Öyle ki (bu,) mezarı ziyaretinize (kabre gidişinize, ölümünüze) kadar sürdü.\"",
      "en": "Until you visit the graveyards.",
      "priority": 1,
      "surah_number": 102,
      "surah_name": "Tekasur",
      "ayah_number": 2,
      "ayah_end_number": 2,
      "status": "pending_review"
    },
    {
      "id": "102/003",
      "kind": "ayah",
      "ref": "102/003",
      "ar": "كَلَّا سَوْفَ تَعْلَمُونَ",
      "tr": "Hayır; ileride bileceksiniz.",
      "en": "No! You are going to know.",
      "priority": 1,
      "surah_number": 102,
      "surah_name": "Tekasur",
      "ayah_number": 3,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "102/004",
      "kind": "ayah",
      "ref": "102/004",
      "ar": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ",
      "tr": "Yine hayır; ileride bileceksiniz.",
      "en": "Then no! You are going to know.",
      "priority": 1,
      "surah_number": 102,
      "surah_name": "Tekasur",
      "ayah_number": 4,
      "ayah_end_number": 4,
      "status": "pending_review"
    },
    {
      "id": "102/005",
      "kind": "ayah",
      "ref": "102/005",
      "ar": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ",
      "tr": "Hayır; eğer siz kesin bir bilgiyle bilmiş olsaydınız,",
      "en": "No! If you only knew with knowledge of certainty...",
      "priority": 1,
      "surah_number": 102,
      "surah_name": "Tekasur",
      "ayah_number": 5,
      "ayah_end_number": 5,
      "status": "pending_review"
    },
    {
      "id": "102/006",
      "kind": "ayah",
      "ref": "102/006",
      "ar": "لَتَرَوُنَّ ٱلْجَحِيمَ",
      "tr": "Andolsun, o çılgınca yanan ateşi de elbette görecektiniz.",
      "en": "You will surely see the Hellfire.",
      "priority": 1,
      "surah_number": 102,
      "surah_name": "Tekasur",
      "ayah_number": 6,
      "ayah_end_number": 6,
      "status": "pending_review"
    },
    {
      "id": "102/007",
      "kind": "ayah",
      "ref": "102/007",
      "ar": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ",
      "tr": "Sonra onu, gerçekten yakîn gözüyle (Ayne'l Yakîn) görmüş olacaksınız.",
      "en": "Then you will surely see it with the eye of certainty.",
      "priority": 1,
      "surah_number": 102,
      "surah_name": "Tekasur",
      "ayah_number": 7,
      "ayah_end_number": 7,
      "status": "pending_review"
    },
    {
      "id": "102/008",
      "kind": "ayah",
      "ref": "102/008",
      "ar": "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ",
      "tr": "Sonra o gün, nimetten sorguya çekileceksiniz.",
      "en": "Then you will surely be asked that Day about pleasure.",
      "priority": 1,
      "surah_number": 102,
      "surah_name": "Tekasur",
      "ayah_number": 8,
      "ayah_end_number": 8,
      "status": "pending_review"
    },
    {
      "id": "104/001",
      "kind": "ayah",
      "ref": "104/001",
      "ar": "\\basmalah وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ",
      "tr": "Arkadan çekiştirip duran, kaş göz hareketleriyle alay eden her kişinin vay haline;",
      "en": "Woe to every scorner and mocker",
      "priority": 1,
      "surah_number": 104,
      "surah_name": "Humeze",
      "ayah_number": 1,
      "ayah_end_number": 1,
      "status": "pending_review"
    },
    {
      "id": "104/002",
      "kind": "ayah",
      "ref": "104/002",
      "ar": "ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ",
      "tr": "Ki o, mal yığıp biriktiren ve onu saydıkça sayandır.",
      "en": "Who collects wealth and [continuously] counts it.",
      "priority": 1,
      "surah_number": 104,
      "surah_name": "Humeze",
      "ayah_number": 2,
      "ayah_end_number": 2,
      "status": "pending_review"
    },
    {
      "id": "104/003",
      "kind": "ayah",
      "ref": "104/003",
      "ar": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ",
      "tr": "Gerçekten malının kendisini ebedi kılacağını sanıyor.",
      "en": "He thinks that his wealth will make him immortal.",
      "priority": 1,
      "surah_number": 104,
      "surah_name": "Humeze",
      "ayah_number": 3,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "107/004",
      "kind": "ayah",
      "ref": "107/004",
      "ar": "فَوَيْلٌ لِّلْمُصَلِّينَ",
      "tr": "İşte (şu) namaz kılanların vay haline,",
      "en": "So woe to those who pray",
      "priority": 1,
      "surah_number": 107,
      "surah_name": "Maun",
      "ayah_number": 4,
      "ayah_end_number": 4,
      "status": "pending_review"
    },
    {
      "id": "107/005",
      "kind": "ayah",
      "ref": "107/005",
      "ar": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ",
      "tr": "Ki onlar, namazlarında yanılgıdadırlar,",
      "en": "[But] who are heedless of their prayer -",
      "priority": 1,
      "surah_number": 107,
      "surah_name": "Maun",
      "ayah_number": 5,
      "ayah_end_number": 5,
      "status": "pending_review"
    },
    {
      "id": "107/006",
      "kind": "ayah",
      "ref": "107/006",
      "ar": "ٱلَّذِينَ هُمْ يُرَآءُونَ",
      "tr": "Onlar gösteriş yapmaktadırlar",
      "en": "Those who make show [of their deeds]",
      "priority": 1,
      "surah_number": 107,
      "surah_name": "Maun",
      "ayah_number": 6,
      "ayah_end_number": 6,
      "status": "pending_review"
    },
    {
      "id": "109/006",
      "kind": "ayah",
      "ref": "109/006",
      "ar": "لَكُمْ دِينُكُمْ وَلِىَ دِينِ",
      "tr": "\"Sizin dininiz size, benim dinim bana.\"",
      "en": "For you is your religion, and for me is my religion.\"",
      "priority": 1,
      "surah_number": 109,
      "surah_name": "Kafirun",
      "ayah_number": 6,
      "ayah_end_number": 6,
      "status": "pending_review"
    },
    {
      "id": "112/002",
      "kind": "ayah",
      "ref": "112/002",
      "ar": "ٱللَّهُ ٱلصَّمَدُ",
      "tr": "Allah, Samed'dir (herşey O'na muhtaçtır, daimdir, hiçbir şeye ihtiyacı olmayandır).",
      "en": "Allah, the Eternal Refuge.",
      "priority": 1,
      "surah_number": 112,
      "surah_name": "Ihlas",
      "ayah_number": 2,
      "ayah_end_number": 2,
      "status": "pending_review"
    },
    {
      "id": "112/003",
      "kind": "ayah",
      "ref": "112/003",
      "ar": "لَمْ يَلِدْ وَلَمْ يُولَدْ",
      "tr": "O, doğurmamıştır ve doğurulmamıştır.",
      "en": "He neither begets nor is born,",
      "priority": 1,
      "surah_number": 112,
      "surah_name": "Ihlas",
      "ayah_number": 3,
      "ayah_end_number": 3,
      "status": "pending_review"
    },
    {
      "id": "113/005",
      "kind": "ayah",
      "ref": "113/005",
      "ar": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",
      "tr": "Ve hased ettiği zaman, hasetçinin şerrinden.",
      "en": "And from the evil of an envier when he envies.\"",
      "priority": 1,
      "surah_number": 113,
      "surah_name": "Felak",
      "ayah_number": 5,
      "ayah_end_number": 5,
      "status": "pending_review"
    },
    {
      "id": "002/008-009",
      "kind": "ayah",
      "ref": "002/008-009",
      "ar": "﴿8﴾ وَمِنَ ٱلنَّاسِ مَن يَقُولُ ءَامَنَّا بِٱللَّهِ وَبِٱلْيَوْمِ ٱلْـَٔاخِرِ وَمَا هُم بِمُؤْمِنِينَ\n﴿9﴾ يُخَـٰدِعُونَ ٱللَّهَ وَٱلَّذِينَ ءَامَنُوا۟ وَمَا يَخْدَعُونَ إِلَّآ أَنفُسَهُمْ وَمَا يَشْعُرُونَ",
      "tr": "[8] İnsanlardan, inanmadıkları halde, \"Allah'a ve ahiret gününe inandık\" diyenler vardır.\n[9] Bunlar Allah'ı ve inananları aldatmaya çalışırlar, oysa sadece kendilerini aldatırlar da farkında değildirler.",
      "en": "[8] And of the people are some who say, \"We believe in Allah and the Last Day,\" but they are not believers.\n[9] They [think to] deceive Allah and those who believe, but they deceive not except themselves and perceive [it] not.",
      "priority": 3,
      "surah_number": 2,
      "surah_name": "Bakara",
      "ayah_number": 8,
      "ayah_end_number": 9,
      "status": "pending_review"
    },
    {
      "id": "010/088",
      "kind": "ayah",
      "ref": "010/088",
      "ar": "وَقَالَ مُوسَىٰ رَبَّنَآ إِنَّكَ ءَاتَيْتَ فِرْعَوْنَ وَمَلَأَهُۥ زِينَةً وَأَمْوَٰلًا فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا رَبَّنَا لِيُضِلُّوا۟ عَن سَبِيلِكَ ۖ رَبَّنَا ٱطْمِسْ عَلَىٰٓ أَمْوَٰلِهِمْ وَٱشْدُدْ عَلَىٰ قُلُوبِهِمْ فَلَا يُؤْمِنُوا۟ حَتَّىٰ يَرَوُا۟ ٱلْعَذَابَ ٱلْأَلِيمَ",
      "tr": "Musa: \"Rabbimiz! Doğrusu sen Firavun'a ve erkanına ziynetler ve dünya hayatında mallar verdin. Rabbimiz! Senin yolundan şaşırtmaları için mi? Rabbimiz! Mallarını yok et, kalblerini sık; çünkü onlar can yakıcı azabı görmedikçe inanmazlar\" dedi.",
      "en": "And Moses said, \"Our Lord, indeed You have given Pharaoh and his establishment splendor and wealth in the worldly life, our Lord, that they may lead [men] astray from Your way. Our Lord, obliterate their wealth and harden their hearts so that they will not believe until they see the painful punishment.\"",
      "priority": 2,
      "approvedAt": "2026-06-10T13:51:07+00:00",
      "surah_number": 10,
      "surah_name": "Yunus",
      "ayah_number": 88,
      "ayah_end_number": null
    }
  ]
}
