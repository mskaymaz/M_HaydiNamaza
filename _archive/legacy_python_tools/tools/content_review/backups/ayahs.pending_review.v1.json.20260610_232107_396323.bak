      "ayahs": [
        {
          "ref": "026/223",
          "surah": 26,
          "ayah": 223,
          "arabic": "يُلْقُونَ ٱلسَّمْعَ وَأَكْثَرُهُمْ كَـٰذِبُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "026/223",
            "text": "Bunlar (şeytanlara) kulak verirler ve çoğu yalan söylemektedirler."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "026/223",
            "text": "Bunlar şeytanlara kulak verirler, çoğu yalancıdırlar."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "026/223",
            "text": "They pass on what is heard, and most of them are liars."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "026/223",
            "text": "on those who whisper hearsay in the ears of people; and most of them are liars."
          }
        }
      ],
