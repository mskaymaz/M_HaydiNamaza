          "ref": "056/005",
          "surah": 56,
          "ayah": 5,
          "arabic": "وَبُسَّتِ ٱلْجِبَالُ بَسًّا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "056/005",
            "text": "Ve dağlar darmadağın olup ufalandığı,"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "056/005",
            "text": "Ey insanlar! Yer sarsıldıkça sarsıldığı, dağlar ufalandıkça ufalanıp da toz duman haline geldiği zaman, siz de üç sınıf olursunuz."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "056/005",
