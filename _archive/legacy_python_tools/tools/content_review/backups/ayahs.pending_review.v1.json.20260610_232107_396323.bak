      },
      "sourceRefGroups": [
        "021/066"
      ],
      "ayahs": [
        {
          "ref": "021/066",
          "surah": 21,
          "ayah": 66,
          "arabic": "قَالَ أَفَتَعْبُدُونَ مِن دُونِ ٱللَّهِ مَا لَا يَنفَعُكُمْ شَيْـًٔا وَلَا يَضُرُّكُمْ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "021/066",
            "text": "Dedi ki: \"O halde, Allah'ı bırakıp da sizlere yararı olmayan ve zararı dokunmayan şeylere mi tapıyorsunuz?\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "021/066",
            "text": "İbrahim: \"O halde, Allah'ı bırakıp da size hiçbir fayda ve zarar veremeyecek olan putlara ne diye taparsınız? Size de, Allah'ı bırakıp taptıklarınıza da yazıklar olsun! Akletmiyor musunuz?\" dedi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "021/066",
            "text": "He said, \"Then do you worship instead of Allah that which does not benefit you at all or harm you?"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "021/066",
            "text": "Abraham said: \"Do you, then, worship beside Allah a thing that can neither benefit you nor hurt you?"
          }
        }
      ],
      "status": "approved",
