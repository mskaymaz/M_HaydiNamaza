    {
      "ref": "008/062",
      "id": "008/062",
      "surah": 8,
      "ayahStart": 62,
      "ayahEnd": 62,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 495,
        "ref": "008/062",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 352,
        "input_status": "kaynak_birleşik:008/062-063",
        "input_source_ref_groups": "008/062-063"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "008/062-063"
      ],
      "ayahs": [
        {
          "ref": "008/062",
          "surah": 8,
          "ayah": 62,
          "arabic": "وَإِن يُرِيدُوٓا۟ أَن يَخْدَعُوكَ فَإِنَّ حَسْبَكَ ٱللَّهُ ۚ هُوَ ٱلَّذِىٓ أَيَّدَكَ بِنَصْرِهِۦ وَبِٱلْمُؤْمِنِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "008/062",
            "text": "Onlar, seni aldatmak isterlerse, şüphesiz Allah sana yeter. O, seni yardımıyla ve mü'minlerle destekledi."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "008/062",
            "text": "Seni aldatmak isterlerse, bil ki şüphesiz Allah sana kafidir. Seni ve inananları yardımıyla destekleyen, kalblerini uzlaştıran O'dur. Eğer yeryüzünde olan her şeyi sarfetsen bile, sen onların kalblerini uzlaştıramazdın, ama Allah onları uzlaştırdı. Doğrusu O Güçlü'dür, Hakim'dir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "008/062",
            "text": "But if they intend to deceive you - then sufficient for you is Allah. It is He who supported you with His help and with the believers"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "008/062",
            "text": "And should they seek to deceive you, Allah is sufficient for you. He it is Who strengthened you with His succour and the believers"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Enfal",
      "ayah_number": 62,
      "ayah_end_number": 62,
      "text_ar": "وَإِن يُرِيدُوٓا۟ أَن يَخْدَعُوكَ فَإِنَّ حَسْبَكَ ٱللَّهُ ۚ هُوَ ٱلَّذِىٓ أَيَّدَكَ بِنَصْرِهِۦ وَبِٱلْمُؤْمِنِينَ",
      "text_tr": "Onlar, seni aldatmak isterlerse, şüphesiz Allah sana yeter. O, seni yardımıyla ve mü'minlerle destekledi.",
      "text_en": "But if they intend to deceive you - then sufficient for you is Allah. It is He who supported you with His help and with the believers",
