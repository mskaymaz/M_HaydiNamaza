    {
      "ref": "004/037",
      "id": "004/037",
      "surah": 4,
      "ayahStart": 37,
      "ayahEnd": 37,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 248,
        "ref": "004/037",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 180,
        "input_status": "ok",
        "input_source_ref_groups": "004/037"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "004/037"
      ],
      "ayahs": [
        {
          "ref": "004/037",
          "surah": 4,
          "ayah": 37,
          "arabic": "ٱلَّذِينَ يَبْخَلُونَ وَيَأْمُرُونَ ٱلنَّاسَ بِٱلْبُخْلِ وَيَكْتُمُونَ مَآ ءَاتَىٰهُمُ ٱللَّهُ مِن فَضْلِهِۦ ۗ وَأَعْتَدْنَا لِلْكَـٰفِرِينَ عَذَابًا مُّهِينًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/037",
            "text": "Onlar, cimrilikte bulunurlar, insanlara da cimriliği emreder (önerir)ler. Allah'ın fazlından kendilerine verdiğini gizli tutarlar. Biz o kafirlere aşağılatıcı bir azap hazırlamışızdır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/037",
            "text": "Onlar cimrilik ederler, insanlara cimrilik tavsiyesinde bulunurlar, Allah'ın bol nimetinden kendilerine verdiğini gizlerler. Kafirlere aşağılık bir azab hazırlamışızdır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/037",
            "text": "Who are stingy and enjoin upon [other] people stinginess and conceal what Allah has given them of His bounty - and We have prepared for the disbelievers a humiliating punishment -"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/037",
            "text": "who are niggardly and bid others to be niggardly and conceal the bounty which Allah has bestowed upon them. We have kept in readiness a humiliating chastisement for such deniers (of Allah's bounty)."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
