          "ref": "081/021",
          "surah": 81,
          "ayah": 21,
          "arabic": "مُّطَاعٍ ثَمَّ أَمِينٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "081/021",
            "text": "Ona itaat edilir, sonra güvenilirdir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "081/021",
            "text": "Bu Kuran, arşın sahibi katında değerli, güçlü, sözü dinlenen ve güvenilen şerefli bir elçinin getirdiği sözdür."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "081/021",
            "text": "Obeyed there [in the heavens] and trustworthy."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "081/021",
            "text": "there he is obeyed and held trustworthy."
          }
        }
      ],
