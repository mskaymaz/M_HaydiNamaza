      "ref": "016/113",
      "id": "016/113",
      "surah": 16,
      "ayahStart": 113,
      "ayahEnd": 113,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 689,
        "ref": "016/113",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 118,
        "input_status": "ok",
        "input_source_ref_groups": "016/113"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "016/113"
      ],
      "ayahs": [
        {
          "ref": "016/113",
          "surah": 16,
          "ayah": 113,
          "arabic": "وَلَقَدْ جَآءَهُمْ رَسُولٌ مِّنْهُمْ فَكَذَّبُوهُ فَأَخَذَهُمُ ٱلْعَذَابُ وَهُمْ ظَـٰلِمُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "016/113",
            "text": "Andolsun, onlara kendi içlerinden bir elçi gelmişti, fakat onu yalanladılar; böylece onlar, zulümlerine devam etmektelerken azap onları yakalayıverdi."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "016/113",
            "text": "And olsun ki, aralarından kendilerine bir peygamber gelmişti, onu yalancı saydılar. Haksızlık ederlerken azaba uğradılar."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "016/113",
            "text": "And there had certainly come to them a Messenger from among themselves, but they denied him; so punishment overtook them while they were wrongdoers."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "016/113",
            "text": "Most certainly a Messenger came to them from among them; but they rejected him, calling him a liar. Therefore chastisement seized them while they engaged in wrong-doing."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
