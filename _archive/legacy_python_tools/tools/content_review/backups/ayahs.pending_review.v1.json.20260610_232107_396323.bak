          "ref": "007/109",
          "surah": 7,
          "ayah": 109,
          "arabic": "قَالَ ٱلْمَلَأُ مِن قَوْمِ فِرْعَوْنَ إِنَّ هَـٰذَا لَسَـٰحِرٌ عَلِيمٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "007/109",
            "text": "Firavun kavminin önde gelenleri dediler ki: \"Bu gerçekten bilgin bir büyücüdür\";"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "007/109",
            "text": "Firavun milletinin ileri gelenleri, \"Doğrusu bu bilgin bir sihirbazdır, sizi memleketinizden çıkarmak istiyor\" dediler. Firavun: \"Ne buyurursunuz?\" dedi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "007/109",
            "text": "Said the eminent among the people of Pharaoh, \"Indeed, this is a learned magician"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "007/109",
            "text": "The elders of Pharaoh's people said: 'Surely this man is a skilful magician"
          }
        }
      ],
