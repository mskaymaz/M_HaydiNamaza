    {
      "ref": "012/067",
      "id": "012/067",
      "surah": 12,
      "ayahStart": 67,
      "ayahEnd": 67,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 629,
        "ref": "012/067",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 238,
        "input_status": "ok",
        "input_source_ref_groups": "012/067"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "012/067"
      ],
      "ayahs": [
        {
          "ref": "012/067",
          "surah": 12,
          "ayah": 67,
          "arabic": "وَقَالَ يَـٰبَنِىَّ لَا تَدْخُلُوا۟ مِنۢ بَابٍ وَٰحِدٍ وَٱدْخُلُوا۟ مِنْ أَبْوَٰبٍ مُّتَفَرِّقَةٍ ۖ وَمَآ أُغْنِى عَنكُم مِّنَ ٱللَّهِ مِن شَىْءٍ ۖ إِنِ ٱلْحُكْمُ إِلَّا لِلَّهِ ۖ عَلَيْهِ تَوَكَّلْتُ ۖ وَعَلَيْهِ فَلْيَتَوَكَّلِ ٱلْمُتَوَكِّلُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "012/067",
            "text": "Ve dedi ki: \"Ey çocuklarım, tek bir kapıdan girmeyin, ayrı ayrı kapılardan girin. Ben size Allah'tan hiçbir şeyi sağlayamam (gideremem). Hüküm yalnızca Allah'ındır. Ben O'na tevekkül ettim. Tevekkül edenler de yalnızca O'na tevekkül etmelidirler.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "012/067",
            "text": "Babaları: \"Oğullarım! Tek bir kapıdan değil, ayrı ayrı kapılardan girin. Ama Allah katında size bir faydam olmaz, hüküm ancak Allah'ındır, O'na güvendim, güvenenler de O'na güvensinler\" dedi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "012/067",
            "text": "And he said, \"O my sons, do not enter from one gate but enter from different gates; and I cannot avail you against [the decree of] Allah at all. The decision is only for Allah; upon Him I have relied, and upon Him let those who would rely [indeed] rely.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "012/067",
            "text": "And he enjoined them: \"My sons! Do not enter the city by one gate; rather enter it by different gates. I can be of no help to you against Allah. Allah's command alone prevails. In Him have I put my trust and in Him should all those who have faith put their trust.\""
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Yusuf",
      "ayah_number": 67,
      "ayah_end_number": 67,
      "text_ar": "وَقَالَ يَـٰبَنِىَّ لَا تَدْخُلُوا۟ مِنۢ بَابٍ وَٰحِدٍ وَٱدْخُلُوا۟ مِنْ أَبْوَٰبٍ مُّتَفَرِّقَةٍ ۖ وَمَآ أُغْنِى عَنكُم مِّنَ ٱللَّهِ مِن شَىْءٍ ۖ إِنِ ٱلْحُكْمُ إِلَّا لِلَّهِ ۖ عَلَيْهِ تَوَكَّلْتُ ۖ وَعَلَيْهِ فَلْيَتَوَكَّلِ ٱلْمُتَوَكِّلُونَ",
      "text_tr": "Ve dedi ki: \"Ey çocuklarım, tek bir kapıdan girmeyin, ayrı ayrı kapılardan girin. Ben size Allah'tan hiçbir şeyi sağlayamam (gideremem). Hüküm yalnızca Allah'ındır. Ben O'na tevekkül ettim. Tevekkül edenler de yalnızca O'na tevekkül etmelidirler.\"",
