    {
      "ref": "004/038",
      "id": "004/038",
      "surah": 4,
      "ayahStart": 38,
      "ayahEnd": 38,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 249,
        "ref": "004/038",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 154,
        "input_status": "ok",
        "input_source_ref_groups": "004/038"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "004/038"
      ],
      "ayahs": [
        {
          "ref": "004/038",
          "surah": 4,
          "ayah": 38,
          "arabic": "وَٱلَّذِينَ يُنفِقُونَ أَمْوَٰلَهُمْ رِئَآءَ ٱلنَّاسِ وَلَا يُؤْمِنُونَ بِٱللَّهِ وَلَا بِٱلْيَوْمِ ٱلْءَاخِرِ ۗ وَمَن يَكُنِ ٱلشَّيْطَـٰنُ لَهُۥ قَرِينًا فَسَآءَ قَرِينًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/038",
            "text": "Ve onlar, mallarını insanlara gösteriş olsun diye infak ederler, Allah'a ve ahiret gününe de inanmazlar. Şeytan, kime arkadaş olursa, artık ne kötü bir arkadaştır o."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/038",
            "text": "Mallarını insanlara gösteriş için sarfedip, Allah'a ve ahiret gününe inanmayanları da Allah sevmez. Şeytanın arkadaş olduğu kimsenin ne fena arkadaşı vardır!"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/038",
            "text": "And [also] those who spend of their wealth to be seen by the people and believe not in Allah nor in the Last Day. And he to whom Satan is a companion - then evil is he as a companion."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/038",
            "text": "Allah does not love those who spend out of their wealth to make a show of it to people when they believe neither in Allah nor in the Last Day. And he who has taken Satan for a companion has indeed taken for himself a very bad companion."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
