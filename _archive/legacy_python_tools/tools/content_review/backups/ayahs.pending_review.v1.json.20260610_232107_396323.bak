      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "008/055"
      ],
      "ayahs": [
        {
          "ref": "008/055",
          "surah": 8,
          "ayah": 55,
          "arabic": "إِنَّ شَرَّ ٱلدَّوَآبِّ عِندَ ٱللَّهِ ٱلَّذِينَ كَفَرُوا۟ فَهُمْ لَا يُؤْمِنُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "008/055",
            "text": "Allah Katında canlıların en kötüsü, şüphesiz inkar edenlerdir. Onlar artık inanmazlar."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "008/055",
            "text": "Allah katında yeryüzünde yaşayanların en kötüsü, inkar edenlerdir. Onlar artık inanmazlar."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "008/055",
            "text": "Indeed, the worst of living creatures in the sight of Allah are those who have disbelieved, and they will not [ever] believe -"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "008/055",
            "text": "Surely the worst moving creatures in the sight of Allah are those who definitively denied the truth and are therefore in no way prepared to accept it;"
          }
        }
      ],
      "status": "approved",
