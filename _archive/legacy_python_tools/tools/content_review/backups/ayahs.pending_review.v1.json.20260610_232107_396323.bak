      "ayahs": [
        {
          "ref": "033/003",
          "surah": 33,
          "ayah": 3,
          "arabic": "وَتَوَكَّلْ عَلَى ٱللَّهِ ۚ وَكَفَىٰ بِٱللَّهِ وَكِيلًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "033/003",
            "text": "Allah'a tevekkül et; vekil olarak Allah yeter."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "033/003",
            "text": "Allah'a güven, Allah, vekil olarak yeter."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "033/003",
            "text": "And rely upon Allah; and sufficient is Allah as Disposer of affairs."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "033/003",
            "text": "Put your trust in Allah: Allah is sufficient as Guardian."
          }
        }
      ],
