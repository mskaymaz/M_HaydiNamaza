      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "037/149"
      ],
      "ayahs": [
        {
          "ref": "037/149",
          "surah": 37,
          "ayah": 149,
          "arabic": "فَٱسْتَفْتِهِمْ أَلِرَبِّكَ ٱلْبَنَاتُ وَلَهُمُ ٱلْبَنُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "037/149",
            "text": "Şimdi sen onlara sor: -Kızlar senin Rabbinin, erkek çocuklar onların mı?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "037/149",
            "text": "Putperestlere sor, kızlar senin Rabbinin de erkekler onların mı?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "037/149",
            "text": "So inquire of them, [O Muhammad], \"Does your Lord have daughters while they have sons?"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "037/149",
            "text": "So ask their opinion: “(Are you convinced) that your Lord should have daughters and you should have sons?"
          }
        }
      ],
      "status": "approved",
