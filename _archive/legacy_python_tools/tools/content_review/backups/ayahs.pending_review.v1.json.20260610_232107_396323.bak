    {
      "ref": "004/112",
      "id": "004/112",
      "surah": 4,
      "ayahStart": 112,
      "ayahEnd": 112,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 284,
        "ref": "004/112",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 139,
        "input_status": "ok",
        "input_source_ref_groups": "004/112"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "004/112"
      ],
      "ayahs": [
        {
          "ref": "004/112",
          "surah": 4,
          "ayah": 112,
          "arabic": "وَمَن يَكْسِبْ خَطِيٓـَٔةً أَوْ إِثْمًا ثُمَّ يَرْمِ بِهِۦ بَرِيٓـًٔا فَقَدِ ٱحْتَمَلَ بُهْتَـٰنًا وَإِثْمًا مُّبِينًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/112",
            "text": "Kim bir hata veya günah kazanır da sonra bunu bir suçsuza yüklerse, gerçekten o, böyle bir yalan (bühtan)ı ve apaçık bir günahı yüklenmiştir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/112",
            "text": "Kim yanılır veya suç işler de sonra onu bir suçsuzun üzerine atarsa, şüphesiz iftira etmiş, apaçık bir günah yüklenmiş olur."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/112",
            "text": "But whoever earns an offense or a sin and then blames it on an innocent [person] has taken upon himself a slander and manifest sin."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/112",
            "text": "But he who commits either a fault or a sin, and then casts it upon an innocent person, lays upon himself the burden of a false charge and a flagrant sin."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
