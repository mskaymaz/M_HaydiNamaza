        "input_char_count": 331,
        "input_status": "ok",
        "input_source_ref_groups": "009/004"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "009/004"
      ],
      "ayahs": [
        {
          "ref": "009/004",
          "surah": 9,
          "ayah": 4,
          "arabic": "إِلَّا ٱلَّذِينَ عَـٰهَدتُّم مِّنَ ٱلْمُشْرِكِينَ ثُمَّ لَمْ يَنقُصُوكُمْ شَيْـًٔا وَلَمْ يُظَـٰهِرُوا۟ عَلَيْكُمْ أَحَدًا فَأَتِمُّوٓا۟ إِلَيْهِمْ عَهْدَهُمْ إِلَىٰ مُدَّتِهِمْ ۚ إِنَّ ٱللَّهَ يُحِبُّ ٱلْمُتَّقِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "009/004",
            "text": "Ancak müşriklerden kendileriyle antlaşma imzaladıklarınızdan (antlaşmadan) bir şeyi eksiltmeyenler ve size karşı hiç kimseye yardım etmeyenler başka; artık antlaşmalarını, süresi bitene kadar tamamlayın. Şüphesiz, Allah muttaki olanları sever."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "009/004",
            "text": "Yalnız, andlaşma hükümlerinde size karşı bir eksiklik yapmayan ve aleyhinizde kimseye yardım etmeyen müşriklerle yaptığınız andlaşmaya sonuna kadar riayet edin. Allah sakınanları sever."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "009/004",
            "text": "Excepted are those with whom you made a treaty among the polytheists and then they have not been deficient toward you in anything or supported anyone against you; so complete for them their treaty until their term [has ended]. Indeed, Allah loves the righteous [who fear Him]."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "009/004",
            "text": "In exception to those who associate others with Allah in His Divinity are those with whom you have made treaties and who have not violated their treaties nor have backed up anyone against you. Fulfil your treaties with them till the end of their term. Surely Allah loves the pious.\""
          }
        }
      ],
      "status": "approved",
