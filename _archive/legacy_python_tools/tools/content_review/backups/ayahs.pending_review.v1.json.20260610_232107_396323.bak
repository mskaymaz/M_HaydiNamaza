    {
      "ref": "012/043",
      "id": "012/043",
      "surah": 12,
      "ayahStart": 43,
      "ayahEnd": 43,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 623,
        "ref": "012/043",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 197,
        "input_status": "ok",
        "input_source_ref_groups": "012/043"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "012/043"
      ],
      "ayahs": [
        {
          "ref": "012/043",
          "surah": 12,
          "ayah": 43,
          "arabic": "وَقَالَ ٱلْمَلِكُ إِنِّىٓ أَرَىٰ سَبْعَ بَقَرَٰتٍ سِمَانٍ يَأْكُلُهُنَّ سَبْعٌ عِجَافٌ وَسَبْعَ سُنۢبُلَـٰتٍ خُضْرٍ وَأُخَرَ يَابِسَـٰتٍ ۖ يَـٰٓأَيُّهَا ٱلْمَلَأُ أَفْتُونِى فِى رُءْيَـٰىَ إِن كُنتُمْ لِلرُّءْيَا تَعْبُرُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "012/043",
            "text": "Hükümdar: \"Ben (rüyamda) yedi besili inek görüyorum, onları yedi zayıf inek yiyor; bir de yedi yeşil başak ve diğerleri ise kupkuru. Ey önde gelen (kahin-bilginler,) eğer rüya yorumluyorsanız benim bu rüyamı çözüverin\" dedi."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "012/043",
            "text": "Hükümdar: \"Ben, yedi semiz ineği yedi zayıf ineğin yediğini; yedi yeşil başak ve bir o kadar da kurumuş başak görüyorum. Ey ileri gelenler! Eğer rüya yormasını biliyorsanız rüyamı söyleyiniz.\" dedi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "012/043",
            "text": "And [subsequently] the king said, \"Indeed, I have seen [in a dream] seven fat cows being eaten by seven [that were] lean, and seven green spikes [of grain] and others [that were] dry. O eminent ones, explain to me my vision, if you should interpret visions.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "012/043",
            "text": "And once the king said: \"I have dreamt that there are seven fat cows and seven lean cows are devouring them, and there are seven fresh green ears of corn and seven others dry and withered. My nobles! Tell me what is the interpretation of this dream, if you are well-versed in interpretation of dreams.\""
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
