      "input": {
        "sira": 63,
        "ref": "002/135",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 192,
        "input_status": "ok",
        "input_source_ref_groups": "002/135"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "002/135"
      ],
      "ayahs": [
        {
          "ref": "002/135",
          "surah": 2,
          "ayah": 135,
          "arabic": "وَقَالُوا۟ كُونُوا۟ هُودًا أَوْ نَصَـٰرَىٰ تَهْتَدُوا۟ ۗ قُلْ بَلْ مِلَّةَ إِبْرَٰهِـۧمَ حَنِيفًا ۖ وَمَا كَانَ مِنَ ٱلْمُشْرِكِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "002/135",
            "text": "Dediler ki: \"Yahudi veya Hıristiyan olun ki hidayete eresiniz.\" De ki: \"Hayır, (doğru yol) Hanif (muvahhid) olan İbrahim'in dini(dir); O müşriklerden değildi.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "002/135",
            "text": "\"Yahudi veya Hıristiyan olun ki doğru yolu bulasınız\" dediler. \"Doğruya yönelmiş olan ve Allah'a eş koşanlardan olmayan İbrahim'in dinine uyarız\" de."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "002/135",
            "text": "They say, \"Be Jews or Christians [so] you will be guided.\" Say, \"Rather, [we follow] the religion of Abraham, inclining toward truth, and he was not of the polytheists.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "002/135",
            "text": "The Jews say, \"Become Jews and you will be rightly guided\"; the Christians say, \"Become Christians and you will have the true guidance.\" Say to them, \"Nay, we turn away from every other way and accept the way of Abraham, and Abraham did not associate other gods with Allah.\""
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
