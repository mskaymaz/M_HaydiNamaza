            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "019/088",
            "text": "And they say, \"The Most Merciful has taken [for Himself] a son.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "019/088",
            "text": "They claim: \"The Most Compassionate Lord has taken a son to Himself.\""
          }
        }
