      "ayahs": [
        {
          "ref": "089/009",
          "surah": 89,
          "ayah": 9,
          "arabic": "وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "089/009",
            "text": "Ve vadilerde kayaları oyup biçen Semud'a?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "089/009",
            "text": "Vadide kayaları kesip yontan Semud milletine, memleketlerde aşırı giden, oralarda bozgunculuğu artıran, sarsılmaz bir saltanat sahibi Firavun'a Rabbinin ne ettiğini görmedin mi?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "089/009",
            "text": "And [with] Thamud, who carved out the rocks in the valley?"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "089/009",
            "text": "And how did He deal with Thamud who hewed out rocks in the valley?"
          }
        }
      ],
