        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 125,
        "input_status": "ok",
        "input_source_ref_groups": "003/105"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "003/105"
      ],
      "ayahs": [
        {
          "ref": "003/105",
          "surah": 3,
          "ayah": 105,
          "arabic": "وَلَا تَكُونُوا۟ كَٱلَّذِينَ تَفَرَّقُوا۟ وَٱخْتَلَفُوا۟ مِنۢ بَعْدِ مَا جَآءَهُمُ ٱلْبَيِّنَـٰتُ ۚ وَأُو۟لَـٰٓئِكَ لَهُمْ عَذَابٌ عَظِيمٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "003/105",
            "text": "Kendilerine apaçık belgeler geldikten sonra, parçalanıp ayrılan ve anlaşmazlığa düşenler gibi olmayın. İşte onlar için büyük bir azap vardır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "003/105",
            "text": "Kendilerine belgeler geldikten sonra ayrılan ve ayrılığa düşenler gibi olmayın. Bir takım yüzlerin ağaracağı ve bir takım yüzlerin kararacağı günde büyük azab onlaradır. Yüzleri kararanlara: \"İnanmanızdan sonra inkar eder misiniz? İnkar etmenizden dolayı tadın azabı\" denecektir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "003/105",
            "text": "And do not be like the ones who became divided and differed after the clear proofs had come to them. And those will have a great punishment."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "003/105",
            "text": "Do not be like those who fell into factions and differed among themselves after clear signs had come to them. A mighty chastisement awaits them on the Day when some faces will turn bright and ther faces will turn dark. Those whose faces have turned dark will be told: 'Did you fall into unbelief after you had been blessed with belief? Taste, then, chastise- ment for your unbelief.' And those whose faces have turned bright, they will be in the mercy of Allah, and therein they shall abide. These are the mes sages of Allah which We recite to you in truth, and Allah desires no wrong to the people of the world. To Allah belongs all that is in the heavens and the earth, and to Allah are all matters referred for decision."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
