      "ayahs": [
        {
          "ref": "005/035",
          "surah": 5,
          "ayah": 35,
          "arabic": "يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱتَّقُوا۟ ٱللَّهَ وَٱبْتَغُوٓا۟ إِلَيْهِ ٱلْوَسِيلَةَ وَجَـٰهِدُوا۟ فِى سَبِيلِهِۦ لَعَلَّكُمْ تُفْلِحُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "005/035",
            "text": "Ey iman edenler, Allah'tan korkup-sakının ve (sizi) O'na (yaklaştıracak) vesile arayın; O'nun yolunda cihad edin, umulur ki kurtuluşa erersiniz."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "005/035",
            "text": "Ey İnananlar! Allah'tan sakının, O'na ulaşmaya yol arayın, yolunda cihad edin ki kurtulasınız."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "005/035",
            "text": "O you who have believed, fear Allah and seek the means [of nearness] to Him and strive in His cause that you may succeed."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "005/035",
            "text": "Believers! Fear Allah and seek the means to come near to Him, and strive hard in His way; maybe you will attain true success."
          }
        }
      ],
