      "ayahs": [
        {
          "ref": "014/041",
          "surah": 14,
          "ayah": 41,
          "arabic": "رَبَّنَا ٱغْفِرْ لِى وَلِوَٰلِدَىَّ وَلِلْمُؤْمِنِينَ يَوْمَ يَقُومُ ٱلْحِسَابُ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "014/041",
            "text": "\"Rabbimiz, hesabın yapılacağı gün, beni, anne-babamı ve mü'minleri bağışla\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "014/041",
            "text": "\"Rabbimiz! Hesap görülecek günde, beni, anamı babamı ve inananları bağışla.\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "014/041",
            "text": "Our Lord, forgive me and my parents and the believers the Day the account is established.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "014/041",
            "text": "Our Lord! Forgive me and my parents and the believers on the Day when the reckoning will take place.\""
          }
        }
      ],
