      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "099/001-003"
      ],
      "ayahs": [
        {
          "ref": "099/001",
          "surah": 99,
          "ayah": 1,
          "arabic": "\\basmalah إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "099/001",
            "text": "Yer, o şiddetli sarsıntısıyla sarsıldığı,"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "099/001",
            "text": "Yer dehşetle sarsıldıkça sarsıldığı, yeryüzü ağırlıklarını dışarıya çıkardığı ve insanın: \"Buna ne oluyor?\" dediği zaman;"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "099/001",
            "text": "When the earth is shaken with its [final] earthquake"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "099/001",
            "text": "When the earth will be shaken with a mighty shaking,"
          }
        },
        {
          "ref": "099/002",
          "surah": 99,
          "ayah": 2,
          "arabic": "وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "099/002",
            "text": "Yer, ağırlıklarını dışa atıp-çıkardığı,"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "099/002",
            "text": "Yer dehşetle sarsıldıkça sarsıldığı, yeryüzü ağırlıklarını dışarıya çıkardığı ve insanın: \"Buna ne oluyor?\" dediği zaman;"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "099/002",
            "text": "And the earth discharges its burdens"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "099/002",
            "text": "and the earth will throw up all her burdens,"
          }
        },
        {
          "ref": "099/003",
          "surah": 99,
          "ayah": 3,
          "arabic": "وَقَالَ ٱلْإِنسَـٰنُ مَا لَهَا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "099/003",
            "text": "Ve insan: \"Buna ne oluyor?\" dediği zaman;"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "099/003",
            "text": "Yer dehşetle sarsıldıkça sarsıldığı, yeryüzü ağırlıklarını dışarıya çıkardığı ve insanın: \"Buna ne oluyor?\" dediği zaman;"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "099/003",
            "text": "And man says, \"What is [wrong] with it?\" -"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "099/003",
            "text": "and man will cry out: “What is the matter with her?”"
          }
        }
      ],
