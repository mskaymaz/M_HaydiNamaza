        "input_ayah_count": 1,
        "input_char_count": 120,
        "input_status": "ok",
        "input_source_ref_groups": "009/057"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "009/057"
      ],
      "ayahs": [
        {
          "ref": "009/057",
          "surah": 9,
          "ayah": 57,
          "arabic": "لَوْ يَجِدُونَ مَلْجَـًٔا أَوْ مَغَـٰرَٰتٍ أَوْ مُدَّخَلًا لَّوَلَّوْا۟ إِلَيْهِ وَهُمْ يَجْمَحُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "009/057",
            "text": "Eğer onlar bir sığınak ya da (kalacak) mağaralar veya girebilecekleri bir yer bulsalardı, hızla oraya yönelip koşarlardı."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "009/057",
            "text": "Bir sığınak veya mağara yahut girecek bir yer bulmuş olsalardı, çarçabuk oraya yönelirlerdi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "009/057",
            "text": "If they could find a refuge or some caves or any place to enter [and hide], they would turn to it while they run heedlessly."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "009/057",
            "text": "If they could find any shelter or any cavern, or any retreat, they would turn around and rush headlong into it."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
