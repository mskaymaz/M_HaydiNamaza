      ],
      "ayahs": [
        {
          "ref": "043/057",
          "surah": 43,
          "ayah": 57,
          "arabic": "وَلَمَّا ضُرِبَ ٱبْنُ مَرْيَمَ مَثَلًا إِذَا قَوْمُكَ مِنْهُ يَصِدُّونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "043/057",
            "text": "Meryem oğlu (İsa) bir örnek olarak verilince, senin kavmin hemen ondan (keyifle söz edip) kahkahalarla gülüyorlar."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "043/057",
            "text": "Meryem oğlu misal verilince, senin milletin buna gülüp geçiverdi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "043/057",
            "text": "And when the son of Mary was presented as an example, immediately your people laughed aloud."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "043/057",
            "text": "No sooner the example of the son of Mary was mentioned than, lo and behold, your people raised a clamour"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
