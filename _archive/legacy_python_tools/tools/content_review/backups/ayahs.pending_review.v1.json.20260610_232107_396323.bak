      "ref": "043/015",
      "id": "043/015",
      "surah": 43,
      "ayahStart": 15,
      "ayahEnd": 15,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 1114,
        "ref": "043/015",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 144,
        "input_status": "ok",
        "input_source_ref_groups": "043/015"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "043/015"
      ],
      "ayahs": [
        {
          "ref": "043/015",
          "surah": 43,
          "ayah": 15,
          "arabic": "وَجَعَلُوا۟ لَهُۥ مِنْ عِبَادِهِۦ جُزْءًا ۚ إِنَّ ٱلْإِنسَـٰنَ لَكَفُورٌ مُّبِينٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "043/015",
            "text": "(Buna rağmen) Kendi kullarından O'na bir parça kılıp-yakıştırdılar. Doğrusu insan, açıkça bir nankördür."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "043/015",
            "text": "Ama inkarcılar O'na çocuk isnat ettiler. İnsan gerçekten apaçık nankördür."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "043/015",
            "text": "But they have attributed to Him from His servants a portion. Indeed, man is clearly ungrateful."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "043/015",
            "text": "Yet they have made some of His servants a part of Him. Indeed man is most evidently thankless."
          }
