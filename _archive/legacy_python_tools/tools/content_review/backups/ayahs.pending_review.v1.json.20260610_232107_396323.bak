        "input_ayah_count": 1,
        "input_char_count": 171,
        "input_status": "ok",
        "input_source_ref_groups": "045/016"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "045/016"
      ],
      "ayahs": [
        {
          "ref": "045/016",
          "surah": 45,
          "ayah": 16,
          "arabic": "وَلَقَدْ ءَاتَيْنَا بَنِىٓ إِسْرَٰٓءِيلَ ٱلْكِتَـٰبَ وَٱلْحُكْمَ وَٱلنُّبُوَّةَ وَرَزَقْنَـٰهُم مِّنَ ٱلطَّيِّبَـٰتِ وَفَضَّلْنَـٰهُمْ عَلَى ٱلْعَـٰلَمِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "045/016",
            "text": "Andolsun, Biz İsrailoğulları'na kitap, hüküm ve peygamberlik verdik, onları temiz ve güzel şeylerle rızıklandırdık ve onları alemlere üstün kıldık."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "045/016",
            "text": "And olsun ki Biz, İsrailoğullarına Kitap, hüküm ve peygamberlik verdik; onları temiz şeylerle rızıklandırdık; onları dünyalara üstün kıldık."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "045/016",
            "text": "And We did certainly give the Children of Israel the Scripture and judgement and prophethood, and We provided them with good things and preferred them over the worlds."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "045/016",
            "text": "Indeed We endowed the Children of Israel with the Book and Wisdom and Prophethood, and provided them with good things as sustenance, and exalted them above the peoples of the whole world."
          }
        }
      ],
      "status": "approved",
