    {
      "ref": "033/017",
      "id": "033/017",
      "surah": 33,
      "ayahStart": 17,
      "ayahEnd": 17,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 975,
        "ref": "033/017",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 210,
        "input_status": "ok",
        "input_source_ref_groups": "033/017"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "033/017"
      ],
      "ayahs": [
        {
          "ref": "033/017",
          "surah": 33,
          "ayah": 17,
          "arabic": "قُلْ مَن ذَا ٱلَّذِى يَعْصِمُكُم مِّنَ ٱللَّهِ إِنْ أَرَادَ بِكُمْ سُوٓءًا أَوْ أَرَادَ بِكُمْ رَحْمَةً ۚ وَلَا يَجِدُونَ لَهُم مِّن دُونِ ٱللَّهِ وَلِيًّا وَلَا نَصِيرًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "033/017",
            "text": "De ki: \"Size bir kötülük isteyecek olsa sizi Allah'tan koruyacak, veya size bir rahmet isteyecek olsa (buna engel olacak) kimdir?\" Onlar, kendileri için Allah'ın dışında ne bir veli, ne bir yardımcı bulamazlar."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "033/017",
            "text": "De ki: \"Allah size bir kötülük dilese veya bir rahmet istese, O'na karşı kim sizi koruyabilir? Allah'tan başka dost ve yardımcı da bulamazsınız.\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "033/017",
            "text": "Say, \"Who is it that can protect you from Allah if He intends for you an ill or intends for you a mercy?\" And they will not find for themselves besides Allah any protector or any helper."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "033/017",
            "text": "Say (to them): “Who can protect you from Allah if He desires an evil for you? And who can prevent Him if He desires to show mercy to you?” They shall find none other than Allah to be their protector or helper."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
