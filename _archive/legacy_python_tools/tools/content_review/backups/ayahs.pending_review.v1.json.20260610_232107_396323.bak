    {
      "ref": "009/090",
      "id": "009/090",
      "surah": 9,
      "ayahStart": 90,
      "ayahEnd": 90,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 555,
        "ref": "009/090",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 224,
        "input_status": "ok",
        "input_source_ref_groups": "009/090"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "009/090"
      ],
      "ayahs": [
        {
          "ref": "009/090",
          "surah": 9,
          "ayah": 90,
          "arabic": "وَجَآءَ ٱلْمُعَذِّرُونَ مِنَ ٱلْأَعْرَابِ لِيُؤْذَنَ لَهُمْ وَقَعَدَ ٱلَّذِينَ كَذَبُوا۟ ٱللَّهَ وَرَسُولَهُۥ ۚ سَيُصِيبُ ٱلَّذِينَ كَفَرُوا۟ مِنْهُمْ عَذَابٌ أَلِيمٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "009/090",
            "text": "Bedevilerden özür belirtenler, kendilerine izin verilmesi için geldiler. Allah'a ve elçisine yalan söyleyenler de oturup kaldı. Onlardan inkar edenlere pek acı bir azap isabet edecektir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "009/090",
            "text": "Bedevilerden, izin almak üzere, özür beyan eden kimseler geldiler. Allah'a ve Peygamberine yalan söyleyenler ise, özür bile beyan etmeksizin geri kaldılar. Onlardan kafir olanlar can yakıcı azaba uğrayacaktır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "009/090",
            "text": "And those with excuses among the bedouins came to be permitted [to remain], and they who had lied to Allah and His Messenger sat [at home]. There will strike those who disbelieved among them a painful punishment."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "009/090",
            "text": "Many of the bedouin Arabs came with excuses, seeking leave to stay behind. Thus those who were false to Allah and His Messenger in their covenant remained behind. A painful chastisement shall befall those of them that disbelieved."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
