    {
      "ref": "009/098",
      "id": "009/098",
      "surah": 9,
      "ayahStart": 98,
      "ayahEnd": 98,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 559,
        "ref": "009/098",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 227,
        "input_status": "ok",
        "input_source_ref_groups": "009/098"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "009/098"
      ],
      "ayahs": [
        {
          "ref": "009/098",
          "surah": 9,
          "ayah": 98,
          "arabic": "وَمِنَ ٱلْأَعْرَابِ مَن يَتَّخِذُ مَا يُنفِقُ مَغْرَمًا وَيَتَرَبَّصُ بِكُمُ ٱلدَّوَآئِرَ ۚ عَلَيْهِمْ دَآئِرَةُ ٱلسَّوْءِ ۗ وَٱللَّهُ سَمِيعٌ عَلِيمٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "009/098",
            "text": "Bedevilerden öyleleri vardır ki, infak ettiğini bir cereme sayar ve sizi felaketlerin sarıvermesini bekler. Kötü felaket onları sarsın. Allah işitendir, bilendir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "009/098",
            "text": "Bedevilerden, Allah yolunda sarfettiklerini angarya sayanlar ve sizin başınıza belalar gelmesini bekleyenler vardır. Belalar onlara olsun; Allah işitir ve bilir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "009/098",
            "text": "And among the bedouins are some who consider what they spend as a loss and await for you turns of misfortune. Upon them will be a misfortune of evil. And Allah is Hearing and Knowing."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "009/098",
            "text": "And among the bedouin Arabs there are such as regard whatever they spend (in the Way of Allah) as a fine and wait for some misfortune to befall you. May ill fortune befall them! Allah is All-Hearing, All-Knowing."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
