          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/139",
            "text": "Onlar, mü'minleri bırakıp kafirleri dostlar (veliler) edinirler. 'Kuvvet ve onuru (izzeti)' onların yanında mı arıyorlar? Şüphesiz, 'bütün kuvvet ve onur,' Allah'ındır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/139",
            "text": "Onlar, inananları bırakıp da kafirleri dost edinirler; onların tarafında bir şeref ve kudret mi arıyorlar? Doğrusu kudret bütün olarak Allah'ındır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/139",
            "text": "Those who take disbelievers as allies instead of the believers. Do they seek with them honor [through power]? But indeed, honor belongs to Allah entirely."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/139",
            "text": "who take the unbelievers for their allies in preference to the believers. Do they seek honour from them whereas honour altogether belongs to Allah alone?"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Nisa",
      "ayah_number": 139,
      "ayah_end_number": 139,
      "text_ar": "ٱلَّذِينَ يَتَّخِذُونَ ٱلْكَـٰفِرِينَ أَوْلِيَآءَ مِن دُونِ ٱلْمُؤْمِنِينَ ۚ أَيَبْتَغُونَ عِندَهُمُ ٱلْعِزَّةَ فَإِنَّ ٱلْعِزَّةَ لِلَّهِ جَمِيعًا",
      "text_tr": "Onlar, mü'minleri bırakıp kafirleri dostlar (veliler) edinirler. 'Kuvvet ve onuru (izzeti)' onların yanında mı arıyorlar? Şüphesiz, 'bütün kuvvet ve onur,' Allah'ındır.",
      "text_en": "Those who take disbelievers as allies instead of the believers. Do they seek with them honor [through power]? But indeed, honor belongs to Allah entirely.",
      "priority": 1,
