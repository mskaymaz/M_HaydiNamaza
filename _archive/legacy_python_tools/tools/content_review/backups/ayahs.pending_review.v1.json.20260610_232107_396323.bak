      },
      "sourceRefGroups": [
        "012/106"
      ],
      "ayahs": [
        {
          "ref": "012/106",
          "surah": 12,
          "ayah": 106,
          "arabic": "وَمَا يُؤْمِنُ أَكْثَرُهُم بِٱللَّهِ إِلَّا وَهُم مُّشْرِكُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "012/106",
            "text": "Onların çoğu Allah'a iman etmezler de ancak şirk katıp-dururlar."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "012/106",
            "text": "Onların çoğu, ortak koşmadan Allah'a inanmazlar."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "012/106",
            "text": "And most of them believe not in Allah except while they associate others with Him."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "012/106",
            "text": "And most of them believe in Allah only when they associate others with Him in His Divinity."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
