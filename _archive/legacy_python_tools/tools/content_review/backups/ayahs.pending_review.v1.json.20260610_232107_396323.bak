        "input_ayah_count": 1,
        "input_char_count": 135,
        "input_status": "ok",
        "input_source_ref_groups": "006/023"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "006/023"
      ],
      "ayahs": [
        {
          "ref": "006/023",
          "surah": 6,
          "ayah": 23,
          "arabic": "ثُمَّ لَمْ تَكُن فِتْنَتُهُمْ إِلَّآ أَن قَالُوا۟ وَٱللَّهِ رَبِّنَا مَا كُنَّا مُشْرِكِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "006/023",
            "text": "(Bundan) Sonra onların: \"Rabbimiz olan Allah'a andolsun ki, biz müşriklerden değildik\" demelerinden başka bir fitneleri olmadı (kalmadı.)"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "006/023",
            "text": "Sonra, \"Rabbimiz Allah'a and olsun ki bizler ortak koşanlar değildik\" demekten başka çare bulamazlar."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "006/023",
            "text": "Then there will be no [excuse upon] examination except they will say, \"By Allah, our Lord, we were not those who associated.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "006/023",
            "text": "Then they will be able to play no mischief but will say (falsely): 'By Allah, our Lord, we associated none (with You in Your divinity).'"
          }
        }
      ],
