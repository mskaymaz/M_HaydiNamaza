        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 123,
        "input_status": "ok",
        "input_source_ref_groups": "016/022"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "016/022"
      ],
      "ayahs": [
        {
          "ref": "016/022",
          "surah": 16,
          "ayah": 22,
          "arabic": "إِلَـٰهُكُمْ إِلَـٰهٌ وَٰحِدٌ ۚ فَٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْءَاخِرَةِ قُلُوبُهُم مُّنكِرَةٌ وَهُم مُّسْتَكْبِرُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "016/022",
            "text": "Sizin İlahınız tek bir İlah'tır. Ahirete inanmayanların kalpleri ise inkarcıdır ve onlar müstekbir (büyüklenmekte) olanlardır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "016/022",
            "text": "Tanrınız tek bir Tanrıdır. Ahirete inanmayanların kalbleri bunu inkar eder; onlar büyüklük taslarlar."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "016/022",
            "text": "Your god is one God. But those who do not believe in the Hereafter - their hearts are disapproving, and they are arrogant."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "016/022",
            "text": "Your God is the One God. But the hearts of those who do not believe in the Hereafter are steeped in rejection of the Truth, and they are given to arrogance."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Nahl",
      "ayah_number": 22,
      "ayah_end_number": 22,
