      "ayahs": [
        {
          "ref": "022/001",
          "surah": 22,
          "ayah": 1,
          "arabic": "\\basmalah يَـٰٓأَيُّهَا ٱلنَّاسُ ٱتَّقُوا۟ رَبَّكُمْ ۚ إِنَّ زَلْزَلَةَ ٱلسَّاعَةِ شَىْءٌ عَظِيمٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "022/001",
            "text": "Ey insanlar, Rabbinizden korkup-sakının, çünkü kıyamet saatinin sarsıntısı büyük bir şeydir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "022/001",
            "text": "Ey insanlar! Rabbinizden sakının; doğrusu kıyamet gününün sarsıntısı büyük şeydir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "022/001",
            "text": "O mankind, fear your Lord. Indeed, the convulsion of the [final] Hour is a terrible thing."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "022/001",
            "text": "O mankind, fear the (wrath of) your Lord! Indeed, the earthquake of the Hour (of Judgement) will be an awesome thing."
          }
        }
      ],
