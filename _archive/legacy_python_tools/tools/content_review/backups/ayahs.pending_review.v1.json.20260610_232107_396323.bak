      "ayahs": [
        {
          "ref": "036/010",
          "surah": 36,
          "ayah": 10,
          "arabic": "وَسَوَآءٌ عَلَيْهِمْ ءَأَنذَرْتَهُمْ أَمْ لَمْ تُنذِرْهُمْ لَا يُؤْمِنُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "036/010",
            "text": "Kendilerini uyarsan da, uyarmasan da onlar için birdir; inanmazlar."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "036/010",
            "text": "Onları uyarsan da uyarmasan da birdir, inanmazlar."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "036/010",
            "text": "And it is all the same for them whether you warn them or do not warn them - they will not believe."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "036/010",
            "text": "It is all the same for them whether you warn them or do not warn them for they shall not believe."
          }
        }
      ],
