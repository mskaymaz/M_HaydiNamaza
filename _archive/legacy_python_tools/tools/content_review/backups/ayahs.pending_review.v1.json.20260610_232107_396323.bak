        "input_status": "ok",
        "input_source_ref_groups": "030/022"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "030/022"
      ],
      "ayahs": [
        {
          "ref": "030/022",
          "surah": 30,
          "ayah": 22,
          "arabic": "وَمِنْ ءَايَـٰتِهِۦ خَلْقُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَٱخْتِلَـٰفُ أَلْسِنَتِكُمْ وَأَلْوَٰنِكُمْ ۚ إِنَّ فِى ذَٰلِكَ لَـَٔايَـٰتٍ لِّلْعَـٰلِمِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "030/022",
            "text": "Göklerin ve yerin yaratılması ile dillerinizin ve renklerinizin ayrı olması, O'nun ayetlerindendir. Şüphesiz bunda, alimler için gerçekten ayetler vardır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "030/022",
            "text": "Gökleri ve yeri yaratması, dillerinizin ve renklerinizin değişik olması, O'nun varlığının belgelerindendir. Doğrusu bunlarda, bilenler için dersler vardır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "030/022",
            "text": "And of His signs is the creation of the heavens and the earth and the diversity of your languages and your colors. Indeed in that are signs for those of knowledge."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "030/022",
            "text": "And of His Signs is the creation of the heavens and the earth and the diversity of your tongues and colours. Indeed there are Signs in this for the wise."
          }
        }
      ],
      "status": "approved",
