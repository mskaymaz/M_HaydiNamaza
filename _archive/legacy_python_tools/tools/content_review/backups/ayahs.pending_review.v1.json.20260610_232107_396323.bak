          "ref": "002/042",
          "surah": 2,
          "ayah": 42,
          "arabic": "وَلَا تَلْبِسُوا۟ ٱلْحَقَّ بِٱلْبَـٰطِلِ وَتَكْتُمُوا۟ ٱلْحَقَّ وَأَنتُمْ تَعْلَمُونَ",
          "tr": {
            "source": "Tanzil tr.bulac - Ali Bulaç",
            "text": "Hakkı batıl ile örtmeyin ve hakkı gizlemeyin. (Kaldı ki) siz (gerçeği) biliyorsunuz."
          },
          "en": {
            "source": "Tanzil en.sahih - Saheeh International",
            "text": "And do not mix the truth with falsehood or conceal the truth while you know [it]."
          },
          "alternatives": {
