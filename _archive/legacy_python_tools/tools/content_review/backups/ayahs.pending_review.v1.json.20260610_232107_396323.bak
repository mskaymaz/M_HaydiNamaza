          "ref": "079/012",
          "surah": 79,
          "ayah": 12,
          "arabic": "قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "079/012",
            "text": "Derler ki: \"Şu durumda, zararına bir dönüştür bu.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "079/012",
            "text": "Derler ki: \"O takdirde bu zararına bir dönüştür.\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "079/012",
            "text": "They say, \"That, then, would be a losing return.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "079/012",
            "text": "They say: “That will then be a return with a great loss!”"
          }
        }
      ],
