          "surah": 19,
          "ayah": 89,
          "arabic": "لَّقَدْ جِئْتُمْ شَيْـًٔا إِدًّا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "019/089",
            "text": "Andolsun, siz oldukça çirkin bir cesarette bulunup-geldiniz."
