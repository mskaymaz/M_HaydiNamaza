        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 83,
        "input_status": "ok",
        "input_source_ref_groups": "003/071"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "003/071"
      ],
      "ayahs": [
        {
          "ref": "003/071",
          "surah": 3,
          "ayah": 71,
          "arabic": "يَـٰٓأَهْلَ ٱلْكِتَـٰبِ لِمَ تَلْبِسُونَ ٱلْحَقَّ بِٱلْبَـٰطِلِ وَتَكْتُمُونَ ٱلْحَقَّ وَأَنتُمْ تَعْلَمُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "003/071",
            "text": "Ey Kitap Ehli, neden hakkı batıl ile örtüyor ve bildiğiniz halde hakkı gizliyorsunuz?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "003/071",
            "text": "Ey Kitap ehli! Niçin hakkı batıla karıştırıyor ve bile bile hakkı gizliyorsunuz?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "003/071",
            "text": "O People of the Scripture, why do you confuse the truth with falsehood and conceal the truth while you know [it]?"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "003/071",
            "text": "People of the Book! Why do you confound Truth with falsehood, and why do you conceal the Truth knowingly?"
          }
        }
      ],
      "status": "approved",
