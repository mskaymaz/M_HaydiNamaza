          "arabic": "ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "055/005",
            "text": "Güneş ve ay (belli) bir hesap iledir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "055/005",
            "text": "Güneş ve ayın hareketleri bir hesaba göredir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "055/005",
            "text": "The sun and the moon [move] by precise calculation,"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "055/005",
            "text": "The sun and the moon follow a reckoning,"
          }
        },
        {
          "ref": "055/006",
          "surah": 55,
          "ayah": 6,
          "arabic": "وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "055/006",
            "text": "Bitki ve ağaç (O'na) secde etmektedirler."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "055/006",
            "text": "Bitkiler ve ağaçlar O'nun buyruğuna boyun eğerler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "055/006",
            "text": "And the stars and trees prostrate."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "055/006",
            "text": "and the stars and the trees all prostrate themselves,"
          }
        }
      ],
