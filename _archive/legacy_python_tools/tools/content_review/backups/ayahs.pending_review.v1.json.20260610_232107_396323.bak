      "ayahs": [
        {
          "ref": "075/005",
          "surah": 75,
          "ayah": 5,
          "arabic": "بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "075/005",
            "text": "Ancak insan, önündeki (sonsuz geleceği)ni de 'fücurla sürdürmek ister.'"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "075/005",
            "text": "Ama, insanoğlu gelecekte de suç işlemek ister de: \"Kıyamet günü ne zamanmış! \" der."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "075/005",
            "text": "But man desires to continue in sin."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "075/005",
            "text": "But man desires to persist in his evil ways."
          }
        }
      ],
