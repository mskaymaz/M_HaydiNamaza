    {
      "ref": "029/017",
      "id": "029/017",
      "surah": 29,
      "ayahStart": 17,
      "ayahEnd": 17,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 930,
        "ref": "029/017",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 262,
        "input_status": "ok",
        "input_source_ref_groups": "029/017"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "029/017"
      ],
      "ayahs": [
        {
          "ref": "029/017",
          "surah": 29,
          "ayah": 17,
          "arabic": "إِنَّمَا تَعْبُدُونَ مِن دُونِ ٱللَّهِ أَوْثَـٰنًا وَتَخْلُقُونَ إِفْكًا ۚ إِنَّ ٱلَّذِينَ تَعْبُدُونَ مِن دُونِ ٱللَّهِ لَا يَمْلِكُونَ لَكُمْ رِزْقًا فَٱبْتَغُوا۟ عِندَ ٱللَّهِ ٱلرِّزْقَ وَٱعْبُدُوهُ وَٱشْكُرُوا۟ لَهُۥٓ ۖ إِلَيْهِ تُرْجَعُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "029/017",
            "text": "\"Siz yalnızca Allah'tan başka birtakım putlara tapıyor ve birtakım yalanlar uyduruyorsunuz. Gerçek şu ki, sizin Allah'tan başka taptıklarınız, size rızık vermeye güç yetiremezler; öyleyse rızkı Allah'ın Katında arayın, O'na kulluk edin ve O'na şükredin. Siz O'na döndürüleceksiniz.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "029/017",
            "text": "Siz Allah'ı bırakıp sadece bir takım putlara tapıyor, aslı olmayan sözler uyduruyorsunuz. Doğrusu, Allah'tan başka taptıklarınızın size rızık vermeye güçleri yetmez. Artık rızkı Allah katında arayın. O'na kulluk edin. O'na şükredin. Siz O'na döneceksiniz."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "029/017",
            "text": "You only worship, besides Allah, idols, and you produce a falsehood. Indeed, those you worship besides Allah do not possess for you [the power of] provision. So seek from Allah provision and worship Him and be grateful to Him. To Him you will be returned.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "029/017",
            "text": "Those that you worship instead of Allah are merely idols, and you are simply inventing lies (about them). Indeed those whom you worship beside Allah have no power to provide you with any sustenance. So seek your sustenance from Allah and serve only Him and give thanks to Him alone. It is to Him that you will be sent back."
          }
        }
      ],
