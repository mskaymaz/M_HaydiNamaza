      "sourceRefGroups": [
        "052/029"
      ],
      "ayahs": [
        {
          "ref": "052/029",
          "surah": 52,
          "ayah": 29,
          "arabic": "فَذَكِّرْ فَمَآ أَنتَ بِنِعْمَتِ رَبِّكَ بِكَاهِنٍ وَلَا مَجْنُونٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "052/029",
            "text": "Şu halde sen, öğüt verip-hatırlat; çünkü sen, Rabbinin nimetiyle ne kahinsin, ne mecnun."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "052/029",
            "text": "Öğüt ver; Rabbinin nimetiyle sen, ne kahinsin ne de delisin."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "052/029",
            "text": "So remind [O Muhammad], for you are not, by the favor of your Lord, a soothsayer or a madman."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "052/029",
            "text": "So exhort (them, O Prophet), for by your Lord's Grace, you are neither a soothsayer nor a madman."
          }
        }
      ],
