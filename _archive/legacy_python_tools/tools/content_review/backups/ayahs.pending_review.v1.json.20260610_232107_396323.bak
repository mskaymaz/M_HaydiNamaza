      },
      "sourceRefGroups": [
        "040/070"
      ],
      "ayahs": [
        {
          "ref": "040/070",
          "surah": 40,
          "ayah": 70,
          "arabic": "ٱلَّذِينَ كَذَّبُوا۟ بِٱلْكِتَـٰبِ وَبِمَآ أَرْسَلْنَا بِهِۦ رُسُلَنَا ۖ فَسَوْفَ يَعْلَمُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "040/070",
            "text": "Ki onlar, Kitab'ı ve elçilerimizle gönderdiğimiz şeyleri yalanladılar. Artık yakında bileceklerdir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "040/070",
            "text": "Kitap'ı ve peygamberlerimize gönderdiklerimizi yalanlayanlar elbette bileceklerdir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "040/070",
            "text": "Those who deny the Book and that with which We sent Our messengers - they are going to know,"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "040/070",
            "text": "Those who gave the lie to this Book and all the Books which We had sent with Our Messengers shall soon come to know the Truth"
          }
        }
      ],
