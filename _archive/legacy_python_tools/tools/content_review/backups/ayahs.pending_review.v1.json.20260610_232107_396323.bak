        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 173,
        "input_status": "ok",
        "input_source_ref_groups": "014/036"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "014/036"
      ],
      "ayahs": [
        {
          "ref": "014/036",
          "surah": 14,
          "ayah": 36,
          "arabic": "رَبِّ إِنَّهُنَّ أَضْلَلْنَ كَثِيرًا مِّنَ ٱلنَّاسِ ۖ فَمَن تَبِعَنِى فَإِنَّهُۥ مِنِّى ۖ وَمَنْ عَصَانِى فَإِنَّكَ غَفُورٌ رَّحِيمٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "014/036",
            "text": "\"Rabbim, gerçekten onlar insanlardan birçoğunu şaşırtıp-saptırdı. Bundan böyle kim bana uyarsa, artık o bendendir, kim bana isyan ederse elbette Sen, bağışlayansın, esirgeyensin.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "014/036",
            "text": "\"Rabbim! O putlar çok insanları saptırdı; bana uyan bendendir, bana karşı gelen kimseyi Sana bırakırım; Sen bağışlarsın, merhamet edersin.\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "014/036",
            "text": "My Lord, indeed they have led astray many among the people. So whoever follows me - then he is of me; and whoever disobeys me - indeed, You are [yet] Forgiving and Merciful."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "014/036",
            "text": "My Lord! They have caused many people to go astray. Now, if anyone follows my way, he is from me; and if anyone follows a way opposed to mine, then surely You are Ever-Forgiving, Most Merciful.\""
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
