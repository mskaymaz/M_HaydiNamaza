    {
      "ref": "003/095",
      "id": "003/095",
      "surah": 3,
      "ayahStart": 95,
      "ayahEnd": 95,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 174,
        "ref": "003/095",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 119,
        "input_status": "ok",
        "input_source_ref_groups": "003/095"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "003/095"
      ],
      "ayahs": [
        {
          "ref": "003/095",
          "surah": 3,
          "ayah": 95,
          "arabic": "قُلْ صَدَقَ ٱللَّهُ ۗ فَٱتَّبِعُوا۟ مِلَّةَ إِبْرَٰهِيمَ حَنِيفًا وَمَا كَانَ مِنَ ٱلْمُشْرِكِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "003/095",
            "text": "De ki: \"Allah doğru söyledi. Öyleyse Allah'ı bir tanıyan (Hanif)ler olarak İbrahim'in dinine uyun. O, müşriklerden değildi.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "003/095",
            "text": "De ki: \"Allah doğru söyledi, doğruya meyleden İbrahim'in dinine uyun; O, puta tapanlardan değildi\"."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "003/095",
            "text": "Say, \"Allah has told the truth. So follow the religion of Abraham, inclining toward truth; and he was not of the polytheists.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "003/095",
            "text": "Say: 'Whatever Allah has said is true. Follow, then, the way of Abraham in total devotion to Allah. He was not one of those who associate others with Allah in His divinity."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
