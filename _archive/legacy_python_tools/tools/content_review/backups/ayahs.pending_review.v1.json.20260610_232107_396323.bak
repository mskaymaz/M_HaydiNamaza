      "ayahs": [
        {
          "ref": "033/070",
          "surah": 33,
          "ayah": 70,
          "arabic": "يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱتَّقُوا۟ ٱللَّهَ وَقُولُوا۟ قَوْلًا سَدِيدًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulac",
            "sourceRef": "033/070",
            "text": "Ey iman edenler, Allah'tan sakının ve sözü doğru söyleyin."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "033/070",
            "text": "O you who have believed, fear Allah and speak words of appropriate justice."
          },
          "alternatives": {
            "tr_diyanet_tanzil": {
              "source": "Tanzil tr.diyanet / Diyanet Isleri",
              "text": "Ey inananlar! Allah'tan sakının, dürüst söz söyleyin de Allah işlerinizi kendinize yararlı kılsın ve günahlarınızı size bağışlasın. Kim Allah'a ve Peygamber'ine itaat ederse, şüphesiz büyük bir kurtuluşa ermiş olur."
            },
            "en_maududi": {
              "source": "Tanzil en.maududi / Abul A'la Maududi",
              "text": "Believers, fear Allah and speak the truth:"
            }
          }
        }
      ],
