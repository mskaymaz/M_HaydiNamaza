        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 168,
        "input_status": "ok",
        "input_source_ref_groups": "022/045"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "022/045"
      ],
      "ayahs": [
        {
          "ref": "022/045",
          "surah": 22,
          "ayah": 45,
          "arabic": "فَكَأَيِّن مِّن قَرْيَةٍ أَهْلَكْنَـٰهَا وَهِىَ ظَالِمَةٌ فَهِىَ خَاوِيَةٌ عَلَىٰ عُرُوشِهَا وَبِئْرٍ مُّعَطَّلَةٍ وَقَصْرٍ مَّشِيدٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "022/045",
            "text": "(Halkı) Zulmediyorken yıkıma uğrattığımız nice ülkeler vardır ki, şimdi onların altları üstlerine gelmiş ıpıssız durmakta, kullanılamaz durumdaki kuyuları (terk edilmiş bulunmakta), yüksek sarayları (çın çın ötmektedir)."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "022/045",
            "text": "Nice kasabaların halkını haksızlık yaparken yok ettik. Artık çatıları çökmüş, kuyuları metruk, sarayları bomboş kalmıştır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "022/045",
            "text": "And how many a city did We destroy while it was committing wrong - so it is [now] fallen into ruin - and [how many] an abandoned well and [how many] a lofty palace."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "022/045",
            "text": "How many towns have We destroyed because their people were steeped in iniquity: so they lie fallen down upon their turrets! How many wells lie deserted; and how many towering palaces lie in ruins!"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
