          "ref": "104/001",
          "surah": 104,
          "ayah": 1,
          "arabic": "\\basmalah وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "104/001",
            "text": "Arkadan çekiştirip duran, kaş göz hareketleriyle alay eden her kişinin vay haline;"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "104/001",
            "text": "Mal toplayarak onu tekrar tekrar sayan, diliyle çekiştirip alay eden kimsenin vay haline!"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "104/001",
            "text": "Woe to every scorner and mocker"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "104/001",
            "text": "Woe to every fault-finding backbiter;"
          }
        }
      ],
