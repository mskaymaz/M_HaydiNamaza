        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 115,
        "input_status": "ok",
        "input_source_ref_groups": "008/025"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "008/025"
      ],
      "ayahs": [
        {
          "ref": "008/025",
          "surah": 8,
          "ayah": 25,
          "arabic": "وَٱتَّقُوا۟ فِتْنَةً لَّا تُصِيبَنَّ ٱلَّذِينَ ظَلَمُوا۟ مِنكُمْ خَآصَّةً ۖ وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ شَدِيدُ ٱلْعِقَابِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "008/025",
            "text": "Ve sizlerden yalnızca zulmedenlere isabet etmekle kalmayan bir fitneden korkup-sakının. Bilin ki, gerçekten Allah (ceza ile) sonuçlandırması pek şiddetli olandır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "008/025",
            "text": "Aranızdan yalnız zalimlere erişmekle kalmayacak fitneden sakının, Allah'ın azabının şiddetli olduğunu bilin."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "008/025",
            "text": "And fear a trial which will not strike those who have wronged among you exclusively, and know that Allah is severe in penalty."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "008/025",
            "text": "And guard against the mischief that will not only bring punishment to the wrong-doers among you. Know well that Allah is severe in punishment."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:50:08+00:00"
      },
      "surah_name": "Enfal",
      "ayah_number": 25,
      "ayah_end_number": 25,
