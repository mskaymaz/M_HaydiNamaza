    {
      "ref": "002/211",
      "id": "002/211",
      "surah": 2,
      "ayahStart": 211,
      "ayahEnd": 211,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 98,
        "ref": "002/211",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 176,
        "input_status": "ok",
        "input_source_ref_groups": "002/211"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "002/211"
      ],
      "ayahs": [
        {
          "ref": "002/211",
          "surah": 2,
          "ayah": 211,
          "arabic": "سَلْ بَنِىٓ إِسْرَٰٓءِيلَ كَمْ ءَاتَيْنَـٰهُم مِّنْ ءَايَةٍۭ بَيِّنَةٍ ۗ وَمَن يُبَدِّلْ نِعْمَةَ ٱللَّهِ مِنۢ بَعْدِ مَا جَآءَتْهُ فَإِنَّ ٱللَّهَ شَدِيدُ ٱلْعِقَابِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "002/211",
            "text": "İsrailoğulları’na sor, onlara nice açık ayet(ler) verdik. Kendisine geldikten sonra kim Allah'ın nimetini değiştirirse, (bilsin ki) şüphesiz Allah, cezası pek şiddetli olandır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "002/211",
            "text": "İsrailoğullarına sor; onlara apaçık nice ayetler verdik, Allah'ın nimetini, kendisine geldikten sonra kim değiştirirse, bilsin ki, Allah'ın cezası şüphesiz şiddetlidir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "002/211",
            "text": "Ask the Children of Israel how many a sign of evidence We have given them. And whoever exchanges the favor of Allah [for disbelief] after it has come to him - then indeed, Allah is severe in penalty."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "002/211",
            "text": "Ask the children of Israel how many a clear sign We have shown to them: (also ask them) what a severe chastisement Allah inflicts on the community that, after receiving Allah's favour exchanges it (for wretchdness)."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
