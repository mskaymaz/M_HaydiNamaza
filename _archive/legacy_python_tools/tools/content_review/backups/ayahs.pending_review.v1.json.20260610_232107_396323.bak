            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "069/008",
            "text": "Then do you see of them any remains?"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "069/008",
            "text": "Do you now see any trace of them?"
          }
        }
      ],
