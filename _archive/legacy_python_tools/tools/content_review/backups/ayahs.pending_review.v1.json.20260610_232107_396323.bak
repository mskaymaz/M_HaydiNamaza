    {
      "ref": "031/021",
      "id": "031/021",
      "surah": 31,
      "ayahStart": 21,
      "ayahEnd": 21,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 963,
        "ref": "031/021",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 182,
        "input_status": "ok",
        "input_source_ref_groups": "031/021"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "031/021"
      ],
      "ayahs": [
        {
          "ref": "031/021",
          "surah": 31,
          "ayah": 21,
          "arabic": "وَإِذَا قِيلَ لَهُمُ ٱتَّبِعُوا۟ مَآ أَنزَلَ ٱللَّهُ قَالُوا۟ بَلْ نَتَّبِعُ مَا وَجَدْنَا عَلَيْهِ ءَابَآءَنَآ ۚ أَوَلَوْ كَانَ ٱلشَّيْطَـٰنُ يَدْعُوهُمْ إِلَىٰ عَذَابِ ٱلسَّعِيرِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "031/021",
            "text": "Onlara; \"Allah'ın indirdiklerine uyun\" denildiğinde, derler ki; \"Hayır, biz atalarımızı üzerinde bulduğumuz şeye uyarız.\" Şayet şeytan, onları çılgınca yanan ateşin azabına çağırmışsa da mı (buna uyacaklar)?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "031/021",
            "text": "Onlara, \"Allah'ın indirdiğine uyun\" denince: \"Babalarımızı üzerinde bulduğumuz yola uyarız\" derler. Ya şeytan, babalarını alevli ateşin azabına çağırmışsa?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "031/021",
            "text": "And when it is said to them, \"Follow what Allah has revealed,\" they say, \"Rather, we will follow that upon which we found our fathers.\" Even if Satan was inviting them to the punishment of the Blaze?"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "031/021",
            "text": "When they are told: “Follow what Allah has revealed,” they say: “We will rather follow that which we have found our forefathers following.” (Will they follow that) even though Satan might invite them to the chastisement of the Blazing Fire?"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
