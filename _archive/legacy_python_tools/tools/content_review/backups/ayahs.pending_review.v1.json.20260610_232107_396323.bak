    {
      "id": "008/030",
      "kind": "ayah",
      "ref": "008/030",
      "ar": "وَإِذْ يَمْكُرُ بِكَ ٱلَّذِينَ كَفَرُوا۟ لِيُثْبِتُوكَ أَوْ يَقْتُلُوكَ أَوْ يُخْرِجُوكَ ۚ وَيَمْكُرُونَ وَيَمْكُرُ ٱللَّهُ ۖ وَٱللَّهُ خَيْرُ ٱلْمَـٰكِرِينَ",
      "tr": "Hani o inkar edenler, seni tutuklamak ya da öldürmek veya sürgün etmek amacıyla, tuzak kuruyorlardı. Onlar bu tuzağı tasarlıyorlarken, Allah da bir düzen (bir karşılık) kuruyordu. Allah, düzen kurucuların (tuzaklarına karşılık verenlerin) hayırlısıdır.",
      "en": "And [remember, O Muhammad], when those who disbelieved plotted against you to restrain you or kill you or evict you [from Makkah]. But they plan, and Allah plans. And Allah is the best of planners.",
      "priority": 2,
      "approvedAt": "2026-06-10T08:15:54+00:00",
      "surah_number": 8,
      "surah_name": "Enfal",
      "ayah_number": 30,
      "ayah_end_number": null,
      "durum": "yayina_hazir",
      "source": {
        "arabic": "ayahs.v1.approved.json",
        "trAlt": "ayahs.v1.approved.json / approved TR",
        "enAlt": "ayahs.v1.approved.json / approved EN"
      },
      "text_tr_alt": "Hani o inkar edenler, seni tutuklamak ya da öldürmek veya sürgün etmek amacıyla, tuzak kuruyorlardı. Onlar bu tuzağı tasarlıyorlarken, Allah da bir düzen (bir karşılık) kuruyordu. Allah, düzen kurucuların (tuzaklarına karşılık verenlerin) hayırlısıdır.",
      "text_en_alt": "And [remember, O Muhammad], when those who disbelieved plotted against you to restrain you or kill you or evict you [from Makkah]. But they plan, and Allah plans. And Allah is the best of planners.",
      "selected_translation": {
        "tr": "alt",
        "en": "alt"
      },
      "status": "approved",
      "notes": "YOK",
