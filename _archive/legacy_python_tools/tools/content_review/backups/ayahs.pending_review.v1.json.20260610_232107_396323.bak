          "ref": "089/008",
          "surah": 89,
          "ayah": 8,
          "arabic": "ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَـٰدِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "089/008",
            "text": "Ki şehirler içinde onun bir benzeri yaratılmış değildi."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "089/008",
            "text": "Rabbinin, hiçbir memlekette benzeri ortaya konmayan sütunlara sahip İrem şehrinde oturan Ad milletine ne ettiğini görmedin mi?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "089/008",
            "text": "The likes of whom had never been created in the land?"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "089/008",
            "text": "the like of whom no nation was ever created in the lands of the world?"
          }
        }
      ],
