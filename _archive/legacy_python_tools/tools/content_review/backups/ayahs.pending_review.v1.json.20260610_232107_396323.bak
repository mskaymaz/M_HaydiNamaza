      "input": {
        "sira": 577,
        "ref": "010/017",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 147,
        "input_status": "ok",
        "input_source_ref_groups": "010/017"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "010/017"
      ],
      "ayahs": [
        {
          "ref": "010/017",
          "surah": 10,
          "ayah": 17,
          "arabic": "فَمَنْ أَظْلَمُ مِمَّنِ ٱفْتَرَىٰ عَلَى ٱللَّهِ كَذِبًا أَوْ كَذَّبَ بِـَٔايَـٰتِهِۦٓ ۚ إِنَّهُۥ لَا يُفْلِحُ ٱلْمُجْرِمُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "010/017",
            "text": "Allah'a karşı yalan uydurup iftira düzenden ve O'nun ayetlerini yalanlayandan daha zalim kimdir? Şüphesiz O, suçlu-günahkarları kurtuluşa erdirmez."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "010/017",
            "text": "Allah'a karşı yalan uyduran veya ayetlerini yalan sayandan daha zalim kim olabilir? Suçlular elbette saadete erişemezler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "010/017",
            "text": "So who is more unjust than he who invents a lie about Allah or denies His signs? Indeed, the criminals will not succeed"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "010/017",
            "text": "Who, then, is a greater wrong-doer than he who forges a lie against Allah or rejects His signs as false? Surely the guilty shall not prosper."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
