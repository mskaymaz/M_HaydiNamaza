          "ref": "052/010",
          "surah": 52,
          "ayah": 10,
          "arabic": "وَتَسِيرُ ٱلْجِبَالُ سَيْرًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "052/010",
            "text": "Ve dağlar (yerlerinden oynatan) bir yürüyüşle yürür."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "052/010",
            "text": "Göğün sarsıldıkça sarsılacağı, dağların yürüdükçe yürüyeceği gün; işte o gün, daldıkları yerde eğlenip oyalanarak kıyameti yalanlayanlara yazık olacak!"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "052/010",
            "text": "And the mountains will pass on, departing -"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "052/010",
            "text": "and the mountains shall violently fly about."
          }
        }
      ],
