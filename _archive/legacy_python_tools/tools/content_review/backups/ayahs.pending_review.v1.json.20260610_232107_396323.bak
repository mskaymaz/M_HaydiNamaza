      "ayahs": [
        {
          "ref": "076/030",
          "surah": 76,
          "ayah": 30,
          "arabic": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "076/030",
            "text": "Allah dilemedikçe siz dileyemezsiniz. Gerçekten Allah, bilendir, hüküm ve hikmet sahibidir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "076/030",
            "text": "Allah dilemedikçe siz dileyemezsiniz. Doğrusu Allah, bilendir, Hakim'dir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "076/030",
            "text": "And you do not will except that Allah wills. Indeed, Allah is ever Knowing and Wise."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "076/030",
            "text": "But your willing shall be of no avail until Allah Himself so wills. Surely Allah is All-Knowing, Most Wise."
          }
        }
      ],
