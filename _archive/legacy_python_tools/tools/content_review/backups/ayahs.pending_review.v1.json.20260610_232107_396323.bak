      "sourceRefGroups": [
        "004/071"
      ],
      "ayahs": [
        {
          "ref": "004/071",
          "surah": 4,
          "ayah": 71,
          "arabic": "يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ خُذُوا۟ حِذْرَكُمْ فَٱنفِرُوا۟ ثُبَاتٍ أَوِ ٱنفِرُوا۟ جَمِيعًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/071",
            "text": "Ey iman edenler, (düşmanlarınıza karşı) tedbirinizi alın da savaşa bölük bölük çıkın ya da topluca çıkın."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/071",
            "text": "Ey İnananlar! İhtiyatlı davranın, bölük bölük veya hep birden savaşa gidin."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/071",
            "text": "O you who have believed, take your precaution and [either] go forth in companies or go forth all together."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/071",
            "text": "Believers! Always be on your guard against encounters. Then (as circumstance demands) either advance in detachments or advance in a body."
          }
        }
      ],
      "status": "approved",
      "review": {
