    },
    {
      "id": "026/151",
      "kind": "ayah",
      "ref": "026/151",
      "ar": "وَلَا تُطِيعُوٓا۟ أَمْرَ ٱلْمُسْرِفِينَ",
      "tr": "\"Ve ölçüsüzce davrananların emrine itaat etmeyin.\"",
      "en": "And do not obey the order of the transgressors,",
      "priority": 1,
      "surah_number": 26,
      "surah_name": "Suara",
      "ayah_number": 151,
      "ayah_end_number": 151,
      "status": "pending_review"
    },
    {
      "id": "026/152",
      "kind": "ayah",
      "ref": "026/152",
      "ar": "ٱلَّذِينَ يُفْسِدُونَ فِى ٱلْأَرْضِ وَلَا يُصْلِحُونَ",
      "tr": "\"Ki onlar, yeryüzünde bozgunculuk çıkarıyor ve dirlik-düzenlik kurmuyorlar (ıslah etmiyorlar).\"",
      "en": "Who cause corruption in the land and do not amend.\"",
      "priority": 1,
      "surah_number": 26,
      "surah_name": "Suara",
      "ayah_number": 152,
      "ayah_end_number": 152,
      "status": "pending_review"
    },
    {
      "id": "026/162",
      "kind": "ayah",
      "ref": "026/162",
      "ar": "إِنِّى لَكُمْ رَسُولٌ أَمِينٌ",
      "tr": "\"Gerçek şu ki, ben size gönderilmiş güvenilir bir elçiyim.\"",
      "en": "Indeed, I am to you a trustworthy messenger.",
      "priority": 1,
      "surah_number": 26,
      "surah_name": "Suara",
      "ayah_number": 162,
      "ayah_end_number": 162,
      "status": "pending_review"
    },
    {
      "id": "026/151-152",
      "kind": "ayah",
      "ref": "026/151-152",
      "ar": "﴿151﴾ وَلَا تُطِيعُوٓا۟ أَمْرَ ٱلْمُسْرِفِينَ\n\n﴿152﴾ ٱلَّذِينَ يُفْسِدُونَ فِى ٱلْأَرْضِ وَلَا يُصْلِحُونَ",
      "tr": "[151] \"Ve ölçüsüzce davrananların emrine itaat etmeyin.\"\n\n[152] \"Ki onlar, yeryüzünde bozgunculuk çıkarıyor ve dirlik-düzenlik kurmuyorlar (ıslah etmiyorlar).\"",
      "en": "[151] And do not obey the order of the transgressors,\n\n[152] Who cause corruption in the land and do not amend.\"",
