      "ayahs": [
        {
          "ref": "078/006",
          "surah": 78,
          "ayah": 6,
          "arabic": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَـٰدًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "078/006",
            "text": "Biz, yeryüzünü bir döşek kılmadık mı?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "078/006",
            "text": "Biz yeryüzünü bir beşik, dağları da onun için birer direk kılmadık mı?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "078/006",
            "text": "Have We not made the earth a resting place?"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "078/006",
            "text": "Have We not spread the earth like a bed,"
          }
        },
        {
          "ref": "078/007",
          "surah": 78,
          "ayah": 7,
          "arabic": "وَٱلْجِبَالَ أَوْتَادًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "078/007",
            "text": "Dağları da birer kazık?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "078/007",
            "text": "Biz yeryüzünü bir beşik, dağları da onun için birer direk kılmadık mı?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "078/007",
            "text": "And the mountains as stakes?"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "078/007",
            "text": "and fixed the mountains like pegs,"
          }
        },
        {
          "ref": "078/008",
          "surah": 78,
          "ayah": 8,
          "arabic": "وَخَلَقْنَـٰكُمْ أَزْوَٰجًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "078/008",
            "text": "Sizi çift çift yarattık."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "078/008",
            "text": "Sizi çift çift yarattık;"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "078/008",
            "text": "And We created you in pairs"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "078/008",
            "text": "and created you in pairs (as men and women),"
