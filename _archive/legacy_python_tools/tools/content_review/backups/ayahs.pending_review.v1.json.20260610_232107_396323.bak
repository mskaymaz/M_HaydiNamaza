        {
          "ref": "055/009",
          "surah": 55,
          "ayah": 9,
          "arabic": "وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "055/009",
            "text": "Tartıyı adaletle tutup-doğrultun ve tartıyı noksan tutmayın."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "055/009",
            "text": "Tartmayı doğru yapın, tartıyı eksik tutmayın."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "055/009",
            "text": "And establish weight in justice and do not make deficient the balance."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "055/009",
            "text": "but weigh things equitably and skimp not in the balance."
          }
        }
      ],
