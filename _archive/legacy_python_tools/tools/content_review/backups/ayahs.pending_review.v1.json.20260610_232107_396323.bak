    {
      "ref": "022/078",
      "id": "022/078",
      "surah": 22,
      "ayahStart": 78,
      "ayahEnd": 78,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 804,
        "ref": "022/078",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 411,
        "input_status": "ok",
        "input_source_ref_groups": "022/078"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "022/078"
      ],
      "ayahs": [
        {
          "ref": "022/078",
          "surah": 22,
          "ayah": 78,
          "arabic": "وَجَـٰهِدُوا۟ فِى ٱللَّهِ حَقَّ جِهَادِهِۦ ۚ هُوَ ٱجْتَبَىٰكُمْ وَمَا جَعَلَ عَلَيْكُمْ فِى ٱلدِّينِ مِنْ حَرَجٍ ۚ مِّلَّةَ أَبِيكُمْ إِبْرَٰهِيمَ ۚ هُوَ سَمَّىٰكُمُ ٱلْمُسْلِمِينَ مِن قَبْلُ وَفِى هَـٰذَا لِيَكُونَ ٱلرَّسُولُ شَهِيدًا عَلَيْكُمْ وَتَكُونُوا۟ شُهَدَآءَ عَلَى ٱلنَّاسِ ۚ فَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ وَٱعْتَصِمُوا۟ بِٱللَّهِ هُوَ مَوْلَىٰكُمْ ۖ فَنِعْمَ ٱلْمَوْلَىٰ وَنِعْمَ ٱلنَّصِيرُ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "022/078",
            "text": "Allah adına gerektiği gibi mücadele edin. O, sizleri seçmiş ve din konusunda size bir güçlük yüklememiştir, atanız İbrahim'in dini(nde olduğu gibi). O (Allah) bundan daha önce de, bunda (Kur'an'da) da sizi \"Müslümanlar\" olarak isimlendirdi; elçi sizin üzerinize şahid olsun, siz de insanlar üzerine şahidler olasınız diye. Artık dosdoğru namazı kılın, zekatı verin ve Allah'a sarılın, sizin Mevlanız O'dur. İşte, ne güzel mevla ve ne güzel yardımcı."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "022/078",
            "text": "Allah uğrunda gereği gibi cihat edin. O, sizi seçmiş, babanız İbrahim'in yolu olan dinde sizin için bir zorluk kılmamıştır. Daha önce ve Kuran'da, peygamberin size şahit olması, sizin de insanlara şahit olmanız için size müslüman adını veren O'dur. Artık, namaz kılın, zekat verin, Allah'a sarılın. O sizin sahibinizdir. Ne güzel sahip ve ne güzel yardımcıdır!"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "022/078",
            "text": "And strive for Allah with the striving due to Him. He has chosen you and has not placed upon you in the religion any difficulty. [It is] the religion of your father, Abraham. Allah named you \"Muslims\" before [in former scriptures] and in this [revelation] that the Messenger may be a witness over you and you may be witnesses over the people. So establish prayer and give zakah and hold fast to Allah. He is your protector; and excellent is the protector, and excellent is the helper."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "022/078",
            "text": "Strive in the cause of Allah in a manner worthy of that striving. He has chosen you (for His task), and He has not laid upon you any hardship in religion. Keep to the faith of your father Abraham. Allah named you Muslims earlier and even in this (Book), that the Messenger may be a witness over you, and that you may be witnesses over all mankind. So establish Prayer, and pay Zakah, and hold fast to Allah. He is your Protector. What an excellent Protector; what an excellent Helper!"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Hac",
      "ayah_number": 78,
      "ayah_end_number": 78,
      "text_ar": "وَجَـٰهِدُوا۟ فِى ٱللَّهِ حَقَّ جِهَادِهِۦ ۚ هُوَ ٱجْتَبَىٰكُمْ وَمَا جَعَلَ عَلَيْكُمْ فِى ٱلدِّينِ مِنْ حَرَجٍ ۚ مِّلَّةَ أَبِيكُمْ إِبْرَٰهِيمَ ۚ هُوَ سَمَّىٰكُمُ ٱلْمُسْلِمِينَ مِن قَبْلُ وَفِى هَـٰذَا لِيَكُونَ ٱلرَّسُولُ شَهِيدًا عَلَيْكُمْ وَتَكُونُوا۟ شُهَدَآءَ عَلَى ٱلنَّاسِ ۚ فَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ وَٱعْتَصِمُوا۟ بِٱللَّهِ هُوَ مَوْلَىٰكُمْ ۖ فَنِعْمَ ٱلْمَوْلَىٰ وَنِعْمَ ٱلنَّصِيرُ",
      "text_tr": "Allah adına gerektiği gibi mücadele edin. O, sizleri seçmiş ve din konusunda size bir güçlük yüklememiştir, atanız İbrahim'in dini(nde olduğu gibi). O (Allah) bundan daha önce de, bunda (Kur'an'da) da sizi \"Müslümanlar\" olarak isimlendirdi; elçi sizin üzerinize şahid olsun, siz de insanlar üzerine şahidler olasınız diye. Artık dosdoğru namazı kılın, zekatı verin ve Allah'a sarılın, sizin Mevlanız O'dur. İşte, ne güzel mevla ve ne güzel yardımcı.",
      "text_en": "And strive for Allah with the striving due to Him. He has chosen you and has not placed upon you in the religion any difficulty. [It is] the religion of your father, Abraham. Allah named you \"Muslims\" before [in former scriptures] and in this [revelation] that the Messenger may be a witness over you and you may be witnesses over the people. So establish prayer and give zakah and hold fast to Allah. He is your protector; and excellent is the protector, and excellent is the helper.",
      "priority": 1,
      "notes": "bulk approved from local Tanzil source",
      "createdAt": "2026-06-09T08:52:44+00:00",
      "updatedAt": "2026-06-09T08:52:44+00:00",
      "approvedAt": "2026-06-09T08:52:44+00:00",
