    {
      "ref": "016/106",
      "id": "016/106",
      "surah": 16,
      "ayahStart": 106,
      "ayahEnd": 106,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 686,
        "ref": "016/106",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 180,
        "input_status": "ok",
        "input_source_ref_groups": "016/106"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "016/106"
      ],
      "ayahs": [
        {
          "ref": "016/106",
          "surah": 16,
          "ayah": 106,
          "arabic": "مَن كَفَرَ بِٱللَّهِ مِنۢ بَعْدِ إِيمَـٰنِهِۦٓ إِلَّا مَنْ أُكْرِهَ وَقَلْبُهُۥ مُطْمَئِنٌّۢ بِٱلْإِيمَـٰنِ وَلَـٰكِن مَّن شَرَحَ بِٱلْكُفْرِ صَدْرًا فَعَلَيْهِمْ غَضَبٌ مِّنَ ٱللَّهِ وَلَهُمْ عَذَابٌ عَظِيمٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "016/106",
            "text": "Kim imanından sonra Allah'a (karşı) inkara sapıp da, -kalbi imanla tatmin bulmuş olduğu halde baskı altında zorlanan hariç- inkara göğüs açarsa, işte onların üstünde Allah'tan bir gazab vardır ve büyük azap onlarındır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "016/106",
            "text": "Gönlü imanla dolu olduğu halde, zor altında olan kimse müstesna, inandıktan sonra Allah'ı inkar edip, gönlünü kafirliğe açanlara Allah katından bir gazap vardır; büyük azap da onlar içindir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "016/106",
            "text": "Whoever disbelieves in Allah after his belief... except for one who is forced [to renounce his religion] while his heart is secure in faith. But those who [willingly] open their breasts to disbelief, upon them is wrath from Allah, and for them is a great punishment;"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "016/106",
            "text": "Except for those who were forced to engage in infidelity to Allah after believing the while their hearts remained firmly convinced of their belief, the ones whose hearts willingly embraced disbelief shall incur Allah's wrath and a mighty chastisement lies in store for them."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Nahl",
      "ayah_number": 106,
      "ayah_end_number": 106,
