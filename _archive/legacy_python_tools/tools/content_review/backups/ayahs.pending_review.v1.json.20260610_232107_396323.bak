          "ref": "068/034",
          "surah": 68,
          "ayah": 34,
          "arabic": "إِنَّ لِلْمُتَّقِينَ عِندَ رَبِّهِمْ جَنَّـٰتِ ٱلنَّعِيمِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "068/034",
            "text": "Doğrusu, muttaki olanlar için Rableri Katında nimetlerle donatılmış cennetler vardır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "068/034",
            "text": "Allah'a karşı gelmekten sakınanlara, Rableri katında nimet cennetleri vardır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "068/034",
            "text": "Indeed, for the righteous with their Lord are the Gardens of Pleasure."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "068/034",
            "text": "Surely the God-fearing shall have Gardens of bliss with their Lord."
          }
        }
      ],
