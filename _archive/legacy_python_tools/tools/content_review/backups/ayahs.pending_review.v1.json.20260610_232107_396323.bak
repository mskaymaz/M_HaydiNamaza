      ],
      "ayahs": [
        {
          "ref": "082/006",
          "surah": 82,
          "ayah": 6,
          "arabic": "يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "082/006",
            "text": "Ey insan, 'üstün kerem sahibi' olan Rabbine karşı seni aldatıp-yanıltan nedir?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "082/006",
            "text": "Ey insanoğlu! Seni yaratıp sonra şekil veren, düzenleyen, mütenasip kılan, istediği şekilde seni terkip eden, çok cömert olan Rabbine karşı seni aldatan nedir?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "082/006",
            "text": "O mankind, what has deceived you concerning your Lord, the Generous,"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "082/006",
            "text": "O man! What has deceived you about your generous Lord"
          }
        }
      ],
