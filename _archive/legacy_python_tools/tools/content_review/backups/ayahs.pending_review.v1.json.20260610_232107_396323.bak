      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "049/004"
      ],
      "ayahs": [
        {
          "ref": "049/004",
          "surah": 49,
          "ayah": 4,
          "arabic": "إِنَّ ٱلَّذِينَ يُنَادُونَكَ مِن وَرَآءِ ٱلْحُجُرَٰتِ أَكْثَرُهُمْ لَا يَعْقِلُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "049/004",
            "text": "Şüphesiz, hücrelerin ardından sana seslenenler de, onların çoğu aklını kullanmıyor."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "049/004",
            "text": "Sana odaların ötesinden seslenenlerin çoğu akletmeyen kimselerdir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "049/004",
            "text": "Indeed, those who call you, [O Muhammad], from behind the chambers - most of them do not use reason."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "049/004",
            "text": "Surely most of those who call out to you, (O Prophet), from behind the apartments, are devoid of understanding."
          }
        }
      ],
      "status": "approved",
      "review": {
