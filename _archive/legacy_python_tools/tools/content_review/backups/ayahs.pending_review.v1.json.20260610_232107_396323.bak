    {
      "ref": "004/054",
      "id": "004/054",
      "surah": 4,
      "ayahStart": 54,
      "ayahEnd": 54,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 259,
        "ref": "004/054",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 196,
        "input_status": "ok",
        "input_source_ref_groups": "004/054"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "004/054"
      ],
      "ayahs": [
        {
          "ref": "004/054",
          "surah": 4,
          "ayah": 54,
          "arabic": "أَمْ يَحْسُدُونَ ٱلنَّاسَ عَلَىٰ مَآ ءَاتَىٰهُمُ ٱللَّهُ مِن فَضْلِهِۦ ۖ فَقَدْ ءَاتَيْنَآ ءَالَ إِبْرَٰهِيمَ ٱلْكِتَـٰبَ وَٱلْحِكْمَةَ وَءَاتَيْنَـٰهُم مُّلْكًا عَظِيمًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/054",
            "text": "Yoksa onlar, Allah'ın Kendi fazlından insanlara verdiklerini mi kıskanıyorlar? Doğrusu Biz, İbrahim ailesine kitabı ve hikmeti verdik; onlara büyük bir mülk de verdik."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/054",
            "text": "Yoksa Allah'ın bol nimetinden verdiği kimseleri mi çekemiyorlar? Oysa İbrahim ailesine kitap ve hikmet verdik, onlara büyük hükümranlık bahşettik."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/054",
            "text": "Or do they envy people for what Allah has given them of His bounty? But we had already given the family of Abraham the Scripture and wisdom and conferred upon them a great kingdom."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/054",
            "text": "Do they envy others for the bounty that Allah has bestowed upon them? (Let them bear in mind that) We bestowed upon the house of Abraham the Book and Wis-dom, and We bestowed upon them a mighty dominion,"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Nisa",
      "ayah_number": 54,
      "ayah_end_number": 54,
