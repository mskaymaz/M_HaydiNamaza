      "ayahs": [
        {
          "ref": "002/011",
          "surah": 2,
          "ayah": 11,
          "arabic": "وَإِذَا قِيلَ لَهُمْ لَا تُفْسِدُوا۟ فِى ٱلْأَرْضِ قَالُوٓا۟ إِنَّمَا نَحْنُ مُصْلِحُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "002/011",
            "text": "Kendilerine: \"Yeryüzünde fesat çıkarmayın\" denildiğinde: \"Biz sadece ıslah edicileriz\" derler."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "002/011",
            "text": "Kendilerine: \"Yeryüzünde bozgunculuk yapmayın\" dendiği zaman, \"Bizler sadece ıslah edicileriz\" derler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "002/011",
            "text": "And when it is said to them, \"Do not cause corruption on the earth,\" they say, \"We are but reformers.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "002/011",
            "text": "Whenever it is said to them, \"Spread not disorder on the earth\", their reply is, \"We only seek to put things aright\"."
          }
        }
      ],
