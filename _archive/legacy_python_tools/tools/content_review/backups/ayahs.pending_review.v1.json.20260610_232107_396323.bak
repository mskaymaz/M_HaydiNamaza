    {
      "ref": "002/006",
      "id": "002/006",
      "surah": 2,
      "ayahStart": 6,
      "ayahEnd": 6,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 6,
        "ref": "002/006",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 91,
        "input_status": "ok",
        "input_source_ref_groups": "002/006"
      },
      "source": {
        "arabic": "Existing clean UTF-8 Uthmani Arabic text from prior working dataset; Tanzil Uthmani Arabic verification/fetch script available",
        "tr": "Tanzil tr.bulac - Ali Bulaç",
        "en": "Tanzil en.sahih - Saheeh International",
        "tr_alternative": "Tanzil tr.diyanet - Diyanet İşleri",
        "en_alternative": "Tanzil en.maududi - Abul A’la Maududi"
      },
      "sourceRefGroups": [
        "002/006"
      ],
      "ayahs": [
        {
          "ref": "002/006",
          "surah": 2,
          "ayah": 6,
          "arabic": "إِنَّ ٱلَّذِينَ كَفَرُوا۟ سَوَآءٌ عَلَيْهِمْ ءَأَنذَرْتَهُمْ أَمْ لَمْ تُنذِرْهُمْ لَا يُؤْمِنُونَ",
          "tr": {
            "source": "Tanzil tr.bulac - Ali Bulaç",
            "text": "Şüphesiz, inkar edenleri uyarsan da, uyarmasan da, onlar için fark etmez; inanmazlar."
          },
          "en": {
            "source": "Tanzil en.sahih - Saheeh International",
            "text": "Indeed, those who disbelieve - it is all the same for them whether you warn them or do not warn them - they will not believe."
          },
          "alternatives": {
            "tr_diyanet_tanzil": {
              "source": "Tanzil tr.diyanet - Diyanet İşleri",
              "text": "Şüphe yok ki, inkar edenleri, başlarına gelecekle uyarsan da uyarmasan da birdir, inanmazlar."
            },
            "en_maududi": {
              "source": "Tanzil en.maududi - Abul A’la Maududi",
              "text": "As for those who have rejected (these things), it is all the same to them whether you warn them or do not warn them: they are not going to believe."
            }
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "pending_review",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "",
        "updated_at": null
      },
      "text_tr": "Şüphesiz, inkar edenleri uyarsan da, uyarmasan da, onlar için fark etmez; inanmazlar.",
      "text_ar": "إِنَّ ٱلَّذِينَ كَفَرُوا۟ سَوَآءٌ عَلَيْهِمْ ءَأَنذَرْتَهُمْ أَمْ لَمْ تُنذِرْهُمْ لَا يُؤْمِنُونَ",
      "text_en": "Indeed, those who disbelieve - it is all the same for them whether you warn them or do not warn them - they will not believe."
    },
