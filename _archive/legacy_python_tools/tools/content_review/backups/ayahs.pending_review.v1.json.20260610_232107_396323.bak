    {
      "ref": "040/012",
      "id": "040/012",
      "surah": 40,
      "ayahStart": 12,
      "ayahEnd": 12,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 1070,
        "ref": "040/012",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 162,
        "input_status": "ok",
        "input_source_ref_groups": "040/012"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "040/012"
      ],
      "ayahs": [
        {
          "ref": "040/012",
          "surah": 40,
          "ayah": 12,
          "arabic": "ذَٰلِكُم بِأَنَّهُۥٓ إِذَا دُعِىَ ٱللَّهُ وَحْدَهُۥ كَفَرْتُمْ ۖ وَإِن يُشْرَكْ بِهِۦ تُؤْمِنُوا۟ ۚ فَٱلْحُكْمُ لِلَّهِ ٱلْعَلِىِّ ٱلْكَبِيرِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "040/012",
            "text": "\"Sizin (durumunuz) böyledir. Çünkü bir olan Allah'a çağırıldığınız zaman inkar ettiniz. O'na ortak koşulduğunda inanıp-onayladınız. Artık hüküm, Yüce, büyük olan Allah'ındır.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "040/012",
            "text": "Onlara: \"Yalnız Allah çağrıldığı zaman inkar ederdiniz de, O'na eş koşulunca inanırdınız. Bugün hüküm, yüce Allah'ındır\" denir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "040/012",
            "text": "[They will be told], \"That is because, when Allah was called upon alone, you disbelieved; but if others were associated with Him, you believed. So the judgement is with Allah, the Most High, the Grand.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "040/012",
            "text": "(They will be told): “(The cause of your present state is that) when Allah alone was invoked, you disbelieved; and when others instead of Him were invoked, you believed. Today all judgement lies with Allah, the Most High, the All-Great.”"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
