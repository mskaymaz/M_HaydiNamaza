        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 162,
        "input_status": "ok",
        "input_source_ref_groups": "017/004"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
