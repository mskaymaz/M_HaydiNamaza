          "ref": "075/018",
          "surah": 75,
          "ayah": 18,
          "arabic": "فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "075/018",
            "text": "Şu halde, Biz onu okuduğumuz zaman, sen de onun okunuşunu izle."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "075/018",
            "text": "Biz onu Cebrail'e okuttuğumuz zaman, onun okumasını dinle."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "075/018",
            "text": "So when We have recited it [through Gabriel], then follow its recitation."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "075/018",
            "text": "And so when We recite it, follow its recitation attentively;"
          }
        }
      ],
      "status": "approved",
