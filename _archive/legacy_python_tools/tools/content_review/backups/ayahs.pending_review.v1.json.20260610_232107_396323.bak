    {
      "ref": "004/131",
      "id": "004/131",
      "surah": 4,
      "ayahStart": 131,
      "ayahEnd": 131,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 292,
        "ref": "004/131",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 275,
        "input_status": "ok",
        "input_source_ref_groups": "004/131"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "004/131"
      ],
      "ayahs": [
        {
          "ref": "004/131",
          "surah": 4,
          "ayah": 131,
          "arabic": "وَلِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ ۗ وَلَقَدْ وَصَّيْنَا ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ مِن قَبْلِكُمْ وَإِيَّاكُمْ أَنِ ٱتَّقُوا۟ ٱللَّهَ ۚ وَإِن تَكْفُرُوا۟ فَإِنَّ لِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ ۚ وَكَانَ ٱللَّهُ غَنِيًّا حَمِيدًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/131",
            "text": "Göklerde ve yerde ne varsa Allah'ındır. Andolsun, Biz sizden önce kitap verilenlere ve sizlere: \"Allah'tan korkup-sakının\" diye tavsiye ettik. Eğer inkara saparsanız, şüphesiz, göklerde ve yerde ne varsa Allah'ındır. Allah, hiçbir şeye ihtiyacı olmayan, hamde layık olandır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/131",
            "text": "Göklerde olanlar da, yerde olanlar da Allah'ındır. And olsun ki, sizden önce Kitap verilenlere ve size, Allah'tan sakınmanızı tavsiye ettik. İnkar ederseniz bilin ki, göklerde olanlar da yerde olanlar da Allah'ındır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/131",
            "text": "And to Allah belongs whatever is in the heavens and whatever is on the earth. And We have instructed those who were given the Scripture before you and yourselves to fear Allah. But if you disbelieve - then to Allah belongs whatever is in the heavens and whatever is on the earth. And ever is Allah Free of need and Praiseworthy."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/131",
            "text": "All that is in the heavens and all that is in the earth belongs to Allah. We enjoined upon those who were given the Book before you, and also yourselves, to have fear of Allah. But if you disbelieve, then bear in mind that all that is in the heavens and all that is in the earth belongs to Allah. Allah is Self-Sufficient, Most Praiseworthy."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
