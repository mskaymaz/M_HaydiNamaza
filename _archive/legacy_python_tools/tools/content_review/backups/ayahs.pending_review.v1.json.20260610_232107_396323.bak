        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 105,
        "input_status": "ok",
        "input_source_ref_groups": "003/051"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "003/051"
      ],
      "ayahs": [
        {
          "ref": "003/051",
          "surah": 3,
          "ayah": 51,
          "arabic": "إِنَّ ٱللَّهَ رَبِّى وَرَبُّكُمْ فَٱعْبُدُوهُ ۗ هَـٰذَا صِرَٰطٌ مُّسْتَقِيمٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "003/051",
            "text": "\"Gerçekten Allah, benim de Rabbim, sizin de Rabbinizdir. Öyleyse O'na ibadet edin. Dosdoğru olan yol işte budur.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "003/051",
            "text": "\"Benden önce gelen Tevrat'ı tasdik etmekle beraber size yasak edilenlerin bir kısmını helal kılmak üzere, Rabbinizden size bir ayet getirdim. Allah'tan sakının ve bana itaat edin; çünkü Allah benim de Rabbim, sizin de Rabbinizdir. O'na kulluk edin, bu doğru yoldur\"."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "003/051",
            "text": "Indeed, Allah is my Lord and your Lord, so worship Him. That is the straight path.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "003/051",
            "text": "Surely, Allah is my Lord and your Lord; so serve Him alone. This is the straight way.'"
          }
        }
      ],
      "status": "approved",
