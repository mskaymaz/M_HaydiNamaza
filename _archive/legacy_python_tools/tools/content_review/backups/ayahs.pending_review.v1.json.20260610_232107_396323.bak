    {
      "ref": "023/117",
      "id": "023/117",
      "surah": 23,
      "ayahStart": 117,
      "ayahEnd": 117,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 817,
        "ref": "023/117",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 166,
        "input_status": "ok",
        "input_source_ref_groups": "023/117"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "023/117"
      ],
      "ayahs": [
        {
          "ref": "023/117",
          "surah": 23,
          "ayah": 117,
          "arabic": "وَمَن يَدْعُ مَعَ ٱللَّهِ إِلَـٰهًا ءَاخَرَ لَا بُرْهَـٰنَ لَهُۥ بِهِۦ فَإِنَّمَا حِسَابُهُۥ عِندَ رَبِّهِۦٓ ۚ إِنَّهُۥ لَا يُفْلِحُ ٱلْكَـٰفِرُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "023/117",
            "text": "Kim Allah ile beraber ona ilişkin geçerli kesin bir kanıt (burhan)ı olmaksızın başka bir İlah'a taparsa, artık onun hesabı Rabbinin Katındadır. Şüphesiz inkar edenler kurtuluşa eremezler."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "023/117",
            "text": "Allah'la beraber, varlığına hiçbir delili olmadığı halde başka tanrıya tapanın hesabını Rabbi görecektir. İnkarcılar elbette kurtulamazlar."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "023/117",
            "text": "And whoever invokes besides Allah another deity for which he has no proof - then his account is only with his Lord. Indeed, the disbelievers will not succeed."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "023/117",
            "text": "He who invokes any other god along with Allah \" one for whom he has no evidence\" his reckoning is with his Lord alone. Indeed, these unbelievers shall not prosper."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
