          "surah": 99,
          "ayah": 8,
          "arabic": "وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُۥ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "099/008",
            "text": "Artık kim zerre ağırlığınca bir şer (kötülük) işlerse, onu görür."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "099/008",
            "text": "Kim de zerre kadar kötülük yapmışsa onu görür."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "099/008",
            "text": "And whoever does an atom's weight of evil will see it."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "099/008",
            "text": "and whoever does an atom's weight of evil shall see it."
          }
        }
