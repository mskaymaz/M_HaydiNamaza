    {
      "ref": "033/033",
      "id": "033/033",
      "surah": 33,
      "ayahStart": 33,
      "ayahEnd": 33,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 984,
        "ref": "033/033",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 263,
        "input_status": "ok",
        "input_source_ref_groups": "033/033"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "033/033"
      ],
      "ayahs": [
        {
          "ref": "033/033",
          "surah": 33,
          "ayah": 33,
          "arabic": "وَقَرْنَ فِى بُيُوتِكُنَّ وَلَا تَبَرَّجْنَ تَبَرُّجَ ٱلْجَـٰهِلِيَّةِ ٱلْأُولَىٰ ۖ وَأَقِمْنَ ٱلصَّلَوٰةَ وَءَاتِينَ ٱلزَّكَوٰةَ وَأَطِعْنَ ٱللَّهَ وَرَسُولَهُۥٓ ۚ إِنَّمَا يُرِيدُ ٱللَّهُ لِيُذْهِبَ عَنكُمُ ٱلرِّجْسَ أَهْلَ ٱلْبَيْتِ وَيُطَهِّرَكُمْ تَطْهِيرًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "033/033",
            "text": "Evlerinizde vakarla-oturun (evlerinizi karargah edinin), ilk cahiliye (kadınları)nın süslerini açığa vurması gibi, siz de süslerinizi açığa vurmayın; namazı dosdoğru kılın, zekatı verin, Allah'a ve elçisine itaat edin. Ey Ehl-i Beyt, gerçekten Allah, sizden kiri (günah ve çirkinliği) gidermek ve sizi tertemiz kılmak ister."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "033/033",
            "text": "Evlerinizde oturun; eski Cahiliyye'de olduğu gibi açılıp saçılmayın; namazı kılın; zekatı verin; Allah'a ve Peygamberine itaat edin. Ey Peygamberin ev halkı! (ehl-i beyt) Şüphesiz Allah sizden kusuru giderip sizi tertemiz yapmak ister."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "033/033",
            "text": "And abide in your houses and do not display yourselves as [was] the display of the former times of ignorance. And establish prayer and give zakah and obey Allah and His Messenger. Allah intends only to remove from you the impurity [of sin], O people of the [Prophet's] household, and to purify you with [extensive] purification."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "033/033",
            "text": "And stay in your homes and do not go about displaying your allurements as in the former Time of Ignorance. Establish Prayer, give Zakah, and obey Allah and His Messenger. Allah only wishes to remove uncleanness from you, O members of the (Prophet's) household, and to purify you completely."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
