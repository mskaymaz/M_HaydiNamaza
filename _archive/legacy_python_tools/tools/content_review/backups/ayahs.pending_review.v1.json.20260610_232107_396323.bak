      "input": {
        "sira": 558,
        "ref": "009/096",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 138,
        "input_status": "ok",
        "input_source_ref_groups": "009/096"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "009/096"
      ],
      "ayahs": [
        {
          "ref": "009/096",
          "surah": 9,
          "ayah": 96,
          "arabic": "يَحْلِفُونَ لَكُمْ لِتَرْضَوْا۟ عَنْهُمْ ۖ فَإِن تَرْضَوْا۟ عَنْهُمْ فَإِنَّ ٱللَّهَ لَا يَرْضَىٰ عَنِ ٱلْقَوْمِ ٱلْفَـٰسِقِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "009/096",
            "text": "Kendilerinden hoşnut olmanız için size yemin ederler. Siz onlardan hoşnut olsanız bile şüphesiz Allah, fasıklar topluluğundan hoşnut olmaz."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "009/096",
            "text": "Kendilerinden hoşnut olasınız diye, size and verirler. Siz onlardan hoşnut olsanız bile, Allah, yoldan çıkmış kimselerden razı olmaz."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "009/096",
            "text": "They swear to you so that you might be satisfied with them. But if you should be satisfied with them - indeed, Allah is not satisfied with a defiantly disobedient people."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "009/096",
            "text": "They will swear to you in order to please you. But even if you become pleased with them, Allah will not be pleased with such an evil-doing folk."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
