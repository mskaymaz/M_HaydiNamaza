      ],
      "ayahs": [
        {
          "ref": "102/001",
          "surah": 102,
          "ayah": 1,
          "arabic": "\\basmalah أَلْهَىٰكُمُ ٱلتَّكَاثُرُ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "102/001",
            "text": "(Mal, mülk ve servette) Çoklukla övünmek, sizi 'tutkuyla oyalayıp, kendinizden geçirdi.'"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "102/001",
            "text": "Çoğunluk olmak iddianız sizi o kadar meşgul etti ki, mezarları ziyaretle oradakileri de sayacak kadar oldunuz."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "102/001",
            "text": "Competition in [worldly] increase diverts you"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "102/001",
            "text": "The craving for ever-greater worldly gains and to excel others in that regard keeps you occupied"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
