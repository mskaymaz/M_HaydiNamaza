      "ayahs": [
        {
          "ref": "050/024",
          "surah": 50,
          "ayah": 24,
          "arabic": "أَلْقِيَا فِى جَهَنَّمَ كُلَّ كَفَّارٍ عَنِيدٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "050/024",
            "text": "Siz ikiniz (ey melekler), her inatçı nankörü atın cehennemin içine,"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "050/024",
            "text": "Allah: \"Ey sürücü ve şahit! Her inatçı inkarcıyı, iyiliklere boyuna engel olan, mütecaviz, şüpheye düşüren, Allah'ın yanında başka tanrı benimseyen kişiyi cehenneme atın, onu çetin bir azaba sokun\" buyurur."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "050/024",
            "text": "[Allah will say], \"Throw into Hell every obstinate disbeliever,"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "050/024",
            "text": "The command was given: “Cast into Hell every hardened, stubborn unbeliever,"
          }
        }
      ],
