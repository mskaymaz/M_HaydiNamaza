    {
      "ref": "012/056",
      "id": "012/056",
      "surah": 12,
      "ayahStart": 56,
      "ayahEnd": 56,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 626,
        "ref": "012/056",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 192,
        "input_status": "ok",
        "input_source_ref_groups": "012/056"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "012/056"
      ],
      "ayahs": [
        {
          "ref": "012/056",
          "surah": 12,
          "ayah": 56,
          "arabic": "وَكَذَٰلِكَ مَكَّنَّا لِيُوسُفَ فِى ٱلْأَرْضِ يَتَبَوَّأُ مِنْهَا حَيْثُ يَشَآءُ ۚ نُصِيبُ بِرَحْمَتِنَا مَن نَّشَآءُ ۖ وَلَا نُضِيعُ أَجْرَ ٱلْمُحْسِنِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "012/056",
            "text": "İşte böylece Biz yeryüzünde Yusuf'a güç ve imkan (iktidar) verdik. Öyle ki, orada (Mısır'da) dilediği yerde konakladı. Biz kime dilersek rahmetimizi nasib ederiz ve iyilik yapanların ecrini kayba uğratmayız."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "012/056",
            "text": "Yusuf'u böylece o memlekete yerleştirdik; istediği yerlerde oturabilirdi. Rahmetimizi tıpkı bu misalde olduğu gibi istediğimize veririz; iyi davrananların ecrini zayi etmeyiz."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "012/056",
            "text": "And thus We established Joseph in the land to settle therein wherever he willed. We touch with Our mercy whom We will, and We do not allow to be lost the reward of those who do good."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "012/056",
            "text": "Thus did We establish Joseph in the land so that he could settle wherever he pleased. We bestow favour, out of Our Mercy, on whomsoever We please, and We do not cause the reward of those who do good to go to waste."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Yusuf",
      "ayah_number": 56,
      "ayah_end_number": 56,
      "text_ar": "وَكَذَٰلِكَ مَكَّنَّا لِيُوسُفَ فِى ٱلْأَرْضِ يَتَبَوَّأُ مِنْهَا حَيْثُ يَشَآءُ ۚ نُصِيبُ بِرَحْمَتِنَا مَن نَّشَآءُ ۖ وَلَا نُضِيعُ أَجْرَ ٱلْمُحْسِنِينَ",
      "text_tr": "İşte böylece Biz yeryüzünde Yusuf'a güç ve imkan (iktidar) verdik. Öyle ki, orada (Mısır'da) dilediği yerde konakladı. Biz kime dilersek rahmetimizi nasib ederiz ve iyilik yapanların ecrini kayba uğratmayız.",
      "text_en": "And thus We established Joseph in the land to settle therein wherever he willed. We touch with Our mercy whom We will, and We do not allow to be lost the reward of those who do good.",
      "priority": 1,
      "notes": "bulk approved from local Tanzil source",
      "createdAt": "2026-06-09T08:52:44+00:00",
      "updatedAt": "2026-06-09T08:52:44+00:00",
      "approvedAt": "2026-06-09T08:52:44+00:00",
