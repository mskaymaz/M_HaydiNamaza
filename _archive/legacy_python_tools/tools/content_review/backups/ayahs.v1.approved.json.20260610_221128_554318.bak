      "surah_number": 26,
      "surah_name": "Suara",
      "ayah_number": 125,
      "ayah_end_number": 125,
      "status": "pending_review"
    },
    {
      "id": "026/130",
      "kind": "ayah",
      "ref": "026/130",
      "ar": "وَإِذَا بَطَشْتُم بَطَشْتُمْ جَبَّارِينَ",
      "tr": "\"Tutup yakaladığınız zaman da zorbalar gibi mi yakalıyorsunuz?\"",
      "en": "And when you strike, you strike as tyrants.",
      "priority": 1,
      "surah_number": 26,
      "surah_name": "Suara",
      "ayah_number": 130,
      "ayah_end_number": 130,
      "status": "pending_review"
    },
    {
      "id": "026/137",
      "kind": "ayah",
      "ref": "026/137",
      "ar": "إِنْ هَـٰذَآ إِلَّا خُلُقُ ٱلْأَوَّلِينَ",
      "tr": "\"Bu, geçmiştekilerin 'geleneksel tutumundan başkası değildir.\"",
      "en": "This is not but the custom of the former peoples,",
      "priority": 1,
      "surah_number": 26,
      "surah_name": "Suara",
      "ayah_number": 137,
      "ayah_end_number": 137,
      "status": "pending_review"
    },
