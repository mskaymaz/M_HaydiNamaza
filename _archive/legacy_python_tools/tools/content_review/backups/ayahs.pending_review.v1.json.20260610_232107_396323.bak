        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 164,
        "input_status": "ok",
        "input_source_ref_groups": "024/016"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "024/016"
      ],
      "ayahs": [
        {
          "ref": "024/016",
          "surah": 24,
          "ayah": 16,
          "arabic": "وَلَوْلَآ إِذْ سَمِعْتُمُوهُ قُلْتُم مَّا يَكُونُ لَنَآ أَن نَّتَكَلَّمَ بِهَـٰذَا سُبْحَـٰنَكَ هَـٰذَا بُهْتَـٰنٌ عَظِيمٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "024/016",
            "text": "Onu işittiğiniz zaman: \"Bu konuda söz söylemek bize yakışmaz. (Allah'ım) Sen Yücesin; bu, büyük bir iftiradır\" demeniz gerekmez miydi?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "024/016",
            "text": "O'nu işittiğinizde: \"Bu konuda konuşmamız yakışık almaz; haşa, bu büyük bir iftiradır\" demeniz gerekmez miydi?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "024/016",
            "text": "And why, when you heard it, did you not say, \"It is not for us to speak of this. Exalted are You, [O Allah]; this is a great slander\"?"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "024/016",
            "text": "Why did you not, as soon as you heard of it, say, \"It is not proper for us to utter such a thing? Glory be to Allah! This is a great slander.\""
          }
        }
      ],
      "status": "approved",
