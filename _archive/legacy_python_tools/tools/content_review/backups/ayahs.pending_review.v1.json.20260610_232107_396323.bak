    {
      "ref": "041/033-035",
      "id": "041/033-035",
      "surah": 41,
      "ayahStart": 33,
      "ayahEnd": 35,
      "type": "range",
      "ayahCount": 3,
      "input": {
        "sira": 1095,
        "ref": "041/033-035",
        "input_type": "aralik",
        "input_ayah_count": 3,
        "input_char_count": 384,
        "input_status": "ok",
        "input_source_ref_groups": "041/033, 041/034, 041/035"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "041/033",
        "041/034",
        "041/035"
      ],
      "ayahs": [
        {
          "ref": "041/033",
          "surah": 41,
          "ayah": 33,
          "arabic": "وَمَنْ أَحْسَنُ قَوْلًا مِّمَّن دَعَآ إِلَى ٱللَّهِ وَعَمِلَ صَـٰلِحًا وَقَالَ إِنَّنِى مِنَ ٱلْمُسْلِمِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "041/033",
            "text": "Allah'a çağıran, salih amelde bulunan ve: \"Gerçekten ben Müslümanlardanım\" diyenden daha güzel sözlü kimdir?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "041/033",
            "text": "\"Doğrusu ben, kendini Allah'a verenlerdenim\" diyen, yararlı iş işleyen ve Allah'a çağıran kimseden daha güzel sözlü kim vardır?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "041/033",
            "text": "And who is better in speech than one who invites to Allah and does righteousness and says, \"Indeed, I am of the Muslims.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "041/033",
            "text": "And who is fairer in speech than he who calls to Allah and acts righteously and says: “I am a Muslim”?"
          }
        },
        {
          "ref": "041/034",
          "surah": 41,
          "ayah": 34,
          "arabic": "وَلَا تَسْتَوِى ٱلْحَسَنَةُ وَلَا ٱلسَّيِّئَةُ ۚ ٱدْفَعْ بِٱلَّتِى هِىَ أَحْسَنُ فَإِذَا ٱلَّذِى بَيْنَكَ وَبَيْنَهُۥ عَدَٰوَةٌ كَأَنَّهُۥ وَلِىٌّ حَمِيمٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "041/034",
            "text": "İyilikle kötülük eşit olmaz. Sen, en güzel olan bir tarzda (kötülüğü) uzaklaştır; o zaman, (görürsün ki) seninle onun arasında düşmanlık bulunan kimse, sanki sıcak bir dost(un) oluvermiştir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "041/034",
            "text": "İyilik ve fenalık bir değildir. Ey inanan kişi: Sen, fenalığı en güzel şekilde sav; o zaman, seninle arasında düşmanlık bulunan kişinin yakın bir dost gibi olduğunu görürsün."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "041/034",
            "text": "And not equal are the good deed and the bad. Repel [evil] by that [deed] which is better; and thereupon the one whom between you and him is enmity [will become] as though he was a devoted friend."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "041/034",
            "text": "(O Prophet), good and evil are not equal. Repel (evil) with that which is good, and you will see that he, between whom and you there was enmity, shall become as if he were a bosom friend (of yours)."
          }
        },
        {
          "ref": "041/035",
          "surah": 41,
          "ayah": 35,
          "arabic": "وَمَا يُلَقَّىٰهَآ إِلَّا ٱلَّذِينَ صَبَرُوا۟ وَمَا يُلَقَّىٰهَآ إِلَّا ذُو حَظٍّ عَظِيمٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "041/035",
            "text": "Buna da, sabredenlerden başkası kavuşturulamaz. Ve buna, büyük bir pay sahibi olanlardan başkası da kavuşturulamaz."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "041/035",
            "text": "Bu, ancak sabredenlere vergidir; bu ancak o büyük hazzı tadanlara vergidir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "041/035",
            "text": "But none is granted it except those who are patient, and none is granted it except one having a great portion [of good]."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "041/035",
            "text": "But none attains to this except those who are steadfast; none attains to this except those endowed with mighty good fortune."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
