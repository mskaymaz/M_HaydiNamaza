      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "003/115"
      ],
      "ayahs": [
        {
          "ref": "003/115",
          "surah": 3,
          "ayah": 115,
          "arabic": "وَمَا يَفْعَلُوا۟ مِنْ خَيْرٍ فَلَن يُكْفَرُوهُ ۗ وَٱللَّهُ عَلِيمٌۢ بِٱلْمُتَّقِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "003/115",
            "text": "Onlar hayırdan her ne yaparlarsa, elbette ondan yoksun bırakılmazlar. Allah, muttakileri bilendir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "003/115",
            "text": "Ne iyilik yaparlarsa, karşılığını bulacaklardır. Allah sakınanları bilir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "003/115",
            "text": "And whatever good they do - never will it be removed from them. And Allah is Knowing of the righteous."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "003/115",
            "text": "Whatever good they do shall not go unappreciated, and Allah fully knows those who are pious."
          }
        }
      ],
