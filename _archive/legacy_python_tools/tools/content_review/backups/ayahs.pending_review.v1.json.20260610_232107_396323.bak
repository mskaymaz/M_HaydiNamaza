    {
      "ref": "017/064",
      "id": "017/064",
      "surah": 17,
      "ayahStart": 64,
      "ayahEnd": 64,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 717,
        "ref": "017/064",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 234,
        "input_status": "ok",
        "input_source_ref_groups": "017/064"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "017/064"
      ],
      "ayahs": [
        {
          "ref": "017/064",
          "surah": 17,
          "ayah": 64,
          "arabic": "وَٱسْتَفْزِزْ مَنِ ٱسْتَطَعْتَ مِنْهُم بِصَوْتِكَ وَأَجْلِبْ عَلَيْهِم بِخَيْلِكَ وَرَجِلِكَ وَشَارِكْهُمْ فِى ٱلْأَمْوَٰلِ وَٱلْأَوْلَـٰدِ وَعِدْهُمْ ۚ وَمَا يَعِدُهُمُ ٱلشَّيْطَـٰنُ إِلَّا غُرُورًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "017/064",
            "text": "\"Onlardan güç yetirdiklerini sesinle sarsıntıya uğrat, atlıların ve yayalarınla onların üstüne yaygarayı kopar, mallarda ve çocuklarda onlara ortak ol ve onlara çeşitli vaadlerde bulun.\" Şeytan, onlara aldatmadan başka bir şey vadetmez."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "017/064",
            "text": "\"Sesinle, gücünün yettiğini yerinden oynat, onlara karşı yaya ve atlılarınla haykırarak yürü, mallarına ve çocuklarına ortak ol, onlara vaadlerde bulun ama şeytan sadece onları aldatmak için vaadeder."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "017/064",
            "text": "And incite [to senselessness] whoever you can among them with your voice and assault them with your horses and foot soldiers and become a partner in their wealth and their children and promise them.\" But Satan does not promise them except delusion."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "017/064",
            "text": "Tempt with your call all whom you wish. Muster against them all your forces - your cavalry and your foot soldiers; share with them riches and offspring, and seduce them with rosy promises - and Satan's promise is nothing but a deception -"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Isra",
      "ayah_number": 64,
      "ayah_end_number": 64,
      "text_ar": "وَٱسْتَفْزِزْ مَنِ ٱسْتَطَعْتَ مِنْهُم بِصَوْتِكَ وَأَجْلِبْ عَلَيْهِم بِخَيْلِكَ وَرَجِلِكَ وَشَارِكْهُمْ فِى ٱلْأَمْوَٰلِ وَٱلْأَوْلَـٰدِ وَعِدْهُمْ ۚ وَمَا يَعِدُهُمُ ٱلشَّيْطَـٰنُ إِلَّا غُرُورًا",
      "text_tr": "\"Onlardan güç yetirdiklerini sesinle sarsıntıya uğrat, atlıların ve yayalarınla onların üstüne yaygarayı kopar, mallarda ve çocuklarda onlara ortak ol ve onlara çeşitli vaadlerde bulun.\" Şeytan, onlara aldatmadan başka bir şey vadetmez.",
      "text_en": "And incite [to senselessness] whoever you can among them with your voice and assault them with your horses and foot soldiers and become a partner in their wealth and their children and promise them.\" But Satan does not promise them except delusion.",
      "priority": 1,
