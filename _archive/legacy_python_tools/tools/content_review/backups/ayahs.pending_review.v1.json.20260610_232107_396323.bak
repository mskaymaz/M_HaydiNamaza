      "ayahs": [
        {
          "ref": "037/045",
          "surah": 37,
          "ayah": 45,
          "arabic": "يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍۭ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "037/045",
            "text": "Kaynaktan (doldurulmuş) kadehlerle çevrelerinde dolaşılır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "037/045",
            "text": "Baş ağrısı vermeyen, sarhoş etmeyen, içenlere zevk bahşeden bembeyaz bir kaynaktan doldurulmuş kadehler sunulur."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "037/045",
            "text": "There will be circulated among them a cup [of wine] from a flowing spring,"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "037/045",
            "text": "a cup filled with wine from its springs, will be passed around to them;"
          }
        },
        {
          "ref": "037/046",
          "surah": 37,
          "ayah": 46,
          "arabic": "بَيْضَآءَ لَذَّةٍ لِّلشَّـٰرِبِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "037/046",
            "text": "Bembeyaz; içenlere lezzet (veren bir içki)."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "037/046",
            "text": "Baş ağrısı vermeyen, sarhoş etmeyen, içenlere zevk bahşeden bembeyaz bir kaynaktan doldurulmuş kadehler sunulur."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "037/046",
            "text": "White and delicious to the drinkers;"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "037/046",
            "text": "white, sparkling (wine), a delight to the drinkers."
          }
        }
      ],
