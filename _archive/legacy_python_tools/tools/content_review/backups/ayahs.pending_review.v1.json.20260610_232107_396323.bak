    {
      "ref": "003/152",
      "id": "003/152",
      "surah": 3,
      "ayahStart": 152,
      "ayahEnd": 152,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 209,
        "ref": "003/152",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 465,
        "input_status": "ok",
        "input_source_ref_groups": "003/152"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "003/152"
      ],
      "ayahs": [
        {
          "ref": "003/152",
          "surah": 3,
          "ayah": 152,
          "arabic": "وَلَقَدْ صَدَقَكُمُ ٱللَّهُ وَعْدَهُۥٓ إِذْ تَحُسُّونَهُم بِإِذْنِهِۦ ۖ حَتَّىٰٓ إِذَا فَشِلْتُمْ وَتَنَـٰزَعْتُمْ فِى ٱلْأَمْرِ وَعَصَيْتُم مِّنۢ بَعْدِ مَآ أَرَىٰكُم مَّا تُحِبُّونَ ۚ مِنكُم مَّن يُرِيدُ ٱلدُّنْيَا وَمِنكُم مَّن يُرِيدُ ٱلْءَاخِرَةَ ۚ ثُمَّ صَرَفَكُمْ عَنْهُمْ لِيَبْتَلِيَكُمْ ۖ وَلَقَدْ عَفَا عَنكُمْ ۗ وَٱللَّهُ ذُو فَضْلٍ عَلَى ٱلْمُؤْمِنِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "003/152",
            "text": "Andolsun, Allah size verdiği sözünde sadık kaldı; siz O'nun izniyle onları kırıp-geçiriyordunuz. Öyle ki sevdiğiniz (zafer)i size gösterdikten sonra, siz yılgınlık gösterdiniz, isyan ettiniz ve emir hakkında çekiştiniz. Sizden kiminiz dünyayı, kiminiz ahireti istiyordu. Sonra (Allah) denemek için sizi ondan çevirdi. Ama (yine de) sizi bağışladı. Allah mü'minlere karşı fazl (ve ihsan) sahibi olandır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "003/152",
            "text": "And olsun ki, Allah, size verdiği sözde durdu. Onun izniyle kafirleri kırıp biçiyordunuz, ama Allah size arzuladığınız zaferi gösterdikten sonra gevşeyip bu hususta çekiştiniz ve isyan ettiniz; sizden kimi dünyayı, kimi ahireti istiyordu; derken denemek için Allah sizi geri çevirip bozguna uğrattı. And olsun ki O, sizi bağışladı. Allah'ın inananlara nimeti boldur."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "003/152",
            "text": "And Allah had certainly fulfilled His promise to you when you were killing the enemy by His permission until [the time] when you lost courage and fell to disputing about the order [given by the Prophet] and disobeyed after He had shown you that which you love. Among you are some who desire this world, and among you are some who desire the Hereafter. Then he turned you back from them [defeated] that He might test you. And He has already forgiven you, and Allah is the possessor of bounty for the believers."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "003/152",
            "text": "Allah surely fulfilled His promise (of succour) when you were slaying them by His leave until the moment when you flagged and quarrelled among yourselves about the matter, and acted against the order of (the Prophet). Soon He showed you what you had intensely desired - for some among you sought this world and some of you sought the Next. Thereupon, in order to put you to a test He turned you away from your foes. Still He pardoned you after that for Allah is Bounteous to those who believe."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Ali Imran",
      "ayah_number": 152,
      "ayah_end_number": 152,
      "text_ar": "وَلَقَدْ صَدَقَكُمُ ٱللَّهُ وَعْدَهُۥٓ إِذْ تَحُسُّونَهُم بِإِذْنِهِۦ ۖ حَتَّىٰٓ إِذَا فَشِلْتُمْ وَتَنَـٰزَعْتُمْ فِى ٱلْأَمْرِ وَعَصَيْتُم مِّنۢ بَعْدِ مَآ أَرَىٰكُم مَّا تُحِبُّونَ ۚ مِنكُم مَّن يُرِيدُ ٱلدُّنْيَا وَمِنكُم مَّن يُرِيدُ ٱلْءَاخِرَةَ ۚ ثُمَّ صَرَفَكُمْ عَنْهُمْ لِيَبْتَلِيَكُمْ ۖ وَلَقَدْ عَفَا عَنكُمْ ۗ وَٱللَّهُ ذُو فَضْلٍ عَلَى ٱلْمُؤْمِنِينَ",
      "text_tr": "Andolsun, Allah size verdiği sözünde sadık kaldı; siz O'nun izniyle onları kırıp-geçiriyordunuz. Öyle ki sevdiğiniz (zafer)i size gösterdikten sonra, siz yılgınlık gösterdiniz, isyan ettiniz ve emir hakkında çekiştiniz. Sizden kiminiz dünyayı, kiminiz ahireti istiyordu. Sonra (Allah) denemek için sizi ondan çevirdi. Ama (yine de) sizi bağışladı. Allah mü'minlere karşı fazl (ve ihsan) sahibi olandır.",
      "text_en": "And Allah had certainly fulfilled His promise to you when you were killing the enemy by His permission until [the time] when you lost courage and fell to disputing about the order [given by the Prophet] and disobeyed after He had shown you that which you love. Among you are some who desire this world, and among you are some who desire the Hereafter. Then he turned you back from them [defeated] that He might test you. And He has already forgiven you, and Allah is the possessor of bounty for the believers.",
      "priority": 1,
      "notes": "bulk approved from local Tanzil source",
