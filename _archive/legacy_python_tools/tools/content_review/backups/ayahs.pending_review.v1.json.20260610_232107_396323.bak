      "ayahs": [
        {
          "ref": "068/035",
          "surah": 68,
          "ayah": 35,
          "arabic": "أَفَنَجْعَلُ ٱلْمُسْلِمِينَ كَٱلْمُجْرِمِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "068/035",
            "text": "Öyleyse, Müslümanları suçlu-günahkar olanlar gibi (eşit) kılar mıyız?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "068/035",
            "text": "Kendilerini Allah'a vermiş olanları hiç suçlular gibi tutar mıyız?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "068/035",
            "text": "Then will We treat the Muslims like the criminals?"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "068/035",
            "text": "What! Shall We treat those who have submitted (to Our command) like those who have acted as criminals?"
          }
        }
      ],
