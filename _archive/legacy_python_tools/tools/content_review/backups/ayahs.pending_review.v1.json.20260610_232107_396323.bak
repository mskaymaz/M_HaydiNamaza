      "input": {
        "sira": 525,
        "ref": "009/034",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 238,
        "input_status": "ok",
        "input_source_ref_groups": "009/034"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "009/034"
      ],
      "ayahs": [
        {
          "ref": "009/034",
          "surah": 9,
          "ayah": 34,
          "arabic": "يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِنَّ كَثِيرًا مِّنَ ٱلْأَحْبَارِ وَٱلرُّهْبَانِ لَيَأْكُلُونَ أَمْوَٰلَ ٱلنَّاسِ بِٱلْبَـٰطِلِ وَيَصُدُّونَ عَن سَبِيلِ ٱللَّهِ ۗ وَٱلَّذِينَ يَكْنِزُونَ ٱلذَّهَبَ وَٱلْفِضَّةَ وَلَا يُنفِقُونَهَا فِى سَبِيلِ ٱللَّهِ فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "009/034",
            "text": "Ey iman edenler, gerçek şu ki, (Yahudi) bilginlerinden ve (Hıristiyan) rahiplerinden çoğu, insanların mallarını haksızlıkla yerler ve Allah'ın yolundan alıkoyarlar. Altını ve gümüşü biriktirip de Allah yolunda harcamayanlar... Onlara acı bir azabı müjdele."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "009/034",
            "text": "Ey inananlar! Hahamlar ve rahiplerin çoğu, insanların mallarını haksızlıkla yerler. Allah yolundan alıkoyarlar. Altın ve gümüşü biriktirip Allah yolunda sarf etmeyenlere can yakıcı bir azabı müjdele."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "009/034",
            "text": "O you who have believed, indeed many of the scholars and the monks devour the wealth of people unjustly and avert [them] from the way of Allah. And those who hoard gold and silver and spend it not in the way of Allah - give them tidings of a painful punishment."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "009/034",
            "text": "Believers! Many of the rabbis and monks wrongfully devour mankind's possessions and hinder people from the Way of Allah. And there are those who amass gold and silver and do not spend it in the Way of Allah. Announce to them the tidings of a painful chastisement"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
