          "surah": 68,
          "ayah": 4,
          "arabic": "وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "068/004",
            "text": "Ve şüphesiz sen, pek büyük bir ahlak üzerindesin."
