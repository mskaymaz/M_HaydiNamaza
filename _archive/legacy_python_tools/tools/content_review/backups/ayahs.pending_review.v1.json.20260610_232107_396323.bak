      "ayahs": [
        {
          "ref": "092/019",
          "surah": 92,
          "ayah": 19,
          "arabic": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "092/019",
            "text": "Onun yanında hiç kimsenin karşılığı verilecek bir nimeti (borcu) yoktur."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "092/019",
            "text": "O yaptığı iyiliği birinden karşılık görmek için değil, ancak yüce Rabbinin hoşnudluğunu (rızasını) gözeterek yapmıştır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "092/019",
            "text": "And not [giving] for anyone who has [done him] a favor to be rewarded"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "092/019",
            "text": "not as payment for any favours that he received,"
          }
        }
      ],
