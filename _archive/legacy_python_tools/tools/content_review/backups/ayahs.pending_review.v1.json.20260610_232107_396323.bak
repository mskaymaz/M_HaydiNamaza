      ],
      "ayahs": [
        {
          "ref": "113/005",
          "surah": 113,
          "ayah": 5,
          "arabic": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "113/005",
            "text": "Ve hased ettiği zaman, hasetçinin şerrinden."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "113/005",
            "text": "De ki: \"Yaratıkların şerrinden, bastırdığı zaman karanlığın şerrinden, düğümlere nefes eden büyücülerin şerrinden, hased ettiği zaman hasedcilerin şerrinden, tan yerini ağartan Rabbe sığınırım.\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "113/005",
            "text": "And from the evil of an envier when he envies.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "113/005",
            "text": "and from the evil of the envier when he envies.”"
          }
        }
      ],
