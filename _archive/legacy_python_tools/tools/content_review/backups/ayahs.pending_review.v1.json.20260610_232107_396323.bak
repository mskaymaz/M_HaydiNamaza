      ],
      "ayahs": [
        {
          "ref": "019/081",
          "surah": 19,
          "ayah": 81,
          "arabic": "وَٱتَّخَذُوا۟ مِن دُونِ ٱللَّهِ ءَالِهَةً لِّيَكُونُوا۟ لَهُمْ عِزًّا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "019/081",
            "text": "Kendilerine güç (izzet) sağlasınlar diye, Allah'tan başka ilahlar edindiler."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "019/081",
            "text": "Onlar kendilerine kuvvet ve şeref kazandırsın diye, Allah'ı bırakarak tanrılar edindiler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "019/081",
            "text": "And they have taken besides Allah [false] deities that they would be for them [a source of] honor."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "019/081",
            "text": "They have taken other gods instead of Allah that they may be a source of strength for them."
          }
        }
      ],
      "status": "approved",
