      "ayahs": [
        {
          "ref": "009/119",
          "surah": 9,
          "ayah": 119,
          "arabic": "يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱتَّقُوا۟ ٱللَّهَ وَكُونُوا۟ مَعَ ٱلصَّـٰدِقِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "009/119",
            "text": "Ey iman edenler, Allah'tan sakının ve doğru (sadık)larla birlikte olun."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "009/119",
            "text": "Ey inananlar! Allah'tan sakının ve doğrularla beraber olun."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "009/119",
            "text": "O you who have believed, fear Allah and be with those who are true."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "009/119",
            "text": "Believers! Have fear of Allah and stand with those that are truthful."
          }
        }
      ],
