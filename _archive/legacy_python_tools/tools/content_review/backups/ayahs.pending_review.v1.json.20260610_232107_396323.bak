      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "016/003"
      ],
      "ayahs": [
        {
          "ref": "016/003",
          "surah": 16,
          "ayah": 3,
          "arabic": "خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ بِٱلْحَقِّ ۚ تَعَـٰلَىٰ عَمَّا يُشْرِكُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "016/003",
            "text": "Gökleri ve yeri hak ile yarattı: O, şirk koştukları şeylerden Yücedir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "016/003",
            "text": "Gökleri ve yeri gereğince yaratmıştır. Onların eş koştukları şeylerden yücedir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "016/003",
            "text": "He created the heavens and earth in truth. High is He above what they associate with Him."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "016/003",
            "text": "He created the heavens and the earth with Truth. Exalted is He above whatever they associate with Allah in His Divinity."
          }
        }
      ],
      "status": "approved",
