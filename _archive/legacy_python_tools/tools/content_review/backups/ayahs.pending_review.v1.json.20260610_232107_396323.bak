      "ayahs": [
        {
          "ref": "047/008",
          "surah": 47,
          "ayah": 8,
          "arabic": "وَٱلَّذِينَ كَفَرُوا۟ فَتَعْسًا لَّهُمْ وَأَضَلَّ أَعْمَـٰلَهُمْ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "047/008",
            "text": "İnkar edenler ise, yüzükoyun-düşüş, onlara olsun; (Allah,) amellerini giderip-boşa çıkarmıştır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "047/008",
            "text": "İnkar edenlere ise, yıkım ve yokluk olsun! Allah onların işlerini boşa çıkarır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "047/008",
            "text": "But those who disbelieve - for them is misery, and He will waste their deeds."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "047/008",
            "text": "As to those who disbelieve, perdition lies in store for them and Allah has reduced their works to nought."
          }
        }
      ],
      "status": "approved",
