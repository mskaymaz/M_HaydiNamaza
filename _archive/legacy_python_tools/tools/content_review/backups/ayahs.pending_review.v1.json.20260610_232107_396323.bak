      "ayahs": [
        {
          "ref": "026/071",
          "surah": 26,
          "ayah": 71,
          "arabic": "قَالُوا۟ نَعْبُدُ أَصْنَامًا فَنَظَلُّ لَهَا عَـٰكِفِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "026/071",
            "text": "Demişlerdi ki: \"Putlara tapıyoruz, bunun için sürekli onların önünde bel büküp eğiliyoruz.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "026/071",
            "text": "\"Putlara tapıyoruz, onlara bağlanıp duruyoruz\" demişlerdi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "026/071",
            "text": "They said, \"We worship idols and remain to them devoted.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "026/071",
            "text": "They answered: \"There are some idols that we worship and are devoted to them with constancy.\""
          }
        }
      ],
      "status": "approved",
