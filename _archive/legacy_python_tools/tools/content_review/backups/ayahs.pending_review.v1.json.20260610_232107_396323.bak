        "ref": "002/206",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 136,
        "input_status": "ok",
        "input_source_ref_groups": "002/206"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "002/206"
      ],
      "ayahs": [
        {
          "ref": "002/206",
          "surah": 2,
          "ayah": 206,
          "arabic": "وَإِذَا قِيلَ لَهُ ٱتَّقِ ٱللَّهَ أَخَذَتْهُ ٱلْعِزَّةُ بِٱلْإِثْمِ ۚ فَحَسْبُهُۥ جَهَنَّمُ ۚ وَلَبِئْسَ ٱلْمِهَادُ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "002/206",
            "text": "Ona: \"Allah'tan kork\" denildiğinde, büyüklük gururu onu günaha sürükler, kuşatır. Böylesine cehennem yeter; ne kötü bir yataktır o."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "002/206",
            "text": "Ona: \"Allah'tan sakın\" denince, gururu kendisine günah işletir, artık ona cehennem yetişir, ne kötü yataktır!.."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "002/206",
            "text": "And when it is said to him, \"Fear Allah,\" pride in the sin takes hold of him. Sufficient for him is Hellfire, and how wretched is the resting place."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "002/206",
            "text": "And when it is said to him, \"Fear Allah,\" vanity seizes him and makes him adhere to the sin. Hell is the proper place for such a person and it is a very bad dwelling indeed."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
