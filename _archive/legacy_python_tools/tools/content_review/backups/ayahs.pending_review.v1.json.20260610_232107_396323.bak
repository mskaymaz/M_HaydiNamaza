    {
      "ref": "004/059",
      "id": "004/059",
      "surah": 4,
      "ayahStart": 59,
      "ayahEnd": 59,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 262,
        "ref": "004/059",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 292,
        "input_status": "ok",
        "input_source_ref_groups": "004/059"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "004/059"
      ],
      "ayahs": [
        {
          "ref": "004/059",
          "surah": 4,
          "ayah": 59,
          "arabic": "يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ أَطِيعُوا۟ ٱللَّهَ وَأَطِيعُوا۟ ٱلرَّسُولَ وَأُو۟لِى ٱلْأَمْرِ مِنكُمْ ۖ فَإِن تَنَـٰزَعْتُمْ فِى شَىْءٍ فَرُدُّوهُ إِلَى ٱللَّهِ وَٱلرَّسُولِ إِن كُنتُمْ تُؤْمِنُونَ بِٱللَّهِ وَٱلْيَوْمِ ٱلْءَاخِرِ ۚ ذَٰلِكَ خَيْرٌ وَأَحْسَنُ تَأْوِيلًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/059",
            "text": "Ey iman edenler, Allah'a itaat edin; elçiye itaat edin ve sizden olan emir sahiplerine de. Eğer bir şeyde anlaşmazlığa düşerseniz, artık onu Allah'a ve elçisine döndürün. Şayet Allah'a ve ahiret gününe iman ediyorsanız. Bu, hayırlı ve sonuç bakımından daha güzeldir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/059",
            "text": "Ey İnananlar! Allah'a itaat edin, Peygambere ve sizden buyruk sahibi olanlara itaat edin. Eğer bir şeyde çekişirseniz, Allah'a ve ahiret gününe inanmışsanız onun halini Allah'a ve Peygambere bırakın. Bu, hayırlı ve netice itibariyle en güzeldir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/059",
            "text": "O you who have believed, obey Allah and obey the Messenger and those in authority among you. And if you disagree over anything, refer it to Allah and the Messenger, if you should believe in Allah and the Last Day. That is the best [way] and best in result."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/059",
            "text": "Believers! Obey Allah and obey the Messenger, and those from among you who are invested with authority; and then if you were to dispute among yourselves about anything refer it to Allah and the Messenger if you indeed believe in Allah and the Last Day; that is better and more commendable in the end."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:50:08+00:00"
      },
      "surah_name": "Nisa",
      "ayah_number": 59,
      "ayah_end_number": 59,
      "text_ar": "يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ أَطِيعُوا۟ ٱللَّهَ وَأَطِيعُوا۟ ٱلرَّسُولَ وَأُو۟لِى ٱلْأَمْرِ مِنكُمْ ۖ فَإِن تَنَـٰزَعْتُمْ فِى شَىْءٍ فَرُدُّوهُ إِلَى ٱللَّهِ وَٱلرَّسُولِ إِن كُنتُمْ تُؤْمِنُونَ بِٱللَّهِ وَٱلْيَوْمِ ٱلْءَاخِرِ ۚ ذَٰلِكَ خَيْرٌ وَأَحْسَنُ تَأْوِيلًا",
      "text_tr": "Ey iman edenler, Allah'a itaat edin; elçiye itaat edin ve sizden olan emir sahiplerine de. Eğer bir şeyde anlaşmazlığa düşerseniz, artık onu Allah'a ve elçisine döndürün. Şayet Allah'a ve ahiret gününe iman ediyorsanız. Bu, hayırlı ve sonuç bakımından daha güzeldir.",
      "text_en": "O you who have believed, obey Allah and obey the Messenger and those in authority among you. And if you disagree over anything, refer it to Allah and the Messenger, if you should believe in Allah and the Last Day. That is the best [way] and best in result.",
      "priority": 1,
      "notes": "bulk approved from local Tanzil source",
      "createdAt": "2026-06-09T08:50:08+00:00",
      "updatedAt": "2026-06-09T08:50:08+00:00",
      "approvedAt": "2026-06-09T08:50:08+00:00",
