      "input": {
        "sira": 143,
        "ref": "003/025",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 185,
        "input_status": "ok",
        "input_source_ref_groups": "003/025"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "003/025"
      ],
      "ayahs": [
        {
          "ref": "003/025",
          "surah": 3,
          "ayah": 25,
          "arabic": "فَكَيْفَ إِذَا جَمَعْنَـٰهُمْ لِيَوْمٍ لَّا رَيْبَ فِيهِ وَوُفِّيَتْ كُلُّ نَفْسٍ مَّا كَسَبَتْ وَهُمْ لَا يُظْلَمُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "003/025",
            "text": "Artık onları, kendisinde şüphe olmayan bir gün topladığımızda ve her bir nefse -haksızlığa uğratılmaksızın- kazandığı tam olarak ödendiğinde nasıl olacak?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "003/025",
            "text": "Geleceğinden şüphe olmayan günde, onları topladığımız ve haksızlık yapılmayarak herkese kazandığı eksiksiz verildiği zaman, nasıl olacak?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "003/025",
            "text": "So how will it be when We assemble them for a Day about which there is no doubt? And each soul will be compensated [in full for] what it earned, and they will not be wronged."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "003/025",
            "text": "How, then, will they fare when We shall gather them all together to witness the Day about (the coming of) which there is no doubt, and when every human being shall be repaid in full for what he has done, and none shall be wronged?"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
