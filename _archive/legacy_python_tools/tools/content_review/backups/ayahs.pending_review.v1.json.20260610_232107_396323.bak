    {
      "ref": "022/040",
      "id": "022/040",
      "surah": 22,
      "ayahStart": 40,
      "ayahEnd": 40,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 796,
        "ref": "022/040",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 408,
        "input_status": "ok",
        "input_source_ref_groups": "022/040"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "022/040"
      ],
      "ayahs": [
        {
          "ref": "022/040",
          "surah": 22,
          "ayah": 40,
          "arabic": "ٱلَّذِينَ أُخْرِجُوا۟ مِن دِيَـٰرِهِم بِغَيْرِ حَقٍّ إِلَّآ أَن يَقُولُوا۟ رَبُّنَا ٱللَّهُ ۗ وَلَوْلَا دَفْعُ ٱللَّهِ ٱلنَّاسَ بَعْضَهُم بِبَعْضٍ لَّهُدِّمَتْ صَوَٰمِعُ وَبِيَعٌ وَصَلَوَٰتٌ وَمَسَـٰجِدُ يُذْكَرُ فِيهَا ٱسْمُ ٱللَّهِ كَثِيرًا ۗ وَلَيَنصُرَنَّ ٱللَّهُ مَن يَنصُرُهُۥٓ ۗ إِنَّ ٱللَّهَ لَقَوِىٌّ عَزِيزٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "022/040",
            "text": "Onlar, yalnızca; \"Rabbimiz Allah'tır\" demelerinden dolayı, haksız yere yurtlarından sürgün edilip çıkarıldılar. Eğer Allah'ın, insanların kimini kimiyle defetmesi (yenilgiye uğratması) olmasaydı, manastırlar, kiliseler, havralar ve içinde Allah'ın isminin çokça anıldığı mescidler, muhakkak yıkılır giderdi. Allah Kendi (dini)ne yardım edenlere kesin olarak yardım eder. Şüphesiz Allah, güçlü olandır, Aziz olandır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "022/040",
            "text": "Onlar haksız yere ve \"Rabbimiz Allah'tır\" dediler diye yurtlarından çıkarılmışlardır. Allah insanların bir kısmını diğeriyle savmasaydı, manastırlar, kiliseler, havralar ve içinde Allah'ın adı çok anılan camiler yıkılıp giderdi. And olsun ki, Allah'a yardım edenlere O da yardım eder. Doğrusu Allah kuvvetlidir, güçlüdür."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "022/040",
            "text": "[They are] those who have been evicted from their homes without right - only because they say, \"Our Lord is Allah.\" And were it not that Allah checks the people, some by means of others, there would have been demolished monasteries, churches, synagogues, and mosques in which the name of Allah is much mentioned. And Allah will surely support those who support Him. Indeed, Allah is Powerful and Exalted in Might."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "022/040",
            "text": "those who were unjustly expelled from their homes for no other reason than their saying: \"Allah is Our Lord.\" If Allah were not to repel some through others, monasteries and churches and synagogues and mosques wherein the name of Allah is much mentioned, would certainly have been pulled down. Allah will most certainly help those who will help Him. Verily Allah is Immensely Strong, Overwhelmingly Mighty."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
