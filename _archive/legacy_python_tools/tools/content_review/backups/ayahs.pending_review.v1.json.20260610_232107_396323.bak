          "ref": "026/037",
          "surah": 26,
          "ayah": 37,
          "arabic": "يَأْتُوكَ بِكُلِّ سَحَّارٍ عَلِيمٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "026/037",
            "text": "\"Bütün uzman-bilgin büyücüleri sana getirsinler.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "026/037",
            "text": "\"Onu ve kardeşini alıkoy, şehirlere, sana bütün bilgin sihirbazları getirecek toplayıcılar gönder\" dediler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "026/037",
            "text": "Who will bring you every learned, skilled magician.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "026/037",
            "text": "to mobilise all skilled magicians.\""
          }
        }
      ],
