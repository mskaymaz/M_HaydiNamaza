      "source": {
        "arabic": "Existing clean UTF-8 Uthmani Arabic text from prior working dataset; Tanzil Uthmani Arabic verification/fetch script available",
        "tr": "Tanzil tr.bulac - Ali Bulaç",
        "en": "Tanzil en.sahih - Saheeh International",
        "tr_alternative": "Tanzil tr.diyanet - Diyanet İşleri",
        "en_alternative": "Tanzil en.maududi - Abul A’la Maududi"
      },
      "sourceRefGroups": [
        "002/009"
      ],
      "ayahs": [
        {
          "ref": "002/009",
          "surah": 2,
          "ayah": 9,
          "arabic": "يُخَـٰدِعُونَ ٱللَّهَ وَٱلَّذِينَ ءَامَنُوا۟ وَمَا يَخْدَعُونَ إِلَّآ أَنفُسَهُمْ وَمَا يَشْعُرُونَ",
          "tr": {
            "source": "Tanzil tr.bulac - Ali Bulaç",
            "text": "(Sözde) Allah'ı ve iman edenleri aldatırlar. Oysa onlar, yalnızca kendilerini aldatıyorlar ve şuurunda değiller."
          },
          "en": {
            "source": "Tanzil en.sahih - Saheeh International",
            "text": "They [think to] deceive Allah and those who believe, but they deceive not except themselves and perceive [it] not."
          },
          "alternatives": {
            "tr_diyanet_tanzil": {
              "source": "Tanzil tr.diyanet - Diyanet İşleri",
              "text": "Bunlar Allah'ı ve inananları aldatmaya çalışırlar, oysa sadece kendilerini aldatırlar da farkında değildirler."
            },
            "en_maududi": {
              "source": "Tanzil en.maududi - Abul A’la Maududi",
              "text": "They thus try to deceive Allah and the Believers, but they succeed in deceiving none except themselves and they realize it not."
            }
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "pending_review",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "",
        "updated_at": null
      },
      "text_tr": "(Sözde) Allah'ı ve iman edenleri aldatırlar. Oysa onlar, yalnızca kendilerini aldatıyorlar ve şuurunda değiller.",
      "text_ar": "يُخَـٰدِعُونَ ٱللَّهَ وَٱلَّذِينَ ءَامَنُوا۟ وَمَا يَخْدَعُونَ إِلَّآ أَنفُسَهُمْ وَمَا يَشْعُرُونَ",
      "text_en": "They [think to] deceive Allah and those who believe, but they deceive not except themselves and perceive [it] not."
