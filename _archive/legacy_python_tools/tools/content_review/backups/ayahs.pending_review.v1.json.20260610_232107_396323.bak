          "ayah": 25,
          "arabic": "وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "081/025",
            "text": "O (Kur'an) da kovulmuş şeytanın sözü değildir."
          },
