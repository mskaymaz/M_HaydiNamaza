    {
      "ref": "003/145",
      "id": "003/145",
      "surah": 3,
      "ayahStart": 145,
      "ayahEnd": 145,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 204,
        "ref": "003/145",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 232,
        "input_status": "ok",
        "input_source_ref_groups": "003/145"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "003/145"
      ],
      "ayahs": [
        {
          "ref": "003/145",
          "surah": 3,
          "ayah": 145,
          "arabic": "وَمَا كَانَ لِنَفْسٍ أَن تَمُوتَ إِلَّا بِإِذْنِ ٱللَّهِ كِتَـٰبًا مُّؤَجَّلًا ۗ وَمَن يُرِدْ ثَوَابَ ٱلدُّنْيَا نُؤْتِهِۦ مِنْهَا وَمَن يُرِدْ ثَوَابَ ٱلْءَاخِرَةِ نُؤْتِهِۦ مِنْهَا ۚ وَسَنَجْزِى ٱلشَّـٰكِرِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "003/145",
            "text": "Allah'ın izni olmaksızın hiçbir nefis için ölmek yoktur. O, süresi belirtilmiş bir yazıdır. Kim dünyanın yararını (sevabını) isterse ona ondan veririz, kim ahiret sevabını isterse ona da ondan veririz. Biz şükredenleri pek yakında ödüllendireceğiz."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "003/145",
            "text": "Hiçbir kimse Allah'ın izni olmadan ölmez; o, belli bir vakte bağlanmıştır. Kim dünya nimetini isterse ona ondan veririz; ve kim ahiret nimetini isterse ona ondan veririz. Şükredenlerin mükafatını vereceğiz."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "003/145",
            "text": "And it is not [possible] for one to die except by permission of Allah at a decree determined. And whoever desires the reward of this world - We will give him thereof; and whoever desires the reward of the Hereafter - We will give him thereof. And we will reward the grateful."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "003/145",
            "text": "It is not given to any soul to die except with the leave of Allah, and at an appointed time. And he who desires his reward in this world, We shall grant him the reward of this world; and he who desires the reward of the Other World, We shall grant him the reward of the Other World. And soon shall We reward the ones who are grateful."
          }
        }
