        "input_ayah_count": 1,
        "input_char_count": 100,
        "input_status": "ok",
        "input_source_ref_groups": "066/007"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "066/007"
      ],
      "ayahs": [
        {
          "ref": "066/007",
          "surah": 66,
          "ayah": 7,
          "arabic": "يَـٰٓأَيُّهَا ٱلَّذِينَ كَفَرُوا۟ لَا تَعْتَذِرُوا۟ ٱلْيَوْمَ ۖ إِنَّمَا تُجْزَوْنَ مَا كُنتُمْ تَعْمَلُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "066/007",
            "text": "Ey inkar edenler, bugün özür beyan etmeyin. Siz ancak yaptıklarınızla cezalandırılıyorsunuz."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "066/007",
            "text": "\"Ey inkar edenler! Bugün özür beyan etmeyin, ancak işlediklerinizin karşılığını görmektesiniz\" denir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "066/007",
            "text": "O you who have disbelieved, make no excuses that Day. You will only be recompensed for what you used to do."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "066/007",
            "text": "(It will then be said): “Unbelievers, make no excuses today. You are being recompensed for nothing else but your deeds.”"
          }
        }
      ],
      "status": "approved",
