      "ayahs": [
        {
          "ref": "089/013",
          "surah": 89,
          "ayah": 13,
          "arabic": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "089/013",
            "text": "Bundan dolayı, Rabbin, onların üzerine bir azap kamçısı çarpıverdi."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "089/013",
            "text": "Rabbin onları azap kırbacından geçirmiştir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "089/013",
            "text": "So your Lord poured upon them a scourge of punishment."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "089/013",
            "text": "Then their Lord unloosed upon them the lash of chastisement."
          }
        }
      ],
