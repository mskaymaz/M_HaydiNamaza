    {
      "ref": "059/021",
      "id": "059/021",
      "surah": 59,
      "ayahStart": 21,
      "ayahEnd": 21,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 1256,
        "ref": "059/021",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 183,
        "input_status": "ok",
        "input_source_ref_groups": "059/021"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "059/021"
      ],
      "ayahs": [
        {
          "ref": "059/021",
          "surah": 59,
          "ayah": 21,
          "arabic": "لَوْ أَنزَلْنَا هَـٰذَا ٱلْقُرْءَانَ عَلَىٰ جَبَلٍ لَّرَأَيْتَهُۥ خَـٰشِعًا مُّتَصَدِّعًا مِّنْ خَشْيَةِ ٱللَّهِ ۚ وَتِلْكَ ٱلْأَمْثَـٰلُ نَضْرِبُهَا لِلنَّاسِ لَعَلَّهُمْ يَتَفَكَّرُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "059/021",
            "text": "Şayet Biz bu Kur'an'ı bir dağın üzerine indirmiş olsaydık, andolsun onu Allah korkusundan saygı ile baş eğmiş, parça parça olmuş görürdün. İşte Biz, belki düşünürler diye, insanlara böyle örnekler veririz."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "059/021",
            "text": "Eğer Biz Kuran'ı bir dağa indirmiş olsaydık, sen, onun, Allah korkusuyla başeğerek parça parça olduğunu görürdün. Bu misalleri, insanlar düşünsünler diye veriyoruz."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "059/021",
            "text": "If We had sent down this Qur'an upon a mountain, you would have seen it humbled and coming apart from fear of Allah. And these examples We present to the people that perhaps they will give thought."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "059/021",
            "text": "Had We sent down this Qur'an upon a mountain you would indeed have seen it humbling itself and breaking asunder out of fear of Allah. We propound such parables to people that they may reflect."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Hasr",
      "ayah_number": 21,
      "ayah_end_number": 21,
      "text_ar": "لَوْ أَنزَلْنَا هَـٰذَا ٱلْقُرْءَانَ عَلَىٰ جَبَلٍ لَّرَأَيْتَهُۥ خَـٰشِعًا مُّتَصَدِّعًا مِّنْ خَشْيَةِ ٱللَّهِ ۚ وَتِلْكَ ٱلْأَمْثَـٰلُ نَضْرِبُهَا لِلنَّاسِ لَعَلَّهُمْ يَتَفَكَّرُونَ",
      "text_tr": "Şayet Biz bu Kur'an'ı bir dağın üzerine indirmiş olsaydık, andolsun onu Allah korkusundan saygı ile baş eğmiş, parça parça olmuş görürdün. İşte Biz, belki düşünürler diye, insanlara böyle örnekler veririz.",
      "text_en": "If We had sent down this Qur'an upon a mountain, you would have seen it humbled and coming apart from fear of Allah. And these examples We present to the people that perhaps they will give thought.",
      "priority": 1,
      "notes": "bulk approved from local Tanzil source",
