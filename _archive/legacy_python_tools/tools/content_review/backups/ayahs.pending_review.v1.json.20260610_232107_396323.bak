      "input": {
        "sira": null,
        "ref": "002/042-043",
        "input_type": "aralik",
        "input_ayah_count": 2,
        "input_char_count": 0,
        "input_status": "tool_ekle",
        "input_source_ref_groups": "002/042-043"
      },
      "source": {
        "arabic": "Tanzil Uthmani Quran Text",
        "tr": "Tanzil tr.bulac / Ali Bulac",
        "trAlt": "Tanzil tr.diyanet / Diyanet Isleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A'la Maududi"
      },
      "sourceRefGroups": [
        "002/042-043"
      ],
      "ayahs": [
        {
          "ref": "002/042",
          "surah": 2,
          "ayah": 42,
          "arabic": "وَلَا تَلْبِسُوا۟ ٱلْحَقَّ بِٱلْبَـٰطِلِ وَتَكْتُمُوا۟ ٱلْحَقَّ وَأَنتُمْ تَعْلَمُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulac",
            "sourceRef": "002/042",
            "text": "Hakkı batıl ile örtmeyin ve hakkı gizlemeyin. (Kaldı ki) siz (gerçeği) biliyorsunuz."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "002/042",
            "text": "And do not mix the truth with falsehood or conceal the truth while you know [it]."
          },
          "alternatives": {
            "tr_diyanet_tanzil": {
              "source": "Tanzil tr.diyanet / Diyanet Isleri",
              "text": "Hakkı batıla karıştırmayın ve bile bile hakkı gizlemeyin."
            },
            "en_maududi": {
              "source": "Tanzil en.maududi / Abul A'la Maududi",
              "text": "Confound not the Truth with falsehood nor conceal it knowingly."
            }
          }
        },
        {
          "ref": "002/043",
          "surah": 2,
          "ayah": 43,
          "arabic": "وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ وَٱرْكَعُوا۟ مَعَ ٱلرَّٰكِعِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulac",
            "sourceRef": "002/043",
            "text": "Namazı dosdoğru kılın, zekatı verin ve rüku edenlerle birlikte siz de rüku edin."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "002/043",
            "text": "And establish prayer and give zakah and bow with those who bow [in worship and obedience]."
          },
          "alternatives": {
            "tr_diyanet_tanzil": {
              "source": "Tanzil tr.diyanet / Diyanet Isleri",
              "text": "Namazı kılın, zekatı verin, rüku edenlerle birlikte rüku edin."
            },
            "en_maududi": {
              "source": "Tanzil en.maududi / Abul A'la Maududi",
              "text": "Establish the Salat, pay the Zakat and bow down before Me along with those who bow down."
            }
          }
        }
      ],
