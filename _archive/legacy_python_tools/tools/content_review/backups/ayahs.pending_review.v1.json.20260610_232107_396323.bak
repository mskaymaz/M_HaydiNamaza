      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "004/028"
      ],
      "ayahs": [
        {
          "ref": "004/028",
          "surah": 4,
          "ayah": 28,
          "arabic": "يُرِيدُ ٱللَّهُ أَن يُخَفِّفَ عَنكُمْ ۚ وَخُلِقَ ٱلْإِنسَـٰنُ ضَعِيفًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/028",
            "text": "Allah (ağır yükleri) sizden hafifletmek ister: (Çünkü) insan zayıf olarak yaratılmıştır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/028",
            "text": "İnsan zayıf yaratılmış olduğundan Allah sizden yükü hafifletmek ister."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/028",
            "text": "And Allah wants to lighten for you [your difficulties]; and mankind was created weak."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/028",
            "text": "Allah wants to lighten your burdens, for man was created weak."
          }
        }
      ],
