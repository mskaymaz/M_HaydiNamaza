          "ref": "020/043",
          "surah": 20,
          "ayah": 43,
          "arabic": "ٱذْهَبَآ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "020/043",
            "text": "\"İkiniz Firavun'a gidin, çünkü o, azmış bulunuyor.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "020/043",
            "text": "Firavun'a gidin, doğrusu o azmıştır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "020/043",
            "text": "Go, both of you, to Pharaoh. Indeed, he has transgressed."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "020/043",
            "text": "Go both of you to Pharaoh, for he has transgressed all bounds,"
          }
        }
      ],
