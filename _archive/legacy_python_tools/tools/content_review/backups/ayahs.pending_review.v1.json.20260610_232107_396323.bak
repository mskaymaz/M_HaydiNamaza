        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 127,
        "input_status": "ok",
        "input_source_ref_groups": "021/092"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "021/092"
      ],
      "ayahs": [
        {
          "ref": "021/092",
          "surah": 21,
          "ayah": 92,
          "arabic": "إِنَّ هَـٰذِهِۦٓ أُمَّتُكُمْ أُمَّةً وَٰحِدَةً وَأَنَا۠ رَبُّكُمْ فَٱعْبُدُونِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "021/092",
            "text": "Gerçekten, sizin bu ümmetiniz tek bir ümmettir. Ben de sizin Rabbinizim, öyleyse Bana ibadet ediniz."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "021/092",
            "text": "Doğrusu tevhid dini olan Müslümanlık, bir tek din olarak sizin dininizdir ve Ben de Rabbinizim, artık Bana kulluk edin."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "021/092",
            "text": "Indeed this, your religion, is one religion, and I am your Lord, so worship Me."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "021/092",
            "text": "Verily this community of yours is a single community, and I am your Lord; so worship Me."
          }
        }
      ],
      "status": "approved",
