    {
      "ref": "002/099-100",
      "id": "002/099-100",
      "surah": 2,
      "ayahStart": 99,
      "ayahEnd": null,
      "type": "range",
      "ayahCount": 2,
      "input": {
        "sira": null,
        "ref": "002/099-100",
        "input_type": "aralik",
        "input_ayah_count": 2,
        "input_char_count": 0,
        "input_status": "tool_ekle",
        "input_source_ref_groups": "002/099-100"
      },
      "source": {
        "arabic": "Tanzil Uthmani Quran Text",
        "tr": "Tanzil tr.bulac / Ali Bulac",
        "trAlt": "Tanzil tr.diyanet / Diyanet Isleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A'la Maududi"
      },
      "sourceRefGroups": [
        "002/099-100"
      ],
      "ayahs": [
        {
          "ref": "002/099",
          "surah": 2,
          "ayah": 99,
          "arabic": "وَلَقَدْ أَنزَلْنَآ إِلَيْكَ ءَايَـٰتٍۭ بَيِّنَـٰتٍ ۖ وَمَا يَكْفُرُ بِهَآ إِلَّا ٱلْفَـٰسِقُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulac",
            "sourceRef": "002/099",
            "text": "Andolsun Biz sana apaçık ayetler indirdik. Bunları fasıklardan başkası inkar etmez."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "002/099",
            "text": "And We have certainly revealed to you verses [which are] clear proofs, and no one would deny them except the defiantly disobedient."
          },
          "alternatives": {
            "tr_diyanet_tanzil": {
              "source": "Tanzil tr.diyanet / Diyanet Isleri",
              "text": "And olsun ki, sana apaçık ayetler indirdik. Onları sadece yoldan çıkmışlar inkar eder."
            },
            "en_maududi": {
              "source": "Tanzil en.maududi / Abul A'la Maududi",
              "text": "We have sent down to you Revelations that clearly expound the Truth, and none but the disobedient reject them."
            }
          }
        },
        {
          "ref": "002/100",
          "surah": 2,
          "ayah": 100,
          "arabic": "أَوَكُلَّمَا عَـٰهَدُوا۟ عَهْدًا نَّبَذَهُۥ فَرِيقٌ مِّنْهُم ۚ بَلْ أَكْثَرُهُمْ لَا يُؤْمِنُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulac",
            "sourceRef": "002/100",
            "text": "Ne zaman bir ahidde bulundularsa, içlerinden bir bölümü onu bozmadı mı? Hayır, onların çoğu iman etmezler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "002/100",
            "text": "Is it not [true] that every time they took a covenant a party of them threw it away? But, [in fact], most of them do not believe."
          },
          "alternatives": {
            "tr_diyanet_tanzil": {
              "source": "Tanzil tr.diyanet / Diyanet Isleri",
              "text": "Onlar, her ne zaman bir ahidde bulunmuşlarsa içlerinden bir takımı onu bozmamış mıdır? Zaten onların çoğu inanmazlar."
            },
            "en_maududi": {
              "source": "Tanzil en.maududi / Abul A'la Maududi",
              "text": "Has it not always been so that every time they made a covenant, some of them set it aside? Nay, most of them never believe in it sincerely."
            }
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
