    {
      "ref": "009/067",
      "id": "009/067",
      "surah": 9,
      "ayahStart": 67,
      "ayahEnd": 67,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 545,
        "ref": "009/067",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 245,
        "input_status": "ok",
        "input_source_ref_groups": "009/067"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "009/067"
      ],
      "ayahs": [
        {
          "ref": "009/067",
          "surah": 9,
          "ayah": 67,
          "arabic": "ٱلْمُنَـٰفِقُونَ وَٱلْمُنَـٰفِقَـٰتُ بَعْضُهُم مِّنۢ بَعْضٍ ۚ يَأْمُرُونَ بِٱلْمُنكَرِ وَيَنْهَوْنَ عَنِ ٱلْمَعْرُوفِ وَيَقْبِضُونَ أَيْدِيَهُمْ ۚ نَسُوا۟ ٱللَّهَ فَنَسِيَهُمْ ۗ إِنَّ ٱلْمُنَـٰفِقِينَ هُمُ ٱلْفَـٰسِقُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "009/067",
            "text": "Münafık erkekler ve münafık kadınlar, bazısı bazısındandır; kötülüğü emrederler, iyilikten alıkoyarlar, ellerini sımsıkı tutarlar. Onlar Allah'ı unuttular; O da onları unuttu. Şüphesiz, münafıklar fıska sapanlardır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "009/067",
            "text": "İkiyüzlü erkek ve kadınlar da birbirlerindendir: Kötülüğü emreder, iyiliğe engel olurlar; elleri de sıkıdır; Allah'ı unuttular, bu yüzden Allah da onları unuttu. Doğrusu ikiyüzlüler fasıktırlar."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "009/067",
            "text": "The hypocrite men and hypocrite women are of one another. They enjoin what is wrong and forbid what is right and close their hands. They have forgotten Allah, so He has forgotten them [accordingly]. Indeed, the hypocrites - it is they who are the defiantly disobedient."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "009/067",
            "text": "The hypocrites, be they men or women, are all alike. They enjoin what is evil, and forbid what is good, and withhold their hands from doing good. They forgot Allah, so Allah also forgot them. Surely the hypocrites are wicked."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Tevbe",
      "ayah_number": 67,
      "ayah_end_number": 67,
      "text_ar": "ٱلْمُنَـٰفِقُونَ وَٱلْمُنَـٰفِقَـٰتُ بَعْضُهُم مِّنۢ بَعْضٍ ۚ يَأْمُرُونَ بِٱلْمُنكَرِ وَيَنْهَوْنَ عَنِ ٱلْمَعْرُوفِ وَيَقْبِضُونَ أَيْدِيَهُمْ ۚ نَسُوا۟ ٱللَّهَ فَنَسِيَهُمْ ۗ إِنَّ ٱلْمُنَـٰفِقِينَ هُمُ ٱلْفَـٰسِقُونَ",
      "text_tr": "Münafık erkekler ve münafık kadınlar, bazısı bazısındandır; kötülüğü emrederler, iyilikten alıkoyarlar, ellerini sımsıkı tutarlar. Onlar Allah'ı unuttular; O da onları unuttu. Şüphesiz, münafıklar fıska sapanlardır.",
      "text_en": "The hypocrite men and hypocrite women are of one another. They enjoin what is wrong and forbid what is right and close their hands. They have forgotten Allah, so He has forgotten them [accordingly]. Indeed, the hypocrites - it is they who are the defiantly disobedient.",
