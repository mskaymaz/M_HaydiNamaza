      "sourceRefGroups": [
        "079/040-041"
      ],
      "ayahs": [
        {
          "ref": "079/040",
          "surah": 79,
          "ayah": 40,
          "arabic": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "079/040",
            "text": "Kim Rabbinin makamından korkar ve nefsi heva (istek ve tutkular) dan sakındırırsa,"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "079/040",
            "text": "Ama kim Rabbinin azametinden korkup da kendini kötülükten alıkoymuşsa, varacağı yer şüphesiz cennettir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "079/040",
            "text": "But as for he who feared the position of his Lord and prevented the soul from [unlawful] inclination,"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "079/040",
            "text": "But he who feared to stand before his Lord, and restrained himself from evil desires,"
          }
        }
      ],
      "status": "approved",
