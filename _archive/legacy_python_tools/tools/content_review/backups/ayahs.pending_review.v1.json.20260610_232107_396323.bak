      "input": {
        "sira": 967,
        "ref": "032/018",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 63,
        "input_status": "ok",
        "input_source_ref_groups": "032/018"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "032/018"
      ],
      "ayahs": [
        {
          "ref": "032/018",
          "surah": 32,
          "ayah": 18,
          "arabic": "أَفَمَن كَانَ مُؤْمِنًا كَمَن كَانَ فَاسِقًا ۚ لَّا يَسْتَوُۥنَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "032/018",
            "text": "Öyleyse, iman eden kimse, fasık olan gibi olur mu? Bunlar eşit olmazlar."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "032/018",
            "text": "İnanan kimse yoldan çıkmış kimseye benzer mi? Bunlar bir olamazlar."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "032/018",
            "text": "Then is one who was a believer like one who was defiantly disobedient? They are not equal."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "032/018",
            "text": "Would a true believer be like him who was an evil-doer? Surely they are not equal."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
