      ],
      "ayahs": [
        {
          "ref": "043/043",
          "surah": 43,
          "ayah": 43,
          "arabic": "فَٱسْتَمْسِكْ بِٱلَّذِىٓ أُوحِىَ إِلَيْكَ ۖ إِنَّكَ عَلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "043/043",
            "text": "Şu halde, sana vahyedilene sımsıkı-tutun; çünkü sen dosdoğru bir yol üzerindesin."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "043/043",
            "text": "Sana vahyolunana sarıl, sen, şüphesiz doğru yol üzerindesin."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "043/043",
            "text": "So adhere to that which is revealed to you. Indeed, you are on a straight path."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "043/043",
            "text": "So hold fast to what has been revealed to you. Surely you are on the Straight Way."
          }
        }
      ],
