          "ref": "027/051",
          "surah": 27,
          "ayah": 51,
          "arabic": "فَٱنظُرْ كَيْفَ كَانَ عَـٰقِبَةُ مَكْرِهِمْ أَنَّا دَمَّرْنَـٰهُمْ وَقَوْمَهُمْ أَجْمَعِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "027/051",
            "text": "Artık sen, onların kurdukları hileli-düzenin uğradığı sona bir bak; Biz, onları ve kavimlerini topluca yerle bir ettik."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "027/051",
            "text": "Hilelerinin sonunun nasıl olduğuna bir bak! Biz onları ve milletlerini, hepsini, yerle bir ettik."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "027/051",
            "text": "Then look how was the outcome of their plan - that We destroyed them and their people, all."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "027/051",
            "text": "So see what was the outcome of the plan they made: We utterly destroyed them and their people, all of them."
          }
        }
      ],
