          "surah": 82,
          "ayah": 18,
          "arabic": "ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "082/018",
            "text": "Ve yine din gününü sana bildiren şey nedir?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "082/018",
            "text": "Evet, din gününün ne olduğunu nereden bileceksin?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "082/018",
            "text": "Then, what can make you know what is the Day of Recompense?"
          },
