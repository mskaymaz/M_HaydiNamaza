      "sourceRefGroups": [
        "003/057"
      ],
      "ayahs": [
        {
          "ref": "003/057",
          "surah": 3,
          "ayah": 57,
          "arabic": "وَأَمَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ فَيُوَفِّيهِمْ أُجُورَهُمْ ۗ وَٱللَّهُ لَا يُحِبُّ ٱلظَّـٰلِمِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "003/057",
            "text": "\"İman edip salih amellerde bulunanların ecirleri eksiksiz ödenecektir. Allah, zalim olanları sevmez.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "003/057",
            "text": "İnanıp yararlı iş işleyenlerin ecirleri ise tastamam verilecektir. Allah zalimleri sevmez."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "003/057",
            "text": "But as for those who believed and did righteous deeds, He will give them in full their rewards, and Allah does not like the wrongdoers."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "003/057",
            "text": "But those who believe and do righteous deeds, He will reward them in full. Allah does not love the unjust.'"
          }
        }
      ],
