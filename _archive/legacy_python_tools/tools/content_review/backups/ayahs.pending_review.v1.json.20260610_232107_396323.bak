    {
      "ref": "009/066",
      "id": "009/066",
      "surah": 9,
      "ayahStart": 66,
      "ayahEnd": 66,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 544,
        "ref": "009/066",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 207,
        "input_status": "ok",
        "input_source_ref_groups": "009/066"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "009/066"
      ],
      "ayahs": [
        {
          "ref": "009/066",
          "surah": 9,
          "ayah": 66,
          "arabic": "لَا تَعْتَذِرُوا۟ قَدْ كَفَرْتُم بَعْدَ إِيمَـٰنِكُمْ ۚ إِن نَّعْفُ عَن طَآئِفَةٍ مِّنكُمْ نُعَذِّبْ طَآئِفَةًۢ بِأَنَّهُمْ كَانُوا۟ مُجْرِمِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "009/066",
            "text": "Özür belirtmeyiniz. Siz, imanınızdan sonra inkara saptınız. Sizden bir topluluğu bağışlasak da, bir topluluğunuzu gerçekten suçlu-günahkar olmaları nedeniyle azaplandıracağız."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "009/066",
            "text": "Özür beyan etmeyin, inandıktan sonra inkar ettiniz. İçinizden bir topluluğu affetsek bile, suçlarından ötürü bir topluluğa da azab ederiz."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "009/066",
            "text": "Make no excuse; you have disbelieved after your belief. If We pardon one faction of you - We will punish another faction because they were criminals."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "009/066",
            "text": "Now, make no excuses. The truth is, you have fallen into unbelief after having believed. Even if We were to forgive some of you, We will surely chastise others because they are guilty."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Tevbe",
      "ayah_number": 66,
      "ayah_end_number": 66,
      "text_ar": "لَا تَعْتَذِرُوا۟ قَدْ كَفَرْتُم بَعْدَ إِيمَـٰنِكُمْ ۚ إِن نَّعْفُ عَن طَآئِفَةٍ مِّنكُمْ نُعَذِّبْ طَآئِفَةًۢ بِأَنَّهُمْ كَانُوا۟ مُجْرِمِينَ",
      "text_tr": "Özür belirtmeyiniz. Siz, imanınızdan sonra inkara saptınız. Sizden bir topluluğu bağışlasak da, bir topluluğunuzu gerçekten suçlu-günahkar olmaları nedeniyle azaplandıracağız.",
