    {
      "ref": "045/035",
      "id": "045/035",
      "surah": 45,
      "ayahStart": 35,
      "ayahEnd": 35,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 1133,
        "ref": "045/035",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 196,
        "input_status": "ok",
        "input_source_ref_groups": "045/035"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "045/035"
      ],
      "ayahs": [
        {
          "ref": "045/035",
          "surah": 45,
          "ayah": 35,
          "arabic": "ذَٰلِكُم بِأَنَّكُمُ ٱتَّخَذْتُمْ ءَايَـٰتِ ٱللَّهِ هُزُوًا وَغَرَّتْكُمُ ٱلْحَيَوٰةُ ٱلدُّنْيَا ۚ فَٱلْيَوْمَ لَا يُخْرَجُونَ مِنْهَا وَلَا هُمْ يُسْتَعْتَبُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "045/035",
            "text": "\"Bunun nedeni şudur: Çünkü siz Allah'ın ayetlerini alay konusu edindiniz; dünya hayatı da sizi aldattı.\" Böylece ne ordan (ateşten) çıkarılırlar, ne (Allah'tan) hoşnutluk dilekleri kabul edilir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "045/035",
            "text": "\"Bu, Allah'ın ayetlerini alaya almanızdan ve dünya hayatının sizi aldatmış olmasından ötürüdür.\" O gün, ne oradan çıkarılırlar ve ne de özürleri dinlenir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "045/035",
            "text": "That is because you took the verses of Allah in ridicule, and worldly life deluded you.\" So that Day they will not be removed from it, nor will they be asked to appease [Allah]."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "045/035",
            "text": "You reached this end because you made Allah's Signs an object of jest and the life of the world deluded you.” So they shall not be taken out of the Fire nor shall they be asked to make amends (and thus please their Lord)."
          }
        }
      ],
      "status": "approved",
