    {
      "ref": "006/119",
      "id": "006/119",
      "surah": 6,
      "ayahStart": 119,
      "ayahEnd": 119,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 412,
        "ref": "006/119",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 290,
        "input_status": "ok",
        "input_source_ref_groups": "006/119"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "006/119"
      ],
      "ayahs": [
        {
          "ref": "006/119",
          "surah": 6,
          "ayah": 119,
          "arabic": "وَمَا لَكُمْ أَلَّا تَأْكُلُوا۟ مِمَّا ذُكِرَ ٱسْمُ ٱللَّهِ عَلَيْهِ وَقَدْ فَصَّلَ لَكُم مَّا حَرَّمَ عَلَيْكُمْ إِلَّا مَا ٱضْطُرِرْتُمْ إِلَيْهِ ۗ وَإِنَّ كَثِيرًا لَّيُضِلُّونَ بِأَهْوَآئِهِم بِغَيْرِ عِلْمٍ ۗ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِٱلْمُعْتَدِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "006/119",
            "text": "Ne oluyor ki size, kaçınılmaz bir ihtiyaçla karşı karşıya kalmanız dışında, O, size haram kıldıklarını ayrı ayrı açıklamışken, üzerinde Allah'ın ismi anılan şeyleri yemiyorsunuz? Gerçekten çoğu, bir ilim olmaksızın kendi heva (istek ve tutku)larıyla (kimilerini) saptırıyorlar. Şüphesiz, senin Rabbin haddi aşanları en iyi bilendir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "006/119",
            "text": "Size ne oluyor ki, Allah size darda kalmanızın dışında, haram olanları genişçe anlatmışken adının üzerine anıldığı şeyden yemiyorsunuz? Doğrusu çoğunluk, heva ve heveslerine uyarak, bilmeden sapıtıyorlar. Aşırı gidenleri en iyi bilen Rabbindir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "006/119",
            "text": "And why should you not eat of that upon which the name of Allah has been mentioned while He has explained in detail to you what He has forbidden you, excepting that to which you are compelled. And indeed do many lead [others] astray through their [own] inclinations without knowledge. Indeed, your Lord - He is most knowing of the transgressors."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "006/119",
            "text": "And how is it that you do not eat of that over which Allah's name has been pronounced even though He has clearly spelled out to you what He has forbidden you unless you are constrained to it? Many indeed say misleading things without knowledge, driven merely by their lowly desires. But your Lord knows well the transgressors."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Enam",
      "ayah_number": 119,
      "ayah_end_number": 119,
      "text_ar": "وَمَا لَكُمْ أَلَّا تَأْكُلُوا۟ مِمَّا ذُكِرَ ٱسْمُ ٱللَّهِ عَلَيْهِ وَقَدْ فَصَّلَ لَكُم مَّا حَرَّمَ عَلَيْكُمْ إِلَّا مَا ٱضْطُرِرْتُمْ إِلَيْهِ ۗ وَإِنَّ كَثِيرًا لَّيُضِلُّونَ بِأَهْوَآئِهِم بِغَيْرِ عِلْمٍ ۗ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِٱلْمُعْتَدِينَ",
      "text_tr": "Ne oluyor ki size, kaçınılmaz bir ihtiyaçla karşı karşıya kalmanız dışında, O, size haram kıldıklarını ayrı ayrı açıklamışken, üzerinde Allah'ın ismi anılan şeyleri yemiyorsunuz? Gerçekten çoğu, bir ilim olmaksızın kendi heva (istek ve tutku)larıyla (kimilerini) saptırıyorlar. Şüphesiz, senin Rabbin haddi aşanları en iyi bilendir.",
      "text_en": "And why should you not eat of that upon which the name of Allah has been mentioned while He has explained in detail to you what He has forbidden you, excepting that to which you are compelled. And indeed do many lead [others] astray through their [own] inclinations without knowledge. Indeed, your Lord - He is most knowing of the transgressors.",
      "priority": 1,
      "notes": "bulk approved from local Tanzil source",
