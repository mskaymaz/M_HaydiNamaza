      "input": {
        "sira": 848,
        "ref": "025/043",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 85,
        "input_status": "ok",
        "input_source_ref_groups": "025/043"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "025/043"
      ],
      "ayahs": [
        {
          "ref": "025/043",
          "surah": 25,
          "ayah": 43,
          "arabic": "أَرَءَيْتَ مَنِ ٱتَّخَذَ إِلَـٰهَهُۥ هَوَىٰهُ أَفَأَنتَ تَكُونُ عَلَيْهِ وَكِيلًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "025/043",
            "text": "Kendi istek ve tutkularını (hevasını) ilah edineni gördün mü? Şimdi ona karşı sen mi vekil olacaksın?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "025/043",
            "text": "Hevesini kendine tanrı edineni gördün mü? Ona sen mi vekil olacaksın?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "025/043",
            "text": "Have you seen the one who takes as his god his own desire? Then would you be responsible for him?"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "025/043",
            "text": "Have you ever considered the case of the person who has made his lust his god? Can you take the responsibility of guiding such a one aright?"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
