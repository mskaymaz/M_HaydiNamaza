      "sourceRefGroups": [
        "019/090-091"
      ],
      "ayahs": [
        {
          "ref": "019/090",
          "surah": 19,
          "ayah": 90,
          "arabic": "تَكَادُ ٱلسَّمَـٰوَٰتُ يَتَفَطَّرْنَ مِنْهُ وَتَنشَقُّ ٱلْأَرْضُ وَتَخِرُّ ٱلْجِبَالُ هَدًّا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "019/090",
            "text": "Neredeyse bundan dolayı, gökler paramparça olacak, yer çatlayacak ve dağlar yıkılıp göçüverecekti."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "019/090",
            "text": "Rahman'a çocuk isnat etmelerinden ötürü neredeyse gökler parçalanacak, yer yarılacak, dağlar göçecekti."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "019/090",
            "text": "The heavens almost rupture therefrom and the earth splits open and the mountains collapse in devastation"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "019/090",
            "text": "It is such a monstrosity that heavens might well-nigh burst forth at it, the earth might be cleaved, and the mountains fall"
          }
        }
      ],
      "status": "approved",
