      "ayahs": [
        {
          "ref": "070/004",
          "surah": 70,
          "ayah": 4,
          "arabic": "تَعْرُجُ ٱلْمَلَـٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "070/004",
            "text": "Melekler ve Ruh (Cebrail), ona, süresi elli bin yıl olan bir günde çıkabilmektedir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "070/004",
            "text": "Melekler ve Cebrail o derecelere, miktarı elli bin yıl olan bir günde yükselirler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "070/004",
            "text": "The angels and the Spirit will ascend to Him during a Day the extent of which is fifty thousand years."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "070/004",
            "text": "by which the angels and the Spirit ascend to Him in one Day the duration of which is fifty thousand years."
          }
        }
      ],
