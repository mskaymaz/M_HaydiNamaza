    {
      "ref": "017/097",
      "id": "017/097",
      "surah": 17,
      "ayahStart": 97,
      "ayahEnd": 97,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 719,
        "ref": "017/097",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 296,
        "input_status": "ok",
        "input_source_ref_groups": "017/097"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "017/097"
      ],
      "ayahs": [
        {
          "ref": "017/097",
          "surah": 17,
          "ayah": 97,
          "arabic": "وَمَن يَهْدِ ٱللَّهُ فَهُوَ ٱلْمُهْتَدِ ۖ وَمَن يُضْلِلْ فَلَن تَجِدَ لَهُمْ أَوْلِيَآءَ مِن دُونِهِۦ ۖ وَنَحْشُرُهُمْ يَوْمَ ٱلْقِيَـٰمَةِ عَلَىٰ وُجُوهِهِمْ عُمْيًا وَبُكْمًا وَصُمًّا ۖ مَّأْوَىٰهُمْ جَهَنَّمُ ۖ كُلَّمَا خَبَتْ زِدْنَـٰهُمْ سَعِيرًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "017/097",
            "text": "Allah, kimi hidayete erdirirse, işte o, hidayet bulmuştur, kimi saptırırsa onlar için O'nun dışında asla veliler bulamazsın. Kıyamet günü, Biz onları yüzükoyun körler, dilsizler ve sağırlar olarak haşrederiz. Onların barınma yerleri cehennemdir; ateşi sükun buldukça, çılgın alevini onlara arttırırız."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "017/097",
            "text": "Allah'ın doğru yola eriştirdiği kimse hak yoldadır. Kimleri de saptırırsa, artık onlar için Allah'dan başka dostlar bulamazsın. Biz onları kıyamet günü yüzükoyun, körler, dilsizler ve sağırlar olarak haşrederiz. Varacakları yer cehennemdir. Onun ateşi ne zaman sönmeye yüz tutsa hemen alevini artırırız."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "017/097",
            "text": "And whoever Allah guides - he is the [rightly] guided; and whoever He sends astray - you will never find for them protectors besides Him, and We will gather them on the Day of Resurrection [fallen] on their faces - blind, dumb and deaf. Their refuge is Hell; every time it subsides We increase them in blazing fire."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "017/097",
            "text": "Whomsoever Allah guides is rightly guided; and whomsoever Allah lets go astray, you shall find none - apart from Him - who could protect him. We shall muster them all on the Day of Resurrection, on their faces - blind and dumb and deaf. Hell shall be their refuge. Every time its Fire subsides, We will intensify for them its flame."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Isra",
      "ayah_number": 97,
      "ayah_end_number": 97,
      "text_ar": "وَمَن يَهْدِ ٱللَّهُ فَهُوَ ٱلْمُهْتَدِ ۖ وَمَن يُضْلِلْ فَلَن تَجِدَ لَهُمْ أَوْلِيَآءَ مِن دُونِهِۦ ۖ وَنَحْشُرُهُمْ يَوْمَ ٱلْقِيَـٰمَةِ عَلَىٰ وُجُوهِهِمْ عُمْيًا وَبُكْمًا وَصُمًّا ۖ مَّأْوَىٰهُمْ جَهَنَّمُ ۖ كُلَّمَا خَبَتْ زِدْنَـٰهُمْ سَعِيرًا",
      "text_tr": "Allah, kimi hidayete erdirirse, işte o, hidayet bulmuştur, kimi saptırırsa onlar için O'nun dışında asla veliler bulamazsın. Kıyamet günü, Biz onları yüzükoyun körler, dilsizler ve sağırlar olarak haşrederiz. Onların barınma yerleri cehennemdir; ateşi sükun buldukça, çılgın alevini onlara arttırırız.",
      "text_en": "And whoever Allah guides - he is the [rightly] guided; and whoever He sends astray - you will never find for them protectors besides Him, and We will gather them on the Day of Resurrection [fallen] on their faces - blind, dumb and deaf. Their refuge is Hell; every time it subsides We increase them in blazing fire.",
      "priority": 1,
      "notes": "bulk approved from local Tanzil source",
      "createdAt": "2026-06-09T08:52:44+00:00",
      "updatedAt": "2026-06-09T08:52:44+00:00",
      "approvedAt": "2026-06-09T08:52:44+00:00",
