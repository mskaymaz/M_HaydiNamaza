    {
      "ref": "040/020",
      "id": "040/020",
      "surah": 40,
      "ayahStart": 20,
      "ayahEnd": 20,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 1072,
        "ref": "040/020",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 146,
        "input_status": "ok",
        "input_source_ref_groups": "040/020"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "040/020"
      ],
      "ayahs": [
        {
          "ref": "040/020",
          "surah": 40,
          "ayah": 20,
          "arabic": "وَٱللَّهُ يَقْضِى بِٱلْحَقِّ ۖ وَٱلَّذِينَ يَدْعُونَ مِن دُونِهِۦ لَا يَقْضُونَ بِشَىْءٍ ۗ إِنَّ ٱللَّهَ هُوَ ٱلسَّمِيعُ ٱلْبَصِيرُ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "040/020",
            "text": "Allah hak ile hükmeder. Oysa O'nu bırakıp taptıkları hiçbir şeye hükmedemezler. Şüphesiz Allah, işitendir, görendir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "040/020",
            "text": "Allah, gerçekle hükmeder. O'nu bırakıp da yalvardıkları putlar bir şeye hüküm veremez. Şüphesiz Allah işitir ve görür."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "040/020",
            "text": "And Allah judges with truth, while those they invoke besides Him judge not with anything. Indeed, Allah - He is the Hearing, the Seeing."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "040/020",
            "text": "Allah will judge with justice, whereas those whom they call upon beside Him cannot judge at all. Surely Allah -- and He alone -- is All- Hearing, All-Seeing."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Mumin",
      "ayah_number": 20,
      "ayah_end_number": 20,
