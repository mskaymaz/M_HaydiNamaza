      "ayahEnd": 14,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 1246,
        "ref": "058/014",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 158,
        "input_status": "ok",
        "input_source_ref_groups": "058/014"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "058/014"
      ],
      "ayahs": [
        {
          "ref": "058/014",
          "surah": 58,
          "ayah": 14,
          "arabic": "أَلَمْ تَرَ إِلَى ٱلَّذِينَ تَوَلَّوْا۟ قَوْمًا غَضِبَ ٱللَّهُ عَلَيْهِم مَّا هُم مِّنكُمْ وَلَا مِنْهُمْ وَيَحْلِفُونَ عَلَى ٱلْكَذِبِ وَهُمْ يَعْلَمُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "058/014",
            "text": "Allah'ın kendilerine karşı gazablandığı bir kavmi veli (dost ve müttefik) edinenleri görmedin mi? Onlar, ne sizdendirler, ne onlardan. Kendileri de (açıkça gerçeği) bildikleri halde, yalan üzere yemin ediyorlar."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "058/014",
            "text": "Allah'ın gazabettiği milleti dost edinen münafıkları görmedin mi? Onlar ne sizdendir ne de onlardan, bile bile, yalan yere yemin etmektedirler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "058/014",
            "text": "Have you not considered those who make allies of a people with whom Allah has become angry? They are neither of you nor of them, and they swear to untruth while they know [they are lying]."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "058/014",
            "text": "Do you not see those who took for friends a people whom Allah is wroth with? They neither belong to you nor you to them. They swear to a falsehood, and they do so knowingly."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
