        "026/089"
      ],
      "ayahs": [
        {
          "ref": "026/082",
          "surah": 26,
          "ayah": 82,
          "arabic": "وَٱلَّذِىٓ أَطْمَعُ أَن يَغْفِرَ لِى خَطِيٓـَٔتِى يَوْمَ ٱلدِّينِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "026/082",
            "text": "\"Din (ceza) günü hatalarımı bağışlayacağını umduğum da O'dur;\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "026/082",
            "text": "İbrahim: \"Eski atalarınızın ve sizin nelere taptıklarınızı görüyor musunuz? Doğrusu onlar benim düşmanımdır. Dostum ancak Alemlerin Rabbidir. Beni yaratan da, doğru yola eriştiren de O'dur. Beni yediren de, içiren de O'dur. Hasta olduğumda bana O şifa verir. Beni öldürecek, sonra da diriltecek O'dur. Ahiret gününde yanılmalarımı bana bağışlamasını umduğum O'dur. Rabbim! Bana hikmet ver ve beni iyiler arasına kat."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "026/082",
            "text": "And who I aspire that He will forgive me my sin on the Day of Recompense.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "026/082",
            "text": "Who, I hope, will forgive me my sins on the Day of Judgement.\""
          }
        },
        {
          "ref": "026/083",
          "surah": 26,
          "ayah": 83,
          "arabic": "رَبِّ هَبْ لِى حُكْمًا وَأَلْحِقْنِى بِٱلصَّـٰلِحِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "026/083",
            "text": "\"Rabbim, bana hüküm (ve hikmet) bağışla ve beni salih olanlara kat;\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "026/083",
            "text": "İbrahim: \"Eski atalarınızın ve sizin nelere taptıklarınızı görüyor musunuz? Doğrusu onlar benim düşmanımdır. Dostum ancak Alemlerin Rabbidir. Beni yaratan da, doğru yola eriştiren de O'dur. Beni yediren de, içiren de O'dur. Hasta olduğumda bana O şifa verir. Beni öldürecek, sonra da diriltecek O'dur. Ahiret gününde yanılmalarımı bana bağışlamasını umduğum O'dur. Rabbim! Bana hikmet ver ve beni iyiler arasına kat."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "026/083",
            "text": "[And he said], \"My Lord, grant me authority and join me with the righteous."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "026/083",
            "text": "(And then Abraham prayed): \"My Lord, endow me with knowledge and wisdom and join me with the righteous,"
          }
        },
        {
          "ref": "026/084",
          "surah": 26,
          "ayah": 84,
          "arabic": "وَٱجْعَل لِّى لِسَانَ صِدْقٍ فِى ٱلْءَاخِرِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "026/084",
            "text": "\"Sonra gelecekler arasında bana bir doğruluk dili (lisan-ı sıdk) ver.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "026/084",
            "text": "Sonrakilerin beni güzel şekilde anmalarını sağla. Beni nimet cennetine varis olanlardan kıl. Babamı da bağışla, o şüphesiz sapıklardandır. İnsanların diriltileceği gün, Allah'a temiz bir kalble gelenden başka kimseye malın ve oğulların fayda vermeyeceği gün, beni rezil etme\" demişti."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "026/084",
            "text": "And grant me a reputation of honor among later generations."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "026/084",
            "text": "and grant me an honourable reputation among posterity,"
          }
        },
        {
          "ref": "026/085",
          "surah": 26,
          "ayah": 85,
          "arabic": "وَٱجْعَلْنِى مِن وَرَثَةِ جَنَّةِ ٱلنَّعِيمِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "026/085",
            "text": "\"Beni nimetlerle-donatılmış cennetin mirasçılarından kıl,\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "026/085",
            "text": "Sonrakilerin beni güzel şekilde anmalarını sağla. Beni nimet cennetine varis olanlardan kıl. Babamı da bağışla, o şüphesiz sapıklardandır. İnsanların diriltileceği gün, Allah'a temiz bir kalble gelenden başka kimseye malın ve oğulların fayda vermeyeceği gün, beni rezil etme\" demişti."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "026/085",
            "text": "And place me among the inheritors of the Garden of Pleasure."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "026/085",
            "text": "and make me of those who will inherit the Garden of Bliss,"
          }
        },
        {
          "ref": "026/086",
          "surah": 26,
          "ayah": 86,
          "arabic": "وَٱغْفِرْ لِأَبِىٓ إِنَّهُۥ كَانَ مِنَ ٱلضَّآلِّينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "026/086",
            "text": "\"Babamı da bağışla, çünkü o şaşırıp sapanlardandır.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "026/086",
            "text": "Sonrakilerin beni güzel şekilde anmalarını sağla. Beni nimet cennetine varis olanlardan kıl. Babamı da bağışla, o şüphesiz sapıklardandır. İnsanların diriltileceği gün, Allah'a temiz bir kalble gelenden başka kimseye malın ve oğulların fayda vermeyeceği gün, beni rezil etme\" demişti."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "026/086",
            "text": "And forgive my father. Indeed, he has been of those astray."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "026/086",
            "text": "and forgive my father for he is among those who strayed,"
          }
        },
        {
          "ref": "026/087",
          "surah": 26,
          "ayah": 87,
          "arabic": "وَلَا تُخْزِنِى يَوْمَ يُبْعَثُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "026/087",
            "text": "\"Ve beni (insanların) diriltilecekleri gün küçük düşürme,\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "026/087",
            "text": "Sonrakilerin beni güzel şekilde anmalarını sağla. Beni nimet cennetine varis olanlardan kıl. Babamı da bağışla, o şüphesiz sapıklardandır. İnsanların diriltileceği gün, Allah'a temiz bir kalble gelenden başka kimseye malın ve oğulların fayda vermeyeceği gün, beni rezil etme\" demişti."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "026/087",
            "text": "And do not disgrace me on the Day they are [all] resurrected -"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "026/087",
            "text": "and disgrace me not on the Day when people will be raised to life,"
          }
        },
        {
          "ref": "026/088",
          "surah": 26,
          "ayah": 88,
          "arabic": "يَوْمَ لَا يَنفَعُ مَالٌ وَلَا بَنُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "026/088",
            "text": "'Malın da, çocukların da bir yarar sağlayamadığı günde.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "026/088",
            "text": "Sonrakilerin beni güzel şekilde anmalarını sağla. Beni nimet cennetine varis olanlardan kıl. Babamı da bağışla, o şüphesiz sapıklardandır. İnsanların diriltileceği gün, Allah'a temiz bir kalble gelenden başka kimseye malın ve oğulların fayda vermeyeceği gün, beni rezil etme\" demişti."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "026/088",
            "text": "The Day when there will not benefit [anyone] wealth or children"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "026/088",
            "text": "the Day when nothing will avail, neither wealth nor offspring,"
          }
        },
        {
          "ref": "026/089",
          "surah": 26,
          "ayah": 89,
          "arabic": "إِلَّا مَنْ أَتَى ٱللَّهَ بِقَلْبٍ سَلِيمٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "026/089",
            "text": "\"Ancak Allah'a selim bir kalp ile gelenler başka.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "026/089",
            "text": "Sonrakilerin beni güzel şekilde anmalarını sağla. Beni nimet cennetine varis olanlardan kıl. Babamı da bağışla, o şüphesiz sapıklardandır. İnsanların diriltileceği gün, Allah'a temiz bir kalble gelenden başka kimseye malın ve oğulların fayda vermeyeceği gün, beni rezil etme\" demişti."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "026/089",
            "text": "But only one who comes to Allah with a sound heart.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "026/089",
            "text": "but only he that brings to Allah a sound heart will (attain to success).\""
