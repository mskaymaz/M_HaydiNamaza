      ],
      "ayahs": [
        {
          "ref": "044/032",
          "surah": 44,
          "ayah": 32,
          "arabic": "وَلَقَدِ ٱخْتَرْنَـٰهُمْ عَلَىٰ عِلْمٍ عَلَى ٱلْعَـٰلَمِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "044/032",
            "text": "Andolsun, Biz onları bir ilim üzere alemlere üstün kıldık."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "044/032",
            "text": "And olsun ki, onların durumunu bilerek dünyaların üzerinde seçkin kıldık."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "044/032",
            "text": "And We certainly chose them by knowledge over [all] the worlds."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "044/032",
            "text": "We knowingly exalted them (i.e., the Children of Israel) above other peoples of the world"
          }
        }
      ],
      "status": "approved",
