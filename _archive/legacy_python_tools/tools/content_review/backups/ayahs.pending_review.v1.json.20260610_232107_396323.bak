          "ref": "068/036",
          "surah": 68,
          "ayah": 36,
          "arabic": "مَا لَكُمْ كَيْفَ تَحْكُمُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "068/036",
            "text": "Size ne oluyor? Nasıl hüküm veriyorsunuz?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "068/036",
            "text": "Ne oluyorsunuz? Ne biçim hükmediyorsunuz?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "068/036",
            "text": "What is [the matter] with you? How do you judge?"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "068/036",
            "text": "What is the matter with you? How ill do you judge!"
          }
        }
      ],
