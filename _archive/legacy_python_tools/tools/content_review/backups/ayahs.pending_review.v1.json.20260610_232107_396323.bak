      "input": {
        "sira": 1281,
        "ref": "063/002",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 115,
        "input_status": "ok",
        "input_source_ref_groups": "063/002"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "063/002"
      ],
      "ayahs": [
        {
          "ref": "063/002",
          "surah": 63,
          "ayah": 2,
          "arabic": "ٱتَّخَذُوٓا۟ أَيْمَـٰنَهُمْ جُنَّةً فَصَدُّوا۟ عَن سَبِيلِ ٱللَّهِ ۚ إِنَّهُمْ سَآءَ مَا كَانُوا۟ يَعْمَلُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "063/002",
            "text": "Onlar, yeminlerini bir siper edinip Allah'ın yolundan alıkoydular. Doğrusu ne kötü şey yapıyorlar."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "063/002",
            "text": "Onlar, yeminlerini kalkan edinerek Allah'ın yolundan alıkoyarlar. İşledikleri işler gerçekten ne kötüdür!"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "063/002",
            "text": "They have taken their oaths as a cover, so they averted [people] from the way of Allah. Indeed, it was evil that they were doing."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "063/002",
            "text": "They shelter behind their oath, and thus hinder their own selves and others from the Path of Allah. Evil indeed is what they do."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
