    {
      "ref": "010/011",
      "id": "010/011",
      "surah": 10,
      "ayahStart": 11,
      "ayahEnd": 11,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 574,
        "ref": "010/011",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 224,
        "input_status": "ok",
        "input_source_ref_groups": "010/011"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "010/011"
      ],
      "ayahs": [
        {
          "ref": "010/011",
          "surah": 10,
          "ayah": 11,
          "arabic": "وَلَوْ يُعَجِّلُ ٱللَّهُ لِلنَّاسِ ٱلشَّرَّ ٱسْتِعْجَالَهُم بِٱلْخَيْرِ لَقُضِىَ إِلَيْهِمْ أَجَلُهُمْ ۖ فَنَذَرُ ٱلَّذِينَ لَا يَرْجُونَ لِقَآءَنَا فِى طُغْيَـٰنِهِمْ يَعْمَهُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "010/011",
            "text": "Eğer Allah, onların hayra ulaşmak için çarçabuk davrandıkları gibi, insanlara şerri de çabuklaştırsaydı, mutlaka ecellerine hüküm verilirdi. İşte Bize kavuşmayı ummayanları Biz böylece taşkınlıkları içinde şaşkınca dolaşır bir durumda bırakırız."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "010/011",
            "text": "İyiliği acele isteyen kimselere Allah fenalığı da çarçabuk verseydi, süreleri hemen bitmiş olurdu. Bizimle karşılaşmayı ummayanları, azgınlıkları içinde bocalayıp dururlarken bırakırız."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "010/011",
            "text": "And if Allah was to hasten for the people the evil [they invoke] as He hastens for them the good, their term would have been ended for them. But We leave the ones who do not expect the meeting with Us, in their transgression, wandering blindly"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "010/011",
            "text": "Were Allah to hasten to bring upon men (the consequence of) evil in the way men hasten in seeking the wealth of this world, their term would have long since expired. (But that is not Our way.) So We leave alone those who do not expect to meet Us that they may blindly stumble in their transgression."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
