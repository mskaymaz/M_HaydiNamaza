      "ayahs": [
        {
          "ref": "039/002",
          "surah": 39,
          "ayah": 2,
          "arabic": "إِنَّآ أَنزَلْنَآ إِلَيْكَ ٱلْكِتَـٰبَ بِٱلْحَقِّ فَٱعْبُدِ ٱللَّهَ مُخْلِصًا لَّهُ ٱلدِّينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "039/002",
            "text": "Şüphesiz, sana bu Kitab'ı hak ile indirdik; öyleyse sen de dini yalnızca O'na halis kılarak Allah'a ibadet et."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "039/002",
            "text": "Biz sana Kitap'ı gerçekle indirdik. Öyle ise dini Allah için halis kılarak O'na kulluk et."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "039/002",
            "text": "Indeed, We have sent down to you the Book, [O Muhammad], in truth. So worship Allah, [being] sincere to Him in religion."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "039/002",
            "text": "(O Prophet), it is We Who have revealed this Book to you with Truth. So serve only Allah, consecrating your devotion to Him."
          }
        },
        {
          "ref": "039/003",
          "surah": 39,
