    {
      "ref": "033/057",
      "id": "033/057",
      "surah": 33,
      "ayahStart": 57,
      "ayahEnd": 57,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 990,
        "ref": "033/057",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 121,
        "input_status": "ok",
        "input_source_ref_groups": "033/057"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "033/057"
      ],
      "ayahs": [
        {
          "ref": "033/057",
          "surah": 33,
          "ayah": 57,
          "arabic": "إِنَّ ٱلَّذِينَ يُؤْذُونَ ٱللَّهَ وَرَسُولَهُۥ لَعَنَهُمُ ٱللَّهُ فِى ٱلدُّنْيَا وَٱلْءَاخِرَةِ وَأَعَدَّ لَهُمْ عَذَابًا مُّهِينًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "033/057",
            "text": "Gerçek şu ki, Allah'a ve elçisine eziyet edenler; Allah, onlara dünyada ve ahirette lanet etmiş ve onlar için aşağılatıcı bir azap hazırlanmıştır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "033/057",
            "text": "Allah'ı ve Peygamber'ini incitenlere, Allah dünyada da ahirette de lanet eder; onlara alçaltıcı bir azap hazırlar."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "033/057",
            "text": "Indeed, those who abuse Allah and His Messenger - Allah has cursed them in this world and the Hereafter and prepared for them a humiliating punishment."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "033/057",
            "text": "Verily those who cause annoyance to Allah and His Messenger - Allah has cursed them in this world and in the Hereafter and has prepared for them a humiliating chastisement."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Ahzab",
      "ayah_number": 57,
      "ayah_end_number": 57,
      "text_ar": "إِنَّ ٱلَّذِينَ يُؤْذُونَ ٱللَّهَ وَرَسُولَهُۥ لَعَنَهُمُ ٱللَّهُ فِى ٱلدُّنْيَا وَٱلْءَاخِرَةِ وَأَعَدَّ لَهُمْ عَذَابًا مُّهِينًا",
      "text_tr": "Gerçek şu ki, Allah'a ve elçisine eziyet edenler; Allah, onlara dünyada ve ahirette lanet etmiş ve onlar için aşağılatıcı bir azap hazırlanmıştır.",
      "text_en": "Indeed, those who abuse Allah and His Messenger - Allah has cursed them in this world and the Hereafter and prepared for them a humiliating punishment.",
