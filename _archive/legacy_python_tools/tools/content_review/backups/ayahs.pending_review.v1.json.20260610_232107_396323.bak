      },
      "sourceRefGroups": [
        "006/011"
      ],
      "ayahs": [
        {
          "ref": "006/011",
          "surah": 6,
          "ayah": 11,
          "arabic": "قُلْ سِيرُوا۟ فِى ٱلْأَرْضِ ثُمَّ ٱنظُرُوا۟ كَيْفَ كَانَ عَـٰقِبَةُ ٱلْمُكَذِّبِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "006/011",
            "text": "De ki: \"Yeryüzünde gezip dolaşın, sonra yalanlayanların sonu nasıl oldu, bir görün.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "006/011",
            "text": "De ki: \"Yeryüzünde gezip dolaşın, sonra da, yalanlayanların sonunun nasıl olduğuna bir bakın.\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "006/011",
            "text": "Say, \"Travel through the land; then observe how was the end of the deniers.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "006/011",
            "text": "Say: 'Go about journeying the earth, and behold the end of those who gave the lie (to the Truth).'"
          }
        }
      ],
      "status": "approved",
