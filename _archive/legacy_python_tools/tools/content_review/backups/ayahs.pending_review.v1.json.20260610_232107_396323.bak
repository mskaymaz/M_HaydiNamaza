      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "021/026"
      ],
      "ayahs": [
        {
          "ref": "021/026",
          "surah": 21,
          "ayah": 26,
          "arabic": "وَقَالُوا۟ ٱتَّخَذَ ٱلرَّحْمَـٰنُ وَلَدًا ۗ سُبْحَـٰنَهُۥ ۚ بَلْ عِبَادٌ مُّكْرَمُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "021/026",
            "text": "\"Rahman (olan Allah) çocuk edindi\" dediler. O, (bu yakıştırmadan) Yücedir. Hayır, onlar (melekler) ikrama layık görülmüş kullardır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "021/026",
            "text": "\"Rahman çocuk edindi\" dediler. Haşa; hayır, melekler şerefli kılınmış kullardır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "021/026",
            "text": "And they say, \"The Most Merciful has taken a son.\" Exalted is He! Rather, they are [but] honored servants."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "021/026",
            "text": "They say: \"The Most Compassionate Lord has taken to Himself a son.\" Glory be to Him! Those whom they so designate are only His honoured servants."
          }
        }
      ],
      "status": "approved",
