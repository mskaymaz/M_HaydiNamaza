    {
      "ref": "002/215",
      "id": "002/215",
      "surah": 2,
      "ayahStart": 215,
      "ayahEnd": 215,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 101,
        "ref": "002/215",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 219,
        "input_status": "ok",
        "input_source_ref_groups": "002/215"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "002/215"
      ],
      "ayahs": [
        {
          "ref": "002/215",
          "surah": 2,
          "ayah": 215,
          "arabic": "يَسْـَٔلُونَكَ مَاذَا يُنفِقُونَ ۖ قُلْ مَآ أَنفَقْتُم مِّنْ خَيْرٍ فَلِلْوَٰلِدَيْنِ وَٱلْأَقْرَبِينَ وَٱلْيَتَـٰمَىٰ وَٱلْمَسَـٰكِينِ وَٱبْنِ ٱلسَّبِيلِ ۗ وَمَا تَفْعَلُوا۟ مِنْ خَيْرٍ فَإِنَّ ٱللَّهَ بِهِۦ عَلِيمٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "002/215",
            "text": "Sana neyi infak edeceklerini sorarlar. De ki: \"Hayır olarak infak edeceğiniz şey, anne-babaya, yakınlara, yetimlere, yoksullara ve yolda kalmışadır. Hayır olarak her ne yaparsanız, Allah onu şüphesiz bilir.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "002/215",
            "text": "Sana, ne sarfedeceklerini sorarlar, de ki: \"Sarfedeceğiniz mal, ana baba, yakınlar, yetimler, düşkünler, yolcular içindir. Yaptığınız her iyiliği Allah şüphesiz bilir\"."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "002/215",
            "text": "They ask you, [O Muhammad], what they should spend. Say, \"Whatever you spend of good is [to be] for parents and relatives and orphans and the needy and the traveler. And whatever you do of good - indeed, Allah is Knowing of it.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "002/215",
            "text": "The people ask, \"What should we spend?\" Tell them, \"Whatever you spend, spend for your parents, your relatives, orphans, the needy and the wayfarer; and whatever good you do, Allah has knowledge of it."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
