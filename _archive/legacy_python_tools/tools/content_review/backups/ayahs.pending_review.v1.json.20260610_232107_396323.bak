        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 302,
        "input_status": "ok",
        "input_source_ref_groups": "048/026"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "048/026"
      ],
      "ayahs": [
        {
          "ref": "048/026",
          "surah": 48,
          "ayah": 26,
          "arabic": "إِذْ جَعَلَ ٱلَّذِينَ كَفَرُوا۟ فِى قُلُوبِهِمُ ٱلْحَمِيَّةَ حَمِيَّةَ ٱلْجَـٰهِلِيَّةِ فَأَنزَلَ ٱللَّهُ سَكِينَتَهُۥ عَلَىٰ رَسُولِهِۦ وَعَلَى ٱلْمُؤْمِنِينَ وَأَلْزَمَهُمْ كَلِمَةَ ٱلتَّقْوَىٰ وَكَانُوٓا۟ أَحَقَّ بِهَا وَأَهْلَهَا ۚ وَكَانَ ٱللَّهُ بِكُلِّ شَىْءٍ عَلِيمًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "048/026",
            "text": "Hani o inkar edenler, kendi kalplerinde, 'öfkeli soy koruyuculuğu'nu (hamiyeti), cahiliyenin 'öfkeli soy koruyuculuğunu' kılıp-kışkırttıkları zaman, hemen Allah; elçisinin ve mü'minlerin üzerine '(kalbi teskin eden) güven ve yatışma duygusunu' indirdi ve onları \"takva sözü\" üzerinde 'kararlılıkla ayakta tuttu.\" Zaten onlar da, buna layık ve ehil idiler. Allah, herşeyi hakkıyla bilendir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "048/026",
            "text": "İnkar edenler, gönüllerindeki cahiliyye çağının asabiyet ateşini ateşlendirdiklerinde, Allah, Peygamberine ve inananlara huzur indirdi; onların takva sözünü tutmalarını sağladı. Onlar, bu söze layık ve ehil kimselerdi. Allah her şeyi bilmektedir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "048/026",
            "text": "When those who disbelieved had put into their hearts chauvinism - the chauvinism of the time of ignorance. But Allah sent down His tranquillity upon His Messenger and upon the believers and imposed upon them the word of righteousness, and they were more deserving of it and worthy of it. And ever is Allah, of all things, Knowing."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "048/026",
            "text": "(This is why) when the unbelievers set in their hearts a fierce bigotry -- the bigotry of ignorance -- Allah bestowed inner peace upon His Messenger and upon the believers and made the word of piety binding on them. They were more deserving and worthier thereof. Allah has knowledge of everything."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Fetih",
      "ayah_number": 26,
      "ayah_end_number": 26,
      "text_ar": "إِذْ جَعَلَ ٱلَّذِينَ كَفَرُوا۟ فِى قُلُوبِهِمُ ٱلْحَمِيَّةَ حَمِيَّةَ ٱلْجَـٰهِلِيَّةِ فَأَنزَلَ ٱللَّهُ سَكِينَتَهُۥ عَلَىٰ رَسُولِهِۦ وَعَلَى ٱلْمُؤْمِنِينَ وَأَلْزَمَهُمْ كَلِمَةَ ٱلتَّقْوَىٰ وَكَانُوٓا۟ أَحَقَّ بِهَا وَأَهْلَهَا ۚ وَكَانَ ٱللَّهُ بِكُلِّ شَىْءٍ عَلِيمًا",
      "text_tr": "Hani o inkar edenler, kendi kalplerinde, 'öfkeli soy koruyuculuğu'nu (hamiyeti), cahiliyenin 'öfkeli soy koruyuculuğunu' kılıp-kışkırttıkları zaman, hemen Allah; elçisinin ve mü'minlerin üzerine '(kalbi teskin eden) güven ve yatışma duygusunu' indirdi ve onları \"takva sözü\" üzerinde 'kararlılıkla ayakta tuttu.\" Zaten onlar da, buna layık ve ehil idiler. Allah, herşeyi hakkıyla bilendir.",
      "text_en": "When those who disbelieved had put into their hearts chauvinism - the chauvinism of the time of ignorance. But Allah sent down His tranquillity upon His Messenger and upon the believers and imposed upon them the word of righteousness, and they were more deserving of it and worthy of it. And ever is Allah, of all things, Knowing.",
      "priority": 1,
      "notes": "bulk approved from local Tanzil source",
