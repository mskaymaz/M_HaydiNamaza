      "input": {
        "sira": 1093,
        "ref": "041/035",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 120,
        "input_status": "ok",
        "input_source_ref_groups": "041/035"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "041/035"
      ],
      "ayahs": [
        {
          "ref": "041/035",
          "surah": 41,
          "ayah": 35,
          "arabic": "وَمَا يُلَقَّىٰهَآ إِلَّا ٱلَّذِينَ صَبَرُوا۟ وَمَا يُلَقَّىٰهَآ إِلَّا ذُو حَظٍّ عَظِيمٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "041/035",
            "text": "Buna da, sabredenlerden başkası kavuşturulamaz. Ve buna, büyük bir pay sahibi olanlardan başkası da kavuşturulamaz."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "041/035",
            "text": "Bu, ancak sabredenlere vergidir; bu ancak o büyük hazzı tadanlara vergidir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "041/035",
            "text": "But none is granted it except those who are patient, and none is granted it except one having a great portion [of good]."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "041/035",
            "text": "But none attains to this except those who are steadfast; none attains to this except those endowed with mighty good fortune."
          }
        }
      ],
      "status": "approved",
