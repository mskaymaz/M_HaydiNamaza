      "input": {
        "sira": 201,
        "ref": "003/137",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 144,
        "input_status": "ok",
        "input_source_ref_groups": "003/137"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "003/137"
      ],
      "ayahs": [
        {
          "ref": "003/137",
          "surah": 3,
          "ayah": 137,
          "arabic": "قَدْ خَلَتْ مِن قَبْلِكُمْ سُنَنٌ فَسِيرُوا۟ فِى ٱلْأَرْضِ فَٱنظُرُوا۟ كَيْفَ كَانَ عَـٰقِبَةُ ٱلْمُكَذِّبِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "003/137",
            "text": "Gerçek şu ki, sizden önce nice sünnetler gelip-geçmiştir. Bundan dolayı yeryüzünde gezip-dolaşın da yalanlayanların uğradıkları sonuç nasıl oldu bir görün."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "003/137",
            "text": "Sizden önce neler gelip geçmiştir. Yeryüzünde gezin de, yalancıların sonunun ne olduğuna bir bakın."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "003/137",
            "text": "Similar situations [as yours] have passed on before you, so proceed throughout the earth and observe how was the end of those who denied."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "003/137",
            "text": "Many eras have passed before you. Go about, then, in the land and behold the end of those who gave the lie to (the directives and ordinances of Allah)."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Ali Imran",
      "ayah_number": 137,
      "ayah_end_number": 137,
      "text_ar": "قَدْ خَلَتْ مِن قَبْلِكُمْ سُنَنٌ فَسِيرُوا۟ فِى ٱلْأَرْضِ فَٱنظُرُوا۟ كَيْفَ كَانَ عَـٰقِبَةُ ٱلْمُكَذِّبِينَ",
