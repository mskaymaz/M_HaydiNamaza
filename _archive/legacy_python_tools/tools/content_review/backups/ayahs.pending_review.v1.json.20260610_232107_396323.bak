    {
      "ref": "006/111",
      "id": "006/111",
      "surah": 6,
      "ayahStart": 111,
      "ayahEnd": 111,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 408,
        "ref": "006/111",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 219,
        "input_status": "ok",
        "input_source_ref_groups": "006/111"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "006/111"
      ],
      "ayahs": [
        {
          "ref": "006/111",
          "surah": 6,
          "ayah": 111,
          "arabic": "وَلَوْ أَنَّنَا نَزَّلْنَآ إِلَيْهِمُ ٱلْمَلَـٰٓئِكَةَ وَكَلَّمَهُمُ ٱلْمَوْتَىٰ وَحَشَرْنَا عَلَيْهِمْ كُلَّ شَىْءٍ قُبُلًا مَّا كَانُوا۟ لِيُؤْمِنُوٓا۟ إِلَّآ أَن يَشَآءَ ٱللَّهُ وَلَـٰكِنَّ أَكْثَرَهُمْ يَجْهَلُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "006/111",
            "text": "Gerçek şu ki, Biz onlara melekler indirseydik, onlarla ölüler konuşsaydı ve herşeyi karşılarına toplasaydık, -Allah'ın dilediği dışında- yine onlar inanmayacaklardı. Ancak onların çoğu cahillik ediyorlar."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "006/111",
            "text": "Eğer biz onlara melekleri indirsek, ölüler onlarla konuşsa ve her şeyi karşılarına toplasaydık, Allah dilemedikçe, yine de inanmazlardı; fakat onların çoğu bunu bilmiyorlar."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "006/111",
            "text": "And even if We had sent down to them the angels [with the message] and the dead spoke to them [of it] and We gathered together every [created] thing in front of them, they would not believe unless Allah should will. But most of them, [of that], are ignorant."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "006/111",
            "text": "Even if We had sent angels down to them and the dead had spoken to them, and even if We had assembled before them all the things, face to face, they would still not believe unless it be Allah's will that they believe. Most of them behave in utter ignorance."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Enam",
      "ayah_number": 111,
      "ayah_end_number": 111,
      "text_ar": "وَلَوْ أَنَّنَا نَزَّلْنَآ إِلَيْهِمُ ٱلْمَلَـٰٓئِكَةَ وَكَلَّمَهُمُ ٱلْمَوْتَىٰ وَحَشَرْنَا عَلَيْهِمْ كُلَّ شَىْءٍ قُبُلًا مَّا كَانُوا۟ لِيُؤْمِنُوٓا۟ إِلَّآ أَن يَشَآءَ ٱللَّهُ وَلَـٰكِنَّ أَكْثَرَهُمْ يَجْهَلُونَ",
      "text_tr": "Gerçek şu ki, Biz onlara melekler indirseydik, onlarla ölüler konuşsaydı ve herşeyi karşılarına toplasaydık, -Allah'ın dilediği dışında- yine onlar inanmayacaklardı. Ancak onların çoğu cahillik ediyorlar.",
