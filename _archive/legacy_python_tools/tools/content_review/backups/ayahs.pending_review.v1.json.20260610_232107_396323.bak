      "ayahs": [
        {
          "ref": "017/026",
          "surah": 17,
          "ayah": 26,
          "arabic": "وَءَاتِ ذَا ٱلْقُرْبَىٰ حَقَّهُۥ وَٱلْمِسْكِينَ وَٱبْنَ ٱلسَّبِيلِ وَلَا تُبَذِّرْ تَبْذِيرًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "017/026",
            "text": "Akrabaya hakkını ver, yoksula ve yolda kalmışa da. İsraf ederek saçıp-savurma."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "017/026",
            "text": "Yakınına, düşküne, yolcuya hakkını ver; elindekileri saçıp savurma."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "017/026",
            "text": "And give the relative his right, and [also] the poor and the traveler, and do not spend wastefully."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "017/026",
            "text": "(iii) Give to the near of kin his due, and also to the needy and the wayfarer. (iv) Do not squander your wealth wastefully,"
          }
        },
