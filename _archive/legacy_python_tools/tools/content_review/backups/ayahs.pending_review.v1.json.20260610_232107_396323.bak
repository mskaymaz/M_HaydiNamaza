      "ayahs": [
        {
          "ref": "081/029",
          "surah": 81,
          "ayah": 29,
          "arabic": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "081/029",
            "text": "Alemlerin Rabbi olan Allah dilemedikçe siz dileyemezsiniz."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "081/029",
            "text": "Alemlerin Rabbi olan Allah dilemedikçe sizler bir şey dileyemezsiniz."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "081/029",
            "text": "And you do not will except that Allah wills - Lord of the worlds."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "081/029",
            "text": "but your wishing will not avail unless Allah, the Lord of the Universe, so wishes."
          }
        }
      ],
      "status": "approved",
