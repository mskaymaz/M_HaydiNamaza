          "arabic": "وَإِنَّ ٱلدِّينَ لَوَٰقِعٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "051/006",
            "text": "Şüphesiz din (hesap ve ceza) da mutlaka gerçekleşecektir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "051/006",
            "text": "Esip savuran rüzgarlara, yağmur yüklü bulutlara, kolayca süzülen gemiler ve işleri yöneten meleklere and olsun ki, size söz verilen kıyametin kopması şüphesiz gerçektir. Ödeşme günü gelecektir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "051/006",
            "text": "And indeed, the recompense is to occur."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "051/006",
            "text": "and the Judgement shall doubtlessly take place."
          }
        }
      ],
