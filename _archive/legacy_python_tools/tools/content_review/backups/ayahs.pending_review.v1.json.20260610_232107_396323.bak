      "sourceRefGroups": [
        "080/003"
      ],
      "ayahs": [
        {
          "ref": "080/003",
          "surah": 80,
          "ayah": 3,
          "arabic": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "080/003",
            "text": "Nerden biliyorsun; belki o, temizlenip-arınacak?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "080/003",
            "text": "Ne bilirsin, belki de o arınacak;"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "080/003",
            "text": "But what would make you perceive, [O Muhammad], that perhaps he might be purified"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "080/003",
            "text": "How could you know? Perhaps he would cleanse himself,"
          }
        }
      ],
