        {
          "ref": "092/008",
          "surah": 92,
          "ayah": 8,
          "arabic": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "092/008",
            "text": "Kim de cimrilik eder, kendini müstağni görürse,"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "092/008",
            "text": "Ama, cimrilik eden, kendini Allah'tan müstağni sayan, en güzel sözü yalanlayan kimsenin güçlüğe uğramasını kolaylaştırırız."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "092/008",
            "text": "But as for he who withholds and considers himself free of need"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "092/008",
            "text": "As for him who was a miser and behaved with aversion (to Allah),"
          }
        }
      ],
