      "input": {
        "sira": 596,
        "ref": "010/103",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 130,
        "input_status": "ok",
        "input_source_ref_groups": "010/103"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "010/103"
      ],
      "ayahs": [
        {
          "ref": "010/103",
          "surah": 10,
          "ayah": 103,
          "arabic": "ثُمَّ نُنَجِّى رُسُلَنَا وَٱلَّذِينَ ءَامَنُوا۟ ۚ كَذَٰلِكَ حَقًّا عَلَيْنَا نُنجِ ٱلْمُؤْمِنِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "010/103",
            "text": "Sonra Biz, elçilerimizi ve iman edenleri böyle kurtarırız; mü'minleri kurtarmamız Bizim üzerimize bir haktır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "010/103",
            "text": "Sonra Biz, peygamberlerimizi ve inananları böylece kurtarırız, inananları (verdiğimiz söz gereğince) kurtarmamız Bize haktır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "010/103",
            "text": "Then We will save our messengers and those who have believed. Thus, it is an obligation upon Us that We save the believers"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "010/103",
            "text": "Then, (when Allah's wrath falls upon the wicked) We save our Messengers and also those who believe. It is incumbent on Us to deliver the believers.' set fire to the whole city and its environs. The Assyrian king set his own palace ablaze and was himself burnt to death."
          }
        }
      ],
