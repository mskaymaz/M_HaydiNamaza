      "ayahs": [
        {
          "ref": "002/002",
          "surah": 2,
          "ayah": 2,
          "arabic": "ذَٰلِكَ ٱلْكِتَـٰبُ لَا رَيْبَ ۛ فِيهِ ۛ هُدًى لِّلْمُتَّقِينَ",
          "tr": {
            "source": "Tanzil tr.bulac - Ali Bulaç",
            "text": "Bu, kendisinde şüphe olmayan, muttakiler için yol gösterici olan bir Kitap'tır."
          },
          "en": {
            "source": "Tanzil en.sahih - Saheeh International",
            "text": "This is the Book about which there is no doubt, a guidance for those conscious of Allah -"
          },
          "alternatives": {
            "tr_diyanet_tanzil": {
              "source": "Tanzil tr.diyanet - Diyanet İşleri",
              "text": "Bu, doğruluğu şüphe götürmeyen ve Allah'a karşı gelmekten sakınanlara yol gösteren Kitap'dır."
            },
            "en_maududi": {
              "source": "Tanzil en.maududi - Abul A’la Maududi",
              "text": "This is the Book of Allah: there is no doubt about it. It is guidance to Godfearing people,"
            }
          }
        }
      ],
