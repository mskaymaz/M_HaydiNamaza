      "input": {
        "sira": 1278,
        "ref": "062/005-007",
        "input_type": "aralik",
        "input_ayah_count": 3,
        "input_char_count": 493,
        "input_status": "ok",
        "input_source_ref_groups": "062/005, 062/006, 062/007"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "062/005",
        "062/006",
        "062/007"
      ],
      "ayahs": [
        {
          "ref": "062/005",
          "surah": 62,
          "ayah": 5,
          "arabic": "مَثَلُ ٱلَّذِينَ حُمِّلُوا۟ ٱلتَّوْرَىٰةَ ثُمَّ لَمْ يَحْمِلُوهَا كَمَثَلِ ٱلْحِمَارِ يَحْمِلُ أَسْفَارًۢا ۚ بِئْسَ مَثَلُ ٱلْقَوْمِ ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَـٰتِ ٱللَّهِ ۚ وَٱللَّهُ لَا يَهْدِى ٱلْقَوْمَ ٱلظَّـٰلِمِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "062/005",
            "text": "Kendilerine Tevrat yükletilip de sonra onu (içindeki derin anlamları, hikmet ve hükümleriyle gereği gibi) yüklenmemiş olanların durumu, koskoca kitap yükü taşıyan eşeğin durumu gibidir. Allah'ın ayetlerini yalanlayan kavmin durumu ne kötüdür. Allah, zalim bir kavmi hidayete erdirmez."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "062/005",
            "text": "Kendilerine Tevrat öğretildiği halde, onun gereğini yapmayanların durumu, sırtına kitap yüklenmiş merkebin durumu gibidir. Allah'ın ayetlerini yalanlayan kimselerin durumu ne kötüdür! Allah zalimleri doğru yola eriştirmez."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "062/005",
            "text": "The example of those who were entrusted with the Torah and then did not take it on is like that of a donkey who carries volumes [of books]. Wretched is the example of the people who deny the signs of Allah. And Allah does not guide the wrongdoing people."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "062/005",
            "text": "The parable of those who were charged with the Torah and then they failed to live up to it is that of a donkey laden with books. Even more evil is the parable of the people who gave the lie to the Signs of Allah. Allah does not direct such wrong-doers to the Right Way."
          }
        },
        {
          "ref": "062/006",
          "surah": 62,
          "ayah": 6,
          "arabic": "قُلْ يَـٰٓأَيُّهَا ٱلَّذِينَ هَادُوٓا۟ إِن زَعَمْتُمْ أَنَّكُمْ أَوْلِيَآءُ لِلَّهِ مِن دُونِ ٱلنَّاسِ فَتَمَنَّوُا۟ ٱلْمَوْتَ إِن كُنتُمْ صَـٰدِقِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "062/006",
            "text": "De ki: \"Ey Yahudi olanlar, eğer siz, (bütün) insanlardan ayrı olarak yalnızca sizlerin gerçekten Allah'ın velileri (dost ve sevgili kulları) olduğunuzu öne sürüyorsanız, şu halde ölümü temenni edin; eğer doğru sözlü iseniz (bunu çekinmeden yapın).\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "062/006",
            "text": "De ki: \"Ey Yahudiler! Bütün insanlar bir yana, yalnız kendinizin Allah'ın dostları olduğunuzu iddia ediyorsanız ve bunda samimi iseniz, ölümü dilesenize!\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "062/006",
            "text": "Say, \"O you who are Jews, if you claim that you are allies of Allah, excluding the [other] people, then wish for death, if you should be truthful.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "062/006",
            "text": "Tell them: “O you who have become Judaised, if you arrogantly fancy that you are Allah's favourites to the exclusion of all people, then wish for death, if you are truthful in your claim.”"
          }
        },
        {
          "ref": "062/007",
          "surah": 62,
          "ayah": 7,
          "arabic": "وَلَا يَتَمَنَّوْنَهُۥٓ أَبَدًۢا بِمَا قَدَّمَتْ أَيْدِيهِمْ ۚ وَٱللَّهُ عَلِيمٌۢ بِٱلظَّـٰلِمِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "062/007",
            "text": "Oysa onlar, ellerinin öne takdim ettikleri dolayısıyla bunu hiçbir zaman temenni edemezler. Allah, zalimleri bilendir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "062/007",
            "text": "Yaptıklarından ötürü, ölümü asla dileyemezler. Allah, zalimleri bilendir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "062/007",
            "text": "But they will not wish for it, ever, because of what their hands have put forth. And Allah is Knowing of the wrongdoers."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "062/007",
            "text": "But they shall never wish for death because of the (evil) deeds they have committed. Allah is well aware of these evil-doers."
          }
        }
      ],
      "status": "approved",
