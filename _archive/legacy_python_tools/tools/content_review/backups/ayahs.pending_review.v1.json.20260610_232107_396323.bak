          "surah": 69,
          "ayah": 6,
          "arabic": "وَأَمَّا عَادٌ فَأُهْلِكُوا۟ بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "069/006",
            "text": "Ad (halkın)a gelince; onlar da, uğultu yüklü, azgın bir kasırga ile helak edildiler."
          },
          "trAlt": {
