      ],
      "ayahs": [
        {
          "ref": "042/043",
          "surah": 42,
          "ayah": 43,
          "arabic": "وَلَمَن صَبَرَ وَغَفَرَ إِنَّ ذَٰلِكَ لَمِنْ عَزْمِ ٱلْأُمُورِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulac",
            "sourceRef": "042/043",
            "text": "Kim sabreder ve bağışlarsa, şüphesiz bu, azme değer işlerdendir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "042/043",
            "text": "And whoever is patient and forgives - indeed, that is of the matters [requiring] determination."
          },
          "alternatives": {
            "tr_diyanet_tanzil": {
              "source": "Tanzil tr.diyanet / Diyanet Isleri",
              "text": "Ama sabredip bağışlayanın işi, işte bu, azmedilmeye değer işlerdendir."
            },
            "en_maududi": {
              "source": "Tanzil en.maududi / Abul A'la Maududi",
              "text": "But he who patiently endures and forgives, that is a conduct of great resolve."
            }
          }
        }
      ],
