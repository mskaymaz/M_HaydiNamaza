      "sourceRefGroups": [
        "011/067"
      ],
      "ayahs": [
        {
          "ref": "011/067",
          "surah": 11,
          "ayah": 67,
          "arabic": "وَأَخَذَ ٱلَّذِينَ ظَلَمُوا۟ ٱلصَّيْحَةُ فَأَصْبَحُوا۟ فِى دِيَـٰرِهِمْ جَـٰثِمِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "011/067",
            "text": "O zulmedenleri dayanılmaz bir ses sarıverdi de kendi yurtlarında dizüstü çökmüş olarak sabahladılar."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "011/067",
            "text": "Haksızlık yapanları bir çığlık tuttu, oldukları yerde diz üstü çöküverdiler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "011/067",
            "text": "And the shriek seized those who had wronged, and they became within their homes [corpses] fallen prone"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "011/067",
            "text": "And the Blast overtook those who were wont to do wrong, and then they lay lifeless in their homes"
          }
        }
      ],
      "status": "approved",
