    {
      "ref": "004/141",
      "id": "004/141",
      "surah": 4,
      "ayahStart": 141,
      "ayahEnd": 141,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 299,
        "ref": "004/141",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 366,
        "input_status": "ok",
        "input_source_ref_groups": "004/141"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "004/141"
      ],
      "ayahs": [
        {
          "ref": "004/141",
          "surah": 4,
          "ayah": 141,
          "arabic": "ٱلَّذِينَ يَتَرَبَّصُونَ بِكُمْ فَإِن كَانَ لَكُمْ فَتْحٌ مِّنَ ٱللَّهِ قَالُوٓا۟ أَلَمْ نَكُن مَّعَكُمْ وَإِن كَانَ لِلْكَـٰفِرِينَ نَصِيبٌ قَالُوٓا۟ أَلَمْ نَسْتَحْوِذْ عَلَيْكُمْ وَنَمْنَعْكُم مِّنَ ٱلْمُؤْمِنِينَ ۚ فَٱللَّهُ يَحْكُمُ بَيْنَكُمْ يَوْمَ ٱلْقِيَـٰمَةِ ۗ وَلَن يَجْعَلَ ٱللَّهُ لِلْكَـٰفِرِينَ عَلَى ٱلْمُؤْمِنِينَ سَبِيلًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/141",
            "text": "Onlar sizi gözetleyip-duruyorlar. Size Allah'tan bir fetih (zafer ve ganimet) gelirse: \"Sizinle birlikte değil miydik?\" derler. Ama kafirlere bir pay düşerse: \"Size üstünlük sağlamadık mı, mü'minlerden size (gelecek tehlikeleri) önlemedik mi?\" derler. Allah, kıyamet günü aranızda hükmedecektir. Allah, kafirlere mü'minlerin aleyhinde kesinlikle yol vermez."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/141",
            "text": "Sizi gözleyenler, Allah'tan size bir zafer gelirse, \"Sizinle beraber değil miydik?\" derler; eğer kafirlere bir pay çıkarsa, onlara: \"Size üstünlük sağlayarak sizi müminlerden korumadık mı?\" derler. Allah kıyamet günü aranızda hüküm verir. Allah inkarcılara, inananlar aleyhinde asla fırsat vermeyecektir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/141",
            "text": "Those who wait [and watch] you. Then if you gain a victory from Allah, they say, \"Were we not with you?\" But if the disbelievers have a success, they say [to them], \"Did we not gain the advantage over you, but we protected you from the believers?\" Allah will judge between [all of] you on the Day of Resurrection, and never will Allah give the disbelievers over the believers a way [to overcome them]."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/141",
            "text": "These hypocrites watch you closely: if victory is granted to you by Allah, they will say: 'Were we not with you?' And were the unbelievers to gain the upper hand, they will say: 'Did we not have mastery over you, and yet we protected you from the believers?' It is Allah Who will judge between you on the Day of Resurrection, and He will not allow the unbelievers, in any way, to gain advantage over the believers."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:50:08+00:00"
      },
      "surah_name": "Nisa",
