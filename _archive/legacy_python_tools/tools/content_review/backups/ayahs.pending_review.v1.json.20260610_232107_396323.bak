      "ayahs": [
        {
          "ref": "074/048",
          "surah": 74,
          "ayah": 48,
          "arabic": "فَمَا تَنفَعُهُمْ شَفَـٰعَةُ ٱلشَّـٰفِعِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "074/048",
            "text": "Artık, şefaat edenlerin şefaati onlara bir yarar sağlamaz."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "074/048",
            "text": "Artık onlara, şefaatçilerin şefaati fayda vermez."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "074/048",
            "text": "So there will not benefit them the intercession of [any] intercessors."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "074/048",
            "text": "The intercession of the intercessors shall then be of no avail to them."
          }
        }
      ],
