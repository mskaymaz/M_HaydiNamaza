      ],
      "ayahs": [
        {
          "ref": "026/074",
          "surah": 26,
          "ayah": 74,
          "arabic": "قَالُوا۟ بَلْ وَجَدْنَآ ءَابَآءَنَا كَذَٰلِكَ يَفْعَلُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "026/074",
            "text": "\"Hayır\" dediler. \"Biz atalarımızı böyle yaparlarken bulduk.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "026/074",
            "text": "\"Hayır ama, babalarımızı da bu şekilde ibadet ederken bulduk\" demişlerdi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "026/074",
            "text": "They said, \"But we found our fathers doing thus.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "026/074",
            "text": "They answered: \"No; but we found our forefathers doing so.\""
          }
        }
      ],
