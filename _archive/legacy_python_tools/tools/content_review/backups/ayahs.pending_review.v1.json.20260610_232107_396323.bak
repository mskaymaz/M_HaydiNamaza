      "input": {
        "sira": null,
        "ref": "041/030",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 0,
        "input_status": "tool_ekle",
        "input_source_ref_groups": "041/030"
      },
      "source": {
        "arabic": "Tanzil Uthmani Quran Text",
        "tr": "Tanzil tr.bulac / Ali Bulac",
        "trAlt": "Tanzil tr.diyanet / Diyanet Isleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A'la Maududi"
      },
      "sourceRefGroups": [
        "041/030"
      ],
      "ayahs": [
        {
          "ref": "041/030",
          "surah": 41,
          "ayah": 30,
          "arabic": "إِنَّ ٱلَّذِينَ قَالُوا۟ رَبُّنَا ٱللَّهُ ثُمَّ ٱسْتَقَـٰمُوا۟ تَتَنَزَّلُ عَلَيْهِمُ ٱلْمَلَـٰٓئِكَةُ أَلَّا تَخَافُوا۟ وَلَا تَحْزَنُوا۟ وَأَبْشِرُوا۟ بِٱلْجَنَّةِ ٱلَّتِى كُنتُمْ تُوعَدُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulac",
            "sourceRef": "041/030",
            "text": "Şüphesiz: \"Bizim Rabbimiz Allah'tır\" deyip sonra dosdoğru bir istikamet tutturanlar (yok mu); onların üzerine melekler iner (ve der ki:) \"Korkmayın ve hüzne kapılmayın, size vadolunan cennetle sevinin.\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "041/030",
            "text": "Indeed, those who have said, \"Our Lord is Allah \" and then remained on a right course - the angels will descend upon them, [saying], \"Do not fear and do not grieve but receive good tidings of Paradise, which you were promised."
          },
          "alternatives": {
            "tr_diyanet_tanzil": {
              "source": "Tanzil tr.diyanet / Diyanet Isleri",
              "text": "\"Rabbimiz Allah'tır\" deyip sonra da doğrulukta devam edenler, onları, melekler, ölümleri anında: \"Korkmayınız, üzülmeyiniz, size söz verilen cennetle sevinin, biz dünya hayatında da, ahirette de size dostuz. Burada, canlarınızın çektiği, umduğunuz şeyler, bağışlayan ve acıyan Allah katından bir ziyafet olarak size sunulur\" diyerek inerler."
            },
            "en_maududi": {
              "source": "Tanzil en.maududi / Abul A'la Maududi",
              "text": "Those who say “Allah is our Lord” and then remain steadfast, upon them descend angels (and say): “Do not fear nor grieve, and receive good tidings of Paradise which you were promised."
            }
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:50:08+00:00"
      },
