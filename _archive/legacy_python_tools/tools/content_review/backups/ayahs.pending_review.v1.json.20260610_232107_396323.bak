    {
      "ref": "009/086",
      "id": "009/086",
      "surah": 9,
      "ayahStart": 86,
      "ayahEnd": 86,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 552,
        "ref": "009/086",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 199,
        "input_status": "ok",
        "input_source_ref_groups": "009/086"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "009/086"
      ],
      "ayahs": [
        {
          "ref": "009/086",
          "surah": 9,
          "ayah": 86,
          "arabic": "وَإِذَآ أُنزِلَتْ سُورَةٌ أَنْ ءَامِنُوا۟ بِٱللَّهِ وَجَـٰهِدُوا۟ مَعَ رَسُولِهِ ٱسْتَـْٔذَنَكَ أُو۟لُوا۟ ٱلطَّوْلِ مِنْهُمْ وَقَالُوا۟ ذَرْنَا نَكُن مَّعَ ٱلْقَـٰعِدِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "009/086",
            "text": "\"Allah'a iman edin, O'nun elçisi ile cihad etmeye çıkın\" diye bir sûre indirildiği zaman onlardan servet sahibi olanlar, senden izin isteyip: \"Bizi bırakıver, oturanlarla birlikte olalım\" dediler."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "009/086",
            "text": "\"Allah'a inanın ve Peygamberinin yanında savaşın\" diye bir sure inmiş olsa, onların gücü yetenleri sizden izin isterler ve \"Bizi bırak oturanlarla beraber kalalım\" derler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "009/086",
            "text": "And when a surah was revealed [enjoining them] to believe in Allah and to fight with His Messenger, those of wealth among them asked your permission [to stay back] and said, \"Leave us to be with them who sit [at home].\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "009/086",
            "text": "And whenever any surah is revealed enjoining: \"Believe in Allah and strive (in His Way) along with His Messenger,\" the affluent among them ask you to excuse them, saying: \"Leave us with those who will sit back at home.\""
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Tevbe",
      "ayah_number": 86,
      "ayah_end_number": 86,
      "text_ar": "وَإِذَآ أُنزِلَتْ سُورَةٌ أَنْ ءَامِنُوا۟ بِٱللَّهِ وَجَـٰهِدُوا۟ مَعَ رَسُولِهِ ٱسْتَـْٔذَنَكَ أُو۟لُوا۟ ٱلطَّوْلِ مِنْهُمْ وَقَالُوا۟ ذَرْنَا نَكُن مَّعَ ٱلْقَـٰعِدِينَ",
      "text_tr": "\"Allah'a iman edin, O'nun elçisi ile cihad etmeye çıkın\" diye bir sûre indirildiği zaman onlardan servet sahibi olanlar, senden izin isteyip: \"Bizi bırakıver, oturanlarla birlikte olalım\" dediler.",
      "text_en": "And when a surah was revealed [enjoining them] to believe in Allah and to fight with His Messenger, those of wealth among them asked your permission [to stay back] and said, \"Leave us to be with them who sit [at home].\"",
      "priority": 1,
      "notes": "bulk approved from local Tanzil source",
      "createdAt": "2026-06-09T08:52:44+00:00",
      "updatedAt": "2026-06-09T08:52:44+00:00",
      "approvedAt": "2026-06-09T08:52:44+00:00",
