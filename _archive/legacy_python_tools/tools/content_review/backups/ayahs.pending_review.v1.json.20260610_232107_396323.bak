        "input_type": "aralik",
        "input_ayah_count": 2,
        "input_char_count": 0,
        "input_status": "tool_ekle",
        "input_source_ref_groups": "002/011-012"
      },
      "source": {
        "arabic": "Tanzil Uthmani Quran Text",
        "tr": "Tanzil tr.bulac / Ali Bulac",
        "trAlt": "Tanzil tr.diyanet / Diyanet Isleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A'la Maududi"
      },
      "sourceRefGroups": [
        "002/011-012"
      ],
      "ayahs": [
        {
          "ref": "002/011",
          "surah": 2,
          "ayah": 11,
          "arabic": "وَإِذَا قِيلَ لَهُمْ لَا تُفْسِدُوا۟ فِى ٱلْأَرْضِ قَالُوٓا۟ إِنَّمَا نَحْنُ مُصْلِحُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulac",
            "sourceRef": "002/011",
            "text": "Kendilerine: \"Yeryüzünde fesat çıkarmayın\" denildiğinde: \"Biz sadece ıslah edicileriz\" derler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "002/011",
            "text": "And when it is said to them, \"Do not cause corruption on the earth,\" they say, \"We are but reformers.\""
          },
          "alternatives": {
            "tr_diyanet_tanzil": {
              "source": "Tanzil tr.diyanet / Diyanet Isleri",
              "text": "Kendilerine: \"Yeryüzünde bozgunculuk yapmayın\" dendiği zaman, \"Bizler sadece ıslah edicileriz\" derler."
            },
            "en_maududi": {
              "source": "Tanzil en.maududi / Abul A'la Maududi",
              "text": "Whenever it is said to them, \"Spread not disorder on the earth\", their reply is, \"We only seek to put things aright\"."
            }
          }
        },
        {
          "ref": "002/012",
          "surah": 2,
          "ayah": 12,
          "arabic": "أَلَآ إِنَّهُمْ هُمُ ٱلْمُفْسِدُونَ وَلَـٰكِن لَّا يَشْعُرُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulac",
            "sourceRef": "002/012",
            "text": "Bilin ki; gerçekten, asıl fesatçılar bunlardır, ama şuurunda değildirler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "002/012",
            "text": "Unquestionably, it is they who are the corrupters, but they perceive [it] not."
          },
          "alternatives": {
            "tr_diyanet_tanzil": {
              "source": "Tanzil tr.diyanet / Diyanet Isleri",
              "text": "İyi bilin ki, asıl bozguncular kendileridir, lakin farkında değillerdir."
            },
            "en_maududi": {
              "source": "Tanzil en.maududi / Abul A'la Maududi",
              "text": "Beware! they do spread disorder but they realize it not."
            }
          }
        }
      ],
