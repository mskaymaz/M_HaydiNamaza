        "019/032"
      ],
      "ayahs": [
        {
          "ref": "019/032",
          "surah": 19,
          "ayah": 32,
          "arabic": "وَبَرًّۢا بِوَٰلِدَتِى وَلَمْ يَجْعَلْنِى جَبَّارًا شَقِيًّا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "019/032",
            "text": "\"Anneme itati de. Ve beni mutsuz bir zorba kılmadı.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "019/032",
            "text": "Çocuk: \"Ben şüphesiz Allah'ın kuluyum. Bana kitap verdi ve beni peygamber yaptı, nerede olursam olayım beni mübarek kıldı. Yaşadığım müddetçe namaz kılmamı, zekat vermemi ve anneme iyi davranmamı emretti. Beni bedbaht bir zorba kılmadı. Doğduğum günde, öleceğim günde, dirileceğim günde bana selam olsun\" dedi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "019/032",
            "text": "And [made me] dutiful to my mother, and He has not made me a wretched tyrant."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "019/032",
            "text": "and has made me dutiful to my mother. He has not made me oppressive, nor bereft of God's blessings."
          }
        }
      ],
      "status": "approved",
