      "sourceRefGroups": [
        "027/069"
      ],
      "ayahs": [
        {
          "ref": "027/069",
          "surah": 27,
          "ayah": 69,
          "arabic": "قُلْ سِيرُوا۟ فِى ٱلْأَرْضِ فَٱنظُرُوا۟ كَيْفَ كَانَ عَـٰقِبَةُ ٱلْمُجْرِمِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "027/069",
            "text": "De ki: \"Yeryüzünde gezip dolaşın da, suçlu-günahkarların nasıl bir sona uğradıklarını görün\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "027/069",
            "text": "De ki: \"Yeryüzünde gezin, suçluların sonunun nasıl olduğuna bir bakın.\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "027/069",
            "text": "Say, [O Muhammad], \"Travel through the land and observe how was the end of the criminals.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "027/069",
            "text": "Say: \"Go about through the earth and see what has been the end of the evil-doers.\""
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
