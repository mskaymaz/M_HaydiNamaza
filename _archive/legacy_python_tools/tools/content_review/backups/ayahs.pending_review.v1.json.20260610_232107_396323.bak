      "input": {
        "sira": 624,
        "ref": "012/050",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 192,
        "input_status": "ok",
        "input_source_ref_groups": "012/050"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "012/050"
      ],
      "ayahs": [
        {
          "ref": "012/050",
          "surah": 12,
          "ayah": 50,
          "arabic": "وَقَالَ ٱلْمَلِكُ ٱئْتُونِى بِهِۦ ۖ فَلَمَّا جَآءَهُ ٱلرَّسُولُ قَالَ ٱرْجِعْ إِلَىٰ رَبِّكَ فَسْـَٔلْهُ مَا بَالُ ٱلنِّسْوَةِ ٱلَّـٰتِى قَطَّعْنَ أَيْدِيَهُنَّ ۚ إِنَّ رَبِّى بِكَيْدِهِنَّ عَلِيمٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "012/050",
            "text": "Hükümdar dedi ki: \"Onu bana getirin.\" Ona elçi geldiğinde (Yusuf:) \"Efendine (Rabbine) dön de ona sor: \"Ellerini kesen o kadınların durumu neydi? Doğrusu benim Rabbim, onların hileli düzenlerini gerçekten bilendir.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "012/050",
            "text": "Hükümdar: \"Onu bana getirin\" dedi. Yusuf'a elçi gelince, \"Efendine dön, kadınlar niçin ellerini kesmişlerdi bir sor; doğrusu Rabbim onların hilesini bilir\" dedi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "012/050",
            "text": "And the king said, \"Bring him to me.\" But when the messenger came to him, [Joseph] said, \"Return to your master and ask him what is the case of the women who cut their hands. Indeed, my Lord is Knowing of their plan.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "012/050",
            "text": "The king said: \"Bring this man to me.\" But when the royal messenger came to Joseph he said: \"Go back to your master and ask him about the case of the women who had cut their hands. Surely my Lord has full knowledge of their guile.\""
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
