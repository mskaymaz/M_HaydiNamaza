          "ref": "081/019",
          "surah": 81,
          "ayah": 19,
          "arabic": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "081/019",
            "text": "Şüphesiz o (Kur'an), üstün onur sahibi bir elçinin gerçekten (Allah'tan getirdiği) sözüdür;"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "081/019",
            "text": "Bu Kuran, arşın sahibi katında değerli, güçlü, sözü dinlenen ve güvenilen şerefli bir elçinin getirdiği sözdür."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "081/019",
            "text": "[That] indeed, the Qur'an is a word [conveyed by] a noble messenger"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "081/019",
            "text": "Verily this is the word of a noble message-bearer;"
          }
        }
      ],
