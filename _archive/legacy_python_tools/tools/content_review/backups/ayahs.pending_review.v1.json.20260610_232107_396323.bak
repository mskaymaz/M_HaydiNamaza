      "ayahs": [
        {
          "ref": "014/040",
          "surah": 14,
          "ayah": 40,
          "arabic": "رَبِّ ٱجْعَلْنِى مُقِيمَ ٱلصَّلَوٰةِ وَمِن ذُرِّيَّتِى ۚ رَبَّنَا وَتَقَبَّلْ دُعَآءِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "014/040",
            "text": "\"Rabbim, beni namazı(nda) sürekli kıl, soyumdan olanları da. Rabbimiz, duamı kabul buyur.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "014/040",
            "text": "\"Rabbim! Beni ve çocuklarımı namaz kılanlardan eyle. Rabbimiz! Duamı kabul buyur.\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "014/040",
            "text": "My Lord, make me an establisher of prayer, and [many] from my descendants. Our Lord, and accept my supplication."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "014/040",
            "text": "My Lord! Enable me and my offspring to establish Prayer, and do accept, our Lord, this prayer of mine."
          }
        }
      ],
