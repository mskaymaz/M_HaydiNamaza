      "input": {
        "sira": 511,
        "ref": "009/007",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 290,
        "input_status": "ok",
        "input_source_ref_groups": "009/007"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "009/007"
      ],
      "ayahs": [
        {
          "ref": "009/007",
          "surah": 9,
          "ayah": 7,
          "arabic": "كَيْفَ يَكُونُ لِلْمُشْرِكِينَ عَهْدٌ عِندَ ٱللَّهِ وَعِندَ رَسُولِهِۦٓ إِلَّا ٱلَّذِينَ عَـٰهَدتُّمْ عِندَ ٱلْمَسْجِدِ ٱلْحَرَامِ ۖ فَمَا ٱسْتَقَـٰمُوا۟ لَكُمْ فَٱسْتَقِيمُوا۟ لَهُمْ ۚ إِنَّ ٱللَّهَ يُحِبُّ ٱلْمُتَّقِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "009/007",
            "text": "Mescid-i Haram yanında kendileriyle anlaştıklarınız dışında, müşriklerin Allah Katında ve Resûlünün katında nasıl bir ahdi olabilir? Şu halde o (anlaşmalı olanlar), size karşı (doğru) bir tutum takındıkça, siz de onlara karşı doğru bir tutum takının. Şüphesiz Allah, muttaki olanları sever."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "009/007",
            "text": "Mescidi Haram'ın yanında andlaştıklarınızın dışında, puta tapanların Allah katında ve Peygamberi önünde nasıl bir andlaşmaları olabilir. Size doğru davrandıkça siz de onlara doğru davranın. Allah, sözleşmelerini bozmaktan sakınanları sever."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "009/007",
            "text": "How can there be for the polytheists a treaty in the sight of Allah and with His Messenger, except for those with whom you made a treaty at al-Masjid al-Haram? So as long as they are upright toward you, be upright toward them. Indeed, Allah loves the righteous [who fear Him]."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "009/007",
            "text": "How can there be a covenant with those who associate others with Allah in His Divinity be binding upon Allah and His Messenger, excepting those with whom you made a covenant near the Sacred Mosque? Behave in a straight manner with them so long as they behave with you in a straight manner for Allah loves the Godfearing."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
