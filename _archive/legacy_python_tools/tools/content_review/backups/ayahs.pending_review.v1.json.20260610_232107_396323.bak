    {
      "ref": "005/104",
      "id": "005/104",
      "surah": 5,
      "ayahStart": 104,
      "ayahEnd": 104,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 385,
        "ref": "005/104",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 213,
        "input_status": "ok",
        "input_source_ref_groups": "005/104"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "005/104"
      ],
      "ayahs": [
        {
          "ref": "005/104",
          "surah": 5,
          "ayah": 104,
          "arabic": "وَإِذَا قِيلَ لَهُمْ تَعَالَوْا۟ إِلَىٰ مَآ أَنزَلَ ٱللَّهُ وَإِلَى ٱلرَّسُولِ قَالُوا۟ حَسْبُنَا مَا وَجَدْنَا عَلَيْهِ ءَابَآءَنَآ ۚ أَوَلَوْ كَانَ ءَابَآؤُهُمْ لَا يَعْلَمُونَ شَيْـًٔا وَلَا يَهْتَدُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "005/104",
            "text": "Onlara: \"Allah'ın indirdiğine ve elçiye gelin\" denildiğinde, \"Atalarımızı üzerinde bulduğumuz şey bize yeter\" derler. (Peki,) Ya ataları bir şey bilmiyor ve hidayete ermiyor idilerse?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "005/104",
            "text": "Onlara, \"Gelin Allah'ın indirdiği Kitap'a ve peygambere uyun\" dendiğinde, \"Atalarımızı üzerinde bulduğumuz yol bize yeter\" derler; ya ataları bir şey bilmeyen ve doğru yolda olmayan kimseler idiyseler?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "005/104",
            "text": "And when it is said to them, \"Come to what Allah has revealed and to the Messenger,\" they say, \"Sufficient for us is that upon which we found our fathers.\" Even though their fathers knew nothing, nor were they guided?"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "005/104",
            "text": "When they are asked: 'Come to what Allah has revealed, and come to the Messenger', they reply: 'The way of our refathers suffices us.' (Will they continue to follow their forefathers) even though their forefathers might have known nothing, and might have been on the wrong way?"
          }
        }
      ],
      "status": "approved",
