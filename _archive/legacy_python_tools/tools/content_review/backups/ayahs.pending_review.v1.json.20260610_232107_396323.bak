      "ayahs": [
        {
          "ref": "010/105",
          "surah": 10,
          "ayah": 105,
          "arabic": "وَأَنْ أَقِمْ وَجْهَكَ لِلدِّينِ حَنِيفًا وَلَا تَكُونَنَّ مِنَ ٱلْمُشْرِكِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "010/105",
            "text": "Ve: \"Bir muvahhid (hanif) olarak yüzünü dine doğru yönelt ve sakın müşriklerden olma,\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "010/105",
            "text": "(Muhammed'e) \"Yüzünü, doğruya yönelmiş olarak dine çevir, sakın ortak koşanlardan olma; sana fayda da zarar da veremeyecek, Allah'tan başkasına yalvarma; öyle yaparsan şüphesiz, zalimlerden olursun\" denildi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "010/105",
            "text": "And [commanded], 'Direct your face toward the religion, inclining to truth, and never be of those who associate others with Allah;"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "010/105",
            "text": "and to adhere exclusively and sincerely to the true faith, and not to be one of those who associate others with Allah in His divinity."
          }
        }
      ],
