      "input": {
        "sira": 278,
        "ref": "004/100",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 269,
        "input_status": "ok",
        "input_source_ref_groups": "004/100"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "004/100"
      ],
      "ayahs": [
        {
          "ref": "004/100",
          "surah": 4,
          "ayah": 100,
          "arabic": "وَمَن يُهَاجِرْ فِى سَبِيلِ ٱللَّهِ يَجِدْ فِى ٱلْأَرْضِ مُرَٰغَمًا كَثِيرًا وَسَعَةً ۚ وَمَن يَخْرُجْ مِنۢ بَيْتِهِۦ مُهَاجِرًا إِلَى ٱللَّهِ وَرَسُولِهِۦ ثُمَّ يُدْرِكْهُ ٱلْمَوْتُ فَقَدْ وَقَعَ أَجْرُهُۥ عَلَى ٱللَّهِ ۗ وَكَانَ ٱللَّهُ غَفُورًا رَّحِيمًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/100",
            "text": "Allah yolunda hicret eden, yeryüzünde barınacak çok yer de bulur, genişlik (ve bolluk) da. Allah'a ve Resûlü’ne hicret etmek üzere evinden çıkan, sonra kendisine ölüm gelen kişinin ecri şüphesiz Allah'a düşmüştür. Allah, bağışlayıcıdır, esirgeyicidir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/100",
            "text": "Allah yolunda hicret eden kişi, yeryüzünde çok bereketli yer ve genişlik bulur. Evinden, Allah'a ve Peygamberine hicret ederek çıkan kimseye ölüm gelirse, onun ecrini vermek Allah'a düşer. Allah bağışlar ve merhamet eder."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/100",
            "text": "And whoever emigrates for the cause of Allah will find on the earth many [alternative] locations and abundance. And whoever leaves his home as an emigrant to Allah and His Messenger and then death overtakes him - his reward has already become incumbent upon Allah. And Allah is ever Forgiving and Merciful."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/100",
            "text": "He who emigrates in the way of Allah will find in the earth enough room for refuge and plentiful resources. And he who goes forth from his house as a migrant in the way of Allah and His Messenger, and whom death overtakes, his reward becomes incumbent on Allah. Surely Allah is All-Forgiving, All-Compassionate."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:50:08+00:00"
      },
      "surah_name": "Nisa",
