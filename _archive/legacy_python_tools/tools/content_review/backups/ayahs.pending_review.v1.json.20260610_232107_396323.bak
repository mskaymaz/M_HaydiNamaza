    {
      "ref": "013/042",
      "id": "013/042",
      "surah": 13,
      "ayahStart": 42,
      "ayahEnd": 42,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 644,
        "ref": "013/042",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 177,
        "input_status": "ok",
        "input_source_ref_groups": "013/042"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "013/042"
      ],
      "ayahs": [
        {
          "ref": "013/042",
          "surah": 13,
          "ayah": 42,
          "arabic": "وَقَدْ مَكَرَ ٱلَّذِينَ مِن قَبْلِهِمْ فَلِلَّهِ ٱلْمَكْرُ جَمِيعًا ۖ يَعْلَمُ مَا تَكْسِبُ كُلُّ نَفْسٍ ۗ وَسَيَعْلَمُ ٱلْكُفَّـٰرُ لِمَنْ عُقْبَى ٱلدَّارِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "013/042",
            "text": "Onlardan öncekiler de hileli-düzenler kurmuşlardı; fakat düzen kuruculuğun (tedbirlerin, karşılık vermelerin) tümü Allah'a aittir. Her bir nefsin ne kazandığını O bilir. Bu yurdun sonu kimindir, inkar edenler pek yakında bileceklerdir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "013/042",
            "text": "Onlardan öncekiler de tuzak kurdular, oysa bütün tuzaklar(ın cezası) Allah'ındır, Herkesin yaptığını bilir. İnkarcılar da, neticenin kimin olduğunu göreceklerdir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "013/042",
            "text": "And those before them had plotted, but to Allah belongs the plan entirely. He knows what every soul earns, and the disbelievers will know for whom is the final home."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "013/042",
            "text": "Those who lived before them also devised many a plot, but the master plot rests with Allah. He knows what everyone does. The deniers of the truth will soon come to know whose end is good."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
