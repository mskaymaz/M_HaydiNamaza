      "ayahs": [
        {
          "ref": "021/059",
          "surah": 21,
          "ayah": 59,
          "arabic": "قَالُوا۟ مَن فَعَلَ هَـٰذَا بِـَٔالِهَتِنَآ إِنَّهُۥ لَمِنَ ٱلظَّـٰلِمِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "021/059",
            "text": "\"Bizim ilahlarımıza bunu kim yaptı? Şüphesiz o, zalimlerden biridir\" dediler."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "021/059",
            "text": "Milleti: \"Tanrılarımıza bunu kim yaptı? Doğrusu o zalimlerden biridir\" dediler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "021/059",
            "text": "They said, \"Who has done this to our gods? Indeed, he is of the wrongdoers.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "021/059",
            "text": "(When they saw the idols in this state) they said: \"Who has done this to our gods? Surely he is one of the wrong-doers.\""
          }
        }
      ],
