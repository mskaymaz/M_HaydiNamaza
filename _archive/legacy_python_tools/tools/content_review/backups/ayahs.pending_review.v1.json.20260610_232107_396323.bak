    {
      "ref": "004/051",
      "id": "004/051",
      "surah": 4,
      "ayahStart": 51,
      "ayahEnd": 51,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 257,
        "ref": "004/051",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 183,
        "input_status": "ok",
        "input_source_ref_groups": "004/051"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "004/051"
      ],
      "ayahs": [
        {
          "ref": "004/051",
          "surah": 4,
          "ayah": 51,
          "arabic": "أَلَمْ تَرَ إِلَى ٱلَّذِينَ أُوتُوا۟ نَصِيبًا مِّنَ ٱلْكِتَـٰبِ يُؤْمِنُونَ بِٱلْجِبْتِ وَٱلطَّـٰغُوتِ وَيَقُولُونَ لِلَّذِينَ كَفَرُوا۟ هَـٰٓؤُلَآءِ أَهْدَىٰ مِنَ ٱلَّذِينَ ءَامَنُوا۟ سَبِيلًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/051",
            "text": "Kendilerine kitaptan bir pay verilenleri görmedin mi? Onlar, tağuta ve cibt'e inanıyorlar ve diğer inkar edenler için: \"Bunlar, iman edenlerden daha doğru bir yoldadır\" diyorlar."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/051",
            "text": "Kendilerine kitap verilmiş olanların, puta ve şeytana kanıp, inkar edenlere: \"Bunlar, inananlardan daha doğru yoldadırlar\" dediklerini görmedin mi?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/051",
            "text": "Have you not seen those who were given a portion of the Scripture, who believe in superstition and false objects of worship and say about the disbelievers, \"These are better guided than the believers as to the way\"?"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/051",
            "text": "Have you not seen those to whom a portion of the Book was given? They believe in baseless superstitions and taghut (false deities), and say about the unbelievers that they are better guided than those who believe."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
