      },
      "sourceRefGroups": [
        "048/002-003",
        "048/004"
      ],
      "ayahs": [
        {
          "ref": "048/003",
          "surah": 48,
          "ayah": 3,
          "arabic": "وَيَنصُرَكَ ٱللَّهُ نَصْرًا عَزِيزًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "048/003",
            "text": "Ve Allah, sana 'üstün ve onurlu' bir zaferle yardım etsin."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "048/003",
            "text": "Böylece sana, kimsenin güç yetiremeyeceği bir şekilde yardım eder."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "048/003",
            "text": "And [that] Allah may aid you with a mighty victory."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "048/003",
            "text": "and that Allah may bestow upon you a mighty help."
          }
        },
        {
          "ref": "048/004",
          "surah": 48,
          "ayah": 4,
          "arabic": "هُوَ ٱلَّذِىٓ أَنزَلَ ٱلسَّكِينَةَ فِى قُلُوبِ ٱلْمُؤْمِنِينَ لِيَزْدَادُوٓا۟ إِيمَـٰنًا مَّعَ إِيمَـٰنِهِمْ ۗ وَلِلَّهِ جُنُودُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَكَانَ ٱللَّهُ عَلِيمًا حَكِيمًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "048/004",
            "text": "Mü'minlerin kalplerine, imanlarına iman katıp-arttırsınlar diye, 'güven duygusu ve huzur' indiren O'dur. Göklerin ve yerin orduları Allah'ındır: Allah bilendir, hüküm ve hikmet sahibidir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "048/004",
            "text": "İnananların, imanlarını kat kat artırmaları için, kalblerine güven indiren O'dur. Göklerdeki ve yerdeki ordular Allah'ındır. Allah bilendir, Hakim olandır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "048/004",
            "text": "It is He who sent down tranquillity into the hearts of the believers that they would increase in faith along with their [present] faith. And to Allah belong the soldiers of the heavens and the earth, and ever is Allah Knowing and Wise."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "048/004",
            "text": "He it is Who bestowed inner peace on the hearts of the believers so that they may grow yet more firm in their faith. To Allah belong the legions of the heavens and the earth; Allah is All-Knowing, Most Wise."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
