    {
      "ref": "042/010",
      "id": "042/010",
      "surah": 42,
      "ayahStart": 10,
      "ayahEnd": 10,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 1096,
        "ref": "042/010",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 150,
        "input_status": "ok",
        "input_source_ref_groups": "042/010"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "042/010"
      ],
      "ayahs": [
        {
          "ref": "042/010",
          "surah": 42,
          "ayah": 10,
          "arabic": "وَمَا ٱخْتَلَفْتُمْ فِيهِ مِن شَىْءٍ فَحُكْمُهُۥٓ إِلَى ٱللَّهِ ۚ ذَٰلِكُمُ ٱللَّهُ رَبِّى عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ أُنِيبُ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "042/010",
            "text": "Hakkında ihtilafa düştüğünüz herhangi bir şey; artık O'nun hükmü Allah'ındır. İşte Rabbim olan Allah. Ben O'na tevekkül ettim ve yalnızca O'na dönüp-yönelirim."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "042/010",
            "text": "Ayrılığa düştüğünüz herhangi bir şeyde hüküm vermek, Allah'a aittir; \"İşte bu Allah, benim Rabbimdir. O'na güvenirim ve O'na yönelirim.\" (demek gerekir)"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "042/010",
            "text": "And in anything over which you disagree - its ruling is [to be referred] to Allah. [Say], \"That is Allah, my Lord; upon Him I have relied, and to Him I turn back.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "042/010",
            "text": "The judgement on whatever you differ rests with Allah. Such is Allah, my Lord; in Him I have put all my trust and to Him I always turn in devotion."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
