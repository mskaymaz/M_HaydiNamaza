        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 93,
        "input_status": "ok",
        "input_source_ref_groups": "039/070"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "039/070"
      ],
      "ayahs": [
        {
          "ref": "039/070",
          "surah": 39,
          "ayah": 70,
          "arabic": "وَوُفِّيَتْ كُلُّ نَفْسٍ مَّا عَمِلَتْ وَهُوَ أَعْلَمُ بِمَا يَفْعَلُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "039/070",
            "text": "Her bir nefse yaptığının tam karşılığı verildi. O, onların işlediklerini daha iyi bilendir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "039/070",
            "text": "Her kişiye işlediği ödenir. Esasen Allah onların yaptıklarını en iyi bilendir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "039/070",
            "text": "And every soul will be fully compensated [for] what it did; and He is most knowing of what they do."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "039/070",
            "text": "and everyone shall be paid in full for all that he did. Allah is best aware of all that they do."
          }
        }
      ],
