      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "009/056",
        "009/057"
      ],
      "ayahs": [
        {
          "ref": "009/056",
          "surah": 9,
          "ayah": 56,
          "arabic": "وَيَحْلِفُونَ بِٱللَّهِ إِنَّهُمْ لَمِنكُمْ وَمَا هُم مِّنكُمْ وَلَـٰكِنَّهُمْ قَوْمٌ يَفْرَقُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "009/056",
            "text": "Gerçekten sizden olduklarına dair Allah adına yemin ederler. Oysa onlar sizden değildirler. Ancak onlar ödleri kopan bir topluluktur."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "009/056",
            "text": "Sizden olmadıkları halde, sizinle beraber olduklarına Allah'a yemin ederler. Oysa onlar korkak bir topluluktur."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "009/056",
            "text": "And they swear by Allah that they are from among you while they are not from among you; but they are a people who are afraid."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "009/056",
            "text": "They swear by Allah that they are part of you whereas they are certainly not part of you. They are merely a people who dread you."
          }
        },
        {
          "ref": "009/057",
          "surah": 9,
          "ayah": 57,
          "arabic": "لَوْ يَجِدُونَ مَلْجَـًٔا أَوْ مَغَـٰرَٰتٍ أَوْ مُدَّخَلًا لَّوَلَّوْا۟ إِلَيْهِ وَهُمْ يَجْمَحُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "009/057",
            "text": "Eğer onlar bir sığınak ya da (kalacak) mağaralar veya girebilecekleri bir yer bulsalardı, hızla oraya yönelip koşarlardı."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "009/057",
            "text": "Bir sığınak veya mağara yahut girecek bir yer bulmuş olsalardı, çarçabuk oraya yönelirlerdi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "009/057",
            "text": "If they could find a refuge or some caves or any place to enter [and hide], they would turn to it while they run heedlessly."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "009/057",
            "text": "If they could find any shelter or any cavern, or any retreat, they would turn around and rush headlong into it."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
