      "ayahs": [
        {
          "ref": "014/015",
          "surah": 14,
          "ayah": 15,
          "arabic": "وَٱسْتَفْتَحُوا۟ وَخَابَ كُلُّ جَبَّارٍ عَنِيدٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "014/015",
            "text": "(Peygamberler) Fetih istediler, (sonunda) her zorba inatçı bozguna uğrayıp -yok oldu- gitti."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "014/015",
            "text": "Peygamberler yardım istediler ve her inatçı zorba hüsrana uğradı."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "014/015",
            "text": "And they requested victory from Allah, and disappointed, [therefore], was every obstinate tyrant."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "014/015",
            "text": "They sought Our judgement. And (thanks to that judgement) every obstinate tyrant opposed to the Truth was brought to naught."
          }
        },
        {
          "ref": "014/016",
          "surah": 14,
          "ayah": 16,
          "arabic": "مِّن وَرَآئِهِۦ جَهَنَّمُ وَيُسْقَىٰ مِن مَّآءٍ صَدِيدٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "014/016",
            "text": "(Böylesinin) Önünde cehennem vardır ve (orada) irinli sudan içirilecektir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "014/016",
            "text": "Ardında cehennem vardır; orada kendisine irinli su içirilecektir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "014/016",
            "text": "Before him is Hell, and he will be given a drink of purulent water."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "014/016",
            "text": "Hell is before him and he shall be made to drink of the oozing pus,"
          }
        }
      ],
      "status": "approved",
