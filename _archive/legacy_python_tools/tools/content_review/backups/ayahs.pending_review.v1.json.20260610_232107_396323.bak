      "input": {
        "sira": 871,
        "ref": "026/082-089",
        "input_type": "aralik",
        "input_ayah_count": 8,
        "input_char_count": 452,
        "input_status": "ok",
        "input_source_ref_groups": "026/082, 026/083, 026/084, 026/085, 026/086, 026/087, 026/088, 026/089"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "026/082",
        "026/083",
        "026/084",
        "026/085",
        "026/086",
        "026/087",
