          "ayah": 31,
          "arabic": "وَأُزْلِفَتِ ٱلْجَنَّةُ لِلْمُتَّقِينَ غَيْرَ بَعِيدٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "050/031",
            "text": "Cennet de, muttakiler için, uzakta değildir, (o gün) yakınlaştırılmıştır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "050/031",
            "text": "Cennet, Allah'a karşı gelmekten sakınanlara yaklaştırılır, zaten uzakta değildir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "050/031",
            "text": "And Paradise will be brought near to the righteous, not far,"
