          "surah": 26,
          "ayah": 221,
          "arabic": "هَلْ أُنَبِّئُكُمْ عَلَىٰ مَن تَنَزَّلُ ٱلشَّيَـٰطِينُ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "026/221",
            "text": "Şeytanların kimlere inmekte olduklarını size haber vereyim mi?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "026/221",
            "text": "\"Şeytanların kime indiğini size haber vereyim mi?\" de."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "026/221",
            "text": "Shall I inform you upon whom the devils descend?"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "026/221",
            "text": "O people, shall I tell you on whom it is that satans descend?"
          }
        }
      ],
