          "ref": "088/017",
          "surah": 88,
          "ayah": 17,
          "arabic": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "088/017",
            "text": "Bakmıyorlar mı o deveye; nasıl yaratıldı?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "088/017",
            "text": "Bu insanlar, devenin nasıl yaratıldığına, göğün nasıl yükseltildiğine, dağların nasıl dikildiğine, yerin nasıl yayıldığına bir bakmazlar mı?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "088/017",
            "text": "Then do they not look at the camels - how they are created?"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "088/017",
            "text": "Do (these unbelievers) not observe the camels: how they were created?"
          }
        }
      ],
