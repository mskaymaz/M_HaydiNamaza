      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "070/042"
      ],
      "ayahs": [
        {
          "ref": "070/042",
          "surah": 70,
          "ayah": 42,
          "arabic": "فَذَرْهُمْ يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ يُلَـٰقُوا۟ يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "070/042",
            "text": "Şu halde sen, kendilerine vadedilen (azap) günlerine kavuşuncaya kadar onları bırak; dalıp-oynasınlar, oyalansınlar."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "070/042",
            "text": "Onları bırak; kendilerine söz verilen güne kavuşmalarına kadar dalıp oynasınlar."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "070/042",
            "text": "So leave them to converse vainly and amuse themselves until they meet their Day which they are promised -"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "070/042",
            "text": "So leave them to engage in vain talk and to amuse themselves until they come face to face with the Day which they are promised,"
          }
        }
      ],
      "status": "approved",
