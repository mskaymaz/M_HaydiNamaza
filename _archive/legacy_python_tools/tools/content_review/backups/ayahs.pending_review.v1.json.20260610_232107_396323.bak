          "surah": 82,
          "ayah": 10,
          "arabic": "وَإِنَّ عَلَيْكُمْ لَحَـٰفِظِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "082/010",
            "text": "Oysa gerçekten sizin üzerinizde koruyucular var,"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "082/010",
            "text": "Oysa, yaptıklarınızı bilen değerli yazıcılar sizi gözetlemektedirler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "082/010",
            "text": "And indeed, [appointed] over you are keepers,"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "082/010",
            "text": "you do so the while there are watchers over you;"
          }
        }
      ],
