          "ref": "004/151",
          "surah": 4,
          "ayah": 151,
          "arabic": "أُو۟لَـٰٓئِكَ هُمُ ٱلْكَـٰفِرُونَ حَقًّا ۚ وَأَعْتَدْنَا لِلْكَـٰفِرِينَ عَذَابًا مُّهِينًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/151",
            "text": "İşte bunlar, gerçekten kafir olanlardır. Kafirlere aşağılatıcı bir azap hazırlamışızdır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/151",
            "text": "Allah'ı ve peygamberlerini inkar eden, Allah'la peygamberleri arasını ayırmak isteyen, \"Bir kısmına inanır bir kısmını inkar ederiz\" diyerek ikisi arasında bir yol tutmak isteyenler, işte onlar gerçekten kafir olanlardır. Kafirlere ağır bir azab hazırlamışızdır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/151",
            "text": "Those are the disbelievers, truly. And We have prepared for the disbelievers a humiliating punishment."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/151",
            "text": "It is they, indeed they, who are, beyond all doubt, unbelievers; and for the unbelievers We have prepared a humiliating chastisement."
          }
        }
