    {
      "ref": "011/018",
      "id": "011/018",
      "surah": 11,
      "ayahStart": 18,
      "ayahEnd": 18,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 601,
        "ref": "011/018",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 219,
        "input_status": "ok",
        "input_source_ref_groups": "011/018"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "011/018"
      ],
      "ayahs": [
        {
          "ref": "011/018",
          "surah": 11,
          "ayah": 18,
          "arabic": "وَمَنْ أَظْلَمُ مِمَّنِ ٱفْتَرَىٰ عَلَى ٱللَّهِ كَذِبًا ۚ أُو۟لَـٰٓئِكَ يُعْرَضُونَ عَلَىٰ رَبِّهِمْ وَيَقُولُ ٱلْأَشْهَـٰدُ هَـٰٓؤُلَآءِ ٱلَّذِينَ كَذَبُوا۟ عَلَىٰ رَبِّهِمْ ۚ أَلَا لَعْنَةُ ٱللَّهِ عَلَى ٱلظَّـٰلِمِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "011/018",
            "text": "Allah’a karşı yalan uydurup iftira düzenden daha zalim kimdir? İşte bunlar, Rablerine sunulacaklar ve şahidler: \"Rablerine karşı yalan söyleyenler bunlardır\" diyecekler. Haberiniz olsun; Allah'ın laneti zalimlerin üzerinedir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "011/018",
            "text": "Yalan söyleyerek Allah'a iftira edenden daha zalim kim vardır? İşte bunlar Rablerine götürülürler ve şahidler: \"Rablerine yalan söyleyenler bunlardır\" derler. Bilin ki Allah'ın laneti haksızlık yapanlaradır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "011/018",
            "text": "And who is more unjust than he who invents a lie about Allah? Those will be presented before their Lord, and the witnesses will say, \"These are the ones who lied against their Lord.\" Unquestionably, the curse of Allah is upon the wrongdoers."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "011/018",
            "text": "And who is a greater wrong-doer than he who invents a lie against Allah? Such men will be set forth before their Lord and witnesses will say: 'These are the ones who lied against their Lord. Lo! Allah's curse be upon the wrong-doers;"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Hud",
      "ayah_number": 18,
      "ayah_end_number": 18,
      "text_ar": "وَمَنْ أَظْلَمُ مِمَّنِ ٱفْتَرَىٰ عَلَى ٱللَّهِ كَذِبًا ۚ أُو۟لَـٰٓئِكَ يُعْرَضُونَ عَلَىٰ رَبِّهِمْ وَيَقُولُ ٱلْأَشْهَـٰدُ هَـٰٓؤُلَآءِ ٱلَّذِينَ كَذَبُوا۟ عَلَىٰ رَبِّهِمْ ۚ أَلَا لَعْنَةُ ٱللَّهِ عَلَى ٱلظَّـٰلِمِينَ",
      "text_tr": "Allah’a karşı yalan uydurup iftira düzenden daha zalim kimdir? İşte bunlar, Rablerine sunulacaklar ve şahidler: \"Rablerine karşı yalan söyleyenler bunlardır\" diyecekler. Haberiniz olsun; Allah'ın laneti zalimlerin üzerinedir.",
      "text_en": "And who is more unjust than he who invents a lie about Allah? Those will be presented before their Lord, and the witnesses will say, \"These are the ones who lied against their Lord.\" Unquestionably, the curse of Allah is upon the wrongdoers.",
      "priority": 1,
      "notes": "bulk approved from local Tanzil source",
      "createdAt": "2026-06-09T08:52:44+00:00",
      "updatedAt": "2026-06-09T08:52:44+00:00",
      "approvedAt": "2026-06-09T08:52:44+00:00",
