    {
      "ref": "027/032-035",
      "id": "027/032-035",
      "surah": 27,
      "ayahStart": 32,
      "ayahEnd": 35,
      "type": "range",
      "ayahCount": 4,
      "input": {
        "sira": 900,
        "ref": "027/032-035",
        "input_type": "aralik",
        "input_ayah_count": 4,
        "input_char_count": 462,
        "input_status": "ok",
        "input_source_ref_groups": "027/032, 027/033, 027/034, 027/035"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "027/032",
        "027/033",
        "027/034",
        "027/035"
      ],
      "ayahs": [
        {
          "ref": "027/032",
          "surah": 27,
          "ayah": 32,
          "arabic": "قَالَتْ يَـٰٓأَيُّهَا ٱلْمَلَؤُا۟ أَفْتُونِى فِىٓ أَمْرِى مَا كُنتُ قَاطِعَةً أَمْرًا حَتَّىٰ تَشْهَدُونِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "027/032",
            "text": "Dedi ki: \"Ey önde gelenler, bu işimde bana görüş belirtin, siz (herşeye) şahidlik etmedikçe ben hiçbir işte kesin (karar veren biri) değilim.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "027/032",
            "text": "\"Ey ileri gelenler! Vereceğim emir hakkında bana fikrinizi söyleyin; siz benim yanımda bulunmadıkça, bir iş hakkında kesin bir hüküm vermem\" dedi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "027/032",
            "text": "She said, \"O eminent ones, advise me in my affair. I would not decide a matter until you witness [for] me.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "027/032",
            "text": "(After reading the letter) the Queen said: \"Nobles, let me have your counsel in this matter for I make no firm decision without you.\""
          }
        },
        {
          "ref": "027/033",
          "surah": 27,
          "ayah": 33,
          "arabic": "قَالُوا۟ نَحْنُ أُو۟لُوا۟ قُوَّةٍ وَأُو۟لُوا۟ بَأْسٍ شَدِيدٍ وَٱلْأَمْرُ إِلَيْكِ فَٱنظُرِى مَاذَا تَأْمُرِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "027/033",
            "text": "Dediler ki: \"Biz kuvvet sahibiyiz ve zorlu savaşçılarız. İş konusunda karar senindir, artık sen bak, neyi emredersen (biz uygularız)."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "027/033",
            "text": "\"Biz güçlü kimseler ve zorlu savaş adamlarıyız, emir senindir, sen emretmene bak.\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "027/033",
            "text": "They said, \"We are men of strength and of great military might, but the command is yours, so see what you will command.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "027/033",
            "text": "They said: \"We are strong and are given to vehement fighting. But the decision is yours. Therefore, consider what you would like to command.\""
          }
        },
        {
          "ref": "027/034",
          "surah": 27,
          "ayah": 34,
          "arabic": "قَالَتْ إِنَّ ٱلْمُلُوكَ إِذَا دَخَلُوا۟ قَرْيَةً أَفْسَدُوهَا وَجَعَلُوٓا۟ أَعِزَّةَ أَهْلِهَآ أَذِلَّةً ۖ وَكَذَٰلِكَ يَفْعَلُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "027/034",
            "text": "Dedi ki: \"Gerçekten hükümdarlar bir ülkeye girdikleri zaman, orasını bozguna uğratırlar ve halkından onur sahibi olanları hor ve aşağılık kılarlar; işte onlar, böyle yaparlar.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "027/034",
            "text": "Melike: \"Doğrusu hükümdarlar bir şehre girdikleri zaman orasını bozarlar, onurlu kimselerini aşağılık yaparlar. İşte böyle davranırlar. Ben onlara bir hediye göndereyim de, elçilerin ne ile döneceklerine bakayım\" dedi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "027/034",
            "text": "She said, \"Indeed kings - when they enter a city, they ruin it and render the honored of its people humbled. And thus do they do."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "027/034",
            "text": "The Queen said: \"When the kings enter a country they cause corruption in it and abase those of its people who are held in honour. This is what they are wont to do."
          }
        },
        {
          "ref": "027/035",
          "surah": 27,
          "ayah": 35,
          "arabic": "وَإِنِّى مُرْسِلَةٌ إِلَيْهِم بِهَدِيَّةٍ فَنَاظِرَةٌۢ بِمَ يَرْجِعُ ٱلْمُرْسَلُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "027/035",
            "text": "\"Ben onlara bir hediye göndereyim de, bir bakayım elçiler neyle dönerler.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "027/035",
            "text": "Melike: \"Doğrusu hükümdarlar bir şehre girdikleri zaman orasını bozarlar, onurlu kimselerini aşağılık yaparlar. İşte böyle davranırlar. Ben onlara bir hediye göndereyim de, elçilerin ne ile döneceklerine bakayım\" dedi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "027/035",
            "text": "But indeed, I will send to them a gift and see with what [reply] the messengers will return.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "027/035",
            "text": "I will send them a gift and then see with what answer my envoys return.\""
          }
        }
      ],
      "status": "approved",
