      "sourceRefGroups": [
        "019/019"
      ],
      "ayahs": [
        {
          "ref": "019/019",
          "surah": 19,
          "ayah": 19,
          "arabic": "قَالَ إِنَّمَآ أَنَا۠ رَسُولُ رَبِّكِ لِأَهَبَ لَكِ غُلَـٰمًا زَكِيًّا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "019/019",
            "text": "Demişti ki: \"Ben, yalnızca Rabbinden (gelen) bir elçiyim; sana tertemiz bir erkek çocuk armağan etmek için (buradayım).\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "019/019",
            "text": "Cebrail: \"Ben temiz bir oğlan bağışlamak için Rabbinin sana gönderdiği elçiden başkası değilim\" dedi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "019/019",
            "text": "He said, \"I am only the messenger of your Lord to give you [news of] a pure boy.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "019/019",
            "text": "He said: \"I am just a message-bearer of your Lord, I have come to grant you a most pure boy.\""
          }
        }
      ],
