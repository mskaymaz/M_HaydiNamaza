      "sourceRefGroups": [
        "089/016"
      ],
      "ayahs": [
        {
          "ref": "089/016",
          "surah": 89,
          "ayah": 16,
          "arabic": "وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَـٰنَنِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "089/016",
            "text": "Ama ne zaman onu deneyerek, rızkını kıssa, hemen: \"Rabbim bana ihanet etti\" der."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "089/016",
            "text": "Ama onu sınamak için rızkını daraltıp bir ölçüye göre verdiği zaman: \"Rabbim bana hor baktı\" der."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "089/016",
            "text": "But when He tries him and restricts his provision, he says, \"My Lord has humiliated me.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "089/016",
            "text": "But when He tests him by straitening his sustenance, he says: “My Lord has humiliated me.”"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
