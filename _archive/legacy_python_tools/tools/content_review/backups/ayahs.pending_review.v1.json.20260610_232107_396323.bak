    {
      "ref": "018/007",
      "id": "018/007",
      "surah": 18,
      "ayahStart": 7,
      "ayahEnd": 7,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 724,
        "ref": "018/007",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 118,
        "input_status": "ok",
        "input_source_ref_groups": "018/007"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "018/007"
      ],
      "ayahs": [
        {
          "ref": "018/007",
          "surah": 18,
          "ayah": 7,
          "arabic": "إِنَّا جَعَلْنَا مَا عَلَى ٱلْأَرْضِ زِينَةً لَّهَا لِنَبْلُوَهُمْ أَيُّهُمْ أَحْسَنُ عَمَلًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "018/007",
            "text": "Şüphesiz Biz, yeryüzü üzerindeki şeyleri ona bir süs kıldık; onların hangisinin daha güzel davranışta bulunduğunu deneyelim diye."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "018/007",
            "text": "İnsanların hangisinin daha iyi iş işlediğini ortaya koyalım diye, yeryüzünde olan şeyleri, yeryüzünün süsü yaptık."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "018/007",
            "text": "Indeed, We have made that which is on the earth adornment for it that We may test them [as to] which of them is best in deed."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "018/007",
            "text": "Surely We have made all that is on the earth an embellishment for it in order to test people as to who of them is better in conduct."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Kehf",
      "ayah_number": 7,
      "ayah_end_number": 7,
      "text_ar": "إِنَّا جَعَلْنَا مَا عَلَى ٱلْأَرْضِ زِينَةً لَّهَا لِنَبْلُوَهُمْ أَيُّهُمْ أَحْسَنُ عَمَلًا",
      "text_tr": "Şüphesiz Biz, yeryüzü üzerindeki şeyleri ona bir süs kıldık; onların hangisinin daha güzel davranışta bulunduğunu deneyelim diye.",
      "text_en": "Indeed, We have made that which is on the earth adornment for it that We may test them [as to] which of them is best in deed.",
