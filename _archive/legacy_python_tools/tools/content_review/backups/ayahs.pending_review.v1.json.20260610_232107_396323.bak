          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "080/007",
            "text": "Oysa, onun temizlenip-arınmasından sana ne?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "080/007",
            "text": "Arınmak istememesinden sana ne?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "080/007",
            "text": "And not upon you [is any blame] if he will not be purified."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "080/007",
            "text": "though you are not to blame if he would not cleanse himself."
          }
