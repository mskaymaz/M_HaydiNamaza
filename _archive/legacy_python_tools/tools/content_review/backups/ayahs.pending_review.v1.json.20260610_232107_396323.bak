    {
      "ref": "006/100",
      "id": "006/100",
      "surah": 6,
      "ayahStart": 100,
      "ayahEnd": 100,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 406,
        "ref": "006/100",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 178,
        "input_status": "ok",
        "input_source_ref_groups": "006/100"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "006/100"
      ],
      "ayahs": [
        {
          "ref": "006/100",
          "surah": 6,
          "ayah": 100,
          "arabic": "وَجَعَلُوا۟ لِلَّهِ شُرَكَآءَ ٱلْجِنَّ وَخَلَقَهُمْ ۖ وَخَرَقُوا۟ لَهُۥ بَنِينَ وَبَنَـٰتٍۭ بِغَيْرِ عِلْمٍ ۚ سُبْحَـٰنَهُۥ وَتَعَـٰلَىٰ عَمَّا يَصِفُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "006/100",
            "text": "Cinleri Allah'a ortak koştular. Oysa onları O yaratmıştır. Bir de hiçbir bilgiye dayanmaksızın O'na oğullar ve kızlar yakıştırıp-uydurdular. O ise nitelendiregeldikleri şeylerden Yücedir, uzaktır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "006/100",
            "text": "Cinleri O yaratmışken kafirler Allah'a ortak koştular. Körü körüne O'na oğullar ve kızlar uydurdular. Haşa, O onların vasıflandırmalarından yücedir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "006/100",
            "text": "But they have attributed to Allah partners - the jinn, while He has created them - and have fabricated for Him sons and daughters. Exalted is He and high above what they describe"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "006/100",
            "text": "And yet, some people have come to associate the jinn with Allah in His divinity, even though it is He Who created them; and in ignorance they impute to Him sons and daughters. He is Holy and Exalted far above that which they attribute to Him."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
