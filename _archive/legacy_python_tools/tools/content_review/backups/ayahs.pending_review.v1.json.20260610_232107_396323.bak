      "input": {
        "sira": 283,
        "ref": "004/104-105",
        "input_type": "aralik",
        "input_ayah_count": 2,
        "input_char_count": 426,
        "input_status": "ok",
        "input_source_ref_groups": "004/104, 004/105"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "004/104",
        "004/105"
      ],
      "ayahs": [
        {
          "ref": "004/104",
          "surah": 4,
          "ayah": 104,
          "arabic": "وَلَا تَهِنُوا۟ فِى ٱبْتِغَآءِ ٱلْقَوْمِ ۖ إِن تَكُونُوا۟ تَأْلَمُونَ فَإِنَّهُمْ يَأْلَمُونَ كَمَا تَأْلَمُونَ ۖ وَتَرْجُونَ مِنَ ٱللَّهِ مَا لَا يَرْجُونَ ۗ وَكَانَ ٱللَّهُ عَلِيمًا حَكِيمًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/104",
            "text": "(Düşmanınız olan) Topluluğu aramakta gevşeklik göstermeyin. Siz acı çekiyorsanız, şüphesiz onlar da, sizin acı çektiğiniz gibi acı çekiyorlar. Oysa siz, onların umud etmediklerini Allah'tan umuyorsunuz. Allah, bilendir, hüküm ve hikmet sahibidir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/104",
            "text": "Düşman milleti kovalamakta gevşeklik göstermeyin. Eğer siz acı çekiyorsanız, şüphesiz onlar da sizin çektiğiniz gibi acı çekiyorlar; oysa siz Allah'tan onların beklemedikleri şeyleri bekliyorsunuz. Allah Bilendir, Hakim olandır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/104",
            "text": "And do not weaken in pursuit of the enemy. If you should be suffering - so are they suffering as you are suffering, but you expect from Allah that which they expect not. And Allah is ever Knowing and Wise."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/104",
            "text": "Do not be faint of heart in pursuing these people: if you happen to suffer harm they too are suffering just as you are, while you may hope from Allah what they cannot hope for. Allah is All-Knowing, All- Wise."
          }
        },
        {
          "ref": "004/105",
          "surah": 4,
          "ayah": 105,
          "arabic": "إِنَّآ أَنزَلْنَآ إِلَيْكَ ٱلْكِتَـٰبَ بِٱلْحَقِّ لِتَحْكُمَ بَيْنَ ٱلنَّاسِ بِمَآ أَرَىٰكَ ٱللَّهُ ۚ وَلَا تَكُن لِّلْخَآئِنِينَ خَصِيمًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/105",
            "text": "Şüphesiz, Allah'ın sana gösterdiği gibi insanlar arasında hükmetmen için Biz sana kitabı hak olarak indirdik. (Sakın) Hainlerin savunucusu olma."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/105",
            "text": "Doğrusu, insanlar arasında Allah'ın sana gösterdiği gibi hükmedesin diye Kitap'ı sana hak olarak indirdik; hakkı gözet, hainlerden taraf olma."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/105",
            "text": "Indeed, We have revealed to you, [O Muhammad], the Book in truth so you may judge between the people by that which Allah has shown you. And do not be for the deceitful an advocate."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/105",
            "text": "(O Messenger!) We have revealed to you this Book with the Truth so that you may judge between people in accordance with what Allah has shown you. So do not dispute on behalf of the dishonest,"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Nisa",
      "ayah_number": 104,
      "ayah_end_number": 105,
      "text_ar": "﴿104﴾ وَلَا تَهِنُوا۟ فِى ٱبْتِغَآءِ ٱلْقَوْمِ ۖ إِن تَكُونُوا۟ تَأْلَمُونَ فَإِنَّهُمْ يَأْلَمُونَ كَمَا تَأْلَمُونَ ۖ وَتَرْجُونَ مِنَ ٱللَّهِ مَا لَا يَرْجُونَ ۗ وَكَانَ ٱللَّهُ عَلِيمًا حَكِيمًا\n\n﴿105﴾ إِنَّآ أَنزَلْنَآ إِلَيْكَ ٱلْكِتَـٰبَ بِٱلْحَقِّ لِتَحْكُمَ بَيْنَ ٱلنَّاسِ بِمَآ أَرَىٰكَ ٱللَّهُ ۚ وَلَا تَكُن لِّلْخَآئِنِينَ خَصِيمًا",
      "text_tr": "[104] (Düşmanınız olan) Topluluğu aramakta gevşeklik göstermeyin. Siz acı çekiyorsanız, şüphesiz onlar da, sizin acı çektiğiniz gibi acı çekiyorlar. Oysa siz, onların umud etmediklerini Allah'tan umuyorsunuz. Allah, bilendir, hüküm ve hikmet sahibidir.\n\n[105] Şüphesiz, Allah'ın sana gösterdiği gibi insanlar arasında hükmetmen için Biz sana kitabı hak olarak indirdik. (Sakın) Hainlerin savunucusu olma.",
      "text_en": "[104] And do not weaken in pursuit of the enemy. If you should be suffering - so are they suffering as you are suffering, but you expect from Allah that which they expect not. And Allah is ever Knowing and Wise.\n\n[105] Indeed, We have revealed to you, [O Muhammad], the Book in truth so you may judge between the people by that which Allah has shown you. And do not be for the deceitful an advocate.",
      "priority": 1,
      "notes": "bulk approved from local Tanzil source",
