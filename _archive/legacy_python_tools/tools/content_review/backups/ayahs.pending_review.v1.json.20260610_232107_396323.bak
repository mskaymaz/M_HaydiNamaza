      "input": {
        "sira": 970,
        "ref": "033/012",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 123,
        "input_status": "ok",
        "input_source_ref_groups": "033/012"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "033/012"
      ],
      "ayahs": [
        {
          "ref": "033/012",
          "surah": 33,
          "ayah": 12,
          "arabic": "وَإِذْ يَقُولُ ٱلْمُنَـٰفِقُونَ وَٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌ مَّا وَعَدَنَا ٱللَّهُ وَرَسُولُهُۥٓ إِلَّا غُرُورًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "033/012",
            "text": "Hani, münafık olanlar ve kalplerinde hastalık bulunanlar: \"Allah ve Resulü, bize boş bir aldanıştan başka bir şey vadetmedi\" diyorlardı."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "033/012",
            "text": "İkiyüzlüler ve kalblerinde hastalık olanlar: \"Allah ve Peygamberi bize sadece kuru vaadlerde bulundular\" diyorlardı."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "033/012",
            "text": "And [remember] when the hypocrites and those in whose hearts is disease said, \"Allah and His Messenger did not promise us except delusion,\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "033/012",
            "text": "And call to mind when the hypocrites and all those with diseased hearts said: “All that Allah and His Messenger had promised us was nothing but deceit.”"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
