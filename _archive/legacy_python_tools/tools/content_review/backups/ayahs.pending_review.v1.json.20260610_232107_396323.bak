      "sourceRefGroups": [
        "002/003"
      ],
      "ayahs": [
        {
          "ref": "002/003",
          "surah": 2,
          "ayah": 3,
          "arabic": "ٱلَّذِينَ يُؤْمِنُونَ بِٱلْغَيْبِ وَيُقِيمُونَ ٱلصَّلَوٰةَ وَمِمَّا رَزَقْنَـٰهُمْ يُنفِقُونَ",
          "tr": {
            "source": "Tanzil tr.bulac - Ali Bulaç",
            "text": "Onlar, gaybe inanırlar, namazı dosdoğru kılarlar ve kendilerine rızık olarak verdiklerimizden infak ederler."
          },
          "en": {
            "source": "Tanzil en.sahih - Saheeh International",
            "text": "Who believe in the unseen, establish prayer, and spend out of what We have provided for them,"
          },
          "alternatives": {
            "tr_diyanet_tanzil": {
              "source": "Tanzil tr.diyanet - Diyanet İşleri",
              "text": "Onlar, gaybe inanırlar, namazı kılarlar, kendilerine verdiğimiz rızıktan yerli yerince sarfederler."
            },
            "en_maududi": {
              "source": "Tanzil en.maududi - Abul A’la Maududi",
              "text": "who believe in the unseen, establish the Salats and expend (in Our way) out of what We have bestowed on them;"
            }
          }
        }
      ],
      "status": "pending_review",
