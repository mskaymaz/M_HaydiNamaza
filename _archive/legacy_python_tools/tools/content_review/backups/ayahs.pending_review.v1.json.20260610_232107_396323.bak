      "input": {
        "sira": 1340,
        "ref": "072/021",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 74,
        "input_status": "ok",
        "input_source_ref_groups": "072/021"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "072/021"
      ],
      "ayahs": [
        {
          "ref": "072/021",
          "surah": 72,
          "ayah": 21,
          "arabic": "قُلْ إِنِّى لَآ أَمْلِكُ لَكُمْ ضَرًّا وَلَا رَشَدًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "072/021",
            "text": "De ki: \"Doğrusu ben, sizin için ne bir zarar, ne de bir yarar (irşad) sağlayabilirim.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "072/021",
            "text": "De ki: \"Ben size zarar vermeye de iyilik yapmaya da kadir değilim.\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "072/021",
            "text": "Say, \"Indeed, I do not possess for you [the power of] harm or right direction.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "072/021",
            "text": "Say: “Surely neither it is in my power to hurt you nor to bring you to the Right Way.”"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
