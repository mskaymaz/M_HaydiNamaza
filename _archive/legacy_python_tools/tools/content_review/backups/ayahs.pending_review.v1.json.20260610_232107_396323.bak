    {
      "ref": "004/124",
      "id": "004/124",
      "surah": 4,
      "ayahStart": 124,
      "ayahEnd": 124,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 290,
        "ref": "004/124",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 132,
        "input_status": "ok",
        "input_source_ref_groups": "004/124"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "004/124"
      ],
      "ayahs": [
        {
          "ref": "004/124",
          "surah": 4,
          "ayah": 124,
          "arabic": "وَمَن يَعْمَلْ مِنَ ٱلصَّـٰلِحَـٰتِ مِن ذَكَرٍ أَوْ أُنثَىٰ وَهُوَ مُؤْمِنٌ فَأُو۟لَـٰٓئِكَ يَدْخُلُونَ ٱلْجَنَّةَ وَلَا يُظْلَمُونَ نَقِيرًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/124",
            "text": "Erkek olsun, kadın olsun inanmış olarak kim salih bir amelde bulunursa, onlar cennete girecek ve onlar, bir 'çekirdeğin sırtındaki tomurcuk kadar' bile haksızlığa uğramayacaklardır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/124",
            "text": "Erkek veya kadın, mümin olarak, kim yararlı işler işlerse, işte onlar cennete girerler, kendilerine zerre kadar zulmedilmez."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/124",
            "text": "And whoever does righteous deeds, whether male or female, while being a believer - those will enter Paradise and will not be wronged, [even as much as] the speck on a date seed."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/124",
            "text": "Whoever does good and believes -whether he is male or female - such shall enter the Garden, and they shall not be wronged in the slightest."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Nisa",
      "ayah_number": 124,
      "ayah_end_number": 124,
      "text_ar": "وَمَن يَعْمَلْ مِنَ ٱلصَّـٰلِحَـٰتِ مِن ذَكَرٍ أَوْ أُنثَىٰ وَهُوَ مُؤْمِنٌ فَأُو۟لَـٰٓئِكَ يَدْخُلُونَ ٱلْجَنَّةَ وَلَا يُظْلَمُونَ نَقِيرًا",
      "text_tr": "Erkek olsun, kadın olsun inanmış olarak kim salih bir amelde bulunursa, onlar cennete girecek ve onlar, bir 'çekirdeğin sırtındaki tomurcuk kadar' bile haksızlığa uğramayacaklardır.",
