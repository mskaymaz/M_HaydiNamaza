        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 159,
        "input_status": "ok",
        "input_source_ref_groups": "010/081"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "010/081"
      ],
      "ayahs": [
        {
          "ref": "010/081",
          "surah": 10,
          "ayah": 81,
          "arabic": "فَلَمَّآ أَلْقَوْا۟ قَالَ مُوسَىٰ مَا جِئْتُم بِهِ ٱلسِّحْرُ ۖ إِنَّ ٱللَّهَ سَيُبْطِلُهُۥٓ ۖ إِنَّ ٱللَّهَ لَا يُصْلِحُ عَمَلَ ٱلْمُفْسِدِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "010/081",
            "text": "Onlar atınca, Musa dedi ki: \"Sizlerin (ortaya) getirdiğiniz büyüdür. Doğrusu Allah onu geçersiz kılacaktır. Şüphesiz Allah, bozgunculuk çıkaranların işini düzeltmez.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "010/081",
            "text": "Attıklarında, Musa: \"Yaptığınız sihirdir, fakat Allah onu boşa çıkaracaktır. Allah bozguncuların işini elbette düzeltmez. Suçlular istemese de Allah sözleriyle hakkı gerçekleştirecektir\" dedi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "010/081",
            "text": "And when they had thrown, Moses said, \"What you have brought is [only] magic. Indeed, Allah will expose its worthlessness. Indeed, Allah does not amend the work of corrupters."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "010/081",
            "text": "Then when they had cast (their staffs), Moses said: 'What you have produced is sheer sorcery. Allah will certainly reduce it to naught. Surely Allah does not set right the work of the mischief-makers."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
