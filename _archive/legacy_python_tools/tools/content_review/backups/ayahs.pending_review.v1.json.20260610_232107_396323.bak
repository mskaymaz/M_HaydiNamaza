        "input_char_count": 225,
        "input_status": "ok",
        "input_source_ref_groups": "020/105, 020/106, 020/107"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "020/105",
        "020/106",
        "020/107"
      ],
      "ayahs": [
        {
          "ref": "020/105",
          "surah": 20,
          "ayah": 105,
          "arabic": "وَيَسْـَٔلُونَكَ عَنِ ٱلْجِبَالِ فَقُلْ يَنسِفُهَا رَبِّى نَسْفًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "020/105",
            "text": "Sana dağlar hakkında soruyorlar. De ki: \"Benim Rabbim, onları darmadağın edip savuracak\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "020/105",
            "text": "Sana dağları sorarlar; de ki: \"Rabbim onları ufalayıp savuracak, yerlerini düz, kuru bir toprak haline getirecek; orada ne çukur, ne tümsek göreceksin. O gün, hiçbir tarafa sapmadan bir davetçiye uyarlar. Sesler Rahman'ın heybetinden kısılmıştır; ancak bir fısıltı işitirsin.\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "020/105",
            "text": "And they ask you about the mountains, so say, \"My Lord will blow them away with a blast."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "020/105",
            "text": "They ask you concerning the mountains: \"Where will they go?\" Say: \"My Lord will scatter them like dust,"
          }
        },
        {
          "ref": "020/106",
          "surah": 20,
          "ayah": 106,
          "arabic": "فَيَذَرُهَا قَاعًا صَفْصَفًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "020/106",
            "text": "\"Yerlerini bomboş, çırçıplak bırakacaktır.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "020/106",
            "text": "Sana dağları sorarlar; de ki: \"Rabbim onları ufalayıp savuracak, yerlerini düz, kuru bir toprak haline getirecek; orada ne çukur, ne tümsek göreceksin. O gün, hiçbir tarafa sapmadan bir davetçiye uyarlar. Sesler Rahman'ın heybetinden kısılmıştır; ancak bir fısıltı işitirsin.\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "020/106",
            "text": "And He will leave the earth a level plain;"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "020/106",
            "text": "and leave the earth a levelled plain"
          }
        },
        {
          "ref": "020/107",
          "surah": 20,
          "ayah": 107,
          "arabic": "لَّا تَرَىٰ فِيهَا عِوَجًا وَلَآ أَمْتًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "020/107",
            "text": "\"Orada ne bir eğrilik göreceksin, ne de bir tümsek.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "020/107",
            "text": "Sana dağları sorarlar; de ki: \"Rabbim onları ufalayıp savuracak, yerlerini düz, kuru bir toprak haline getirecek; orada ne çukur, ne tümsek göreceksin. O gün, hiçbir tarafa sapmadan bir davetçiye uyarlar. Sesler Rahman'ın heybetinden kısılmıştır; ancak bir fısıltı işitirsin.\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "020/107",
            "text": "You will not see therein a depression or an elevation.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "020/107",
            "text": "in which you shall find no crookedness or curvature."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
