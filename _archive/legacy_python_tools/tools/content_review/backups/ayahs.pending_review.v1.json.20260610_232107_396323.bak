    {
      "ref": "006/057",
      "id": "006/057",
      "surah": 6,
      "ayahStart": 57,
      "ayahEnd": 57,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 399,
        "ref": "006/057",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 241,
        "input_status": "ok",
        "input_source_ref_groups": "006/057"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "006/057"
      ],
      "ayahs": [
        {
          "ref": "006/057",
          "surah": 6,
          "ayah": 57,
          "arabic": "قُلْ إِنِّى عَلَىٰ بَيِّنَةٍ مِّن رَّبِّى وَكَذَّبْتُم بِهِۦ ۚ مَا عِندِى مَا تَسْتَعْجِلُونَ بِهِۦٓ ۚ إِنِ ٱلْحُكْمُ إِلَّا لِلَّهِ ۖ يَقُصُّ ٱلْحَقَّ ۖ وَهُوَ خَيْرُ ٱلْفَـٰصِلِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "006/057",
            "text": "De ki: \"Ben, gerçekten Rabbimden kesin bir belge üzerindeyim, siz ise onu yalanladınız. Sizin kendisine acele ettiğiniz (azap) yanımda değildir. Hüküm yalnızca Allah'ındır. O, doğru haberi verir ve O, ayırt edenlerin en hayırlısıdır.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "006/057",
            "text": "De ki: \"Ben Rabbim'den bir belgeye dayanmaktayım, halbuki siz onu yalanladınız; acele istediğiniz de elimde değildir. Hüküm ancak Allah'ındır. O, hükmedenlerin en iyisi olarak gerçeği anlatır.\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "006/057",
            "text": "Say, \"Indeed, I am on clear evidence from my Lord, and you have denied it. I do not have that for which you are impatient. The decision is only for Allah. He relates the truth, and He is the best of deciders.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "006/057",
            "text": "Say: 'I take stand upon a clear evidence from my Lord and it is that which you have given the lie to. That which you desire to be hastened is not within my power. Judgement lies with Allah alone. He declares the Truth, and He is the best judge.'"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
