        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 95,
        "input_status": "ok",
        "input_source_ref_groups": "021/093"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "021/093"
      ],
      "ayahs": [
        {
          "ref": "021/093",
          "surah": 21,
          "ayah": 93,
          "arabic": "وَتَقَطَّعُوٓا۟ أَمْرَهُم بَيْنَهُمْ ۖ كُلٌّ إِلَيْنَا رَٰجِعُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "021/093",
            "text": "Onlar, işlerini kendi aralarında parça parça dağıttılar (dinlerinde bölünmeler yaptılar); hepsi Bize döneceklerdir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "021/093",
            "text": "Ama insanlar, din konusunda aralarında bölüklere ayrıldılar, hepsi Bize döneceklerdir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "021/093",
            "text": "And [yet] they divided their affair among themselves, [but] all to Us will return."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "021/093",
            "text": "But they tore asunder their faith into many parts. But to Us they are bound to return."
          }
        }
      ],
      "status": "approved",
