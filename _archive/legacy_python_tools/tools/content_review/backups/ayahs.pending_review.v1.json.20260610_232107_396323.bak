      "sourceRefGroups": [
        "053/052"
      ],
      "ayahs": [
        {
          "ref": "053/052",
          "surah": 53,
          "ayah": 52,
          "arabic": "وَقَوْمَ نُوحٍ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا۟ هُمْ أَظْلَمَ وَأَطْغَىٰ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "053/052",
            "text": "Daha önce Nuh kavmini de. Çünkü onlar, daha zalim ve daha azgındılar."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "053/052",
            "text": "Daha önce de Nuh milletini yok eden O'dur; çünkü onlar çok zalim ve pek taşkın kimselerdi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "053/052",
            "text": "And the people of Noah before. Indeed, it was they who were [even] more unjust and oppressing."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "053/052",
            "text": "and that He it is Who destroyed the people of Noah before for they were much given to iniquity and transgression."
          }
        }
      ],
      "status": "approved",
