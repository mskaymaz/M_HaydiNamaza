    {
      "ref": "066/012",
      "id": "066/012",
      "surah": 66,
      "ayahStart": 12,
      "ayahEnd": 12,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 1303,
        "ref": "066/012",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 209,
        "input_status": "ok",
        "input_source_ref_groups": "066/012"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "066/012"
      ],
      "ayahs": [
        {
          "ref": "066/012",
          "surah": 66,
          "ayah": 12,
          "arabic": "وَمَرْيَمَ ٱبْنَتَ عِمْرَٰنَ ٱلَّتِىٓ أَحْصَنَتْ فَرْجَهَا فَنَفَخْنَا فِيهِ مِن رُّوحِنَا وَصَدَّقَتْ بِكَلِمَـٰتِ رَبِّهَا وَكُتُبِهِۦ وَكَانَتْ مِنَ ٱلْقَـٰنِتِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "066/012",
            "text": "İmran'ın kızı Meryem'i de. Ki o kendi ırzını korumuştu. Böylece Biz ona ruhumuzdan üfledik. O da Rabbinin kelimelerini ve kitaplarını tasdik etti. O, (Rabbine) gönülden bağlı olanlardandı."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "066/012",
            "text": "Mahrem yerini korumuş olan İmran kızı Meryem de bir misaldir. Ona ruhumuzdan üflemiştik; Rabbinin sözlerini ve kitablarını tasdik etmişti; o, Bize gönülden itaat edenlerdendi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "066/012",
            "text": "And [the example of] Mary, the daughter of 'Imran, who guarded her chastity, so We blew into [her garment] through Our angel, and she believed in the words of her Lord and His scriptures and was of the devoutly obedient."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "066/012",
            "text": "Allah has also set forth the parable of Mary, the daughter of Imran, who guarded her chastity, and into whom We breathed of Our Spirit, and who testified to the words of her Lord and His Books. She was among the obedient."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
