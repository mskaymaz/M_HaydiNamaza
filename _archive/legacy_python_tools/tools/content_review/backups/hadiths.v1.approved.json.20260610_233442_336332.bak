    {
      "id": "hadith_001648",
      "type": "hadith",
      "collection": "Riyazu's-Salihin",
      "book": "Riyad as-Salihin 1648",
      "hadith_number": "1648",
      "narrator": "requires verification",
      "text_ar": "وعَنْ عائشة رضي اللَّه عنْهَا نَحْوُهُ، متفقٌ عليه.",
      "text_tr": "Hz. Ali’den (ra) rivayet edildiğine göre o, Resûlullah , kadının başını (ustura ile) tıraş etmesini yasakladı, demiştir.",
      "text_en": "A similar narration was narrated on the authority of 'Aishah.",
      "source_ar": "local_approved:riyazussalihin/1648:ar",
      "source_tr": "local_approved:riyazussalihin/1648:tr",
      "source_en": "local_approved:riyazussalihin/1648:en",
      "grade": "riyad_as_salihin_selection",
      "source_note": "local approved payload; approved_at=2026-06-09T08:35:54+00:00",
