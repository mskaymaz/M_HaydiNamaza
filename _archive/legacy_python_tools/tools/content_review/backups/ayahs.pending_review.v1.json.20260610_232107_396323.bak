    {
      "ref": "009/048",
      "id": "009/048",
      "surah": 9,
      "ayahStart": 48,
      "ayahEnd": 48,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 533,
        "ref": "009/048",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 177,
        "input_status": "ok",
        "input_source_ref_groups": "009/048"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "009/048"
      ],
      "ayahs": [
        {
          "ref": "009/048",
          "surah": 9,
          "ayah": 48,
          "arabic": "لَقَدِ ٱبْتَغَوُا۟ ٱلْفِتْنَةَ مِن قَبْلُ وَقَلَّبُوا۟ لَكَ ٱلْأُمُورَ حَتَّىٰ جَآءَ ٱلْحَقُّ وَظَهَرَ أَمْرُ ٱللَّهِ وَهُمْ كَـٰرِهُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "009/048",
            "text": "Andolsun, daha önce onlar fitne aramışlardı. Ve sana karşı birtakım işler çevirmişlerdi. Sonunda onlar, istemedikleri halde hak geldi ve Allah'ın emri ortaya çıkıp-üstünlük sağladı."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "009/048",
            "text": "And olsun ki, daha önce de fitne koparmak istemişlerdi. Sana karşı bir takım işler çeviriyorlardı, sonunda onlar istemedikleri halde hak ortaya çıktı, Allah'ın emri üstün geldi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "009/048",
            "text": "They had already desired dissension before and had upset matters for you until the truth came and the ordinance of Allah appeared, while they were averse."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "009/048",
            "text": "Surely they sought even earlier to stir up sedition, and turned things upside down to frustrate you until the Truth came and the decree of Allah appeared, however hateful this may have been to them."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
