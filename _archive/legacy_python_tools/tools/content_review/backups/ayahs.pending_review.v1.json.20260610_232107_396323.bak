          "ref": "083/001",
          "surah": 83,
          "ayah": 1,
          "arabic": "\\basmalah وَيْلٌ لِّلْمُطَفِّفِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "083/001",
            "text": "Eksik ölçüp tartanların vay haline,"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "083/001",
            "text": "İnsanlardan, kendileri bir şeyi ölçerek aldıkları zaman tam alan; ama onlara bir şeyi ölçüp tartarak verdiklerinde eksik tutan kimselerin, vay haline!"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "083/001",
            "text": "Woe to those who give less [than due],"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "083/001",
            "text": "Woe to the stinters;"
          }
        }
      ],
