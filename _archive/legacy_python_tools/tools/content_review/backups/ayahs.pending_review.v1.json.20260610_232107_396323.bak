      "ayahs": [
        {
          "ref": "038/078",
          "surah": 38,
          "ayah": 78,
          "arabic": "وَإِنَّ عَلَيْكَ لَعْنَتِىٓ إِلَىٰ يَوْمِ ٱلدِّينِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "038/078",
            "text": "\"Ve şüphesiz, din (kıyametteki hesap) gününe kadar Benim lanetim senin üzerinedir.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "038/078",
            "text": "Allah: \"Defol oradan, sen artık kovulmuş birisin. Din (kıyamet/ceza) gününe kadar lanetim senin üzerinedir\" dedi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "038/078",
            "text": "And indeed, upon you is My curse until the Day of Recompense.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "038/078",
            "text": "and My curse shall remain upon you till the Day of Resurrection.”"
          }
        }
      ],
