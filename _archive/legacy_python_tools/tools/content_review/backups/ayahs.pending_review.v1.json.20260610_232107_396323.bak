      "ayahs": [
        {
          "ref": "030/031",
          "surah": 30,
          "ayah": 31,
          "arabic": "مُنِيبِينَ إِلَيْهِ وَٱتَّقُوهُ وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَلَا تَكُونُوا۟ مِنَ ٱلْمُشْرِكِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "030/031",
            "text": "'Gönülden katıksız bağlılar' olarak, O'na yönelin ve O'ndan korkup-sakının, dosdoğru namazı kılın ve müşriklerden olmayın."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "030/031",
            "text": "Allah'a yönelerek O'na karşı gelmekten sakınınız, namaz kılınız, dinlerinde ayrılığa düşüp fırka fırka olan, her fırkasının da kendisinde bulunanla sevindiği müşriklerden olmayınız."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "030/031",
            "text": "[Adhere to it], turning in repentance to Him, and fear Him and establish prayer and do not be of those who associate others with Allah"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "030/031",
            "text": "(Adhere to the True Faith and) turn to Him, and hold Him in awe, and establish Prayer, and do not be of those who associate others with Allah in His Divinity,"
          }
        }
      ],
