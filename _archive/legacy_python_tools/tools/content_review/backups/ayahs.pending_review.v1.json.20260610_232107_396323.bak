        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 138,
        "input_status": "ok",
        "input_source_ref_groups": "061/011"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "061/011"
      ],
      "ayahs": [
        {
          "ref": "061/011",
          "surah": 61,
          "ayah": 11,
          "arabic": "تُؤْمِنُونَ بِٱللَّهِ وَرَسُولِهِۦ وَتُجَـٰهِدُونَ فِى سَبِيلِ ٱللَّهِ بِأَمْوَٰلِكُمْ وَأَنفُسِكُمْ ۚ ذَٰلِكُمْ خَيْرٌ لَّكُمْ إِن كُنتُمْ تَعْلَمُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "061/011",
            "text": "Allah'a ve O'nun Resulü’ne iman edersiniz, mallarınızla ve canlarınızla Allah yolunda mücadele edersiniz. Bu, sizin için daha hayırlıdır; eğer bilirseniz."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "061/011",
            "text": "Allah'a ve Peygamberine inanırsınız; Allah yolunda canlarınızla, mallarınızla cihat edersiniz; bilseniz, bu sizin için en iyi yoldur."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "061/011",
            "text": "[It is that] you believe in Allah and His Messenger and strive in the cause of Allah with your wealth and your lives. That is best for you, if you should know."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "061/011",
            "text": "Have faith in Allah and His Messenger and strive in the Way of Allah with your possessions and your lives. That is better for you if you only knew."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:50:08+00:00"
      },
