        "ref": "033/048",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 115,
        "input_status": "ok",
        "input_source_ref_groups": "033/048"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "033/048"
      ],
      "ayahs": [
        {
          "ref": "033/048",
          "surah": 33,
          "ayah": 48,
          "arabic": "وَلَا تُطِعِ ٱلْكَـٰفِرِينَ وَٱلْمُنَـٰفِقِينَ وَدَعْ أَذَىٰهُمْ وَتَوَكَّلْ عَلَى ٱللَّهِ ۚ وَكَفَىٰ بِٱللَّهِ وَكِيلًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "033/048",
            "text": "Kafirlere ve münafıklara itaat etme, eziyetlerine aldırma ve Allah'a tevekkül et. Vekil olarak Allah yeter."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "033/048",
            "text": "İnkarcılara, ikiyüzlülere itaat etme; eziyetlerine aldırma; Allah'a güven, güvenilecek olarak Allah yeter."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "033/048",
            "text": "And do not obey the disbelievers and the hypocrites but do not harm them, and rely upon Allah. And sufficient is Allah as Disposer of affairs."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "033/048",
            "text": "Do not yield to the unbelievers and the hypocrites, and disregard the hurt that comes from them, and put your trust in Allah. Allah suffices as the Guardian to entrust one's affairs to."
          }
        }
      ],
      "status": "approved",
