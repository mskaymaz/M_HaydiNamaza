      "ayahs": [
        {
          "ref": "047/009",
          "surah": 47,
          "ayah": 9,
          "arabic": "ذَٰلِكَ بِأَنَّهُمْ كَرِهُوا۟ مَآ أَنزَلَ ٱللَّهُ فَأَحْبَطَ أَعْمَـٰلَهُمْ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "047/009",
            "text": "İşte böyle; çünkü onlar, Allah'ın indirdiğini çirkin (kerih) gördüler, bundan dolayı, O da, onların amellerini boşa çıkardı."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "047/009",
            "text": "Bu, Allah'ın indirdiğini beğenmediklerinden ötürüdür. İşlerini Allah bunun için boşa çıkarmıştır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "047/009",
            "text": "That is because they disliked what Allah revealed, so He rendered worthless their deeds."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "047/009",
            "text": "That was because they were averse to what Allah had revealed; so He let their works go to waste."
          }
        }
      ],
