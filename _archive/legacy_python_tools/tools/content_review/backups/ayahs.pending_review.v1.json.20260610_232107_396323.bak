    {
      "ref": "035/005",
      "id": "035/005",
      "surah": 35,
      "ayahStart": 5,
      "ayahEnd": 5,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 1003,
        "ref": "035/005",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 144,
        "input_status": "ok",
        "input_source_ref_groups": "035/005"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "035/005"
      ],
      "ayahs": [
        {
          "ref": "035/005",
          "surah": 35,
          "ayah": 5,
          "arabic": "يَـٰٓأَيُّهَا ٱلنَّاسُ إِنَّ وَعْدَ ٱللَّهِ حَقٌّ ۖ فَلَا تَغُرَّنَّكُمُ ٱلْحَيَوٰةُ ٱلدُّنْيَا ۖ وَلَا يَغُرَّنَّكُم بِٱللَّهِ ٱلْغَرُورُ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "035/005",
            "text": "Ey insanlar, hiç şüphesiz Allah'ın va'di haktır; öyleyse dünya hayatı sizi aldatmasın ve aldatıcı(lar) da, sizi Allah ile (Allah'ın adını kullanarak) aldatmasın."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "035/005",
            "text": "Ey insanlar! Allah'ın verdiği söz şüphesiz gerçektir; dünya hayatı sizi aldatmasın. Allah'ın affına güvendirerek şeytan sizi ayartmasın."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "035/005",
            "text": "O mankind, indeed the promise of Allah is truth, so let not the worldly life delude you and be not deceived about Allah by the Deceiver."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "035/005",
            "text": "O people, assuredly Allah's promise is true. So let the life of the world not delude you, and let not the Deluder delude you concerning Allah."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
