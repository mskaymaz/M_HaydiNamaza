      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "010/047"
      ],
      "ayahs": [
        {
          "ref": "010/047",
          "surah": 10,
          "ayah": 47,
          "arabic": "وَلِكُلِّ أُمَّةٍ رَّسُولٌ ۖ فَإِذَا جَآءَ رَسُولُهُمْ قُضِىَ بَيْنَهُم بِٱلْقِسْطِ وَهُمْ لَا يُظْلَمُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "010/047",
            "text": "Her ümmetin bir resulü vardır. Onlara resulleri geldiği zaman, aralarında adaletle hüküm verilir ve onlar zulme uğratılmazlar."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "010/047",
            "text": "Her ümmetin bir peygamberi vardır. Onlara peygamberleri geldiğinde aralarında adaletle hüküm verilmiş olur. Onların hakları yenmez."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "010/047",
            "text": "And for every nation is a messenger. So when their messenger comes, it will be judged between them in justice, and they will not be wronged"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "010/047",
            "text": "A Messenger is sent to every people; and when their Messenger comes, the fate of that people is decided with full justice; they are subjected to no wrong."
          }
        }
      ],
      "status": "approved",
