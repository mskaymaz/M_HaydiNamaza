        "input_ayah_count": 1,
        "input_char_count": 364,
        "input_status": "ok",
        "input_source_ref_groups": "004/097"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "004/097"
      ],
      "ayahs": [
        {
          "ref": "004/097",
          "surah": 4,
          "ayah": 97,
          "arabic": "إِنَّ ٱلَّذِينَ تَوَفَّىٰهُمُ ٱلْمَلَـٰٓئِكَةُ ظَالِمِىٓ أَنفُسِهِمْ قَالُوا۟ فِيمَ كُنتُمْ ۖ قَالُوا۟ كُنَّا مُسْتَضْعَفِينَ فِى ٱلْأَرْضِ ۚ قَالُوٓا۟ أَلَمْ تَكُنْ أَرْضُ ٱللَّهِ وَٰسِعَةً فَتُهَاجِرُوا۟ فِيهَا ۚ فَأُو۟لَـٰٓئِكَ مَأْوَىٰهُمْ جَهَنَّمُ ۖ وَسَآءَتْ مَصِيرًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/097",
            "text": "Melekler kendi nefislerine zulmedenlerin hayatına son verecekleri zaman derler ki: \"Nerede idiniz?\" Onlar: \"Biz, yeryüzünde zayıf bırakılmışlar (müstaz'aflar) idik.\" derler. (Melekler de:) \"Hicret etmeniz için Allah'ın arzı geniş değil miydi?\" derler. İşte onların barınma yeri cehennemdir. Ne kötü yataktır o?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/097",
            "text": "Kendilerine yazık edenlerin melekler canlarını aldıkları zaman onlara: \"Ne yaptınız bakalım?\" deyince, \"Biz yeryüzünde zavallı kimselerdik\" diyecekler, melekler de: \"Allah'ın arzı geniş değil miydi? Hicret etseydiniz ya!\" cevabını verecekler. Onlarınvaracakları yer cehennemdir. Orası ne kötü dönülecek yerdir!"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/097",
            "text": "Indeed, those whom the angels take [in death] while wronging themselves - [the angels] will say, \"In what [condition] were you?\" They will say, \"We were oppressed in the land.\" The angels will say, \"Was not the earth of Allah spacious [enough] for you to emigrate therein?\" For those, their refuge is Hell - and evil it is as a destination."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/097",
            "text": "While taking the souls of those who were engaged in wronging themselves, the angels asked: 'In what circumstances were you?' They replied: 'We were too weak and helpless in the land.' The angels said: 'Was not the earth of Allah wide enough for you to emigrate in it?' For such men their refuge is Hell - an evil destination indeed;"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:50:08+00:00"
