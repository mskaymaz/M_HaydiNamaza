    {
      "ref": "004/107",
      "id": "004/107",
      "surah": 4,
      "ayahStart": 107,
      "ayahEnd": 107,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 282,
        "ref": "004/107",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 88,
        "input_status": "ok",
        "input_source_ref_groups": "004/107"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "004/107"
      ],
      "ayahs": [
        {
          "ref": "004/107",
          "surah": 4,
          "ayah": 107,
          "arabic": "وَلَا تُجَـٰدِلْ عَنِ ٱلَّذِينَ يَخْتَانُونَ أَنفُسَهُمْ ۚ إِنَّ ٱللَّهَ لَا يُحِبُّ مَن كَانَ خَوَّانًا أَثِيمًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/107",
            "text": "Kendi nefislerine ihanet edenlerden yana mücadeleye girişme. Hiç şüphesiz Allah, ihanette ilerlemiş günahkarı sevmez."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/107",
            "text": "Kendilerine hainlik edenlerden yana uğraşmaya kalkma. Allah, hainlikte direnen suçluyu sevmez."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/107",
            "text": "And do not argue on behalf of those who deceive themselves. Indeed, Allah loves not one who is a habitually sinful deceiver."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/107",
            "text": "Do not plead for those who are dishonest to themselves; Allah does not love him who betrays trust and persists in sin."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Nisa",
      "ayah_number": 107,
      "ayah_end_number": 107,
      "text_ar": "وَلَا تُجَـٰدِلْ عَنِ ٱلَّذِينَ يَخْتَانُونَ أَنفُسَهُمْ ۚ إِنَّ ٱللَّهَ لَا يُحِبُّ مَن كَانَ خَوَّانًا أَثِيمًا",
      "text_tr": "Kendi nefislerine ihanet edenlerden yana mücadeleye girişme. Hiç şüphesiz Allah, ihanette ilerlemiş günahkarı sevmez.",
      "text_en": "And do not argue on behalf of those who deceive themselves. Indeed, Allah loves not one who is a habitually sinful deceiver.",
      "priority": 1,
      "notes": "bulk approved from local Tanzil source",
      "createdAt": "2026-06-09T08:52:44+00:00",
      "updatedAt": "2026-06-09T08:52:44+00:00",
