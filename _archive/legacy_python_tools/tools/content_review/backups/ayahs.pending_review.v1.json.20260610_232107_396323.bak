    {
      "ref": "016/022-023",
      "id": "016/022-023",
      "surah": 16,
      "ayahStart": 22,
      "ayahEnd": 23,
      "type": "range",
      "ayahCount": 2,
      "input": {
        "sira": 671,
        "ref": "016/022-023",
        "input_type": "aralik",
        "input_ayah_count": 2,
        "input_char_count": 236,
        "input_status": "ok",
        "input_source_ref_groups": "016/022, 016/023"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "016/022",
        "016/023"
      ],
      "ayahs": [
        {
          "ref": "016/022",
          "surah": 16,
          "ayah": 22,
          "arabic": "إِلَـٰهُكُمْ إِلَـٰهٌ وَٰحِدٌ ۚ فَٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْءَاخِرَةِ قُلُوبُهُم مُّنكِرَةٌ وَهُم مُّسْتَكْبِرُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "016/022",
            "text": "Sizin İlahınız tek bir İlah'tır. Ahirete inanmayanların kalpleri ise inkarcıdır ve onlar müstekbir (büyüklenmekte) olanlardır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "016/022",
            "text": "Tanrınız tek bir Tanrıdır. Ahirete inanmayanların kalbleri bunu inkar eder; onlar büyüklük taslarlar."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "016/022",
            "text": "Your god is one God. But those who do not believe in the Hereafter - their hearts are disapproving, and they are arrogant."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "016/022",
            "text": "Your God is the One God. But the hearts of those who do not believe in the Hereafter are steeped in rejection of the Truth, and they are given to arrogance."
          }
        },
        {
          "ref": "016/023",
          "surah": 16,
          "ayah": 23,
          "arabic": "لَا جَرَمَ أَنَّ ٱللَّهَ يَعْلَمُ مَا يُسِرُّونَ وَمَا يُعْلِنُونَ ۚ إِنَّهُۥ لَا يُحِبُّ ٱلْمُسْتَكْبِرِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "016/023",
            "text": "Şüphesiz Allah, onların saklı tuttuklarını ve açığa vurduklarını bilir; gerçekten O, müstekbirleri sevmez."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "016/023",
            "text": "Onların gizlediklerini de, açığa vurduklarını da Allah'ın bildiğinde şüphe yoktur. O, büyüklük taslayanları sevmez."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "016/023",
            "text": "Assuredly, Allah knows what they conceal and what they declare. Indeed, He does not like the arrogant."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "016/023",
            "text": "Surely Allah knows all that they conceal and all that they disclose. He certainly does not love those who are steeped in arrogance."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Nahl",
      "ayah_number": 22,
      "ayah_end_number": 23,
      "text_ar": "﴿22﴾ إِلَـٰهُكُمْ إِلَـٰهٌ وَٰحِدٌ ۚ فَٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْءَاخِرَةِ قُلُوبُهُم مُّنكِرَةٌ وَهُم مُّسْتَكْبِرُونَ\n\n﴿23﴾ لَا جَرَمَ أَنَّ ٱللَّهَ يَعْلَمُ مَا يُسِرُّونَ وَمَا يُعْلِنُونَ ۚ إِنَّهُۥ لَا يُحِبُّ ٱلْمُسْتَكْبِرِينَ",
