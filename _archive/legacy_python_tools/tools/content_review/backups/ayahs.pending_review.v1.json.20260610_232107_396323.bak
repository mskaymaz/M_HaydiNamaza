    {
      "ref": "021/030",
      "id": "021/030",
      "surah": 21,
      "ayahStart": 30,
      "ayahEnd": 30,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 773,
        "ref": "021/030",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 154,
        "input_status": "ok",
        "input_source_ref_groups": "021/030"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "021/030"
      ],
      "ayahs": [
        {
          "ref": "021/030",
          "surah": 21,
          "ayah": 30,
          "arabic": "أَوَلَمْ يَرَ ٱلَّذِينَ كَفَرُوٓا۟ أَنَّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ كَانَتَا رَتْقًا فَفَتَقْنَـٰهُمَا ۖ وَجَعَلْنَا مِنَ ٱلْمَآءِ كُلَّ شَىْءٍ حَىٍّ ۖ أَفَلَا يُؤْمِنُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "021/030",
            "text": "O inkar edenler görmüyorlar mı ki, (başlangıçta) göklerle yer, birbiriyle bitişik iken, Biz onları ayırdık ve her canlı şeyi sudan yarattık. Yine de onlar inanmayacaklar mı?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "021/030",
            "text": "İnkar edenler, gökler ve yer yapışıkken onları ayırdığımızı ve bütün canlıları sudan meydana getirdiğimizi bilmezler mi? İnanmıyorlar mı?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "021/030",
            "text": "Have those who disbelieved not considered that the heavens and the earth were a joined entity, and We separated them and made from water every living thing? Then will they not believe?"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "021/030",
            "text": "Did the unbelievers (who do not accept the teaching of the Prophet) not realize that the heavens and the earth were one solid mass, then We tore them apart, and We made every living being out of water? Will they, then, not believe (that We created all this)?"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
