        "input_ayah_count": 1,
        "input_char_count": 103,
        "input_status": "ok",
        "input_source_ref_groups": "023/096"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "023/096"
      ],
      "ayahs": [
        {
          "ref": "023/096",
          "surah": 23,
          "ayah": 96,
          "arabic": "ٱدْفَعْ بِٱلَّتِى هِىَ أَحْسَنُ ٱلسَّيِّئَةَ ۚ نَحْنُ أَعْلَمُ بِمَا يَصِفُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "023/096",
            "text": "Kötülüğü en güzel olanla uzaklaştır; Biz, onların nitelendiregeldiklerini en iyi bileniz."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "023/096",
            "text": "Kötülüğü en iyi ile sav. Onların vasıflandırmalarını Biz daha iyi biliriz."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "023/096",
            "text": "Repel, by [means of] what is best, [their] evil. We are most knowing of what they describe."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "023/096",
            "text": "(O Muhammad)! Repel evil in the best manner. We are well aware of all that they say about you."
          }
        }
      ],
      "status": "approved",
