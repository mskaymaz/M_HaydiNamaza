    {
      "ref": "007/036",
      "id": "007/036",
      "surah": 7,
      "ayahStart": 36,
      "ayahEnd": 36,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 438,
        "ref": "007/036",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 143,
        "input_status": "ok",
        "input_source_ref_groups": "007/036"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "007/036"
      ],
      "ayahs": [
        {
          "ref": "007/036",
          "surah": 7,
          "ayah": 36,
          "arabic": "وَٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَـٰتِنَا وَٱسْتَكْبَرُوا۟ عَنْهَآ أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلنَّارِ ۖ هُمْ فِيهَا خَـٰلِدُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "007/036",
            "text": "Ayetlerimizi yalanlayanlar ve onlara karşı büyüklenenler, işte onlar ateşin arkadaşlarıdır; onda sonsuzca kalacaklardır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "007/036",
            "text": "Ayetlerimizi yalanlayıp onlara karşı büyüklük taslayanlara gelince, işte onlar cehennemliklerdir, orada temelli kalacaklardır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "007/036",
            "text": "But the ones who deny Our verses and are arrogant toward them - those are the companions of the Fire; they will abide therein eternally."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "007/036",
            "text": "And those who reject Our revelations as false and turn away from them in arrogance, they shall be the inmates of Hell; and there shall they abide."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Araf",
      "ayah_number": 36,
      "ayah_end_number": 36,
      "text_ar": "وَٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَـٰتِنَا وَٱسْتَكْبَرُوا۟ عَنْهَآ أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلنَّارِ ۖ هُمْ فِيهَا خَـٰلِدُونَ",
