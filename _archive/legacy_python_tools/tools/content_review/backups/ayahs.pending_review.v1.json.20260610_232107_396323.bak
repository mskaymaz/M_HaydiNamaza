        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "039/011"
      ],
      "ayahs": [
        {
          "ref": "039/011",
          "surah": 39,
          "ayah": 11,
          "arabic": "قُلْ إِنِّىٓ أُمِرْتُ أَنْ أَعْبُدَ ٱللَّهَ مُخْلِصًا لَّهُ ٱلدِّينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "039/011",
            "text": "De ki: \"Ben, dini yalnızca O'na halis kılarak Allah'a ibadet etmekle emrolundum.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "039/011",
            "text": "De ki: \"Dini Allah'a halis kılarak O'na kulluk etmekle emrolundum.\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "039/011",
            "text": "Say, [O Muhammad], \"Indeed, I have been commanded to worship Allah, [being] sincere to Him in religion."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "039/011",
            "text": "Tell them, (O Prophet): “I am bidden to serve Allah, consecrating my devotion to Him,"
          }
        }
      ],
