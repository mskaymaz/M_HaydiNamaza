    {
      "ref": "028/058",
      "id": "028/058",
      "surah": 28,
      "ayahStart": 58,
      "ayahEnd": 58,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 917,
        "ref": "028/058",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 164,
        "input_status": "ok",
        "input_source_ref_groups": "028/058"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "028/058"
      ],
      "ayahs": [
        {
          "ref": "028/058",
          "surah": 28,
          "ayah": 58,
          "arabic": "وَكَمْ أَهْلَكْنَا مِن قَرْيَةٍۭ بَطِرَتْ مَعِيشَتَهَا ۖ فَتِلْكَ مَسَـٰكِنُهُمْ لَمْ تُسْكَن مِّنۢ بَعْدِهِمْ إِلَّا قَلِيلًا ۖ وَكُنَّا نَحْنُ ٱلْوَٰرِثِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "028/058",
            "text": "Biz, yaşama biçimleriyle 'refah içinde şımarıp azmış' nice şehri yıkıma uğrattık. İşte meskenleri; çok az (bir zaman) dışında (onlarda) kendilerinden sonra oturulabilmiş değildir. (Onlara) Varis olanlar Biziz."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "028/058",
            "text": "Nimet ve refaha karşı nankörlük eden nice şehri yok etmişizdir. İşte yerleri! Kendilerinden sonra pek az kimseler oturabilmiştir. Oralara Biz varis olmuşuzdur."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "028/058",
            "text": "And how many a city have We destroyed that was insolent in its [way of] living, and those are their dwellings which have not been inhabited after them except briefly. And it is We who were the inheritors."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "028/058",
            "text": "And how many a town did We destroy whose inhabitants exulted on account of their affluence. These are their dwellings in which very few dwelt after them. Eventually it is We Who inherited them."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
