          "arabic": "وَكَذَّبَ بِٱلْحُسْنَىٰ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "092/009",
            "text": "Ve en güzel olanı yalan sayarsa,"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "092/009",
            "text": "Ama, cimrilik eden, kendini Allah'tan müstağni sayan, en güzel sözü yalanlayan kimsenin güçlüğe uğramasını kolaylaştırırız."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "092/009",
            "text": "And denies the best [reward],"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "092/009",
            "text": "and denied the Truth of goodness:"
          }
        },
        {
          "ref": "092/010",
          "surah": 92,
          "ayah": 10,
          "arabic": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "092/010",
            "text": "Biz de ona en zorlu olanı (azaba uğramasını) kolaylaştıracağız."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "092/010",
            "text": "Ama, cimrilik eden, kendini Allah'tan müstağni sayan, en güzel sözü yalanlayan kimsenin güçlüğe uğramasını kolaylaştırırız."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "092/010",
            "text": "We will ease him toward difficulty."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "092/010",
            "text": "We shall facilitate for him the way to Hardship,"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
