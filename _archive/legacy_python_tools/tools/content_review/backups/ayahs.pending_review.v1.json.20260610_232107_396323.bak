    {
      "ref": "022/031",
      "id": "022/031",
      "surah": 22,
      "ayahStart": 31,
      "ayahEnd": 31,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 794,
        "ref": "022/031",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 180,
        "input_status": "ok",
        "input_source_ref_groups": "022/031"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "022/031"
      ],
      "ayahs": [
        {
          "ref": "022/031",
          "surah": 22,
          "ayah": 31,
          "arabic": "حُنَفَآءَ لِلَّهِ غَيْرَ مُشْرِكِينَ بِهِۦ ۚ وَمَن يُشْرِكْ بِٱللَّهِ فَكَأَنَّمَا خَرَّ مِنَ ٱلسَّمَآءِ فَتَخْطَفُهُ ٱلطَّيْرُ أَوْ تَهْوِى بِهِ ٱلرِّيحُ فِى مَكَانٍ سَحِيقٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "022/031",
            "text": "Allah'ı birleyen (Hanif)ler olarak, O'na (hiçbir) ortak koşmaksızın. Kim Allah'a ortak koşarsa, sanki o gökten düşmüş de onu bir kuş kapıvermiş veya rüzgar onu ıssız bir yere sürükleyip atmış gibidir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "022/031",
            "text": "Allah'a ortak koşmaksızın O'na yönelerek pis putlardan kaçının, yalan sözden çekinin. Allah'a ortak koşan kimse, gökten düşüp de kuşların kaptığı veya rüzgarın bir uçuruma attığı şeye benzer."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "022/031",
            "text": "Inclining [only] to Allah, not associating [anything] with Him. And he who associates with Allah - it is as though he had fallen from the sky and was snatched by the birds or the wind carried him down into a remote place."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "022/031",
            "text": "Become exclusively devoted to Allah, ascribing Divinity to none other than Him. Whoso ascribes Divinity to aught beside Allah, it is as though he fell down from the sky whereafter either the birds will snatch him away, or the wind will sweep him to a distant place (causing him to be shattered to pieces)."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Hac",
      "ayah_number": 31,
      "ayah_end_number": 31,
      "text_ar": "حُنَفَآءَ لِلَّهِ غَيْرَ مُشْرِكِينَ بِهِۦ ۚ وَمَن يُشْرِكْ بِٱللَّهِ فَكَأَنَّمَا خَرَّ مِنَ ٱلسَّمَآءِ فَتَخْطَفُهُ ٱلطَّيْرُ أَوْ تَهْوِى بِهِ ٱلرِّيحُ فِى مَكَانٍ سَحِيقٍ",
      "text_tr": "Allah'ı birleyen (Hanif)ler olarak, O'na (hiçbir) ortak koşmaksızın. Kim Allah'a ortak koşarsa, sanki o gökten düşmüş de onu bir kuş kapıvermiş veya rüzgar onu ıssız bir yere sürükleyip atmış gibidir.",
      "text_en": "Inclining [only] to Allah, not associating [anything] with Him. And he who associates with Allah - it is as though he had fallen from the sky and was snatched by the birds or the wind carried him down into a remote place.",
      "priority": 1,
      "notes": "bulk approved from local Tanzil source",
      "createdAt": "2026-06-09T08:52:44+00:00",
      "updatedAt": "2026-06-09T08:52:44+00:00",
      "approvedAt": "2026-06-09T08:52:44+00:00",
