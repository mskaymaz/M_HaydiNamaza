      "input": {
        "sira": 957,
        "ref": "031/013",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 125,
        "input_status": "ok",
        "input_source_ref_groups": "031/013"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "031/013"
      ],
      "ayahs": [
        {
          "ref": "031/013",
          "surah": 31,
          "ayah": 13,
          "arabic": "وَإِذْ قَالَ لُقْمَـٰنُ لِٱبْنِهِۦ وَهُوَ يَعِظُهُۥ يَـٰبُنَىَّ لَا تُشْرِكْ بِٱللَّهِ ۖ إِنَّ ٱلشِّرْكَ لَظُلْمٌ عَظِيمٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "031/013",
            "text": "Hani Lukman oğluna -öğüt vererek- demişti ki; \"Ey oğlum, Allah'a şirk koşma. Şüphesiz şirk, gerçekten büyük bir zulümdür.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "031/013",
            "text": "Lokman, oğluna öğüt vererek: \"Ey oğulcuğum! Allah'a eş koşma, doğrusu eş koşmak büyük zulümdür\" demişti."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "031/013",
            "text": "And [mention, O Muhammad], when Luqman said to his son while he was instructing him, \"O my son, do not associate [anything] with Allah. Indeed, association [with him] is great injustice.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "031/013",
            "text": "And call to mind when Luqman said to his son while exhorting him: “My son, do not associate others with Allah in His Divinity. Surely, associating others with Allah in His Divinity is a mighty wrong.”"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
