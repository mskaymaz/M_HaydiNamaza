    {
      "ref": "003/086",
      "id": "003/086",
      "surah": 3,
      "ayahStart": 86,
      "ayahEnd": 86,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 168,
        "ref": "003/086",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 200,
        "input_status": "ok",
        "input_source_ref_groups": "003/086"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "003/086"
      ],
      "ayahs": [
        {
          "ref": "003/086",
          "surah": 3,
          "ayah": 86,
          "arabic": "كَيْفَ يَهْدِى ٱللَّهُ قَوْمًا كَفَرُوا۟ بَعْدَ إِيمَـٰنِهِمْ وَشَهِدُوٓا۟ أَنَّ ٱلرَّسُولَ حَقٌّ وَجَآءَهُمُ ٱلْبَيِّنَـٰتُ ۚ وَٱللَّهُ لَا يَهْدِى ٱلْقَوْمَ ٱلظَّـٰلِمِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "003/086",
            "text": "Kendilerine apaçık belgeler geldiği ve elçinin hak olduğuna şahid oldukları halde, imanlarından sonra küfre sapan bir kavmi Allah nasıl hidayete erdirir? Allah, zulmeden bir kavmi hidayete erdirmez."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "003/086",
            "text": "İnandıktan, peygamberin hak olduğuna şehadet ettikten, kendilerine belgeler geldikten sonra inkar eden bir milleti Allah nasıl doğru yola eriştirir? Allah zalimleri doğru yola eriştirmez."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "003/086",
            "text": "How shall Allah guide a people who disbelieved after their belief and had witnessed that the Messenger is true and clear signs had come to them? And Allah does not guide the wrongdoing people."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "003/086",
            "text": "How can Allah guide people who once believed, after they received clear signs and affirmed that the Messenger was a true one, lapsed into disbelief. Allah does not guide the wrong-doers."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
