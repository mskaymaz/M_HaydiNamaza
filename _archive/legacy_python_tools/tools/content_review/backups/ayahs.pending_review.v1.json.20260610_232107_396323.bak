          "arabic": "وَلَمْ يَكُن لَّهُم مِّن شُرَكَآئِهِمْ شُفَعَـٰٓؤُا۟ وَكَانُوا۟ بِشُرَكَآئِهِمْ كَـٰفِرِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "030/013",
            "text": "(Allah'a eş koştukları) Ortaklarından kendilerine şefaatçi olan yoktur; onlar, ortaklarını inkar ediyorlar."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "030/013",
            "text": "Koştukları ortakları artık şefaatçileri değildir; ortaklarını inkar ederler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "030/013",
            "text": "And there will not be for them among their [alleged] partners any intercessors, and they will [then] be disbelievers in their partners."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "030/013",
            "text": "None whom they had associated with Allah in His Divinity will intercede on their behalf; rather, they will disown those whom they had set up as Allah's associates in His Divinity."
          }
        }
      ],
      "status": "approved",
      "review": {
