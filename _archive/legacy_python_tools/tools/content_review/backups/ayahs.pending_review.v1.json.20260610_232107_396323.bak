        "input_ayah_count": 1,
        "input_char_count": 88,
        "input_status": "ok",
        "input_source_ref_groups": "002/008"
      },
      "source": {
        "arabic": "Existing clean UTF-8 Uthmani Arabic text from prior working dataset; Tanzil Uthmani Arabic verification/fetch script available",
        "tr": "Tanzil tr.bulac - Ali Bulaç",
        "en": "Tanzil en.sahih - Saheeh International",
        "tr_alternative": "Tanzil tr.diyanet - Diyanet İşleri",
        "en_alternative": "Tanzil en.maududi - Abul A’la Maududi"
      },
      "sourceRefGroups": [
        "002/008"
      ],
      "ayahs": [
        {
          "ref": "002/008",
          "surah": 2,
          "ayah": 8,
          "arabic": "وَمِنَ ٱلنَّاسِ مَن يَقُولُ ءَامَنَّا بِٱللَّهِ وَبِٱلْيَوْمِ ٱلْءَاخِرِ وَمَا هُم بِمُؤْمِنِينَ",
          "tr": {
            "source": "Tanzil tr.bulac - Ali Bulaç",
            "text": "İnsanlardan öyleleri vardır ki: \"Biz Allah'a ve ahiret gününe iman ettik\" derler; oysa inanmış değillerdir."
          },
          "en": {
            "source": "Tanzil en.sahih - Saheeh International",
            "text": "And of the people are some who say, \"We believe in Allah and the Last Day,\" but they are not believers."
          },
          "alternatives": {
            "tr_diyanet_tanzil": {
              "source": "Tanzil tr.diyanet - Diyanet İşleri",
              "text": "İnsanlardan, inanmadıkları halde, \"Allah'a ve ahiret gününe inandık\" diyenler vardır."
            },
            "en_maududi": {
              "source": "Tanzil en.maududi - Abul A’la Maududi",
              "text": "Then there are some who say, \"We believe in Allah and the Last Day\", whereas they do not believe at all."
            }
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "pending_review",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "",
        "updated_at": null
      },
      "text_tr": "İnsanlardan öyleleri vardır ki: \"Biz Allah'a ve ahiret gününe iman ettik\" derler; oysa inanmış değillerdir.",
      "text_ar": "وَمِنَ ٱلنَّاسِ مَن يَقُولُ ءَامَنَّا بِٱللَّهِ وَبِٱلْيَوْمِ ٱلْءَاخِرِ وَمَا هُم بِمُؤْمِنِينَ",
      "text_en": "And of the people are some who say, \"We believe in Allah and the Last Day,\" but they are not believers."
    },
