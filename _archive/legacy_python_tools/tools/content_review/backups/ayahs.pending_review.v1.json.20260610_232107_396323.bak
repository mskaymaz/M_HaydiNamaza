        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 68,
        "input_status": "ok",
        "input_source_ref_groups": "043/025"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "043/025"
      ],
      "ayahs": [
        {
          "ref": "043/025",
          "surah": 43,
          "ayah": 25,
          "arabic": "فَٱنتَقَمْنَا مِنْهُمْ ۖ فَٱنظُرْ كَيْفَ كَانَ عَـٰقِبَةُ ٱلْمُكَذِّبِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "043/025",
            "text": "Böylece onlardan intikam aldık. Öyleyse, bir bak; yalan sayanların sonu nasıl oldu?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "043/025",
            "text": "Bunun üzerine Biz de onlardan öç aldık. Yalancıların sonunun nasıl olduğuna bir bak!"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "043/025",
            "text": "So we took retribution from them; then see how was the end of the deniers."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "043/025",
            "text": "Then We exacted retribution from them. So do consider the end of those who gave the lie (to the Prophets)."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
