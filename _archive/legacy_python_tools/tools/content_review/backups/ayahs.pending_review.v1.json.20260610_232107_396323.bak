    {
      "ref": "010/083",
      "id": "010/083",
      "surah": 10,
      "ayahStart": 83,
      "ayahEnd": 83,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 591,
        "ref": "010/083",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 195,
        "input_status": "ok",
        "input_source_ref_groups": "010/083"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "010/083"
      ],
      "ayahs": [
        {
          "ref": "010/083",
          "surah": 10,
          "ayah": 83,
          "arabic": "فَمَآ ءَامَنَ لِمُوسَىٰٓ إِلَّا ذُرِّيَّةٌ مِّن قَوْمِهِۦ عَلَىٰ خَوْفٍ مِّن فِرْعَوْنَ وَمَلَإِي۟هِمْ أَن يَفْتِنَهُمْ ۚ وَإِنَّ فِرْعَوْنَ لَعَالٍ فِى ٱلْأَرْضِ وَإِنَّهُۥ لَمِنَ ٱلْمُسْرِفِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "010/083",
            "text": "Sonunda Musa'ya kendi kavminin bir zürriyetinden (gençlerinden) başka -Firavun ve önde gelen çevresinin kendilerini belalara çarptırmaları korkusuyla- iman eden olmadı. Çünkü Firavun, gerçekten yeryüzünde büyüklenen bir zorba ve gerçekten ölçüyü taşıranlardandı."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "010/083",
            "text": "Firavun ve erkanının kendilerine fenalık yapmasından korktuklarından, milletinin bir kısım gençleri dışında, kimse Musa'ya inanmamıştı, çünkü Firavun o yerde hakimdi. O, gerçekten aşırı gidenlerdendi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "010/083",
            "text": "But no one believed Moses, except [some] youths among his people, for fear of Pharaoh and his establishment that they would persecute them. And indeed, Pharaoh was haughty within the land, and indeed, he was of the transgressors"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "010/083",
            "text": "None but a few youths of Moses' people accepted him, fearing that Pharaoh and their own chiefs would persecute them. Indeed Pharaoh was mighty in the land, he was among those who exceed all limits."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
