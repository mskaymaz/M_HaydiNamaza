    {
      "ref": "016/097",
      "id": "016/097",
      "surah": 16,
      "ayahStart": 97,
      "ayahEnd": 97,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 684,
        "ref": "016/097",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 161,
        "input_status": "ok",
        "input_source_ref_groups": "016/097"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "016/097"
      ],
      "ayahs": [
        {
          "ref": "016/097",
          "surah": 16,
          "ayah": 97,
          "arabic": "مَنْ عَمِلَ صَـٰلِحًا مِّن ذَكَرٍ أَوْ أُنثَىٰ وَهُوَ مُؤْمِنٌ فَلَنُحْيِيَنَّهُۥ حَيَوٰةً طَيِّبَةً ۖ وَلَنَجْزِيَنَّهُمْ أَجْرَهُم بِأَحْسَنِ مَا كَانُوا۟ يَعْمَلُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "016/097",
            "text": "Erkek olsun, kadın olsun, bir mü'min olarak kim salih bir amelde bulunursa, hiç şüphesiz Biz onu güzel bir hayatla yaşatırız ve onların karşılığını, yaptıklarının en güzeliyle muhakkak veririz."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "016/097",
            "text": "Kadın, erkek, inanmış olarak kim iyi iş işlerse, ona hoş bir hayat yaşatacağız. Ecirlerini yaptıklarından daha güzeli ile ödeyeceğiz."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "016/097",
            "text": "Whoever does righteousness, whether male or female, while he is a believer - We will surely cause him to live a good life, and We will surely give them their reward [in the Hereafter] according to the best of what they used to do."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "016/097",
            "text": "Whosoever acts righteously - whether a man or a woman - and embraces belief, We will surely grant him a good life; and will surely grant such persons their reward according to the best of their deeds."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
