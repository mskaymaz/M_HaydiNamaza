          "ref": "086/004",
          "surah": 86,
          "ayah": 4,
          "arabic": "إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "086/004",
            "text": "Üzerinde gözetleyici-koruyucu bulunmayan hiçbir nefis (kimse) yoktur."
