      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "054/001",
        "054/002"
      ],
      "ayahs": [
        {
          "ref": "054/001",
          "surah": 54,
          "ayah": 1,
          "arabic": "\\basmalah ٱقْتَرَبَتِ ٱلسَّاعَةُ وَٱنشَقَّ ٱلْقَمَرُ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "054/001",
            "text": "Saat (kıyamet vakti) yakınlaştı ve ay yarıldı."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "054/001",
            "text": "Kıyamet saati yaklaşır, ay yarılır; onlar bir delil görünce hala yüz çevirirler ve: \"Süregelen bir sihir\" derler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "054/001",
            "text": "The Hour has come near, and the moon has split [in two]."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "054/001",
            "text": "The Hour of Resurrection drew near and the moon split asunder."
          }
        },
        {
          "ref": "054/002",
          "surah": 54,
          "ayah": 2,
          "arabic": "وَإِن يَرَوْا۟ ءَايَةً يُعْرِضُوا۟ وَيَقُولُوا۟ سِحْرٌ مُّسْتَمِرٌّ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "054/002",
            "text": "Onlar bir ayet (mucize) görseler, sırt çevirirler ve: \"(Bu,) Süregelen bir büyüdür\" derler."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "054/002",
            "text": "Kıyamet saati yaklaşır, ay yarılır; onlar bir delil görünce hala yüz çevirirler ve: \"Süregelen bir sihir\" derler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "054/002",
            "text": "And if they see a miracle, they turn away and say, \"Passing magic.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "054/002",
            "text": "(Regardless of any Signs these people see), they turn away and say: “This is an ongoing sorcery.”"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Kamer",
      "ayah_number": 1,
      "ayah_end_number": 2,
      "text_ar": "﴿1﴾ \\basmalah ٱقْتَرَبَتِ ٱلسَّاعَةُ وَٱنشَقَّ ٱلْقَمَرُ\n\n﴿2﴾ وَإِن يَرَوْا۟ ءَايَةً يُعْرِضُوا۟ وَيَقُولُوا۟ سِحْرٌ مُّسْتَمِرٌّ",
      "text_tr": "[1] Saat (kıyamet vakti) yakınlaştı ve ay yarıldı.\n\n[2] Onlar bir ayet (mucize) görseler, sırt çevirirler ve: \"(Bu,) Süregelen bir büyüdür\" derler.",
      "text_en": "[1] The Hour has come near, and the moon has split [in two].\n\n[2] And if they see a miracle, they turn away and say, \"Passing magic.\"",
