      ],
      "ayahs": [
        {
          "ref": "071/015",
          "surah": 71,
          "ayah": 15,
          "arabic": "أَلَمْ تَرَوْا۟ كَيْفَ خَلَقَ ٱللَّهُ سَبْعَ سَمَـٰوَٰتٍ طِبَاقًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "071/015",
            "text": "\"Görmüyor musunuz; Allah, yedi göğü birbirleriyle bir uyum (mutabakat) içinde yaratmıştır?\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "071/015",
            "text": "\"Allah'ın, göğü yedi kat üzerine nasıl yarattığını görmez misiniz?\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "071/015",
            "text": "Do you not consider how Allah has created seven heavens in layers"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "071/015",
            "text": "Do you not see how Allah has created seven heavens, one upon the other,"
          }
        }
      ],
      "status": "approved",
