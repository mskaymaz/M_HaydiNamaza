      ],
      "ayahs": [
        {
          "ref": "075/017",
          "surah": 75,
          "ayah": 17,
          "arabic": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "075/017",
            "text": "Şüphesiz, onu (kalbinde) toplamak ve onu (sana) okutmak Bize ait (bir iş)tir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "075/017",
            "text": "Doğrusu o vahyolunanı kalbine yerleştirmek ve onu sana okutturmak Bize düşer."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "075/017",
            "text": "Indeed, upon Us is its collection [in your heart] and [to make possible] its recitation."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "075/017",
            "text": "Surely it is for Us to have you commit it to memory and to recite it."
          }
        }
      ],
      "status": "approved",
