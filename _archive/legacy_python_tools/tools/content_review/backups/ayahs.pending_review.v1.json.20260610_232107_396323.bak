        {
          "ref": "002/015",
          "surah": 2,
          "ayah": 15,
          "arabic": "ٱللَّهُ يَسْتَهْزِئُ بِهِمْ وَيَمُدُّهُمْ فِى طُغْيَـٰنِهِمْ يَعْمَهُونَ",
