      },
      "sourceRefGroups": [
        "025/047"
      ],
      "ayahs": [
        {
          "ref": "025/047",
          "surah": 25,
          "ayah": 47,
          "arabic": "وَهُوَ ٱلَّذِى جَعَلَ لَكُمُ ٱلَّيْلَ لِبَاسًا وَٱلنَّوْمَ سُبَاتًا وَجَعَلَ ٱلنَّهَارَ نُشُورًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "025/047",
            "text": "O, geceyi sizin için bir elbise, uykuyu bir dinlenme ve gündüzü de yayılıp-çalışma (zamanı) kılandır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "025/047",
            "text": "Size geceyi örtü, uykuyu rahatlık kılan, gündüzü çalışma zamanı yapan Allah'tır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "025/047",
            "text": "And it is He who has made the night for you as clothing and sleep [a means for] rest and has made the day a resurrection."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "025/047",
            "text": "And it is Allah Who has ordained the night as a garment for you, and the sleep as a repose of death, and the day as the time of return to life."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Furkan",
      "ayah_number": 47,
      "ayah_end_number": 47,
      "text_ar": "وَهُوَ ٱلَّذِى جَعَلَ لَكُمُ ٱلَّيْلَ لِبَاسًا وَٱلنَّوْمَ سُبَاتًا وَجَعَلَ ٱلنَّهَارَ نُشُورًا",
      "text_tr": "O, geceyi sizin için bir elbise, uykuyu bir dinlenme ve gündüzü de yayılıp-çalışma (zamanı) kılandır.",
      "text_en": "And it is He who has made the night for you as clothing and sleep [a means for] rest and has made the day a resurrection.",
      "priority": 1,
      "notes": "bulk approved from local Tanzil source",
      "createdAt": "2026-06-09T08:52:44+00:00",
      "updatedAt": "2026-06-09T08:52:44+00:00",
