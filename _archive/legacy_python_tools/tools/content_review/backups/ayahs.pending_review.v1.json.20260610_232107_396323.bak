      "sourceRefGroups": [
        "051/049"
      ],
      "ayahs": [
        {
          "ref": "051/049",
          "surah": 51,
          "ayah": 49,
          "arabic": "وَمِن كُلِّ شَىْءٍ خَلَقْنَا زَوْجَيْنِ لَعَلَّكُمْ تَذَكَّرُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "051/049",
            "text": "Ve Biz, herşeyi iki çift yarattık. Umulur ki, öğüt alıp-düşünürsünüz."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "051/049",
            "text": "İbret alasınız diye her şeyi çift çift yaratmışızdır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "051/049",
            "text": "And of all things We created two mates; perhaps you will remember."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "051/049",
            "text": "And of everything We have created pairs; perhaps you will take heed."
          }
        }
      ],
      "status": "approved",
