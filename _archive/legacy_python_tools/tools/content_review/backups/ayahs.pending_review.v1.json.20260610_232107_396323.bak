      "ayahs": [
        {
          "ref": "037/150",
          "surah": 37,
          "ayah": 150,
          "arabic": "أَمْ خَلَقْنَا ٱلْمَلَـٰٓئِكَةَ إِنَـٰثًا وَهُمْ شَـٰهِدُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "037/150",
            "text": "Yoksa onlar, şahidlik etmekteyken Biz melekleri dişiler olarak mı yarattık?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "037/150",
            "text": "Yoksa melekleri kız olarak yarattığımızda onlar hazır mı idiler?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "037/150",
            "text": "Or did We create the angels as females while they were witnesses?\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "037/150",
            "text": "Did We create the angels as females the while they witnessed?”"
          }
        }
      ],
