      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "027/029"
      ],
      "ayahs": [
        {
          "ref": "027/029",
          "surah": 27,
          "ayah": 29,
          "arabic": "قَالَتْ يَـٰٓأَيُّهَا ٱلْمَلَؤُا۟ إِنِّىٓ أُلْقِىَ إِلَىَّ كِتَـٰبٌ كَرِيمٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "027/029",
            "text": "(Hüdhüd'ün mektubu götürüp bırakmasından sonra Saba melikesi Belkıs:) Dedi ki: \"Ey önde gelenler gerçekten bana oldukça önemli bir mektup bırakıldı.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "027/029",
            "text": "Sebe melikesi: \"Ey ileri gelenler! Bana, Bismillahirrahmanirrahim diye başlayan ve 'sakın bana karşı baş kaldırmayın ve teslim olarak gelin' diyen Süleyman'dan gönderilen önemli bir mektup bırakıldı\" dedi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "027/029",
            "text": "She said, \"O eminent ones, indeed, to me has been delivered a noble letter."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "027/029",
            "text": "The Queen said:\" Know my nobles that a gracious letter has been delivered to me."
          }
        }
      ],
