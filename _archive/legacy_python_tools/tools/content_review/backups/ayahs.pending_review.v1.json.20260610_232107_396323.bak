    {
      "ref": "034/040",
      "id": "034/040",
      "surah": 34,
      "ayahStart": 40,
      "ayahEnd": 40,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 997,
        "ref": "034/040",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 124,
        "input_status": "ok",
        "input_source_ref_groups": "034/040"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "034/040"
      ],
      "ayahs": [
        {
          "ref": "034/040",
          "surah": 34,
          "ayah": 40,
          "arabic": "وَيَوْمَ يَحْشُرُهُمْ جَمِيعًا ثُمَّ يَقُولُ لِلْمَلَـٰٓئِكَةِ أَهَـٰٓؤُلَآءِ إِيَّاكُمْ كَانُوا۟ يَعْبُدُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "034/040",
            "text": "O gün, onların hepsini birarada toplayacak (haşredecek), sonra meleklere diyecek ki: \"Size tapanlar bunlar mıydı?\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "034/040",
            "text": "Allah bir gün onların hepsini diriltip toplar, sonra meleklere: \"Bunlar mı size tapıyordu?\" der."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "034/040",
            "text": "And [mention] the Day when He will gather them all and then say to the angels, \"Did these [people] used to worship you?\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "034/040",
            "text": "And on the Day when He will muster them all and will ask the angels: “Are they the ones who worshipped you?”"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Sebe",
      "ayah_number": 40,
      "ayah_end_number": 40,
      "text_ar": "وَيَوْمَ يَحْشُرُهُمْ جَمِيعًا ثُمَّ يَقُولُ لِلْمَلَـٰٓئِكَةِ أَهَـٰٓؤُلَآءِ إِيَّاكُمْ كَانُوا۟ يَعْبُدُونَ",
      "text_tr": "O gün, onların hepsini birarada toplayacak (haşredecek), sonra meleklere diyecek ki: \"Size tapanlar bunlar mıydı?\"",
