      "ayahs": [
        {
          "ref": "052/023",
          "surah": 52,
          "ayah": 23,
          "arabic": "يَتَنَـٰزَعُونَ فِيهَا كَأْسًا لَّا لَغْوٌ فِيهَا وَلَا تَأْثِيمٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "052/023",
            "text": "Orada bir kadeh kapışır-çekişirler ki, onda ne 'boş ve saçma bir söz', ne günaha sokma yoktur."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "052/023",
            "text": "Orada kadeh tokuştururlar; fakat bunda ne bir saçmalama, ne de bir günaha girme vardır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "052/023",
            "text": "They will exchange with one another a cup [of wine] wherein [results] no ill speech or commission of sin."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "052/023",
            "text": "They shall pass on to one another a cup that will incite neither levity nor sin."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
