    {
      "ref": "057/007",
      "id": "057/007",
      "surah": 57,
      "ayahStart": 7,
      "ayahEnd": 7,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 1230,
        "ref": "057/007",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 202,
        "input_status": "ok",
        "input_source_ref_groups": "057/007"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "057/007"
      ],
      "ayahs": [
        {
          "ref": "057/007",
          "surah": 57,
          "ayah": 7,
          "arabic": "ءَامِنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ وَأَنفِقُوا۟ مِمَّا جَعَلَكُم مُّسْتَخْلَفِينَ فِيهِ ۖ فَٱلَّذِينَ ءَامَنُوا۟ مِنكُمْ وَأَنفَقُوا۟ لَهُمْ أَجْرٌ كَبِيرٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "057/007",
            "text": "Allah'a ve Resûlü’ne iman edin. \"Sizi kendilerinde halifeler kılıp harcama yetkisi verdiği' şeylerden infak edin. Artık sizden kim iman edip infak ederse, onlara büyük bir ecir vardır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "057/007",
            "text": "Ey insanlar! Allah'a ve Peygamberine inanın; sizi varis kıldığı şeylerden sarfedin; aranızdan, inanıp da sarfeden kimselere büyük ecir vardır"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "057/007",
            "text": "Believe in Allah and His Messenger and spend out of that in which He has made you successors. For those who have believed among you and spent, there will be a great reward."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "057/007",
            "text": "Believe in Allah and in His Messenger and expend of what He has entrusted to you. A great reward awaits those of you who believe and spend their wealth."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
