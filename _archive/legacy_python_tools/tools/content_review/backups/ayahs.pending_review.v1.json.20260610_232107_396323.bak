        "input_char_count": 188,
        "input_status": "kaynak_birleşik:069/013-015",
        "input_source_ref_groups": "069/013-015, 069/016"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "069/013-015",
        "069/016"
      ],
      "ayahs": [
        {
          "ref": "069/013",
          "surah": 69,
          "ayah": 13,
          "arabic": "فَإِذَا نُفِخَ فِى ٱلصُّورِ نَفْخَةٌ وَٰحِدَةٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "069/013",
            "text": "Artık sur'a tek bir üfürülüşle üfürüleceği."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "069/013",
            "text": "Sura bir üfürüş üfürüldüğü, yer ve dağlar kaldırılıp bir vuruşla birbirine çarpıldığı zaman, işte o gün olacak olur, kıyamet kopar."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "069/013",
            "text": "Then when the Horn is blown with one blast"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "069/013",
            "text": "So when the Trumpet is blown with a single blast"
          }
        },
        {
          "ref": "069/014",
          "surah": 69,
          "ayah": 14,
          "arabic": "وَحُمِلَتِ ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا دَكَّةً وَٰحِدَةً",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "069/014",
            "text": "Yeryüzü ve dağlar yerlerinden oynatılıp kaldırılacağı, ardından tek bir çarpma ile birbirlerine çarpılıp parça parça olacağı zaman."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "069/014",
            "text": "Sura bir üfürüş üfürüldüğü, yer ve dağlar kaldırılıp bir vuruşla birbirine çarpıldığı zaman, işte o gün olacak olur, kıyamet kopar."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "069/014",
            "text": "And the earth and the mountains are lifted and leveled with one blow -"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "069/014",
            "text": "and the earth and the mountains are carried aloft and are crushed to bits at one stroke,"
          }
        },
        {
          "ref": "069/015",
          "surah": 69,
          "ayah": 15,
          "arabic": "فَيَوْمَئِذٍ وَقَعَتِ ٱلْوَاقِعَةُ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "069/015",
            "text": "İşte o gün, vakıa (bir gerçek olan kıyamet) artık vukubulmuş (gerçekleşmiş)tur."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "069/015",
            "text": "Sura bir üfürüş üfürüldüğü, yer ve dağlar kaldırılıp bir vuruşla birbirine çarpıldığı zaman, işte o gün olacak olur, kıyamet kopar."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "069/015",
            "text": "Then on that Day, the Resurrection will occur,"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "069/015",
            "text": "on that Day shall that indubitable event come to pass;"
          }
        },
        {
          "ref": "069/016",
          "surah": 69,
          "ayah": 16,
          "arabic": "وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِىَ يَوْمَئِذٍ وَاهِيَةٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "069/016",
            "text": "Gök yarılıp-çatlamıştır; artık o gün, 'sarkmış-za'fa uğramıştır.'"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "069/016",
            "text": "Gök yarılır; o gün düzeni bozulur."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "069/016",
            "text": "And the heaven will split [open], for that Day it is infirm."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "069/016",
            "text": "when the sky will be rent asunder, the grip holding it together having loosened on that Day,"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
