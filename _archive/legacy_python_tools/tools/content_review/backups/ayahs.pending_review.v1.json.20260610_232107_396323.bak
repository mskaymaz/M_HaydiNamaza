      "input": {
        "sira": null,
        "ref": "061/004",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 0,
        "input_status": "tool_ekle",
        "input_source_ref_groups": "061/004"
      },
      "source": {
        "arabic": "Tanzil Uthmani Quran Text",
        "tr": "Tanzil tr.bulac / Ali Bulac",
        "trAlt": "Tanzil tr.diyanet / Diyanet Isleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A'la Maududi"
      },
      "sourceRefGroups": [
        "061/004"
      ],
      "ayahs": [
        {
          "ref": "061/004",
          "surah": 61,
          "ayah": 4,
          "arabic": "إِنَّ ٱللَّهَ يُحِبُّ ٱلَّذِينَ يُقَـٰتِلُونَ فِى سَبِيلِهِۦ صَفًّا كَأَنَّهُم بُنْيَـٰنٌ مَّرْصُوصٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulac",
            "sourceRef": "061/004",
            "text": "Şüphesiz Allah, Kendi yolunda, sanki birbirlerine kenetlenmiş bir bina gibi saf bağlayarak çarpışanları sever."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "061/004",
            "text": "Indeed, Allah loves those who fight in His cause in a row as though they are a [single] structure joined firmly."
          },
          "alternatives": {
            "tr_diyanet_tanzil": {
              "source": "Tanzil tr.diyanet / Diyanet Isleri",
              "text": "Doğrusu Allah, kendi uğrunda, kenetlenmiş bir duvar gibi, saf halinde çarpışanları sever."
            },
            "en_maududi": {
              "source": "Tanzil en.maududi / Abul A'la Maududi",
              "text": "Allah indeed loves those who fight in His Way as though they are a solid wall cemented with molten lead."
            }
          }
        }
      ],
