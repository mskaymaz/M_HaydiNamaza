    {
      "ref": "017/035",
      "id": "017/035",
      "surah": 17,
      "ayahStart": 35,
      "ayahEnd": 35,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 714,
        "ref": "017/035",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 105,
        "input_status": "ok",
        "input_source_ref_groups": "017/035"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "017/035"
      ],
      "ayahs": [
        {
          "ref": "017/035",
          "surah": 17,
          "ayah": 35,
          "arabic": "وَأَوْفُوا۟ ٱلْكَيْلَ إِذَا كِلْتُمْ وَزِنُوا۟ بِٱلْقِسْطَاسِ ٱلْمُسْتَقِيمِ ۚ ذَٰلِكَ خَيْرٌ وَأَحْسَنُ تَأْوِيلًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "017/035",
            "text": "Ölçtüğünüz zaman ölçüyü tam tutun ve dosdoğru bir tartıyla tartın; bu, daha hayırlıdır ve sonuç bakımından daha güzeldir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "017/035",
            "text": "Bir şeyi ölçtüğünüz zaman, ölçüyü tam tutun, doğru teraziyle tartın. Böyle yapmak, sonuç itibariyle daha güzel ve daha iyidir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "017/035",
            "text": "And give full measure when you measure, and weigh with an even balance. That is the best [way] and best in result."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "017/035",
            "text": "(xii) Give full measure when you measure, and weigh with even scales. That is fair and better in consequence."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Isra",
      "ayah_number": 35,
      "ayah_end_number": 35,
      "text_ar": "وَأَوْفُوا۟ ٱلْكَيْلَ إِذَا كِلْتُمْ وَزِنُوا۟ بِٱلْقِسْطَاسِ ٱلْمُسْتَقِيمِ ۚ ذَٰلِكَ خَيْرٌ وَأَحْسَنُ تَأْوِيلًا",
