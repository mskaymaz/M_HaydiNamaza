      },
      "sourceRefGroups": [
        "036/036"
      ],
      "ayahs": [
        {
          "ref": "036/036",
          "surah": 36,
          "ayah": 36,
          "arabic": "سُبْحَـٰنَ ٱلَّذِى خَلَقَ ٱلْأَزْوَٰجَ كُلَّهَا مِمَّا تُنۢبِتُ ٱلْأَرْضُ وَمِنْ أَنفُسِهِمْ وَمِمَّا لَا يَعْلَمُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "036/036",
            "text": "Yerin bitirdiklerinden, kendi nefislerinden ve daha bilmedikleri nice şeylerden bütün çiftleri yaratan (Allah çok) Yücedir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "036/036",
            "text": "Yerin yetiştirdiklerinden, kendilerinden ve daha bilmediklerinden çift çift yaratan Allah münezzehtir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "036/036",
            "text": "Exalted is He who created all pairs - from what the earth grows and from themselves and from that which they do not know."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "036/036",
            "text": "Holy is He Who created all things in pairs, whether it be of what the earth produces, and of themselves, and of what they do not know."
          }
        }
      ],
      "status": "approved",
