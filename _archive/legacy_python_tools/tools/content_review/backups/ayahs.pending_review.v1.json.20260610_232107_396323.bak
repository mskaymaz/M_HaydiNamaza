    {
      "ref": "024/012",
      "id": "024/012",
      "surah": 24,
      "ayahStart": 12,
      "ayahEnd": 12,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 821,
        "ref": "024/012",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 153,
        "input_status": "ok",
        "input_source_ref_groups": "024/012"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "024/012"
      ],
      "ayahs": [
        {
          "ref": "024/012",
          "surah": 24,
          "ayah": 12,
          "arabic": "لَّوْلَآ إِذْ سَمِعْتُمُوهُ ظَنَّ ٱلْمُؤْمِنُونَ وَٱلْمُؤْمِنَـٰتُ بِأَنفُسِهِمْ خَيْرًا وَقَالُوا۟ هَـٰذَآ إِفْكٌ مُّبِينٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "024/012",
            "text": "Onu işittiğiniz zaman, erkek mü'minler ile kadın mü’minlerin kendi nefisleri adına hayırlı bir zanda bulunup: \"Bu, açıkça uydurulmuş iftira bir sözdür\" demeleri gerekmez miydi?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "024/012",
            "text": "Onu işittiğiniz zaman, erkek kadın müminlerin, kendiliklerinden hüsnü zanda bulunup da: \"Bu apaçık bir iftiradır\" demeleri gerekmez miydi?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "024/012",
            "text": "Why, when you heard it, did not the believing men and believing women think good of one another and say, \"This is an obvious falsehood\"?"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "024/012",
            "text": "When you heard of it, why didn't the Believing men and the Believing women have a good opinion of themselves, and why did they not say, \"This is a manifest slander?\""
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
