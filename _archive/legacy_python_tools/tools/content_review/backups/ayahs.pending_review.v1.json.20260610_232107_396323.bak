    {
      "ref": "005/038",
      "id": "005/038",
      "surah": 5,
      "ayahStart": 38,
      "ayahEnd": 38,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 337,
        "ref": "005/038",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 177,
        "input_status": "ok",
        "input_source_ref_groups": "005/038"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "005/038"
      ],
      "ayahs": [
        {
          "ref": "005/038",
          "surah": 5,
          "ayah": 38,
          "arabic": "وَٱلسَّارِقُ وَٱلسَّارِقَةُ فَٱقْطَعُوٓا۟ أَيْدِيَهُمَا جَزَآءًۢ بِمَا كَسَبَا نَكَـٰلًا مِّنَ ٱللَّهِ ۗ وَٱللَّهُ عَزِيزٌ حَكِيمٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "005/038",
            "text": "Hırsız erkek ve hırsız kadının, (çalıp) kazandıklarına bir karşılık, Allah'tan, 'tekrarı önleyen kesin bir ceza' olmak üzere ellerini kesin. Allah üstün ve güçlü olandır, hüküm ve hikmet sahibidir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "005/038",
            "text": "Erkek hırsız ve kadın hırsızın, yaptıklarından ötürü Allah tarafından ibret verici bir ceza olarak, ellerini kesin. Allah Güçlü'dür, Hakim'dir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "005/038",
            "text": "[As for] the thief, the male and the female, amputate their hands in recompense for what they committed as a deterrent [punishment] from Allah. And Allah is Exalted in Might and Wise."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "005/038",
            "text": "As for the thief -male or female - cut off the hands of both. This is a recompense for what they have done, and an exemplary punishment from Allah. Allah is All-Mighty, All-Wise."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
