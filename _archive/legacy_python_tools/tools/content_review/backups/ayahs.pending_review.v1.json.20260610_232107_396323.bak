      "input": {
        "sira": 539,
        "ref": "009/056",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 153,
        "input_status": "ok",
        "input_source_ref_groups": "009/056"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "009/056"
      ],
      "ayahs": [
        {
          "ref": "009/056",
          "surah": 9,
          "ayah": 56,
          "arabic": "وَيَحْلِفُونَ بِٱللَّهِ إِنَّهُمْ لَمِنكُمْ وَمَا هُم مِّنكُمْ وَلَـٰكِنَّهُمْ قَوْمٌ يَفْرَقُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "009/056",
            "text": "Gerçekten sizden olduklarına dair Allah adına yemin ederler. Oysa onlar sizden değildirler. Ancak onlar ödleri kopan bir topluluktur."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "009/056",
            "text": "Sizden olmadıkları halde, sizinle beraber olduklarına Allah'a yemin ederler. Oysa onlar korkak bir topluluktur."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "009/056",
            "text": "And they swear by Allah that they are from among you while they are not from among you; but they are a people who are afraid."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "009/056",
            "text": "They swear by Allah that they are part of you whereas they are certainly not part of you. They are merely a people who dread you."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
