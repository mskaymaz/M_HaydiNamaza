      "ayahs": [
        {
          "ref": "002/122",
          "surah": 2,
          "ayah": 122,
          "arabic": "يَـٰبَنِىٓ إِسْرَٰٓءِيلَ ٱذْكُرُوا۟ نِعْمَتِىَ ٱلَّتِىٓ أَنْعَمْتُ عَلَيْكُمْ وَأَنِّى فَضَّلْتُكُمْ عَلَى ٱلْعَـٰلَمِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "002/122",
            "text": "Ey İsrailoğulları, size bağışladığım nimetimi ve sizi (bir dönem) alemlere muhakkak üstün kıldığımı hatırlayın."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "002/122",
            "text": "Ey İsrailoğulları! Size verdiğim nimeti ve sizi bir zamanlar alemlere üstün tuttuğumu hatırlayın."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "002/122",
            "text": "O Children of Israel, remember My favor which I have bestowed upon you and that I preferred you over the worlds."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "002/122",
            "text": "O children of Israel, remember that special favour I bestowed upon you, and that I exalted you above all the communities of the world."
          }
        }
      ],
      "status": "approved",
