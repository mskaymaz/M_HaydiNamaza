        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 111,
        "input_status": "ok",
        "input_source_ref_groups": "021/011"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "021/011"
      ],
      "ayahs": [
        {
          "ref": "021/011",
          "surah": 21,
          "ayah": 11,
          "arabic": "وَكَمْ قَصَمْنَا مِن قَرْيَةٍ كَانَتْ ظَالِمَةً وَأَنشَأْنَا بَعْدَهَا قَوْمًا ءَاخَرِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "021/011",
            "text": "Biz, zulmeden ülkelerden nicesini kırıp geçirdik ve bunun ardından bir başka kavmi meydana getirdik."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "021/011",
            "text": "Halkı zalim olan nice kasabaları kırıp geçirdik ve onlardan sonra başka milletler varettik."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "021/011",
            "text": "And how many a city which was unjust have We shattered and produced after it another people."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "021/011",
            "text": "How many a wrong-doing town did We shatter and then raise up another people."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
