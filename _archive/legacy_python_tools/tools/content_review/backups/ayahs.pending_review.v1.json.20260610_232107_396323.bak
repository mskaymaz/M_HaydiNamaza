    {
      "ref": "010/067",
      "id": "010/067",
      "surah": 10,
      "ayahStart": 67,
      "ayahEnd": 67,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 585,
        "ref": "010/067",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 143,
        "input_status": "ok",
        "input_source_ref_groups": "010/067"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "010/067"
      ],
      "ayahs": [
        {
          "ref": "010/067",
          "surah": 10,
          "ayah": 67,
          "arabic": "هُوَ ٱلَّذِى جَعَلَ لَكُمُ ٱلَّيْلَ لِتَسْكُنُوا۟ فِيهِ وَٱلنَّهَارَ مُبْصِرًا ۚ إِنَّ فِى ذَٰلِكَ لَـَٔايَـٰتٍ لِّقَوْمٍ يَسْمَعُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "010/067",
            "text": "O, dinlenmeniz için geceyi, gündüzü de aydınlatıcı (mubsir) olarak sizin için yaratmıştır. Şüphesiz işitebilen bir topluluk için bunda gerçekten ayetler vardır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "010/067",
            "text": "Size geceyi dinlenesiniz diye karanlık ve gündüzü çalışasınız diye aydınlık olarak yaratan Allah'tır. Kulak veren millet için bunlarda ayetler vardır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "010/067",
            "text": "It is He who made for you the night to rest therein and the day, giving sight. Indeed in that are signs for a people who listen."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "010/067",
            "text": "It is Allah alone Who has made the night that you may rest in it, and has made the day light-giving. Surely in that there are signs for those who give heed (to the call of the Messenger)."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Yunus",
      "ayah_number": 67,
