      "sourceRefGroups": [
        "023/045-046"
      ],
      "ayahs": [
        {
          "ref": "023/046",
          "surah": 23,
          "ayah": 46,
          "arabic": "إِلَىٰ فِرْعَوْنَ وَمَلَإِي۟هِۦ فَٱسْتَكْبَرُوا۟ وَكَانُوا۟ قَوْمًا عَالِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "023/046",
            "text": "Firavun'a ve ileri gelen çevresine; fakat onlar büyüklendiler. Onlar, 'büyüklenen-zorba' bir topluluktu."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "023/046",
            "text": "Sonra Musa ve kardeşi Harun'u, Firavun ve erkanına mucizelerimiz ve apaçık delille gönderdik. Büyüklük tasladılar. Zaten mağrur bir topluluktular."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "023/046",
            "text": "To Pharaoh and his establishment, but they were arrogant and were a haughty people."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "023/046",
            "text": "to Pharaoh and to his chiefs, but they behaved superciliously and they were haughty."
          }
        }
      ],
      "status": "approved",
