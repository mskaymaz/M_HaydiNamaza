          "ayah": 181,
          "arabic": "أَوْفُوا۟ ٱلْكَيْلَ وَلَا تَكُونُوا۟ مِنَ ٱلْمُخْسِرِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "026/181",
            "text": "\"Ölçüyü tam tutun ve eksiltenlerden olmayın.\""
          },
          "trAlt": {
