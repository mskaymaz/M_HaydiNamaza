      "ayahEnd": 126,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 195,
        "ref": "003/126",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 163,
        "input_status": "ok",
        "input_source_ref_groups": "003/126"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "003/126"
      ],
      "ayahs": [
        {
          "ref": "003/126",
          "surah": 3,
          "ayah": 126,
          "arabic": "وَمَا جَعَلَهُ ٱللَّهُ إِلَّا بُشْرَىٰ لَكُمْ وَلِتَطْمَئِنَّ قُلُوبُكُم بِهِۦ ۗ وَمَا ٱلنَّصْرُ إِلَّا مِنْ عِندِ ٱللَّهِ ٱلْعَزِيزِ ٱلْحَكِيمِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "003/126",
            "text": "Allah bunu (yardımı) size ancak bir müjde olsun ve kalpleriniz bununla tatmin bulsun diye yaptı. 'Yardım ve zafer’ (nusret) ancak üstün ve güçlü, hüküm ve hikmet sahibi olan Allah'ın Katındandır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "003/126",
            "text": "Allah bunu, ancak size müjde olsun ve böylece kalbleriniz yatışsın diye yapmıştır. İnkar edenlerin bir kısmını kesmek veya ümidsiz olarak geri dönecek şekilde bozguna uğratmak için gereken yardım, ancak Güçlü ve Hakim olan Allah katından olur."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "003/126",
            "text": "And Allah made it not except as [a sign of] good tidings for you and to reassure your hearts thereby. And victory is not except from Allah, the Exalted in Might, the Wise -"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "003/126",
            "text": "Allah has reminded you of this only as a glad tiding to you and so as to let your hearts be at rest. Help can only come from Allah, the All-Mighty, the All-Wise."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Ali Imran",
      "ayah_number": 126,
      "ayah_end_number": 126,
      "text_ar": "وَمَا جَعَلَهُ ٱللَّهُ إِلَّا بُشْرَىٰ لَكُمْ وَلِتَطْمَئِنَّ قُلُوبُكُم بِهِۦ ۗ وَمَا ٱلنَّصْرُ إِلَّا مِنْ عِندِ ٱللَّهِ ٱلْعَزِيزِ ٱلْحَكِيمِ",
      "text_tr": "Allah bunu (yardımı) size ancak bir müjde olsun ve kalpleriniz bununla tatmin bulsun diye yaptı. 'Yardım ve zafer’ (nusret) ancak üstün ve güçlü, hüküm ve hikmet sahibi olan Allah'ın Katındandır.",
      "text_en": "And Allah made it not except as [a sign of] good tidings for you and to reassure your hearts thereby. And victory is not except from Allah, the Exalted in Might, the Wise -",
