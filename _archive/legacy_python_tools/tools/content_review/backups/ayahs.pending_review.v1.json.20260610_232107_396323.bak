      },
      "sourceRefGroups": [
        "002/278"
      ],
      "ayahs": [
        {
          "ref": "002/278",
          "surah": 2,
          "ayah": 278,
          "arabic": "يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱتَّقُوا۟ ٱللَّهَ وَذَرُوا۟ مَا بَقِىَ مِنَ ٱلرِّبَوٰٓا۟ إِن كُنتُم مُّؤْمِنِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "002/278",
            "text": "Ey iman edenler, Allah'tan sakının ve eğer inanmışsanız, faizden artakalanı bırakın."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "002/278",
            "text": "Ey İnananlar! Allah'tan sakının, inanmışsanız, faizden arta kalmış hesabdan vazgeçin."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "002/278",
            "text": "O you who have believed, fear Allah and give up what remains [due to you] of interest, if you should be believers."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "002/278",
            "text": "O Believers, fear Allah and give up that interest which is still due to you, if you are true Believers;"
          }
        }
      ],
