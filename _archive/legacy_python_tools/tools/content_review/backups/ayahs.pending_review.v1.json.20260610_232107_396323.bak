          "ayah": 5,
          "arabic": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "102/005",
            "text": "Hayır; eğer siz kesin bir bilgiyle bilmiş olsaydınız,"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "102/005",
            "text": "Dikkat edin, şayet yaptığınızın sonucunu kesin olarak bir bilseniz!"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "102/005",
            "text": "No! If you only knew with knowledge of certainty..."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "102/005",
            "text": "Nay, would that you knew with certainty of knowledge (what your attitude will lead to, you would never have acted the way you do)."
          }
        }
      ],
