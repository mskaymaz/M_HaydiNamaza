      ],
      "ayahs": [
        {
          "ref": "039/064",
          "surah": 39,
          "ayah": 64,
          "arabic": "قُلْ أَفَغَيْرَ ٱللَّهِ تَأْمُرُوٓنِّىٓ أَعْبُدُ أَيُّهَا ٱلْجَـٰهِلُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "039/064",
            "text": "De ki: \"Ey cahiller, bana Allah'ın dışında bir başkasına mı kulluk etmemi emrediyorsunuz?\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "039/064",
            "text": "De ki: \"Ey cahiller! Bana, Allah'tan başkasına kulluk etmemi mi emredersiniz?\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "039/064",
            "text": "Say, [O Muhammad], \"Is it other than Allah that you order me to worship, O ignorant ones?\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "039/064",
            "text": "(O Prophet), say: “Ignorant people! Do you bid me to serve any other beside Allah?”"
          }
        }
      ],
      "status": "approved",
