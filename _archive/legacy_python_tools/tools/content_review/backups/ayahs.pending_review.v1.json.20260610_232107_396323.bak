      "sourceRefGroups": [
        "006/045"
      ],
      "ayahs": [
        {
          "ref": "006/045",
          "surah": 6,
          "ayah": 45,
          "arabic": "فَقُطِعَ دَابِرُ ٱلْقَوْمِ ٱلَّذِينَ ظَلَمُوا۟ ۚ وَٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "006/045",
            "text": "Böylece zulmeden topluluğun kökü kurutuldu. Hamd, alemlerin Rabbi olan Allah'adır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "006/045",
            "text": "Zulmeden milletin kökü böylece kesildi. Hamd, Alemlerin Rabbi Allah'a mahsustur."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "006/045",
            "text": "So the people that committed wrong were eliminated. And praise to Allah, Lord of the worlds."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "006/045",
            "text": "Thus the last remnant of those wrongdoing people was cut off. All praise is for Allah, the Lord of the entire universe, (for having punished them so)."
          }
        }
      ],
      "status": "approved",
