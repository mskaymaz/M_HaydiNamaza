          "ref": "078/031",
          "surah": 78,
          "ayah": 31,
          "arabic": "إِنَّ لِلْمُتَّقِينَ مَفَازًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "078/031",
            "text": "Gerçek şu ki, muttakiler için 'bir kurtuluş ve mutluluk' vardır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "078/031",
            "text": "Doğrusu, Allah'a karşı gelmekten sakınanlara kurtuluş, bahçeler, bağlar, yaşıtlar ve dolu kadehler vardır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "078/031",
            "text": "Indeed, for the righteous is attainment -"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "078/031",
            "text": "Surely the state of triumph awaits the God-fearing:"
          }
        }
      ],
