    {
      "ref": "017/033",
      "id": "017/033",
      "surah": 17,
      "ayahStart": 33,
      "ayahEnd": 33,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 713,
        "ref": "017/033",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 241,
        "input_status": "ok",
        "input_source_ref_groups": "017/033"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "017/033"
      ],
      "ayahs": [
        {
          "ref": "017/033",
          "surah": 17,
          "ayah": 33,
          "arabic": "وَلَا تَقْتُلُوا۟ ٱلنَّفْسَ ٱلَّتِى حَرَّمَ ٱللَّهُ إِلَّا بِٱلْحَقِّ ۗ وَمَن قُتِلَ مَظْلُومًا فَقَدْ جَعَلْنَا لِوَلِيِّهِۦ سُلْطَـٰنًا فَلَا يُسْرِف فِّى ٱلْقَتْلِ ۖ إِنَّهُۥ كَانَ مَنصُورًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "017/033",
            "text": "Haklı bir neden olmaksızın Allah'ın haram kıldığı bir kimseyi öldürmeyin. Kim mazlum olarak öldürülürse onun velisine yetki vermişizdir; o da öldürmede ölçüyü aşmasın. Çünkü o, gerçekten yardım görmüştür."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "017/033",
            "text": "Allah'ın haram kıldığı cana haksız yere kıymayın. Haksız yere öldürülenin velisine bir yetki tanımışızdır. Artık o da öldürmekte aşırı gitmesin. Zira kendisi ne de olsa yardım görmüştür."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "017/033",
            "text": "And do not kill the soul which Allah has forbidden, except by right. And whoever is killed unjustly - We have given his heir authority, but let him not exceed limits in [the matter of] taking life. Indeed, he has been supported [by the law]."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "017/033",
            "text": "(ix) Do not kill any person whom Allah has forbidden to kill, except with right. We have granted the heir of him who has been wrongfully killed the authority to (claim retribution); so let him not exceed in slaying. He shall be helped."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
