      ],
      "ayahs": [
        {
          "ref": "005/010",
          "surah": 5,
          "ayah": 10,
          "arabic": "وَٱلَّذِينَ كَفَرُوا۟ وَكَذَّبُوا۟ بِـَٔايَـٰتِنَآ أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلْجَحِيمِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "005/010",
            "text": "İnkar edenler ve ayetlerimizi yalanlayanlar ise, onlar da, alevli ateşin halkıdırlar."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "005/010",
            "text": "İnkar edenler ve ayetlerimizi yalanlayanlar, işte onlar cehennemliklerdir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "005/010",
            "text": "But those who disbelieve and deny Our signs - those are the companions of Hellfire."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "005/010",
            "text": "As for those who disbelieve and give the lie to Our signs, they are destined for the Blazing Flame."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
