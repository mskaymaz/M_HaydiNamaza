          "ref": "037/095",
          "surah": 37,
          "ayah": 95,
          "arabic": "قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "037/095",
            "text": "Dedi ki: “Yontmakta olduğunuz şeylere mi tapıyorsunuz?”"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "037/095",
            "text": "İbrahim onlara şöyle söyledi: \"Yonttuğunuz şeylere mi tapıyorsunuz? Oysa sizi de, yonttuklarınızı da Allah yaratmıştır.\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "037/095",
            "text": "He said, \"Do you worship that which you [yourselves] carve,"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "037/095",
            "text": "Abraham said to them: “Do you worship what you yourselves have carved with your own hands"
          }
        }
      ],
      "status": "approved",
