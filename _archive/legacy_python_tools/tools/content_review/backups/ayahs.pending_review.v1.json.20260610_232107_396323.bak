      "ayahs": [
        {
          "ref": "058/015",
          "surah": 58,
          "ayah": 15,
          "arabic": "أَعَدَّ ٱللَّهُ لَهُمْ عَذَابًا شَدِيدًا ۖ إِنَّهُمْ سَآءَ مَا كَانُوا۟ يَعْمَلُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "058/015",
            "text": "Allah, onlara şiddetli bir azap hazırlamıştır. Doğrusu onların yaptıkları ne kötüdür."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "058/015",
            "text": "Allah, onlara çetin bir azap hazırlamıştır. İşledikleri şey ne kötüdür!"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "058/015",
            "text": "Allah has prepared for them a severe punishment. Indeed, it was evil that they were doing."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "058/015",
            "text": "Allah has prepared for them a grievous chastisement. Indeed, evil are the acts in which they are engaged."
          }
        }
      ],
