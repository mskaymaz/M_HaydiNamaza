      "ayahs": [
        {
          "ref": "019/063",
          "surah": 19,
          "ayah": 63,
          "arabic": "تِلْكَ ٱلْجَنَّةُ ٱلَّتِى نُورِثُ مِنْ عِبَادِنَا مَن كَانَ تَقِيًّا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "019/063",
            "text": "O cennet; Biz, kullarımızdan takva sahibi olanları (ona) varisçi kılacağız."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "019/063",
            "text": "Kullarımızdan Allah'a karşı gelmekten sakınanları mirasçı kılacağımız Cennet işte budur."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "019/063",
            "text": "That is Paradise, which We give as inheritance to those of Our servants who were fearing of Allah."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "019/063",
            "text": "Such is the Paradise which We shall cause those of Our servants who have been God-fearing to inherit."
          }
        }
      ],
