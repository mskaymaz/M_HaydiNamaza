        "input_ayah_count": 1,
        "input_char_count": 80,
        "input_status": "ok",
        "input_source_ref_groups": "017/032"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "017/032"
      ],
      "ayahs": [
        {
          "ref": "017/032",
          "surah": 17,
          "ayah": 32,
          "arabic": "وَلَا تَقْرَبُوا۟ ٱلزِّنَىٰٓ ۖ إِنَّهُۥ كَانَ فَـٰحِشَةً وَسَآءَ سَبِيلًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "017/032",
            "text": "Zinaya yaklaşmayın, gerçekten o, 'çirkin bir hayasızlık' ve kötü bir yoldur."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "017/032",
            "text": "Sakın zinaya yaklaşmayın; doğrusu bu çirkindir, kötü bir yoldur."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "017/032",
            "text": "And do not approach unlawful sexual intercourse. Indeed, it is ever an immorality and is evil as a way."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "017/032",
            "text": "(viii) Do not even approach fornication for it is an outrageous act, and an evil way."
          }
        }
      ],
      "status": "approved",
