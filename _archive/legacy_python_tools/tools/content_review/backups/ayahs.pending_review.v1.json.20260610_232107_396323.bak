    {
      "ref": "009/054",
      "id": "009/054",
      "surah": 9,
      "ayahStart": 54,
      "ayahEnd": 54,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 537,
        "ref": "009/054",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 161,
        "input_status": "ok",
        "input_source_ref_groups": "009/054"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "009/054"
      ],
      "ayahs": [
        {
          "ref": "009/054",
          "surah": 9,
          "ayah": 54,
          "arabic": "وَمَا مَنَعَهُمْ أَن تُقْبَلَ مِنْهُمْ نَفَقَـٰتُهُمْ إِلَّآ أَنَّهُمْ كَفَرُوا۟ بِٱللَّهِ وَبِرَسُولِهِۦ وَلَا يَأْتُونَ ٱلصَّلَوٰةَ إِلَّا وَهُمْ كُسَالَىٰ وَلَا يُنفِقُونَ إِلَّا وَهُمْ كَـٰرِهُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "009/054",
            "text": "İnfak ettiklerinin kendilerinden kabulünü engelleyen şey, Allah'ı ve elçisini tanımamaları, namaza ancak isteksizce gelmeleri ve hoşlarına gitmiyorken infak etmeleridir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "009/054",
            "text": "Verdiklerinin kabul olunmasına engel olan, Allah'ı ve Peygamberini inkar etmeleri, namaza tembel tembel gelmeleri, istemeye istemeye vermeleridir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "009/054",
            "text": "And what prevents their expenditures from being accepted from them but that they have disbelieved in Allah and in His Messenger and that they come not to prayer except while they are lazy and that they do not spend except while they are unwilling."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "009/054",
            "text": "Nothing prevents that their expendings be accepted except that they disbelieve in Allah and His Messenger, and whenever they come to the Prayer they do so lazily, and whenever they spend they do so grudgingly."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
