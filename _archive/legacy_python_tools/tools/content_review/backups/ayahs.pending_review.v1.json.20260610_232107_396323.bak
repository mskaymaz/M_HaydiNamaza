      },
      "sourceRefGroups": [
        "002/276"
      ],
      "ayahs": [
        {
          "ref": "002/276",
          "surah": 2,
          "ayah": 276,
          "arabic": "يَمْحَقُ ٱللَّهُ ٱلرِّبَوٰا۟ وَيُرْبِى ٱلصَّدَقَـٰتِ ۗ وَٱللَّهُ لَا يُحِبُّ كُلَّ كَفَّارٍ أَثِيمٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "002/276",
            "text": "Allah, faizi yok eder de, sadakaları artırır. Allah, günahkar kafirlerin hiçbirini sevmez."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "002/276",
            "text": "Allah faizi eksiltir, sadakaları bereketlendirir. Allah pek nankör olan hiçbir günahkarı sevmez."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "002/276",
            "text": "Allah destroys interest and gives increase for charities. And Allah does not like every sinning disbeliever."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "002/276",
            "text": "Allah deprives interest of all blessing and develops charity; and Allah does not like an ungrateful, sinful person."
          }
        }
      ],
      "status": "approved",
