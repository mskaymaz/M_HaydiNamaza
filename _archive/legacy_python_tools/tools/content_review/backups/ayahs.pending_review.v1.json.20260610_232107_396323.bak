      "ayahs": [
        {
          "ref": "019/092",
          "surah": 19,
          "ayah": 92,
          "arabic": "وَمَا يَنۢبَغِى لِلرَّحْمَـٰنِ أَن يَتَّخِذَ وَلَدًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "019/092",
            "text": "Rahman (olan Allah)a çocuk edinmek yaraşmaz."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "019/092",
            "text": "Oysa Rahman'a çocuk edinmek yaraşmaz, çünkü göklerde ve yerde olan her şey Rahman'a baş eğmiş kul olarak gelecektir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "019/092",
            "text": "And it is not appropriate for the Most Merciful that He should take a son."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "019/092",
            "text": "It does not befit the Most Compassionate Lord that He should take a son."
          }
        }
      ],
      "status": "approved",
