    {
      "ref": "002/008-009",
      "id": "002/008-009",
      "surah": 2,
      "ayahStart": 8,
      "ayahEnd": 9,
      "type": "range",
      "ayahCount": 2,
      "input": {
        "sira": null,
        "ref": "002/008-009",
        "input_type": "aralik",
        "input_ayah_count": 2,
        "input_char_count": 0,
        "input_status": "tool_ekle",
        "input_source_ref_groups": "002/008-009"
      },
      "source": {
        "arabic": "Tanzil Uthmani Quran Text",
        "tr": "Tanzil tr.bulac / Ali Bulac",
        "trAlt": "Tanzil tr.diyanet / Diyanet Isleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A'la Maududi"
      },
      "sourceRefGroups": [
        "002/008-009"
      ],
      "ayahs": [
        {
          "ref": "002/008",
          "surah": 2,
          "ayah": 8,
          "arabic": "وَمِنَ ٱلنَّاسِ مَن يَقُولُ ءَامَنَّا بِٱللَّهِ وَبِٱلْيَوْمِ ٱلْـَٔاخِرِ وَمَا هُم بِمُؤْمِنِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulac",
            "sourceRef": "002/008",
            "text": "İnsanlardan öyleleri vardır ki: \"Biz Allah'a ve ahiret gününe iman ettik\" derler; oysa inanmış değillerdir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "002/008",
            "text": "And of the people are some who say, \"We believe in Allah and the Last Day,\" but they are not believers."
          },
          "alternatives": {
            "tr_diyanet_tanzil": {
              "source": "Tanzil tr.diyanet / Diyanet Isleri",
              "text": "İnsanlardan, inanmadıkları halde, \"Allah'a ve ahiret gününe inandık\" diyenler vardır."
            },
            "en_maududi": {
              "source": "Tanzil en.maududi / Abul A'la Maududi",
              "text": "Then there are some who say, \"We believe in Allah and the Last Day\", whereas they do not believe at all."
            }
          }
        },
        {
          "ref": "002/009",
          "surah": 2,
          "ayah": 9,
          "arabic": "يُخَـٰدِعُونَ ٱللَّهَ وَٱلَّذِينَ ءَامَنُوا۟ وَمَا يَخْدَعُونَ إِلَّآ أَنفُسَهُمْ وَمَا يَشْعُرُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulac",
            "sourceRef": "002/009",
            "text": "(Sözde) Allah'ı ve iman edenleri aldatırlar. Oysa onlar, yalnızca kendilerini aldatıyorlar ve şuurunda değiller."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "002/009",
            "text": "They [think to] deceive Allah and those who believe, but they deceive not except themselves and perceive [it] not."
          },
          "alternatives": {
            "tr_diyanet_tanzil": {
              "source": "Tanzil tr.diyanet / Diyanet Isleri",
              "text": "Bunlar Allah'ı ve inananları aldatmaya çalışırlar, oysa sadece kendilerini aldatırlar da farkında değildirler."
            },
            "en_maududi": {
              "source": "Tanzil en.maududi / Abul A'la Maududi",
              "text": "They thus try to deceive Allah and the Believers, but they succeed in deceiving none except themselves and they realize it not."
            }
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 3,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "YOK",
