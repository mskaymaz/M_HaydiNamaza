        "input_ayah_count": 1,
        "input_char_count": 0,
        "input_status": "tool_ekle",
        "input_source_ref_groups": "008/057"
      },
      "source": {
        "arabic": "Tanzil Uthmani Quran Text",
        "tr": "Tanzil tr.bulac / Ali Bulac",
        "trAlt": "Tanzil tr.diyanet / Diyanet Isleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A'la Maududi"
      },
      "sourceRefGroups": [
        "008/057"
      ],
      "ayahs": [
        {
          "ref": "008/057",
          "surah": 8,
          "ayah": 57,
          "arabic": "فَإِمَّا تَثْقَفَنَّهُمْ فِى ٱلْحَرْبِ فَشَرِّدْ بِهِم مَّنْ خَلْفَهُمْ لَعَلَّهُمْ يَذَّكَّرُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulac",
            "sourceRef": "008/057",
            "text": "Bundan dolayı, savaşta onları yakalarsan, öyle darmadağın et ki, onlarla arkalarından gelecek olanlar(ı caydır). Umulur ki ibret alırlar."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "008/057",
            "text": "So if you, [O Muhammad], gain dominance over them in war, disperse by [means of] them those behind them that perhaps they will be reminded."
          },
          "alternatives": {
            "tr_diyanet_tanzil": {
              "source": "Tanzil tr.diyanet / Diyanet Isleri",
              "text": "Anlaşma yaptığın kimseler, sonucundan sakınmayarak anlaşmalarını her defasında bozarlar. Savaşta onları yakalarsan, arkalarındakilere ibret olacak şekilde, darmadağın et."
            },
            "en_maududi": {
              "source": "Tanzil en.maududi / Abul A'la Maududi",
              "text": "So if you meet them in war, make of them a fearsome example for those who follow them that they may he admonished."
            }
          }
        }
      ],
      "status": "approved",
