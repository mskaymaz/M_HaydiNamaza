          "surah": 56,
          "ayah": 18,
          "arabic": "بِأَكْوَابٍ وَأَبَارِيقَ وَكَأْسٍ مِّن مَّعِينٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "056/018",
            "text": "Kaynağından (doldurulmuş) testiler, ibrikler ve kadehler,"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "056/018",
            "text": "Ölümsüz gençler yanlarında, baş ağrısı ve dönmesi vermeyen bembeyaz bir kaynaktan doldurulmuş kaseler, ibrikler, kadehler; seçecekleri meyveler, arzulayacakları kuş eti ile dolaşırlar."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "056/018",
            "text": "With vessels, pitchers and a cup [of wine] from a flowing spring -"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "056/018",
            "text": "with goblets and ewers and a cup filled with a drink drawn from a running spring,"
          }
        }
      ],
