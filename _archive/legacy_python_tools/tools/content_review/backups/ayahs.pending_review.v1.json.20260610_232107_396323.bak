    {
      "ref": "028/088",
      "id": "028/088",
      "surah": 28,
      "ayahStart": 88,
      "ayahEnd": 88,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 925,
        "ref": "028/088",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 189,
        "input_status": "ok",
        "input_source_ref_groups": "028/088"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "028/088"
      ],
      "ayahs": [
        {
          "ref": "028/088",
          "surah": 28,
          "ayah": 88,
          "arabic": "وَلَا تَدْعُ مَعَ ٱللَّهِ إِلَـٰهًا ءَاخَرَ ۘ لَآ إِلَـٰهَ إِلَّا هُوَ ۚ كُلُّ شَىْءٍ هَالِكٌ إِلَّا وَجْهَهُۥ ۚ لَهُ ٱلْحُكْمُ وَإِلَيْهِ تُرْجَعُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "028/088",
            "text": "Ve Allah ile beraber başka bir İlah'a tapma. O'ndan başka İlah yoktur. O'nun yüzünden (zatından) başka herşey helak olucudur. Hüküm O'nundur ve siz O'na döndürüleceksiniz."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "028/088",
            "text": "Allah'la beraber başka tanrı tutup tapma. O'ndan başka tanrı yoktur. O'ndan başka her şey yok olacaktır. Hüküm O'nundur, O'na döndürüleceksiniz."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "028/088",
            "text": "And do not invoke with Allah another deity. There is no deity except Him. Everything will be destroyed except His Face. His is the judgement, and to Him you will be returned."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "028/088",
            "text": "and do not invoke any god beside Allah. There is no god but He. All will perish but He. To Him belongs the command. And to Him shall all of you return."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
