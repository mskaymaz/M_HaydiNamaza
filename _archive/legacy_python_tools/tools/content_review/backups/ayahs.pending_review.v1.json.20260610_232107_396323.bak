        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 134,
        "input_status": "ok",
        "input_source_ref_groups": "010/085"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "010/085"
      ],
      "ayahs": [
        {
          "ref": "010/085",
          "surah": 10,
          "ayah": 85,
          "arabic": "فَقَالُوا۟ عَلَى ٱللَّهِ تَوَكَّلْنَا رَبَّنَا لَا تَجْعَلْنَا فِتْنَةً لِّلْقَوْمِ ٱلظَّـٰلِمِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "010/085",
            "text": "Dediler ki: \"Biz Allah'a tevekkül ettik; Rabbimiz, bizi zulmeden bir kavim için bir fitne (konusu) kılma.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "010/085",
            "text": "\"Allah'a güvendik; Ey Rabbimiz! Zalim bir millet ile bizi sınama, rahmetinle bizi kafirlerden kurtar\" dediler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "010/085",
            "text": "So they said, \"Upon Allah do we rely. Our Lord, make us not [objects of] trial for the wrongdoing people"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "010/085",
            "text": "They replied: 'We place our reliance on Allah. Our Lord! Do not make us a trial for the oppressors,"
          }
        }
      ],
