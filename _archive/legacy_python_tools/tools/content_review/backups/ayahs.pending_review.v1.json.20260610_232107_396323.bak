    {
      "ref": "003/135",
      "id": "003/135",
      "surah": 3,
      "ayahStart": 135,
      "ayahEnd": 135,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 200,
        "ref": "003/135",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 246,
        "input_status": "ok",
        "input_source_ref_groups": "003/135"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "003/135"
      ],
      "ayahs": [
        {
          "ref": "003/135",
          "surah": 3,
          "ayah": 135,
          "arabic": "وَٱلَّذِينَ إِذَا فَعَلُوا۟ فَـٰحِشَةً أَوْ ظَلَمُوٓا۟ أَنفُسَهُمْ ذَكَرُوا۟ ٱللَّهَ فَٱسْتَغْفَرُوا۟ لِذُنُوبِهِمْ وَمَن يَغْفِرُ ٱلذُّنُوبَ إِلَّا ٱللَّهُ وَلَمْ يُصِرُّوا۟ عَلَىٰ مَا فَعَلُوا۟ وَهُمْ يَعْلَمُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "003/135",
            "text": "Ve 'çirkin bir hayasızlık' işledikleri ya da nefislerine zulmettikleri zaman, Allah'ı hatırlayıp hemen günahlarından dolayı bağışlanma isteyenlerdir. Allah'tan başka günahları bağışlayan kimdir? Bir de onlar yaptıkları (kötü şeylerde) bile bile ısrar etmeyenlerdir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "003/135",
            "text": "Onlar fena bir şey yaptıklarında veya kendilerine zulmettiklerinde Allah'ı anarlar, günahlarının bağışlanmasını dilerler. Günahları Allah'tan başka bağışlayan kim vardır? Onlar, yaptıklarında bile bile direnmezler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "003/135",
            "text": "And those who, when they commit an immorality or wrong themselves [by transgression], remember Allah and seek forgiveness for their sins - and who can forgive sins except Allah? - and [who] do not persist in what they have done while they know."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "003/135",
            "text": "These are the ones who, when they commit any indecency and wrong against themselves, instantly remember Allah and implore forgiveness for their sins - for who will forgive sins save Allah? - and who do not wilfully persist in the wrong they did."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
