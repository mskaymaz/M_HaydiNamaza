          "surah": 74,
          "ayah": 24,
          "arabic": "فَقَالَ إِنْ هَـٰذَآ إِلَّا سِحْرٌ يُؤْثَرُ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "074/024",
            "text": "Böylece: \"Bu, yalnızca 'aktarılarak öğrenilen' bir büyüdür\" dedi."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "074/024",
            "text": "\"Bu sadece öğretilegelen bir sihirdir. Bu Kuran yalnızca bir insan sözüdür\" dedi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "074/024",
            "text": "And said, \"This is not but magic imitated [from others]."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "074/024",
            "text": "and said: “This (Qur'an) is merely a sorcery of yore;"
          }
        }
      ],
