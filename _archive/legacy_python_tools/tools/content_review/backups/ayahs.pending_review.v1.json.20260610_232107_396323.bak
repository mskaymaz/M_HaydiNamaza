      "input": {
        "sira": 410,
        "ref": "006/116",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 134,
        "input_status": "ok",
        "input_source_ref_groups": "006/116"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "006/116"
      ],
      "ayahs": [
        {
          "ref": "006/116",
          "surah": 6,
          "ayah": 116,
          "arabic": "وَإِن تُطِعْ أَكْثَرَ مَن فِى ٱلْأَرْضِ يُضِلُّوكَ عَن سَبِيلِ ٱللَّهِ ۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَإِنْ هُمْ إِلَّا يَخْرُصُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "006/116",
            "text": "Yeryüzünde olanların çoğunluğuna uyacak olursan, seni Allah'ın yolundan şaşırtıp-saptırırlar. Onlar ancak zanna uyarlar ve onlar ancak 'zan ve tahminle yalan söylerler.'"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "006/116",
            "text": "Yeryüzündekilerin çoğunluğuna itaat edersen seni Allah yolundan saptırırlar. Onlar ancak zanna uyarlar, sadece tahminde bulunurlar."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "006/116",
            "text": "And if you obey most of those upon the earth, they will mislead you from the way of Allah. They follow not except assumption, and they are not but falsifying."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "006/116",
            "text": "(O Muhammad!) If you obey the majority of those who live on earth, they will lead you away from Allah's path. They only follow idle fancies, indulging in conjecture."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Enam",
      "ayah_number": 116,
      "ayah_end_number": 116,
      "text_ar": "وَإِن تُطِعْ أَكْثَرَ مَن فِى ٱلْأَرْضِ يُضِلُّوكَ عَن سَبِيلِ ٱللَّهِ ۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَإِنْ هُمْ إِلَّا يَخْرُصُونَ",
      "text_tr": "Yeryüzünde olanların çoğunluğuna uyacak olursan, seni Allah'ın yolundan şaşırtıp-saptırırlar. Onlar ancak zanna uyarlar ve onlar ancak 'zan ve tahminle yalan söylerler.'",
