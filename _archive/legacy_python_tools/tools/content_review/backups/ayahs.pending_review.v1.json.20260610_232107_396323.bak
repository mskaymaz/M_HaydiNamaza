      "input": {
        "sira": 1276,
        "ref": "062/007",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 99,
        "input_status": "ok",
        "input_source_ref_groups": "062/007"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "062/007"
      ],
      "ayahs": [
        {
          "ref": "062/007",
          "surah": 62,
          "ayah": 7,
          "arabic": "وَلَا يَتَمَنَّوْنَهُۥٓ أَبَدًۢا بِمَا قَدَّمَتْ أَيْدِيهِمْ ۚ وَٱللَّهُ عَلِيمٌۢ بِٱلظَّـٰلِمِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "062/007",
            "text": "Oysa onlar, ellerinin öne takdim ettikleri dolayısıyla bunu hiçbir zaman temenni edemezler. Allah, zalimleri bilendir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "062/007",
            "text": "Yaptıklarından ötürü, ölümü asla dileyemezler. Allah, zalimleri bilendir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "062/007",
            "text": "But they will not wish for it, ever, because of what their hands have put forth. And Allah is Knowing of the wrongdoers."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "062/007",
            "text": "But they shall never wish for death because of the (evil) deeds they have committed. Allah is well aware of these evil-doers."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
