          "ref": "104/002",
          "surah": 104,
          "ayah": 2,
          "arabic": "ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "104/002",
            "text": "Ki o, mal yığıp biriktiren ve onu saydıkça sayandır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "104/002",
            "text": "Mal toplayarak onu tekrar tekrar sayan, diliyle çekiştirip alay eden kimsenin vay haline!"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "104/002",
            "text": "Who collects wealth and [continuously] counts it."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "104/002",
            "text": "who amasses wealth and counts it over and again."
          }
        }
      ],
