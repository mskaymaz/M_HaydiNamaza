    {
      "ref": "003/199",
      "id": "003/199",
      "surah": 3,
      "ayahStart": 199,
      "ayahEnd": 199,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 231,
        "ref": "003/199",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 273,
        "input_status": "ok",
        "input_source_ref_groups": "003/199"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "003/199"
      ],
      "ayahs": [
        {
          "ref": "003/199",
          "surah": 3,
          "ayah": 199,
          "arabic": "وَإِنَّ مِنْ أَهْلِ ٱلْكِتَـٰبِ لَمَن يُؤْمِنُ بِٱللَّهِ وَمَآ أُنزِلَ إِلَيْكُمْ وَمَآ أُنزِلَ إِلَيْهِمْ خَـٰشِعِينَ لِلَّهِ لَا يَشْتَرُونَ بِـَٔايَـٰتِ ٱللَّهِ ثَمَنًا قَلِيلًا ۗ أُو۟لَـٰٓئِكَ لَهُمْ أَجْرُهُمْ عِندَ رَبِّهِمْ ۗ إِنَّ ٱللَّهَ سَرِيعُ ٱلْحِسَابِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "003/199",
            "text": "Şüphesiz, Kitap Ehlinden, Allah'a; size indirilene ve kendilerine indirilene -Allah'a derin saygı gösterenler olarak- inananlar vardır. Onlar Allah'ın ayetlerine karşılık olarak az bir değeri satın almazlar. İşte bunların Rableri Katında ecirleri vardır. Şüphesiz Allah, hesabı çok çabuk görendir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "003/199",
            "text": "Kitap ehlinden Allah'a huşu duyarak inanıp, Allah'ın ayetlerini az bir değere değişmeyenler vardır. İşte onların ecirleri Rablerinin katındadır. Şüphesiz Allah'ın hesabı çabuktur."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "003/199",
            "text": "And indeed, among the People of the Scripture are those who believe in Allah and what was revealed to you and what was revealed to them, [being] humbly submissive to Allah. They do not exchange the verses of Allah for a small price. Those will have their reward with their Lord. Indeed, Allah is swift in account."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "003/199",
            "text": "And among the People of the Book some believe in Allah and what has been revealed to you, and what has been revealed to them. They humble themselves before Allah, and do not sell Allah's revelations for a small price. For these men their reward is with their Lord. Allah is swift in His reckoning."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Ali Imran",
      "ayah_number": 199,
      "ayah_end_number": 199,
      "text_ar": "وَإِنَّ مِنْ أَهْلِ ٱلْكِتَـٰبِ لَمَن يُؤْمِنُ بِٱللَّهِ وَمَآ أُنزِلَ إِلَيْكُمْ وَمَآ أُنزِلَ إِلَيْهِمْ خَـٰشِعِينَ لِلَّهِ لَا يَشْتَرُونَ بِـَٔايَـٰتِ ٱللَّهِ ثَمَنًا قَلِيلًا ۗ أُو۟لَـٰٓئِكَ لَهُمْ أَجْرُهُمْ عِندَ رَبِّهِمْ ۗ إِنَّ ٱللَّهَ سَرِيعُ ٱلْحِسَابِ",
      "text_tr": "Şüphesiz, Kitap Ehlinden, Allah'a; size indirilene ve kendilerine indirilene -Allah'a derin saygı gösterenler olarak- inananlar vardır. Onlar Allah'ın ayetlerine karşılık olarak az bir değeri satın almazlar. İşte bunların Rableri Katında ecirleri vardır. Şüphesiz Allah, hesabı çok çabuk görendir.",
      "text_en": "And indeed, among the People of the Scripture are those who believe in Allah and what was revealed to you and what was revealed to them, [being] humbly submissive to Allah. They do not exchange the verses of Allah for a small price. Those will have their reward with their Lord. Indeed, Allah is swift in account.",
      "priority": 1,
      "notes": "bulk approved from local Tanzil source",
      "createdAt": "2026-06-09T08:52:44+00:00",
      "updatedAt": "2026-06-09T08:52:44+00:00",
      "approvedAt": "2026-06-09T08:52:44+00:00",
