      "ayahs": [
        {
          "ref": "018/004",
          "surah": 18,
          "ayah": 4,
          "arabic": "وَيُنذِرَ ٱلَّذِينَ قَالُوا۟ ٱتَّخَذَ ٱللَّهُ وَلَدًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "018/004",
            "text": "(Bu Kur'an) \"Allah çocuk edindi\" diyenleri uyarıp-korkutur."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "018/004",
            "text": "Hamd Allah'a mahsustur ki, kendi katından şiddetli bir baskını haber vermek ve yararlı iş yapan müminlere, içinde temelli kalacakları güzel bir mükafatı müjdelemek ve: \"Allah çocuk edindi\" diyenleri uyarmak için kuluna eğri bir taraf bırakmadığı dosdoğru Kitap'ı indirmiştir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "018/004",
            "text": "And to warn those who say, \"Allah has taken a son.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "018/004",
            "text": "and also to warn those who say: \"Allah has taken to Himself a son,\""
          }
        }
      ],
      "status": "approved",
