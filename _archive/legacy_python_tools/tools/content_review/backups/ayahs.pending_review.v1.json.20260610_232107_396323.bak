        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 137,
        "input_status": "ok",
        "input_source_ref_groups": "016/111"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "016/111"
      ],
      "ayahs": [
        {
          "ref": "016/111",
          "surah": 16,
          "ayah": 111,
          "arabic": "يَوْمَ تَأْتِى كُلُّ نَفْسٍ تُجَـٰدِلُ عَن نَّفْسِهَا وَتُوَفَّىٰ كُلُّ نَفْسٍ مَّا عَمِلَتْ وَهُمْ لَا يُظْلَمُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "016/111",
            "text": "O gün, herkes kendi nefsi adına mücadele eder ve herkese yaptığının karşılığı eksiksiz ödenir. Onlar zulme uğratılmazlar."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "016/111",
            "text": "O gün, herkesin kendi derdine düşüp çabalayacağı ve herkesin işlediğinin haksızlığa uğratılmadan kendisine ödeneceği bir gündür."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "016/111",
            "text": "On the Day when every soul will come disputing for itself, and every soul will be fully compensated for what it did, and they will not be wronged."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "016/111",
            "text": "Allah's judgement will come about them all on the Day when everyone shall come pleading in his defence, and everyone shall be fully requited for his deeds and none shall be wronged in the least."
          }
        }
      ],
