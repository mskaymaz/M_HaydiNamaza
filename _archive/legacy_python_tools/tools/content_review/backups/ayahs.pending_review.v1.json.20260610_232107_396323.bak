    {
      "ref": "005/043",
      "id": "005/043",
      "surah": 5,
      "ayahStart": 43,
      "ayahEnd": 43,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 339,
        "ref": "005/043",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 215,
        "input_status": "ok",
        "input_source_ref_groups": "005/043"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "005/043"
      ],
      "ayahs": [
        {
          "ref": "005/043",
          "surah": 5,
          "ayah": 43,
          "arabic": "وَكَيْفَ يُحَكِّمُونَكَ وَعِندَهُمُ ٱلتَّوْرَىٰةُ فِيهَا حُكْمُ ٱللَّهِ ثُمَّ يَتَوَلَّوْنَ مِنۢ بَعْدِ ذَٰلِكَ ۚ وَمَآ أُو۟لَـٰٓئِكَ بِٱلْمُؤْمِنِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "005/043",
            "text": "Allah'ın hükmünün bulunduğu Tevrat yanlarında olduğu halde, seni nasıl hakem kılıyorlar ve sonra bunun peşinden yüz çeviriyorlar? İşte onlar, inanmış değildir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "005/043",
            "text": "Allah'ın hükmünün bulunduğu Tevrat yanlarında iken, ne yüzle seni hakem tayin ediyorlar da sonra bundan yüz çeviriyorlar? İşte onlar inanmış değillerdir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "005/043",
            "text": "But how is it that they come to you for judgement while they have the Torah, in which is the judgement of Allah? Then they turn away, [even] after that; but those are not [in fact] believers."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "005/043",
            "text": "Yet how will they appoint you a judge when they have the Torah with them, wherein there is Allah's judgement - and still they turn away from it? The fact is, they are not believers."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Maide",
      "ayah_number": 43,
      "ayah_end_number": 43,
      "text_ar": "وَكَيْفَ يُحَكِّمُونَكَ وَعِندَهُمُ ٱلتَّوْرَىٰةُ فِيهَا حُكْمُ ٱللَّهِ ثُمَّ يَتَوَلَّوْنَ مِنۢ بَعْدِ ذَٰلِكَ ۚ وَمَآ أُو۟لَـٰٓئِكَ بِٱلْمُؤْمِنِينَ",
      "text_tr": "Allah'ın hükmünün bulunduğu Tevrat yanlarında olduğu halde, seni nasıl hakem kılıyorlar ve sonra bunun peşinden yüz çeviriyorlar? İşte onlar, inanmış değildir.",
