      "ayahs": [
        {
          "ref": "067/011",
          "surah": 67,
          "ayah": 11,
          "arabic": "فَٱعْتَرَفُوا۟ بِذَنۢبِهِمْ فَسُحْقًا لِّأَصْحَـٰبِ ٱلسَّعِيرِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "067/011",
            "text": "Böylece kendi günahlarını itiraf ettiler. Çılgınca yanan ateşin halkına (Allah'ın rahmetinden) uzaklık olsun."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "067/011",
            "text": "Böylece, günahlarını itiraf ederler. Çılgın alevli cehennemlikler yok olsunlar!"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "067/011",
            "text": "And they will admit their sin, so [it is] alienation for the companions of the Blaze."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "067/011",
            "text": "Thus will they confess their sins. Damned are these inmates of the Blazing Fire."
          }
        }
      ],
