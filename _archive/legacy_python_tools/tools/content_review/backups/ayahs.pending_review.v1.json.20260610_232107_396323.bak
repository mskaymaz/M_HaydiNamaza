          "surah": 99,
          "ayah": 7,
          "arabic": "فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُۥ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "099/007",
            "text": "Artık kim zerre ağırlığınca hayır işlerse, onu görür."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "099/007",
            "text": "Kim zerre kadar iyilik yapmışsa onu görür."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "099/007",
            "text": "So whoever does an atom's weight of good will see it,"
