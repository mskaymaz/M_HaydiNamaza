    {
      "ref": "003/164",
      "id": "003/164",
      "surah": 3,
      "ayahStart": 164,
      "ayahEnd": 164,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 218,
        "ref": "003/164",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 247,
        "input_status": "ok",
        "input_source_ref_groups": "003/164"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "003/164"
      ],
      "ayahs": [
        {
          "ref": "003/164",
          "surah": 3,
          "ayah": 164,
          "arabic": "لَقَدْ مَنَّ ٱللَّهُ عَلَى ٱلْمُؤْمِنِينَ إِذْ بَعَثَ فِيهِمْ رَسُولًا مِّنْ أَنفُسِهِمْ يَتْلُوا۟ عَلَيْهِمْ ءَايَـٰتِهِۦ وَيُزَكِّيهِمْ وَيُعَلِّمُهُمُ ٱلْكِتَـٰبَ وَٱلْحِكْمَةَ وَإِن كَانُوا۟ مِن قَبْلُ لَفِى ضَلَـٰلٍ مُّبِينٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "003/164",
            "text": "Andolsun ki Allah, mü'minlere, içlerinde kendilerinden onlara bir peygamber göndermekle lütufta bulunmuştur. (Ki O) Onlara ayetlerini okuyor, onları arındırıyor ve onlara kitabı ve hikmeti öğretiyor. Ondan önce ise onlar apaçık bir sapıklık içindeydiler."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "003/164",
            "text": "And olsun ki Allah, inananlara, ayetlerini okuyan, onları arıtan, onlara Kitap ve hikmeti öğreten, kendilerinden bir peygamber göndermekle iyilikte bulunmuştur. Halbuki onlar, önceleri apaçık sapıklıkta idiler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "003/164",
            "text": "Certainly did Allah confer [great] favor upon the believers when He sent among them a Messenger from themselves, reciting to them His verses and purifying them and teaching them the Book and wisdom, although they had been before in manifest error."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "003/164",
            "text": "Surely Allah conferred a great favour on the believers when He raised from among them a Messenger to recite to them His signs, and to purify them, and to teach them the Book and Wisdom. For before that they were in manifest error."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
