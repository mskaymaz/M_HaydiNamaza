      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "050/017",
        "050/018"
      ],
      "ayahs": [
        {
          "ref": "050/017",
          "surah": 50,
          "ayah": 17,
          "arabic": "إِذْ يَتَلَقَّى ٱلْمُتَلَقِّيَانِ عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ قَعِيدٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "050/017",
            "text": "Onun sağında ve solunda oturan iki yazıcı kaydederlerken"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "050/017",
            "text": "Sağında ve solunda, onunla beraber oturan iki alıcı melek, yanında hazır birer gözcü olarak söylediği her sözü zaptederler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "050/017",
            "text": "When the two receivers receive, seated on the right and on the left."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "050/017",
            "text": "Moreover, there are two scribes, one each sitting on the right and the left, recording everything."
          }
        },
        {
          "ref": "050/018",
          "surah": 50,
          "ayah": 18,
          "arabic": "مَّا يَلْفِظُ مِن قَوْلٍ إِلَّا لَدَيْهِ رَقِيبٌ عَتِيدٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "050/018",
            "text": "O, söz olarak (herhangi bir şey) söylemeyiversin, mutlaka yanında hazır bir gözetleyici vardır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "050/018",
            "text": "Sağında ve solunda, onunla beraber oturan iki alıcı melek, yanında hazır birer gözcü olarak söylediği her sözü zaptederler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "050/018",
            "text": "Man does not utter any word except that with him is an observer prepared [to record]."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "050/018",
            "text": "He utters not a word, but there is a vigilant watcher at hand."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
