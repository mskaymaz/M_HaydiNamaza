      "input": {
        "sira": 795,
        "ref": "022/038",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 79,
        "input_status": "ok",
        "input_source_ref_groups": "022/038"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "022/038"
      ],
      "ayahs": [
        {
          "ref": "022/038",
          "surah": 22,
          "ayah": 38,
          "arabic": "إِنَّ ٱللَّهَ يُدَٰفِعُ عَنِ ٱلَّذِينَ ءَامَنُوٓا۟ ۗ إِنَّ ٱللَّهَ لَا يُحِبُّ كُلَّ خَوَّانٍ كَفُورٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "022/038",
            "text": "Şüphesiz Allah, (müşriklerin saldırı ve sinsi tuzaklarını) iman edenlerden uzaklaştırmaktadır. Gerçekten Allah, hain ve nankör olan kimseyi sevmez."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "022/038",
            "text": "Allah şüphesiz inananları savunur, çünkü hainleri ve nankörleri hiç sevmez."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "022/038",
            "text": "Indeed, Allah defends those who have believed. Indeed, Allah does not like everyone treacherous and ungrateful."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "022/038",
            "text": "Surely Allah defends those who believe. Certainly Allah has no love for the perfidious, the thankless."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:50:08+00:00"
      },
      "surah_name": "Hac",
      "ayah_number": 38,
      "ayah_end_number": 38,
      "text_ar": "إِنَّ ٱللَّهَ يُدَٰفِعُ عَنِ ٱلَّذِينَ ءَامَنُوٓا۟ ۗ إِنَّ ٱللَّهَ لَا يُحِبُّ كُلَّ خَوَّانٍ كَفُورٍ",
      "text_tr": "Şüphesiz Allah, (müşriklerin saldırı ve sinsi tuzaklarını) iman edenlerden uzaklaştırmaktadır. Gerçekten Allah, hain ve nankör olan kimseyi sevmez.",
