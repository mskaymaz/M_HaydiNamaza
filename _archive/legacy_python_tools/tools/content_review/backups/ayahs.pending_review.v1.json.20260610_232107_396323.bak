        "input_status": "tool_ekle",
        "input_source_ref_groups": "022/039"
      },
      "source": {
        "arabic": "Tanzil Uthmani Quran Text",
        "tr": "Tanzil tr.bulac / Ali Bulac",
        "trAlt": "Tanzil tr.diyanet / Diyanet Isleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A'la Maududi"
      },
      "sourceRefGroups": [
        "022/039"
      ],
      "ayahs": [
        {
          "ref": "022/039",
          "surah": 22,
          "ayah": 39,
          "arabic": "أُذِنَ لِلَّذِينَ يُقَـٰتَلُونَ بِأَنَّهُمْ ظُلِمُوا۟ ۚ وَإِنَّ ٱللَّهَ عَلَىٰ نَصْرِهِمْ لَقَدِيرٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulac",
            "sourceRef": "022/039",
            "text": "Kendilerine zulmedilmesi dolayısıyla, onlara karşı savaş açılana (mü'minlere, savaşma) izni verildi. Şüphesiz Allah, onlara yardım etmeye güç yetirendir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "022/039",
            "text": "Permission [to fight] has been given to those who are being fought, because they were wronged. And indeed, Allah is competent to give them victory."
          },
          "alternatives": {
            "tr_diyanet_tanzil": {
              "source": "Tanzil tr.diyanet / Diyanet Isleri",
              "text": "Haksızlığa uğratılarak kendilerine savaş açılan kimselerin karşı koyup savaşmasına izin verilmiştir. Allah onlara yardım etmeğe elbette Kadir'dir."
            },
            "en_maududi": {
              "source": "Tanzil en.maududi / Abul A'la Maududi",
              "text": "Permission (to fight) has been granted to those for they have been wronged. Verily Allah has the power to help them:"
            }
          }
        }
      ],
      "status": "approved",
