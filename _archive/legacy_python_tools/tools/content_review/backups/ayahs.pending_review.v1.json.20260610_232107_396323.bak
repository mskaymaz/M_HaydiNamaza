    {
      "ref": "009/038",
      "id": "009/038",
      "surah": 9,
      "ayahStart": 38,
      "ayahEnd": 38,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 526,
        "ref": "009/038",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 213,
        "input_status": "ok",
        "input_source_ref_groups": "009/038"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "009/038"
      ],
      "ayahs": [
        {
          "ref": "009/038",
          "surah": 9,
          "ayah": 38,
          "arabic": "يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ مَا لَكُمْ إِذَا قِيلَ لَكُمُ ٱنفِرُوا۟ فِى سَبِيلِ ٱللَّهِ ٱثَّاقَلْتُمْ إِلَى ٱلْأَرْضِ ۚ أَرَضِيتُم بِٱلْحَيَوٰةِ ٱلدُّنْيَا مِنَ ٱلْءَاخِرَةِ ۚ فَمَا مَتَـٰعُ ٱلْحَيَوٰةِ ٱلدُّنْيَا فِى ٱلْءَاخِرَةِ إِلَّا قَلِيلٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "009/038",
            "text": "Ey iman edenler, ne oldu ki size, Allah yolunda savaşa kuşanın denildiği zaman, yer(iniz)de ağırlaşıp kaldınız? Ahiretten (cayıp) dünya hayatına mı razı oldunuz? Ama ahirettekine (göre), bu dünya hayatının yararı pek azdır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "009/038",
            "text": "Ey inananlar! Size ne oldu ki, \"Allah yolunda, savaşa çıkın\" dendiği zaman yere çöküp kaldınız? Oysa dünya hayatının geçimi ahirete göre pek az bir şeydir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "009/038",
            "text": "O you who have believed, what is [the matter] with you that, when you are told to go forth in the cause of Allah, you adhere heavily to the earth? Are you satisfied with the life of this world rather than the Hereafter? But what is the enjoyment of worldly life compared to the Hereafter except a [very] little."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "009/038",
            "text": "Believers! What is amiss with you that when it is said to you: \"March forth in the cause of Allah,\" you cling heavily to the earth? Do you prefer the worldly life to the Hereafter? Know well that all the enjoyment of this world, in comparison with the Hereafter, is trivial."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:50:08+00:00"
      },
