    {
      "ref": "003/157",
      "id": "003/157",
      "surah": 3,
      "ayahStart": 157,
      "ayahEnd": 157,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 212,
        "ref": "003/157",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 143,
        "input_status": "ok",
        "input_source_ref_groups": "003/157"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "003/157"
      ],
      "ayahs": [
        {
          "ref": "003/157",
          "surah": 3,
          "ayah": 157,
          "arabic": "وَلَئِن قُتِلْتُمْ فِى سَبِيلِ ٱللَّهِ أَوْ مُتُّمْ لَمَغْفِرَةٌ مِّنَ ٱللَّهِ وَرَحْمَةٌ خَيْرٌ مِّمَّا يَجْمَعُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "003/157",
            "text": "Andolsun, eğer Allah yolunda öldürülür ya da ölürseniz, Allah'tan olan bir bağışlanma ve rahmet, onların bütün toplamakta olduklarından daha hayırlıdır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "003/157",
            "text": "Allah yolunda öldürülür veya ölürseniz, size Allah'tan onların topladıklarından hayırlı bir mağfiret ve rahmet vardır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "003/157",
            "text": "And if you are killed in the cause of Allah or die - then forgiveness from Allah and mercy are better than whatever they accumulate [in this world]."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "003/157",
            "text": "And were you to be slain or to die in the way of Allah, then surely Allah's forgiveness and mercy are better than all the goods they amass."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Ali Imran",
      "ayah_number": 157,
      "ayah_end_number": 157,
      "text_ar": "وَلَئِن قُتِلْتُمْ فِى سَبِيلِ ٱللَّهِ أَوْ مُتُّمْ لَمَغْفِرَةٌ مِّنَ ٱللَّهِ وَرَحْمَةٌ خَيْرٌ مِّمَّا يَجْمَعُونَ",
      "text_tr": "Andolsun, eğer Allah yolunda öldürülür ya da ölürseniz, Allah'tan olan bir bağışlanma ve rahmet, onların bütün toplamakta olduklarından daha hayırlıdır.",
