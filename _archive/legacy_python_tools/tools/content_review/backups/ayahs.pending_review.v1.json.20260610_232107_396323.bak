    {
      "ref": "004/114",
      "id": "004/114",
      "surah": 4,
      "ayahStart": 114,
      "ayahEnd": 114,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 285,
        "ref": "004/114",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 263,
        "input_status": "ok",
        "input_source_ref_groups": "004/114"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "004/114"
      ],
      "ayahs": [
        {
          "ref": "004/114",
          "surah": 4,
          "ayah": 114,
          "arabic": "لَّا خَيْرَ فِى كَثِيرٍ مِّن نَّجْوَىٰهُمْ إِلَّا مَنْ أَمَرَ بِصَدَقَةٍ أَوْ مَعْرُوفٍ أَوْ إِصْلَـٰحٍۭ بَيْنَ ٱلنَّاسِ ۚ وَمَن يَفْعَلْ ذَٰلِكَ ٱبْتِغَآءَ مَرْضَاتِ ٱللَّهِ فَسَوْفَ نُؤْتِيهِ أَجْرًا عَظِيمًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/114",
            "text": "Onların 'gizlice söyleşmelerinin' çoğunda hayır yok. Ancak bir sadaka vermeyi veya iyilikte bulunmayı ya da insanların arasını düzeltmeyi emredenlerinki başka. Kim Allah'ın rızasını isteyerek böyle yaparsa, artık ona büyük bir ecir vereceğiz."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/114",
            "text": "Ancak sadaka vermeyi yahut iyilik yapmayı ve insanların arasını düzeltmeyi gözeten kimseler müstesna, onların gizli toplantılarının çoğunda hayır yoktur. Bunları, Allah'ın rızasını kazanmak için yapana büyük ecir vereceğiz."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/114",
            "text": "No good is there in much of their private conversation, except for those who enjoin charity or that which is right or conciliation between people. And whoever does that seeking means to the approval of Allah - then We are going to give him a great reward."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/114",
            "text": "Most of their secret conferrings are devoid of good, unless one secretly enjoins in charity, good deeds, and setting the affairs of men right. We shall grant who ever does that seeking to please Allah a great reward."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Nisa",
