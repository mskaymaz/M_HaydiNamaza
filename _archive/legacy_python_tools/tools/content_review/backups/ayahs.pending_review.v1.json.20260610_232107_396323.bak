        "004/115"
      ],
      "ayahs": [
        {
          "ref": "004/115",
          "surah": 4,
          "ayah": 115,
          "arabic": "وَمَن يُشَاقِقِ ٱلرَّسُولَ مِنۢ بَعْدِ مَا تَبَيَّنَ لَهُ ٱلْهُدَىٰ وَيَتَّبِعْ غَيْرَ سَبِيلِ ٱلْمُؤْمِنِينَ نُوَلِّهِۦ مَا تَوَلَّىٰ وَنُصْلِهِۦ جَهَنَّمَ ۖ وَسَآءَتْ مَصِيرًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/115",
            "text": "Kim kendisine 'dosdoğru yol' apaçık belli olduktan sonra, elçiye muhalefet ederse ve mü'minlerin yolundan başka bir yola uyarsa, onu döndüğü şeyde bırakırız ve cehenneme sokarız. Ne kötü bir yataktır o!.."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/115",
            "text": "Doğru yol kendisine apaçık belli olduktan sonra, Peygamberden ayrılıp, inananların yolundan başkasına uyan kimseyi, döndüğü yöne döndürür ve onu cehenneme sokarız. Orası ne kötü bir dönüş yeridir!"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/115",
            "text": "And whoever opposes the Messenger after guidance has become clear to him and follows other than the way of the believers - We will give him what he has taken and drive him into Hell, and evil it is as a destination."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/115",
            "text": "As for him who sets himself against the Messenger and follows a path other than that of the believers even after true guidance had become clear to him, We will let him go to the way he has turned to, and We will cast him into Hell - an evil destination."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
