      ],
      "ayahs": [
        {
          "ref": "083/003",
          "surah": 83,
          "ayah": 3,
          "arabic": "وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "083/003",
            "text": "Kendileri onlara ölçtüklerinde veya tarttıklarında eksiltirler."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "083/003",
            "text": "İnsanlardan, kendileri bir şeyi ölçerek aldıkları zaman tam alan; ama onlara bir şeyi ölçüp tartarak verdiklerinde eksik tutan kimselerin, vay haline!"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "083/003",
            "text": "But if they give by measure or by weight to them, they cause loss."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "083/003",
            "text": "but who, when they measure or weigh for others, give less than their due."
          }
        }
      ],
