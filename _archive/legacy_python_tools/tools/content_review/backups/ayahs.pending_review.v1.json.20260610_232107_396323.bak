      "input": {
        "sira": 437,
        "ref": "007/034",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 113,
        "input_status": "ok",
        "input_source_ref_groups": "007/034"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "007/034"
      ],
      "ayahs": [
        {
          "ref": "007/034",
          "surah": 7,
          "ayah": 34,
          "arabic": "وَلِكُلِّ أُمَّةٍ أَجَلٌ ۖ فَإِذَا جَآءَ أَجَلُهُمْ لَا يَسْتَأْخِرُونَ سَاعَةً ۖ وَلَا يَسْتَقْدِمُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "007/034",
            "text": "Her ümmet için bir ecel vardır. Onların ecelleri gelince, ne bir saat ertelenebilirler ne de öne alınabilirler (tam zamanında çökerler.)"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "007/034",
            "text": "Her ümmet için belirli bir süre vardır; vakitleri dolunca ne bir saat gecikebilir ne de öne geçebilirler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "007/034",
            "text": "And for every nation is a [specified] term. So when their time has come, they will not remain behind an hour, nor will they precede [it]."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "007/034",
            "text": "For every community there is an appointed term; and when its term arrives, they cannot tarry behind a moment, nor can they get ahead."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
