          "ayah": 59,
          "arabic": "وَتِلْكَ ٱلْقُرَىٰٓ أَهْلَكْنَـٰهُمْ لَمَّا ظَلَمُوا۟ وَجَعَلْنَا لِمَهْلِكِهِم مَّوْعِدًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "018/059",
            "text": "İşte ülkeler (ve onların halkları), zulmettikleri zaman onları yıkıma uğrattık; ve yıkımları için bir buluşma zamanı tespit ettik."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "018/059",
            "text": "Haksızlıklarından ötürü işte yok ettiğimiz şehirler! Onları yok etmek için bir süre tayin etmiştik."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "018/059",
            "text": "And those cities - We destroyed them when they wronged, and We made for their destruction an appointed time."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "018/059",
            "text": "All the townships afflicted with scourge are before your eyes. When they committed wrong, We destroyed them. For the destruction of each We had set a definite term."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
