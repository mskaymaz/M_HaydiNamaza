      "ayahs": [
        {
          "ref": "051/047",
          "surah": 51,
          "ayah": 47,
          "arabic": "وَٱلسَّمَآءَ بَنَيْنَـٰهَا بِأَيْي۟دٍ وَإِنَّا لَمُوسِعُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "051/047",
            "text": "Biz göğü 'büyük bir kudretle' bina ettik ve şüphesiz Biz, (onu) genişleticiyiz."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "051/047",
            "text": "Göğü, gücümüzle Biz kurduk; şüphesiz biz onu genişleticiyiz."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "051/047",
            "text": "And the heaven We constructed with strength, and indeed, We are [its] expander."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "051/047",
            "text": "And heaven – We made it with Our Own Power and We have the Power to do so."
          }
        }
      ],
