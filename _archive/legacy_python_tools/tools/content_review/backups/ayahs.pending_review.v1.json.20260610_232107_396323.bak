    {
      "ref": "047/031",
      "id": "047/031",
      "surah": 47,
      "ayahStart": 31,
      "ayahEnd": 31,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 1158,
        "ref": "047/031",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 124,
        "input_status": "ok",
        "input_source_ref_groups": "047/031"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "047/031"
      ],
      "ayahs": [
        {
          "ref": "047/031",
          "surah": 47,
          "ayah": 31,
          "arabic": "وَلَنَبْلُوَنَّكُمْ حَتَّىٰ نَعْلَمَ ٱلْمُجَـٰهِدِينَ مِنكُمْ وَٱلصَّـٰبِرِينَ وَنَبْلُوَا۟ أَخْبَارَكُمْ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "047/031",
            "text": "Andolsun, Biz sizden mücahid olanlarla sabredenleri bilinceye (belli edip ortaya çıkarıncaya) kadar, deneyeceğiz ve haberlerinizi sınayacağız (açıklayacağız)."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "047/031",
            "text": "And olsun ki sizi, içinizden cihada çıkanları ve sabredenleri meydana çıkarana ve haberlerinizi açıklayana kadar deneyeceğiz."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "047/031",
            "text": "And We will surely test you until We make evident those who strive among you [for the cause of Allah] and the patient, and We will test your affairs."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "047/031",
            "text": "We shall certainly test you until We know those of you who truly strive and remain steadfast, and will ascertain about you."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Muhammed",
      "ayah_number": 31,
