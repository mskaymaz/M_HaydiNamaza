      "ayahs": [
        {
          "ref": "012/089",
          "surah": 12,
          "ayah": 89,
          "arabic": "قَالَ هَلْ عَلِمْتُم مَّا فَعَلْتُم بِيُوسُفَ وَأَخِيهِ إِذْ أَنتُمْ جَـٰهِلُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "012/089",
            "text": "(Yusuf) Dedi ki: \"Sizler, cahiller iken Yusuf'a ve kardeşine neler yaptığınızı biliyor musunuz?\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "012/089",
            "text": "\"Siz, Yusuf ve kardeşine bilmeden neler yaptığınızın farkında mısınız?\" dedi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "012/089",
            "text": "He said, \"Do you know what you did with Joseph and his brother when you were ignorant?\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "012/089",
            "text": "When Joseph heard this (he could not hold himself and said): \"Do you remember what you did to Joseph and his brother when you were ignorant?\""
          }
        }
      ],
