        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 119,
        "input_status": "ok",
        "input_source_ref_groups": "024/025"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "024/025"
      ],
      "ayahs": [
        {
          "ref": "024/025",
          "surah": 24,
          "ayah": 25,
          "arabic": "يَوْمَئِذٍ يُوَفِّيهِمُ ٱللَّهُ دِينَهُمُ ٱلْحَقَّ وَيَعْلَمُونَ أَنَّ ٱللَّهَ هُوَ ٱلْحَقُّ ٱلْمُبِينُ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "024/025",
            "text": "O gün, Allah hak ettikleri cezayı eksiksiz verecektir ve onlar da Allah'ın hiç şüphesiz hak olduğunu bileceklerdir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "024/025",
            "text": "O gün, Allah onlara kesinleşmiş cezalarını verecektir. Allah'ın apaçık hak olduğunu bileceklerdir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "024/025",
            "text": "That Day, Allah will pay them in full their deserved recompense, and they will know that it is Allah who is the perfect in justice."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "024/025",
            "text": "On that Day Allah will give them the full recompense they deserve, and they will realize that Allah is the very Truth, Who makes the Truth manifest."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
