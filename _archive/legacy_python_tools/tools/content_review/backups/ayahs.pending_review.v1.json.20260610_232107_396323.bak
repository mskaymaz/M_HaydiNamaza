          "ref": "051/011",
          "surah": 51,
          "ayah": 11,
          "arabic": "ٱلَّذِينَ هُمْ فِى غَمْرَةٍ سَاهُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "051/011",
            "text": "Ki onlar, 'bilgisizliğin kuşatması' içinde habersizdirler."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "051/011",
            "text": "Yalancılığı itiyat edinenlerin, bilgisizliğe saplanıp kalanların canları çıksın!"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "051/011",
            "text": "Who are within a flood [of confusion] and heedless."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "051/011",
            "text": "who are steeped in ignorance and heedlessness."
          }
        }
      ],
