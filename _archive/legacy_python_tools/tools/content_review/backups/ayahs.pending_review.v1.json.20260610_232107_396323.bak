    {
      "ref": "033/058",
      "id": "033/058",
      "surah": 33,
      "ayahStart": 58,
      "ayahEnd": 58,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 991,
        "ref": "033/058",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 126,
        "input_status": "ok",
        "input_source_ref_groups": "033/058"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "033/058"
      ],
      "ayahs": [
        {
          "ref": "033/058",
          "surah": 33,
          "ayah": 58,
          "arabic": "وَٱلَّذِينَ يُؤْذُونَ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ بِغَيْرِ مَا ٱكْتَسَبُوا۟ فَقَدِ ٱحْتَمَلُوا۟ بُهْتَـٰنًا وَإِثْمًا مُّبِينًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "033/058",
            "text": "Mü'min erkeklere ve mü'min kadınlara irtikab etmedikleri (bir suç) sebebiyle eziyet edenler ise, gerçekten bir iftira ve açık bir günah yüklenmişlerdir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "033/058",
            "text": "İnanan erkek ve kadınları, yapmadıkları bir şeyden ötürü incitenler, şüphesiz iftira etmiş ve apaçık bir günah yüklenmiş olurlar."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "033/058",
            "text": "And those who harm believing men and believing women for [something] other than what they have earned have certainly born upon themselves a slander and manifest sin."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "033/058",
            "text": "Those who cause hurt to believing men and to believing women have invited upon themselves a calumny and a manifest sin."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
