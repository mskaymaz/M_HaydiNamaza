      ],
      "ayahs": [
        {
          "ref": "054/049",
          "surah": 54,
          "ayah": 49,
          "arabic": "إِنَّا كُلَّ شَىْءٍ خَلَقْنَـٰهُ بِقَدَرٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "054/049",
            "text": "Hiç şüphesiz, Biz herşeyi kader ile yarattık."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "054/049",
            "text": "Şüphesiz Biz her şeyi bir ölçüye göre yaratmışızdır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "054/049",
            "text": "Indeed, all things We created with predestination."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "054/049",
            "text": "We have created everything in a determined measure."
          }
        }
      ],
