          "ref": "086/001",
          "surah": 86,
          "ayah": 1,
          "arabic": "\\basmalah وَٱلسَّمَآءِ وَٱلطَّارِقِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "086/001",
            "text": "Göğe ve Tarık'a andolsun,"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "086/001",
            "text": "Göğe ve Tarık'a and olsun;"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "086/001",
            "text": "By the sky and the night comer -"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "086/001",
            "text": "By the heaven, and the night-visitor,"
          }
        },
        {
          "ref": "086/002",
          "surah": 86,
          "ayah": 2,
          "arabic": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "086/002",
            "text": "Tarık'ın ne olduğunu sana bildiren nedir?"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "086/002",
            "text": "Tarık'ın ne olduğunu sen bilir misin?"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "086/002",
            "text": "And what can make you know what is the night comer?"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "086/002",
            "text": "what do you know what the night-visitor is?"
          }
        },
        {
          "ref": "086/003",
          "surah": 86,
          "ayah": 3,
          "arabic": "ٱلنَّجْمُ ٱلثَّاقِبُ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "086/003",
            "text": "(Karanlığı) Delen yıldızdır."
