      ],
      "ayahs": [
        {
          "ref": "056/001",
          "surah": 56,
          "ayah": 1,
          "arabic": "\\basmalah إِذَا وَقَعَتِ ٱلْوَاقِعَةُ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "056/001",
            "text": "Vakıa (kesin bir gerçek olan kıyamet) vuku bulduğu zaman,"
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "056/001",
            "text": "Kıyamet koptuğunda kimini alçaltacak ve kimini yükseltecek olan o hadisenin yalan olmadığı ortaya çıkacaktır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "056/001",
            "text": "When the Occurrence occurs,"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "056/001",
            "text": "When the Event will come to pass"
          }
        },
        {
          "ref": "056/002",
          "surah": 56,
          "ayah": 2,
          "arabic": "لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "056/002",
            "text": "Onun vukuuna (gerçekleşmesine artık) yalan diyecek yoktur."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "056/002",
            "text": "Kıyamet koptuğunda kimini alçaltacak ve kimini yükseltecek olan o hadisenin yalan olmadığı ortaya çıkacaktır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "056/002",
            "text": "There is, at its occurrence, no denial."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "056/002",
            "text": "– and then there will be no one to deny its occurrence –"
          }
        },
        {
          "ref": "056/003",
          "surah": 56,
          "ayah": 3,
          "arabic": "خَافِضَةٌ رَّافِعَةٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "056/003",
            "text": "O aşağılatıcı, yücelticidir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "056/003",
            "text": "Kıyamet koptuğunda kimini alçaltacak ve kimini yükseltecek olan o hadisenin yalan olmadığı ortaya çıkacaktır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "056/003",
            "text": "It will bring down [some] and raise up [others]."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "056/003",
            "text": "(a calamitous Event) that shall turn things upside down:"
          }
        }
      ],
