      "sourceRefGroups": [
        "003/139"
      ],
      "ayahs": [
        {
          "ref": "003/139",
          "surah": 3,
          "ayah": 139,
          "arabic": "وَلَا تَهِنُوا۟ وَلَا تَحْزَنُوا۟ وَأَنتُمُ ٱلْأَعْلَوْنَ إِن كُنتُم مُّؤْمِنِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulac",
            "sourceRef": "003/139",
            "text": "Gevşemeyin, üzülmeyin; eğer (gerçekten) iman etmişseniz en üstün olan sizlersiniz."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "003/139",
            "text": "So do not weaken and do not grieve, and you will be superior if you are [true] believers."
          },
          "alternatives": {
            "tr_diyanet_tanzil": {
              "source": "Tanzil tr.diyanet / Diyanet Isleri",
              "text": "Gevşemeyin, üzülmeyin, inanmışsanız, mutlaka siz en üstünsünüzdür."
            },
            "en_maududi": {
              "source": "Tanzil en.maududi / Abul A'la Maududi",
              "text": "Do not, then, either lose heart or grieve: for you shall surely gain the upper hand if you are true men of faith."
            }
          }
        }
      ],
