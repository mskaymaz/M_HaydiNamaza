      },
      "sourceRefGroups": [
        "061/013"
      ],
      "ayahs": [
        {
          "ref": "061/013",
          "surah": 61,
          "ayah": 13,
          "arabic": "وَأُخْرَىٰ تُحِبُّونَهَا ۖ نَصْرٌ مِّنَ ٱللَّهِ وَفَتْحٌ قَرِيبٌ ۗ وَبَشِّرِ ٱلْمُؤْمِنِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "061/013",
            "text": "Ve seveceğiniz bir başka (nimet) daha var: Allah'tan 'yardım ve zafer (nusret)' ve yakın bir fetih. Mü'minleri müjdele."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "061/013",
            "text": "Bundan başka, sevdiğiniz bir şey daha: Allah katından bir yardım ve yakın bir zafer vardır. İnananlara müjde ver."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "061/013",
            "text": "And [you will obtain] another [favor] that you love - victory from Allah and an imminent conquest; and give good tidings to the believers."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "061/013",
            "text": "He will also grant you the other favour that you desire: help from Allah and a victory that will come soon. Give glad tidings of this to the believers."
          }
        }
      ],
      "status": "approved",
