    {
      "ref": "002/223",
      "id": "002/223",
      "surah": 2,
      "ayahStart": 223,
      "ayahEnd": 223,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 106,
        "ref": "002/223",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 260,
        "input_status": "ok",
        "input_source_ref_groups": "002/223"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "002/223"
      ],
      "ayahs": [
        {
          "ref": "002/223",
          "surah": 2,
          "ayah": 223,
          "arabic": "نِسَآؤُكُمْ حَرْثٌ لَّكُمْ فَأْتُوا۟ حَرْثَكُمْ أَنَّىٰ شِئْتُمْ ۖ وَقَدِّمُوا۟ لِأَنفُسِكُمْ ۚ وَٱتَّقُوا۟ ٱللَّهَ وَٱعْلَمُوٓا۟ أَنَّكُم مُّلَـٰقُوهُ ۗ وَبَشِّرِ ٱلْمُؤْمِنِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "002/223",
            "text": "Kadınlarınız sizin tarlanızdır; tarlanıza dilediğiniz gibi varın. Kendiniz için (geleceğe hazırlık olarak güzel davranışlar) takdim edin. Allah'tan korkup-sakının ve bilin ki elbette O'na kavuşucusunuz. İman edenlere müjde ver."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "002/223",
            "text": "Kadınlarınız sizin tarlanızdır, tarlanıza istediğiniz gibi gelin. İstikbal için hazırlıklı olun, Allah'tan sakının. O'na, hiç şüphesiz kavuşacağınızı bilin, bunu inananlara müjdele."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "002/223",
            "text": "Your wives are a place of sowing of seed for you, so come to your place of cultivation however you wish and put forth [righteousness] for yourselves. And fear Allah and know that you will meet Him. And give good tidings to the believers."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "002/223",
            "text": "Your wives are your tilth: so you may go to your tilth as you please, but you should take care of your future and refrain from the displeasure of Allah. Know it well that One Day you shall meet Him. (O Prophet!) bear good tidings to the Believers."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
