    {
      "ref": "021/057-060",
      "id": "021/057-060",
      "surah": 21,
      "ayahStart": 57,
      "ayahEnd": 60,
      "type": "range",
      "ayahCount": 4,
      "input": {
        "sira": 784,
        "ref": "021/057-060",
        "input_type": "aralik",
        "input_ayah_count": 4,
        "input_char_count": 393,
        "input_status": "ok",
        "input_source_ref_groups": "021/057, 021/058, 021/059, 021/060"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "021/057",
        "021/058",
        "021/059",
        "021/060"
      ],
      "ayahs": [
        {
          "ref": "021/057",
          "surah": 21,
          "ayah": 57,
          "arabic": "وَتَٱللَّهِ لَأَكِيدَنَّ أَصْنَـٰمَكُم بَعْدَ أَن تُوَلُّوا۟ مُدْبِرِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "021/057",
            "text": "\"Andolsun Allah'a, sizler arkanızı dönüp gittikten sonra, ben sizin putlarınıza muhakkak bir tuzak kuracağım.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "021/057",
            "text": "\"Allah'a yemin ederim ki, siz ayrıldıktan sonra, putlarınıza bir tuzak kuracağım!\""
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "021/057",
            "text": "And [I swear] by Allah, I will surely plan against your idols after you have turned and gone away.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "021/057",
            "text": "By Allah, I shall certainly carry out my plan against your gods after you are gone.\""
          }
        },
        {
          "ref": "021/058",
          "surah": 21,
          "ayah": 58,
          "arabic": "فَجَعَلَهُمْ جُذَٰذًا إِلَّا كَبِيرًا لَّهُمْ لَعَلَّهُمْ إِلَيْهِ يَرْجِعُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "021/058",
            "text": "Böylece o, yalnızca büyükleri hariç olmak üzere onları paramparça etti; belki ona başvururlar diye."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "021/058",
            "text": "Hepsini paramparça edip, içlerinden büyüğünü ona başvursunlar diye, sağlam bıraktı."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "021/058",
            "text": "So he made them into fragments, except a large one among them, that they might return to it [and question]."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "021/058",
            "text": "Then he broke them all into pieces, sparing only the supreme one among them that they may possibly return to him."
          }
        },
        {
          "ref": "021/059",
          "surah": 21,
          "ayah": 59,
          "arabic": "قَالُوا۟ مَن فَعَلَ هَـٰذَا بِـَٔالِهَتِنَآ إِنَّهُۥ لَمِنَ ٱلظَّـٰلِمِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "021/059",
            "text": "\"Bizim ilahlarımıza bunu kim yaptı? Şüphesiz o, zalimlerden biridir\" dediler."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "021/059",
            "text": "Milleti: \"Tanrılarımıza bunu kim yaptı? Doğrusu o zalimlerden biridir\" dediler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "021/059",
            "text": "They said, \"Who has done this to our gods? Indeed, he is of the wrongdoers.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "021/059",
            "text": "(When they saw the idols in this state) they said: \"Who has done this to our gods? Surely he is one of the wrong-doers.\""
          }
        },
        {
          "ref": "021/060",
          "surah": 21,
          "ayah": 60,
          "arabic": "قَالُوا۟ سَمِعْنَا فَتًى يَذْكُرُهُمْ يُقَالُ لَهُۥٓ إِبْرَٰهِيمُ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "021/060",
            "text": "\"Kendisine İbrahim denilen bir gencin bunları diline doladığını işittik\" dediler."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "021/060",
            "text": "Bazıları: \"İbrahim denen bir gencin onları diline doladığını duymuştuk\" deyince, \"O halde bunların şahidlik edebilmeleri için onu halkın gözü önüne getirin\" dediler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "021/060",
            "text": "They said, \"We heard a young man mention them who is called Abraham.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "021/060",
            "text": "Some of them said: \"We heard a youth called Abraham speak (ill) of them.\""
          }
        }
      ],
      "status": "approved",
