      "ref": "073/004",
      "id": "073/004",
      "surah": 73,
      "ayahStart": 4,
      "ayahEnd": 4,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 1341,
        "ref": "073/004",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 57,
        "input_status": "ok",
        "input_source_ref_groups": "073/004"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "073/004"
      ],
      "ayahs": [
        {
          "ref": "073/004",
          "surah": 73,
          "ayah": 4,
          "arabic": "أَوْ زِدْ عَلَيْهِ وَرَتِّلِ ٱلْقُرْءَانَ تَرْتِيلًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "073/004",
            "text": "Veya üzerine ilave et. Ve Kur'an'ı belli bir düzen içinde (tertil üzere) oku."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "073/004",
            "text": "Ey örtünüp bürünen! Gecenin yarısında, istersen biraz sonra, istersen biraz önce bir müddet için kalk ve ağır ağır Kuran oku."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "073/004",
            "text": "Or add to it, and recite the Qur'an with measured recitation."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "073/004",
            "text": "or add to it a little; and recite the Qur'an slowly and distinctly."
          }
        }
