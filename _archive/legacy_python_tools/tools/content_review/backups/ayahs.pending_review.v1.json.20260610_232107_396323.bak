          "ayah": 39,
          "arabic": "وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "037/039",
            "text": "Yaptıklarınızdan başkasıyla cezalandırılmayacaksınız."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "037/039",
            "text": "Yaptığınızdan başka birşeyle cezalanmayacaksınız."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "037/039",
            "text": "And you will not be recompensed except for what you used to do -"
