      },
      "source": {
        "arabic": "Existing clean UTF-8 Uthmani Arabic text from prior working dataset; Tanzil Uthmani Arabic verification/fetch script available",
        "tr": "Tanzil tr.bulac - Ali Bulaç",
        "en": "Tanzil en.sahih - Saheeh International",
        "tr_alternative": "Tanzil tr.diyanet - Diyanet İşleri",
        "en_alternative": "Tanzil en.maududi - Abul A’la Maududi"
      },
      "sourceRefGroups": [
        "002/007"
      ],
      "ayahs": [
        {
          "ref": "002/007",
          "surah": 2,
          "ayah": 7,
          "arabic": "خَتَمَ ٱللَّهُ عَلَىٰ قُلُوبِهِمْ وَعَلَىٰ سَمْعِهِمْ ۖ وَعَلَىٰٓ أَبْصَـٰرِهِمْ غِشَـٰوَةٌ ۖ وَلَهُمْ عَذَابٌ عَظِيمٌ",
          "tr": {
            "source": "Tanzil tr.bulac - Ali Bulaç",
            "text": "Allah, onların kalplerini ve kulaklarını mühürlemiştir; gözlerinin üzerinde perdeler vardır. Ve büyük azap onlaradır."
          },
          "en": {
            "source": "Tanzil en.sahih - Saheeh International",
            "text": "Allah has set a seal upon their hearts and upon their hearing, and over their vision is a veil. And for them is a great punishment."
          },
          "alternatives": {
            "tr_diyanet_tanzil": {
              "source": "Tanzil tr.diyanet - Diyanet İşleri",
              "text": "Allah onların kalblerini ve kulaklarını mühürlemiştir, gözlerinde de perde vardır ve büyük azab onlar içindir."
            },
            "en_maududi": {
              "source": "Tanzil en.maududi - Abul A’la Maududi",
              "text": "Allah has sealed up their hearts and ears and a covering has fallen over their eyes, and they have incurred the severest punishment."
            }
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "pending_review",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "",
        "updated_at": null
      },
      "text_tr": "Allah, onların kalplerini ve kulaklarını mühürlemiştir; gözlerinin üzerinde perdeler vardır. Ve büyük azap onlaradır.",
      "text_ar": "خَتَمَ ٱللَّهُ عَلَىٰ قُلُوبِهِمْ وَعَلَىٰ سَمْعِهِمْ ۖ وَعَلَىٰٓ أَبْصَـٰرِهِمْ غِشَـٰوَةٌ ۖ وَلَهُمْ عَذَابٌ عَظِيمٌ",
      "text_en": "Allah has set a seal upon their hearts and upon their hearing, and over their vision is a veil. And for them is a great punishment."
