          "surah": 83,
          "ayah": 13,
          "arabic": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَـٰتُنَا قَالَ أَسَـٰطِيرُ ٱلْأَوَّلِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "083/013",
            "text": "Ona ayetlerimiz okunduğu zaman: \"Geçmişlerin masallarıdır\" dedi."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "083/013",
            "text": "Ona ayetlerimiz okunduğu zaman \"Öncekilerin masalları\" der."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "083/013",
            "text": "When Our verses are recited to him, he says, \"Legends of the former peoples.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "083/013",
            "text": "who, when Our verses are recited to him, says: “Mere tales of olden times!”"
          }
        }
      ],
