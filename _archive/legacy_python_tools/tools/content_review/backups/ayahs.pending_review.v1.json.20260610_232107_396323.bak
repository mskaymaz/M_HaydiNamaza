      "ayahEnd": 79,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": null,
        "ref": "005/079",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 0,
        "input_status": "tool_ekle",
        "input_source_ref_groups": "005/079"
      },
      "source": {
        "arabic": "Tanzil Uthmani Quran Text",
        "tr": "Tanzil tr.bulac / Ali Bulac",
        "trAlt": "Tanzil tr.diyanet / Diyanet Isleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A'la Maududi"
      },
      "sourceRefGroups": [
        "005/079"
      ],
      "ayahs": [
        {
          "ref": "005/079",
          "surah": 5,
          "ayah": 79,
          "arabic": "كَانُوا۟ لَا يَتَنَاهَوْنَ عَن مُّنكَرٍ فَعَلُوهُ ۚ لَبِئْسَ مَا كَانُوا۟ يَفْعَلُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulac",
            "sourceRef": "005/079",
            "text": "Yapmakta oldukları münker(çirkin iş)lerden birbirlerini sakındırmıyorlardı. Yapmakta oldukları şey ne kötü idi!"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "005/079",
            "text": "They used not to prevent one another from wrongdoing that they did. How wretched was that which they were doing."
          },
          "alternatives": {
            "tr_diyanet_tanzil": {
              "source": "Tanzil tr.diyanet / Diyanet Isleri",
              "text": "Birbirlerinin yaptıkları fenalıklara mani olmuyorlardı. Yapmakta oldukları ne kötü idi!"
            },
            "en_maududi": {
              "source": "Tanzil en.maududi / Abul A'la Maududi",
              "text": "They did not forbid each other from committing the abominable deeds they committed. Indeed what they did was evil."
            }
          }
        }
      ],
      "status": "approved",
