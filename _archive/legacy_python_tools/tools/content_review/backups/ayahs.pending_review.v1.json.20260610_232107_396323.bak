        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 127,
        "input_status": "ok",
        "input_source_ref_groups": "007/178"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "007/178"
      ],
      "ayahs": [
        {
          "ref": "007/178",
          "surah": 7,
          "ayah": 178,
          "arabic": "مَن يَهْدِ ٱللَّهُ فَهُوَ ٱلْمُهْتَدِى ۖ وَمَن يُضْلِلْ فَأُو۟لَـٰٓئِكَ هُمُ ٱلْخَـٰسِرُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "007/178",
            "text": "Allah kime hidayet verirse o artık hidayeti bulmuştur; kimi şaşırtıp-saptırırsa artık onlar da hüsrana uğrayanlardır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "007/178",
            "text": "Allah'ın doğru yola sevkettiği kimse doğru yolda olur. Saptırdığı kimseler ise, işte onlar mahvolanlardır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "007/178",
            "text": "Whoever Allah guides - he is the [rightly] guided; and whoever He sends astray - it is those who are the losers."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "007/178",
            "text": "He whom Allah guides, he alone is rightly guided; and he whom Allah lets go astray - it is they who are the loser.'"
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
