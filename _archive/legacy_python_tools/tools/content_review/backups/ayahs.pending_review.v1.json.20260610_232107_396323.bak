      "sourceRefGroups": [
        "027/013"
      ],
      "ayahs": [
        {
          "ref": "027/013",
          "surah": 27,
          "ayah": 13,
          "arabic": "فَلَمَّا جَآءَتْهُمْ ءَايَـٰتُنَا مُبْصِرَةً قَالُوا۟ هَـٰذَا سِحْرٌ مُّبِينٌ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "027/013",
            "text": "Ayetlerimiz onlara, gözler önünde sergilenmiş olarak gelince dediler ki: \"Bu, apaçık olan bir büyüdür.\""
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "027/013",
            "text": "Ayetlerimiz gözlerinin önüne serilince: \"Bu apaçık bir sihirdir\" dediler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "027/013",
            "text": "But when there came to them Our visible signs, they said, \"This is obvious magic.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "027/013",
            "text": "But when Our Clear Signs came to them, they said: \"This is plain magic.\""
          }
        }
      ],
      "status": "approved",
