      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "066/009"
      ],
      "ayahs": [
        {
          "ref": "066/009",
          "surah": 66,
          "ayah": 9,
          "arabic": "يَـٰٓأَيُّهَا ٱلنَّبِىُّ جَـٰهِدِ ٱلْكُفَّارَ وَٱلْمُنَـٰفِقِينَ وَٱغْلُظْ عَلَيْهِمْ ۚ وَمَأْوَىٰهُمْ جَهَنَّمُ ۖ وَبِئْسَ ٱلْمَصِيرُ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "066/009",
            "text": "Ey Peygamber, kafirlere ve münafıklara karşı cihad et ve onlara karşı 'sert ve caydırıcı' davran. Onların barınma yeri cehennemdir. Ne kötü bir dönüş yeridir o."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "066/009",
            "text": "Ey Peygamber! İnkarcılarla ve ikiyüzlülerle savaş; onlara karşı sert davran. Onların varacakları yer cehennemdir, ne kötü dönüştür!..."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "066/009",
            "text": "O Prophet, strive against the disbelievers and the hypocrites and be harsh upon them. And their refuge is Hell, and wretched is the destination."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "066/009",
            "text": "O Prophet, strive against the unbelievers and the hypocrites, and be severe with them. Hell shall be their resort. What a grievous end!"
          }
        }
      ],
      "status": "approved",
