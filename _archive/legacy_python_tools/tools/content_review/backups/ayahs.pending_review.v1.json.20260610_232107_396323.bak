        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 84,
        "input_status": "ok",
        "input_source_ref_groups": "005/086"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "005/086"
      ],
      "ayahs": [
        {
          "ref": "005/086",
          "surah": 5,
          "ayah": 86,
          "arabic": "وَٱلَّذِينَ كَفَرُوا۟ وَكَذَّبُوا۟ بِـَٔايَـٰتِنَآ أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلْجَحِيمِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "005/086",
            "text": "İnkar edenler ve ayetlerimizi yalanlayanlar; işte onlar, çılgın ateşin arkadaşlarıdırlar."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "005/086",
            "text": "İnkar edip ayetlerimizi yalanlayanlar, işte onlar cehennemliklerdir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "005/086",
            "text": "But those who disbelieved and denied Our signs - they are the companions of Hellfire."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "005/086",
            "text": "Those who disbelieved and gave the lie to Our signs are rightfully the inmates of the Blazing Flame."
          }
        }
      ],
      "status": "approved",
