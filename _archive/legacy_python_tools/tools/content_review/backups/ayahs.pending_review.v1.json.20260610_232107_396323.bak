            "text": "Woe to the stinters;"
          }
        },
        {
          "ref": "083/002",
          "surah": 83,
          "ayah": 2,
          "arabic": "ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "083/002",
            "text": "Ki onlar, insanlardan ölçerek aldıklarında noksansız alırlar."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "083/002",
            "text": "İnsanlardan, kendileri bir şeyi ölçerek aldıkları zaman tam alan; ama onlara bir şeyi ölçüp tartarak verdiklerinde eksik tutan kimselerin, vay haline!"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "083/002",
            "text": "Who, when they take a measure from people, take in full."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "083/002",
            "text": "those who, when they take from others by measure, take their full share;"
          }
        },
        {
          "ref": "083/003",
          "surah": 83,
          "ayah": 3,
          "arabic": "وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "083/003",
            "text": "Kendileri onlara ölçtüklerinde veya tarttıklarında eksiltirler."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "083/003",
            "text": "İnsanlardan, kendileri bir şeyi ölçerek aldıkları zaman tam alan; ama onlara bir şeyi ölçüp tartarak verdiklerinde eksik tutan kimselerin, vay haline!"
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "083/003",
            "text": "But if they give by measure or by weight to them, they cause loss."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "083/003",
            "text": "but who, when they measure or weigh for others, give less than their due."
          }
        }
      ],
