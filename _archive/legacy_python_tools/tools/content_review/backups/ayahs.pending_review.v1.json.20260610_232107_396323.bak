      "input": {
        "sira": 254,
        "ref": "004/047",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 278,
        "input_status": "ok",
        "input_source_ref_groups": "004/047"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "004/047"
      ],
      "ayahs": [
        {
          "ref": "004/047",
          "surah": 4,
          "ayah": 47,
          "arabic": "يَـٰٓأَيُّهَا ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ ءَامِنُوا۟ بِمَا نَزَّلْنَا مُصَدِّقًا لِّمَا مَعَكُم مِّن قَبْلِ أَن نَّطْمِسَ وُجُوهًا فَنَرُدَّهَا عَلَىٰٓ أَدْبَارِهَآ أَوْ نَلْعَنَهُمْ كَمَا لَعَنَّآ أَصْحَـٰبَ ٱلسَّبْتِ ۚ وَكَانَ أَمْرُ ٱللَّهِ مَفْعُولًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/047",
            "text": "Ey kendilerine kitap verilenler birtakım yüzleri silip de arkalarına çevirmeden ya da cumartesi adamlarını (o gün yasağı çiğneyenleri) lanetlediğimiz gibi onları da lanetlemeden evvel, yanınızdakini (Tevrat ve İncil'i) doğrulayıcı olarak indirdiğimize (Kur'an'a) iman edin. Allah'ın emri yapılagelmiştir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/047",
            "text": "Ey Kitap verilenler! Yüzleri silip arkaya çevirerek enseler gibi dümdüz yapmadan, yahut cumartesi güncüleri lanetlediğimiz gibi lanetlemeden önce, yanınızdakini tasdik ederek indirdiğimiz Kuran'a inanın; Allah'ın emri daima yapılagelmiştir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/047",
            "text": "O you who were given the Scripture, believe in what We have sent down [to Muhammad], confirming that which is with you, before We obliterate faces and turn them toward their backs or curse them as We cursed the sabbath-breakers. And ever is the decree of Allah accomplished."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/047",
            "text": "O you who have been granted the Book! Do believe in what We have (now) revealed, which confirms the revelation which you already possess. Do this before We alter countenances, turning them backwards, or lay a curse upon them as We cursed the Sabbath-men. Bear in mind that Allah's command is done."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
