    {
      "ref": "004/090",
      "id": "004/090",
      "surah": 4,
      "ayahStart": 90,
      "ayahEnd": 90,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 274,
        "ref": "004/090",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 400,
        "input_status": "ok",
        "input_source_ref_groups": "004/090"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "004/090"
      ],
      "ayahs": [
        {
          "ref": "004/090",
          "surah": 4,
          "ayah": 90,
          "arabic": "إِلَّا ٱلَّذِينَ يَصِلُونَ إِلَىٰ قَوْمٍۭ بَيْنَكُمْ وَبَيْنَهُم مِّيثَـٰقٌ أَوْ جَآءُوكُمْ حَصِرَتْ صُدُورُهُمْ أَن يُقَـٰتِلُوكُمْ أَوْ يُقَـٰتِلُوا۟ قَوْمَهُمْ ۚ وَلَوْ شَآءَ ٱللَّهُ لَسَلَّطَهُمْ عَلَيْكُمْ فَلَقَـٰتَلُوكُمْ ۚ فَإِنِ ٱعْتَزَلُوكُمْ فَلَمْ يُقَـٰتِلُوكُمْ وَأَلْقَوْا۟ إِلَيْكُمُ ٱلسَّلَمَ فَمَا جَعَلَ ٱللَّهُ لَكُمْ عَلَيْهِمْ سَبِيلًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/090",
            "text": "Ancak sizinle aralarında andlaşma bulunan bir kavme sığınanlar ya da hem sizinle, hem kendi kavimleriyle savaşmak (istemeyip bun)dan göğüslerini sıkıntı basıp size gelenler (dokunulmazdır.) Allah dileseydi, onları üstünüze saldırtır, böylece sizinle çarpışırlardı. Eğer sizden uzak durur (geri çekilir), sizinle savaşmaz ve barış (şartların)ı size bırakırlarsa, artık Allah, sizin için onların aleyhinde bir yol kılmamıştır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/090",
            "text": "Ancak, sizinle kendileri arasında anlaşma olan bir millete sığınanlar yahut sizinle savaştan veya kendi milletleriyle savaşmaktan bıkarak size başvuranlar müstesnadır. Allah dileseydi onları üzerinize çullandırırdı da sizinle savaşırlardı. Eğer sizden uzak durur, sizinle savaşmaz, size barış teklif ederlerse Allah onlara dokunmanıza izin vermez."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/090",
            "text": "Except for those who take refuge with a people between yourselves and whom is a treaty or those who come to you, their hearts strained at [the prospect of] fighting you or fighting their own people. And if Allah had willed, He could have given them power over you, and they would have fought you. So if they remove themselves from you and do not fight you and offer you peace, then Allah has not made for you a cause [for fighting] against them."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/090",
            "text": "unless it be such of them who seek refuge with a people who are joined with you by a covenant, or those who come to you because their hearts shrink from fighting either against you or against their own people. Had Allah so willed, He would certainly have given them power over you and they would have fought against you. If they leave you alone and do not fight against you and offer you peace,, then Allah does not permit you to harm them."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Nisa",
      "ayah_number": 90,
      "ayah_end_number": 90,
      "text_ar": "إِلَّا ٱلَّذِينَ يَصِلُونَ إِلَىٰ قَوْمٍۭ بَيْنَكُمْ وَبَيْنَهُم مِّيثَـٰقٌ أَوْ جَآءُوكُمْ حَصِرَتْ صُدُورُهُمْ أَن يُقَـٰتِلُوكُمْ أَوْ يُقَـٰتِلُوا۟ قَوْمَهُمْ ۚ وَلَوْ شَآءَ ٱللَّهُ لَسَلَّطَهُمْ عَلَيْكُمْ فَلَقَـٰتَلُوكُمْ ۚ فَإِنِ ٱعْتَزَلُوكُمْ فَلَمْ يُقَـٰتِلُوكُمْ وَأَلْقَوْا۟ إِلَيْكُمُ ٱلسَّلَمَ فَمَا جَعَلَ ٱللَّهُ لَكُمْ عَلَيْهِمْ سَبِيلًا",
      "text_tr": "Ancak sizinle aralarında andlaşma bulunan bir kavme sığınanlar ya da hem sizinle, hem kendi kavimleriyle savaşmak (istemeyip bun)dan göğüslerini sıkıntı basıp size gelenler (dokunulmazdır.) Allah dileseydi, onları üstünüze saldırtır, böylece sizinle çarpışırlardı. Eğer sizden uzak durur (geri çekilir), sizinle savaşmaz ve barış (şartların)ı size bırakırlarsa, artık Allah, sizin için onların aleyhinde bir yol kılmamıştır.",
      "text_en": "Except for those who take refuge with a people between yourselves and whom is a treaty or those who come to you, their hearts strained at [the prospect of] fighting you or fighting their own people. And if Allah had willed, He could have given them power over you, and they would have fought you. So if they remove themselves from you and do not fight you and offer you peace, then Allah has not made for you a cause [for fighting] against them.",
