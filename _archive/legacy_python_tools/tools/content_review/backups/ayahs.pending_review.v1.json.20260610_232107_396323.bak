    {
      "ref": "004/049",
      "id": "004/049",
      "surah": 4,
      "ayahStart": 49,
      "ayahEnd": 49,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 256,
        "ref": "004/049",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 121,
        "input_status": "ok",
        "input_source_ref_groups": "004/049"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "004/049"
      ],
      "ayahs": [
        {
          "ref": "004/049",
          "surah": 4,
          "ayah": 49,
          "arabic": "أَلَمْ تَرَ إِلَى ٱلَّذِينَ يُزَكُّونَ أَنفُسَهُم ۚ بَلِ ٱللَّهُ يُزَكِّى مَن يَشَآءُ وَلَا يُظْلَمُونَ فَتِيلًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/049",
            "text": "Kendilerini (övgüyle) temize çıkaranları görmedin mi? Hayır; Allah, dilediğini temizleyip yüceltir. Onlar, 'bir hurma çekirdeğindeki iplikçik kadar' bile haksızlığa uğratılmazlar."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/049",
            "text": "Kendilerini temize çıkaranları görmedin mi? Allah dilediğini temize çıkarır ve kendilerine kıl kadar haksızlık yapmaz."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/049",
            "text": "Have you not seen those who claim themselves to be pure? Rather, Allah purifies whom He wills, and injustice is not done to them, [even] as much as a thread [inside a date seed]."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/049",
            "text": "Have you not seen those who boast of their righteousness, even though it is Allah Who grants righteousness to whomsoever He wills? They are not wronged even as much as the husk of a date-stone (if they do not receive righteousness)."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Nisa",
      "ayah_number": 49,
      "ayah_end_number": 49,
      "text_ar": "أَلَمْ تَرَ إِلَى ٱلَّذِينَ يُزَكُّونَ أَنفُسَهُم ۚ بَلِ ٱللَّهُ يُزَكِّى مَن يَشَآءُ وَلَا يُظْلَمُونَ فَتِيلًا",
      "text_tr": "Kendilerini (övgüyle) temize çıkaranları görmedin mi? Hayır; Allah, dilediğini temizleyip yüceltir. Onlar, 'bir hurma çekirdeğindeki iplikçik kadar' bile haksızlığa uğratılmazlar.",
      "text_en": "Have you not seen those who claim themselves to be pure? Rather, Allah purifies whom He wills, and injustice is not done to them, [even] as much as a thread [inside a date seed].",
      "priority": 1,
      "notes": "bulk approved from local Tanzil source",
      "createdAt": "2026-06-09T08:52:44+00:00",
      "updatedAt": "2026-06-09T08:52:44+00:00",
      "approvedAt": "2026-06-09T08:52:44+00:00",
