    {
      "ref": "016/023",
      "id": "016/023",
      "surah": 16,
      "ayahStart": 23,
      "ayahEnd": 23,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 669,
        "ref": "016/023",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 112,
        "input_status": "ok",
        "input_source_ref_groups": "016/023"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "016/023"
      ],
      "ayahs": [
        {
          "ref": "016/023",
          "surah": 16,
          "ayah": 23,
          "arabic": "لَا جَرَمَ أَنَّ ٱللَّهَ يَعْلَمُ مَا يُسِرُّونَ وَمَا يُعْلِنُونَ ۚ إِنَّهُۥ لَا يُحِبُّ ٱلْمُسْتَكْبِرِينَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "016/023",
            "text": "Şüphesiz Allah, onların saklı tuttuklarını ve açığa vurduklarını bilir; gerçekten O, müstekbirleri sevmez."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "016/023",
            "text": "Onların gizlediklerini de, açığa vurduklarını da Allah'ın bildiğinde şüphe yoktur. O, büyüklük taslayanları sevmez."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "016/023",
            "text": "Assuredly, Allah knows what they conceal and what they declare. Indeed, He does not like the arrogant."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "016/023",
            "text": "Surely Allah knows all that they conceal and all that they disclose. He certainly does not love those who are steeped in arrogance."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
