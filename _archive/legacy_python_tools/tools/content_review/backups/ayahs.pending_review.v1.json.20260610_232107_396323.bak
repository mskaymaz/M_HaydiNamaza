    {
      "ref": "010/012",
      "id": "010/012",
      "surah": 10,
      "ayahStart": 12,
      "ayahEnd": 12,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 575,
        "ref": "010/012",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 368,
        "input_status": "ok",
        "input_source_ref_groups": "010/012"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "010/012"
      ],
      "ayahs": [
        {
          "ref": "010/012",
          "surah": 10,
          "ayah": 12,
          "arabic": "وَإِذَا مَسَّ ٱلْإِنسَـٰنَ ٱلضُّرُّ دَعَانَا لِجَنۢبِهِۦٓ أَوْ قَاعِدًا أَوْ قَآئِمًا فَلَمَّا كَشَفْنَا عَنْهُ ضُرَّهُۥ مَرَّ كَأَن لَّمْ يَدْعُنَآ إِلَىٰ ضُرٍّ مَّسَّهُۥ ۚ كَذَٰلِكَ زُيِّنَ لِلْمُسْرِفِينَ مَا كَانُوا۟ يَعْمَلُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "010/012",
            "text": "İnsana bir zarar dokunduğunda, yan yatarken, otururken ya da ayaktayken Bize dua eder; zararını üstünden kaldırdığımız zaman ise, sanki kendisine dokunan zarara Bizi hiç çağırmamış gibi döner-gider. İşte, ölçüyü taşıranlara yapmakta oldukları böyle süslenmiştir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "010/012",
            "text": "İnsana bir darlık gelince, yan yatarken, oturur veya ayakta iken bize yalvarıp yakarır; biz darlığını giderince, başına gelen darlıktan ötürü bize hiç yalvarmamışa döner. İşlerinde tutumsuz olanlara, yaptıkları böylece güzel görünür."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "010/012",
            "text": "And when affliction touches man, he calls upon Us, whether lying on his side or sitting or standing; but when We remove from him his affliction, he continues [in disobedience] as if he had never called upon Us to [remove] an affliction that touched him. Thus is made pleasing to the transgressors that which they have been doing"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "010/012",
            "text": "And (such is man that) when an affliction befalls him, he cries out to Us, reclining and sitting and standing. But no sooner than We have removed his affliction, he passes on as though he had never cried out to Us to remove his affliction. Thus it is that the misdeeds of the transgressors are made fair-seeming to them."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
      "surah_name": "Yunus",
      "ayah_number": 12,
      "ayah_end_number": 12,
      "text_ar": "وَإِذَا مَسَّ ٱلْإِنسَـٰنَ ٱلضُّرُّ دَعَانَا لِجَنۢبِهِۦٓ أَوْ قَاعِدًا أَوْ قَآئِمًا فَلَمَّا كَشَفْنَا عَنْهُ ضُرَّهُۥ مَرَّ كَأَن لَّمْ يَدْعُنَآ إِلَىٰ ضُرٍّ مَّسَّهُۥ ۚ كَذَٰلِكَ زُيِّنَ لِلْمُسْرِفِينَ مَا كَانُوا۟ يَعْمَلُونَ",
      "text_tr": "İnsana bir zarar dokunduğunda, yan yatarken, otururken ya da ayaktayken Bize dua eder; zararını üstünden kaldırdığımız zaman ise, sanki kendisine dokunan zarara Bizi hiç çağırmamış gibi döner-gider. İşte, ölçüyü taşıranlara yapmakta oldukları böyle süslenmiştir.",
      "text_en": "And when affliction touches man, he calls upon Us, whether lying on his side or sitting or standing; but when We remove from him his affliction, he continues [in disobedience] as if he had never called upon Us to [remove] an affliction that touched him. Thus is made pleasing to the transgressors that which they have been doing",
      "priority": 1,
      "notes": "bulk approved from local Tanzil source",
      "createdAt": "2026-06-09T08:52:44+00:00",
      "updatedAt": "2026-06-09T08:52:44+00:00",
      "approvedAt": "2026-06-09T08:52:44+00:00",
