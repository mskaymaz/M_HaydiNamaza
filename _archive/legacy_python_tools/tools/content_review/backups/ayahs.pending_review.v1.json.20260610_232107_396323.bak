          "arabic": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "092/017",
            "text": "Sakınan ise, ondan uzak tutulacaktır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "092/017",
            "text": "Arınmak için malını veren, en çok sakınan kimse ise ondan uzak tutulur."
          },
          "en": {
