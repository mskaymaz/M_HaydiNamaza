      ],
      "ayahs": [
        {
          "ref": "075/016",
          "surah": 75,
          "ayah": 16,
          "arabic": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "075/016",
            "text": "Onu (Kur'an'ı, kavrayıp belletmek için) aceleye kapılıp dilini onunla hareket ettirip-durma."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "075/016",
            "text": "Cebrail sana Kuran okurken, unutmamak için acele edip onunla beraber söyleme, yalnız dinle."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "075/016",
            "text": "Move not your tongue with it, [O Muhammad], to hasten with recitation of the Qur'an."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "075/016",
            "text": "(O Prophet), do not stir your tongue hastily (to commit the Revelation to memory)."
          }
        }
      ],
