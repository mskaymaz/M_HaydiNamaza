        "input_source_ref_groups": "069/004, 069/005, 069/006"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "069/004",
        "069/005",
        "069/006"
      ],
      "ayahs": [
        {
          "ref": "069/004",
          "surah": 69,
          "ayah": 4,
          "arabic": "كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "069/004",
            "text": "Semud ve Ad (toplumları), karia’yı yalan saydılar."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "069/004",
            "text": "Semud ve Ad milletleri tepelerine inecek bu gerçeği yalanladılar."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "069/004",
            "text": "Thamud and 'Aad denied the Striking Calamity."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "069/004",
            "text": "The Thamud and the Ad denied the (possibility of a) sudden calamity, calling it false."
          }
        },
        {
          "ref": "069/005",
          "surah": 69,
          "ayah": 5,
          "arabic": "فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "069/005",
            "text": "Bu nedenle Semud (halkı), korkunç bir sesle helak edildi."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "069/005",
            "text": "Bu yüzden Semud milleti zorlu bir sarsıntı ile yok edildi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "069/005",
            "text": "So as for Thamud, they were destroyed by the overpowering [blast]."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "069/005",
            "text": "Then the Thamud were destroyed by an awesome upheaval;"
          }
        },
        {
          "ref": "069/006",
          "surah": 69,
          "ayah": 6,
          "arabic": "وَأَمَّا عَادٌ فَأُهْلِكُوا۟ بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "069/006",
            "text": "Ad (halkın)a gelince; onlar da, uğultu yüklü, azgın bir kasırga ile helak edildiler."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "069/006",
            "text": "Ad milleti de bu yüzden önünde durulmaz, dondurucu bir rüzgarla yok edildi."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "069/006",
            "text": "And as for 'Aad, they were destroyed by a screaming, violent wind"
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "069/006",
            "text": "and the Ad were destroyed by a furiously raging wind-storm"
          }
        }
      ],
