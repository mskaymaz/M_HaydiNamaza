      },
      "sourceRefGroups": [
        "004/076"
      ],
      "ayahs": [
        {
          "ref": "004/076",
          "surah": 4,
          "ayah": 76,
          "arabic": "ٱلَّذِينَ ءَامَنُوا۟ يُقَـٰتِلُونَ فِى سَبِيلِ ٱللَّهِ ۖ وَٱلَّذِينَ كَفَرُوا۟ يُقَـٰتِلُونَ فِى سَبِيلِ ٱلطَّـٰغُوتِ فَقَـٰتِلُوٓا۟ أَوْلِيَآءَ ٱلشَّيْطَـٰنِ ۖ إِنَّ كَيْدَ ٱلشَّيْطَـٰنِ كَانَ ضَعِيفًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "004/076",
            "text": "İman edenler Allah yolunda savaşırlar; inkar edenler ise tağut yolunda savaşırlar öyleyse şeytanın dostlarıyla savaşın. Hiç şüphesiz, şeytanın hileli-düzeni pek zayıftır."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "004/076",
            "text": "İnananlar Allah yolunda savaşırlar, inkar edenler ise tağut yolunda harbederler. Şeytanın dostlarıyla savaşın, esasen şeytanın hilesi zayıftır."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "004/076",
            "text": "Those who believe fight in the cause of Allah, and those who disbelieve fight in the cause of Taghut. So fight against the allies of Satan. Indeed, the plot of Satan has ever been weak."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "004/076",
            "text": "Those who have faith fight in the way of Allah, while those who disbelieve fight in the way of taghut (Satan). Fight, then, against the fellows of Satan. Surely Satan's strategy is weak."
          }
        }
      ],
