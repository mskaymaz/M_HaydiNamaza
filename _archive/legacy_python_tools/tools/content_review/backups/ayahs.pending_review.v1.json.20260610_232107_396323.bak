        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 171,
        "input_status": "ok",
        "input_source_ref_groups": "016/044"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "016/044"
      ],
      "ayahs": [
        {
          "ref": "016/044",
          "surah": 16,
          "ayah": 44,
          "arabic": "بِٱلْبَيِّنَـٰتِ وَٱلزُّبُرِ ۗ وَأَنزَلْنَآ إِلَيْكَ ٱلذِّكْرَ لِتُبَيِّنَ لِلنَّاسِ مَا نُزِّلَ إِلَيْهِمْ وَلَعَلَّهُمْ يَتَفَكَّرُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "016/044",
            "text": "(Onları) Apaçık deliller ve kitaplarla (gönderdik). Sana da zikri (Kur'an'ı) indirdik ki, insanlara kendileri için indirileni açıklayasın ve onlar da iyice düşünsünler, diye."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "016/044",
            "text": "Doğrusu senden önce de kendilerine kitablar ve belgelerle vahyettiğimiz bir takım adamlar gönderdik. Bilmiyorsanız kitablılara sorun. Sana da, insanlara gönderileni açıklayasın diye Kuran'ı indirdik. Belki düşünürler."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "016/044",
            "text": "[We sent them] with clear proofs and written ordinances. And We revealed to you the message that you may make clear to the people what was sent down to them and that they might give thought."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "016/044",
            "text": "We raised the Messengers earlier with Clear Signs and Divine Books, and We have now sent down this Reminder upon you that you may elucidate to people the teaching that has been sent down for them, and that the people may themselves reflect."
          }
        }
      ],
      "status": "approved",
