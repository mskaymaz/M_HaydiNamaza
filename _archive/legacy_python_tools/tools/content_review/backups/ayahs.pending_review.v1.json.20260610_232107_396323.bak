    {
      "ref": "063/005",
      "id": "063/005",
      "surah": 63,
      "ayahStart": 5,
      "ayahEnd": 5,
      "type": "single",
      "ayahCount": 1,
      "input": {
        "sira": 1284,
        "ref": "063/005",
        "input_type": "tekil",
        "input_ayah_count": 1,
        "input_char_count": 167,
        "input_status": "ok",
        "input_source_ref_groups": "063/005"
      },
      "source": {
        "arabic": "Tanzil Quran Text / Uthmani text",
        "tr": "Tanzil tr.bulac / Ali Bulaç",
        "trAlt": "Tanzil tr.diyanet / Diyanet İşleri",
        "en": "Tanzil en.sahih / Saheeh International",
        "enAlt": "Tanzil en.maududi / Abul A‘la Maududi"
      },
      "sourceRefGroups": [
        "063/005"
      ],
      "ayahs": [
        {
          "ref": "063/005",
          "surah": 63,
          "ayah": 5,
          "arabic": "وَإِذَا قِيلَ لَهُمْ تَعَالَوْا۟ يَسْتَغْفِرْ لَكُمْ رَسُولُ ٱللَّهِ لَوَّوْا۟ رُءُوسَهُمْ وَرَأَيْتَهُمْ يَصُدُّونَ وَهُم مُّسْتَكْبِرُونَ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "063/005",
            "text": "Onlara: \"Gelin Allah'ın Resûlü sizin için mağfiret (bağışlanma) dilesin,\" denildiği zaman başlarını yana çevirdiler. Sen, onların büyüklük taslamışlar olarak yüz çevirmekte olduklarını görürsün."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "063/005",
            "text": "Onlara: \"Gelin de Allah'ın Peygamberi sizin için mağfiret dilesin\" dendiği zaman, başlarını çevirirler; büyüklük taslayarak yüz çevirdiklerini görürsün."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "063/005",
            "text": "And when it is said to them, \"Come, the Messenger of Allah will ask forgiveness for you,\" they turn their heads aside and you see them evading while they are arrogant."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "063/005",
            "text": "When it is said to them: “Come, Allah's Messenger will seek forgiveness for you,” they (contemptuously) shake their heads and you see them holding back in pride."
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
