          "arabic": "\\basmalah إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "099/001",
            "text": "Yer, o şiddetli sarsıntısıyla sarsıldığı,"
