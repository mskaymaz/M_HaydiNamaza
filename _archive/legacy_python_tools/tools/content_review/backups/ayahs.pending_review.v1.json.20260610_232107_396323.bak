      ],
      "ayahs": [
        {
          "ref": "017/027",
          "surah": 17,
          "ayah": 27,
          "arabic": "إِنَّ ٱلْمُبَذِّرِينَ كَانُوٓا۟ إِخْوَٰنَ ٱلشَّيَـٰطِينِ ۖ وَكَانَ ٱلشَّيْطَـٰنُ لِرَبِّهِۦ كَفُورًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "017/027",
            "text": "Çünkü saçıp-savuranlar, şeytanın kardeşleri olmuşlardır; şeytan ise Rabbine karşı nankördür."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "017/027",
            "text": "Saçıp savuranlar, şüphesiz şeytanlarla kardeş olmuş olurlar; şeytan ise Rabbine karşı pek nankördür."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "017/027",
            "text": "Indeed, the wasteful are brothers of the devils, and ever has Satan been to his Lord ungrateful."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "017/027",
            "text": "for those who squander wastefully are Satan's brothers, and Satan is ever ungrateful to his Lord."
          }
        }
      ],
