      "ayahs": [
        {
          "ref": "003/017",
          "surah": 3,
          "ayah": 17,
          "arabic": "ٱلصَّـٰبِرِينَ وَٱلصَّـٰدِقِينَ وَٱلْقَـٰنِتِينَ وَٱلْمُنفِقِينَ وَٱلْمُسْتَغْفِرِينَ بِٱلْأَسْحَارِ",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "003/017",
            "text": "Sabredenler, doğru olanlar, gönülden boyun eğenler, infak edenler ve 'seher vakitlerinde' bağışlanma dileyenlerdir."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "003/017",
            "text": "Onlar ki, \"Rabbimiz! Biz şüphesiz inandık, bunun için günahlarımızı bize bağışla ve bizi ateşin azabından koru\" diyen, sabreden, doğru olan, gönülden kulluk eden, hayra sarfeden ve seher vakitlerinde bağışlanma dileyenlerdir."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "003/017",
            "text": "The patient, the true, the obedient, those who spend [in the way of Allah], and those who seek forgiveness before dawn."
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "003/017",
            "text": "men who are steadfast, truthful, obedient, spend (in the way of Allah) and implore the forgiveness of Allah before daybreak."
          }
        }
      ],
