      "sourceRefGroups": [
        "018/083"
      ],
      "ayahs": [
        {
          "ref": "018/083",
          "surah": 18,
          "ayah": 83,
          "arabic": "وَيَسْـَٔلُونَكَ عَن ذِى ٱلْقَرْنَيْنِ ۖ قُلْ سَأَتْلُوا۟ عَلَيْكُم مِّنْهُ ذِكْرًا",
          "tr": {
            "source": "Tanzil tr.bulac / Ali Bulaç",
            "sourceRef": "018/083",
            "text": "Sana (Ey Muhammed,) Zu'l-Karneyn hakkında sorarlar. De ki: \"Size, ondan 'öğüt ve hatırlatma olarak' (bazı bilgiler) vereceğim."
          },
          "trAlt": {
            "source": "Tanzil tr.diyanet / Diyanet İşleri",
            "sourceRef": "018/083",
            "text": "Sana Zülkarneyn'i sorarlar, \"Onu size anlatacağım\" de."
          },
          "en": {
            "source": "Tanzil en.sahih / Saheeh International",
            "sourceRef": "018/083",
            "text": "And they ask you, [O Muhammad], about Dhul-Qarnayn. Say, \"I will recite to you about him a report.\""
          },
          "enAlt": {
            "source": "Tanzil en.maududi / Abul A‘la Maududi",
            "sourceRef": "018/083",
            "text": "(O Muhammad), they ask you about Dhu al-Qarnayn. Say: \"I will give you an account of him.\""
          }
        }
      ],
      "status": "approved",
      "review": {
        "status": "approved",
        "priority_key": "normal",
        "priority": 1,
        "boost": {
          "enabled": false,
          "weight": 1
        },
        "note": "bulk approved from local Tanzil source",
        "updated_at": "2026-06-09T08:52:44+00:00"
      },
